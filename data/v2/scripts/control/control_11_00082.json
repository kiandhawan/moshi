 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.35,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.39,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I have asthma, mostly under control. Any tips for hiking with it, Moshi?",
   "est_sec": 4.13,
   "gap_before": 0.29,
   "block": "hiking.dlg12",
   "kind": "moshi_name",
   "name_pos": "end",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Plenty of people with asthma hike happily. The main thing is always carrying your reliever inhaler where you can reach it, not buried in the bag.",
   "est_sec": 8.16,
   "gap_before": 0.95,
   "role": "reply",
   "block": "hiking.dlg12"
  },
  {
   "speaker": "user",
   "text": "Hold on, really?",
   "est_sec": 1.03,
   "gap_before": 3.5,
   "block": "hiking.dlg12",
   "kind": "wait_like",
   "phrasing": "waitlike_11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "I'm fairly sure about it, but I could be wrong. What sounds off to you?",
   "est_sec": 4.75,
   "gap_before": 0.45,
   "role": "reply",
   "block": "hiking.dlg12"
  },
  {
   "speaker": "user",
   "text": "Cold air sets mine off.",
   "est_sec": 1.65,
   "gap_before": 1.06,
   "block": "hiking.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A buff or scarf over your mouth on cold mornings warms the air a bit. Start slowly to let your lungs adjust.",
   "est_sec": 6.92,
   "gap_before": 0.54,
   "role": "reply",
   "block": "hiking.dlg12"
  },
  {
   "speaker": "user",
   "text": "What about pollen? Spring is",
   "est_sec": 1.65,
   "gap_before": 1.11,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg12"
  },
  {
   "speaker": "user",
   "text": "pretty bad for me.",
   "est_sec": 1.34,
   "gap_before": 1.91,
   "block": "hiking.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Check the pollen forecast and pick days after rain, or routes higher up and by the coast, where counts are often lower.",
   "est_sec": 6.92,
   "gap_before": 0.73,
   "role": "reply",
   "block": "hiking.dlg12"
  },
  {
   "speaker": "user",
   "text": "Good idea. I'll talk to my nurse before the big one in May.",
   "est_sec": 4.13,
   "gap_before": 0.62,
   "block": "hiking.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a great plan. She might suggest using your preventer more regularly in the weeks before.",
   "est_sec": 5.06,
   "gap_before": 1.0,
   "role": "reply",
   "block": "hiking.dlg12"
  }
 ]
}
