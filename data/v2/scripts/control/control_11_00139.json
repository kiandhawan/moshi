 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.43,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.61,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "Our water is so hard the kettle looks like it's full of snow. Is there a kettle that deals with that?",
   "est_sec": 6.61,
   "gap_before": 0.51,
   "block": "shopping.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Some come with a built in limescale filter at the spout, which stops the flakes getting in your tea.",
   "est_sec": 5.99,
   "gap_before": 1.54,
   "role": "reply",
   "block": "shopping.dlg11"
  },
  {
   "speaker": "user",
   "text": "Does that stop the build up though?",
   "est_sec": 2.27,
   "gap_before": 0.48,
   "block": "shopping.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not really, it just catches the bits. To stop the crust you'll want to descale it every few weeks.",
   "est_sec": 5.99,
   "gap_before": 0.77,
   "role": "reply",
   "block": "shopping.dlg11"
  },
  {
   "speaker": "user",
   "text": "With what? Those little sachets?",
   "est_sec": 1.65,
   "gap_before": 1.34,
   "block": "shopping.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Those work, or just boil half water and half white vinegar, leave it an hour, then rinse and boil fresh water twice.",
   "est_sec": 6.92,
   "gap_before": 0.36,
   "role": "reply",
   "block": "shopping.dlg11"
  },
  {
   "speaker": "user",
   "text": "My tea will taste of vinegar.",
   "est_sec": 1.96,
   "gap_before": 0.87,
   "block": "shopping.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not if you rinse properly. And a stainless steel kettle with a hidden element is much easier to clean than one with a coil inside.",
   "est_sec": 7.85,
   "gap_before": 0.75,
   "role": "reply",
   "block": "shopping.dlg11"
  }
 ]
}
