 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.48,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "I'm going back to college at fifty-five and I haven't written an essay in thirty years.",
   "est_sec": 5.06,
   "gap_before": 0.3,
   "block": "studying.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's exciting. The basics haven't changed much. Have a clear argument, back it up, and keep each paragraph to one idea.",
   "est_sec": 6.61,
   "gap_before": 0.35,
   "role": "reply",
   "block": "studying.dlg4"
  },
  {
   "speaker": "user",
   "text": "What about all the referencing? That's what scares me.",
   "est_sec": 2.89,
   "gap_before": 0.32,
   "block": "studying.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most colleges use one standard style and have a guide online. A free reference manager can format everything for you.",
   "est_sec": 6.3,
   "gap_before": 0.49,
   "role": "reply",
   "block": "studying.dlg4"
  },
  {
   "speaker": "user",
   "text": "So I don't have to type it all by hand?",
   "est_sec": 3.2,
   "gap_before": 3.33,
   "block": "studying.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not at all. You save the sources as you read, and it builds the list at the end.",
   "est_sec": 5.68,
   "gap_before": 0.79,
   "role": "reply",
   "block": "studying.dlg4"
  },
  {
   "speaker": "user",
   "text": "Well that's a relief. I was picturing",
   "est_sec": 2.27,
   "gap_before": 0.91,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg4"
  },
  {
   "speaker": "user",
   "text": "index cards and a typewriter.",
   "est_sec": 1.65,
   "gap_before": 2.19,
   "block": "studying.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Things have gotten a lot easier. Your library will likely run a short workshop on it too, worth asking.",
   "est_sec": 5.99,
   "gap_before": 0.6,
   "role": "reply",
   "block": "studying.dlg4"
  }
 ]
