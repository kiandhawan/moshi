 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.41,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.68,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "There's a huge tree stump in the middle of my garden. Any way to get rid of it without a machine?",
   "est_sec": 6.61,
   "gap_before": 0.38,
   "block": "gardening.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can, it just takes patience. Drill some deep holes in the top, fill them with water and cover it so it stays damp. That speeds up rotting.",
   "est_sec": 8.78,
   "gap_before": 0.94,
   "role": "reply",
   "block": "gardening.dlg31"
  },
  {
   "speaker": "user",
   "text": "How long are we talking?",
   "est_sec": 1.65,
   "gap_before": 0.33,
   "block": "gardening.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A year or two for a big stump. Fungi and bugs do most of the work.",
   "est_sec": 5.06,
   "gap_before": 1.06,
   "role": "reply",
   "block": "gardening.dlg31"
  },
  {
   "speaker": "user",
   "text": "That's ages.",
   "est_sec": 0.72,
   "gap_before": 0.41,
   "block": "gardening.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It is. The quicker route is hiring a stump grinder for a day. It turns the stump into wood chips in an hour or so.",
   "est_sec": 7.85,
   "gap_before": 1.03,
   "role": "reply",
   "block": "gardening.dlg31"
  },
  {
   "speaker": "user",
   "text": "Or I could",
   "est_sec": 1.03,
   "gap_before": 2.34,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg31"
  },
  {
   "speaker": "user",
   "text": "just make it a feature, I suppose?",
   "est_sec": 2.27,
   "gap_before": 2.05,
   "block": "gardening.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a lovely option. Put a big pot on top, or let ferns and moss grow around it. Beetles will love it too.",
   "est_sec": 7.23,
   "gap_before": 1.0,
   "role": "reply",
   "block": "gardening.dlg31"
  }
 ]
}
