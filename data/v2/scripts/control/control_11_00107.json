 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.62,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "I want a game I can play with my grandkids. They're four and six.",
   "est_sec": 4.44,
   "gap_before": 0.33,
   "block": "board_games.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Wonderful. Outfoxed is a sweet cooperative game for that age, everyone works together to catch a sneaky fox.",
   "est_sec": 5.68,
   "gap_before": 0.85,
   "role": "reply",
   "block": "board_games.dlg4"
  },
  {
   "speaker": "user",
   "text": "The four year old can't read yet.",
   "est_sec": 2.27,
   "gap_before": 1.33,
   "block": "board_games.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's fine, it uses pictures only. Another favorite is Hoot Owl Hoot, which is all colors.",
   "est_sec": 5.06,
   "gap_before": 0.65,
   "role": "reply",
   "block": "board_games.dlg4"
  },
  {
   "speaker": "user",
   "text": "I used to play",
   "est_sec": 1.34,
   "gap_before": 0.47,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg4"
  },
  {
   "speaker": "user",
   "text": "snakes and ladders with my kids. Is that still good?",
   "est_sec": 3.2,
   "gap_before": 1.66,
   "block": "board_games.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's still great for counting practice. It's pure luck though, so mix it with one where they make choices.",
   "est_sec": 5.99,
   "gap_before": 0.66,
   "role": "reply",
   "block": "board_games.dlg4"
  },
  {
   "speaker": "user",
   "text": "I'll get the owl one then.",
   "est_sec": 1.96,
   "gap_before": 1.09,
   "block": "board_games.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Lovely. Games for that age usually last about fifteen minutes, just right for little attention spans.",
   "est_sec": 5.06,
   "gap_before": 0.39,
   "role": "reply",
   "block": "board_games.dlg4"
  }
 ]
