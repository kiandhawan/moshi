 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.58,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "Is jumping rope actually good cardio, or is it just for boxers in movies?",
   "est_sec": 4.44,
   "gap_before": 0.49,
   "block": "fitness.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's genuinely great cardio. Ten minutes of skipping is a tough workout, and it improves coordination too.",
   "est_sec": 5.37,
   "gap_before": 0.37,
   "role": "reply",
   "block": "fitness.dlg26"
  },
  {
   "speaker": "user",
   "text": "I tried yesterday and kept tripping.",
   "est_sec": 1.96,
   "gap_before": 0.73,
   "block": "fitness.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Everybody does at first. Make sure the rope length is right, the handles should reach your armpits when you stand on the middle.",
   "est_sec": 7.23,
   "gap_before": 1.62,
   "role": "reply",
   "block": "fitness.dlg26"
  },
  {
   "speaker": "user",
   "text": "Mine's definitely too long.",
   "est_sec": 1.34,
   "gap_before": 0.39,
   "block": "fitness.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That makes it much harder. Shorten it with a knot, and keep your jumps small, just off the ground.",
   "est_sec": 5.99,
   "gap_before": 0.8,
   "role": "reply",
   "block": "fitness.dlg26"
  },
  {
   "speaker": "user",
   "text": "How long should I do it",
   "est_sec": 1.96,
   "gap_before": 1.19,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg26"
  },
  {
   "speaker": "user",
   "text": "as a beginner?",
   "est_sec": 1.03,
   "gap_before": 2.74,
   "block": "fitness.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Try thirty seconds on, thirty seconds rest, for ten rounds. Do it on a soft surface to protect your joints.",
   "est_sec": 6.3,
   "gap_before": 0.82,
   "role": "reply",
   "block": "fitness.dlg26"
  }
 ]
