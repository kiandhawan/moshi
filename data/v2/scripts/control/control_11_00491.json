 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.67,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.47,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "I adopted a cat last week and she's hiding under the bed all day.",
   "est_sec": 4.44,
   "gap_before": 0.29,
   "block": "pets.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's really normal for a new cat. Give her a quiet room with food, water and a litter box nearby.",
   "est_sec": 6.3,
   "gap_before": 0.98,
   "role": "reply",
   "block": "pets.dlg4"
  },
  {
   "speaker": "user",
   "text": "Should I try to pull her out so she gets used to me?",
   "est_sec": 4.13,
   "gap_before": 0.82,
   "block": "pets.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Better not. Let her come out on her own. Sit nearby and read or talk softly so she learns you're safe.",
   "est_sec": 6.61,
   "gap_before": 1.07,
   "role": "reply",
   "block": "pets.dlg4"
  },
  {
   "speaker": "user",
   "text": "How long does it usually take?",
   "est_sec": 1.96,
   "gap_before": 1.3,
   "block": "pets.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Anywhere from a few days to a few weeks. Treats and a feather toy can speed things up.",
   "est_sec": 5.68,
   "gap_before": 0.51,
   "role": "reply",
   "block": "pets.dlg4"
  },
  {
   "speaker": "user",
   "text": "I'll pick up a feather toy tomorrow",
   "est_sec": 2.27,
   "gap_before": 0.58,
   "event": "distractor",
   "kind": "pause",
   "block": "pets.dlg4"
  },
  {
   "speaker": "user",
   "text": "and maybe some of those lickable treats.",
   "est_sec": 2.27,
   "gap_before": 2.95,
   "block": "pets.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
