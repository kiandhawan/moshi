 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.66,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.79,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "My white trainers are grey and I've got a wedding on Saturday. Can I save them?",
   "est_sec": 5.06,
   "gap_before": 0.41,
   "block": "cleaning.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Probably. Take the laces out, then scrub the soles and sides with a soft brush and a paste of baking soda and washing-up liquid.",
   "est_sec": 7.54,
   "gap_before": 1.87,
   "role": "reply",
   "block": "cleaning.dlg25"
  },
  {
   "speaker": "user",
   "text": "And the laces?",
   "est_sec": 1.03,
   "gap_before": 0.92,
   "block": "cleaning.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Soak them in warm soapy water while you scrub, or just buy new white ones, they're cheap.",
   "est_sec": 5.37,
   "gap_before": 0.9,
   "role": "reply",
   "block": "cleaning.dlg25"
  },
  {
   "speaker": "user",
   "text": "The fabric part is",
   "est_sec": 1.34,
   "gap_before": 0.9,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg25"
  },
  {
   "speaker": "user",
   "text": "the worst. It's mesh.",
   "est_sec": 1.34,
   "gap_before": 2.79,
   "block": "cleaning.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Use an old toothbrush and the same paste gently on the mesh, then wipe with a damp cloth. Stuff them with paper to dry.",
   "est_sec": 7.54,
   "gap_before": 1.01,
   "role": "reply",
   "block": "cleaning.dlg25"
  },
  {
   "speaker": "user",
   "text": "Not the radiator?",
   "est_sec": 1.03,
   "gap_before": 2.98,
   "block": "cleaning.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "No, heat can yellow them and warp the glue. Give them a full day to dry.",
   "est_sec": 5.06,
   "gap_before": 0.62,
   "role": "reply",
   "block": "cleaning.dlg25"
  }
 ]
}
