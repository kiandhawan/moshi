  {
   "speaker": "user",
   "text": "Why does my TV show black bars at the top and bottom on some films?",
   "est_sec": 4.75,
   "gap_before": 0.49,
   "block": "movies.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Those films are shot wider than your TV's shape. The bars keep the full picture without cutting off the sides.",
   "est_sec": 6.3,
   "gap_before": 1.03,
   "role": "reply",
   "block": "movies.dlg8"
  },
  {
   "speaker": "user",
   "text": "Can I get rid of them?",
   "est_sec": 1.96,
   "gap_before": 1.45,
   "block": "movies.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can use the zoom setting on the TV, but it'll crop the edges of the image. The director framed it that way on purpose.",
   "est_sec": 7.85,
   "gap_before": 0.86,
   "role": "reply",
   "block": "movies.dlg8"
  },
