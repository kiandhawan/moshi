 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.72,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "Quick one. Is it okay to throw an orange peel into the bushes? It's natural, right, Moshi?",
   "est_sec": 5.37,
   "gap_before": 0.59,
   "block": "hiking.dlg9",
   "kind": "moshi_name",
   "name_pos": "end",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It feels harmless, but it's better to take it home. Peel takes a long time to break down, sometimes months or more.",
   "est_sec": 6.92,
   "gap_before": 0.53,
   "role": "reply",
   "block": "hiking.dlg9"
  },
  {
   "speaker": "user",
   "text": "Seriously? Months?",
   "est_sec": 0.72,
   "gap_before": 2.9,
   "block": "hiking.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, especially in dry or cold places. And it's not part of what animals there would normally eat.",
   "est_sec": 5.68,
   "gap_before": 0.55,
   "role": "reply",
   "block": "hiking.dlg9"
  },
  {
   "speaker": "user",
   "text": "Huh. Same with apple cores?",
   "est_sec": 1.65,
   "gap_before": 1.2,
   "block": "hiking.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Same idea. On busy trails, hundreds of people dropping cores adds up quickly.",
   "est_sec": 4.13,
   "gap_before": 0.48,
   "role": "reply",
   "block": "hiking.dlg9"
  },
  {
   "speaker": "user",
   "text": "Fine, I'll",
   "est_sec": 0.72,
   "gap_before": 1.21,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg9"
  },
  {
   "speaker": "user",
   "text": "bring a little bag for scraps.",
   "est_sec": 1.96,
   "gap_before": 1.74,
   "block": "hiking.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's all it takes. A small zip bag in the side pocket and you're sorted.",
   "est_sec": 4.75,
   "gap_before": 0.94,
   "role": "reply",
   "block": "hiking.dlg9"
  }
 ]
