   "block": "birthday_party.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then fill the crater. Whipped cream, berries, chocolate buttons, anything piled in the middle, and call it a volcano cake.",
