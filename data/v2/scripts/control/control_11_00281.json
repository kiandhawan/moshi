   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "My friend's company is hiring and she offered to set up a coffee with her boss. Is that an interview or not?",
   "est_sec": 6.92,
   "gap_before": 0.24,
   "block": "job_interview.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's informal, but treat it as a gentle interview. First impressions still count.",
   "est_sec": 4.13,
   "gap_before": 1.13,
   "role": "reply",
   "block": "job_interview.dlg28"
  },
  {
   "speaker": "user",
   "text": "So I should dress up?",
   "est_sec": 1.65,
   "gap_before": 0.79,
   "block": "job_interview.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Smart casual is right. Not a suit, but something neat.",
   "est_sec": 3.2,
   "gap_before": 0.87,
   "role": "reply",
   "block": "job_interview.dlg28"
  },
  {
   "speaker": "user",
   "text": "And what do we even talk about?",
   "est_sec": 2.27,
   "gap_before": 0.97,
   "block": "job_interview.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ask about their work and what the team needs. Mention your background briefly, but let it feel like a conversation.",
   "est_sec": 6.3,
   "gap_before": 1.1,
   "role": "reply",
   "block": "job_interview.dlg28"
  },
  {
