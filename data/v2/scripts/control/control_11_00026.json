   "est_sec": 2.89,
   "gap_before": 0.35,
   "block": "hiking.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most healthy adult dogs love it. How old is your dog, and what breed?",
