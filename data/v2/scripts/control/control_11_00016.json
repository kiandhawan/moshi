 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.3,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.62,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "What's an emergency fund supposed to cover exactly?",
   "est_sec": 2.58,
   "gap_before": 0.32,
   "block": "personal_finance.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Unexpected costs you can't put off. Things like a broken boiler, car repairs, or losing your job.",
   "est_sec": 5.37,
   "gap_before": 0.37,
   "role": "reply",
   "block": "personal_finance.dlg17"
  },
  {
   "speaker": "user",
   "text": "Does a new phone count?",
   "est_sec": 1.65,
   "gap_before": 0.59,
   "block": "personal_finance.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "If your phone breaks and you need it for work, maybe. A shiny upgrade, probably not.",
   "est_sec": 5.06,
   "gap_before": 1.13,
   "role": "reply",
   "block": "personal_finance.dlg17"
  },
  {
   "speaker": "user",
   "text": "How much should be in it?",
   "est_sec": 1.96,
   "gap_before": 2.65,
   "block": "personal_finance.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A common goal is three to six months of essential costs. But even one month is a huge help.",
   "est_sec": 5.99,
   "gap_before": 0.99,
   "role": "reply",
   "block": "personal_finance.dlg17"
  },
  {
   "speaker": "user",
   "text": "Six months sounds",
   "est_sec": 1.03,
   "gap_before": 0.53,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg17"
  },
  {
   "speaker": "user",
   "text": "impossible right now.",
   "est_sec": 1.03,
   "gap_before": 2.68,
   "block": "personal_finance.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Start with a smaller target, like five hundred. Once you hit it, aim for one month, then build up.",
   "est_sec": 5.99,
   "gap_before": 1.11,
   "role": "reply",
   "block": "personal_finance.dlg17"
  }
 ]
}
