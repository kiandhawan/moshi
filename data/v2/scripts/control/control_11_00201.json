 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.38,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "I'm planning a long walk across the city on Sunday. Forecast says drizzle all day. Lovely.",
   "est_sec": 5.06,
   "gap_before": 0.55,
   "block": "weather_plans.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Drizzle isn't the worst. A light waterproof and decent shoes will keep you comfortable.",
   "est_sec": 4.44,
   "gap_before": 0.44,
   "role": "reply",
   "block": "weather_plans.dlg32"
  },
  {
   "speaker": "user",
   "text": "My waterproof is basically a bin bag with sleeves.",
   "est_sec": 2.89,
   "gap_before": 0.37,
   "block": "weather_plans.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then maybe tuck a spare jumper in a bag in case it soaks through. Or treat the old jacket with a waterproof spray.",
   "est_sec": 7.23,
   "gap_before": 0.7,
   "role": "reply",
   "block": "weather_plans.dlg32"
  },
  {
   "speaker": "user",
   "text": "Should I plan stops?",
   "est_sec": 1.34,
   "gap_before": 0.41,
   "block": "weather_plans.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, pick a few cafes or covered markets along the route. Little warm breaks make a grey day much nicer.",
   "est_sec": 6.3,
   "gap_before": 0.89,
   "role": "reply",
   "block": "weather_plans.dlg32"
  },
  {
   "speaker": "user",
   "text": "Any route tips?",
   "est_sec": 1.03,
   "gap_before": 0.66,
   "block": "weather_plans.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Choose paths along the river or through parks with some cover. Drizzle can make city streets feel really moody and pretty.",
   "est_sec": 6.61,
   "gap_before": 1.03,
   "role": "reply",
   "block": "weather_plans.dlg32"
  }
 ]
}
