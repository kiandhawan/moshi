 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.48,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.46,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "Why are films so badly mixed? I can't hear anyone talking and then an explosion wakes the baby.",
   "est_sec": 5.68,
   "gap_before": 0.26,
   "block": "movies.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's a very common complaint. Films are mixed for big cinema speakers, so the quiet bits get very quiet at home.",
   "est_sec": 6.61,
   "gap_before": 0.43,
   "role": "reply",
   "block": "movies.dlg14"
  },
  {
   "speaker": "user",
   "text": "Can I do anything?",
   "est_sec": 1.34,
   "gap_before": 0.92,
   "block": "movies.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Check your TV settings for something like night mode or dialogue boost. It squashes the loud and quiet parts together.",
   "est_sec": 6.3,
   "gap_before": 1.11,
   "role": "reply",
   "block": "movies.dlg14"
  },
  {
   "speaker": "user",
   "text": "I've never even",
   "est_sec": 1.03,
   "gap_before": 2.59,
   "event": "distractor",
   "kind": "pause",
   "block": "movies.dlg14"
  },
  {
   "speaker": "user",
   "text": "looked at those settings.",
   "est_sec": 1.34,
   "gap_before": 2.22,
   "block": "movies.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most people haven't. A small soundbar with a speech mode helps a lot too, since TV speakers are tiny.",
   "est_sec": 5.99,
   "gap_before": 0.76,
   "role": "reply",
   "block": "movies.dlg14"
  },
  {
   "speaker": "user",
   "text": "And subtitles, I guess.",
   "est_sec": 1.34,
   "gap_before": 0.56,
   "block": "movies.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Honestly, loads of people use them now. Combined with night mode, you'll catch every line and the baby stays asleep.",
   "est_sec": 6.3,
   "gap_before": 0.48,
   "role": "reply",
   "block": "movies.dlg14"
  }
 ]
}
