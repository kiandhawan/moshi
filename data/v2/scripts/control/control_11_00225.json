 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.44,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.59,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "First shift as a barista tomorrow. I'm terrified of steaming milk wrong in front of customers.",
   "est_sec": 5.06,
   "gap_before": 0.32,
   "block": "coffee.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Everyone starts there. The main thing is to start with the steam wand tip just under the surface, so you hear a gentle tearing sound.",
   "est_sec": 7.85,
   "gap_before": 0.82,
   "role": "reply",
   "block": "coffee.dlg17"
  },
  {
   "speaker": "user",
   "text": "Like paper ripping?",
   "est_sec": 1.03,
   "gap_before": 0.93,
   "block": "coffee.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Exactly like that. That's air going in. After a few seconds, lower the jug a little so the milk spins like a whirlpool.",
   "est_sec": 7.23,
   "gap_before": 0.31,
   "role": "reply",
   "block": "coffee.dlg17"
  },
  {
   "speaker": "user",
   "text": "And how do I know",
   "est_sec": 1.65,
   "gap_before": 2.79,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg17"
  },
  {
   "speaker": "user",
   "text": "when it's hot enough?",
   "est_sec": 1.34,
   "gap_before": 1.94,
   "block": "coffee.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Put your hand on the side of the jug. When it's too hot to hold for more than a second or two, it's ready. Some cafes use a thermometer too.",
   "est_sec": 9.4,
   "gap_before": 0.8,
   "role": "reply",
   "block": "coffee.dlg17"
  },
  {
   "speaker": "user",
   "text": "What if it screams?",
   "est_sec": 1.34,
   "gap_before": 2.09,
   "block": "coffee.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's the tip being too high or too deep. Adjust slowly. And ask your colleagues for help, nobody expects you to be perfect on day one.",
   "est_sec": 8.16,
   "gap_before": 1.4,
   "role": "reply",
   "block": "coffee.dlg17"
  }
