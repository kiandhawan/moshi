   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.37,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "I get really motion sick on buses. Is there anything that helps?",
   "est_sec": 3.82,
   "gap_before": 0.21,
   "block": "public_transport.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sit near the front, facing forward, and look out the window at the horizon. Reading or scrolling usually makes it worse.",
   "est_sec": 6.61,
   "gap_before": 0.72,
   "role": "reply",
   "block": "public_transport.dlg2"
  },
  {
   "speaker": "user",
   "text": "I always read",
   "est_sec": 1.03,
