 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.67,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.96,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "We booked bowling for my son's party. What do I need to sort beforehand?",
   "est_sec": 4.44,
   "gap_before": 0.22,
   "block": "birthday_party.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Nice choice. Have you checked if they do bumpers and lighter balls for kids?",
   "est_sec": 4.44,
   "gap_before": 1.11,
   "role": "reply",
   "block": "birthday_party.dlg22"
  },
  {
   "speaker": "user",
   "text": "I didn't think of that. They're nine.",
   "est_sec": 2.27,
   "gap_before": 0.32,
   "block": "birthday_party.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ask for bumpers, they make it more fun and less frustrating at that age. Also check how many kids per lane.",
   "est_sec": 6.61,
   "gap_before": 0.56,
   "role": "reply",
   "block": "birthday_party.dlg22"
  },
  {
   "speaker": "user",
   "text": "Six per lane, I think. And food?",
   "est_sec": 2.27,
   "gap_before": 0.73,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg22"
  },
  {
   "speaker": "user",
   "text": "Do I bring my own or do they do it?",
   "est_sec": 3.2,
   "gap_before": 2.36,
   "block": "birthday_party.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most places offer a party package with food, and often don't allow outside food except the cake. Ask them directly.",
   "est_sec": 6.3,
   "gap_before": 0.62,
   "role": "reply",
   "block": "birthday_party.dlg22"
  },
  {
   "speaker": "user",
   "text": "Okay. Anything else?",
   "est_sec": 1.03,
   "gap_before": 1.23,
   "block": "birthday_party.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Bring socks for any kid who forgets them, and a list of parent phone numbers, just in case.",
   "est_sec": 5.68,
   "gap_before": 0.96,
   "role": "reply",
   "block": "birthday_party.dlg22"
  }
 ]
}
