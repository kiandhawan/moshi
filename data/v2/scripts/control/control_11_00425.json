 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.75,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.61,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "I'm fifty two and I want to learn to read sheet music. Feeling a bit silly about it.",
   "est_sec": 5.68,
   "gap_before": 0.34,
   "block": "music.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not silly at all. Adults often pick it up faster than kids, because you can understand the logic behind it.",
   "est_sec": 6.3,
   "gap_before": 0.97,
   "role": "reply",
   "block": "music.dlg19"
  },
  {
   "speaker": "user",
   "text": "Where do I begin?",
   "est_sec": 1.34,
   "gap_before": 0.81,
   "block": "music.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Start with the lines of the treble clef. The notes on the lines from bottom to top are E, G, B, D, F.",
   "est_sec": 7.23,
   "gap_before": 0.31,
   "role": "reply",
   "block": "music.dlg19"
  },
  {
   "speaker": "user",
   "text": "Is there a trick to",
   "est_sec": 1.65,
   "gap_before": 0.9,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg19"
  },
  {
   "speaker": "user",
   "text": "remembering that?",
   "est_sec": 0.72,
   "gap_before": 2.06,
   "block": "music.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A classic one is every good boy deserves fruit. The spaces in between spell face.",
   "est_sec": 4.75,
   "gap_before": 0.45,
   "role": "reply",
   "block": "music.dlg19"
  },
  {
   "speaker": "user",
   "text": "Oh, that's handy. And rhythm?",
   "est_sec": 1.65,
   "gap_before": 1.53,
   "block": "music.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Learn a few note lengths first, like whole, half and quarter notes. Clap along to simple rhythms and you'll start reading them quickly.",
   "est_sec": 7.23,
   "gap_before": 1.0,
   "role": "reply",
   "block": "music.dlg19"
  },
  {
   "speaker": "user",
