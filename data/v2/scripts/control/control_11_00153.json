 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.54,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.53,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "My bathroom sink smells awful. Like old eggs.",
   "est_sec": 2.58,
   "gap_before": 0.5,
   "block": "cleaning.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's usually gunk built up in the drain. Pull out the plug or stopper if you can, there's often hair wrapped around it.",
   "est_sec": 7.23,
   "gap_before": 1.2,
   "role": "reply",
   "block": "cleaning.dlg22"
  },
  {
   "speaker": "user",
   "text": "Oh, that is horrible.",
   "est_sec": 1.34,
   "gap_before": 1.36,
   "block": "cleaning.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sorry. Clear it out, then pour half a cup of baking soda down, followed by a cup of vinegar.",
   "est_sec": 5.99,
   "gap_before": 0.92,
   "role": "reply",
   "block": "cleaning.dlg22"
  },
  {
   "speaker": "user",
   "text": "It's fizzing like",
   "est_sec": 1.03,
   "gap_before": 1.32,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg22"
  },
  {
   "speaker": "user",
   "text": "a science project.",
   "est_sec": 1.03,
   "gap_before": 2.88,
   "block": "cleaning.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Let it fizz for fifteen minutes, then flush with a kettle of hot water, not boiling if you have plastic pipes.",
   "est_sec": 6.61,
   "gap_before": 0.6,
   "role": "reply",
   "block": "cleaning.dlg22"
  },
  {
   "speaker": "user",
   "text": "The smell's already better.",
   "est_sec": 1.34,
   "gap_before": 1.28,
   "block": "cleaning.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Do the fizz trick once a month and it should stay that way.",
   "est_sec": 4.13,
   "gap_before": 0.98,
   "role": "reply",
   "block": "cleaning.dlg22"
  }
 ]
