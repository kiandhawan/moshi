 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.72,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.52,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "The bag says notes of chocolate, cherry and almond. I just taste coffee. Am I broken?",
   "est_sec": 5.06,
   "gap_before": 0.56,
   "block": "coffee.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Definitely not. Those notes are subtle hints, not added flavours. Most people need a bit of practice to pick them out.",
   "est_sec": 6.61,
   "gap_before": 0.96,
   "role": "reply",
   "block": "coffee.dlg31"
  },
  {
   "speaker": "user",
   "text": "Isabella, have you brushed your teeth yet?",
   "est_sec": 2.27,
   "gap_before": 0.52,
   "block": "nq_home_004",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_004",
   "name_pos": "start",
   "addressee": "Isabella"
  },
  {
   "speaker": "other",
   "text": "Yes. Well, nearly.",
   "est_sec": 1.03,
   "gap_before": 0.48,
   "block": "nq_home_004"
  },
  {
   "speaker": "user",
   "text": "So it's a bit of",
   "est_sec": 1.65,
   "gap_before": 1.41,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg31"
  },
  {
   "speaker": "user",
   "text": "a marketing gimmick?",
   "est_sec": 1.03,
   "gap_before": 2.03,
   "block": "coffee.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Partly description, partly a guide. The beans really do have different flavour compounds, but the words are the roaster's best attempt to describe them.",
   "est_sec": 7.54,
   "gap_before": 0.81,
   "role": "reply",
   "block": "coffee.dlg31"
  },
  {
   "speaker": "user",
   "text": "How do I practise?",
   "est_sec": 1.34,
   "gap_before": 0.9,
   "block": "coffee.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Taste two very different coffees side by side, like a light African roast and a dark Brazilian one. Differences jump out much more when you compare.",
   "est_sec": 8.16,
   "gap_before": 0.6,
   "role": "reply",
   "block": "coffee.dlg31"
  },
  {
   "speaker": "user",
   "text": "And let it cool?",
   "est_sec": 1.34,
   "gap_before": 0.69,
   "block": "coffee.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, good instinct. Flavours often get clearer as the coffee cools a bit. Very hot coffee mostly just tastes hot.",
   "est_sec": 6.3,
   "gap_before": 0.38,
   "role": "reply",
   "block": "coffee.dlg31"
  }
