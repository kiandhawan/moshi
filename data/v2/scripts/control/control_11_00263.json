 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.96,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "My budgie used to sing all day, and now he's really quiet. Should I worry?",
   "est_sec": 4.75,
   "gap_before": 0.48,
   "block": "pets.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's worth keeping an eye on. Has anything changed lately, like the cage spot, a new pet, or less daylight?",
   "est_sec": 6.3,
   "gap_before": 0.68,
   "role": "reply",
   "block": "pets.dlg14"
  },
  {
   "speaker": "user",
   "text": "We moved his cage into the bedroom because of the cat.",
   "est_sec": 3.51,
   "gap_before": 0.41,
   "block": "pets.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That might be it. Budgies like being near the action and they get lonely easily.",
   "est_sec": 4.75,
   "gap_before": 0.4,
   "role": "reply",
   "block": "pets.dlg14"
  },
  {
   "speaker": "user",
   "text": "The other night, Nevaeh, Moshi helped me write a birthday poem.",
   "est_sec": 3.51,
   "gap_before": 1.5,
   "block": "mm_040",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_040",
   "name_pos": "middle",
   "addressee": "Nevaeh"
  },
  {
   "speaker": "other",
   "text": "Was it any good?",
   "est_sec": 1.34,
   "gap_before": 0.38,
   "block": "mm_040"
  },
  {
   "speaker": "user",
   "text": "Sakura, what time does the chippy shut on Sundays?",
   "est_sec": 2.89,
   "gap_before": 0.95,
   "block": "nq_social_026",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_026",
   "name_pos": "start",
   "addressee": "Sakura"
  },
  {
   "speaker": "other",
   "text": "Nine, I think. Ten at the latest.",
   "est_sec": 2.27,
   "gap_before": 0.66,
   "block": "nq_social_026"
  },
  {
   "speaker": "user",
   "text": "Is he eating okay?",
   "est_sec": 1.34,
   "gap_before": 1.2,
   "block": "pets.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's the key question. If he's eating, preening and his droppings look normal, it's probably mood. If he's fluffed up and sleepy, see an avian vet.",
   "est_sec": 8.16,
   "gap_before": 0.63,
   "role": "reply",
   "block": "pets.dlg14"
  },
  {
   "speaker": "user",
   "text": "He's eating. He just",
   "est_sec": 1.34,
   "gap_before": 0.37,
   "event": "distractor",
   "kind": "pause",
   "block": "pets.dlg14"
  },
  {
   "speaker": "user",
   "text": "sits there looking sad.",
   "est_sec": 1.34,
   "gap_before": 1.87,
   "block": "pets.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Try moving him to a busy room that's safe from the cat, and talk to him through the day. Some people get a second budgie for company.",
   "est_sec": 8.47,
   "gap_before": 0.68,
   "role": "reply",
   "block": "pets.dlg14"
  }
 ]
