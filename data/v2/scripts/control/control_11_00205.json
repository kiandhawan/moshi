 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.36,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.77,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "Every time I blind bake a tart case, the sides slump down. What am I doing wrong?",
   "est_sec": 5.37,
   "gap_before": 0.24,
   "block": "baking.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Usually the pastry is too warm going into the oven. Chill the lined tin for at least thirty minutes first.",
   "est_sec": 6.3,
   "gap_before": 1.28,
   "role": "reply",
   "block": "baking.dlg5"
  },
  {
   "speaker": "user",
   "text": "I do use baking beans, though.",
   "est_sec": 1.96,
   "gap_before": 0.87,
   "block": "baking.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good, but fill them right up to the rim, not just the bottom. The beans hold the sides in place.",
   "est_sec": 6.3,
   "gap_before": 0.64,
   "role": "reply",
   "block": "baking.dlg5"
  },
  {
   "speaker": "user",
   "text": "Oh. I only put",
   "est_sec": 1.34,
   "gap_before": 0.48,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg5"
  },
  {
   "speaker": "user",
   "text": "like a single layer in.",
   "est_sec": 1.65,
   "gap_before": 2.33,
   "block": "baking.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That'll be it. Also leave a bit of pastry hanging over the edge and trim it after baking, so any shrinking doesn't matter.",
   "est_sec": 7.23,
   "gap_before": 0.44,
   "role": "reply",
   "block": "baking.dlg5"
  },
  {
   "speaker": "user",
   "text": "Trim after? That feels backwards.",
   "est_sec": 1.65,
   "gap_before": 1.06,
   "block": "baking.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It does, but a sharp knife on cooled pastry gives you a really clean edge.",
   "est_sec": 4.75,
   "gap_before": 0.98,
   "role": "reply",
   "block": "baking.dlg5"
  }
 ]
}
