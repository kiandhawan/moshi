 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.74,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.36,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "My fourteen year old is bored out of his mind every weekend. He just wants to game.",
   "est_sec": 5.37,
   "gap_before": 0.2,
   "block": "weekend_plans.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's very normal at fourteen. Is there anything he's into besides games?",
   "est_sec": 3.82,
   "gap_before": 0.7,
   "role": "reply",
   "block": "weekend_plans.dlg6"
  },
  {
   "speaker": "user",
   "text": "He used to like skateboarding, I think.",
   "est_sec": 2.27,
   "gap_before": 1.21,
   "block": "weekend_plans.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A skate park session with a friend could be a good start. Or let him try something that feels grown up, like an indoor climbing session.",
   "est_sec": 8.16,
   "gap_before": 0.59,
   "role": "reply",
   "block": "weekend_plans.dlg6"
  },
  {
   "speaker": "user",
   "text": "He'd probably say climbing is",
   "est_sec": 1.65,
   "gap_before": 0.49,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg6"
  },
  {
   "speaker": "user",
   "text": "for nerds.",
   "est_sec": 0.72,
   "gap_before": 2.16,
   "block": "weekend_plans.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then let him pick something himself from a short list. Teenagers say yes more when it's their choice.",
   "est_sec": 5.68,
   "gap_before": 0.45,
   "role": "reply",
   "block": "weekend_plans.dlg6"
  },
  {
   "speaker": "user",
   "text": "Smart. And if he still says no?",
   "est_sec": 2.27,
   "gap_before": 0.94,
   "block": "weekend_plans.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Try a deal. Gaming time in the evening, something out of the house in the afternoon.",
   "est_sec": 5.06,
   "gap_before": 0.94,
   "role": "reply",
   "block": "weekend_plans.dlg6"
  }
 ]
