 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.32,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.63,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "How do you clean a mattress? I've never done it in my life.",
   "est_sec": 4.13,
   "gap_before": 0.48,
   "block": "cleaning.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most people haven't. Strip the bed, vacuum the mattress with the upholstery tool, especially the seams.",
   "est_sec": 5.06,
   "gap_before": 1.05,
   "role": "reply",
   "block": "cleaning.dlg12"
  },
  {
   "speaker": "user",
   "text": "Then what?",
   "est_sec": 0.72,
   "gap_before": 0.88,
   "block": "cleaning.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sprinkle baking soda over the top, leave it for a few hours, then vacuum it up. It freshens it nicely.",
   "est_sec": 6.3,
   "gap_before": 1.01,
   "role": "reply",
   "block": "cleaning.dlg12"
  },
  {
   "speaker": "user",
   "text": "There's a yellow stain on one side. Can't remember",
   "est_sec": 2.89,
   "gap_before": 1.28,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg12"
  },
  {
   "speaker": "user",
   "text": "from what.",
   "est_sec": 0.72,
   "gap_before": 2.64,
   "block": "cleaning.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Dab it with a mild mix of washing-up liquid and cool water, don't soak it. Then let it dry fully before the sheets go back on.",
   "est_sec": 8.16,
   "gap_before": 1.07,
   "role": "reply",
   "block": "cleaning.dlg12"
  },
  {
   "speaker": "user",
   "text": "I'll do it while I'm at work. Leave the window open.",
   "est_sec": 3.51,
   "gap_before": 0.68,
   "block": "cleaning.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ideal. Fresh air helps it dry too.",
   "est_sec": 2.27,
   "gap_before": 0.68,
   "role": "reply",
   "block": "cleaning.dlg12"
  }
 ]
}
