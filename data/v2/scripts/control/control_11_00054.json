 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.64,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "My four-year-old drew on our cream leather sofa. With a biro.",
   "est_sec": 3.51,
   "gap_before": 0.4,
   "block": "cleaning.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Oh dear. Act fast, ink sets over time. Dab a cotton bud with a little rubbing alcohol and touch only the ink lines.",
   "est_sec": 7.23,
   "gap_before": 0.69,
   "role": "reply",
   "block": "cleaning.dlg13"
  },
  {
   "speaker": "user",
   "text": "Won't that hurt the leather?",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "block": "cleaning.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Test it on a hidden spot first, like the back. And dab, don't rub, or you'll spread it.",
   "est_sec": 5.68,
   "gap_before": 0.89,
   "role": "reply",
   "block": "cleaning.dlg13"
  },
  {
   "speaker": "user",
   "text": "Okay. It's lifting on",
   "est_sec": 1.34,
   "gap_before": 1.34,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg13"
  },
  {
   "speaker": "user",
   "text": "the test bit.",
   "est_sec": 1.03,
   "gap_before": 2.52,
   "block": "cleaning.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good. Work slowly along the lines, then wipe with a damp cloth and use leather conditioner afterwards.",
   "est_sec": 5.37,
   "gap_before": 0.59,
   "role": "reply",
   "block": "cleaning.dlg13"
  },
  {
   "speaker": "user",
   "text": "And hide every pen in the house.",
