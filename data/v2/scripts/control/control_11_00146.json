 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.79,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.67,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "My daughter wants a hamster for her birthday. Are they good first pets?",
   "est_sec": 4.13,
   "gap_before": 0.2,
   "block": "pets.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "They can be, but they're awake mostly at night and can nip if handled roughly. How old is she?",
   "est_sec": 5.99,
   "gap_before": 0.51,
   "role": "reply",
   "block": "pets.dlg2"
  },
  {
   "speaker": "user",
   "text": "Apparently, Moshi can't help with tax returns, sadly.",
   "est_sec": 2.58,
   "gap_before": 0.9,
   "block": "mm_049",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_049",
   "name_pos": "none"
  },
  {
   "speaker": "other",
   "text": "Nobody can help with tax returns.",
   "est_sec": 1.96,
   "gap_before": 0.49,
   "block": "mm_049"
  },
  {
   "speaker": "user",
   "text": "She's turning eight.",
   "est_sec": 1.03,
   "gap_before": 1.44,
   "block": "pets.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a fine age with some supervision. A big cage, a wheel and a deep layer of bedding are the essentials.",
   "est_sec": 6.61,
   "gap_before": 0.69,
   "role": "reply",
   "block": "pets.dlg2"
  },
  {
   "speaker": "user",
   "text": "Would a guinea pig be better? I've heard",
   "est_sec": 2.58,
   "gap_before": 0.94,
   "event": "distractor",
   "kind": "pause",
   "block": "pets.dlg2"
  },
  {
   "speaker": "user",
   "text": "they're friendlier.",
   "est_sec": 0.72,
   "gap_before": 1.51,
   "block": "pets.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Guinea pigs are usually calmer and awake during the day, so they're great with kids. But they're happier in pairs.",
   "est_sec": 6.3,
   "gap_before": 1.12,
   "role": "reply",
   "block": "pets.dlg2"
  },
  {
   "speaker": "user",
   "text": "Two of them? That's double the cleaning.",
   "est_sec": 2.27,
   "gap_before": 0.81,
   "block": "pets.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "True, but one cage and they keep each other company. It's honestly not much more work.",
   "est_sec": 5.06,
   "gap_before": 0.61,
   "role": "reply",
   "block": "pets.dlg2"
  }
 ]
}
