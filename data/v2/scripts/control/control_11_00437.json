 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.58,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "My dad refuses to watch foreign films because he hates subtitles. Any way around that?",
   "est_sec": 4.75,
   "gap_before": 0.27,
   "block": "movies.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A lot of international films now have good English dubs. Dubbing has improved a lot.",
   "est_sec": 4.75,
   "gap_before": 0.64,
   "role": "reply",
   "block": "movies.dlg17"
  },
  {
   "speaker": "user",
   "text": "He'd probably say dubbing is worse.",
   "est_sec": 1.96,
   "gap_before": 1.03,
   "block": "movies.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then maybe ease him in with films that don't have much dialogue. Some great action films or animations are mostly visual.",
   "est_sec": 6.61,
   "gap_before": 1.11,
   "role": "reply",
   "block": "movies.dlg17"
  },
  {
   "speaker": "user",
   "text": "Do we have any envelopes left, Emery?",
   "est_sec": 2.27,
   "gap_before": 0.45,
   "block": "nq_work_012",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_work_012",
   "name_pos": "end",
   "addressee": "Emery"
  },
  {
   "speaker": "other",
   "text": "Top shelf, the brown ones.",
   "est_sec": 1.65,
   "gap_before": 0.67,
   "block": "nq_work_012"
  },
  {
   "speaker": "user",
   "text": "Oh, he does love",
   "est_sec": 1.34,
   "gap_before": 1.44,
   "event": "distractor",
   "kind": "pause",
   "block": "movies.dlg17"
  },
  {
   "speaker": "user",
   "text": "a good chase scene.",
   "est_sec": 1.34,
   "gap_before": 2.3,
   "block": "movies.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Perfect. Start with a fast action film from Korea or Hong Kong. Once he's hooked, the subtitles won't feel like reading.",
   "est_sec": 6.61,
   "gap_before": 1.67,
   "role": "reply",
   "block": "movies.dlg17"
  },
  {
   "speaker": "user",
   "text": "Sneaky. I like it.",
   "est_sec": 1.34,
   "gap_before": 0.94,
   "block": "movies.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "And sit him close to the screen. Subtitles are much easier to read when you're not squinting from across the room.",
   "est_sec": 6.61,
   "gap_before": 1.09,
   "role": "reply",
   "block": "movies.dlg17"
  }
