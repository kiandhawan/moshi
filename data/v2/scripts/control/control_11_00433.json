 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.67,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.5,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "I'm drowning in post. Leaflets, bills, letters. They pile up on the kitchen counter.",
   "est_sec": 4.44,
   "gap_before": 0.32,
   "block": "cleaning.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Try a rule of handling each piece once. When it comes through the door, recycle the junk standing right by the bin.",
   "est_sec": 6.92,
   "gap_before": 0.83,
   "role": "reply",
   "block": "cleaning.dlg19"
  },
  {
   "speaker": "user",
   "text": "And the",
   "est_sec": 0.72,
   "gap_before": 0.75,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg19"
  },
  {
   "speaker": "user",
   "text": "real stuff?",
   "est_sec": 0.72,
   "gap_before": 2.09,
   "block": "cleaning.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "One tray for things to act on, like bills. Everything else gets filed or scanned on a set day.",
   "est_sec": 5.99,
   "gap_before": 0.91,
   "role": "reply",
   "block": "cleaning.dlg19"
  },
  {
   "speaker": "user",
   "text": "What day?",
   "est_sec": 0.72,
   "gap_before": 1.76,
   "block": "cleaning.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Whichever you'll stick to. Many people pick Sunday evening, ten minutes with a cup of tea.",
   "est_sec": 5.06,
   "gap_before": 1.03,
   "role": "reply",
   "block": "cleaning.dlg19"
  },
  {
   "speaker": "user",
   "text": "I'll do Sunday. And put a no junk mail sign on the door.",
   "est_sec": 4.13,
   "gap_before": 0.99,
   "block": "cleaning.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That alone cuts it down a lot.",
   "est_sec": 2.27,
   "gap_before": 0.43,
   "role": "reply",
   "block": "cleaning.dlg19"
  }
 ]
