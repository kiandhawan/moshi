 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.6,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "Why does my new jumper already have little bobbles all over it?",
   "est_sec": 3.82,
   "gap_before": 0.36,
   "block": "shopping.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's pilling. Short loose fibres rub together and twist into little balls, especially under the arms and on the sides.",
   "est_sec": 6.3,
   "gap_before": 1.14,
   "role": "reply",
   "block": "shopping.dlg27"
  },
  {
   "speaker": "user",
   "text": "It was not cheap.",
   "est_sec": 1.34,
   "gap_before": 0.48,
   "block": "shopping.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sadly price doesn't always mean quality. Blends with lots of acrylic and very soft loose knits pill fastest.",
   "est_sec": 5.68,
   "gap_before": 0.47,
   "role": "reply",
   "block": "shopping.dlg27"
  },
  {
   "speaker": "user",
   "text": "Um, Gabriel, did you mean to leave the bath running?",
   "est_sec": 3.2,
   "gap_before": 0.71,
   "block": "nq_home_011",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_011",
   "name_pos": "start",
   "addressee": "Gabriel"
  },
  {
   "speaker": "other",
   "text": "Oh no. Turn it off!",
   "est_sec": 1.65,
   "gap_before": 0.58,
   "block": "nq_home_011"
  },
  {
   "speaker": "user",
   "text": "Can I fix it?",
   "est_sec": 1.34,
   "gap_before": 1.38,
   "block": "shopping.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A fabric shaver or a de pilling comb takes them off quickly. Wash it inside out on a gentle cycle to slow it down.",
   "est_sec": 7.54,
   "gap_before": 0.62,
   "role": "reply",
   "block": "shopping.dlg27"
  },
  {
   "speaker": "user",
   "text": "And next time?",
   "est_sec": 1.03,
   "gap_before": 1.48,
   "block": "shopping.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Feel the knit. Tighter knits and longer fibres like merino or good cotton hold up better. Check the label before you fall in love.",
   "est_sec": 7.54,
   "gap_before": 1.07,
   "role": "reply",
   "block": "shopping.dlg27"
  }
 ]
}
