 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.38,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.75,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "My flight got overbooked and they want volunteers to take a later one. Should I do it?",
   "est_sec": 5.37,
   "gap_before": 0.54,
   "block": "travel_planning.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It depends on your plans. If you're flexible, you can often get a voucher or cash for it.",
   "est_sec": 5.68,
   "gap_before": 0.71,
   "role": "reply",
   "block": "travel_planning.dlg27"
  },
  {
   "speaker": "user",
   "text": "What should I ask for?",
   "est_sec": 1.65,
   "gap_before": 1.12,
   "block": "travel_planning.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ask what the compensation is, when the new flight leaves, and whether they'll cover meals or a hotel if it's the next day.",
   "est_sec": 7.23,
   "gap_before": 1.11,
   "role": "reply",
   "block": "travel_planning.dlg27"
  },
  {
   "speaker": "user",
   "text": "Hang on, I missed that.",
   "est_sec": 1.65,
   "gap_before": 1.44,
   "block": "travel_planning.dlg27",
   "kind": "wait_like",
   "phrasing": "waitlike_04",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "No problem. Ask what the compensation is, when the new flight leaves, and whether they'll cover meals or a hotel if it's the next day.",
   "est_sec": 7.85,
   "gap_before": 0.73,
   "role": "reply",
   "block": "travel_planning.dlg27"
  },
  {
   "speaker": "user",
   "text": "Can I negotiate?",
   "est_sec": 1.03,
   "gap_before": 1.22,
   "block": "travel_planning.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sometimes. If nobody volunteers, the offer often goes up, so you don't have to accept the first one.",
   "est_sec": 5.68,
   "gap_before": 1.01,
   "role": "reply",
   "block": "travel_planning.dlg27"
  },
  {
   "speaker": "user",
   "text": "It's only a four hour wait",
   "est_sec": 1.96,
   "gap_before": 1.07,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg27"
  },
  {
   "speaker": "user",
   "text": "so I'm tempted.",
   "est_sec": 1.03,
   "gap_before": 1.58,
   "block": "travel_planning.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then it could be a good deal. Make sure your new seat is confirmed before you give up your current one.",
   "est_sec": 6.61,
   "gap_before": 1.14,
   "role": "reply",
   "block": "travel_planning.dlg27"
  },
  {
   "speaker": "user",
   "text": "Smart. Going to the desk now.",
   "est_sec": 1.96,
   "gap_before": 0.57,
   "block": "travel_planning.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good luck. Ask for a lounge pass too while you're there.",
   "est_sec": 3.51,
   "gap_before": 0.51,
   "role": "reply",
   "block": "travel_planning.dlg27"
  }
 ]
