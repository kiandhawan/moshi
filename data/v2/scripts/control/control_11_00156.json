 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.47,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.87,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "I've been asked to DJ my cousin's house party. I've never done it.",
   "est_sec": 4.13,
   "gap_before": 0.51,
   "block": "music.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Fun. You don't need fancy gear. A laptop with DJ software and a cheap controller is plenty for a house party.",
   "est_sec": 6.61,
   "gap_before": 0.42,
   "role": "reply",
   "block": "music.dlg28"
  },
  {
   "speaker": "user",
   "text": "What about the mixing part?",
   "est_sec": 1.65,
   "gap_before": 3.31,
   "block": "music.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Keep it simple. Let songs play most of the way through, and fade from one to the next where it feels natural.",
   "est_sec": 6.92,
   "gap_before": 0.6,
   "role": "reply",
   "block": "music.dlg28"
  },
  {
   "speaker": "user",
   "text": "How do I",
   "est_sec": 1.03,
   "gap_before": 0.58,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg28"
  },
  {
   "speaker": "user",
   "text": "keep people dancing?",
   "est_sec": 1.03,
   "gap_before": 2.05,
   "block": "music.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Watch the room. Start chill as people arrive, build up once the room fills, and drop the big crowd favourites when the energy peaks.",
   "est_sec": 7.54,
   "gap_before": 0.7,
   "role": "reply",
   "block": "music.dlg28"
  },
  {
   "speaker": "user",
   "text": "And requests?",
   "est_sec": 0.72,
   "gap_before": 0.38,
   "block": "music.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Take them, but play them when they fit the mood. A slow ballad in the middle of a dance bit can empty the floor.",
   "est_sec": 7.54,
   "gap_before": 0.69,
   "role": "reply",
   "block": "music.dlg28"
  }
 ]
}
