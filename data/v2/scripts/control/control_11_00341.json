 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.52,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.97,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "Is vinyl actually better quality than streaming, or is it just trendy?",
   "est_sec": 3.82,
   "gap_before": 0.44,
   "block": "music.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's a bit of both. Vinyl sounds different, warmer for some people, but it's not technically more detailed than a good digital file.",
   "est_sec": 7.23,
   "gap_before": 1.99,
   "role": "reply",
   "block": "music.dlg11"
  },
  {
   "speaker": "user",
   "text": "Then why do people love it so much?",
   "est_sec": 2.58,
   "gap_before": 1.5,
   "block": "music.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "The ritual, mostly. Choosing a record, the big artwork, listening to a whole album side without skipping.",
   "est_sec": 5.37,
   "gap_before": 1.14,
   "role": "reply",
   "block": "music.dlg11"
  },
  {
   "speaker": "user",
   "text": "That actually",
   "est_sec": 0.72,
   "gap_before": 0.52,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg11"
  },
  {
   "speaker": "user",
   "text": "sounds really nice.",
   "est_sec": 1.03,
   "gap_before": 2.94,
   "block": "music.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It is. You also tend to listen more closely when you can't just skip to the next song.",
   "est_sec": 5.68,
   "gap_before": 0.47,
   "role": "reply",
   "block": "music.dlg11"
  },
  {
   "speaker": "user",
   "text": "Are records expensive?",
   "est_sec": 1.03,
   "gap_before": 1.11,
   "block": "music.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "New ones can be. Second hand shops and car boot sales are where the bargains are, and the hunt is half the fun.",
   "est_sec": 7.23,
   "gap_before": 0.52,
   "role": "reply",
   "block": "music.dlg11"
  }
 ]
}
