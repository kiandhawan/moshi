 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.55,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.51,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "My teacher keeps telling me to practise with a metronome. I find it so boring.",
   "est_sec": 4.75,
   "gap_before": 0.29,
   "block": "music.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Fair, it's not thrilling. But it's one of the fastest ways to clean up your playing.",
   "est_sec": 5.06,
   "gap_before": 0.62,
   "role": "reply",
   "block": "music.dlg8"
  },
  {
   "speaker": "user",
   "text": "Why does it matter so much?",
   "est_sec": 1.96,
   "gap_before": 0.39,
   "block": "music.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most people rush the easy bits and slow down on the hard bits. A metronome shows you exactly where.",
   "est_sec": 5.99,
   "gap_before": 0.33,
   "role": "reply",
   "block": "music.dlg8"
  },
  {
   "speaker": "user",
   "text": "I just feel",
   "est_sec": 1.03,
   "gap_before": 0.66,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg8"
  },
  {
   "speaker": "user",
   "text": "kind of robotic with it on.",
   "est_sec": 1.96,
   "gap_before": 2.76,
   "block": "music.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's normal at first. Try setting it slow and only practising the tricky bars with it, not the whole piece.",
   "est_sec": 6.3,
   "gap_before": 0.41,
   "role": "reply",
   "block": "music.dlg8"
  },
  {
   "speaker": "user",
   "text": "Okay, that sounds less painful.",
   "est_sec": 1.65,
   "gap_before": 0.83,
   "block": "music.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "And make it a game. Every time you play the bit perfectly three times in a row, nudge the speed up a little.",
   "est_sec": 7.23,
   "gap_before": 0.83,
   "role": "reply",
   "block": "music.dlg8"
  }
 ]
