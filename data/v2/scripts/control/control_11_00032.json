 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.63,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "My sixteen-year-old is impossible to wake up. Moshi, school starts at eight.",
   "est_sec": 3.82,
   "gap_before": 0.25,
   "block": "sleep.dlg13",
   "kind": "moshi_name",
   "name_pos": "middle",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Teens' body clocks genuinely shift later, so it's not just laziness. They often can't feel sleepy before eleven.",
   "est_sec": 5.68,
   "gap_before": 0.56,
   "role": "reply",
   "block": "sleep.dlg13"
  },
  {
   "speaker": "user",
   "text": "So what do I do?",
   "est_sec": 1.65,
   "gap_before": 0.95,
   "event": "distractor",
   "kind": "pause",
   "block": "sleep.dlg13"
  },
  {
   "speaker": "user",
   "text": "Let him sleep till noon?",
   "est_sec": 1.65,
   "gap_before": 2.48,
   "block": "sleep.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "On school days, help him get to bed a little earlier by putting screens away at ten, and open the curtains as soon as he wakes.",
   "est_sec": 8.16,
   "gap_before": 1.3,
   "role": "reply",
   "block": "sleep.dlg13"
  },
  {
   "speaker": "user",
   "text": "He'll hate that.",
   "est_sec": 1.03,
   "gap_before": 1.49,
   "block": "sleep.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Probably. Explain the why, teens respond better when they understand it. And keep weekend lie-ins to an hour or two longer, not until afternoon.",
   "est_sec": 7.54,
   "gap_before": 0.38,
   "role": "reply",
   "block": "sleep.dlg13"
  },
  {
   "speaker": "user",
   "text": "An hour or two. Okay, that's fair.",
   "est_sec": 2.27,
   "gap_before": 1.39,
   "block": "sleep.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "And breakfast with some protein helps him actually feel awake.",
   "est_sec": 3.2,
   "gap_before": 0.61,
   "role": "reply",
   "block": "sleep.dlg13"
  }
 ]
