 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.48,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.54,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "What are my chances of seeing the northern lights in Iceland in late February?",
   "est_sec": 4.44,
   "gap_before": 0.52,
   "block": "travel_planning.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Late February is actually a decent time. The nights are still long, and the season runs roughly from September to April.",
   "est_sec": 6.61,
   "gap_before": 0.93,
   "role": "reply",
   "block": "travel_planning.dlg24"
  },
  {
   "speaker": "user",
   "text": "Do I need a tour?",
   "est_sec": 1.65,
   "gap_before": 2.52,
   "block": "travel_planning.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not necessarily, but tours know where the skies are clear. If you rent a car, check the aurora forecast and cloud cover each evening.",
   "est_sec": 7.54,
   "gap_before": 0.81,
   "role": "reply",
   "block": "travel_planning.dlg24"
  },
  {
   "speaker": "user",
   "text": "Is there an app or something?",
   "est_sec": 1.96,
   "gap_before": 1.07,
   "block": "travel_planning.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, the Icelandic weather office has an aurora forecast online, and there are several apps.",
   "est_sec": 4.75,
   "gap_before": 0.37,
   "role": "reply",
   "block": "travel_planning.dlg24"
  },
  {
   "speaker": "user",
   "text": "And if it's cloudy all week?",
   "est_sec": 1.96,
   "gap_before": 3.23,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg24"
  },
  {
   "speaker": "user",
   "text": "I'll be so sad.",
   "est_sec": 1.34,
   "gap_before": 2.62,
   "block": "travel_planning.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It can happen, so plan other things too, like hot springs and waterfalls. Staying four or five nights gives you more chances.",
   "est_sec": 6.92,
   "gap_before": 0.6,
   "role": "reply",
   "block": "travel_planning.dlg24"
  },
  {
   "speaker": "user",
   "text": "Five nights then.",
   "est_sec": 1.03,
   "gap_before": 0.34,
   "block": "travel_planning.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good choice. Pack warm, the waiting outside can get chilly.",
   "est_sec": 3.2,
   "gap_before": 1.5,
   "role": "reply",
   "block": "travel_planning.dlg24"
  }
 ]
}
