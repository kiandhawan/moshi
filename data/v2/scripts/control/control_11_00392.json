 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.73,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.72,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "Got a horrible calf cramp at three this morning. I yelled so loud I woke the dog.",
   "est_sec": 5.37,
   "gap_before": 0.47,
   "block": "sleep.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ouch. When it happens, flex your foot toward your knee, it stretches the muscle and usually eases it.",
   "est_sec": 5.68,
   "gap_before": 0.32,
   "role": "reply",
   "block": "sleep.dlg8"
  },
  {
   "speaker": "user",
   "text": "Why does it even happen, Moshi?",
   "est_sec": 1.96,
   "gap_before": 0.49,
   "block": "sleep.dlg8",
   "kind": "moshi_name",
   "name_pos": "end",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Common triggers are dehydration, a long day on your feet, or a lot of exercise. Sometimes there's no clear reason.",
   "est_sec": 6.3,
   "gap_before": 1.13,
   "role": "reply",
   "block": "sleep.dlg8"
  },
  {
   "speaker": "user",
   "text": "I did walk",
   "est_sec": 1.03,
   "gap_before": 0.94,
   "event": "distractor",
   "kind": "pause",
   "block": "sleep.dlg8"
  },
  {
   "speaker": "user",
   "text": "a lot yesterday, actually.",
   "est_sec": 1.34,
   "gap_before": 1.6,
   "block": "sleep.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's likely it. A gentle calf stretch before bed and a glass of water can help prevent the next one.",
   "est_sec": 6.3,
   "gap_before": 0.89,
   "role": "reply",
   "block": "sleep.dlg8"
  },
  {
   "speaker": "user",
   "text": "And if it keeps happening?",
   "est_sec": 1.65,
   "gap_before": 0.88,
   "block": "sleep.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then mention it to your doctor, especially if it's often or painful during the day.",
   "est_sec": 4.75,
   "gap_before": 0.93,
   "role": "reply",
   "block": "sleep.dlg8"
  }
 ]
