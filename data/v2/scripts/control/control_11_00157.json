 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.9,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "The steam wand on our espresso machine smells funky. Like old milk.",
   "est_sec": 3.82,
   "gap_before": 0.36,
   "block": "coffee.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's milk getting sucked up inside the wand and going off. Luckily it's easy to fix.",
   "est_sec": 5.06,
   "gap_before": 0.91,
   "role": "reply",
   "block": "coffee.dlg21"
  },
  {
   "speaker": "user",
   "text": "How do I clean inside it?",
   "est_sec": 1.96,
   "gap_before": 1.03,
   "block": "coffee.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Soak the tip in a cup of hot water with a little milk system cleaner, then purge steam through it a few times. Wipe the outside too.",
   "est_sec": 8.47,
   "gap_before": 0.42,
   "role": "reply",
   "block": "coffee.dlg21"
  },
  {
   "speaker": "user",
   "text": "Thanh, is it your turn to present on Thursday?",
   "est_sec": 2.89,
   "gap_before": 1.07,
   "block": "nq_work_003",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_work_003",
   "name_pos": "start",
   "addressee": "Thanh"
  },
  {
   "speaker": "other",
   "text": "Sadly, yes.",
   "est_sec": 0.72,
   "gap_before": 0.71,
   "block": "nq_work_003"
  },
  {
   "speaker": "user",
   "text": "There's a little",
   "est_sec": 1.03,
   "gap_before": 0.9,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg21"
  },
  {
   "speaker": "user",
   "text": "hole that seems blocked.",
   "est_sec": 1.34,
   "gap_before": 2.55,
   "block": "coffee.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Use a pin or the small tool that came with the machine to gently clear it. Some tips unscrew so you can soak them properly.",
   "est_sec": 7.85,
   "gap_before": 0.33,
   "role": "reply",
   "block": "coffee.dlg21"
  },
  {
   "speaker": "user",
   "text": "How do I stop it happening again?",
   "est_sec": 2.27,
   "gap_before": 1.14,
   "block": "coffee.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "After every use, wipe the wand with a damp cloth and blast a short burst of steam. Two seconds of habit saves a lot of smell.",
   "est_sec": 8.16,
   "gap_before": 1.07,
   "role": "reply",
   "block": "coffee.dlg21"
  }
 ]
