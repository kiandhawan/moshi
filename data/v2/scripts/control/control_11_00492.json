   "block": "cleaning.dlg23",
   "kind": "moshi_name",
   "name_pos": "end",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Pick one surface you see a lot, like your bedside table. Clear only that.",
