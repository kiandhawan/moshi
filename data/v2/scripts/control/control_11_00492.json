   "gap_before": 0.39,
   "block": "cleaning.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That sounds really hard, and it's very common. Let's make it tiny. Could you do just five minutes, with a timer?",
