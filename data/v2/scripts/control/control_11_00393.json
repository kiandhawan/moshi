 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.45,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.31,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "We're taking a ferry to the islands and I get seasick on basically anything.",
   "est_sec": 4.44,
   "gap_before": 0.23,
   "block": "travel_planning.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sit in the middle of the boat on a lower deck, where there's the least movement, and look at the horizon.",
   "est_sec": 6.61,
   "gap_before": 1.08,
   "role": "reply",
   "block": "travel_planning.dlg17"
  },
  {
   "speaker": "user",
   "text": "Not inside reading?",
   "est_sec": 1.03,
   "gap_before": 1.36,
   "block": "travel_planning.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Definitely not reading. That's one of the worst things for seasickness.",
   "est_sec": 3.51,
   "gap_before": 1.04,
   "role": "reply",
   "block": "travel_planning.dlg17"
  },
  {
   "speaker": "user",
   "text": "What about pills?",
   "est_sec": 1.03,
   "gap_before": 0.96,
   "block": "travel_planning.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Motion sickness tablets work well for many people. Take them before you get on, not after you start feeling sick.",
   "est_sec": 6.3,
   "gap_before": 0.89,
   "role": "reply",
   "block": "travel_planning.dlg17"
  },
  {
   "speaker": "user",
   "text": "They make me drowsy though",
   "est_sec": 1.65,
   "gap_before": 1.05,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg17"
  },
  {
   "speaker": "user",
   "text": "is there anything else?",
   "est_sec": 1.34,
   "gap_before": 1.78,
   "block": "travel_planning.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Some people find ginger sweets or wristbands helpful. Fresh air on deck helps too, if it's not too rough.",
   "est_sec": 5.99,
   "gap_before": 1.23,
   "role": "reply",
   "block": "travel_planning.dlg17"
  }
 ]
}
