 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.56,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.9,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "I'm allergic to dust and I sneeze my way through every cleaning session.",
   "est_sec": 4.13,
   "gap_before": 0.48,
   "block": "cleaning.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's rough. Dust with a slightly damp microfibre cloth instead of a dry duster. It traps dust rather than throwing it in the air.",
   "est_sec": 7.54,
   "gap_before": 0.78,
   "role": "reply",
   "block": "cleaning.dlg31"
  },
  {
   "speaker": "user",
   "text": "How much did the flights end up costing, Brooklyn?",
   "est_sec": 2.89,
   "gap_before": 0.96,
   "block": "nq_social_074",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_074",
   "name_pos": "end",
   "addressee": "Brooklyn"
  },
  {
   "speaker": "user",
   "text": "Should I wear a mask?",
   "est_sec": 1.65,
   "gap_before": 2.96,
   "block": "cleaning.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A simple mask helps a lot. And a vacuum with a HEPA filter, which keeps fine dust inside.",
   "est_sec": 5.68,
   "gap_before": 0.53,
   "role": "reply",
   "block": "cleaning.dlg31"
  },
  {
   "speaker": "user",
   "text": "Minh, Moshi just told me it's going to rain all weekend.",
   "est_sec": 3.51,
   "gap_before": 2.59,
   "block": "mm_010",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_010",
   "name_pos": "start",
   "addressee": "Minh"
  },
  {
   "speaker": "other",
   "text": "Ugh, there go our plans.",
   "est_sec": 1.65,
   "gap_before": 0.58,
   "block": "mm_010"
  },
