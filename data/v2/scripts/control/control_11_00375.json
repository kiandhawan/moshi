 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.33,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "I'm doing a ten hour overnight coach next week. I need survival tips.",
   "est_sec": 4.13,
   "gap_before": 0.31,
   "block": "public_transport.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Respect. A neck pillow, an eye mask and earplugs are the holy trinity.",
   "est_sec": 4.13,
   "gap_before": 1.19,
   "role": "reply",
   "block": "public_transport.dlg31"
  },
  {
   "speaker": "user",
   "text": "Hold on, really?",
   "est_sec": 1.03,
   "gap_before": 0.93,
   "block": "public_transport.dlg31",
   "kind": "wait_like",
   "phrasing": "waitlike_11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Hmm, I believe it is. Which part doesn't sound right?",
   "est_sec": 3.2,
   "gap_before": 0.49,
   "role": "reply",
   "block": "public_transport.dlg31"
  },
  {
   "speaker": "user",
   "text": "Where should I sit?",
   "est_sec": 1.34,
   "gap_before": 1.31,
   "block": "public_transport.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Somewhere in the middle, away from the toilet and not right over the wheels. A window seat lets you lean and control the curtain.",
   "est_sec": 7.54,
   "gap_before": 1.12,
   "role": "reply",
   "block": "public_transport.dlg31"
  },
  {
   "speaker": "user",
   "text": "What about",
   "est_sec": 0.72,
   "gap_before": 0.51,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg31"
  },
  {
   "speaker": "user",
   "text": "food and stuff?",
   "est_sec": 1.03,
   "gap_before": 1.75,
   "block": "public_transport.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Bring snacks and water, but nothing too salty. And wear layers, coaches swing from boiling to freezing.",
   "est_sec": 5.37,
   "gap_before": 0.44,
   "role": "reply",
   "block": "public_transport.dlg31"
  },
  {
   "speaker": "user",
   "text": "Anything to help actually sleep?",
   "est_sec": 1.65,
   "gap_before": 1.3,
   "block": "public_transport.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Download a long, boring podcast. And put your shoes somewhere you'll find them in the dark.",
   "est_sec": 5.06,
   "gap_before": 0.55,
   "role": "reply",
   "block": "public_transport.dlg31"
  },
  {
   "speaker": "user",
   "text": "Very specific advice.",
   "est_sec": 1.03,
   "gap_before": 1.42,
   "block": "public_transport.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Learned the hard way, I imagine, by many people.",
   "est_sec": 2.89,
   "gap_before": 0.39,
