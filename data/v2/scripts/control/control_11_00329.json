 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.96,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "My wife wants me to regrout the kitchen backsplash before her parents visit. I've got two days.",
   "est_sec": 5.37,
   "gap_before": 0.36,
   "block": "home_repair.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Two days is enough if you start today. Is the grout cracked, or just stained?",
   "est_sec": 4.75,
   "gap_before": 0.49,
   "role": "reply",
   "block": "home_repair.dlg28"
  },
  {
   "speaker": "user",
   "text": "You know Moshi helped me plan your surprise, right, Katya?",
   "est_sec": 3.2,
   "gap_before": 1.16,
   "block": "mm_127",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_127",
   "name_pos": "end",
   "addressee": "Katya"
  },
  {
   "speaker": "other",
   "text": "Seriously? That was Moshi?",
   "est_sec": 1.34,
   "gap_before": 0.93,
   "block": "mm_127"
  },
  {
   "speaker": "user",
   "text": "Wait, what did you say?",
   "est_sec": 1.65,
   "gap_before": 1.89,
   "block": "home_repair.dlg28",
   "kind": "wait_like",
   "phrasing": "waitlike_01",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sure. Two days is enough if you start today. Is the grout cracked, or just stained?",
   "est_sec": 5.06,
   "gap_before": 1.02,
   "role": "reply",
   "block": "home_repair.dlg28"
  },
  {
   "speaker": "user",
   "text": "Cracked and falling out in places.",
   "est_sec": 1.96,
   "gap_before": 2.4,
   "block": "home_repair.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then scrape out the damaged grout with a grout rake, vacuum the dust, and press new grout in with a rubber float.",
   "est_sec": 6.92,
   "gap_before": 0.94,
   "role": "reply",
   "block": "home_repair.dlg28"
  },
  {
   "speaker": "user",
   "text": "How long does it take to set?",
   "est_sec": 2.27,
   "gap_before": 0.71,
   "block": "home_repair.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Usually it's dry to touch in a few hours, but give it a full day before wiping the backsplash hard.",
   "est_sec": 6.3,
   "gap_before": 1.04,
   "role": "reply",
   "block": "home_repair.dlg28"
  },
  {
   "speaker": "user",
   "text": "Do I need to seal it after?",
   "est_sec": 2.27,
   "gap_before": 3.15,
   "block": "home_repair.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's a good idea in a kitchen, it stops grease staining it again. Many sealers need a day though, so do it tomorrow evening.",
   "est_sec": 7.54,
   "gap_before": 0.81,
   "role": "reply",
   "block": "home_repair.dlg28"
  }
 ]
