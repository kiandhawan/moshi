 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.41,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "I want to write song lyrics but everything I write sounds cheesy.",
   "est_sec": 3.82,
   "gap_before": 0.28,
   "block": "music.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most first drafts do. One trick is to swap general words for specific ones. Instead of saying I miss you, describe one small detail.",
   "est_sec": 7.54,
   "gap_before": 1.42,
   "role": "reply",
   "block": "music.dlg13"
  },
  {
   "speaker": "user",
   "text": "Like what?",
   "est_sec": 0.72,
   "gap_before": 1.21,
   "block": "music.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Like your coffee mug still on the shelf. A concrete image makes people feel it without you saying it.",
   "est_sec": 5.99,
   "gap_before": 0.43,
   "role": "reply",
   "block": "music.dlg13"
  },
  {
   "speaker": "user",
   "text": "Oh, I like that. What about rhymes? Mine",
   "est_sec": 2.58,
   "gap_before": 2.99,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg13"
  },
  {
   "speaker": "user",
   "text": "always feel forced.",
   "est_sec": 1.03,
   "gap_before": 2.52,
   "block": "music.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Try near rhymes, words that almost rhyme, like home and alone. They sound more natural and give you way more options.",
   "est_sec": 6.61,
   "gap_before": 1.26,
   "role": "reply",
   "block": "music.dlg13"
  },
  {
   "speaker": "user",
   "text": "Near rhymes. Got it.",
   "est_sec": 1.34,
   "gap_before": 3.48,
   "block": "music.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "And say your lines out loud. If you wouldn't say it in real life, it'll probably sound cheesy when sung.",
   "est_sec": 6.3,
   "gap_before": 1.15,
   "role": "reply",
   "block": "music.dlg13"
  }
 ]
}
