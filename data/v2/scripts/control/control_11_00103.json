 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.51,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "It's been raining for a week and I'm getting cabin fever. Any photo ideas that don't need sunshine?",
   "est_sec": 5.68,
   "gap_before": 0.2,
   "block": "photography.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Rain is actually brilliant for photos. Puddle reflections, drops on a window with city lights behind, umbrellas from above.",
   "est_sec": 5.99,
   "gap_before": 1.12,
   "role": "reply",
   "block": "photography.dlg20"
  },
  {
   "speaker": "user",
   "text": "Did you book the car in for a service, Rafael?",
   "est_sec": 3.2,
   "gap_before": 0.45,
   "block": "nq_work_014",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_work_014",
   "name_pos": "end",
   "addressee": "Rafael"
  },
  {
   "speaker": "user",
   "text": "Puddle reflections?",
   "est_sec": 0.72,
   "gap_before": 2.68,
   "block": "photography.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Put your phone right down near a puddle and flip the image later. Buildings and trees appear upside down in a little mirror world.",
   "est_sec": 7.54,
   "gap_before": 0.34,
   "role": "reply",
   "block": "photography.dlg20"
  },
  {
   "speaker": "user",
   "text": "Ha, I like that. What if I",
   "est_sec": 2.27,
   "gap_before": 0.77,
   "event": "distractor",
   "kind": "pause",
   "block": "photography.dlg20"
  },
  {
   "speaker": "user",
   "text": "really don't want to go out?",
   "est_sec": 1.96,
   "gap_before": 2.96,
   "block": "photography.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then try still life by a rainy window. A cup of tea, a book, the soft grey light makes everything moody.",
   "est_sec": 6.61,
   "gap_before": 1.19,
   "role": "reply",
   "block": "photography.dlg20"
  },
  {
   "speaker": "user",
   "text": "Moody is my mood exactly.",
   "est_sec": 1.65,
   "gap_before": 0.92,
   "block": "photography.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Perfect match then. Turn off the room lights so only the window lights the scene, and you'll get lovely soft shadows.",
   "est_sec": 6.61,
   "gap_before": 0.48,
   "role": "reply",
   "block": "photography.dlg20"
  }
 ]
