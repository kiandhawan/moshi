 "est_total_sec": 59.56,
 "est_speech_sec": 45.94,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.45,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.54,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "My mother used to make a soda bread when I was a boy, and I've never managed to get it the same.",
   "est_sec": 6.92,
   "gap_before": 0.57,
   "block": "baking.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a lovely thing to recreate. Do you remember anything about it, the texture or the crust?",
   "est_sec": 5.37,
   "gap_before": 0.67,
   "role": "reply",
   "block": "baking.dlg16"
  },
  {
   "speaker": "user",
   "text": "Moshi, it had a hard crust with a cross cut in the top, and it was slightly sour.",
   "est_sec": 5.68,
   "gap_before": 1.5,
   "block": "baking.dlg16",
   "kind": "moshi_name",
   "name_pos": "start",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "The sourness probably came from buttermilk. A traditional soda bread is just flour, baking soda, salt and buttermilk.",
   "est_sec": 5.68,
   "gap_before": 1.06,
   "role": "reply",
   "block": "baking.dlg16"
  },
  {
   "speaker": "user",
   "text": "That's all? No butter, nothing?",
   "est_sec": 1.65,
   "gap_before": 0.45,
   "block": "baking.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Nothing else. Mix it quickly with a light hand, shape a round, cut a deep cross, and bake it hot.",
   "est_sec": 6.3,
   "gap_before": 0.65,
   "role": "reply",
   "block": "baking.dlg16"
  },
  {
   "speaker": "user",
   "text": "She did always say",
   "est_sec": 1.34,
   "gap_before": 0.48,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg16"
  },
  {
   "speaker": "user",
   "text": "not to fuss with it.",
   "est_sec": 1.65,
   "gap_before": 2.7,
   "block": "baking.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "She was right. The less you handle it, the softer the inside.",
   "est_sec": 3.82,
   "gap_before": 0.68,
   "role": "reply",
   "block": "baking.dlg16"
  },
  {
   "speaker": "user",
   "text": "I'll try it Sunday.",
   "est_sec": 1.34,
   "gap_before": 0.77,
   "block": "baking.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "I hope it tastes just like hers.",
   "est_sec": 2.27,
   "gap_before": 1.6,
   "role": "reply",
   "block": "baking.dlg16"
  }
 ]
}
