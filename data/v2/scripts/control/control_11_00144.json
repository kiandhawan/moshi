 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.73,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.94,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "I've got a recipe for a big round cake but I only own a small loaf tin.",
   "est_sec": 5.37,
   "gap_before": 0.21,
   "block": "baking.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can usually make it work. Fill the tin about two thirds full and bake any extra batter as a few cupcakes.",
   "est_sec": 6.92,
   "gap_before": 0.54,
   "role": "reply",
   "block": "baking.dlg12"
  },
  {
   "speaker": "user",
   "text": "Audrey, love, did you take your tablets with breakfast?",
   "est_sec": 2.89,
   "gap_before": 1.16,
   "block": "nq_home_016",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_016",
   "name_pos": "start",
   "addressee": "Audrey"
  },
  {
   "speaker": "user",
   "text": "Will the time change?",
   "est_sec": 1.34,
   "gap_before": 2.74,
   "block": "baking.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes. A loaf is deeper, so lower the oven a little and expect it to take longer, maybe fifteen minutes or so extra.",
   "est_sec": 7.23,
   "gap_before": 1.08,
   "role": "reply",
   "block": "baking.dlg12"
  },
  {
   "speaker": "user",
   "text": "How will I know",
   "est_sec": 1.34,
   "gap_before": 0.31,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg12"
  },
  {
   "speaker": "user",
   "text": "it's done in the middle?",
   "est_sec": 1.65,
   "gap_before": 1.54,
   "block": "baking.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A skewer in the centre should come out clean, and the top should spring back when you press it gently. If the top browns too fast, lay foil over it.",
