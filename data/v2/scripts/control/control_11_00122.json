 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.76,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.92,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "We're flying with our eighteen month old. Do we need to bring the car seat?",
   "est_sec": 4.75,
   "gap_before": 0.35,
   "block": "travel_planning.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You don't have to, but it's often worth it, both for the flight if she has her own seat, and for taxis or rental cars at the other end.",
   "est_sec": 9.09,
   "gap_before": 1.9,
   "role": "reply",
   "block": "travel_planning.dlg14"
  },
  {
   "speaker": "user",
   "text": "She'll be on my lap, we didn't buy her a seat, Moshi.",
   "est_sec": 3.82,
   "gap_before": 1.19,
   "block": "travel_planning.dlg14",
   "kind": "moshi_name",
   "name_pos": "end",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then you can usually check the car seat for free at the gate. Put it in a padded bag to protect it.",
   "est_sec": 6.92,
   "gap_before": 1.58,
   "role": "reply",
   "block": "travel_planning.dlg14"
  },
  {
   "speaker": "user",
   "text": "Free? That's a relief.",
   "est_sec": 1.34,
   "gap_before": 0.44,
   "block": "travel_planning.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most airlines don't charge for car seats or strollers. Check yours to be sure.",
   "est_sec": 4.44,
   "gap_before": 0.68,
   "role": "reply",
   "block": "travel_planning.dlg14"
  },
  {
   "speaker": "user",
   "text": "Hold on, that's not right.",
   "est_sec": 1.65,
   "gap_before": 3.0,
   "block": "travel_planning.dlg14",
   "kind": "wait_like",
   "phrasing": "waitlike_07",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good to question it. I still think it's right, though you know your situation best.",
   "est_sec": 4.75,
   "gap_before": 1.43,
   "role": "reply",
   "block": "travel_planning.dlg14"
  },
  {
   "speaker": "user",
   "text": "Any tips for keeping her",
   "est_sec": 1.65,
   "gap_before": 1.46,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg14"
  },
  {
   "speaker": "user",
   "text": "you know, not screaming the whole time?",
   "est_sec": 2.27,
   "gap_before": 2.68,
   "block": "travel_planning.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Feed her or give her a dummy during takeoff and landing to help her ears. Pack new little toys she hasn't seen yet.",
   "est_sec": 7.23,
   "gap_before": 0.61,
   "role": "reply",
   "block": "travel_planning.dlg14"
  },
  {
   "speaker": "user",
   "text": "New toys. Smart.",
   "est_sec": 1.03,
   "gap_before": 2.2,
   "block": "travel_planning.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "And snacks, lots of snacks.",
   "est_sec": 1.65,
   "gap_before": 0.82,
   "role": "reply",
   "block": "travel_planning.dlg14"
  }
 ]
}
