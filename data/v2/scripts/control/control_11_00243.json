 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.51,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "I'm visiting the States for the first time. The tipping thing confuses me. Who do I tip?",
   "est_sec": 5.37,
   "gap_before": 0.35,
   "block": "travel_planning.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "In restaurants with table service, around fifteen to twenty percent of the bill is normal.",
   "est_sec": 4.75,
   "gap_before": 1.92,
   "role": "reply",
   "block": "travel_planning.dlg26"
  },
  {
   "speaker": "user",
   "text": "Twenty percent? On top of the price?",
   "est_sec": 2.27,
   "gap_before": 1.49,
   "block": "travel_planning.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, and tax is often added at the till too, so the menu price isn't what you'll pay.",
   "est_sec": 5.68,
   "gap_before": 0.47,
   "role": "reply",
   "block": "travel_planning.dlg26"
  },
  {
   "speaker": "user",
   "text": "What time's the parents' evening, Emma?",
   "est_sec": 1.96,
   "gap_before": 0.33,
   "block": "nq_work_043",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_work_043",
   "name_pos": "end",
   "addressee": "Emma"
  },
  {
   "speaker": "user",
   "text": "Okay, that's a shock. What about taxis?",
   "est_sec": 2.27,
   "gap_before": 2.93,
   "block": "travel_planning.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Roughly fifteen percent for taxis and rideshares. Hotel staff who carry bags usually get a couple of dollars per bag.",
   "est_sec": 6.3,
   "gap_before": 0.86,
   "role": "reply",
   "block": "travel_planning.dlg26"
  },
  {
   "speaker": "user",
   "text": "And coffee shops? There's always",
   "est_sec": 1.65,
   "gap_before": 0.53,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg26"
  },
  {
   "speaker": "user",
   "text": "that little tip screen.",
   "est_sec": 1.34,
   "gap_before": 2.4,
   "block": "travel_planning.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's optional for counter service. Tip if you want to, but nobody expects it the way restaurants do.",
   "est_sec": 5.68,
   "gap_before": 0.64,
   "role": "reply",
   "block": "travel_planning.dlg26"
  }
 ]
}
