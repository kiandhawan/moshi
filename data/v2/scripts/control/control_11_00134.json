 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.9,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "Can I take a cello on the train? It's in a hard case.",
   "est_sec": 4.13,
   "gap_before": 0.57,
   "block": "public_transport.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Usually yes. Most trains allow musical instruments as long as they fit in the luggage space or you can hold them without blocking the aisle.",
   "est_sec": 7.85,
   "gap_before": 0.84,
   "role": "reply",
   "block": "public_transport.dlg8"
  },
  {
   "speaker": "user",
   "text": "A cello is quite big.",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "block": "public_transport.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "True. On a busy commuter train it could be tough. On long distance trains, some people book a seat for the instrument.",
   "est_sec": 6.92,
   "gap_before": 1.16,
   "role": "reply",
   "block": "public_transport.dlg8"
  },
  {
   "speaker": "user",
   "text": "A seat? For the cello?",
   "est_sec": 1.65,
   "gap_before": 2.61,
   "block": "public_transport.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It sounds funny, but it's common for musicians. The cello rides safely next to you instead of getting bumped in the rack.",
   "est_sec": 6.92,
   "gap_before": 0.47,
   "role": "reply",
   "block": "public_transport.dlg8"
  },
  {
   "speaker": "user",
   "text": "That's actually adorable.",
   "est_sec": 1.03,
   "gap_before": 0.76,
   "block": "public_transport.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Just travel outside rush hour if you can.",
   "est_sec": 2.58,
   "gap_before": 0.78,
   "role": "reply",
   "block": "public_transport.dlg8"
  }
 ]
}
