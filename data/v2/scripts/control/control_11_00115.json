 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.7,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.7,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "How do I know when a steak is medium rare without cutting into it?",
   "est_sec": 4.44,
   "gap_before": 0.23,
   "block": "cooking.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "The easiest way is a meat thermometer. You're looking for about fifty-five degrees Celsius in the middle.",
   "est_sec": 5.37,
   "gap_before": 1.07,
   "role": "reply",
   "block": "cooking.dlg16"
  },
  {
   "speaker": "user",
   "text": "No thermometer. Is there a trick?",
   "est_sec": 1.96,
   "gap_before": 1.22,
   "block": "cooking.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "There's the finger test. Press the steak, it should feel soft but springy, like the base of your thumb when you touch your thumb to your middle finger.",
   "est_sec": 8.78,
   "gap_before": 0.74,
   "role": "reply",
   "block": "cooking.dlg16"
  },
  {
   "speaker": "user",
   "text": "That feels very vague.",
   "est_sec": 1.34,
   "gap_before": 0.51,
   "block": "cooking.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It is, honestly. It gets better with practice, but a cheap thermometer saves a lot of guessing.",
   "est_sec": 5.37,
   "gap_before": 1.35,
   "role": "reply",
   "block": "cooking.dlg16"
  },
  {
   "speaker": "user",
   "text": "Fine, I'll buy one. And then I just slice it straight away?",
   "est_sec": 3.82,
   "gap_before": 0.63,
   "block": "cooking.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Let it rest for five minutes first. The juices settle back in, so they don't run all over the board.",
   "est_sec": 6.3,
   "gap_before": 1.46,
   "role": "reply",
   "block": "cooking.dlg16"
  },
  {
   "speaker": "user",
   "text": "Hold on a sec, five minutes feels like forever",
   "est_sec": 2.89,
   "gap_before": 0.4,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg16"
  },
  {
   "speaker": "user",
   "text": "when you're hungry.",
   "est_sec": 1.03,
   "gap_before": 2.78,
   "block": "cooking.dlg16",
