 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.42,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.52,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "What should I do with an old pension from a job I left years ago?",
   "est_sec": 4.75,
   "gap_before": 0.48,
   "block": "personal_finance.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "First, find out where it is and how much is in it. The old employer or a pension tracing service can help.",
   "est_sec": 6.92,
   "gap_before": 0.61,
   "role": "reply",
   "block": "personal_finance.dlg29"
  },
  {
   "speaker": "user",
   "text": "I think I have three of those, actually.",
   "est_sec": 2.58,
   "gap_before": 0.93,
   "block": "personal_finance.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's common. Some people combine them into one, which makes them easier to keep an eye on.",
   "est_sec": 5.37,
   "gap_before": 0.53,
   "role": "reply",
   "block": "personal_finance.dlg29"
  },
  {
   "speaker": "user",
   "text": "Is there a downside to combining?",
   "est_sec": 1.96,
   "gap_before": 1.0,
   "block": "personal_finance.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Some old pensions have valuable guarantees or low fees. Check those before moving anything.",
   "est_sec": 4.44,
   "gap_before": 0.89,
   "role": "reply",
   "block": "personal_finance.dlg29"
  },
  {
   "speaker": "user",
   "text": "This is",
   "est_sec": 0.72,
   "gap_before": 0.69,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg29"
  },
  {
   "speaker": "user",
   "text": "so much paperwork.",
   "est_sec": 1.03,
   "gap_before": 2.54,
   "block": "personal_finance.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It is a bit. But it's a few evenings of effort for money you'll really want later.",
   "est_sec": 5.37,
   "gap_before": 0.5,
   "role": "reply",
   "block": "personal_finance.dlg29"
  }
 ]
}
