 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.45,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "How much of my paycheck should I be saving?",
   "est_sec": 2.89,
   "gap_before": 0.44,
   "block": "personal_finance.dlg1",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A common rule of thumb is about a fifth of your take home pay. If that's too much right now, start smaller and build up.",
   "est_sec": 7.85,
   "gap_before": 0.32,
   "role": "reply",
   "block": "personal_finance.dlg1"
  },
  {
   "speaker": "user",
   "text": "A fifth sounds like a lot when rent is already half.",
   "est_sec": 3.51,
   "gap_before": 1.97,
   "block": "personal_finance.dlg1",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's tight, I get it. Even five percent saved automatically is a great habit to start with.",
   "est_sec": 5.37,
   "gap_before": 0.43,
   "role": "reply",
   "block": "personal_finance.dlg1"
  },
  {
   "speaker": "user",
   "text": "I can't find the scanner app. Sarah, did you delete it?",
   "est_sec": 3.51,
   "gap_before": 2.86,
   "block": "nq_work_063",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_work_063",
   "name_pos": "middle",
   "addressee": "Sarah"
  },
  {
   "speaker": "other",
   "text": "It's in the work folder.",
   "est_sec": 1.65,
   "gap_before": 0.5,
   "block": "nq_work_063"
  },
  {
   "speaker": "user",
   "text": "Should that go into",
   "est_sec": 1.34,
   "gap_before": 0.99,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg1"
  },
  {
   "speaker": "user",
   "text": "like a normal savings account, or something else?",
   "est_sec": 2.58,
   "gap_before": 1.64,
   "block": "personal_finance.dlg1",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "For an emergency fund, a high yield savings account is ideal. It's easy to reach and still earns some interest.",
   "est_sec": 6.3,
   "gap_before": 0.94,
   "role": "reply",
   "block": "personal_finance.dlg1"
  },
  {
   "speaker": "user",
   "text": "And once that's built up?",
   "est_sec": 1.65,
   "gap_before": 0.54,
   "block": "personal_finance.dlg1",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then look at retirement accounts, especially if your employer matches contributions. That match is basically free money.",
   "est_sec": 5.37,
   "gap_before": 0.82,
   "role": "reply",
   "block": "personal_finance.dlg1"
  }
 ]
