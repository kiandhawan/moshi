 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.76,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "What should I eat on the morning of an exam? I usually just skip breakfast.",
   "est_sec": 4.75,
   "gap_before": 0.22,
   "block": "studying.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Try not to skip it. Something with slow energy, like porridge, eggs on toast, or yogurt with fruit, keeps you going.",
   "est_sec": 6.61,
   "gap_before": 0.96,
   "role": "reply",
   "block": "studying.dlg22"
  },
  {
   "speaker": "user",
   "text": "Wait a second, that doesn't sound right.",
   "est_sec": 2.27,
   "gap_before": 1.03,
   "block": "studying.dlg22",
   "kind": "wait_like",
   "phrasing": "waitlike_10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "I'm fairly sure about it, but I could be wrong. What sounds off to you?",
   "est_sec": 4.75,
   "gap_before": 1.09,
   "role": "reply",
   "block": "studying.dlg22"
  },
  {
   "speaker": "user",
   "text": "I was telling Rosa how Moshi helps me remember my pills.",
   "est_sec": 3.51,
   "gap_before": 1.11,
   "block": "mm_057",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_057",
   "name_pos": "none"
  },
  {
   "speaker": "user",
   "text": "I get too nervous to eat.",
   "est_sec": 1.96,
   "gap_before": 3.06,
   "block": "studying.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then something small. A banana and a glass of milk is better than nothing.",
   "est_sec": 4.44,
   "gap_before": 0.8,
   "role": "reply",
   "block": "studying.dlg22"
  },
  {
   "speaker": "user",
   "text": "And coffee?",
   "est_sec": 0.72,
   "gap_before": 0.52,
   "block": "studying.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "If you normally drink it, have your usual amount. Don't suddenly drink three cups, that can make the nerves worse.",
   "est_sec": 6.3,
   "gap_before": 1.12,
   "role": "reply",
   "block": "studying.dlg22"
  },
  {
   "speaker": "user",
   "text": "And what should I",
   "est_sec": 1.34,
   "gap_before": 0.86,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg22"
  },
  {
   "speaker": "user",
   "text": "bring in with me?",
   "est_sec": 1.34,
   "gap_before": 2.56,
   "block": "studying.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Spare pens, a clear water bottle, your ID, and a watch if you're allowed. Pack it all the night before.",
