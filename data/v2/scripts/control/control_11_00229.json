 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.57,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "My flatmate keeps our coffee beans in the freezer. Is that right? It seems weird.",
   "est_sec": 4.75,
   "gap_before": 0.59,
   "block": "coffee.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's a common debate. For beans you'll use within a couple of weeks, an airtight container in a cool, dark cupboard is best.",
   "est_sec": 7.23,
   "gap_before": 0.39,
   "role": "reply",
   "block": "coffee.dlg11"
  },
  {
   "speaker": "user",
   "text": "So the freezer is wrong?",
   "est_sec": 1.65,
   "gap_before": 0.53,
   "block": "coffee.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not wrong, just not needed for everyday beans. Taking them in and out of the freezer causes condensation, which isn't great for flavour.",
   "est_sec": 7.23,
   "gap_before": 1.43,
   "role": "reply",
   "block": "coffee.dlg11"
  },
  {
   "speaker": "user",
   "text": "Hold on, that's not right.",
   "est_sec": 1.65,
   "gap_before": 1.28,
   "block": "coffee.dlg11",
   "kind": "wait_like",
   "phrasing": "waitlike_07",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "I'm fairly sure about it, but I could be wrong. What sounds off to you?",
   "est_sec": 4.75,
   "gap_before": 1.01,
   "role": "reply",
   "block": "coffee.dlg11"
  },
  {
   "speaker": "user",
   "text": "When would freezing",
   "est_sec": 1.03,
   "gap_before": 0.67,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg11"
  },
  {
   "speaker": "user",
   "text": "make sense?",
   "est_sec": 0.72,
   "gap_before": 1.98,
   "block": "coffee.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "If you buy a big bag and won't use it for a month or more. Freeze it in small portions and only take out what you need.",
   "est_sec": 8.47,
   "gap_before": 0.31,
   "role": "reply",
   "block": "coffee.dlg11"
  },
  {
   "speaker": "user",
   "text": "Okay. I'll negotiate with him.",
   "est_sec": 1.65,
   "gap_before": 0.99,
   "block": "coffee.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Diplomacy is key. And keep them away from the fridge, beans soak up smells like onions surprisingly fast.",
   "est_sec": 5.68,
   "gap_before": 1.05,
   "role": "reply",
   "block": "coffee.dlg11"
  }
 ]
