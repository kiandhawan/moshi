 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.93,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "I'm a nurse and I work night shifts. When am I supposed to read?",
   "est_sec": 4.44,
   "gap_before": 0.57,
   "block": "books.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Night shifts are tough on routines. Do you get any proper breaks during the night?",
   "est_sec": 4.75,
   "gap_before": 0.38,
   "role": "reply",
   "block": "books.dlg20"
  },
  {
   "speaker": "user",
   "text": "A short one, maybe twenty minutes, but I'm usually too wired.",
   "est_sec": 3.51,
   "gap_before": 1.36,
   "block": "books.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then something easy might fit, like short stories or essays you can finish in one sitting.",
   "est_sec": 5.06,
   "gap_before": 0.65,
   "role": "reply",
   "block": "books.dlg20"
  },
  {
   "speaker": "user",
   "text": "I used to love long novels.",
   "est_sec": 1.96,
   "gap_before": 1.27,
   "block": "books.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You could save those for your days off, when you're rested. Treat them like a little holiday.",
   "est_sec": 5.37,
   "gap_before": 0.85,
   "role": "reply",
   "block": "books.dlg20"
  },
  {
   "speaker": "user",
   "text": "And on the way home? I take the bus.",
   "est_sec": 2.89,
   "gap_before": 1.67,
   "block": "books.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "An audiobook could be lovely then, as long as it's calm. Nothing too gripping, or you won't sleep when you get home.",
   "est_sec": 6.92,
   "gap_before": 1.74,
   "role": "reply",
   "block": "books.dlg20"
  }
 ]
