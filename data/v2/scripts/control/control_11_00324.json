 "est_total_sec": 53.95,
 "est_speech_sec": 41.09,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.36,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.87,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "I'm forty-five and I've never stayed in a hostel. Am I too old?",
   "est_sec": 4.13,
   "gap_before": 0.26,
   "block": "travel_planning.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not at all. Plenty of hostels have guests of every age, and many have private rooms too.",
   "est_sec": 5.37,
   "gap_before": 1.08,
   "role": "reply",
   "block": "travel_planning.dlg19"
  },
  {
   "speaker": "user",
   "text": "A private room in a hostel? Then what's the point?",
   "est_sec": 3.2,
   "gap_before": 1.14,
   "block": "travel_planning.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's usually cheaper than a hotel, and you still get the social side, like the kitchen, the bar and organized walks.",
   "est_sec": 6.61,
   "gap_before": 0.85,
   "role": "reply",
   "block": "travel_planning.dlg19"
  },
  {
   "speaker": "user",
   "text": "Hmm. I do like meeting people.",
   "est_sec": 1.96,
   "gap_before": 1.44,
   "block": "travel_planning.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then look for hostels described as relaxed or social, not party hostels. Reviews tell you a lot.",
   "est_sec": 5.37,
   "gap_before": 2.0,
   "role": "reply",
   "block": "travel_planning.dlg19"
  },
  {
   "speaker": "user",
   "text": "Do I need to bring",
   "est_sec": 1.65,
   "gap_before": 0.31,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg19"
  },
  {
   "speaker": "user",
   "text": "my own towel and stuff?",
   "est_sec": 1.65,
   "gap_before": 1.72,
   "block": "travel_planning.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sometimes. Many charge a small fee for towels, so a light travel towel is handy. A padlock for the lockers is useful too.",
   "est_sec": 7.23,
   "gap_before": 1.33,
   "role": "reply",
   "block": "travel_planning.dlg19"
  }
 ]
}
