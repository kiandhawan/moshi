   "gap_before": 1.39,
   "block": "music.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Some lyrics are fine, just avoid anything everyone knows the words to, or people start singing instead of talking.",
   "est_sec": 5.99,
   "gap_before": 1.02,
   "role": "reply",
   "block": "music.dlg17"
  },
