 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.42,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "I work on building sites through the winter. What should I buy to stay warm?",
   "est_sec": 4.75,
   "gap_before": 0.3,
   "block": "shopping.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Layers beat one big coat. Start with a thermal base layer, ideally merino wool or a synthetic that pulls sweat away.",
   "est_sec": 6.61,
   "gap_before": 1.08,
   "role": "reply",
   "block": "shopping.dlg26"
  },
  {
   "speaker": "user",
   "text": "Moshi, cotton's no good?",
   "est_sec": 1.34,
   "gap_before": 0.92,
   "block": "shopping.dlg26",
   "kind": "moshi_name",
   "name_pos": "start",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Cotton holds onto sweat and then chills you, so avoid it for the bottom layer.",
   "est_sec": 4.75,
   "gap_before": 0.3,
   "role": "reply",
   "block": "shopping.dlg26"
  },
  {
   "speaker": "user",
   "text": "Wait, right. What about my feet? They're always the worst.",
   "est_sec": 3.2,
   "gap_before": 0.34,
   "block": "shopping.dlg26",
   "kind": "wait_like",
   "phrasing": "waitlike_13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good wool socks and boots with a bit of room. Tight boots cut off circulation and make your toes colder.",
   "est_sec": 6.3,
   "gap_before": 0.99,
   "role": "reply",
   "block": "shopping.dlg26"
  },
  {
   "speaker": "user",
   "text": "And gloves I can actually work in?",
   "est_sec": 2.27,
   "gap_before": 2.4,
   "block": "shopping.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Look for insulated work gloves with a grippy palm, or thin liner gloves under a thicker pair you can pull off for fiddly jobs.",
   "est_sec": 7.54,
   "gap_before": 1.28,
   "role": "reply",
   "block": "shopping.dlg26"
  }
 ]
