 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.36,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "One guy in our group takes forever on his turn. Like ten minutes. Everyone's getting fed up.",
   "est_sec": 5.37,
   "gap_before": 0.55,
   "block": "board_games.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Long turns are frustrating. Does he do it in every game, or only the heavy strategy ones?",
   "est_sec": 5.37,
   "gap_before": 0.58,
   "role": "reply",
   "block": "board_games.dlg21"
  },
  {
   "speaker": "user",
   "text": "Mostly the heavy ones.",
   "est_sec": 1.34,
   "gap_before": 0.76,
   "block": "board_games.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then you could play more games where everyone moves at once, or games with a sand timer. It keeps things moving without singling him out.",
   "est_sec": 7.85,
   "gap_before": 0.87,
   "role": "reply",
   "block": "board_games.dlg21"
  },
  {
   "speaker": "user",
   "text": "A sand timer would really annoy him.",
   "est_sec": 2.27,
   "gap_before": 1.04,
   "block": "board_games.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Maybe at first. You could also ask him kindly to plan during other people's turns, so he's ready when it's his.",
   "est_sec": 6.61,
   "gap_before": 0.66,
   "role": "reply",
   "block": "board_games.dlg21"
  },
  {
   "speaker": "user",
   "text": "He'd probably say he's thinking on our turns already.",
   "est_sec": 2.89,
   "gap_before": 0.84,
   "block": "board_games.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then a gentle chat away from the table helps. He may not realise how long it takes, most slow players don't.",
   "est_sec": 6.61,
   "gap_before": 0.32,
   "role": "reply",
   "block": "board_games.dlg21"
  }
 ]
}
