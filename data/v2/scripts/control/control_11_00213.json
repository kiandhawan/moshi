 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.45,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.31,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "I have asthma. Can I still get into running?",
   "est_sec": 2.89,
   "gap_before": 0.4,
   "block": "fitness.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Many people with asthma run, including top athletes. It's worth talking to your doctor about a plan first.",
   "est_sec": 5.68,
   "gap_before": 0.46,
   "role": "reply",
   "block": "fitness.dlg27"
  },
  {
   "speaker": "user",
   "text": "I had Moshi translate the menu at that Greek place.",
   "est_sec": 3.2,
   "gap_before": 0.6,
   "block": "mm_111",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_111",
   "name_pos": "none"
  },
  {
   "speaker": "other",
   "text": "The squid one?",
   "est_sec": 1.03,
   "gap_before": 0.66,
   "block": "mm_111"
  },
  {
   "speaker": "user",
   "text": "What kind of plan?",
   "est_sec": 1.34,
   "gap_before": 1.58,
   "block": "fitness.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Often using your inhaler before exercise, and having it with you on every run.",
   "est_sec": 4.44,
   "gap_before": 0.54,
   "role": "reply",
   "block": "fitness.dlg27"
  },
  {
   "speaker": "user",
   "text": "Cold air seems to set me off.",
   "est_sec": 2.27,
   "gap_before": 1.07,
   "block": "fitness.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's common. A scarf or buff over your mouth warms the air. Warm up gradually rather than starting fast.",
   "est_sec": 5.99,
   "gap_before": 0.53,
   "role": "reply",
   "block": "fitness.dlg27"
  },
  {
   "speaker": "user",
   "text": "Should I avoid",
   "est_sec": 1.03,
   "gap_before": 2.53,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg27"
  },
  {
   "speaker": "user",
   "text": "certain times or places?",
   "est_sec": 1.34,
   "gap_before": 2.58,
   "block": "fitness.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Avoid busy roads with traffic fumes, and high pollen days if pollen is a trigger. Parks in the morning are often good.",
   "est_sec": 6.92,
   "gap_before": 0.94,
   "role": "reply",
   "block": "fitness.dlg27"
  },
  {
   "speaker": "user",
   "text": "Okay, I'll book a doctor's appointment first.",
   "est_sec": 2.27,
   "gap_before": 0.43,
   "block": "fitness.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Great idea. Then start gently and build up.",
   "est_sec": 2.58,
   "gap_before": 0.82,
   "role": "reply",
   "block": "fitness.dlg27"
  }
 ]
}
