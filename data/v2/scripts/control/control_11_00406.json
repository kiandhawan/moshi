 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.76,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.81,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "I can swim, but I can't breathe properly doing front crawl. I end up gasping after one length.",
   "est_sec": 5.68,
   "gap_before": 0.51,
   "block": "fitness.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's usually because people hold their breath underwater. Breathe out slowly through your nose or mouth while your face is in the water.",
   "est_sec": 7.23,
   "gap_before": 1.2,
   "role": "reply",
   "block": "fitness.dlg25"
  },
  {
   "speaker": "user",
   "text": "Breathe out underwater?",
   "est_sec": 1.03,
   "gap_before": 2.03,
   "block": "fitness.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, then when you turn your head, your lungs are ready to take a quick breath in.",
   "est_sec": 5.37,
   "gap_before": 1.19,
   "role": "reply",
   "block": "fitness.dlg25"
  },
  {
   "speaker": "user",
   "text": "When do I turn my head?",
   "est_sec": 1.96,
   "gap_before": 1.04,
   "block": "fitness.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Every two or three strokes. Rotate your body and keep one eye in the water, don't lift your whole head.",
   "est_sec": 6.3,
   "gap_before": 1.54,
   "role": "reply",
   "block": "fitness.dlg25"
  },
  {
   "speaker": "user",
   "text": "This is a lot to think about",
   "est_sec": 2.27,
   "gap_before": 0.87,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg25"
  },
  {
   "speaker": "user",
   "text": "all at once.",
   "est_sec": 1.03,
   "gap_before": 2.81,
   "block": "fitness.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Practice the breathing standing in the shallow end first. Bubbles out, turn, breathe in, repeat.",
   "est_sec": 4.75,
   "gap_before": 1.16,
   "role": "reply",
   "block": "fitness.dlg25"
  },
  {
   "speaker": "user",
   "text": "Bubbles, turn, breathe. Got it.",
   "est_sec": 1.65,
   "gap_before": 1.43,
   "block": "fitness.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You'll get it. Most people need a few sessions.",
   "est_sec": 2.89,
   "gap_before": 0.64,
   "role": "reply",
   "block": "fitness.dlg25"
  }
 ]
