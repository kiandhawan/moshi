 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.65,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.81,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "How many push-ups should a beginner aim for, Moshi?",
   "est_sec": 2.89,
   "gap_before": 0.5,
   "block": "fitness.dlg1",
   "kind": "moshi_name",
   "name_pos": "end",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Start with however many you can do with good form, even if it's five. Do three sets and try to add one rep each week.",
   "est_sec": 7.85,
   "gap_before": 1.37,
   "role": "reply",
   "block": "fitness.dlg1"
  },
  {
   "speaker": "user",
   "text": "What if I can't do a single one?",
   "est_sec": 2.58,
   "gap_before": 0.81,
   "block": "fitness.dlg1",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then start with push-ups against a wall or a kitchen counter. As those get easy, move lower, to a chair and then the floor.",
   "est_sec": 7.54,
   "gap_before": 0.35,
   "role": "reply",
   "block": "fitness.dlg1"
  },
  {
   "speaker": "user",
   "text": "Hold on, knee push-ups count too, right?",
   "est_sec": 2.27,
   "gap_before": 0.49,
   "block": "fitness.dlg1",
   "kind": "wait_like",
   "phrasing": "waitlike_14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Absolutely. They build the same muscles and they're a great step towards full push-ups.",
   "est_sec": 4.44,
   "gap_before": 0.63,
   "role": "reply",
   "block": "fitness.dlg1"
  },
  {
   "speaker": "user",
   "text": "Cool. And how often should I",
   "est_sec": 1.96,
   "gap_before": 2.09,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg1"
  },
  {
   "speaker": "user",
   "text": "do them, every day?",
   "est_sec": 1.34,
   "gap_before": 1.67,
   "block": "fitness.dlg1",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Every other day is better at first. Your muscles grow during the rest days.",
   "est_sec": 4.44,
   "gap_before": 1.08,
   "role": "reply",
   "block": "fitness.dlg1"
  }
 ]
