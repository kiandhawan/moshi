 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.38,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.34,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "I'm moving to Lisbon for a new job and I'm already feeling homesick and I haven't even left.",
   "est_sec": 5.68,
   "gap_before": 0.45,
   "block": "moving_house.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's very common. It's a huge change, even if it's a good one.",
   "est_sec": 4.13,
   "gap_before": 1.14,
   "role": "reply",
   "block": "moving_house.dlg14"
  },
  {
   "speaker": "user",
   "text": "How do people deal with it?",
   "est_sec": 1.96,
   "gap_before": 1.03,
   "block": "moving_house.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Building a small routine quickly helps, like a favourite cafe, a gym or a weekly class. Familiar places make a city feel like home.",
   "est_sec": 7.54,
   "gap_before": 0.86,
   "role": "reply",
   "block": "moving_house.dlg14"
  },
  {
   "speaker": "user",
   "text": "I don't speak Portuguese. At all.",
   "est_sec": 1.96,
   "gap_before": 0.62,
   "block": "moving_house.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A beginner class would help twice, you'd learn the language and meet other newcomers. Many cities have expat meetups too.",
   "est_sec": 6.3,
   "gap_before": 0.95,
   "role": "reply",
   "block": "moving_house.dlg14"
  },
  {
   "speaker": "user",
   "text": "And with my family?",
   "est_sec": 1.34,
   "gap_before": 0.45,
   "block": "moving_house.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Schedule regular calls instead of random ones. Something to look forward to makes the distance easier.",
   "est_sec": 5.06,
   "gap_before": 1.4,
   "role": "reply",
   "block": "moving_house.dlg14"
  }
 ]
}
