 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.65,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.78,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "Beach day tomorrow. Is there anything about the weather I should check besides sunshine?",
   "est_sec": 4.44,
   "gap_before": 0.22,
   "block": "weather_plans.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "The wind and the tide times. A windy beach can feel cold and sandblasting even if it's sunny.",
   "est_sec": 5.68,
   "gap_before": 0.41,
   "role": "reply",
   "block": "weather_plans.dlg19"
  },
  {
   "speaker": "user",
   "text": "Wait, what was the last part?",
   "est_sec": 1.96,
   "gap_before": 1.03,
   "block": "weather_plans.dlg19",
   "kind": "wait_like",
   "phrasing": "waitlike_05",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Of course. The wind and the tide times. A windy beach can feel cold and sandblasting even if it's sunny.",
   "est_sec": 6.3,
   "gap_before": 0.95,
   "role": "reply",
   "block": "weather_plans.dlg19"
  },
  {
   "speaker": "user",
   "text": "What wind speed is too much?",
   "est_sec": 1.96,
   "gap_before": 0.4,
   "block": "weather_plans.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Above about fifteen or twenty miles an hour gets unpleasant. A windbreak helps a lot.",
   "est_sec": 4.75,
   "gap_before": 0.61,
   "role": "reply",
   "block": "weather_plans.dlg19"
  },
  {
   "speaker": "user",
   "text": "And why the tides?",
   "est_sec": 1.34,
   "gap_before": 0.64,
   "block": "weather_plans.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "At high tide some beaches almost disappear. Low tide is better for rock pools and space to play.",
   "est_sec": 5.68,
   "gap_before": 0.78,
   "role": "reply",
   "block": "weather_plans.dlg19"
  },
  {
   "speaker": "user",
   "text": "My kids want to swim",
   "est_sec": 1.65,
   "gap_before": 1.24,
   "event": "distractor",
   "kind": "pause",
   "block": "weather_plans.dlg19"
  },
  {
   "speaker": "user",
   "text": "but the sea is freezing this time of year.",
   "est_sec": 2.89,
   "gap_before": 2.19,
   "block": "weather_plans.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Pick a lifeguarded beach, and get them out before their lips go blue. Bring a hot drink for after.",
   "est_sec": 5.99,
   "gap_before": 0.9,
   "role": "reply",
   "block": "weather_plans.dlg19"
  }
 ]
}
