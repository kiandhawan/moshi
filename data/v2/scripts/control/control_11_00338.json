 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.34,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "My train commute is unbearable in the heat. Any tips?",
   "est_sec": 3.2,
   "gap_before": 0.49,
   "block": "weather_plans.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Bring a big bottle of cold water. Freeze half of it the night before, it'll still be cold by the afternoon.",
   "est_sec": 6.61,
   "gap_before": 0.58,
   "role": "reply",
   "block": "weather_plans.dlg31"
  },
  {
   "speaker": "user",
   "text": "That's genius.",
   "est_sec": 0.72,
   "gap_before": 1.47,
   "block": "weather_plans.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Wear loose clothes in light fabrics, and if you can, stand near the doors where there's a breeze at each stop.",
   "est_sec": 6.61,
   "gap_before": 0.46,
   "role": "reply",
   "block": "weather_plans.dlg31"
  },
  {
   "speaker": "user",
   "text": "I always end up squished in the middle.",
   "est_sec": 2.58,
   "gap_before": 0.66,
   "block": "weather_plans.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then try an earlier train if you can. They're often a bit less full and the morning is cooler.",
   "est_sec": 5.99,
   "gap_before": 0.43,
   "role": "reply",
   "block": "weather_plans.dlg31"
  },
  {
   "speaker": "user",
   "text": "I'll think about it.",
   "est_sec": 1.34,
   "gap_before": 1.42,
   "event": "distractor",
   "kind": "pause",
   "block": "weather_plans.dlg31"
  },
  {
   "speaker": "user",
   "text": "Wait, does the first carriage tend to be emptier?",
   "est_sec": 2.89,
   "gap_before": 2.32,
   "block": "weather_plans.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Often the ends of the train are less crowded. And a small handheld fan won't hurt, people will be jealous.",
   "est_sec": 6.3,
   "gap_before": 0.52,
   "role": "reply",
   "block": "weather_plans.dlg31"
  }
 ]
}
