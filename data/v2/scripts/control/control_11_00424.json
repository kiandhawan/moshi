   "gap_before": 0.23,
   "block": "movies.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's not weird, that's a big moment. What was the film?",
   "est_sec": 3.51,
   "gap_before": 0.33,
   "role": "reply",
   "block": "movies.dlg27"
  },
  {
   "speaker": "user",
   "text": "There's a weird smell in here. Owen, did you empty the food bin?",
