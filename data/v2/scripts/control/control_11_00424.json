  },
  {
   "speaker": "other",
   "text": "Not since Tuesday. Sorry.",
   "est_sec": 1.34,
   "gap_before": 0.9,
   "block": "nq_home_038"
  },
  {
   "speaker": "user",
   "text": "One about a father and son fixing up an old boat.",
   "est_sec": 3.51,
   "gap_before": 1.87,
   "block": "movies.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ah, that makes sense. Films like that sometimes hit things people don't say out loud.",
   "est_sec": 4.75,
   "gap_before": 1.18,
   "role": "reply",
   "block": "movies.dlg27"
  },
  {
   "speaker": "user",
   "text": "Should I mention it? He",
   "est_sec": 1.65,
   "gap_before": 0.58,
   "event": "distractor",
   "kind": "pause",
   "block": "movies.dlg27"
  },
  {
