 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.35,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.32,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "I want a gardening thing to do with my four year old. Something quick, she's not patient.",
   "est_sec": 5.37,
   "gap_before": 0.59,
   "block": "gardening.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Cress is the classic for a reason. Sprinkle seeds on damp cotton wool and you'll see shoots in two or three days.",
   "est_sec": 6.92,
   "gap_before": 0.31,
   "role": "reply",
   "block": "gardening.dlg22"
  },
  {
   "speaker": "user",
   "text": "Two days, that's perfect. Can we make it fun?",
   "est_sec": 2.89,
   "gap_before": 0.7,
   "block": "gardening.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Grow it in an empty eggshell with a face drawn on. The cress becomes hair, and she can give it a haircut with scissors.",
   "est_sec": 7.54,
   "gap_before": 0.63,
   "role": "reply",
   "block": "gardening.dlg22"
  },
  {
   "speaker": "user",
   "text": "Oh she'll love that. Then what?",
   "est_sec": 1.96,
   "gap_before": 0.44,
   "block": "gardening.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then sunflowers or radishes. Radishes go from seed to plate in about a month, and they're bright red.",
   "est_sec": 5.68,
   "gap_before": 0.98,
   "role": "reply",
   "block": "gardening.dlg22"
  },
  {
   "speaker": "user",
   "text": "Will she actually eat a radish? She's",
   "est_sec": 2.27,
   "gap_before": 1.34,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg22"
  },
  {
   "speaker": "user",
   "text": "very suspicious of anything red.",
   "est_sec": 1.65,
   "gap_before": 2.4,
   "block": "gardening.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Maybe not, but kids are much more likely to try food they grew themselves. Worth a go.",
   "est_sec": 5.37,
   "gap_before": 1.02,
   "role": "reply",
   "block": "gardening.dlg22"
  }
 ]
}
