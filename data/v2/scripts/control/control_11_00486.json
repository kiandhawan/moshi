 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.62,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.95,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "My kids want to make a stop motion film with their toys. Where do we start?",
   "est_sec": 5.06,
   "gap_before": 0.59,
   "block": "movies.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Great project. All you need is a phone, a free stop motion app, and something to keep the phone completely still.",
   "est_sec": 6.61,
   "gap_before": 0.53,
   "role": "reply",
   "block": "movies.dlg30"
  },
  {
   "speaker": "user",
   "text": "Like a tripod?",
   "est_sec": 1.03,
   "gap_before": 3.03,
   "block": "movies.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A tripod is perfect, but a stack of books and some tape works too. Any wobble shows up in the film.",
   "est_sec": 6.61,
   "gap_before": 0.76,
   "role": "reply",
   "block": "movies.dlg30"
  },
  {
   "speaker": "user",
   "text": "How many photos",
   "est_sec": 1.03,
   "gap_before": 1.0,
   "event": "distractor",
   "kind": "pause",
   "block": "movies.dlg30"
  },
  {
   "speaker": "user",
   "text": "are we talking for a short scene?",
   "est_sec": 2.27,
   "gap_before": 2.99,
   "block": "movies.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Usually around twelve photos for every second of film. So a ten second clip is over a hundred tiny moves.",
   "est_sec": 6.3,
   "gap_before": 1.0,
   "role": "reply",
   "block": "movies.dlg30"
  },
  {
   "speaker": "user",
   "text": "That's a lot of moving dinosaurs.",
   "est_sec": 1.96,
   "gap_before": 0.43,
   "block": "movies.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It is, but kids love it. Start with something tiny, like a dinosaur walking across the table and eating a biscuit.",
   "est_sec": 6.61,
   "gap_before": 0.86,
   "role": "reply",
   "block": "movies.dlg30"
  },
  {
   "speaker": "user",
   "text": "They'll definitely want the biscuit bit.",
   "est_sec": 1.96,
   "gap_before": 0.85,
   "block": "movies.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then you've got your first film. Add some sound effects in the app and you're done.",
   "est_sec": 5.06,
   "gap_before": 0.75,
   "role": "reply",
   "block": "movies.dlg30"
  }
 ]
