 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.83,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "I get really anxious on Sunday afternoons. Like a heavy feeling.",
   "est_sec": 3.51,
   "gap_before": 0.25,
   "block": "weekend_plans.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You're far from alone in that. Many people call it the Sunday scaries. Is it about work or something else?",
   "est_sec": 6.3,
   "gap_before": 1.18,
   "role": "reply",
   "block": "weekend_plans.dlg28"
  },
  {
   "speaker": "user",
   "text": "Work mostly. Monday mornings are chaos.",
   "est_sec": 1.96,
   "gap_before": 1.21,
   "block": "weekend_plans.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It might help to spend fifteen minutes on Friday writing down what's coming next week. Then you're not carrying it all weekend.",
   "est_sec": 6.92,
   "gap_before": 0.92,
   "role": "reply",
   "block": "weekend_plans.dlg28"
  },
  {
   "speaker": "user",
   "text": "On Friday, not Sunday?",
   "est_sec": 1.34,
   "gap_before": 1.47,
   "block": "weekend_plans.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, so Sunday stays yours. Then plan something nice on Sunday afternoon, like a walk or seeing a friend.",
   "est_sec": 5.99,
   "gap_before": 0.98,
   "role": "reply",
   "block": "weekend_plans.dlg28"
  },
  {
   "speaker": "user",
   "text": "I usually just",
   "est_sec": 1.03,
   "gap_before": 2.4,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg28"
  },
  {
   "speaker": "user",
   "text": "sit at home and dread it.",
   "est_sec": 1.96,
   "gap_before": 2.96,
   "block": "weekend_plans.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Getting out, even for an hour, can break that feeling. And go easy on yourself, it's a very normal reaction.",
   "est_sec": 6.3,
   "gap_before": 0.76,
   "role": "reply",
   "block": "weekend_plans.dlg28"
  }
 ]
}
