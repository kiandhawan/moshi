 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.66,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.8,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "I keep buying books and never reading them. Is that a problem?",
   "est_sec": 3.82,
   "gap_before": 0.42,
   "block": "books.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "There's even a word for it in Japanese, for a pile of unread books. You're in good company.",
   "est_sec": 5.68,
   "gap_before": 0.5,
   "role": "reply",
   "block": "books.dlg23"
  },
  {
   "speaker": "user",
   "text": "My partner says it's out of control. There's a pile by the bed taller than the lamp.",
   "est_sec": 5.37,
   "gap_before": 0.77,
   "block": "books.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ha, that's a strong pile. Maybe set a little rule, like reading one from the pile before buying a new one.",
   "est_sec": 6.61,
   "gap_before": 1.14,
   "role": "reply",
   "block": "books.dlg23"
  },
  {
   "speaker": "user",
   "text": "When we lost the remote, Moshi was no use at all.",
   "est_sec": 3.51,
   "gap_before": 1.33,
   "block": "mm_081",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_081",
   "name_pos": "none"
  },
  {
   "speaker": "other",
   "text": "It doesn't have eyes.",
   "est_sec": 1.34,
   "gap_before": 0.37,
   "block": "mm_081"
  },
  {
   "speaker": "user",
   "text": "The ref's blind. Monique, was that a penalty or not?",
   "est_sec": 3.2,
   "gap_before": 1.78,
   "block": "nq_social_052",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_052",
   "name_pos": "middle",
   "addressee": "Monique"
  },
  {
   "speaker": "user",
   "text": "That sounds horrible.",
   "est_sec": 1.03,
   "gap_before": 2.68,
   "block": "books.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It sounds strict, but it can make the pile feel less like guilt and more like a treasure chest.",
   "est_sec": 5.99,
   "gap_before": 0.47,
   "role": "reply",
   "block": "books.dlg23"
  },
  {
   "speaker": "user",
   "text": "What if I",
   "est_sec": 1.03,
   "gap_before": 1.47,
   "event": "distractor",
   "kind": "pause",
   "block": "books.dlg23"
  },
  {
   "speaker": "user",
   "text": "start one and hate it?",
   "est_sec": 1.65,
   "gap_before": 2.15,
   "block": "books.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then give it fifty pages and move on. That still counts as clearing it from the pile.",
   "est_sec": 5.37,
