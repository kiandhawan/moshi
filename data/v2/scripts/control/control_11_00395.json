 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "My elderly mum got a call saying she'd won a lottery but needed to pay a fee first.",
   "est_sec": 5.68,
   "gap_before": 0.49,
   "block": "personal_finance.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a classic scam. Real prizes never ask you to pay to receive them.",
   "est_sec": 4.44,
   "gap_before": 0.38,
   "role": "reply",
   "block": "personal_finance.dlg25"
  },
  {
   "speaker": "user",
   "text": "She already gave them her card number.",
   "est_sec": 2.27,
   "gap_before": 0.45,
   "block": "personal_finance.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then call her bank right away and ask them to block the card. Explain that it was a scam.",
   "est_sec": 5.99,
   "gap_before": 0.79,
   "role": "reply",
   "block": "personal_finance.dlg25"
  },
  {
   "speaker": "user",
   "text": "Hold on, really?",
   "est_sec": 1.03,
   "gap_before": 1.36,
   "block": "personal_finance.dlg25",
   "kind": "wait_like",
   "phrasing": "waitlike_11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Let me double-check. I'd still stand by it, but tell me what you heard.",
   "est_sec": 4.44,
   "gap_before": 1.24,
   "role": "reply",
   "block": "personal_finance.dlg25"
  },
  {
   "speaker": "user",
   "text": "Will she get the money back?",
   "est_sec": 1.96,
   "gap_before": 0.84,
   "block": "personal_finance.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Banks can often refund fraud, especially if you report it quickly. Ask about it on the call.",
   "est_sec": 5.37,
   "gap_before": 0.9,
   "role": "reply",
   "block": "personal_finance.dlg25"
  },
  {
   "speaker": "user",
   "text": "She's so embarrassed. She",
   "est_sec": 1.34,
   "gap_before": 0.6,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg25"
  },
  {
   "speaker": "user",
   "text": "didn't want to tell me.",
   "est_sec": 1.65,
   "gap_before": 2.42,
   "block": "personal_finance.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Reassure her. These scams are very convincing, and they target lovely, trusting people. She did the right thing by telling you.",
