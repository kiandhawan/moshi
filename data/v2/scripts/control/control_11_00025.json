 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.42,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.67,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "There's a famous ridge walk my friends want to do, but I'm scared of heights.",
   "est_sec": 4.75,
   "gap_before": 0.56,
   "block": "hiking.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a real concern. Do you know how narrow it gets? Some ridges look scary in photos but feel wide when you're on them.",
   "est_sec": 7.54,
   "gap_before": 0.67,
   "role": "reply",
   "block": "hiking.dlg22"
  },
  {
   "speaker": "user",
   "text": "My friend said there's one bit with drops on both sides.",
   "est_sec": 3.51,
   "gap_before": 2.97,
   "block": "hiking.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's usually the hardest part for people with a fear of heights. Is there a bypass path around it?",
   "est_sec": 5.99,
   "gap_before": 0.71,
   "role": "reply",
   "block": "hiking.dlg22"
  },
  {
   "speaker": "user",
   "text": "No idea.",
   "est_sec": 0.72,
   "gap_before": 0.31,
   "block": "hiking.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Worth checking a guidebook or a walking forum. Many ridges have a lower path for exactly that reason.",
   "est_sec": 5.68,
   "gap_before": 1.99,
   "role": "reply",
   "block": "hiking.dlg22"
  },
  {
   "speaker": "user",
   "text": "And if there isn't?",
   "est_sec": 1.34,
   "gap_before": 1.26,
   "block": "hiking.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Try a smaller ridge first to see how you feel. And it's fine to turn back. Nobody good will mind.",
   "est_sec": 6.3,
   "gap_before": 1.19,
   "role": "reply",
   "block": "hiking.dlg22"
  }
 ]
}
