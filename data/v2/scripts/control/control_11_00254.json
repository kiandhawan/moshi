 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.83,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "My wife and I keep double-booking our weekends. Can our phones sort that out?",
   "est_sec": 4.44,
   "gap_before": 0.48,
   "block": "smartphones.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A shared calendar would help. Make one calendar called family, share it with her, and you'll both see and edit it.",
   "est_sec": 6.61,
   "gap_before": 0.92,
   "role": "reply",
   "block": "smartphones.dlg29"
  },
  {
   "speaker": "user",
   "text": "Do I have to put everything in there?",
   "est_sec": 2.58,
   "gap_before": 0.3,
   "block": "smartphones.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Just the things that affect both of you. Dinners, kids' events, trips. Your work meetings can stay in your own calendar.",
   "est_sec": 6.61,
   "gap_before": 1.03,
   "role": "reply",
   "block": "smartphones.dlg29"
  },
  {
   "speaker": "user",
   "text": "Her sister's birthday is usually the",
   "est_sec": 1.96,
   "gap_before": 1.19,
   "event": "distractor",
   "kind": "pause",
   "block": "smartphones.dlg29"
  },
  {
   "speaker": "user",
   "text": "the one we forget.",
   "est_sec": 1.34,
   "gap_before": 1.89,
   "block": "smartphones.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Add it as a yearly event with a reminder a week before. That way there's time to buy a present.",
   "est_sec": 6.3,
   "gap_before": 0.46,
   "role": "reply",
   "block": "smartphones.dlg29"
  },
  {
   "speaker": "user",
   "text": "A week. Yeah. Last year I bought flowers at a petrol station.",
   "est_sec": 3.82,
   "gap_before": 0.52,
   "block": "smartphones.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "We can do better than that this year.",
