   "text": "something with Portuguese audio for her?",
   "est_sec": 1.96,
   "gap_before": 2.28,
   "block": "movies.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a kind thought. If her English is good, she may prefer English with subtitles. Just ask her, it's a nice welcome either way.",
   "est_sec": 7.54,
   "gap_before": 1.19,
   "role": "reply",
   "block": "movies.dlg9"
  },
  {
