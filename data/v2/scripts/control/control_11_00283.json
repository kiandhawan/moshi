   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "My cousin's flying in from Brazil tonight, she'll be jetlagged. What film should we put on?",
   "est_sec": 5.06,
   "gap_before": 0.23,
   "block": "movies.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Something easy to follow that you can talk over. A light comedy or a heartwarming film is ideal, nothing with a complicated plot.",
   "est_sec": 7.23,
   "gap_before": 0.55,
   "role": "reply",
   "block": "movies.dlg9"
  },
  {
   "speaker": "user",
   "text": "She's into thrillers usually.",
   "est_sec": 1.34,
   "gap_before": 0.98,
   "block": "movies.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then save the thriller for tomorrow when she's rested. Jetlagged brains struggle with twists.",
   "est_sec": 4.44,
   "gap_before": 0.99,
   "role": "reply",
   "block": "movies.dlg9"
  },
  {
   "speaker": "user",
   "text": "Hey Nadia, did my package come today?",
   "est_sec": 2.27,
