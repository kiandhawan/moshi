 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.73,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.93,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "What should I do if a thunderstorm catches me on a ridge?",
   "est_sec": 3.82,
   "gap_before": 0.34,
   "block": "hiking.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Get off the high ground as fast as you safely can. Ridges and summits are the worst places to be.",
   "est_sec": 6.3,
   "gap_before": 0.32,
   "role": "reply",
   "block": "hiking.dlg19"
  },
  {
   "speaker": "user",
   "text": "What if I can't get down in time?",
   "est_sec": 2.58,
   "gap_before": 1.3,
   "block": "hiking.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Avoid lone trees and metal fences, and spread out if you're in a group. Crouch low on your pack, feet together, rather than lying flat.",
   "est_sec": 7.85,
   "gap_before": 0.39,
   "role": "reply",
   "block": "hiking.dlg19"
  },
  {
   "speaker": "user",
   "text": "Why not lie down?",
   "est_sec": 1.34,
   "gap_before": 1.44,
   "block": "hiking.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Lying flat puts more of your body in contact with the ground, where current can travel. Crouching keeps that smaller.",
   "est_sec": 6.3,
   "gap_before": 0.62,
   "role": "reply",
   "block": "hiking.dlg19"
  },
  {
   "speaker": "user",
   "text": "Scary stuff.",
   "est_sec": 0.72,
   "gap_before": 0.69,
   "block": "hiking.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It is, but rare if you plan well. Check the forecast, and if storms are likely in the afternoon, be off the tops by lunchtime.",
   "est_sec": 7.85,
   "gap_before": 0.82,
   "role": "reply",
   "block": "hiking.dlg19"
  }
 ]
}
