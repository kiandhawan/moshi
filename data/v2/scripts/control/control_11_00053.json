 "est_speech_sec": 46.15,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.73,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.81,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "We're thinking of getting backyard chickens. Is it a lot of work?",
   "est_sec": 3.82,
   "gap_before": 0.55,
   "block": "pets.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A bit, but less than a dog. They need feeding and water every day, eggs collecting, and a coop clean once a week or so.",
   "est_sec": 7.85,
   "gap_before": 0.84,
   "role": "reply",
   "block": "pets.dlg29"
  },
  {
   "speaker": "user",
   "text": "Do they need a lot of space?",
   "est_sec": 2.27,
   "gap_before": 1.01,
   "block": "pets.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A few chickens are happy in a medium garden, as long as the coop is secure and they get time to scratch around.",
   "est_sec": 7.23,
   "gap_before": 0.95,
   "role": "reply",
   "block": "pets.dlg29"
  },
  {
   "speaker": "user",
   "text": "What about foxes?",
   "est_sec": 1.03,
   "gap_before": 0.69,
   "block": "pets.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's the big one. The coop needs to be fox proof, with a solid lock and wire buried under the run.",
   "est_sec": 6.61,
   "gap_before": 0.84,
   "role": "reply",
   "block": "pets.dlg29"
  },
  {
   "speaker": "user",
   "text": "And noise?",
   "est_sec": 0.72,
   "gap_before": 2.15,
   "block": "pets.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Hens are fairly quiet, just a bit of clucking. Roosters are the loud ones, and you don't need one to get eggs.",
   "est_sec": 6.92,
   "gap_before": 1.02,
   "role": "reply",
   "block": "pets.dlg29"
  },
  {
   "speaker": "user",
   "text": "Huh, news to me.",
   "est_sec": 1.34,
   "gap_before": 1.09,
   "block": "pets.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A lot of people don't. Start with three hens, chickens are social and shouldn't live alone.",
   "est_sec": 5.06,
   "gap_before": 1.0,
   "role": "reply",
   "block": "pets.dlg29"
  }
 ]
}
