 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.6,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.56,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "Why does my floor creak right by the bed? It wakes my wife when I get up.",
   "est_sec": 5.37,
   "gap_before": 0.41,
   "block": "home_repair.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Creaks usually come from floorboards rubbing against each other or against a loose nail.",
   "est_sec": 4.44,
   "gap_before": 0.78,
   "role": "reply",
   "block": "home_repair.dlg25"
  },
  {
   "speaker": "user",
   "text": "Is it a big job to fix?",
   "est_sec": 2.27,
   "gap_before": 0.6,
   "block": "home_repair.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not necessarily. If you can get under the floor, a screw through the board into the joist often stops it.",
   "est_sec": 6.3,
   "gap_before": 0.65,
   "role": "reply",
   "block": "home_repair.dlg25"
  },
  {
   "speaker": "user",
   "text": "There's carpet over it, so I can't see.",
   "est_sec": 2.58,
   "gap_before": 1.02,
   "block": "home_repair.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "There are kits for that, special screws that go through carpet and snap off below the surface.",
   "est_sec": 5.37,
   "gap_before": 0.77,
   "role": "reply",
   "block": "home_repair.dlg25"
  },
  {
   "speaker": "user",
   "text": "Really? That",
   "est_sec": 0.72,
   "gap_before": 0.64,
   "event": "distractor",
   "kind": "pause",
   "block": "home_repair.dlg25"
  },
  {
   "speaker": "user",
   "text": "sounds like magic.",
   "est_sec": 1.03,
   "gap_before": 1.5,
   "block": "home_repair.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Almost. Find the joist by pressing around until the creak stops, then screw into that spot.",
   "est_sec": 5.06,
   "gap_before": 0.41,
   "role": "reply",
   "block": "home_repair.dlg25"
  }
 ]
}
