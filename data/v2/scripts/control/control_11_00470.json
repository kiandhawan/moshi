 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.41,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.7,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "I have about forty games I've bought and never played. How do I even choose?",
   "est_sec": 4.75,
   "gap_before": 0.58,
   "block": "video_games.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A classic backlog. One way is to pick by how long they take. Do you want a short win or a long project right now?",
   "est_sec": 7.85,
   "gap_before": 0.75,
   "role": "reply",
   "block": "video_games.dlg25"
  },
  {
   "speaker": "user",
   "text": "Tariq, is your knee any better since the physio?",
   "est_sec": 2.89,
   "gap_before": 1.46,
   "block": "nq_social_008",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_008",
   "name_pos": "start",
   "addressee": "Tariq"
  },
  {
   "speaker": "other",
   "text": "A bit. Stairs still hurt though.",
   "est_sec": 1.96,
   "gap_before": 0.76,
   "block": "nq_social_008"
  },
  {
   "speaker": "user",
   "text": "Short. I need to feel like I finish something.",
   "est_sec": 2.89,
   "gap_before": 1.16,
   "block": "video_games.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then look up how long each one takes to beat and sort by that. Pick the shortest one you're still curious about.",
   "est_sec": 6.92,
   "gap_before": 0.38,
   "role": "reply",
   "block": "video_games.dlg25"
  },
  {
   "speaker": "user",
   "text": "What if I don't",
   "est_sec": 1.34,
   "gap_before": 1.36,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg25"
  },
  {
   "speaker": "user",
   "text": "like it after an hour?",
   "est_sec": 1.65,
   "gap_before": 1.7,
   "block": "video_games.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Drop it, guilt free. A backlog isn't homework. Uninstalling things you won't play makes the list feel lighter too.",
   "est_sec": 5.99,
   "gap_before": 0.51,
   "role": "reply",
   "block": "video_games.dlg25"
  },
  {
   "speaker": "user",
   "text": "And stop buying new ones?",
   "est_sec": 1.65,
   "gap_before": 0.91,
   "block": "video_games.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That helps. Maybe a rule like finishing one before buying another, at least until the list is a bit friendlier.",
   "est_sec": 6.3,
   "gap_before": 0.87,
   "role": "reply",
   "block": "video_games.dlg25"
  }
 ]
