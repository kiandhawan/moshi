 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.62,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.72,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "The timetable says every twelve minutes, but there's no actual time listed. How am I supposed to plan?",
   "est_sec": 5.68,
   "gap_before": 0.36,
   "block": "public_transport.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That means it's a frequent service. Instead of exact times, buses run at a regular rhythm, so you'll never wait longer than about twelve minutes.",
   "est_sec": 7.85,
   "gap_before": 0.3,
   "role": "reply",
   "block": "public_transport.dlg30"
  },
  {
   "speaker": "user",
   "text": "So I just show up?",
   "est_sec": 1.65,
   "gap_before": 0.45,
   "block": "public_transport.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Basically, yes. If you need to be somewhere for a fixed time, assume the worst wait and add it on.",
   "est_sec": 6.3,
   "gap_before": 1.83,
   "role": "reply",
   "block": "public_transport.dlg30"
  },
  {
   "speaker": "user",
   "text": "Okay, and late",
   "est_sec": 1.03,
   "gap_before": 0.83,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg30"
  },
  {
   "speaker": "user",
   "text": "at night, does it change?",
   "est_sec": 1.65,
   "gap_before": 2.06,
   "block": "public_transport.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Often. The frequency drops in the evenings, and then the timetable might switch to exact times. Check the bottom of the sign.",
   "est_sec": 6.92,
   "gap_before": 1.18,
   "role": "reply",
   "block": "public_transport.dlg30"
  },
  {
   "speaker": "user",
   "text": "Ah, there's a little section there.",
   "est_sec": 1.96,
   "gap_before": 0.66,
   "block": "public_transport.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's the one. Those evening times are worth a photo.",
   "est_sec": 3.2,
   "gap_before": 0.69,
   "role": "reply",
   "block": "public_transport.dlg30"
  }
 ]
