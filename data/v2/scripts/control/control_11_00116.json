 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "I'm going to a used car lot tomorrow and I'm rubbish at haggling. Any advice?",
   "est_sec": 4.75,
   "gap_before": 0.46,
   "block": "cars.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sure. Look up what similar cars sell for in your area before you go, so you know a fair price.",
   "est_sec": 6.3,
   "gap_before": 0.88,
   "role": "reply",
   "block": "cars.dlg7"
  },
  {
   "speaker": "user",
   "text": "I've done that. The one I like is listed a bit high.",
   "est_sec": 3.82,
   "gap_before": 1.02,
   "block": "cars.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good. Start your offer below what you'd really pay, and point to specific things, like worn tyres or a missing service stamp.",
   "est_sec": 6.92,
   "gap_before": 0.64,
   "role": "reply",
   "block": "cars.dlg7"
  },
  {
   "speaker": "user",
   "text": "What if the salesman just says no?",
   "est_sec": 2.27,
   "gap_before": 0.46,
   "block": "cars.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Be ready to walk away politely. Often that's when the price moves. And ask about extras, like a full tank or new mats, if they won't drop the price.",
   "est_sec": 9.09,
   "gap_before": 0.38,
   "role": "reply",
   "block": "cars.dlg7"
  },
  {
   "speaker": "user",
   "text": "Should I mention",
   "est_sec": 1.03,
   "gap_before": 1.06,
   "event": "distractor",
   "kind": "pause",
   "block": "cars.dlg7"
  },
  {
   "speaker": "user",
   "text": "I'm paying cash?",
   "est_sec": 1.03,
   "gap_before": 2.0,
   "block": "cars.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not straight away. Some dealers make money on finance, so settle the car's price first, then talk about how you'll pay.",
   "est_sec": 6.61,
   "gap_before": 1.84,
   "role": "reply",
   "block": "cars.dlg7"
  }
 ]
}
