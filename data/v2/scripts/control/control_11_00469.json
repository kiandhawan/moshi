 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.43,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.32,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "There's a severe wind warning tonight. What should I do with the garden stuff?",
   "est_sec": 4.44,
   "gap_before": 0.27,
   "block": "weather_plans.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Bring in anything light, like cushions, plant pots, toys and the bins if you can.",
   "est_sec": 4.75,
   "gap_before": 1.49,
   "role": "reply",
   "block": "weather_plans.dlg15"
  },
  {
   "speaker": "user",
   "text": "We have a massive trampoline.",
   "est_sec": 1.65,
   "gap_before": 1.37,
   "block": "weather_plans.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Trampolines are notorious for flying. Either weigh it down with anchor kits or flip it upside down.",
   "est_sec": 5.37,
   "gap_before": 1.41,
   "role": "reply",
   "block": "weather_plans.dlg15"
  },
  {
   "speaker": "user",
   "text": "Upside down? Seriously?",
   "est_sec": 1.03,
   "gap_before": 0.7,
   "block": "weather_plans.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, it catches much less wind that way. Some people also take the net off.",
   "est_sec": 4.75,
   "gap_before": 0.6,
   "role": "reply",
   "block": "weather_plans.dlg15"
  },
  {
   "speaker": "user",
   "text": "Hold on, and the shed door keeps blowing open.",
   "est_sec": 2.89,
   "gap_before": 0.66,
   "block": "weather_plans.dlg15",
   "kind": "wait_like",
   "phrasing": "waitlike_14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Tie it or wedge it shut. Park the car away from trees if possible, and check on any elderly neighbours too.",
   "est_sec": 6.61,
   "gap_before": 0.66,
   "role": "reply",
   "block": "weather_plans.dlg15"
  }
 ]
