 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.35,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.78,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "Is it weird to play board games on your own?",
   "est_sec": 3.2,
   "gap_before": 0.26,
   "block": "board_games.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not at all. Solo gaming is really popular, and lots of games come with a one player mode built in.",
   "est_sec": 6.3,
   "gap_before": 0.59,
   "role": "reply",
   "block": "board_games.dlg5"
  },
  {
   "speaker": "user",
   "text": "How does that even work with no opponent?",
   "est_sec": 2.58,
   "gap_before": 1.42,
   "block": "board_games.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Usually the game plays against you with a deck of cards or simple rules, or you're trying to beat your own best score.",
   "est_sec": 7.23,
   "gap_before": 0.84,
   "role": "reply",
   "block": "board_games.dlg5"
  },
  {
   "speaker": "user",
   "text": "I work nights, so",
   "est_sec": 1.34,
   "gap_before": 0.67,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg5"
  },
  {
   "speaker": "user",
   "text": "my friends are never free when I am.",
   "est_sec": 2.58,
   "gap_before": 2.84,
   "block": "board_games.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then solo games are perfect for you. Puzzly ones where you build something, like a garden or a city, feel calm after a long shift.",
   "est_sec": 7.85,
   "gap_before": 0.51,
   "role": "reply",
   "block": "board_games.dlg5"
  },
  {
   "speaker": "user",
   "text": "Calm sounds good. My job is not calm.",
   "est_sec": 2.58,
   "gap_before": 1.21,
   "block": "board_games.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then avoid the ones with timers. Look for games that say solo mode in the description, and read reviews from people who mostly play alone.",
   "est_sec": 7.85,
   "gap_before": 0.52,
   "role": "reply",
   "block": "board_games.dlg5"
  }
 ]
}
