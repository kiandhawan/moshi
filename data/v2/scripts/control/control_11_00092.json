 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.72,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "Hey Moshi, I bought a kettlebell and I'm scared of the swing. It feels like it's going to fly through my window.",
   "est_sec": 6.92,
   "gap_before": 0.28,
   "block": "fitness.dlg12",
   "kind": "moshi_name",
   "name_pos": "start",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a fair worry. The key is that the power comes from your hips, not your arms.",
   "est_sec": 5.37,
   "gap_before": 0.35,
   "role": "reply",
   "block": "fitness.dlg12"
  },
  {
   "speaker": "user",
   "text": "My hips?",
   "est_sec": 0.72,
   "gap_before": 1.24,
   "block": "fitness.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Push your hips back like you're closing a car door with your bum, then snap them forward. Your arms just guide the bell.",
   "est_sec": 7.23,
   "gap_before": 0.64,
   "role": "reply",
   "block": "fitness.dlg12"
  },
  {
   "speaker": "user",
   "text": "That's a weird image but okay.",
   "est_sec": 1.96,
   "gap_before": 0.95,
   "block": "fitness.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It works. Keep your back flat and let the bell float up to chest height, no higher.",
   "est_sec": 5.37,
   "gap_before": 1.02,
   "role": "reply",
   "block": "fitness.dlg12"
  },
  {
   "speaker": "user",
   "text": "What weight",
   "est_sec": 0.72,
   "gap_before": 0.96,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg12"
  },
  {
   "speaker": "user",
   "text": "should a beginner use?",
   "est_sec": 1.34,
   "gap_before": 1.65,
   "block": "fitness.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Something you can control for fifteen swings with good form. For many people, that's eight to twelve kilos.",
   "est_sec": 5.68,
   "gap_before": 1.31,
   "role": "reply",
   "block": "fitness.dlg12"
  },
  {
   "speaker": "user",
   "text": "Mine's eight. Phew.",
   "est_sec": 1.03,
   "gap_before": 0.61,
   "block": "fitness.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Perfect starting point. Practice in a clear space, away from that window.",
   "est_sec": 3.82,
   "gap_before": 0.64,
