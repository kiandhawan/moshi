 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.61,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.91,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "My niece is vegan and I'd love to make her brownies. Is that even possible without eggs?",
   "est_sec": 5.37,
   "gap_before": 0.34,
   "block": "baking.dlg10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Absolutely. A flax egg works well in brownies. Mix one tablespoon of ground flaxseed with three of water and let it go gloopy for ten minutes.",
   "est_sec": 8.16,
   "gap_before": 0.88,
   "role": "reply",
   "block": "baking.dlg10"
  },
  {
   "speaker": "user",
   "text": "Gloopy. Lovely. And the butter?",
   "est_sec": 1.65,
   "gap_before": 1.04,
   "block": "baking.dlg10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Use a good vegan block butter or a neutral oil. Oil actually makes brownies extra fudgy.",
   "est_sec": 5.06,
   "gap_before": 0.38,
   "role": "reply",
   "block": "baking.dlg10"
  },
  {
   "speaker": "user",
   "text": "What about the chocolate? I'm not sure",
   "est_sec": 2.27,
   "gap_before": 0.3,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg10"
  },
  {
   "speaker": "user",
   "text": "which kinds are vegan.",
   "est_sec": 1.34,
   "gap_before": 2.73,
   "block": "baking.dlg10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most plain dark chocolate is, but check the label for milk powder. Cocoa powder is always fine.",
   "est_sec": 5.37,
   "gap_before": 0.3,
   "role": "reply",
   "block": "baking.dlg10"
  },
  {
   "speaker": "user",
   "text": "She'll be so surprised.",
   "est_sec": 1.34,
   "gap_before": 1.19,
   "block": "baking.dlg10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a lovely thing to do for her. Underbake them slightly, they firm up as they cool.",
   "est_sec": 5.37,
   "gap_before": 0.33,
   "role": "reply",
   "block": "baking.dlg10"
  }
 ]
}
