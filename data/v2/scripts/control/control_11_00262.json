 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.48,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "Every autumn I throw out my geraniums and buy new ones in spring. Moshi, feels wasteful.",
   "est_sec": 5.06,
   "gap_before": 0.59,
   "block": "gardening.dlg9",
   "kind": "moshi_name",
   "name_pos": "middle",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It is a bit. You can keep them over winter quite easily if you've got a cool, frost free spot, like a porch or a spare room.",
   "est_sec": 8.47,
   "gap_before": 1.16,
   "role": "reply",
   "block": "gardening.dlg9"
  },
  {
   "speaker": "user",
   "text": "Hold on a sec, there's an unheated porch. Gets cold but never freezes.",
   "est_sec": 4.13,
   "gap_before": 0.61,
   "block": "gardening.dlg9",
   "kind": "wait_like",
   "phrasing": "waitlike_17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's ideal. Dig them up before the first frost, cut them back by about half, and pot them up snugly.",
   "est_sec": 6.3,
   "gap_before": 0.35,
   "role": "reply",
   "block": "gardening.dlg9"
  },
  {
   "speaker": "user",
   "text": "Do they need watering all winter?",
   "est_sec": 1.96,
   "gap_before": 2.18,
   "block": "gardening.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Hardly at all. Just a splash once a month so the roots don't completely dry out. They'll look sad, and that's fine.",
   "est_sec": 6.92,
   "gap_before": 1.89,
   "role": "reply",
   "block": "gardening.dlg9"
  },
  {
   "speaker": "user",
   "text": "And then in spring?",
   "est_sec": 1.34,
   "gap_before": 1.42,
   "block": "gardening.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Bring them somewhere brighter, water more, and they'll push out new shoots. You can even take cuttings and double your plants for free.",
   "est_sec": 7.23,
   "gap_before": 1.28,
   "role": "reply",
   "block": "gardening.dlg9"
  }
 ]
}
