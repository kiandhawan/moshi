 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.47,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.91,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "Help. I put way too much salt in my lentil soup.",
   "est_sec": 3.51,
   "gap_before": 0.31,
   "block": "cooking.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Okay, it's fixable. Can you add more liquid, like water or unsalted stock?",
   "est_sec": 4.13,
   "gap_before": 1.0,
   "role": "reply",
   "block": "cooking.dlg8"
  },
  {
   "speaker": "user",
   "text": "Yeah, but it'll get really thin.",
   "est_sec": 1.96,
   "gap_before": 0.79,
   "block": "cooking.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then add more lentils or a potato to bulk it up and thicken it again. Simmer until they're soft.",
   "est_sec": 5.99,
   "gap_before": 0.67,
   "role": "reply",
   "block": "cooking.dlg8"
  },
  {
   "speaker": "user",
   "text": "I heard you can drop a raw potato in to soak up salt.",
   "est_sec": 4.13,
   "gap_before": 1.7,
   "block": "cooking.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's mostly a myth. It absorbs a little salty liquid, but really it's the dilution that helps.",
   "est_sec": 5.37,
   "gap_before": 0.56,
   "role": "reply",
   "block": "cooking.dlg8"
  },
  {
   "speaker": "user",
   "text": "Oh. Well, I'll try more lentils",
   "est_sec": 1.96,
   "gap_before": 1.56,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg8"
  },
  {
   "speaker": "user",
   "text": "plus some water, then.",
   "est_sec": 1.34,
   "gap_before": 2.83,
   "block": "cooking.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good plan. A squeeze of lemon at the end also makes salty food taste more balanced.",
   "est_sec": 5.06,
   "gap_before": 0.89,
   "role": "reply",
   "block": "cooking.dlg8"
  }
 ]
