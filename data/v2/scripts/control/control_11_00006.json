 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.91,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "I work in a hospital, so my weekend is Tuesday and Wednesday. Nobody's free.",
   "est_sec": 4.44,
   "gap_before": 0.28,
   "block": "weekend_plans.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That can feel lonely, but weekdays have perks. Everything's quieter, from museums to cinemas.",
   "est_sec": 4.44,
   "gap_before": 0.36,
   "role": "reply",
   "block": "weekend_plans.dlg31"
  },
  {
   "speaker": "user",
   "text": "True. The cinema's empty on a Tuesday.",
   "est_sec": 2.27,
   "gap_before": 0.46,
   "block": "weekend_plans.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "And many places have cheaper midweek prices. You could treat yourself to things you'd skip on a crowded weekend.",
   "est_sec": 5.99,
   "gap_before": 1.18,
   "role": "reply",
   "block": "weekend_plans.dlg31"
  },
  {
   "speaker": "user",
   "text": "I'd still like",
   "est_sec": 1.03,
   "gap_before": 1.08,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg31"
  },
  {
   "speaker": "user",
   "text": "to see people though.",
   "est_sec": 1.34,
   "gap_before": 1.86,
   "block": "weekend_plans.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Look for others with odd schedules, like coworkers or groups for shift workers. Or meet a friend for an early dinner after their work.",
   "est_sec": 7.54,
   "gap_before": 1.12,
   "role": "reply",
   "block": "weekend_plans.dlg31"
  },
  {
   "speaker": "user",
   "text": "Good idea. A colleague has the same days off.",
   "est_sec": 2.89,
   "gap_before": 0.67,
   "block": "weekend_plans.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Perfect. Make it a regular Tuesday thing, it'll give your week a shape.",
   "est_sec": 4.13,
   "gap_before": 0.66,
   "role": "reply",
   "block": "weekend_plans.dlg31"
  }
 ]
}
