   "gap_before": 0.87,
   "block": "music.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Much quieter than real drums. You'll hear a soft tapping, but nothing like the full noise.",
   "est_sec": 5.06,
   "gap_before": 0.85,
   "role": "reply",
   "block": "music.dlg4"
  },
  {
   "speaker": "user",
   "text": "Are they expensive?",
