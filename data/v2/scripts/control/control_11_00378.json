 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.75,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.42,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "I teach year eleven and they're just not revising. Any ideas to help them?",
   "est_sec": 4.44,
   "gap_before": 0.54,
   "block": "studying.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Teenagers often don't know how to revise, they just reread. Teaching them a few methods directly can help a lot.",
   "est_sec": 6.3,
   "gap_before": 1.07,
   "role": "reply",
   "block": "studying.dlg28"
  },
  {
   "speaker": "user",
   "text": "Like what, flashcards?",
   "est_sec": 1.03,
   "gap_before": 1.13,
   "block": "studying.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Flashcards, self quizzing, and explaining things to a partner. Try short in class quizzes so they see the benefit.",
   "est_sec": 5.99,
   "gap_before": 0.59,
   "role": "reply",
   "block": "studying.dlg28"
  },
  {
   "speaker": "user",
   "text": "They groan at quizzes.",
   "est_sec": 1.34,
   "gap_before": 1.28,
   "block": "studying.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Make them low stakes, maybe a quick team quiz at the start of lessons. No marks recorded, just practice.",
   "est_sec": 5.99,
   "gap_before": 0.46,
   "role": "reply",
   "block": "studying.dlg28"
  },
  {
   "speaker": "user",
   "text": "And getting them to",
   "est_sec": 1.34,
   "gap_before": 0.34,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg28"
  },
  {
   "speaker": "user",
   "text": "actually do it at home?",
   "est_sec": 1.65,
   "gap_before": 2.68,
   "block": "studying.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Give them a simple weekly plan and check in on it briefly. Small, regular habits beat big revision lectures.",
   "est_sec": 5.99,
   "gap_before": 1.03,
   "role": "reply",
   "block": "studying.dlg28"
  }
 ]
}
