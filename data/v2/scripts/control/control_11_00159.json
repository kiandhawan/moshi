 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.71,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.72,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "What's the deal with liquids in hand luggage? I keep getting stuff taken off me.",
   "est_sec": 4.75,
   "gap_before": 0.22,
   "block": "travel_planning.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most airports allow containers up to a hundred millilitres each, all in one small clear bag.",
   "est_sec": 5.06,
   "gap_before": 0.57,
   "role": "reply",
   "block": "travel_planning.dlg7"
  },
  {
   "speaker": "user",
   "text": "Even toothpaste?",
   "est_sec": 0.72,
   "gap_before": 0.96,
   "block": "travel_planning.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, toothpaste counts as a liquid. So do creams, gels and peanut butter, oddly.",
   "est_sec": 4.44,
   "gap_before": 0.76,
   "role": "reply",
   "block": "travel_planning.dlg7"
  },
  {
   "speaker": "user",
   "text": "Peanut butter. So that's what happened.",
   "est_sec": 1.96,
   "gap_before": 1.13,
   "block": "travel_planning.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ha, that catches lots of people. Some airports with new scanners have looser rules, but it's safest to assume the old ones.",
   "est_sec": 6.92,
   "gap_before": 0.45,
   "role": "reply",
   "block": "travel_planning.dlg7"
  },
  {
   "speaker": "user",
   "text": "What about my",
   "est_sec": 1.03,
   "gap_before": 0.53,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg7"
  },
  {
   "speaker": "user",
   "text": "um, contact lens solution?",
   "est_sec": 1.34,
   "gap_before": 1.99,
   "block": "travel_planning.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Get a travel size bottle under a hundred millilitres, or buy a big one when you land.",
   "est_sec": 5.37,
   "gap_before": 0.49,
   "role": "reply",
   "block": "travel_planning.dlg7"
  }
 ]
