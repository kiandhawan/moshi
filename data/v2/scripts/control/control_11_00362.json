 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.72,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.65,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "Right, I've decided. This winter I'm making proper croissants from scratch, Moshi.",
   "est_sec": 3.82,
   "gap_before": 0.45,
   "block": "baking.dlg13",
   "kind": "moshi_name",
   "name_pos": "end",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Love the ambition. It's a three day project if you do it properly, but most of that is the dough resting in the fridge.",
   "est_sec": 7.54,
   "gap_before": 0.86,
   "role": "reply",
   "block": "baking.dlg13"
  },
  {
   "speaker": "user",
   "text": "Three days? I was hoping for Saturday morning.",
   "est_sec": 2.58,
   "gap_before": 0.73,
   "block": "baking.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can squeeze it into two. Make the dough Thursday night, laminate Friday, shape and bake Saturday.",
   "est_sec": 5.37,
   "gap_before": 1.19,
   "role": "reply",
   "block": "baking.dlg13"
  },
  {
   "speaker": "user",
   "text": "Laminate means",
   "est_sec": 0.72,
   "gap_before": 1.43,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg13"
  },
  {
   "speaker": "user",
   "text": "the butter folding thing, yeah?",
   "est_sec": 1.65,
   "gap_before": 2.67,
   "block": "baking.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. You wrap a flat slab of cold butter in dough and roll and fold it a few times to build layers.",
   "est_sec": 6.92,
   "gap_before": 0.41,
   "role": "reply",
   "block": "baking.dlg13"
  },
  {
   "speaker": "user",
   "text": "Hold on, can you say that again?",
   "est_sec": 2.27,
   "gap_before": 0.6,
   "block": "baking.dlg13",
   "kind": "wait_like",
   "phrasing": "waitlike_02",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sure. Exactly. You wrap a flat slab of cold butter in dough and roll and fold it a few times to build layers.",
   "est_sec": 7.23,
   "gap_before": 0.4,
   "role": "reply",
   "block": "baking.dlg13"
  },
  {
   "speaker": "user",
   "text": "What usually goes wrong?",
   "est_sec": 1.34,
   "gap_before": 2.42,
   "block": "baking.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Butter that's too warm and leaks out, or too cold and shatters. It should bend like modelling clay.",
   "est_sec": 5.68,
   "gap_before": 0.96,
   "role": "reply",
   "block": "baking.dlg13"
  },
  {
   "speaker": "user",
   "text": "Modelling clay. Okay, noted.",
   "est_sec": 1.34,
   "gap_before": 1.34,
   "block": "baking.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "And keep the kitchen cool. Croissants hate a hot room.",
   "est_sec": 3.2,
   "gap_before": 0.88,
   "role": "reply",
   "block": "baking.dlg13"
  }
 ]
}
