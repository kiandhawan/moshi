 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.68,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "My garden is drowning in cucumbers. Can I pickle them without canning equipment?",
   "est_sec": 4.13,
   "gap_before": 0.4,
   "block": "cooking.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, fridge pickles are easy. You just need jars, vinegar, water, salt, a little sugar and some dill.",
   "est_sec": 5.68,
   "gap_before": 0.42,
   "role": "reply",
   "block": "cooking.dlg25"
  },
  {
   "speaker": "user",
   "text": "What ratio?",
   "est_sec": 0.72,
   "gap_before": 0.31,
   "block": "cooking.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Equal parts vinegar and water, with about a tablespoon of salt and a teaspoon of sugar per cup of liquid.",
   "est_sec": 6.3,
   "gap_before": 0.75,
   "role": "reply",
   "block": "cooking.dlg25"
  },
  {
   "speaker": "user",
   "text": "Lucia, have you seen my blue notebook?",
   "est_sec": 2.27,
   "gap_before": 1.05,
   "block": "nq_work_046",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_work_046",
   "name_pos": "start",
   "addressee": "Lucia"
  },
  {
   "speaker": "user",
   "text": "Hot or cold?",
   "est_sec": 1.03,
   "gap_before": 2.01,
   "block": "cooking.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Heat the liquid just until the salt dissolves, then pour it over the sliced cucumbers in the jars.",
   "est_sec": 5.68,
   "gap_before": 0.74,
   "role": "reply",
   "block": "cooking.dlg25"
  },
  {
   "speaker": "user",
   "text": "And how long until they're ready?",
   "est_sec": 1.96,
   "gap_before": 0.96,
   "block": "cooking.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "They're tasty after a day, and best after three or four. Keep them in the fridge and eat them within a month.",
   "est_sec": 6.92,
   "gap_before": 0.33,
   "role": "reply",
   "block": "cooking.dlg25"
  },
  {
   "speaker": "user",
   "text": "A month, that's fine. We go through",
   "est_sec": 2.27,
   "gap_before": 0.59,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg25"
  },
  {
   "speaker": "user",
   "text": "a ridiculous amount of pickles.",
   "est_sec": 1.65,
   "gap_before": 2.72,
   "block": "cooking.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then make a few jars with garlic or chili flakes too, for some variety.",
   "est_sec": 4.44,
   "gap_before": 0.31,
   "role": "reply",
   "block": "cooking.dlg25"
  }
