 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.32,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "I take terrible photos on hikes. Everything looks flat.",
   "est_sec": 2.89,
   "gap_before": 0.4,
   "block": "hiking.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's often the light. Midday sun flattens everything. Early morning or late afternoon gives you shadows and warmer colours.",
   "est_sec": 5.99,
   "gap_before": 0.87,
   "role": "reply",
   "block": "hiking.dlg16"
  },
  {
   "speaker": "user",
   "text": "I can't always hike at those times.",
   "est_sec": 2.27,
   "gap_before": 0.82,
   "block": "hiking.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Fair. Then try putting something in the foreground, like a rock, a tree or your friend, with the view behind. It adds depth straight away.",
   "est_sec": 7.85,
   "gap_before": 0.74,
   "role": "reply",
   "block": "hiking.dlg16"
  },
  {
   "speaker": "user",
   "text": "Oh, like a person looking out at the view?",
   "est_sec": 2.89,
   "gap_before": 1.15,
   "block": "hiking.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Exactly, it also shows how big the landscape is. Just don't make them stand near a cliff edge for it.",
   "est_sec": 6.3,
   "gap_before": 1.52,
   "role": "reply",
   "block": "hiking.dlg16"
  },
  {
   "speaker": "user",
   "text": "Ha, noted. And",
   "est_sec": 1.03,
   "gap_before": 0.37,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg16"
  },
  {
   "speaker": "user",
   "text": "should I bother with a proper camera?",
   "est_sec": 2.27,
   "gap_before": 2.93,
   "block": "hiking.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Your phone is plenty to start. Learn the basics on that first.",
   "est_sec": 3.82,
   "gap_before": 0.77,
   "role": "reply",
   "block": "hiking.dlg16"
  }
 ]
