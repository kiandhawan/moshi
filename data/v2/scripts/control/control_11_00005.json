   "gap_before": 1.7,
   "block": "movies.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Usually longer, sometimes with a different ending or extra scenes that explain things.",
   "est_sec": 4.13,
   "gap_before": 0.4,
   "role": "reply",
   "block": "movies.dlg6"
  },
