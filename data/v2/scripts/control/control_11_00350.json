 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.68,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.52,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "Why does my washing machine smell like a swamp? It's supposed to clean things.",
   "est_sec": 4.44,
   "gap_before": 0.38,
   "block": "cleaning.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ironic, right? Usually it's damp left in the rubber seal and the detergent drawer. Mould loves it.",
   "est_sec": 5.37,
   "gap_before": 0.52,
   "role": "reply",
   "block": "cleaning.dlg7"
  },
  {
   "speaker": "user",
   "text": "Ugh. I just looked in the seal. There's black gunk.",
   "est_sec": 3.2,
   "gap_before": 1.23,
   "block": "cleaning.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Wipe it out with a cloth and some diluted white vinegar. Then pull out the detergent drawer and rinse it under hot water.",
   "est_sec": 7.23,
   "gap_before": 0.75,
   "role": "reply",
   "block": "cleaning.dlg7"
  },
  {
   "speaker": "user",
   "text": "What do you fancy for tea tonight, Skylar?",
   "est_sec": 2.58,
   "gap_before": 1.26,
   "block": "nq_home_063",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_063",
   "name_pos": "end",
   "addressee": "Skylar"
  },
  {
   "speaker": "user",
   "text": "Anything else?",
   "est_sec": 0.72,
   "gap_before": 2.25,
   "block": "cleaning.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Run an empty hot wash, the hottest setting. And afterwards, leave the door and drawer open a crack so it can dry.",
   "est_sec": 6.92,
   "gap_before": 1.19,
   "role": "reply",
   "block": "cleaning.dlg7"
  },
  {
   "speaker": "user",
   "text": "I always shut it. I thought that",
   "est_sec": 2.27,
   "gap_before": 1.33,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg7"
  },
  {
   "speaker": "user",
   "text": "was tidier.",
   "est_sec": 0.72,
   "gap_before": 2.91,
   "block": "cleaning.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Very common. A little open door is the secret.",
   "est_sec": 2.89,
   "gap_before": 0.86,
   "role": "reply",
   "block": "cleaning.dlg7"
  }
 ]
}
