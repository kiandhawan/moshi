 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.48,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.74,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "What's a deck building game? My friends keep mentioning it.",
   "est_sec": 3.2,
   "gap_before": 0.3,
   "block": "board_games.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Everyone starts with the same small deck of weak cards. During the game you buy better cards and add them, so your deck grows stronger.",
   "est_sec": 7.85,
   "gap_before": 0.62,
   "role": "reply",
   "block": "board_games.dlg20"
  },
  {
   "speaker": "user",
   "text": "Francesca, which streaming thing are we paying for this month?",
   "est_sec": 3.2,
   "gap_before": 3.39,
   "block": "nq_social_006",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_006",
   "name_pos": "start",
   "addressee": "Francesca"
  },
  {
   "speaker": "other",
   "text": "Just the one with the dragon show.",
   "est_sec": 2.27,
   "gap_before": 0.33,
   "block": "nq_social_006"
  },
  {
   "speaker": "user",
   "text": "So it's like collecting cards?",
   "est_sec": 1.65,
   "gap_before": 1.33,
   "block": "board_games.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Kind of, but it all happens inside one game. You don't need to buy packs, everything comes in the box.",
   "est_sec": 6.3,
   "gap_before": 0.88,
   "role": "reply",
   "block": "board_games.dlg20"
  },
  {
   "speaker": "user",
   "text": "And how do you win?",
   "est_sec": 1.65,
   "gap_before": 1.21,
   "block": "board_games.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Usually by having the most points at the end, which come from certain cards. The fun is building a deck that works well together.",
   "est_sec": 7.54,
   "gap_before": 1.08,
   "role": "reply",
   "block": "board_games.dlg20"
  },
  {
   "speaker": "user",
   "text": "Sounds a bit",
   "est_sec": 1.03,
   "gap_before": 0.4,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg20"
  },
  {
   "speaker": "user",
   "text": "mathsy, honestly.",
   "est_sec": 0.72,
   "gap_before": 2.16,
   "block": "board_games.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It can be, but the first few games feel more like a puzzle than maths. Ask your friends to teach you a lighter one first.",
   "est_sec": 7.85,
   "gap_before": 0.42,
   "role": "reply",
   "block": "board_games.dlg20"
  }
 ]
