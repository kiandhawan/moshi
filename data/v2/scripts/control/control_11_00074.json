 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.62,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.47,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "I work nights in a hospital and I sleep during the day. My phone keeps waking me up.",
   "est_sec": 5.68,
   "gap_before": 0.27,
   "block": "smartphones.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Set a do not disturb schedule for your sleep hours. It silences everything at once.",
   "est_sec": 4.75,
   "gap_before": 1.73,
   "role": "reply",
   "block": "smartphones.dlg14"
  },
  {
   "speaker": "user",
   "text": "But I can't miss calls from my kids' school. That's the whole problem.",
   "est_sec": 4.13,
   "gap_before": 0.77,
   "block": "smartphones.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can allow certain contacts through. Add the school and your partner as favourites, and only they will ring.",
   "est_sec": 5.99,
   "gap_before": 0.35,
   "role": "reply",
   "block": "smartphones.dlg14"
  },
  {
   "speaker": "user",
   "text": "And if a call comes from the school office instead of",
   "est_sec": 3.51,
   "gap_before": 0.48,
   "event": "distractor",
   "kind": "pause",
   "block": "smartphones.dlg14"
  },
  {
   "speaker": "user",
   "text": "the number I saved?",
   "est_sec": 1.34,
   "gap_before": 2.32,
   "block": "smartphones.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good thinking. There's often a setting that lets a call through if the same number tries twice within a few minutes. Schools usually do try again if it's urgent.",
   "est_sec": 9.09,
   "gap_before": 1.94,
   "role": "reply",
   "block": "smartphones.dlg14"
  },
  {
   "speaker": "user",
   "text": "That's actually perfect. Why didn't I do this years ago?",
   "est_sec": 3.2,
   "gap_before": 1.11,
   "block": "smartphones.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Better late than never. Sleep well today.",
   "est_sec": 2.27,
   "gap_before": 1.0,
   "role": "reply",
   "block": "smartphones.dlg14"
  }
 ]
}
