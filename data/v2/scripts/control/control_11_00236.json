   "gap_before": 0.72,
   "block": "studying.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "There's a little rhyme for eight times eight. I ate and I ate till I was sick on the floor, eight times eight is sixty four.",
