  },
  {
   "speaker": "user",
   "text": "My grandson is struggling with times tables. Any tricks I can teach him?",
   "est_sec": 4.13,
   "gap_before": 0.47,
   "block": "studying.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Lots. Which ones give him the most trouble?",
