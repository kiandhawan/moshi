 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.53,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "My friend says knees should never go past your toes when you squat. True?",
   "est_sec": 4.44,
   "gap_before": 0.41,
   "block": "fitness.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's an old rule that isn't really true for most people. Knees going forward is natural, especially if you're tall.",
   "est_sec": 6.3,
   "gap_before": 1.22,
   "role": "reply",
   "block": "fitness.dlg24"
  },
  {
   "speaker": "user",
   "text": "So I can just let them go?",
   "est_sec": 2.27,
   "gap_before": 3.47,
   "block": "fitness.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, as long as your heels stay down and your knees track over your toes, not collapsing inward.",
   "est_sec": 5.68,
   "gap_before": 1.17,
   "role": "reply",
   "block": "fitness.dlg24"
  },
  {
   "speaker": "user",
   "text": "How deep should I go?",
   "est_sec": 1.65,
   "gap_before": 1.51,
   "block": "fitness.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "As deep as you can while keeping your back neutral and heels down. For many people that's thighs parallel or lower.",
   "est_sec": 6.61,
   "gap_before": 0.5,
   "role": "reply",
   "block": "fitness.dlg24"
  },
  {
   "speaker": "user",
   "text": "My heels lift",
   "est_sec": 1.03,
   "gap_before": 1.02,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg24"
  },
  {
   "speaker": "user",
   "text": "when I go low.",
   "est_sec": 1.34,
   "gap_before": 2.19,
   "block": "fitness.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That often means tight ankles. Try putting small plates under your heels and work on ankle mobility.",
   "est_sec": 5.37,
   "gap_before": 0.64,
   "role": "reply",
   "block": "fitness.dlg24"
  }
