  },
  {
   "speaker": "user",
   "text": "Quick one. Hardcover or paperback for a gift?",
   "est_sec": 2.58,
   "gap_before": 0.6,
   "block": "books.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Hardcover feels more special and lasts longer, so it's lovely for a gift. Paperbacks are cheaper and easier to carry around.",
   "est_sec": 6.61,
   "gap_before": 0.55,
   "role": "reply",
   "block": "books.dlg32"
  },
  {
   "speaker": "user",
   "text": "It's for my best friend who reads on the subway.",
