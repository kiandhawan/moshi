 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.61,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.72,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "My rescue dog gets anxious with change. How do I move house without stressing him out?",
   "est_sec": 5.06,
   "gap_before": 0.29,
   "block": "moving_house.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Keep his routine as normal as possible during packing. Same walks, same feeding times.",
   "est_sec": 4.44,
   "gap_before": 0.9,
   "role": "reply",
   "block": "moving_house.dlg7"
  },
  {
   "speaker": "user",
   "text": "Did the parrot learn another rude word, Connor?",
   "est_sec": 2.58,
   "gap_before": 0.93,
   "block": "nq_home_079",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_079",
   "name_pos": "end",
   "addressee": "Connor"
  },
  {
   "speaker": "other",
   "text": "He's been listening to Grandad.",
   "est_sec": 1.65,
   "gap_before": 0.35,
   "block": "nq_home_079"
  },
  {
   "speaker": "user",
   "text": "And on moving day itself?",
   "est_sec": 1.65,
   "gap_before": 1.05,
   "block": "moving_house.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "If you can, have a friend look after him away from the chaos. Doors open all day are a risk for an anxious dog.",
   "est_sec": 7.54,
   "gap_before": 0.89,
   "role": "reply",
   "block": "moving_house.dlg7"
  },
  {
   "speaker": "user",
   "text": "Right, he'd bolt. What about the new place?",
   "est_sec": 2.58,
   "gap_before": 2.32,
   "block": "moving_house.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Set up his bed, bowls and toys in one room first, with something that smells of the old house. Let him explore slowly.",
   "est_sec": 7.23,
   "gap_before": 1.07,
   "role": "reply",
   "block": "moving_house.dlg7"
  },
  {
   "speaker": "user",
   "text": "He does love",
   "est_sec": 1.03,
   "gap_before": 1.24,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg7"
  },
  {
   "speaker": "user",
   "text": "my old hoodie.",
   "est_sec": 1.03,
   "gap_before": 2.18,
   "block": "moving_house.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Perfect, put that in his bed. And walk him around the new area a lot in the first week so it starts smelling like home.",
   "est_sec": 7.85,
   "gap_before": 1.2,
   "role": "reply",
   "block": "moving_house.dlg7"
  }
 ]
