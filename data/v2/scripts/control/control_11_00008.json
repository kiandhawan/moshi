 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.55,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.48,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "Hi, I'm a student in a rented flat. There's mold on the ceiling above the shower.",
   "est_sec": 5.06,
   "gap_before": 0.43,
   "block": "home_repair.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's really common in bathrooms. Do you have a fan or a window in there?",
   "est_sec": 4.75,
   "gap_before": 0.49,
   "role": "reply",
   "block": "home_repair.dlg20"
  },
  {
   "speaker": "user",
   "text": "A tiny window that's painted shut.",
   "est_sec": 1.96,
   "gap_before": 1.24,
   "block": "home_repair.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then moisture has nowhere to go. Tell your landlord about the window, that's their job to fix.",
   "est_sec": 5.37,
   "gap_before": 0.86,
   "role": "reply",
   "block": "home_repair.dlg20"
  },
  {
   "speaker": "user",
   "text": "Can I clean the mold myself in the meantime?",
   "est_sec": 2.89,
   "gap_before": 1.46,
   "block": "home_repair.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes. A mold spray or diluted bleach on a cloth works. Wear gloves and open the door while you do it.",
   "est_sec": 6.61,
   "gap_before": 1.1,
   "role": "reply",
   "block": "home_repair.dlg20"
  },
  {
   "speaker": "user",
   "text": "Will it come back?",
   "est_sec": 1.34,
   "gap_before": 1.29,
   "block": "home_repair.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Probably, unless the steam can escape. Leave the door open after showers and wipe the walls down. Small habits help a lot.",
   "est_sec": 6.92,
   "gap_before": 0.33,
   "role": "reply",
   "block": "home_repair.dlg20"
  }
 ]
}
