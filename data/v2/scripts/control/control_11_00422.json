 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.73,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.92,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "Under my bathroom sink is a jungle of half-empty bottles. How do I tidy it, Moshi?",
   "est_sec": 5.06,
   "gap_before": 0.52,
   "block": "cleaning.dlg32",
   "kind": "moshi_name",
   "name_pos": "end",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Empty it completely and group what's left. Cleaning sprays, spare toiletries, and random stuff.",
   "est_sec": 4.44,
   "gap_before": 1.34,
   "role": "reply",
   "block": "cleaning.dlg32"
  },
  {
   "speaker": "user",
   "text": "I found four bottles of the same bathroom spray.",
   "est_sec": 2.89,
   "gap_before": 0.36,
   "block": "cleaning.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Combine them if they're the same, and recycle the empties.",
   "est_sec": 3.2,
   "gap_before": 1.05,
   "role": "reply",
   "block": "cleaning.dlg32"
  },
  {
   "speaker": "user",
   "text": "Okay. And then?",
   "est_sec": 1.03,
   "gap_before": 0.45,
   "block": "cleaning.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Two small baskets or a little pull-out drawer make it easy to grab things. A tension rod across the top lets you hang spray bottles by their triggers.",
   "est_sec": 8.78,
   "gap_before": 0.35,
   "role": "reply",
   "block": "cleaning.dlg32"
  },
  {
   "speaker": "user",
   "text": "Hold on, that's not right.",
   "est_sec": 1.65,
   "gap_before": 3.01,
   "block": "cleaning.dlg32",
   "kind": "wait_like",
   "phrasing": "waitlike_07",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Let me double-check. I'd still stand by it, but tell me what you heard.",
   "est_sec": 4.44,
   "gap_before": 0.94,
   "role": "reply",
   "block": "cleaning.dlg32"
  },
  {
