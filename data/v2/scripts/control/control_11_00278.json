 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.41,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.31,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I'm vegan and I want a plant milk that actually foams for cappuccinos.",
   "est_sec": 4.13,
   "gap_before": 0.41,
   "block": "coffee.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Oat milk is usually the winner. Look for barista versions, they add a bit of fat so it froths like dairy.",
   "est_sec": 6.61,
   "gap_before": 0.56,
   "role": "reply",
   "block": "coffee.dlg9"
  },
  {
   "speaker": "user",
   "text": "I tried regular oat milk and it went flat.",
   "est_sec": 2.89,
   "gap_before": 1.39,
   "block": "coffee.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's very common with the regular kind. The barista ones hold the foam much better and don't split in hot coffee.",
   "est_sec": 6.61,
   "gap_before": 0.88,
   "role": "reply",
   "block": "coffee.dlg9"
  },
  {
   "speaker": "user",
   "text": "What about soy?",
   "est_sec": 1.03,
   "gap_before": 1.06,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg9"
  },
  {
   "speaker": "user",
   "text": "Is soy any good?",
   "est_sec": 1.34,
   "gap_before": 1.68,
   "block": "coffee.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Soy foams well too, and some people prefer its creamier texture. Almond is the trickiest, it tends to make big bubbles that collapse quickly.",
   "est_sec": 7.54,
   "gap_before": 0.91,
   "role": "reply",
   "block": "coffee.dlg9"
  },
  {
   "speaker": "user",
   "text": "Should I heat it as hot as dairy milk?",
   "est_sec": 2.89,
   "gap_before": 0.99,
   "block": "coffee.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A bit less hot, actually. Plant milks taste best and foam best when they're warm but not scalding.",
   "est_sec": 5.68,
   "gap_before": 1.03,
   "role": "reply",
   "block": "coffee.dlg9"
  }
 ]
}
