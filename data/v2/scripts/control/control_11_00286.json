 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.58,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.91,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "My Turkish neighbour made me coffee in a little pot and it was amazing. Can I make it at home?",
   "est_sec": 6.3,
   "gap_before": 0.39,
   "block": "coffee.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can. You'll want a small long handled pot, very finely ground coffee, almost like powder, and cold water.",
   "est_sec": 5.99,
   "gap_before": 1.71,
   "role": "reply",
   "block": "coffee.dlg16"
  },
  {
   "speaker": "user",
   "text": "Do I need special coffee?",
   "est_sec": 1.65,
   "gap_before": 0.88,
   "block": "coffee.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Many shops sell coffee ground specifically for it. Regular coffee ground on the finest setting can work if your grinder goes that fine.",
   "est_sec": 7.23,
   "gap_before": 1.11,
   "role": "reply",
   "block": "coffee.dlg16"
  },
  {
   "speaker": "user",
   "text": "And sugar? She asked me",
   "est_sec": 1.65,
   "gap_before": 1.05,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg16"
  },
  {
   "speaker": "user",
   "text": "how sweet I wanted it.",
   "est_sec": 1.65,
   "gap_before": 2.64,
   "block": "coffee.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's because the sugar goes in at the start. You mix coffee, sugar and water in the pot, then heat it slowly without boiling.",
   "est_sec": 7.54,
   "gap_before": 1.09,
   "role": "reply",
   "block": "coffee.dlg16"
  },
  {
   "speaker": "user",
   "text": "How do I know when it's done?",
   "est_sec": 2.27,
   "gap_before": 0.86,
   "block": "coffee.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "When a thick foam rises up to the top, take it off the heat just before it boils over. Pour gently to keep the foam, and let the grounds settle before sipping.",
   "est_sec": 10.02,
   "gap_before": 0.66,
   "role": "reply",
   "block": "coffee.dlg16"
  }
 ]
}
