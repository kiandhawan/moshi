   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.54,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "Okay Moshi, is it sad to go to the cinema alone?",
   "est_sec": 3.51,
   "gap_before": 0.5,
   "block": "movies.dlg28",
   "kind": "moshi_name",
   "name_pos": "start",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not at all. Lots of people love it. You pick the film, the seat and the snacks, and no one talks over the good bits.",
   "est_sec": 7.85,
   "gap_before": 0.72,
   "role": "reply",
   "block": "movies.dlg28"
  },
  {
   "speaker": "user",
   "text": "I just feel like everyone will stare.",
   "est_sec": 2.27,
   "gap_before": 0.67,
   "block": "movies.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Honestly, once the lights go down, nobody's looking at anyone. And plenty of solo viewers go to weekday showings.",
   "est_sec": 5.99,
   "gap_before": 0.44,
   "role": "reply",
   "block": "movies.dlg28"
  },
  {
   "speaker": "user",
   "text": "Wait, are you sure about that?",
   "est_sec": 1.96,
   "gap_before": 0.78,
   "block": "movies.dlg28",
   "kind": "wait_like",
   "phrasing": "waitlike_08",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Hmm, I believe it is. Which part doesn't sound right?",
   "est_sec": 3.2,
   "gap_before": 0.99,
   "role": "reply",
   "block": "movies.dlg28"
  },
  {
   "speaker": "user",
   "text": "Weekday afternoon could",
   "est_sec": 1.03,
   "gap_before": 1.57,
   "event": "distractor",
   "kind": "pause",
   "block": "movies.dlg28"
  },
  {
   "speaker": "user",
   "text": "be a good first try.",
   "est_sec": 1.65,
   "gap_before": 2.94,
   "block": "movies.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Perfect. Quieter, cheaper, and you'll probably get the best seat in the room.",
   "est_sec": 4.13,
   "gap_before": 1.46,
   "role": "reply",
   "block": "movies.dlg28"
  },
  {
   "speaker": "user",
   "text": "Any other tips?",
   "est_sec": 1.03,
   "gap_before": 3.27,
   "block": "movies.dlg28",
   "event": "ordinary_request"
  },
