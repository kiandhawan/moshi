 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.71,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.7,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "Why does my coffee taste different at my parents' house? Same beans, same press.",
   "est_sec": 4.44,
   "gap_before": 0.42,
   "block": "coffee.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "The water is probably the difference. Hard water, with lots of minerals, can make coffee taste flat or chalky.",
   "est_sec": 5.99,
   "gap_before": 0.93,
   "role": "reply",
   "block": "coffee.dlg13"
  },
  {
   "speaker": "user",
   "text": "Their kettle is full of white crust.",
   "est_sec": 2.27,
   "gap_before": 0.86,
   "block": "coffee.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a sure sign of hard water. You could try filtered water there, or a bottle of still water, and compare.",
   "est_sec": 6.61,
   "gap_before": 0.96,
   "role": "reply",
   "block": "coffee.dlg13"
  },
  {
   "speaker": "user",
   "text": "Is soft water",
   "est_sec": 1.03,
   "gap_before": 1.1,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg13"
  },
  {
   "speaker": "user",
   "text": "always better then?",
   "est_sec": 1.03,
   "gap_before": 2.33,
   "block": "coffee.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not always. Water with almost no minerals can make coffee taste thin and sour. Something in the middle is ideal.",
   "est_sec": 6.3,
   "gap_before": 0.58,
   "role": "reply",
   "block": "coffee.dlg13"
  },
  {
   "speaker": "user",
   "text": "Huh. I never thought water mattered.",
   "est_sec": 1.96,
   "gap_before": 1.54,
   "block": "coffee.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's most of what's in your cup, so it matters a lot. Fresh cold water and a clean kettle make a real difference.",
   "est_sec": 7.23,
   "gap_before": 0.58,
   "role": "reply",
   "block": "coffee.dlg13"
  }
 ]
