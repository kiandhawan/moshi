 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.55,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.94,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "I travel for work every week. How do I keep fit in hotel rooms?",
   "est_sec": 4.44,
   "gap_before": 0.26,
   "block": "fitness.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Bodyweight circuits are perfect. Squats, push-ups, lunges, planks and burpees need no equipment at all.",
   "est_sec": 4.75,
   "gap_before": 1.2,
   "role": "reply",
   "block": "fitness.dlg16"
  },
  {
   "speaker": "user",
   "text": "Burpees. I hate burpees.",
   "est_sec": 1.34,
   "gap_before": 1.29,
   "block": "fitness.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Everybody does. You can swap them for fast mountain climbers.",
   "est_sec": 3.2,
   "gap_before": 0.53,
   "role": "reply",
   "block": "fitness.dlg16"
  },
  {
   "speaker": "user",
   "text": "How long should a circuit take?",
   "est_sec": 1.96,
   "gap_before": 0.41,
   "block": "fitness.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Twenty minutes is plenty. Do each exercise for forty seconds with twenty seconds rest, and repeat the round four times.",
   "est_sec": 6.3,
   "gap_before": 0.66,
   "role": "reply",
   "block": "fitness.dlg16"
  },
  {
   "speaker": "user",
   "text": "That's quiet enough",
   "est_sec": 1.03,
   "gap_before": 2.35,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg16"
  },
  {
   "speaker": "user",
   "text": "for a thin wall hotel?",
   "est_sec": 1.65,
   "gap_before": 2.36,
   "block": "fitness.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Mostly, yes. Skip jumping moves late at night if you're worried about the neighbors.",
   "est_sec": 4.44,
   "gap_before": 0.52,
   "role": "reply",
   "block": "fitness.dlg16"
  },
  {
   "speaker": "user",
   "text": "Smart. Resistance bands too?",
   "est_sec": 1.34,
   "gap_before": 1.02,
   "block": "fitness.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, they weigh nothing and add a lot. Throw a pair in your suitcase.",
