 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.75,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.42,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "My daughter's gone vegetarian and wants me to cook tofu. Honestly I think it tastes like wet sponge.",
   "est_sec": 5.68,
   "gap_before": 0.4,
   "block": "cooking.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A lot of people feel that way until they try it crispy. The trick is getting the water out first.",
   "est_sec": 6.3,
   "gap_before": 1.06,
   "role": "reply",
   "block": "cooking.dlg9"
  },
  {
   "speaker": "user",
   "text": "How do I do that without a fancy press?",
   "est_sec": 2.89,
   "gap_before": 0.85,
   "block": "cooking.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Wrap the block in a tea towel and put a heavy pan on it for twenty minutes. Then cut it into cubes.",
   "est_sec": 6.92,
   "gap_before": 0.34,
   "role": "reply",
   "block": "cooking.dlg9"
  },
  {
   "speaker": "user",
   "text": "Then I just fry it?",
   "est_sec": 1.65,
   "gap_before": 1.3,
   "block": "cooking.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Toss the cubes in a little cornflour first. Fry them in hot oil until golden on all sides, then add your sauce right at the end.",
   "est_sec": 8.16,
   "gap_before": 0.51,
   "role": "reply",
   "block": "cooking.dlg9"
  },
  {
   "speaker": "user",
   "text": "What sauce, though? She likes",
   "est_sec": 1.65,
   "gap_before": 1.32,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg9"
  },
  {
   "speaker": "user",
   "text": "um, sweet things mostly.",
   "est_sec": 1.34,
   "gap_before": 2.85,
   "block": "cooking.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Try soy sauce, honey, garlic and a splash of rice vinegar. Let it bubble until it's sticky.",
   "est_sec": 5.37,
   "gap_before": 1.06,
   "role": "reply",
   "block": "cooking.dlg9"
  },
  {
   "speaker": "user",
   "text": "Alright. If I hate it, I'm blaming you.",
   "est_sec": 2.58,
   "gap_before": 0.32,
   "block": "cooking.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Deal. But I think you'll be surprised.",
   "est_sec": 2.27,
   "gap_before": 0.93,
   "role": "reply",
   "block": "cooking.dlg9"
  }
 ]
}
