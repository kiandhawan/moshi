 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.33,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.93,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "I'm seventeen, going for a Christmas job at a toy shop. What will they ask?",
   "est_sec": 4.75,
   "gap_before": 0.53,
   "block": "job_interview.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Probably simple things. When you're free, why you want to work there, and how you'd handle a busy shop.",
   "est_sec": 5.99,
   "gap_before": 0.79,
   "role": "reply",
   "block": "job_interview.dlg19"
  },
  {
   "speaker": "user",
   "text": "What do I say for why I want to work there? Money?",
   "est_sec": 3.82,
   "gap_before": 1.41,
   "block": "job_interview.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Money's honest, but add something else. Maybe that you like helping people or that you know lots about games and toys.",
   "est_sec": 6.61,
   "gap_before": 1.1,
   "role": "reply",
   "block": "job_interview.dlg19"
  },
  {
   "speaker": "user",
   "text": "I do know a lot about board games.",
   "est_sec": 2.58,
   "gap_before": 0.94,
   "block": "job_interview.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Perfect, mention that. Shops love staff who can actually recommend things.",
   "est_sec": 3.51,
   "gap_before": 0.69,
   "role": "reply",
   "block": "job_interview.dlg19"
  },
  {
   "speaker": "user",
   "text": "And if they ask about",
   "est_sec": 1.65,
   "gap_before": 1.46,
   "event": "distractor",
   "kind": "pause",
   "block": "job_interview.dlg19"
  },
  {
   "speaker": "user",
   "text": "a time I worked in a team? I've never had a job.",
   "est_sec": 3.82,
   "gap_before": 2.64,
   "block": "job_interview.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Use school or a club. A group project or a sports team counts. Just say what you did and how it turned out.",
   "est_sec": 7.23,
   "gap_before": 1.06,
   "role": "reply",
   "block": "job_interview.dlg19"
  }
 ]
