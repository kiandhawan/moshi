 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.74,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.42,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "Can I save seeds from my tomatoes for next year?",
   "est_sec": 3.2,
   "gap_before": 0.6,
   "block": "gardening.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can, as long as they're not hybrids. If the packet said hybrid, the new plants might not match the parent.",
   "est_sec": 6.61,
   "gap_before": 0.36,
   "role": "reply",
   "block": "gardening.dlg30"
  },
  {
   "speaker": "user",
   "text": "Hold on, that's not right.",
   "est_sec": 1.65,
   "gap_before": 1.35,
   "block": "gardening.dlg30",
   "kind": "wait_like",
   "phrasing": "waitlike_07",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Let me double-check. I'd still stand by it, but tell me what you heard.",
   "est_sec": 4.44,
   "gap_before": 1.1,
   "role": "reply",
   "block": "gardening.dlg30"
  },
  {
   "speaker": "user",
   "text": "These are old heirloom ones from my uncle.",
   "est_sec": 2.58,
   "gap_before": 1.39,
   "block": "gardening.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Perfect, those come true from seed. Pick a really ripe tomato and scoop the seeds into a jar with a little water.",
   "est_sec": 6.92,
   "gap_before": 1.8,
   "role": "reply",
   "block": "gardening.dlg30"
  },
  {
   "speaker": "user",
   "text": "And then?",
   "est_sec": 0.72,
   "gap_before": 0.7,
   "block": "gardening.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Leave it a few days until it gets a bit mouldy on top. That ferments away the jelly coating. Then rinse and dry the seeds on a plate.",
   "est_sec": 8.78,
   "gap_before": 0.83,
   "role": "reply",
   "block": "gardening.dlg30"
  },
  {
   "speaker": "user",
   "text": "Mouldy on purpose. That's",
   "est_sec": 1.34,
   "gap_before": 1.2,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg30"
  },
  {
   "speaker": "user",
   "text": "disgusting and brilliant.",
   "est_sec": 1.03,
   "gap_before": 2.47,
   "block": "gardening.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's the traditional way. Store them dry in a paper envelope, labelled, somewhere cool. They'll keep for years.",
   "est_sec": 5.68,
   "gap_before": 0.98,
   "role": "reply",
   "block": "gardening.dlg30"
  }
 ]
}
