 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.38,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.5,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "How on earth do I move a big tropical fish tank?",
   "est_sec": 3.51,
   "gap_before": 0.55,
   "block": "moving_house.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Carefully. Start by putting the fish in bags or buckets with water from their own tank.",
   "est_sec": 5.06,
   "gap_before": 0.36,
   "role": "reply",
   "block": "moving_house.dlg23"
  },
  {
   "speaker": "user",
   "text": "How long can they stay in there?",
   "est_sec": 2.27,
   "gap_before": 1.41,
   "block": "moving_house.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A few hours is usually fine if they're kept warm and dark. Bring a battery air pump for longer trips.",
   "est_sec": 6.3,
   "gap_before": 0.56,
   "role": "reply",
   "block": "moving_house.dlg23"
  },
  {
   "speaker": "user",
   "text": "And the tank?",
   "est_sec": 1.03,
   "gap_before": 0.56,
   "block": "moving_house.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Empty it completely before moving. Even a small amount of water makes it heavy and can crack the glass.",
   "est_sec": 5.99,
   "gap_before": 0.56,
   "role": "reply",
   "block": "moving_house.dlg23"
  },
  {
   "speaker": "user",
   "text": "What about the filter? I'd",
   "est_sec": 1.65,
   "gap_before": 3.41,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg23"
  },
  {
   "speaker": "user",
   "text": "rather not start from scratch.",
   "est_sec": 1.65,
   "gap_before": 2.9,
   "block": "moving_house.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Keep the filter wet in tank water so the good bacteria survive. That way the tank settles much faster in the new place.",
   "est_sec": 7.23,
   "gap_before": 0.47,
   "role": "reply",
   "block": "moving_house.dlg23"
  }
 ]
}
