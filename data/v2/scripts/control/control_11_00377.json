 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.75,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.59,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "We just got a border collie. How much exercise does she actually need?",
   "est_sec": 4.13,
   "gap_before": 0.51,
   "block": "pets.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A lot. Most collies want a couple of hours of activity a day, and just as importantly, things for their brain to do.",
   "est_sec": 7.23,
   "gap_before": 0.63,
   "role": "reply",
   "block": "pets.dlg7"
  },
  {
   "speaker": "user",
   "text": "Two hours? We both work.",
   "est_sec": 1.65,
   "gap_before": 1.11,
   "block": "pets.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It doesn't all have to be walking. Training games, sniffing hunts and puzzle toys tire them out surprisingly well.",
   "est_sec": 5.99,
   "gap_before": 1.16,
   "role": "reply",
   "block": "pets.dlg7"
  },
  {
   "speaker": "user",
   "text": "I'm making a shopping list, so Joshua, do we need loo roll?",
   "est_sec": 3.82,
   "gap_before": 0.72,
   "block": "nq_home_037",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_037",
   "name_pos": "middle",
   "addressee": "Joshua"
  },
  {
   "speaker": "other",
   "text": "Yes, we're on the last one.",
   "est_sec": 1.96,
   "gap_before": 0.79,
   "block": "nq_home_037"
  },
  {
   "speaker": "user",
   "text": "What happens if she doesn't get enough?",
   "est_sec": 2.27,
   "gap_before": 1.09,
   "block": "pets.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Bored collies tend to invent their own jobs, like herding the kids, chewing furniture, or barking at everything.",
   "est_sec": 5.68,
   "gap_before": 0.77,
   "role": "reply",
   "block": "pets.dlg7"
  },
  {
   "speaker": "user",
   "text": "She already herds my son.",
   "est_sec": 1.65,
   "gap_before": 2.0,
   "event": "distractor",
   "kind": "pause",
   "block": "pets.dlg7"
  },
  {
   "speaker": "user",
   "text": "He thinks it's hilarious.",
   "est_sec": 1.34,
   "gap_before": 2.77,
   "block": "pets.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's sweet now, but nipping at heels can grow into a habit. Give her a proper outlet, like fetch or a beginner agility class.",
   "est_sec": 7.54,
   "gap_before": 0.54,
   "role": "reply",
   "block": "pets.dlg7"
  }
 ]
