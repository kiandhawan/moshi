 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.84,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "There's a local tournament for a fighting game I love. Moshi, I want to enter but I'm scared I'll get destroyed.",
   "est_sec": 6.61,
   "gap_before": 0.56,
   "block": "video_games.dlg14",
   "kind": "moshi_name",
   "name_pos": "middle",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's how almost everyone feels before their first one. Local events are usually very welcoming to newcomers.",
   "est_sec": 5.37,
   "gap_before": 0.51,
   "role": "reply",
   "block": "video_games.dlg14"
  },
  {
   "speaker": "user",
   "text": "What if I lose in the first round?",
   "est_sec": 2.58,
   "gap_before": 1.97,
   "block": "video_games.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You might, and that's okay. Most tournaments use double elimination, so you get at least two matches. And people often play casual games all day.",
   "est_sec": 7.85,
   "gap_before": 0.92,
   "role": "reply",
   "block": "video_games.dlg14"
  },
  {
   "speaker": "user",
   "text": "Should I practise anything",
   "est_sec": 1.34,
   "gap_before": 1.47,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg14"
  },
  {
   "speaker": "user",
   "text": "specific before?",
   "est_sec": 0.72,
   "gap_before": 2.45,
   "block": "video_games.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Pick one character and learn a few reliable moves really well, rather than a bit of everything. Practise blocking too, beginners forget to defend.",
   "est_sec": 7.54,
   "gap_before": 0.42,
   "role": "reply",
   "block": "video_games.dlg14"
  },
  {
   "speaker": "user",
   "text": "And etiquette?",
   "est_sec": 0.72,
   "gap_before": 0.34,
   "block": "video_games.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Shake hands or say good games after a match, bring your own controller if you can, and ask people for tips. Players love talking shop.",
   "est_sec": 7.85,
   "gap_before": 1.19,
   "role": "reply",
   "block": "video_games.dlg14"
  },
  {
   "speaker": "user",
   "text": "Wait a second, okay. I'm signing up tonight.",
   "est_sec": 2.58,
   "gap_before": 1.09,
   "block": "video_games.dlg14",
   "kind": "wait_like",
   "phrasing": "waitlike_16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Brilliant. Have fun, and go in to learn, not to win.",
   "est_sec": 3.51,
   "gap_before": 1.05,
   "role": "reply",
   "block": "video_games.dlg14"
  }
 ]
