 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.73,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.54,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "I'm going to my first big outdoor festival. What should I bring?",
   "est_sec": 3.82,
   "gap_before": 0.29,
   "block": "music.dlg3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Earplugs, a refillable water bottle, sunscreen and a portable phone charger. And comfortable shoes you don't mind getting dirty.",
   "est_sec": 5.99,
   "gap_before": 0.56,
   "role": "reply",
   "block": "music.dlg3"
  },
  {
   "speaker": "user",
   "text": "Earplugs? Won't that ruin the music?",
   "est_sec": 1.96,
   "gap_before": 1.15,
   "block": "music.dlg3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good musician earplugs just lower the volume evenly. Everything sounds clear, and your ears won't ring the next day.",
   "est_sec": 5.99,
   "gap_before": 0.48,
   "role": "reply",
   "block": "music.dlg3"
  },
  {
   "speaker": "user",
   "text": "I was going to bring a big backpack but",
   "est_sec": 2.89,
   "gap_before": 0.68,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg3"
  },
  {
   "speaker": "user",
   "text": "maybe that's too much.",
   "est_sec": 1.34,
   "gap_before": 1.66,
   "block": "music.dlg3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A small bag is better. Big ones get heavy and many festivals have size limits at the gate.",
   "est_sec": 5.68,
   "gap_before": 0.43,
   "role": "reply",
   "block": "music.dlg3"
  },
  {
   "speaker": "user",
   "text": "And how do we not lose each other in the crowd?",
   "est_sec": 3.51,
   "gap_before": 0.36,
   "block": "music.dlg3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Pick a fixed meeting spot early on, like a sign or a food stand. Phones often don't work well in big crowds.",
   "est_sec": 6.92,
   "gap_before": 1.12,
   "role": "reply",
   "block": "music.dlg3"
  }
 ]
