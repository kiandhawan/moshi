 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.61,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.48,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "Someone's selling a fridge freezer online for cheap. What should I check before I hand over money?",
   "est_sec": 5.37,
   "gap_before": 0.25,
   "block": "shopping.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ask to see it running. It should be cold inside and the freezer should be properly frozen, not just cool.",
   "est_sec": 6.3,
   "gap_before": 0.65,
   "role": "reply",
   "block": "shopping.dlg18"
  },
  {
   "speaker": "user",
   "text": "My grandson set up Moshi so I could hear audiobooks.",
   "est_sec": 3.2,
   "gap_before": 1.64,
   "block": "mm_096",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_096",
   "name_pos": "none"
  },
  {
   "speaker": "user",
   "text": "Anything else?",
   "est_sec": 0.72,
   "gap_before": 1.97,
   "block": "shopping.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Look at the door seals. Close the door on a piece of paper, if it slides out easily, the seal is worn.",
   "est_sec": 6.92,
   "gap_before": 1.49,
   "role": "reply",
   "block": "shopping.dlg18"
  },
  {
   "speaker": "user",
   "text": "Ooh, that's a good trick.",
   "est_sec": 1.65,
   "gap_before": 0.93,
   "block": "shopping.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Also check for rust at the bottom, smells, and a loud buzzing or rattling. Ask how old it is.",
   "est_sec": 5.99,
   "gap_before": 0.52,
   "role": "reply",
   "block": "shopping.dlg18"
  },
  {
   "speaker": "user",
   "text": "They said around six years, I think.",
   "est_sec": 2.27,
   "gap_before": 0.77,
   "event": "distractor",
   "kind": "pause",
   "block": "shopping.dlg18"
  },
  {
   "speaker": "user",
   "text": "Or seven.",
   "est_sec": 0.72,
   "gap_before": 2.73,
   "block": "shopping.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's fine for a fridge, many last over a decade. Just remember it should stand upright for a few hours after moving before you switch it on.",
   "est_sec": 8.47,
   "gap_before": 0.92,
   "role": "reply",
   "block": "shopping.dlg18"
  }
 ]
