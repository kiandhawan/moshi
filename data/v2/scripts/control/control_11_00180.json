 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.64,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.79,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "Can I swap regular flour for whole wheat in my muffin recipe?",
   "est_sec": 3.82,
   "gap_before": 0.59,
   "block": "baking.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can, but start by swapping only half. Whole wheat makes muffins denser and a little drier.",
   "est_sec": 5.37,
   "gap_before": 0.82,
   "role": "reply",
   "block": "baking.dlg2"
  },
  {
   "speaker": "user",
   "text": "Should I add more liquid then?",
   "est_sec": 1.96,
   "gap_before": 2.73,
   "block": "baking.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, a couple of extra spoonfuls of milk helps. Letting the batter rest ten minutes also softens the bran.",
   "est_sec": 5.99,
   "gap_before": 0.88,
   "role": "reply",
   "block": "baking.dlg2"
  },
  {
   "speaker": "user",
   "text": "Sophie, Moshi found a cheaper hotel two streets over.",
   "est_sec": 2.89,
   "gap_before": 0.97,
   "block": "mm_066",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_066",
   "name_pos": "start",
   "addressee": "Sophie"
  },
  {
   "speaker": "other",
   "text": "Book it before it's gone.",
   "est_sec": 1.65,
   "gap_before": 0.83,
   "block": "mm_066"
  },
  {
   "speaker": "user",
   "text": "And if I want to cut",
   "est_sec": 1.96,
   "gap_before": 0.94,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg2"
  },
  {
   "speaker": "user",
   "text": "some of the sugar too?",
   "est_sec": 1.65,
   "gap_before": 1.65,
   "block": "baking.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can cut about a quarter without problems. Mashed banana or a bit of applesauce adds sweetness back.",
   "est_sec": 5.68,
   "gap_before": 0.33,
   "role": "reply",
   "block": "baking.dlg2"
  },
  {
   "speaker": "user",
   "text": "Banana sounds good. I have some brown ones.",
   "est_sec": 2.58,
   "gap_before": 1.09,
   "block": "baking.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Perfect, the browner the better for baking.",
   "est_sec": 2.27,
   "gap_before": 1.09,
   "role": "reply",
   "block": "baking.dlg2"
  }
 ]
