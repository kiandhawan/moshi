 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.36,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.72,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "Is it possible to roast coffee beans at home? I keep seeing green beans for sale.",
   "est_sec": 5.06,
   "gap_before": 0.49,
   "block": "coffee.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It is, and it's a fun hobby. You can start with a heavy pan on the stove or a cheap popcorn popper.",
   "est_sec": 6.92,
   "gap_before": 0.73,
   "role": "reply",
   "block": "coffee.dlg30"
  },
  {
   "speaker": "user",
   "text": "Our nephew, Ji-woo, asked Moshi for a dinosaur fact every five minutes.",
   "est_sec": 3.82,
   "gap_before": 0.95,
   "block": "mm_128",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_128",
   "name_pos": "middle",
   "addressee": "Ji-woo"
  },
  {
   "speaker": "other",
   "text": "Did it run out?",
   "est_sec": 1.34,
   "gap_before": 0.67,
   "block": "mm_128"
  },
  {
   "speaker": "user",
   "text": "A popcorn popper? Really?",
   "est_sec": 1.34,
   "gap_before": 1.75,
   "block": "coffee.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Really. The hot air keeps the beans moving so they roast evenly. Just do it outside or near an open window, there's a lot of smoke and chaff.",
   "est_sec": 8.78,
   "gap_before": 0.47,
   "role": "reply",
   "block": "coffee.dlg30"
  },
  {
   "speaker": "user",
   "text": "How do I know",
   "est_sec": 1.34,
   "gap_before": 0.75,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg30"
  },
  {
   "speaker": "user",
   "text": "when they're done?",
   "est_sec": 1.03,
   "gap_before": 2.84,
   "block": "coffee.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Listen for the first crack, a popping sound like popcorn. Stopping shortly after gives a light roast, and keeping going towards a second crack gets darker.",
   "est_sec": 8.16,
   "gap_before": 1.16,
   "role": "reply",
   "block": "coffee.dlg30"
  },
  {
   "speaker": "user",
   "text": "Hang on, I missed that.",
   "est_sec": 1.65,
   "gap_before": 1.24,
   "block": "coffee.dlg30",
   "kind": "wait_like",
   "phrasing": "waitlike_04",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "No problem. Listen for the first crack, a popping sound like popcorn. Stopping shortly after gives a light roast, and keeping going towards a second crack gets darker.",
   "est_sec": 8.78,
   "gap_before": 0.8,
   "role": "reply",
   "block": "coffee.dlg30"
  },
  {
   "speaker": "user",
   "text": "Can I drink them straight away?",
   "est_sec": 1.96,
   "gap_before": 0.39,
   "block": "coffee.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's best to let them rest for a day or two. Fresh roasted beans release a lot of gas, and the flavour settles after a short rest.",
   "est_sec": 8.47,
   "gap_before": 0.33,
   "role": "reply",
   "block": "coffee.dlg30"
  }
 ]
