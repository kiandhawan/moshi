 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.64,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "My best friend is in hospital over her birthday. Can we still celebrate somehow?",
   "est_sec": 4.44,
   "gap_before": 0.48,
   "block": "birthday_party.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, in a gentle way. Do you know what the ward allows for visitors?",
   "est_sec": 4.44,
   "gap_before": 0.76,
   "role": "reply",
   "block": "birthday_party.dlg32"
  },
  {
   "speaker": "user",
   "text": "Two at a time, and no flowers, Moshi.",
   "est_sec": 2.58,
   "gap_before": 0.99,
   "block": "birthday_party.dlg32",
   "kind": "moshi_name",
   "name_pos": "end",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then bring things that don't take space. A card signed by lots of people, some photos, maybe a small cake to share with the nurses if she's allowed.",
   "est_sec": 8.78,
   "gap_before": 1.13,
   "role": "reply",
   "block": "birthday_party.dlg32"
  },
  {
   "speaker": "user",
   "text": "She'd love that. She's always feeding people.",
   "est_sec": 2.27,
   "gap_before": 0.55,
   "block": "birthday_party.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You could also ask friends to send short video messages and play them together on your phone.",
   "est_sec": 5.37,
   "gap_before": 0.57,
   "role": "reply",
   "block": "birthday_party.dlg32"
  },
  {
   "speaker": "user",
   "text": "Okay. I might cry more than her though.",
   "est_sec": 2.58,
   "gap_before": 1.37,
   "block": "birthday_party.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's okay. Just being there, on her day, will mean the most.",
   "est_sec": 3.82,
   "gap_before": 1.0,
   "role": "reply",
   "block": "birthday_party.dlg32"
  }
 ]
}
