 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.79,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.43,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "I'm in a hotel room with just a kettle and some sad instant sachets. Any way to make decent coffee?",
   "est_sec": 6.3,
   "gap_before": 0.39,
   "block": "coffee.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A little creativity helps. If you have ground coffee, you can make cowboy style coffee in a mug.",
   "est_sec": 5.68,
   "gap_before": 0.5,
   "role": "reply",
   "block": "coffee.dlg7"
  },
  {
   "speaker": "user",
   "text": "My sister swears Moshi helped her pass her driving theory test.",
   "est_sec": 3.51,
   "gap_before": 3.37,
   "block": "mm_008",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_008",
   "name_pos": "none"
  },
  {
   "speaker": "other",
   "text": "Your sister swears by everything.",
   "est_sec": 1.65,
   "gap_before": 0.78,
   "block": "mm_008"
  },
  {
   "speaker": "user",
   "text": "I could grab some ground coffee from the shop downstairs. How does that work?",
   "est_sec": 4.44,
   "gap_before": 1.37,
   "block": "coffee.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Put a spoonful or two in a mug, pour hot water just off the boil, stir, and wait about four minutes. Then let the grounds sink to the bottom.",
   "est_sec": 9.09,
   "gap_before": 0.87,
   "role": "reply",
   "block": "coffee.dlg7"
  },
  {
   "speaker": "user",
   "text": "Won't I drink",
   "est_sec": 1.03,
   "gap_before": 0.84,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg7"
  },
  {
   "speaker": "user",
   "text": "a mouthful of grit?",
   "est_sec": 1.34,
   "gap_before": 2.28,
   "block": "coffee.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A tiny bit, maybe. A splash of cold water on top helps the grounds settle. Pour slowly into a second cup if you have one.",
   "est_sec": 7.85,
   "gap_before": 0.94,
   "role": "reply",
   "block": "coffee.dlg7"
  },
  {
   "speaker": "user",
   "text": "Genius. Better than the sachets anyway.",
   "est_sec": 1.96,
   "gap_before": 3.06,
   "block": "coffee.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Much better. Some shops also sell single serve drip bags that hang on the mug, perfect for travelling.",
   "est_sec": 5.68,
   "gap_before": 0.67,
   "role": "reply",
   "block": "coffee.dlg7"
  }
 ]
