 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.33,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.36,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "How did I get sunburned on a cloudy, windy hike?",
   "est_sec": 3.2,
   "gap_before": 0.23,
   "block": "hiking.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Clouds don't block much UV, and wind cools your skin so you don't feel yourself burning.",
   "est_sec": 5.06,
   "gap_before": 0.49,
   "role": "reply",
   "block": "hiking.dlg28"
  },
  {
   "speaker": "user",
   "text": "That's sneaky.",
   "est_sec": 0.72,
   "gap_before": 0.82,
   "block": "hiking.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It really is. Higher up, the sun is also stronger than at sea level.",
   "est_sec": 4.44,
   "gap_before": 0.63,
   "role": "reply",
   "block": "hiking.dlg28"
  },
  {
   "speaker": "user",
   "text": "So sunscreen even in April.",
   "est_sec": 1.65,
   "gap_before": 1.34,
   "block": "hiking.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, and reapply it after a couple of hours or if you sweat a lot. Don't forget your ears and the back of your neck.",
   "est_sec": 7.85,
   "gap_before": 0.62,
   "role": "reply",
   "block": "hiking.dlg28"
  },
  {
   "speaker": "user",
   "text": "My ears are peeling right now. It's",
   "est_sec": 2.27,
   "gap_before": 1.16,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg28"
  },
  {
   "speaker": "user",
   "text": "honestly so embarrassing.",
   "est_sec": 1.03,
   "gap_before": 2.01,
   "block": "hiking.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A cap with a neck flap or a buff sorts that out next time. Until then, aloe gel will help.",
   "est_sec": 6.3,
   "gap_before": 1.61,
   "role": "reply",
   "block": "hiking.dlg28"
  }
