 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.42,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 1.0,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I have a huge bag of used coffee grounds every week. Seems a shame to bin them.",
   "est_sec": 5.37,
   "gap_before": 0.5,
   "block": "coffee.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You're right, they're surprisingly useful. Many people add them to compost, they break down nicely.",
   "est_sec": 4.75,
   "gap_before": 0.96,
   "role": "reply",
   "block": "coffee.dlg27"
  },
  {
   "speaker": "user",
   "text": "I've heard you can put them",
   "est_sec": 1.96,
   "gap_before": 0.32,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg27"
  },
  {
   "speaker": "user",
   "text": "straight on plants.",
   "est_sec": 1.03,
   "gap_before": 1.52,
   "block": "coffee.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "In small amounts, mixed into the soil. Too much in a thick layer can form a crust that keeps water out, so sprinkle lightly.",
   "est_sec": 7.54,
   "gap_before": 0.88,
   "role": "reply",
   "block": "coffee.dlg27"
  },
  {
   "speaker": "user",
   "text": "Anything else?",
   "est_sec": 0.72,
   "gap_before": 0.48,
   "block": "coffee.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Dried grounds in a bowl in the fridge can absorb smells. Some people use them as a gentle scrub for pots, or even for hands after chopping garlic.",
   "est_sec": 8.78,
   "gap_before": 0.6,
   "role": "reply",
   "block": "coffee.dlg27"
  },
  {
   "speaker": "user",
   "text": "Coffee hands instead of garlic hands. Sold.",
   "est_sec": 2.27,
   "gap_before": 1.56,
   "block": "coffee.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Fair trade. Just let them dry out first if you store them, damp grounds go mouldy quickly.",
   "est_sec": 5.37,
   "gap_before": 1.02,
   "role": "reply",
   "block": "coffee.dlg27"
  }
 ]
}
