 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.88,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "My trumpet smells weird. How often am I meant to clean it?",
   "est_sec": 3.82,
   "gap_before": 0.39,
   "block": "music.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ideally a quick rinse every couple of weeks and a proper bath once a month or so. A smell usually means it's overdue.",
   "est_sec": 7.23,
   "gap_before": 0.83,
   "role": "reply",
   "block": "music.dlg23"
  },
  {
   "speaker": "user",
   "text": "Overdue is putting it mildly.",
   "est_sec": 1.65,
   "gap_before": 0.32,
   "block": "music.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then give it a full bath. Lukewarm water with a bit of washing up liquid, and take the valves and slides out first.",
   "est_sec": 7.23,
   "gap_before": 0.46,
   "role": "reply",
   "block": "music.dlg23"
  },
  {
   "speaker": "user",
   "text": "For me, Moshi is mostly timers and the news, Chiara.",
   "est_sec": 3.2,
   "gap_before": 0.82,
   "block": "mm_095",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_095",
   "name_pos": "end",
   "addressee": "Chiara"
  },
  {
   "speaker": "other",
   "text": "Same here, honestly.",
   "est_sec": 1.03,
   "gap_before": 0.7,
   "block": "mm_095"
  },
  {
   "speaker": "user",
   "text": "Won't hot water",
   "est_sec": 1.03,
   "gap_before": 1.03,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg23"
  },
  {
   "speaker": "user",
   "text": "ruin the finish?",
   "est_sec": 1.03,
   "gap_before": 2.56,
   "block": "music.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Hot water can damage the lacquer, so stick with lukewarm. Use a snake brush through the tubes and a soft cloth on the outside.",
   "est_sec": 7.54,
   "gap_before": 1.11,
   "role": "reply",
   "block": "music.dlg23"
  },
  {
   "speaker": "user",
   "text": "Hold on, can you say that again?",
   "est_sec": 2.27,
   "gap_before": 1.43,
   "block": "music.dlg23",
   "kind": "wait_like",
   "phrasing": "waitlike_02",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sure. Hot water can damage the lacquer, so stick with lukewarm. Use a snake brush through the tubes and a soft cloth on the outside.",
   "est_sec": 7.85,
   "gap_before": 0.73,
   "role": "reply",
   "block": "music.dlg23"
  },
  {
   "speaker": "user",
   "text": "And the valves?",
   "est_sec": 1.03,
   "gap_before": 0.59,
   "block": "music.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Rinse them, dry them, add a few drops of valve oil, and put each one back in its own slot. They're numbered for a reason.",
   "est_sec": 7.85,
   "gap_before": 1.17,
   "role": "reply",
   "block": "music.dlg23"
  }
 ]
