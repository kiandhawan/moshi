 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "Results day. I missed the grade I needed for my first choice uni.",
   "est_sec": 4.13,
   "gap_before": 0.58,
   "block": "studying.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "I'm sorry, that's a hard moment. Have you checked if they'll still accept you?",
   "est_sec": 4.44,
   "gap_before": 1.55,
   "role": "reply",
   "block": "studying.dlg32"
  },
  {
   "speaker": "user",
   "text": "Not yet. I'm too scared to look.",
   "est_sec": 2.27,
   "gap_before": 1.36,
   "block": "studying.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's worth checking right away. Sometimes universities accept people who miss by a little.",
   "est_sec": 4.44,
   "gap_before": 0.35,
   "role": "reply",
   "block": "studying.dlg32"
  },
  {
   "speaker": "user",
   "text": "And if they say no?",
   "est_sec": 1.65,
   "gap_before": 2.53,
   "block": "studying.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then there's your second choice, or clearing, where unis offer spaces that are still open. Lots of people find great courses that way.",
   "est_sec": 7.23,
   "gap_before": 0.49,
   "role": "reply",
   "block": "studying.dlg32"
  },
  {
   "speaker": "user",
   "text": "I just feel like",
   "est_sec": 1.34,
   "gap_before": 1.25,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg32"
  },
  {
   "speaker": "user",
   "text": "I've ruined everything.",
   "est_sec": 1.03,
   "gap_before": 2.17,
   "block": "studying.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You haven't. This feels huge today, but there are still lots of paths forward. Call the uni first, then we'll go from there.",
   "est_sec": 7.23,
   "gap_before": 0.87,
   "role": "reply",
   "block": "studying.dlg32"
  }
