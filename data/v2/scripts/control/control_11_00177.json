 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.32,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.84,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "I have six minutes to change trains tomorrow. Is that crazy?",
   "est_sec": 3.51,
   "gap_before": 0.22,
   "block": "public_transport.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Tight, but often fine if both trains are at the same station and on time. Is it one ticket for the whole trip?",
   "est_sec": 7.23,
   "gap_before": 1.01,
   "role": "reply",
   "block": "public_transport.dlg18"
  },
  {
   "speaker": "user",
   "text": "Did you move my charger off the desk, Mei?",
   "est_sec": 2.89,
   "gap_before": 0.74,
   "block": "nq_work_013",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_work_013",
   "name_pos": "end",
   "addressee": "Mei"
  },
  {
   "speaker": "user",
   "text": "Yeah, one booking.",
   "est_sec": 1.03,
   "gap_before": 3.31,
   "block": "public_transport.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then if you miss the connection because of a delay, you're usually allowed on the next train without paying again.",
   "est_sec": 6.3,
   "gap_before": 0.92,
   "role": "reply",
   "block": "public_transport.dlg18"
  },
  {
   "speaker": "user",
   "text": "Oh good. How can I make the change faster?",
   "est_sec": 2.89,
   "gap_before": 0.99,
   "block": "public_transport.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Look up the platform numbers in advance, and sit near the doors in the carriage closest to the exit.",
   "est_sec": 5.99,
   "gap_before": 1.87,
   "role": "reply",
   "block": "public_transport.dlg18"
  },
  {
   "speaker": "user",
   "text": "And if it's",
   "est_sec": 1.03,
   "gap_before": 1.1,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg18"
  },
  {
   "speaker": "user",
   "text": "like a huge station?",
   "est_sec": 1.34,
   "gap_before": 2.34,
   "block": "public_transport.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then study the station map tonight. Knowing which way to turn saves more time than running.",
   "est_sec": 5.06,
   "gap_before": 1.33,
   "role": "reply",
   "block": "public_transport.dlg18"
  }
 ]
