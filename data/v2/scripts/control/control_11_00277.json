 "est_total_sec": 62.84,
 "est_speech_sec": 48.94,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.35,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.8,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "Family reunion Sunday. Thirty people. Last time someone was blinking in every single group photo.",
   "est_sec": 4.75,
   "gap_before": 0.46,
   "block": "photography.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Thirty people means a blink in almost every frame, so the trick is taking lots. Use burst mode, or take at least ten in a row.",
   "est_sec": 8.16,
   "gap_before": 0.86,
   "role": "reply",
   "block": "photography.dlg21"
  },
  {
   "speaker": "user",
   "text": "Ten! They'll riot.",
   "est_sec": 1.03,
   "gap_before": 3.01,
   "block": "photography.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Tell them it's quick and keep talking while you shoot. Counting down to three and shooting on two catches people before they blink.",
   "est_sec": 7.23,
   "gap_before": 0.87,
   "role": "reply",
   "block": "photography.dlg21"
  },
  {
   "speaker": "user",
   "text": "Um, Christian, have you got a pen that actually works?",
   "est_sec": 3.2,
   "gap_before": 1.29,
   "block": "nq_work_070",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_work_070",
   "name_pos": "start",
   "addressee": "Christian"
  },
  {
   "speaker": "other",
   "text": "Here, take the green one.",
   "est_sec": 1.65,
   "gap_before": 0.61,
   "block": "nq_work_070"
  },
  {
   "speaker": "user",
   "text": "Sneaky. I like it.",
   "est_sec": 1.34,
   "gap_before": 1.8,
   "block": "photography.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Also arrange them in rows on steps if there are any. Tall people at the back, kids at the front, and make sure you can see every face.",
   "est_sec": 8.78,
   "gap_before": 0.86,
   "role": "reply",
   "block": "photography.dlg21"
  },
  {
   "speaker": "user",
   "text": "What about me? I'm always missing.",
   "est_sec": 1.96,
   "gap_before": 0.75,
   "block": "photography.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Use a timer and a tripod, or hand the camera to a neighbour for the last few. You belong in the family photo too.",
   "est_sec": 7.54,
   "gap_before": 0.74,
   "role": "reply",
   "block": "photography.dlg21"
  }
 ]
}
