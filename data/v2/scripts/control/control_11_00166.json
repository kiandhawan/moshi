   "gap_before": 0.67,
   "block": "movies.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Great level for it. Start with Spanish audio and Spanish subtitles, so you can see the words as you hear them.",
   "est_sec": 6.61,
   "gap_before": 1.01,
   "role": "reply",
   "block": "movies.dlg18"
  },
  {
