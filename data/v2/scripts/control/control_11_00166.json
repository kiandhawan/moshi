   "gap_before": 0.5,
   "block": "movies.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "English subtitles are fine for fun, but your brain will just read them. Spanish ones keep you learning.",
   "est_sec": 5.68,
   "gap_before": 0.82,
   "role": "reply",
   "block": "movies.dlg18"
  },
  {
   "speaker": "user",
   "text": "Any kind of film work best? I",
