 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.43,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.95,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "My baby's high chair is crusted with porridge. It sets like cement.",
   "est_sec": 3.82,
   "gap_before": 0.25,
   "block": "cleaning.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Porridge is the worst. Soak the tray in hot soapy water for ten minutes, it softens right up.",
   "est_sec": 5.68,
   "gap_before": 1.02,
   "role": "reply",
   "block": "cleaning.dlg30"
  },
  {
   "speaker": "user",
   "text": "The straps are gross too.",
   "est_sec": 1.65,
   "gap_before": 0.5,
   "block": "cleaning.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most straps unclip. Wash them in a mesh bag on a gentle cycle, or by hand in the sink.",
   "est_sec": 5.99,
   "gap_before": 1.28,
   "role": "reply",
   "block": "cleaning.dlg30"
  },
  {
   "speaker": "user",
   "text": "Are you working from home tomorrow, Anthony?",
   "est_sec": 2.27,
   "gap_before": 0.54,
   "block": "nq_work_059",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_work_059",
   "name_pos": "end",
   "addressee": "Anthony"
  },
  {
   "speaker": "other",
   "text": "Yes, and I'm not getting dressed.",
   "est_sec": 1.96,
   "gap_before": 0.95,
   "block": "nq_work_059"
  },
  {
   "speaker": "user",
   "text": "And the little gaps where food",
   "est_sec": 1.96,
   "gap_before": 0.89,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg30"
  },
  {
   "speaker": "user",
   "text": "gets stuck?",
   "est_sec": 0.72,
   "gap_before": 2.35,
   "block": "cleaning.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "An old toothbrush or a cotton bud gets into those. Then wipe everything with a damp cloth and let it dry fully.",
   "est_sec": 6.92,
   "gap_before": 0.87,
   "role": "reply",
   "block": "cleaning.dlg30"
  },
  {
   "speaker": "user",
   "text": "Thank you. She throws half her breakfast, so this'll happen daily.",
   "est_sec": 3.51,
   "gap_before": 0.75,
   "block": "cleaning.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then a quick wipe right after each meal saves you this whole job later.",
   "est_sec": 4.44,
   "gap_before": 0.51,
   "role": "reply",
   "block": "cleaning.dlg30"
  }
 ]
