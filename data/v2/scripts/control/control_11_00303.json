 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.79,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.69,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "Those escape room games in a box, can you play them more than once?",
   "est_sec": 4.44,
   "gap_before": 0.35,
   "block": "board_games.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most of them only once, sadly. You often cut, fold or write on the components, and once you know the puzzles, the surprise is gone.",
   "est_sec": 7.85,
   "gap_before": 1.09,
   "role": "reply",
   "block": "board_games.dlg25"
  },
  {
   "speaker": "user",
   "text": "That seems wasteful.",
   "est_sec": 1.03,
   "gap_before": 0.62,
   "block": "board_games.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Some are designed so you don't destroy anything, so you can pass them on to friends afterward. The box usually says so.",
   "est_sec": 6.92,
   "gap_before": 0.8,
   "role": "reply",
   "block": "board_games.dlg25"
  },
  {
   "speaker": "user",
   "text": "Can you read me the tracking number, Callum?",
   "est_sec": 2.58,
   "gap_before": 0.77,
   "block": "nq_work_002",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_work_002",
   "name_pos": "end",
   "addressee": "Callum"
  },
  {
   "speaker": "other",
   "text": "It starts with seven, nine, two.",
   "est_sec": 1.96,
   "gap_before": 0.58,
   "block": "nq_work_002"
  },
  {
   "speaker": "user",
   "text": "Oh, swapping with friends is a good idea.",
   "est_sec": 2.58,
   "gap_before": 1.46,
   "block": "board_games.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A lot of groups do that. You play one, they play another, then you swap.",
   "est_sec": 4.75,
   "gap_before": 0.6,
   "role": "reply",
   "block": "board_games.dlg25"
  },
  {
   "speaker": "user",
   "text": "How hard are they? I'm",
   "est_sec": 1.65,
   "gap_before": 1.01,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg25"
  },
  {
   "speaker": "user",
   "text": "not great with puzzles.",
   "est_sec": 1.34,
   "gap_before": 2.61,
   "block": "board_games.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "They have difficulty ratings on the box, and a hint system if you get stuck. Start with an easy one, it's more fun when you finish.",
   "est_sec": 8.16,
   "gap_before": 0.6,
   "role": "reply",
   "block": "board_games.dlg25"
  }
 ]
}
