 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.56,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.63,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "My cheesecake cracked right across the middle. Again. I'm starting to take it personally.",
   "est_sec": 4.44,
   "gap_before": 0.43,
   "block": "baking.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Don't, it happens to everyone. Cracks usually come from baking too hot or cooling too fast.",
   "est_sec": 5.06,
   "gap_before": 0.52,
   "role": "reply",
   "block": "baking.dlg19"
  },
  {
   "speaker": "user",
   "text": "I bake it at the temperature the recipe says.",
   "est_sec": 2.89,
   "gap_before": 1.28,
   "block": "baking.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Try a water bath. Wrap the tin in foil and set it in a tray of hot water, it keeps the heat gentle and moist.",
   "est_sec": 7.85,
   "gap_before": 0.64,
   "role": "reply",
   "block": "baking.dlg19"
  },
  {
   "speaker": "user",
   "text": "And the cooling part?",
   "est_sec": 1.34,
   "gap_before": 1.27,
   "block": "baking.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Turn the oven off when the centre still wobbles slightly, crack the door open, and leave the cheesecake inside for an hour.",
   "est_sec": 6.92,
   "gap_before": 0.61,
   "role": "reply",
   "block": "baking.dlg19"
  },
  {
   "speaker": "user",
   "text": "It's supposed to",
   "est_sec": 1.03,
   "gap_before": 1.29,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg19"
  },
  {
   "speaker": "user",
   "text": "still wobble? I always bake it until it's firm.",
   "est_sec": 2.89,
   "gap_before": 2.63,
   "block": "baking.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's probably the main issue. It sets as it cools. If it's firm in the oven, it's overbaked.",
   "est_sec": 5.68,
   "gap_before": 0.42,
   "role": "reply",
   "block": "baking.dlg19"
  }
 ]
