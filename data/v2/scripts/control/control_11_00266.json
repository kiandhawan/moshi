 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.65,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.36,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "I want to do something spontaneous this weekend. Like hop on a train somewhere.",
   "est_sec": 4.44,
   "gap_before": 0.34,
   "block": "weekend_plans.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Love that. Pick a direction, look at towns within two hours, and choose one you've never been to.",
   "est_sec": 5.68,
   "gap_before": 0.49,
   "role": "reply",
   "block": "weekend_plans.dlg30"
  },
  {
   "speaker": "user",
   "text": "Is it expensive on the day?",
   "est_sec": 1.96,
   "gap_before": 1.38,
   "block": "weekend_plans.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It can be. Off peak tickets are cheaper, so travel after the morning rush.",
   "est_sec": 4.44,
   "gap_before": 1.02,
   "role": "reply",
   "block": "weekend_plans.dlg30"
  },
  {
   "speaker": "user",
   "text": "Should I",
   "est_sec": 0.72,
   "gap_before": 1.39,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg30"
  },
  {
   "speaker": "user",
   "text": "book a place to stay?",
   "est_sec": 1.65,
   "gap_before": 2.54,
   "block": "weekend_plans.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "If you want to stay overnight, look in the morning. You'll often find last minute deals.",
   "est_sec": 5.06,
   "gap_before": 1.0,
   "role": "reply",
   "block": "weekend_plans.dlg30"
  },
  {
   "speaker": "user",
   "text": "And if the town's boring?",
   "est_sec": 1.65,
   "gap_before": 0.64,
   "block": "weekend_plans.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then walk, find a cafe, and get the next train somewhere else. That's half the adventure.",
   "est_sec": 5.06,
   "gap_before": 0.81,
   "role": "reply",
   "block": "weekend_plans.dlg30"
  }
 ]
}
