 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.33,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.9,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "My car insurance renewal came through and it's gone up loads. I haven't even claimed.",
   "est_sec": 4.75,
   "gap_before": 0.34,
   "block": "cars.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's frustrating, and sadly common. Renewal prices are often higher than what new customers get offered.",
   "est_sec": 5.06,
   "gap_before": 0.92,
   "role": "reply",
   "block": "cars.dlg9"
  },
  {
   "speaker": "user",
   "text": "So I should just switch?",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "block": "cars.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Get a few comparison quotes first. Then you can either switch, or call your current insurer and ask them to match it.",
   "est_sec": 6.92,
   "gap_before": 0.85,
   "role": "reply",
   "block": "cars.dlg9"
  },
  {
   "speaker": "user",
   "text": "I can't believe Moshi remembered our anniversary before you did, Paisley.",
   "est_sec": 3.51,
   "gap_before": 0.57,
   "block": "mm_061",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_061",
   "name_pos": "end",
   "addressee": "Paisley"
  },
  {
   "speaker": "other",
   "text": "I was getting to it.",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "block": "mm_061"
  },
  {
   "speaker": "user",
   "text": "Does that actually work?",
   "est_sec": 1.34,
   "gap_before": 1.18,
   "block": "cars.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Quite often, yes. Insurers would rather keep you than lose you. Be polite but clear that you have a cheaper offer.",
   "est_sec": 6.61,
   "gap_before": 0.42,
   "role": "reply",
   "block": "cars.dlg9"
  },
  {
   "speaker": "user",
   "text": "Anything else that brings it down?",
   "est_sec": 1.96,
   "gap_before": 1.24,
   "block": "cars.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A higher voluntary excess lowers the price, and so can paying annually instead of monthly. Just make sure the excess is an amount you could actually afford.",
   "est_sec": 8.47,
   "gap_before": 0.67,
   "role": "reply",
   "block": "cars.dlg9"
  },
  {
   "speaker": "user",
   "text": "Okay. Tonight I'm",
   "est_sec": 1.03,
   "gap_before": 1.9,
   "event": "distractor",
   "kind": "pause",
   "block": "cars.dlg9"
  },
  {
   "speaker": "user",
   "text": "doing the boring phone call.",
   "est_sec": 1.65,
   "gap_before": 2.73,
   "block": "cars.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good luck. Ten minutes of boredom could save you a decent chunk.",
   "est_sec": 3.82,
   "gap_before": 1.8,
   "role": "reply",
   "block": "cars.dlg9"
  }
 ]
