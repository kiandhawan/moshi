 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.77,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "My son's in reception and he's supposed to read with me every night. He hates it.",
   "est_sec": 5.06,
   "gap_before": 0.32,
   "block": "studying.dlg10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Lots of little ones push back. How long are the sessions now?",
   "est_sec": 3.82,
   "gap_before": 0.89,
   "role": "reply",
   "block": "studying.dlg10"
  },
  {
   "speaker": "user",
   "text": "About fifteen minutes, and it ends in a fight.",
   "est_sec": 2.89,
   "gap_before": 0.73,
   "block": "studying.dlg10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Try five minutes instead, and stop while he's still enjoying it. Short and happy builds the habit better.",
   "est_sec": 5.68,
   "gap_before": 0.42,
   "role": "reply",
   "block": "studying.dlg10"
  },
  {
   "speaker": "user",
   "text": "Will the teacher mind?",
   "est_sec": 1.34,
   "gap_before": 0.78,
   "block": "studying.dlg10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Teachers usually care much more about regular reading than long reading. A few calm minutes each night is great.",
   "est_sec": 5.99,
   "gap_before": 0.87,
   "role": "reply",
   "block": "studying.dlg10"
  },
  {
   "speaker": "user",
   "text": "He only wants",
   "est_sec": 1.03,
   "gap_before": 0.99,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg10"
  },
  {
   "speaker": "user",
   "text": "books about trucks.",
   "est_sec": 1.03,
   "gap_before": 2.22,
   "block": "studying.dlg10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then read about trucks. Any book that keeps him excited about reading is doing its job.",
   "est_sec": 5.06,
   "gap_before": 0.6,
