 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.36,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "I just watched a time travel film and I'm so confused. Is it me?",
   "est_sec": 4.44,
   "gap_before": 0.53,
   "block": "movies.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Probably not, time travel plots are designed to twist your brain. What part lost you?",
   "est_sec": 4.75,
   "gap_before": 0.54,
   "role": "reply",
   "block": "movies.dlg11"
  },
  {
   "speaker": "user",
   "text": "The part where the guy meets himself. Is he the old one or the new one?",
   "est_sec": 5.06,
   "gap_before": 1.27,
   "block": "movies.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "In a lot of these films, the version you've been following is the newer timeline, and the other one is from a loop that already happened.",
   "est_sec": 8.16,
   "gap_before": 1.15,
   "role": "reply",
   "block": "movies.dlg11"
  },
  {
   "speaker": "user",
   "text": "Okay, but then",
   "est_sec": 1.03,
   "gap_before": 1.37,
   "event": "distractor",
   "kind": "pause",
   "block": "movies.dlg11"
  },
  {
   "speaker": "user",
   "text": "who is actually telling the story?",
   "est_sec": 1.96,
   "gap_before": 1.63,
   "block": "movies.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Usually the version who loops the most. Try drawing a simple timeline on paper, with arrows for each jump. It suddenly clicks.",
   "est_sec": 6.92,
   "gap_before": 0.66,
   "role": "reply",
   "block": "movies.dlg11"
  },
  {
   "speaker": "user",
   "text": "That's very nerdy.",
   "est_sec": 1.03,
   "gap_before": 1.31,
   "block": "movies.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It is. But the people who love those films are doing exactly that, so you're in good company.",
   "est_sec": 5.68,
   "gap_before": 0.51,
   "role": "reply",
   "block": "movies.dlg11"
  }
 ]
