 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.56,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "My grandmother never threw anything away. She made stock from onion skins and chicken bones. How do I do that?",
   "est_sec": 6.3,
   "gap_before": 0.5,
   "block": "cooking.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Keep a bag in the freezer and add scraps as you go, like onion ends, carrot peels, celery tops and bones.",
   "est_sec": 6.61,
   "gap_before": 0.53,
   "role": "reply",
   "block": "cooking.dlg12"
  },
  {
   "speaker": "user",
   "text": "Is there anything I shouldn't put in?",
   "est_sec": 2.27,
   "gap_before": 1.37,
   "block": "cooking.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Skip cabbage and broccoli, they make it taste bitter. And potato peels make it cloudy.",
   "est_sec": 4.75,
   "gap_before": 0.63,
   "role": "reply",
   "block": "cooking.dlg12"
  },
  {
   "speaker": "user",
   "text": "Once the bag's full, then what?",
   "est_sec": 1.96,
   "gap_before": 1.5,
   "block": "cooking.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Tip it all into a big pot, cover with cold water and simmer gently for two to three hours. Don't let it boil hard.",
   "est_sec": 7.54,
   "gap_before": 0.72,
   "role": "reply",
   "block": "cooking.dlg12"
  },
  {
   "speaker": "user",
   "text": "Do I salt it?",
   "est_sec": 1.34,
   "gap_before": 0.52,
   "block": "cooking.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Leave it unsalted. Then you can season whatever you use it in later.",
   "est_sec": 4.13,
   "gap_before": 0.99,
   "role": "reply",
   "block": "cooking.dlg12"
  },
  {
   "speaker": "user",
   "text": "That's just like her. She'd be",
   "est_sec": 1.96,
   "gap_before": 0.8,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg12"
  },
  {
   "speaker": "user",
   "text": "pleased I'm finally doing it.",
   "est_sec": 1.65,
   "gap_before": 2.77,
   "block": "cooking.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "I'm sure she would. It's a lovely habit to carry on.",
   "est_sec": 3.51,
   "gap_before": 0.45,
   "role": "reply",
   "block": "cooking.dlg12"
  }
 ]
}
