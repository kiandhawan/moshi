   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "Can I use oil instead of butter in a cake? I've run out.",
   "est_sec": 4.13,
   "gap_before": 0.27,
   "block": "baking.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "In most cakes, yes. Use a bit less oil than the butter amount, roughly three quarters.",
   "est_sec": 5.06,
   "gap_before": 0.87,
   "role": "reply",
   "block": "baking.dlg30"
  },
  {
   "speaker": "user",
   "text": "Will it taste different?",
   "est_sec": 1.34,
   "gap_before": 1.09,
   "block": "baking.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You lose the buttery flavour, but oil cakes are often moister and stay soft for longer.",
   "est_sec": 5.06,
   "gap_before": 0.94,
   "role": "reply",
   "block": "baking.dlg30"
  },
  {
   "speaker": "user",
   "text": "It's a",
   "est_sec": 0.72,
   "gap_before": 0.35,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg30"
  },
  {
