 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.89,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "I'm taking the airport train with two massive suitcases. Any tips?",
   "est_sec": 3.51,
   "gap_before": 0.47,
   "block": "public_transport.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Board at the first carriage or the last one. They're usually quieter and closer to the luggage space.",
   "est_sec": 5.68,
   "gap_before": 1.13,
   "role": "reply",
   "block": "public_transport.dlg16"
  },
  {
   "speaker": "user",
   "text": "Moshi, what if the racks are full?",
   "est_sec": 2.27,
   "gap_before": 0.94,
   "block": "public_transport.dlg16",
   "kind": "moshi_name",
   "name_pos": "start",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Keep the cases beside you with the brakes on, out of the aisle. Most people understand on an airport line.",
   "est_sec": 6.3,
   "gap_before": 0.93,
   "role": "reply",
   "block": "public_transport.dlg16"
  },
  {
   "speaker": "user",
   "text": "Wait, what was the last part?",
   "est_sec": 1.96,
   "gap_before": 0.38,
   "block": "public_transport.dlg16",
   "kind": "wait_like",
   "phrasing": "waitlike_05",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "No problem. Keep the cases beside you with the brakes on, out of the aisle. Most people understand on an airport line.",
   "est_sec": 6.92,
   "gap_before": 1.15,
   "role": "reply",
   "block": "public_transport.dlg16"
  },
  {
   "speaker": "user",
   "text": "Do I need",
   "est_sec": 1.03,
   "gap_before": 1.28,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg16"
  },
  {
   "speaker": "user",
   "text": "to worry about the gap?",
   "est_sec": 1.65,
   "gap_before": 1.9,
   "block": "public_transport.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Lift the cases rather than rolling them over it. And let people off before you try to get on, it's much easier with space.",
   "est_sec": 7.54,
   "gap_before": 0.45,
   "role": "reply",
   "block": "public_transport.dlg16"
  },
  {
   "speaker": "user",
   "text": "Thanks, this is my first big trip alone.",
   "est_sec": 2.58,
   "gap_before": 0.78,
   "block": "public_transport.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You'll be fine. Have a wonderful time.",
   "est_sec": 2.27,
   "gap_before": 0.96,
   "role": "reply",
   "block": "public_transport.dlg16"
  }
 ]
