 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.51,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.93,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "So Moshi, how do I stop losing at that train game where you claim routes across the map?",
   "est_sec": 5.68,
   "gap_before": 0.55,
   "block": "board_games.dlg17",
   "kind": "moshi_name",
   "name_pos": "start",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Look at your destination tickets first and plan the route, then grab the most important connections before others do.",
   "est_sec": 5.99,
   "gap_before": 1.14,
   "role": "reply",
   "block": "board_games.dlg17"
  },
  {
   "speaker": "user",
   "text": "I always end up",
   "est_sec": 1.34,
   "gap_before": 1.02,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg17"
  },
  {
   "speaker": "user",
   "text": "stuck because someone takes the one route I need.",
   "est_sec": 2.89,
   "gap_before": 1.81,
   "block": "board_games.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's common. Claim the bottleneck routes early, the short ones between cities with only one path. Leave the long open routes for later.",
   "est_sec": 7.23,
   "gap_before": 1.02,
   "role": "reply",
   "block": "board_games.dlg17"
  },
  {
   "speaker": "user",
   "text": "Hold on a sec, and should I keep drawing tickets?",
   "est_sec": 3.2,
   "gap_before": 0.36,
   "block": "board_games.dlg17",
   "kind": "wait_like",
   "phrasing": "waitlike_17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Only if you can link them to routes you're already building. Unfinished tickets count against you at the end.",
   "est_sec": 5.99,
   "gap_before": 0.47,
   "role": "reply",
   "block": "board_games.dlg17"
  },
  {
   "speaker": "user",
   "text": "That's exactly how I lost last time.",
   "est_sec": 2.27,
   "gap_before": 0.41,
   "block": "board_games.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then you've already learned the hardest lesson. Next game, aim for fewer tickets and more long routes.",
   "est_sec": 5.37,
   "gap_before": 1.19,
   "role": "reply",
   "block": "board_games.dlg17"
  }
 ]
