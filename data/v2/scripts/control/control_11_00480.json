 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.3,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.39,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "I want to decorate for my girlfriend's birthday but I have no budget and no taste.",
   "est_sec": 5.06,
   "gap_before": 0.6,
   "block": "birthday_party.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Two problems, both fixable. Does she have a favourite colour?",
   "est_sec": 3.2,
   "gap_before": 1.52,
   "role": "reply",
   "block": "birthday_party.dlg20"
  },
  {
   "speaker": "user",
   "text": "Green. Like, forest green.",
   "est_sec": 1.34,
   "gap_before": 1.14,
   "block": "birthday_party.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then collect some branches and leaves from a walk, put them in jars with candles, and add a string of fairy lights if you have one.",
   "est_sec": 8.16,
   "gap_before": 0.96,
   "role": "reply",
   "block": "birthday_party.dlg20"
  },
  {
   "speaker": "user",
   "text": "Hi Ethan, Moshi helped me figure out the bus fare.",
   "est_sec": 3.2,
   "gap_before": 2.92,
   "block": "mm_119",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_119",
   "name_pos": "start",
   "addressee": "Ethan"
  },
  {
   "speaker": "other",
   "text": "How much is it?",
   "est_sec": 1.34,
   "gap_before": 0.77,
   "block": "mm_119"
  },
  {
   "speaker": "user",
   "text": "That actually sounds nice. What else?",
   "est_sec": 1.96,
   "gap_before": 1.39,
   "block": "birthday_party.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Print a few photos of the two of you and peg them along a piece of string. Costs almost nothing, looks personal.",
   "est_sec": 6.92,
   "gap_before": 0.47,
   "role": "reply",
   "block": "birthday_party.dlg20"
  },
  {
   "speaker": "user",
   "text": "And she won't think I just picked up rubbish from the park?",
   "est_sec": 3.82,
   "gap_before": 0.51,
   "block": "birthday_party.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not if the photos are there. It'll look intentional, almost like a little woodland theme.",
   "est_sec": 4.75,
   "gap_before": 0.86,
   "role": "reply",
   "block": "birthday_party.dlg20"
  }
 ]
