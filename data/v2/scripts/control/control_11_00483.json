 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.55,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.66,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "I'm running a half marathon on Sunday and it'll probably be wet and cold.",
   "est_sec": 4.44,
   "gap_before": 0.43,
   "block": "weather_plans.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Okay, layers again. A light, thin rain jacket you can tie around your waist, plus a cap to keep rain out of your eyes.",
   "est_sec": 7.54,
   "gap_before": 0.88,
   "role": "reply",
   "block": "weather_plans.dlg29"
  },
  {
   "speaker": "user",
   "text": "Sorry, Freya, did you just print forty copies of something?",
   "est_sec": 3.2,
   "gap_before": 0.97,
   "block": "nq_work_006",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_work_006",
   "name_pos": "middle",
   "addressee": "Freya"
  },
  {
   "speaker": "other",
   "text": "That was a mistake. Ignore it.",
   "est_sec": 1.96,
   "gap_before": 0.55,
   "block": "nq_work_006"
  },
  {
   "speaker": "user",
   "text": "A cap? I never run in one.",
   "est_sec": 2.27,
   "gap_before": 1.04,
   "block": "weather_plans.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "In the rain it's a game changer. Try it on a short run first.",
   "est_sec": 4.44,
   "gap_before": 1.01,
   "role": "reply",
   "block": "weather_plans.dlg29"
  },
  {
   "speaker": "user",
   "text": "What about chafing? It's worse when wet.",
   "est_sec": 2.27,
   "gap_before": 1.18,
   "block": "weather_plans.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Use plenty of anti chafe balm in all the usual spots before you set off. Taping nipples helps a lot too.",
   "est_sec": 6.61,
   "gap_before": 1.52,
   "role": "reply",
   "block": "weather_plans.dlg29"
  },
  {
   "speaker": "user",
   "text": "And at the start,",
   "est_sec": 1.34,
   "gap_before": 0.36,
   "event": "distractor",
   "kind": "pause",
   "block": "weather_plans.dlg29"
  },
  {
   "speaker": "user",
   "text": "while we're waiting?",
   "est_sec": 1.03,
   "gap_before": 1.56,
   "block": "weather_plans.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Wear a bin bag with holes for your head and arms, then throw it away when you start. Very glamorous, very effective.",
   "est_sec": 6.92,
   "gap_before": 1.04,
   "role": "reply",
   "block": "weather_plans.dlg29"
  }
 ]
