 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.6,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "My friend says I look bored in interviews. I'm not, it's just my face.",
   "est_sec": 4.44,
   "gap_before": 0.47,
   "block": "job_interview.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ha, resting serious face. Body language can fix a lot of that.",
   "est_sec": 3.82,
   "gap_before": 0.47,
   "role": "reply",
   "block": "job_interview.dlg26"
  },
  {
   "speaker": "user",
   "text": "Like what? I can't just grin the whole time.",
   "est_sec": 2.89,
   "gap_before": 1.46,
   "block": "job_interview.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "No, but lean forward slightly when they talk, nod now and then, and smile when you greet them and when you're talking about something you enjoy.",
   "est_sec": 8.16,
   "gap_before": 0.83,
   "role": "reply",
   "block": "job_interview.dlg26"
  },
  {
   "speaker": "user",
   "text": "Ama, Moshi has a timer running for the laundry.",
   "est_sec": 2.89,
   "gap_before": 1.08,
   "block": "mm_085",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_085",
   "name_pos": "start",
   "addressee": "Ama"
  },
  {
   "speaker": "user",
   "text": "I also tend to cross my arms.",
   "est_sec": 2.27,
   "gap_before": 2.65,
   "block": "job_interview.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Try resting your hands loosely on the table instead. It looks more open and you'll feel less stiff.",
   "est_sec": 5.68,
   "gap_before": 0.85,
   "role": "reply",
   "block": "job_interview.dlg26"
  },
  {
   "speaker": "user",
   "text": "Feels weird",
   "est_sec": 0.72,
   "gap_before": 1.06,
   "event": "distractor",
   "kind": "pause",
   "block": "job_interview.dlg26"
  },
  {
   "speaker": "user",
   "text": "but okay, I'll try it in the mirror.",
   "est_sec": 2.58,
   "gap_before": 1.85,
   "block": "job_interview.dlg26",
   "event": "ordinary_request"
  },
  {
