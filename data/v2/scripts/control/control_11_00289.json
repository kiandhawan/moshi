 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.92,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "We're at a holiday cottage and all there is is a deck of cards. Any games for four adults?",
   "est_sec": 5.99,
   "gap_before": 0.49,
   "block": "board_games.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Loads. Hearts is a great one for four, easy to learn, and a bit mean in a fun way.",
   "est_sec": 5.99,
   "gap_before": 1.31,
   "role": "reply",
   "block": "board_games.dlg14"
  },
  {
   "speaker": "user",
   "text": "Hold on, really?",
   "est_sec": 1.03,
   "gap_before": 0.92,
   "block": "board_games.dlg14",
   "kind": "wait_like",
   "phrasing": "waitlike_11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "I'm fairly sure about it, but I could be wrong. What sounds off to you?",
   "est_sec": 4.75,
   "gap_before": 0.9,
   "role": "reply",
   "block": "board_games.dlg14"
  },
  {
   "speaker": "user",
   "text": "How mean?",
   "est_sec": 0.72,
   "gap_before": 0.32,
   "block": "board_games.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You're trying to avoid taking hearts and one nasty queen, and you pass bad cards to each other at the start of each round.",
   "est_sec": 7.54,
   "gap_before": 1.02,
   "role": "reply",
   "block": "board_games.dlg14"
  },
  {
   "speaker": "user",
   "text": "Sounds perfect for my family.",
   "est_sec": 1.65,
   "gap_before": 0.99,
   "block": "board_games.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "If you want something louder, try a fast slapping game like spit or a team game like spades.",
   "est_sec": 5.68,
   "gap_before": 1.05,
   "role": "reply",
   "block": "board_games.dlg14"
  },
  {
   "speaker": "user",
   "text": "Teams might be safer.",
   "est_sec": 1.34,
   "gap_before": 3.4,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg14"
  },
  {
   "speaker": "user",
   "text": "My sister and I shouldn't be on opposite sides.",
   "est_sec": 2.89,
   "gap_before": 2.4,
   "block": "board_games.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then spades with you two as partners. You'll have a shared enemy instead.",
   "est_sec": 4.13,
   "gap_before": 0.9,
   "role": "reply",
   "block": "board_games.dlg14"
  }
 ]
}
