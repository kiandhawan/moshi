 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.45,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "Is taking the bus actually better for the environment than driving? Be honest.",
   "est_sec": 4.13,
   "gap_before": 0.45,
   "block": "public_transport.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Generally yes, especially when the bus is reasonably full. Per passenger, a busy bus produces far less pollution than everyone driving.",
   "est_sec": 6.61,
   "gap_before": 0.68,
   "role": "reply",
   "block": "public_transport.dlg21"
  },
  {
   "speaker": "user",
   "text": "Did you ring your dad about Sunday lunch, William?",
   "est_sec": 2.89,
   "gap_before": 0.32,
   "block": "nq_home_064",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_064",
   "name_pos": "end",
   "addressee": "William"
  },
  {
   "speaker": "other",
   "text": "He's bringing a trifle, apparently.",
   "est_sec": 1.65,
   "gap_before": 0.98,
   "block": "nq_home_064"
  },
  {
   "speaker": "user",
   "text": "And an empty bus at midnight?",
   "est_sec": 1.96,
   "gap_before": 1.1,
   "block": "public_transport.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's less impressive, fair. But the bus runs anyway, so you riding it adds almost nothing extra.",
   "est_sec": 5.37,
   "gap_before": 1.07,
   "role": "reply",
   "block": "public_transport.dlg21"
  },
  {
   "speaker": "user",
   "text": "Huh. I never looked",
   "est_sec": 1.34,
   "gap_before": 1.25,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg21"
  },
  {
   "speaker": "user",
   "text": "at it that way.",
   "est_sec": 1.34,
   "gap_before": 2.18,
   "block": "public_transport.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's a nice way to think about it. And trains, especially electric ones, are usually even better.",
   "est_sec": 5.37,
   "gap_before": 0.61,
   "role": "reply",
   "block": "public_transport.dlg21"
  },
  {
   "speaker": "user",
   "text": "So I can feel smug on the train.",
   "est_sec": 2.58,
   "gap_before": 2.41,
   "block": "public_transport.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A little smugness is allowed.",
   "est_sec": 1.65,
   "gap_before": 1.15,
   "role": "reply",
   "block": "public_transport.dlg21"
  }
 ]
}
