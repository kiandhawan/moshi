 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.43,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.55,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "Should I bring cash to Japan or just use my card?",
   "est_sec": 3.51,
   "gap_before": 0.58,
   "block": "travel_planning.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Bring some cash. Cards are widely accepted in cities now, but smaller restaurants, temples and rural places often still want cash.",
   "est_sec": 6.61,
   "gap_before": 0.87,
   "role": "reply",
   "block": "travel_planning.dlg9"
  },
  {
   "speaker": "user",
   "text": "How much?",
   "est_sec": 0.72,
   "gap_before": 1.44,
   "block": "travel_planning.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Enough for a couple of days is a good start. Convenience store cash machines usually accept foreign cards, so you can top up.",
   "est_sec": 7.23,
   "gap_before": 0.38,
   "role": "reply",
   "block": "travel_planning.dlg9"
  },
  {
   "speaker": "user",
   "text": "I've been using Moshi to count reps at the gym.",
   "est_sec": 3.2,
   "gap_before": 0.84,
   "block": "mm_073",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_073",
   "name_pos": "none"
  },
  {
   "speaker": "other",
   "text": "Does it cheer you on?",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "block": "mm_073"
  },
  {
   "speaker": "user",
   "text": "Hey Felix, are you driving in or taking the tram?",
   "est_sec": 3.2,
   "gap_before": 1.88,
   "block": "nq_work_077",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_work_077",
   "name_pos": "start",
   "addressee": "Felix"
  },
  {
   "speaker": "user",
   "text": "Do I get yen before I go?",
   "est_sec": 2.27,
   "gap_before": 2.01,
   "block": "travel_planning.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can, but rates at home are often worse. Taking some out at the airport when you land is usually fine.",
   "est_sec": 6.61,
   "gap_before": 0.42,
   "role": "reply",
   "block": "travel_planning.dlg9"
  },
  {
   "speaker": "user",
   "text": "And do I tell my bank",
   "est_sec": 1.96,
   "gap_before": 0.36,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg9"
  },
  {
   "speaker": "user",
   "text": "that I'm traveling? People keep saying that.",
   "est_sec": 2.27,
   "gap_before": 1.6,
   "block": "travel_planning.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It doesn't hurt. Many banks don't need it anymore, but a quick message in their app can stop your card being blocked.",
