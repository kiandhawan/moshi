 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.83,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "My friends always argue about the rules in Monopoly. How do we stop that?",
   "est_sec": 4.44,
   "gap_before": 0.47,
   "block": "board_games.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Agree on house rules before you start, like what happens on free parking. Writing them on a note helps.",
   "est_sec": 5.99,
   "gap_before": 1.06,
   "role": "reply",
   "block": "board_games.dlg2"
  },
  {
   "speaker": "user",
   "text": "The game also takes forever.",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "block": "board_games.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "The official rules include auctions when someone skips a property. Using them makes the game much faster.",
   "est_sec": 5.37,
   "gap_before": 0.86,
   "role": "reply",
   "block": "board_games.dlg2"
  },
  {
   "speaker": "user",
   "text": "I had no idea. What else?",
   "est_sec": 1.96,
   "gap_before": 1.4,
   "block": "board_games.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can set a time limit, like ninety minutes, and whoever has the most money then wins.",
   "est_sec": 5.37,
   "gap_before": 0.63,
   "role": "reply",
   "block": "board_games.dlg2"
  },
  {
   "speaker": "user",
   "text": "Honestly, maybe",
   "est_sec": 0.72,
   "gap_before": 0.45,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg2"
  },
  {
   "speaker": "user",
   "text": "we should just play a different game.",
   "est_sec": 2.27,
   "gap_before": 2.65,
   "block": "board_games.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's an option too. Catan has a similar trading feel and usually ends in about an hour.",
   "est_sec": 5.37,
   "gap_before": 0.83,
   "role": "reply",
   "block": "board_games.dlg2"
  }
