 "est_total_sec": 51.27,
 "est_speech_sec": 38.61,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.47,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.91,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "My sister and I are going to the Christmas markets in Germany. What do I wear? I'm from Florida.",
   "est_sec": 5.99,
   "gap_before": 0.37,
   "block": "travel_planning.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Layers, lots of them. It can be around freezing, and you'll be standing outside for hours.",
   "est_sec": 5.06,
   "gap_before": 0.48,
   "role": "reply",
   "block": "travel_planning.dlg22"
  },
  {
   "speaker": "user",
   "text": "Freezing. Okay. I own exactly one coat.",
   "est_sec": 2.27,
   "gap_before": 1.14,
   "block": "travel_planning.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Make sure it's warm and ideally waterproof. Add thermal underwear, a thick jumper, a hat, a scarf and gloves.",
   "est_sec": 5.99,
   "gap_before": 1.88,
   "role": "reply",
   "block": "travel_planning.dlg22"
  },
  {
   "speaker": "user",
   "text": "Thermal underwear. Very glamorous.",
   "est_sec": 1.34,
   "gap_before": 0.45,
   "block": "travel_planning.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's the secret of every happy market visitor. Good boots with thick socks matter too, cold feet ruin everything.",
   "est_sec": 5.99,
   "gap_before": 0.77,
   "role": "reply",
   "block": "travel_planning.dlg22"
  },
  {
   "speaker": "user",
   "text": "And the mulled wine",
   "est_sec": 1.34,
   "gap_before": 1.43,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg22"
  },
  {
   "speaker": "user",
   "text": "keeps you warm, right?",
   "est_sec": 1.34,
   "gap_before": 2.51,
   "block": "travel_planning.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It helps your hands at least. You often pay a deposit for the mug, and you can keep it as a souvenir.",
   "est_sec": 6.92,
   "gap_before": 0.75,
   "role": "reply",
   "block": "travel_planning.dlg22"
  }
 ]
}
