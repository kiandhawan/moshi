 "est_total_sec": 65.12,
 "est_speech_sec": 49.45,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.76,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.57,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "I've been gluten free for a year and I really miss proper bread.",
   "est_sec": 4.13,
   "gap_before": 0.35,
   "block": "baking.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Gluten free bread is a different beast, but you can get something good. Start with a flour blend that already contains xanthan gum or psyllium.",
   "est_sec": 7.85,
   "gap_before": 1.4,
   "role": "reply",
   "block": "baking.dlg27"
  },
  {
   "speaker": "user",
   "text": "Who drank all the orange juice, Matteo?",
   "est_sec": 2.27,
   "gap_before": 0.63,
   "block": "nq_home_057",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_057",
   "name_pos": "end",
   "addressee": "Matteo"
  },
  {
   "speaker": "user",
   "text": "What does psyllium do?",
   "est_sec": 1.34,
   "gap_before": 2.91,
   "block": "baking.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It acts a bit like gluten, holding the dough together and trapping air. Bread made with it is far less crumbly.",
   "est_sec": 6.61,
   "gap_before": 0.81,
   "role": "reply",
   "block": "baking.dlg27"
  },
  {
   "speaker": "user",
   "text": "The dough I made last time",
   "est_sec": 1.96,
   "gap_before": 0.93,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg27"
  },
  {
   "speaker": "user",
   "text": "was like cake batter. Is that normal?",
   "est_sec": 2.27,
   "gap_before": 2.27,
   "block": "baking.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, gluten free dough is usually much wetter. Don't add more flour to make it feel like normal dough, it'll come out dry.",
   "est_sec": 7.23,
   "gap_before": 0.31,
   "role": "reply",
   "block": "baking.dlg27"
  },
  {
   "speaker": "user",
   "text": "Any tip for the crust?",
   "est_sec": 1.65,
   "gap_before": 1.0,
   "block": "baking.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Bake it in a covered pot for the first part, then uncover it. And let it cool fully before slicing, it finishes setting as it cools.",
   "est_sec": 8.16,
   "gap_before": 0.76,
   "role": "reply",
   "block": "baking.dlg27"
  },
  {
   "speaker": "user",
   "text": "That's the hardest part.",
   "est_sec": 1.34,
   "gap_before": 0.87,
   "block": "baking.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It really is. Warm bread smells unfair.",
   "est_sec": 2.27,
   "gap_before": 0.6,
   "role": "reply",
   "block": "baking.dlg27"
  }
 ]
}
