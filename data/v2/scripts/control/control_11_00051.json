 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.36,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.9,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "What would I do if someone rolled their ankle halfway up a trail?",
   "est_sec": 4.13,
   "gap_before": 0.59,
   "block": "hiking.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "First, get them sitting down and check if they can bear any weight on it at all.",
   "est_sec": 5.37,
   "gap_before": 1.16,
   "role": "reply",
   "block": "hiking.dlg29"
  },
  {
   "speaker": "user",
   "text": "Say they can, a little.",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "block": "hiking.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then it's probably a sprain. Keep the boot on for support, tighten the laces, and walk back slowly with poles or a shoulder to lean on.",
   "est_sec": 8.16,
   "gap_before": 0.7,
   "role": "reply",
   "block": "hiking.dlg29"
  },
  {
   "speaker": "user",
   "text": "Keep the boot on? I'd have taken it off.",
   "est_sec": 2.89,
   "gap_before": 1.15,
   "block": "hiking.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "If you take it off, the swelling might stop you getting it back on. Ice and elevate once you're home.",
   "est_sec": 6.3,
   "gap_before": 0.39,
   "role": "reply",
   "block": "hiking.dlg29"
  },
  {
   "speaker": "user",
   "text": "And if they can't walk at all?",
   "est_sec": 2.27,
   "gap_before": 0.78,
   "block": "hiking.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Keep them warm and call emergency services. Give your exact location, an offline map app can show your coordinates.",
   "est_sec": 5.99,
   "gap_before": 1.18,
   "role": "reply",
   "block": "hiking.dlg29"
  }
 ]
}
