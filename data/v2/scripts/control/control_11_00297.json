 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.7,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "I want a photo booth at my party but renting one is crazy expensive.",
   "est_sec": 4.44,
   "gap_before": 0.37,
   "block": "birthday_party.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can make one easily. Do you have a blank wall and a phone tripod?",
   "est_sec": 4.75,
   "gap_before": 0.7,
   "role": "reply",
   "block": "birthday_party.dlg29"
  },
  {
   "speaker": "user",
   "text": "Hey Lydia, is the wifi dropping for you too?",
   "est_sec": 2.89,
   "gap_before": 0.84,
   "block": "nq_work_073",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_work_073",
   "name_pos": "start",
   "addressee": "Lydia"
  },
  {
   "speaker": "other",
   "text": "Yeah, mine just died.",
   "est_sec": 1.34,
   "gap_before": 0.92,
   "block": "nq_work_073"
  },
  {
   "speaker": "user",
   "text": "Wall yes, tripod no.",
   "est_sec": 1.34,
   "gap_before": 1.75,
   "block": "birthday_party.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A stack of books works as a tripod. Hang a sheet of shiny curtain or wrapping paper on the wall and add a lamp in front for good light.",
   "est_sec": 9.09,
   "gap_before": 1.4,
   "role": "reply",
   "block": "birthday_party.dlg29"
  },
  {
   "speaker": "user",
   "text": "And props?",
   "est_sec": 0.72,
   "gap_before": 3.17,
   "block": "birthday_party.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Cardboard speech bubbles, silly hats, big sunglasses. Charity shops are brilliant for cheap props.",
   "est_sec": 4.44,
   "gap_before": 0.9,
   "role": "reply",
   "block": "birthday_party.dlg29"
  },
  {
   "speaker": "user",
   "text": "How do people take the photos",
   "est_sec": 1.96,
   "gap_before": 1.48,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg29"
  },
  {
   "speaker": "user",
   "text": "if nobody's standing behind the phone?",
   "est_sec": 1.96,
   "gap_before": 1.71,
   "block": "birthday_party.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Use the phone's timer, or a cheap Bluetooth remote. Put a little sign on the wall explaining how.",
   "est_sec": 5.68,
   "gap_before": 0.51,
   "role": "reply",
   "block": "birthday_party.dlg29"
  }
