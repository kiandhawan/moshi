 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.51,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.48,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "My son's studying abroad and I want to post him a box of my shortbread. Will it survive?",
   "est_sec": 5.68,
   "gap_before": 0.49,
   "block": "baking.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Shortbread is one of the best things to post. It's sturdy and keeps for a couple of weeks.",
   "est_sec": 5.68,
   "gap_before": 0.5,
   "role": "reply",
   "block": "baking.dlg31"
  },
  {
   "speaker": "user",
   "text": "How should I pack it?",
   "est_sec": 1.65,
   "gap_before": 1.03,
   "block": "baking.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Wrap them in pairs back to back in cling film, stack them in a tin, and fill any gaps with crumpled paper so nothing rattles.",
   "est_sec": 7.85,
   "gap_before": 0.93,
   "role": "reply",
   "block": "baking.dlg31"
  },
  {
   "speaker": "user",
   "text": "A tin inside",
   "est_sec": 1.03,
   "gap_before": 1.15,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg31"
  },
  {
   "speaker": "user",
   "text": "a box?",
   "est_sec": 0.72,
   "gap_before": 2.64,
   "block": "baking.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, the tin protects them and the box protects the tin. Shake the parcel gently before sealing it. If you hear movement, add more padding.",
   "est_sec": 7.85,
   "gap_before": 1.27,
   "role": "reply",
   "block": "baking.dlg31"
  },
  {
   "speaker": "user",
   "text": "He'll probably eat them all in one night.",
   "est_sec": 2.58,
   "gap_before": 1.29,
   "block": "baking.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then send two tins and tell him one is for sharing.",
   "est_sec": 3.51,
   "gap_before": 0.64,
   "role": "reply",
   "block": "baking.dlg31"
  }
 ]
}
