 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.48,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.74,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "Is it okay to paint over wallpaper?",
   "est_sec": 2.27,
   "gap_before": 0.3,
   "block": "home_repair.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can, but it's a bit of a gamble. If the paper is firmly stuck, it can work. If it's loose, the paint can make it bubble.",
   "est_sec": 8.47,
   "gap_before": 1.06,
   "role": "reply",
   "block": "home_repair.dlg18"
  },
  {
   "speaker": "user",
   "text": "It's stuck really well. It's from the eighties.",
   "est_sec": 2.58,
   "gap_before": 0.38,
   "block": "home_repair.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then it's probably fine. Prime it first, especially if it's patterned or shiny.",
   "est_sec": 4.13,
   "gap_before": 0.61,
   "role": "reply",
   "block": "home_repair.dlg18"
  },
  {
   "speaker": "user",
   "text": "Why prime?",
   "est_sec": 0.72,
   "gap_before": 0.53,
   "block": "home_repair.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Primer helps the paint grip and stops the pattern showing through. Otherwise you might see those flowers ghosting under your new color.",
   "est_sec": 6.92,
   "gap_before": 0.84,
   "role": "reply",
   "block": "home_repair.dlg18"
  },
  {
   "speaker": "user",
   "text": "Ha. I don't want ghost flowers.",
   "est_sec": 1.96,
   "gap_before": 0.92,
   "block": "home_repair.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Definitely not. Test a small patch first, and check after a day that nothing bubbled up.",
   "est_sec": 5.06,
   "gap_before": 0.53,
   "role": "reply",
   "block": "home_repair.dlg18"
  }
 ]
}
