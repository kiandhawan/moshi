 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.92,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "How big can I print a photo from my phone before it looks bad?",
   "est_sec": 4.44,
   "gap_before": 0.23,
   "block": "photography.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most modern phones are fine up to about A three for a wall, especially if you view it from a little distance.",
   "est_sec": 6.92,
   "gap_before": 0.82,
   "role": "reply",
   "block": "photography.dlg29"
  },
  {
   "speaker": "user",
   "text": "I want it huge, over the sofa.",
   "est_sec": 2.27,
   "gap_before": 0.88,
   "block": "photography.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then it depends on the photo. Sharp, well lit shots in daylight hold up much better than dark ones or ones where you zoomed in.",
   "est_sec": 7.85,
   "gap_before": 0.53,
   "role": "reply",
   "block": "photography.dlg29"
  },
  {
   "speaker": "user",
   "text": "It's a sunset at the lake. No zoom.",
   "est_sec": 2.58,
   "gap_before": 1.23,
   "block": "photography.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That should be fine pretty big. Order a small test print first to check the colours, phone screens often look brighter than paper.",
   "est_sec": 7.23,
   "gap_before": 0.78,
   "role": "reply",
   "block": "photography.dlg29"
  },
  {
   "speaker": "user",
   "text": "Good idea. Canvas or paper?",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "block": "photography.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Canvas hides a little softness and needs no frame, which is nice for a big sunset. Paper behind glass looks crisper but costs more to frame.",
   "est_sec": 8.16,
   "gap_before": 0.55,
   "role": "reply",
   "block": "photography.dlg29"
  }
 ]
}
