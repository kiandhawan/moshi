 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.53,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.55,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I made cold brew concentrate and I have no idea how much to dilute it. My first glass nearly launched me into orbit.",
   "est_sec": 7.23,
   "gap_before": 0.6,
   "block": "coffee.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Concentrate is strong stuff, yes. What ratio of coffee to water did you use when you made it?",
   "est_sec": 5.68,
   "gap_before": 0.49,
   "role": "reply",
   "block": "coffee.dlg19"
  },
  {
   "speaker": "user",
   "text": "About one cup of grounds to four cups of water.",
   "est_sec": 3.2,
   "gap_before": 1.73,
   "block": "coffee.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a typical concentrate. Try mixing it about half and half with water or milk, then adjust to taste.",
   "est_sec": 5.99,
   "gap_before": 0.94,
   "role": "reply",
   "block": "coffee.dlg19"
  },
  {
   "speaker": "user",
   "text": "Half and half. And with ice",
   "est_sec": 1.96,
   "gap_before": 2.16,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg19"
  },
  {
   "speaker": "user",
   "text": "it'll get weaker anyway?",
   "est_sec": 1.34,
   "gap_before": 2.67,
   "block": "coffee.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Right, the ice melts a bit and softens it. Some people make coffee ice cubes from leftover cold brew so the drink stays strong.",
   "est_sec": 7.54,
   "gap_before": 0.71,
   "role": "reply",
   "block": "coffee.dlg19"
  },
  {
   "speaker": "user",
   "text": "How long will the jar last in the fridge?",
   "est_sec": 2.89,
   "gap_before": 0.63,
   "block": "coffee.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Concentrate keeps for about two weeks if it's sealed. Diluted, it's best within a few days.",
   "est_sec": 5.06,
   "gap_before": 0.58,
   "role": "reply",
   "block": "coffee.dlg19"
  }
 ]
