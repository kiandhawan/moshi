 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.7,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "My eight year old watched a scary film at a friend's house and now he won't sleep.",
   "est_sec": 5.37,
   "gap_before": 0.27,
   "block": "movies.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Poor thing. Talk about it during the day, not at bedtime. Ask him what part scared him most.",
   "est_sec": 5.68,
   "gap_before": 0.51,
   "role": "reply",
   "block": "movies.dlg15"
  },
  {
   "speaker": "user",
   "text": "Have you heard Jas got engaged, Arjun?",
   "est_sec": 2.27,
   "gap_before": 1.02,
   "block": "nq_social_056",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_056",
   "name_pos": "end",
   "addressee": "Arjun"
  },
  {
   "speaker": "other",
   "text": "No way! To the guy from climbing?",
   "est_sec": 2.27,
   "gap_before": 0.83,
   "block": "nq_social_056"
  },
  {
   "speaker": "user",
   "text": "He says it's the monster in the wardrobe.",
   "est_sec": 2.58,
   "gap_before": 0.87,
   "block": "movies.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It can help to explain how films are made, like the monster being an actor in a costume, or a puppet. Making it less magic makes it less scary.",
   "est_sec": 9.09,
   "gap_before": 1.07,
   "role": "reply",
   "block": "movies.dlg15"
  },
  {
   "speaker": "user",
   "text": "Ooh, could we",
   "est_sec": 1.03,
   "gap_before": 1.89,
   "event": "distractor",
   "kind": "pause",
   "block": "movies.dlg15"
  },
  {
   "speaker": "user",
   "text": "watch a behind the scenes video together?",
   "est_sec": 2.27,
   "gap_before": 2.42,
   "block": "movies.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a great idea, if one exists for that film. Seeing the crew laughing on set really shrinks the fear.",
   "est_sec": 6.3,
   "gap_before": 0.71,
   "role": "reply",
   "block": "movies.dlg15"
  },
  {
   "speaker": "user",
   "text": "And tonight?",
   "est_sec": 0.72,
   "gap_before": 0.78,
   "block": "movies.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A nightlight, the wardrobe doors shut, and a calm, funny story before bed. Most kids get over it within a week.",
   "est_sec": 6.61,
   "gap_before": 1.17,
   "role": "reply",
   "block": "movies.dlg15"
  }
 ]
}
