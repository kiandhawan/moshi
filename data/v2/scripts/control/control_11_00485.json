 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.64,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "What's a break clause in a rental contract?",
   "est_sec": 2.58,
   "gap_before": 0.4,
   "block": "moving_house.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It lets you or the landlord end the tenancy early, usually after a set period like six months, with notice.",
   "est_sec": 6.3,
   "gap_before": 0.42,
   "role": "reply",
   "block": "moving_house.dlg27"
  },
  {
   "speaker": "user",
   "text": "So I'm not stuck for the whole year?",
   "est_sec": 2.58,
   "gap_before": 0.73,
   "block": "moving_house.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Without one, you'd normally have to pay rent until the end of the fixed term, even if you leave.",
   "est_sec": 6.3,
   "gap_before": 1.05,
   "role": "reply",
   "block": "moving_house.dlg27"
  },
  {
   "speaker": "user",
   "text": "Should I ask for one?",
   "est_sec": 1.65,
   "gap_before": 0.66,
   "block": "moving_house.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "If there's any chance your plans might change, yes. Some landlords agree, especially for longer contracts.",
   "est_sec": 5.06,
   "gap_before": 0.7,
   "role": "reply",
   "block": "moving_house.dlg27"
  },
  {
   "speaker": "user",
   "text": "Okay. And notice is usually",
   "est_sec": 1.65,
   "gap_before": 1.48,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg27"
  },
  {
   "speaker": "user",
   "text": "how long?",
   "est_sec": 0.72,
   "gap_before": 2.96,
   "block": "moving_house.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Often one or two months, but check what your contract says. Write it down so you don't miss the date.",
   "est_sec": 6.3,
   "gap_before": 0.41,
   "role": "reply",
   "block": "moving_house.dlg27"
  }
 ]
}
