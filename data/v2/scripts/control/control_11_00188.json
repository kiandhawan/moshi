 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.65,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.51,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "My four year old won't eat anything green. Not even peas.",
   "est_sec": 3.51,
   "gap_before": 0.29,
   "block": "cooking.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Very common at that age. Hiding veg in sauces can help, but so can letting him see the green stuff over and over without pressure.",
   "est_sec": 7.85,
   "gap_before": 0.96,
   "role": "reply",
   "block": "cooking.dlg14"
  },
  {
   "speaker": "user",
   "text": "Hiding where, though?",
   "est_sec": 1.03,
   "gap_before": 1.02,
   "block": "cooking.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Blend spinach or courgette into a tomato pasta sauce. Grated carrot disappears in meatballs.",
   "est_sec": 4.44,
   "gap_before": 0.51,
   "role": "reply",
   "block": "cooking.dlg14"
  },
  {
   "speaker": "user",
   "text": "He does love meatballs.",
   "est_sec": 1.34,
   "gap_before": 1.31,
   "block": "cooking.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Perfect then. You could even let him roll them with you, kids are more likely to eat what they've made.",
   "est_sec": 6.3,
   "gap_before": 1.1,
   "role": "reply",
   "block": "cooking.dlg14"
  },
  {
   "speaker": "user",
   "text": "And the not pressuring part? Because",
   "est_sec": 1.96,
   "gap_before": 1.47,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg14"
  },
  {
   "speaker": "user",
   "text": "honestly I've been begging.",
   "est_sec": 1.34,
   "gap_before": 1.59,
   "block": "cooking.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Put a tiny bit of green on his plate and say nothing about it. Eat yours happily. It can take ten or fifteen tries before they accept something new.",
   "est_sec": 9.09,
   "gap_before": 0.55,
   "role": "reply",
   "block": "cooking.dlg14"
  },
  {
   "speaker": "user",
   "text": "Fifteen. Wow. Okay.",
   "est_sec": 1.03,
   "gap_before": 2.05,
   "block": "cooking.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's slow, but it does work. Hang in there.",
   "est_sec": 2.89,
   "gap_before": 1.14,
   "role": "reply",
   "block": "cooking.dlg14"
  }
 ]
}
