 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.38,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.55,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I always waste my weekends. How do people actually get stuff done, Moshi?",
   "est_sec": 4.13,
   "gap_before": 0.33,
   "block": "weekend_plans.dlg4",
   "kind": "moshi_name",
   "name_pos": "end",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "One trick is to pick just one or two things you really want to do, and leave the rest of the time free.",
   "est_sec": 7.23,
   "gap_before": 0.45,
   "role": "reply",
   "block": "weekend_plans.dlg4"
  },
  {
   "speaker": "user",
   "text": "Only two? That seems like nothing.",
   "est_sec": 1.96,
   "gap_before": 0.62,
   "block": "weekend_plans.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's enough. Most people try to cram in ten and end up doing none of them.",
   "est_sec": 5.06,
   "gap_before": 1.14,
   "role": "reply",
   "block": "weekend_plans.dlg4"
  },
  {
   "speaker": "user",
   "text": "Fair. This weekend I want to",
   "est_sec": 1.96,
   "gap_before": 0.35,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg4"
  },
  {
   "speaker": "user",
   "text": "finally sort out my wardrobe.",
   "est_sec": 1.65,
   "gap_before": 1.58,
   "block": "weekend_plans.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Great. Do it Saturday morning while you've got energy, then you'll have the rest of the weekend to relax.",
   "est_sec": 5.99,
   "gap_before": 0.65,
   "role": "reply",
   "block": "weekend_plans.dlg4"
  },
  {
   "speaker": "user",
   "text": "Wait, what did you say?",
   "est_sec": 1.65,
   "gap_before": 0.9,
   "block": "weekend_plans.dlg4",
   "kind": "wait_like",
   "phrasing": "waitlike_01",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "No problem. Great. Do it Saturday morning while you've got energy, then you'll have the rest of the weekend to relax.",
   "est_sec": 6.61,
   "gap_before": 0.33,
   "role": "reply",
   "block": "weekend_plans.dlg4"
  },
  {
   "speaker": "user",
   "text": "And the second thing could be seeing a friend.",
   "est_sec": 2.89,
   "gap_before": 0.57,
   "block": "weekend_plans.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Perfect balance, one chore and one treat. You'll feel like you had a real weekend.",
   "est_sec": 4.75,
   "gap_before": 1.81,
   "role": "reply",
   "block": "weekend_plans.dlg4"
  }
 ]
