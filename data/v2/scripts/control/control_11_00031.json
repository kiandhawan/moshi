 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.38,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "What are the actual rules in a quiet carriage? My neighbour keeps taking calls.",
   "est_sec": 4.44,
   "gap_before": 0.22,
   "block": "public_transport.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Generally, no phone calls, no music without headphones, and keep conversations to a whisper.",
   "est_sec": 4.44,
   "gap_before": 0.92,
   "role": "reply",
   "block": "public_transport.dlg5"
  },
  {
   "speaker": "user",
   "text": "Should I say something to him?",
   "est_sec": 1.96,
   "gap_before": 0.99,
   "block": "public_transport.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A polite word is fine. Something like, this is the quiet carriage, would you mind taking that in the corridor.",
   "est_sec": 6.3,
   "gap_before": 1.04,
   "role": "reply",
   "block": "public_transport.dlg5"
  },
  {
   "speaker": "user",
   "text": "And if he",
   "est_sec": 1.03,
   "gap_before": 0.96,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg5"
  },
  {
   "speaker": "user",
   "text": "just ignores me?",
   "est_sec": 1.03,
   "gap_before": 1.52,
   "block": "public_transport.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then let the train staff know. It's their job to enforce it, and you don't have to get into an argument.",
   "est_sec": 6.61,
   "gap_before": 1.94,
   "role": "reply",
   "block": "public_transport.dlg5"
  },
  {
   "speaker": "user",
   "text": "I hate confrontation.",
   "est_sec": 1.03,
   "gap_before": 0.77,
   "block": "public_transport.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most people are just distracted and apologise straight away. You might be surprised.",
   "est_sec": 4.13,
   "gap_before": 0.8,
   "role": "reply",
   "block": "public_transport.dlg5"
  }
 ]
