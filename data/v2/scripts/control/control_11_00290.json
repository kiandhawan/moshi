 "est_total_sec": 54.79,
 "est_speech_sec": 42.33,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.53,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.97,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "The walk I'm planning ends at a lake. I'd love to swim at the end.",
   "est_sec": 4.75,
   "gap_before": 0.28,
   "block": "hiking.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sounds lovely. Just be careful, mountain lakes are often much colder than they look, even in summer.",
   "est_sec": 5.37,
   "gap_before": 1.98,
   "role": "reply",
   "block": "hiking.dlg25"
  },
  {
   "speaker": "user",
   "text": "Did you see the state of Dan's new haircut, Andrew?",
   "est_sec": 3.2,
   "gap_before": 1.3,
   "block": "nq_social_075",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_075",
   "name_pos": "end",
   "addressee": "Andrew"
  },
  {
   "speaker": "user",
   "text": "How cold are we talking?",
   "est_sec": 1.65,
   "gap_before": 1.9,
   "block": "hiking.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It can be cold enough to make you gasp involuntarily, which is dangerous if your head goes under. Walk in slowly rather than jumping.",
   "est_sec": 7.54,
   "gap_before": 1.08,
   "role": "reply",
   "block": "hiking.dlg25"
  },
  {
   "speaker": "user",
   "text": "I was totally going to jump.",
   "est_sec": 1.96,
   "gap_before": 0.5,
   "block": "hiking.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Lots of people do. Let your body adjust for a minute or two first, and stay close to the shore.",
   "est_sec": 6.3,
   "gap_before": 0.7,
   "role": "reply",
   "block": "hiking.dlg25"
  },
  {
   "speaker": "user",
   "text": "Anything else?",
   "est_sec": 0.72,
   "gap_before": 1.01,
   "block": "hiking.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Swim with someone, keep it short, and have warm clothes and a hot drink ready. You'll cool down more after you get out.",
   "est_sec": 7.23,
   "gap_before": 0.71,
   "role": "reply",
   "block": "hiking.dlg25"
  }
 ]
}
