 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.81,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "Three kids starting school in September and the uniform list is long. How do I not go bankrupt?",
   "est_sec": 5.68,
   "gap_before": 0.34,
   "block": "shopping.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Only buy the logo items from the official shop. Plain trousers, skirts, polo shirts and jumpers can usually come from any supermarket.",
   "est_sec": 6.92,
   "gap_before": 1.06,
   "role": "reply",
   "block": "shopping.dlg21"
  },
  {
   "speaker": "user",
   "text": "The school doesn't mind?",
   "est_sec": 1.34,
   "gap_before": 1.47,
   "block": "shopping.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most don't, as long as the colour matches. Check the school's uniform policy to be sure.",
   "est_sec": 5.06,
   "gap_before": 0.41,
   "role": "reply",
   "block": "shopping.dlg21"
  },
  {
   "speaker": "user",
   "text": "My youngest will just get the hand me downs, poor thing.",
   "est_sec": 3.51,
   "gap_before": 0.52,
   "block": "shopping.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's totally normal. Lots of schools also run a secondhand uniform sale, often for almost nothing.",
   "est_sec": 5.06,
   "gap_before": 0.57,
   "role": "reply",
   "block": "shopping.dlg21"
  },
  {
   "speaker": "user",
   "text": "Hold on, can you say that again?",
   "est_sec": 2.27,
   "gap_before": 1.25,
   "block": "shopping.dlg21",
   "kind": "wait_like",
   "phrasing": "waitlike_02",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sure, here it is again. That's totally normal. Lots of schools also run a secondhand uniform sale, often for almost nothing.",
   "est_sec": 6.61,
   "gap_before": 0.67,
   "role": "reply",
   "block": "shopping.dlg21"
  },
  {
   "speaker": "user",
   "text": "Oh, I didn't know that.",
   "est_sec": 1.65,
   "gap_before": 0.75,
   "event": "distractor",
   "kind": "pause",
   "block": "shopping.dlg21"
  },
  {
   "speaker": "user",
   "text": "I'll email the office.",
   "est_sec": 1.34,
   "gap_before": 2.0,
   "block": "shopping.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good idea. And put name labels on everything, lost jumpers are the hidden cost of the school year.",
   "est_sec": 5.68,
   "gap_before": 0.5,
