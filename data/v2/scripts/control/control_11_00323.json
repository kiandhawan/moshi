 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.34,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "I want to put up wallpaper for the first time. Any advice before I ruin a wall?",
   "est_sec": 5.37,
   "gap_before": 0.28,
   "block": "home_repair.dlg10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A few big ones. Start next to a window or door, and draw a straight line with a level, because walls are rarely straight.",
   "est_sec": 7.54,
   "gap_before": 0.87,
   "role": "reply",
   "block": "home_repair.dlg10"
  },
  {
   "speaker": "user",
   "text": "Paste the paper or paste the wall?",
   "est_sec": 2.27,
   "gap_before": 1.86,
   "block": "home_repair.dlg10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It depends on the wallpaper. Check the label. Many modern ones are paste the wall, which is easier.",
   "est_sec": 5.68,
   "gap_before": 0.4,
   "role": "reply",
   "block": "home_repair.dlg10"
  },
  {
   "speaker": "user",
   "text": "Hey Paola, did Tom and Leah really split up?",
   "est_sec": 2.89,
   "gap_before": 1.01,
   "block": "nq_social_027",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_027",
   "name_pos": "start",
   "addressee": "Paola"
  },
  {
   "speaker": "other",
   "text": "That's what Leah's posting, anyway.",
   "est_sec": 1.65,
   "gap_before": 0.64,
   "block": "nq_social_027"
  },
  {
   "speaker": "user",
   "text": "And bubbles? I'm terrified of bubbles.",
   "est_sec": 1.96,
   "gap_before": 1.4,
   "block": "home_repair.dlg10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Smooth from the middle out with a brush or a plastic smoother. Small bubbles often disappear as it dries.",
   "est_sec": 5.99,
   "gap_before": 0.97,
   "role": "reply",
   "block": "home_repair.dlg10"
  },
  {
   "speaker": "user",
   "text": "I picked a pattern with",
   "est_sec": 1.65,
   "gap_before": 0.55,
   "event": "distractor",
   "kind": "pause",
   "block": "home_repair.dlg10"
  },
  {
   "speaker": "user",
   "text": "big leaves, is that harder?",
   "est_sec": 1.65,
   "gap_before": 2.36,
   "block": "home_repair.dlg10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Patterns need matching at the joins, so you'll waste a bit more paper. Buy an extra roll to be safe.",
   "est_sec": 6.3,
   "gap_before": 1.38,
   "role": "reply",
   "block": "home_repair.dlg10"
  }
