 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.32,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.39,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "Do you know any good books set in space that aren't too technical?",
   "est_sec": 4.13,
   "gap_before": 0.37,
   "block": "books.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Plenty. Do you want adventure, or something quieter and more about the people on the ship?",
   "est_sec": 5.06,
   "gap_before": 0.51,
   "role": "reply",
   "block": "books.dlg27"
  },
  {
   "speaker": "user",
   "text": "The people. I don't care how the engines work.",
   "est_sec": 2.89,
   "gap_before": 0.74,
   "block": "books.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then look for character driven science fiction, like stories about a small crew on a long journey. They feel like found family dramas.",
   "est_sec": 7.23,
   "gap_before": 0.46,
   "role": "reply",
   "block": "books.dlg27"
  },
  {
   "speaker": "user",
   "text": "Found family, I love that.",
   "est_sec": 1.65,
   "gap_before": 2.02,
   "block": "books.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then you'll be happy. There's a whole wave of cozy space novels where the biggest problem is getting along with your crewmates.",
   "est_sec": 6.92,
   "gap_before": 1.15,
   "role": "reply",
   "block": "books.dlg27"
  },
  {
   "speaker": "user",
   "text": "Is there romance in them?",
   "est_sec": 1.65,
   "gap_before": 0.58,
   "block": "books.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Often a little, but it's usually gentle and part of the bigger story. Nothing that takes over.",
   "est_sec": 5.37,
   "gap_before": 0.52,
   "role": "reply",
   "block": "books.dlg27"
  }
 ]
}
