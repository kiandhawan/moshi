 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.51,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.49,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "There are tons of blackberries along my usual trail. Is it safe to eat them?",
   "est_sec": 4.75,
   "gap_before": 0.28,
   "block": "hiking.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Blackberries are one of the safest wild fruits, since there's nothing toxic that looks similar.",
   "est_sec": 4.75,
   "gap_before": 0.96,
   "role": "reply",
   "block": "hiking.dlg31"
  },
  {
   "speaker": "user",
   "text": "Even ones right by the path?",
   "est_sec": 1.96,
   "gap_before": 1.13,
   "block": "hiking.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Pick the ones higher up, away from where dogs might wander. Avoid bushes next to busy roads.",
   "est_sec": 5.37,
   "gap_before": 0.96,
   "role": "reply",
   "block": "hiking.dlg31"
  },
  {
   "speaker": "user",
   "text": "What about the red berries",
   "est_sec": 1.65,
   "gap_before": 0.83,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg31"
  },
  {
   "speaker": "user",
   "text": "right next to them?",
   "est_sec": 1.34,
   "gap_before": 2.78,
   "block": "hiking.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Leave those unless you're absolutely sure what they are. Some red berries are poisonous.",
   "est_sec": 4.44,
   "gap_before": 0.52,
   "role": "reply",
   "block": "hiking.dlg31"
  },
  {
   "speaker": "user",
   "text": "Got it, black and bumpy only.",
   "est_sec": 1.96,
   "gap_before": 0.45,
   "block": "hiking.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Bring a tub and you'll have a crumble by the evening.",
   "est_sec": 3.82,
   "gap_before": 0.99,
   "role": "reply",
   "block": "hiking.dlg31"
  }
