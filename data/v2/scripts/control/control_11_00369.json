 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.62,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.58,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "My cat yowls at four in the morning. Every morning. I'm losing my mind.",
   "est_sec": 4.44,
   "gap_before": 0.55,
   "block": "pets.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That sounds rough. Cats are naturally most active around dawn, and she's probably learned that yowling gets you up.",
   "est_sec": 5.99,
   "gap_before": 1.05,
   "role": "reply",
   "block": "pets.dlg6"
  },
  {
   "speaker": "user",
   "text": "Wait a second, that doesn't sound right.",
   "est_sec": 2.27,
   "gap_before": 0.64,
   "block": "pets.dlg6",
   "kind": "wait_like",
   "phrasing": "waitlike_10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Let me double-check. I'd still stand by it, but tell me what you heard.",
   "est_sec": 4.44,
   "gap_before": 0.82,
   "role": "reply",
   "block": "pets.dlg6"
  },
  {
   "speaker": "user",
   "text": "I do get up and feed her, yeah.",
   "est_sec": 2.58,
   "gap_before": 1.11,
   "block": "pets.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's the reward she's after. Try an automatic feeder that opens at dawn, so the food doesn't come from you.",
   "est_sec": 6.3,
   "gap_before": 0.73,
   "role": "reply",
   "block": "pets.dlg6"
  },
  {
   "speaker": "user",
   "text": "Smart. What else?",
   "est_sec": 1.03,
   "gap_before": 2.01,
   "block": "pets.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Play with her hard in the evening, like ten or fifteen minutes with a wand toy, then give her dinner. Tired, full cats sleep longer.",
   "est_sec": 7.85,
   "gap_before": 0.52,
   "role": "reply",
   "block": "pets.dlg6"
  },
  {
   "speaker": "user",
   "text": "And if she still screams?",
   "est_sec": 1.65,
   "gap_before": 1.94,
   "block": "pets.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ignore it completely, no talking, no getting up. It usually gets worse for a few nights before it stops, so hang in there.",
   "est_sec": 7.23,
   "gap_before": 0.65,
   "role": "reply",
   "block": "pets.dlg6"
  }
 ]
