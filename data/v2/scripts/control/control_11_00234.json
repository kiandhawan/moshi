 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.53,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.52,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "I have low vision and I'd love to get into games but text is always tiny.",
   "est_sec": 5.06,
   "gap_before": 0.43,
   "block": "video_games.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Lots of games have improved a lot here. Many have settings to enlarge text and menus, and some add high contrast modes.",
   "est_sec": 6.92,
   "gap_before": 0.34,
   "role": "reply",
   "block": "video_games.dlg12"
  },
  {
   "speaker": "user",
   "text": "How do I know before I buy?",
   "est_sec": 2.27,
   "gap_before": 0.58,
   "block": "video_games.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Look for accessibility reviews. Some websites and community groups rate games specifically on vision features.",
   "est_sec": 4.75,
   "gap_before": 1.46,
   "role": "reply",
   "block": "video_games.dlg12"
  },
  {
   "speaker": "user",
   "text": "Are there consoles with",
   "est_sec": 1.34,
   "gap_before": 0.75,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg12"
  },
  {
   "speaker": "user",
   "text": "built in options?",
   "est_sec": 1.03,
   "gap_before": 2.67,
   "block": "video_games.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, most modern consoles have system wide zoom, text to speech for menus, and colour filters. You can try them before buying any game.",
   "est_sec": 7.54,
   "gap_before": 0.44,
   "role": "reply",
   "block": "video_games.dlg12"
  },
  {
   "speaker": "user",
   "text": "What kind of games work best for me?",
   "est_sec": 2.58,
   "gap_before": 0.49,
   "block": "video_games.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Slower paced ones tend to be friendlier, like turn based strategy or adventure games, since you're not racing against the clock.",
   "est_sec": 6.61,
   "gap_before": 0.9,
   "role": "reply",
   "block": "video_games.dlg12"
  },
  {
   "speaker": "user",
   "text": "That sounds like my kind of thing anyway.",
   "est_sec": 2.58,
   "gap_before": 0.9,
   "block": "video_games.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then you're in luck. There's a lot to explore in those genres.",
   "est_sec": 3.82,
   "gap_before": 0.8,
   "role": "reply",
   "block": "video_games.dlg12"
  }
 ]
}
