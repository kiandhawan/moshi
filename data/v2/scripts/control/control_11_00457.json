 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.97,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "Is it bad to have lots of credit cards?",
   "est_sec": 2.89,
   "gap_before": 0.33,
   "block": "personal_finance.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not necessarily. What matters more is how much you owe on them and whether you pay on time.",
   "est_sec": 5.68,
   "gap_before": 0.66,
   "role": "reply",
   "block": "personal_finance.dlg11"
  },
  {
   "speaker": "user",
   "text": "I've got five. I only use two.",
   "est_sec": 2.27,
   "gap_before": 0.78,
   "block": "personal_finance.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Having unused cards can actually help your score, because it shows available credit. But only if they don't charge annual fees.",
   "est_sec": 6.61,
   "gap_before": 1.14,
   "role": "reply",
   "block": "personal_finance.dlg11"
  },
  {
   "speaker": "user",
   "text": "We've got a free evening, Elijah, fancy a board game?",
   "est_sec": 3.2,
   "gap_before": 0.68,
   "block": "nq_social_048",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_048",
   "name_pos": "middle",
   "addressee": "Elijah"
  },
  {
   "speaker": "user",
   "text": "Two of them have fees.",
   "est_sec": 1.65,
   "gap_before": 3.13,
   "block": "personal_finance.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then consider closing those. Just close one at a time, and keep your oldest card open.",
   "est_sec": 5.06,
   "gap_before": 1.16,
   "role": "reply",
   "block": "personal_finance.dlg11"
  },
  {
   "speaker": "user",
   "text": "Why the oldest one?",
   "est_sec": 1.34,
   "gap_before": 1.16,
   "block": "personal_finance.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "The length of your credit history counts. Closing your oldest card can shorten it.",
   "est_sec": 4.44,
   "gap_before": 1.13,
   "role": "reply",
   "block": "personal_finance.dlg11"
  }
 ]
}
