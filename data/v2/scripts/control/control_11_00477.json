 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.43,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.33,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "It's pouring rain on our moving day tomorrow. Ugh.",
   "est_sec": 2.89,
   "gap_before": 0.5,
   "block": "moving_house.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Annoying, but manageable. Lay old towels or cardboard on the floors at both places to stop mud getting everywhere.",
   "est_sec": 5.99,
   "gap_before": 0.98,
   "role": "reply",
   "block": "moving_house.dlg31"
  },
  {
   "speaker": "user",
   "text": "Let me have the last spring roll, Daniel.",
   "est_sec": 2.58,
   "gap_before": 1.03,
   "block": "nq_social_071",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_071",
   "name_pos": "end",
   "addressee": "Daniel"
  },
  {
   "speaker": "other",
   "text": "Fine, but I'm having the dumpling.",
   "est_sec": 1.96,
   "gap_before": 0.35,
   "block": "nq_social_071"
  },
  {
   "speaker": "user",
   "text": "What about the boxes?",
   "est_sec": 1.34,
   "gap_before": 1.14,
   "block": "moving_house.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Cover the ones with paper or books in bin bags. Keep a pile of plastic sheeting near the van for the sofa and mattress.",
   "est_sec": 7.54,
   "gap_before": 1.19,
   "role": "reply",
   "block": "moving_house.dlg31"
  },
  {
   "speaker": "user",
   "text": "The van is going to",
   "est_sec": 1.65,
   "gap_before": 0.95,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg31"
  },
  {
   "speaker": "user",
   "text": "get soaked inside too.",
   "est_sec": 1.34,
   "gap_before": 1.88,
   "block": "moving_house.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Park as close to the door as you can, and set up a quick handover point so things spend as little time in the rain as possible.",
   "est_sec": 8.47,
   "gap_before": 0.59,
   "role": "reply",
   "block": "moving_house.dlg31"
  },
  {
   "speaker": "user",
   "text": "Makes sense.",
   "est_sec": 0.72,
   "gap_before": 0.56,
   "block": "moving_house.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "And keep a dry change of clothes for everyone. You'll want it by the end.",
   "est_sec": 4.75,
   "gap_before": 0.74,
   "role": "reply",
   "block": "moving_house.dlg31"
  }
 ]
