 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.53,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.49,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "My friend wants to borrow a big amount of money from me. I don't know what to do.",
   "est_sec": 5.68,
   "gap_before": 0.53,
   "block": "personal_finance.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a tough spot. Would losing that money hurt you if it never came back?",
   "est_sec": 4.75,
   "gap_before": 0.43,
   "role": "reply",
   "block": "personal_finance.dlg19"
  },
  {
   "speaker": "user",
   "text": "Kind of, yeah. It's most of my savings.",
   "est_sec": 2.58,
   "gap_before": 1.28,
   "block": "personal_finance.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then be careful. A common rule is to only lend what you could afford to give away.",
   "est_sec": 5.37,
   "gap_before": 0.74,
   "role": "reply",
   "block": "personal_finance.dlg19"
  },
  {
   "speaker": "user",
   "text": "But she's my best friend.",
   "est_sec": 1.65,
   "gap_before": 0.84,
   "block": "personal_finance.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's exactly why it's risky. Money problems can strain even close friendships.",
   "est_sec": 3.82,
   "gap_before": 1.54,
   "role": "reply",
   "block": "personal_finance.dlg19"
  },
  {
   "speaker": "user",
   "text": "Maybe I could",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg19"
  },
  {
   "speaker": "user",
   "text": "lend her a smaller amount?",
   "est_sec": 1.65,
   "gap_before": 2.14,
   "block": "personal_finance.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a kind middle ground. Lend only what you're comfortable losing, and agree clearly on when she'll pay it back.",
   "est_sec": 6.3,
   "gap_before": 1.15,
   "role": "reply",
   "block": "personal_finance.dlg19"
