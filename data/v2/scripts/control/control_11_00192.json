 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.71,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.42,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "I'm a chef and they want me to do a trial shift instead of a normal interview. What should I expect?",
   "est_sec": 6.61,
   "gap_before": 0.53,
   "block": "job_interview.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Usually a few hours in the kitchen, working a section or cooking a dish for the head chef. They're watching how you work as much as the food.",
   "est_sec": 8.78,
   "gap_before": 1.72,
   "role": "reply",
   "block": "job_interview.dlg21"
  },
  {
   "speaker": "user",
   "text": "Okay Moshi, how I work, like speed?",
   "est_sec": 2.27,
   "gap_before": 0.51,
   "block": "job_interview.dlg21",
   "kind": "moshi_name",
   "name_pos": "start",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Speed, cleanliness, how you take instructions, and how you get on with the team under pressure.",
   "est_sec": 5.06,
   "gap_before": 1.18,
   "role": "reply",
   "block": "job_interview.dlg21"
  },
  {
   "speaker": "user",
   "text": "Should I bring my own knives?",
   "est_sec": 1.96,
   "gap_before": 1.02,
   "block": "job_interview.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, and your whites if you have them. Ask beforehand, but most chefs expect you to bring your own kit.",
   "est_sec": 6.3,
   "gap_before": 1.13,
   "role": "reply",
   "block": "job_interview.dlg21"
  },
  {
   "speaker": "user",
   "text": "I always get flustered",
   "est_sec": 1.34,
   "gap_before": 0.34,
   "event": "distractor",
   "kind": "pause",
   "block": "job_interview.dlg21"
  },
  {
