 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.64,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "I'm interviewing people for the spare room in my flat. What should I ask them?",
   "est_sec": 4.75,
   "gap_before": 0.31,
   "block": "moving_house.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ask about their routine, like when they work and when they go to bed. Clashing schedules cause a lot of friction.",
   "est_sec": 6.61,
   "gap_before": 0.51,
   "role": "reply",
   "block": "moving_house.dlg9"
  },
  {
   "speaker": "user",
   "text": "Good one.",
   "est_sec": 0.72,
   "gap_before": 1.57,
   "block": "moving_house.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ask how they feel about guests, cleaning and shared food. And how they handled problems with past flatmates.",
   "est_sec": 5.68,
   "gap_before": 0.55,
   "role": "reply",
   "block": "moving_house.dlg9"
  },
  {
   "speaker": "user",
   "text": "Should I ask about money?",
   "est_sec": 1.65,
   "gap_before": 0.83,
   "block": "moving_house.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, gently. Ask if they're comfortable with the rent and bills, and whether they'd do a reference check.",
   "est_sec": 5.68,
   "gap_before": 0.68,
   "role": "reply",
   "block": "moving_house.dlg9"
  },
  {
   "speaker": "user",
   "text": "And how",
   "est_sec": 0.72,
   "gap_before": 0.37,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg9"
  },
  {
   "speaker": "user",
   "text": "do I know if I actually like them?",
   "est_sec": 2.58,
   "gap_before": 2.24,
   "block": "moving_house.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Trust your gut. Could you happily share a kitchen with them on a Sunday morning? That's usually the real test.",
   "est_sec": 6.3,
   "gap_before": 0.34,
   "role": "reply",
   "block": "moving_house.dlg9"
  }
 ]
}
