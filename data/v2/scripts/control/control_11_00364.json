 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.38,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.81,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "My partner and I want to rent a campervan for a week in the mountains. Is that a silly idea if we've never driven one?",
   "est_sec": 7.85,
   "gap_before": 0.28,
   "block": "cars.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not silly at all, lots of people do it. Smaller vans drive a lot like a big car. The main things are the height and the width.",
   "est_sec": 8.47,
   "gap_before": 0.66,
   "role": "reply",
   "block": "cars.dlg24"
  },
  {
   "speaker": "user",
   "text": "Height, like bridges?",
   "est_sec": 1.03,
   "gap_before": 0.59,
   "block": "cars.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Bridges, car parks, drive throughs, low branches. Write the height on a sticky note on the dashboard so you don't forget.",
   "est_sec": 6.61,
   "gap_before": 0.6,
   "role": "reply",
   "block": "cars.dlg24"
  },
  {
   "speaker": "user",
   "text": "Ha, okay. What about mountain roads?",
   "est_sec": 1.96,
   "gap_before": 1.04,
   "block": "cars.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Use lower gears going downhill so you don't overheat the brakes, and pull into passing places to let faster cars by.",
   "est_sec": 6.61,
   "gap_before": 1.99,
   "role": "reply",
   "block": "cars.dlg24"
  },
  {
   "speaker": "user",
   "text": "Is it cheaper than",
   "est_sec": 1.34,
   "gap_before": 1.29,
   "event": "distractor",
   "kind": "pause",
   "block": "cars.dlg24"
  },
  {
   "speaker": "user",
   "text": "hotels, though?",
   "est_sec": 0.72,
   "gap_before": 2.88,
   "block": "cars.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It can be, but add up rental, fuel and campsite fees. It's often about the same, you're really paying for the freedom.",
   "est_sec": 6.92,
   "gap_before": 0.71,
   "role": "reply",
   "block": "cars.dlg24"
  }
 ]
}
