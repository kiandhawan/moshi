 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.74,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "Is it actually dangerous to leave cooked rice out overnight? My flatmate does it all the time.",
   "est_sec": 5.37,
   "gap_before": 0.52,
   "block": "cooking.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It can be. Rice can carry bacteria spores that survive cooking and multiply at room temperature.",
   "est_sec": 5.06,
   "gap_before": 0.95,
   "role": "reply",
   "block": "cooking.dlg13"
  },
  {
   "speaker": "user",
   "text": "Can you pick up some bread on the way home, Jason?",
   "est_sec": 3.51,
   "gap_before": 1.63,
   "block": "nq_social_065",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_065",
   "name_pos": "end",
   "addressee": "Jason"
  },
  {
   "speaker": "user",
   "text": "But he's never been sick.",
   "est_sec": 1.65,
   "gap_before": 2.04,
   "block": "cooking.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Lots of people get lucky. It's still better to cool rice within an hour and put it in the fridge.",
   "est_sec": 6.3,
   "gap_before": 0.37,
   "role": "reply",
   "block": "cooking.dlg13"
  },
  {
   "speaker": "user",
   "text": "How do you cool it that fast?",
   "est_sec": 2.27,
   "gap_before": 0.31,
   "block": "cooking.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Spread it out on a plate or tray. It cools much quicker than in a deep pot.",
   "est_sec": 5.37,
   "gap_before": 1.13,
   "role": "reply",
   "block": "cooking.dlg13"
  },
  {
   "speaker": "user",
   "text": "And reheating, is once enough",
   "est_sec": 1.65,
   "gap_before": 0.39,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg13"
  },
  {
   "speaker": "user",
   "text": "or can you do it again?",
   "est_sec": 1.96,
   "gap_before": 2.38,
   "block": "cooking.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Just once, and make sure it's steaming hot all the way through.",
   "est_sec": 3.82,
   "gap_before": 0.78,
   "role": "reply",
   "block": "cooking.dlg13"
  }
 ]
}
