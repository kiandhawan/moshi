 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.55,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.56,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "The movers said I have to wait before switching my fridge back on. Is that true?",
   "est_sec": 5.06,
   "gap_before": 0.49,
   "block": "moving_house.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's good advice. If a fridge has been tipped or laid down, the oil in the compressor needs time to settle back.",
   "est_sec": 6.92,
   "gap_before": 0.64,
   "role": "reply",
   "block": "moving_house.dlg28"
  },
  {
   "speaker": "user",
   "text": "How long?",
   "est_sec": 0.72,
   "gap_before": 1.43,
   "block": "moving_house.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Usually a few hours, often the same amount of time it was on its side. Check the manual to be sure.",
   "est_sec": 6.61,
   "gap_before": 0.66,
   "role": "reply",
   "block": "moving_house.dlg28"
  },
  {
   "speaker": "user",
   "text": "Even if it travelled",
   "est_sec": 1.34,
   "gap_before": 1.44,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg28"
  },
  {
   "speaker": "user",
   "text": "standing up?",
   "est_sec": 0.72,
   "gap_before": 2.19,
   "block": "moving_house.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then you can usually switch it on sooner, maybe after an hour. Just give it a bit of time to cool down before you put food in.",
   "est_sec": 8.47,
   "gap_before": 0.97,
   "role": "reply",
   "block": "moving_house.dlg28"
  },
  {
   "speaker": "user",
   "text": "So I need a cool box for the first day.",
   "est_sec": 3.2,
   "gap_before": 0.75,
   "block": "moving_house.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Pack the cold food with some ice packs and you'll be fine.",
   "est_sec": 4.13,
   "gap_before": 1.46,
   "role": "reply",
   "block": "moving_house.dlg28"
  }
 ]
}
