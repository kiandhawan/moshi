 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.69,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "How do I take nice photos of my food at restaurants without being that annoying person?",
   "est_sec": 5.06,
   "gap_before": 0.55,
   "block": "photography.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Keep it quick and quiet. Flash off, no standing on chairs, and one or two shots before you start eating.",
   "est_sec": 6.3,
   "gap_before": 0.74,
   "role": "reply",
   "block": "photography.dlg22"
  },
  {
   "speaker": "user",
   "text": "Right, but the lighting in restaurants is always awful.",
   "est_sec": 2.89,
   "gap_before": 1.82,
   "block": "photography.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ask for a table by the window when you book. Daylight from the side makes food look amazing.",
   "est_sec": 5.68,
   "gap_before": 1.03,
   "role": "reply",
   "block": "photography.dlg22"
  },
  {
   "speaker": "user",
   "text": "Huh, never thought of booking for the light.",
   "est_sec": 2.58,
   "gap_before": 0.46,
   "block": "photography.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then shoot from above for flat dishes like pizza, and at a low angle for tall things like burgers or layered cakes.",
   "est_sec": 6.92,
   "gap_before": 0.59,
   "role": "reply",
   "block": "photography.dlg22"
  },
  {
   "speaker": "user",
   "text": "Do I",
   "est_sec": 0.72,
   "gap_before": 1.18,
   "event": "distractor",
   "kind": "pause",
   "block": "photography.dlg22"
  },
  {
   "speaker": "user",
   "text": "use the zoom?",
   "est_sec": 1.03,
   "gap_before": 2.79,
   "block": "photography.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Better to move the phone a bit closer than zoom in. And wipe the lens with a napkin first, it's often greasy from your fingers.",
   "est_sec": 7.85,
   "gap_before": 0.79,
   "role": "reply",
   "block": "photography.dlg22"
  }
 ]
}
