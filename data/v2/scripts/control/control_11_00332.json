 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.44,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.81,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "Recipe says two tablespoons of fresh thyme. I only have dried, Moshi.",
   "est_sec": 3.82,
   "gap_before": 0.36,
   "block": "cooking.dlg17",
   "kind": "moshi_name",
   "name_pos": "end",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Use about a third as much dried, so roughly two teaspoons.",
   "est_sec": 3.51,
   "gap_before": 0.66,
   "role": "reply",
   "block": "cooking.dlg17"
  },
  {
   "speaker": "user",
   "text": "Why less?",
   "est_sec": 0.72,
   "gap_before": 1.04,
   "block": "cooking.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Dried herbs are more concentrated because the water's gone.",
   "est_sec": 2.89,
   "gap_before": 0.35,
   "role": "reply",
   "block": "cooking.dlg17"
  },
  {
   "speaker": "user",
   "text": "Does that work for all herbs?",
   "est_sec": 1.96,
   "gap_before": 0.75,
   "block": "cooking.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "For woody ones like thyme, rosemary and oregano, yes. Soft herbs like basil or coriander lose a lot when dried, so they're not a great swap.",
   "est_sec": 8.16,
   "gap_before": 0.47,
   "role": "reply",
   "block": "cooking.dlg17"
  },
  {
   "speaker": "user",
   "text": "Good to know. When do I add it, at the start",
   "est_sec": 3.51,
   "gap_before": 1.41,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg17"
  },
  {
   "speaker": "user",
   "text": "or the end?",
   "est_sec": 1.03,
   "gap_before": 2.6,
   "block": "cooking.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Dried herbs go in early so they have time to soften. Fresh soft herbs go in at the very end.",
   "est_sec": 6.3,
   "gap_before": 0.85,
   "role": "reply",
   "block": "cooking.dlg17"
  }
 ]
}
