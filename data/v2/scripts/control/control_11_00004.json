 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.32,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.98,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "Our hamster escaped last night. The cage door was open. Help.",
   "est_sec": 3.51,
   "gap_before": 0.51,
   "block": "pets.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Don't worry, they're usually still in the house. Close doors to keep him in one area and check behind sofas and under the fridge.",
   "est_sec": 7.54,
   "gap_before": 0.64,
   "role": "reply",
   "block": "pets.dlg31"
  },
  {
   "speaker": "user",
   "text": "I've looked everywhere.",
   "est_sec": 1.03,
   "gap_before": 2.02,
   "block": "pets.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Hamsters come out at night. Put small piles of food in a few rooms and see which one gets eaten.",
   "est_sec": 6.3,
   "gap_before": 0.93,
   "role": "reply",
   "block": "pets.dlg31"
  },
  {
   "speaker": "user",
   "text": "That's clever.",
   "est_sec": 0.72,
   "gap_before": 1.18,
   "block": "pets.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can also put a bit of flour around the food, so you'll see little footprints showing where he's going.",
   "est_sec": 6.3,
   "gap_before": 0.63,
   "role": "reply",
   "block": "pets.dlg31"
  },
  {
   "speaker": "user",
   "text": "And then how do I catch him?",
   "est_sec": 2.27,
   "gap_before": 1.57,
   "block": "pets.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Put a deep bucket with some bedding and a treat at the bottom, with a ramp up to it. He'll climb in and can't get back out.",
   "est_sec": 8.47,
   "gap_before": 0.81,
   "role": "reply",
   "block": "pets.dlg31"
  }
 ]
}
