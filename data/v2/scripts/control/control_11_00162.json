 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.52,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "I've just retired and I'd love to see the country by train. Where would you even start?",
   "est_sec": 5.37,
   "gap_before": 0.38,
   "block": "public_transport.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "What a lovely plan. Scenic routes through mountains or along the coast are a good place to begin.",
   "est_sec": 5.68,
   "gap_before": 1.19,
   "role": "reply",
   "block": "public_transport.dlg23"
  },
  {
   "speaker": "user",
   "text": "Okay Moshi, I'm not in a hurry at all.",
   "est_sec": 2.89,
   "gap_before": 0.73,
   "block": "public_transport.dlg23",
   "kind": "moshi_name",
   "name_pos": "start",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then slow regional lines are your friend. They stop in small towns, and you can break the journey wherever you like.",
   "est_sec": 6.61,
   "gap_before": 0.45,
   "role": "reply",
   "block": "public_transport.dlg23"
  },
  {
   "speaker": "user",
   "text": "My wife likes",
   "est_sec": 1.03,
   "gap_before": 3.26,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg23"
  },
  {
   "speaker": "user",
   "text": "comfort, though. She won't rough it.",
   "est_sec": 1.96,
   "gap_before": 1.68,
   "block": "public_transport.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then mix it up. Take the slow scenic line by day, and book a nice hotel each evening. Some countries even have rail passes for older travellers.",
   "est_sec": 8.47,
   "gap_before": 0.81,
   "role": "reply",
   "block": "public_transport.dlg23"
  },
  {
   "speaker": "user",
   "text": "Wait, are you sure about that?",
   "est_sec": 1.96,
   "gap_before": 2.11,
   "block": "public_transport.dlg23",
   "kind": "wait_like",
   "phrasing": "waitlike_08",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "I'm fairly sure about it, but I could be wrong. What sounds off to you?",
   "est_sec": 4.75,
   "gap_before": 0.83,
   "role": "reply",
   "block": "public_transport.dlg23"
  },
  {
   "speaker": "user",
   "text": "A pass sounds useful.",
   "est_sec": 1.34,
   "gap_before": 2.47,
   "block": "public_transport.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It can be great value if you're taking lots of trains in a few weeks. Shall I explain how they usually work?",
   "est_sec": 6.92,
   "gap_before": 0.85,
   "role": "reply",
   "block": "public_transport.dlg23"
  },
  {
   "speaker": "user",
   "text": "Yes please, another time.",
   "est_sec": 1.34,
   "gap_before": 1.39,
   "block": "public_transport.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Of course. Enjoy planning it.",
   "est_sec": 1.65,
   "gap_before": 0.52,
   "role": "reply",
   "block": "public_transport.dlg23"
  }
 ]
}
