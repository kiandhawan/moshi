 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.56,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.67,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "Do air fryers really cook chips as well as a deep fryer?",
   "est_sec": 3.82,
   "gap_before": 0.33,
   "block": "cooking.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not quite as crispy, but close, and with way less oil. Most people are happy with them.",
   "est_sec": 5.37,
   "gap_before": 1.09,
   "role": "reply",
   "block": "cooking.dlg19"
  },
  {
   "speaker": "user",
   "text": "What's the trick for fresh potatoes?",
   "est_sec": 1.96,
   "gap_before": 0.63,
   "block": "cooking.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Cut them evenly, soak them in cold water for half an hour, then dry them really well before tossing with a spoon of oil.",
   "est_sec": 7.54,
   "gap_before": 1.07,
   "role": "reply",
   "block": "cooking.dlg19"
  },
  {
   "speaker": "user",
   "text": "Why soak them?",
   "est_sec": 1.03,
   "gap_before": 1.16,
   "block": "cooking.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It washes off surface starch, so they crisp instead of going gummy.",
   "est_sec": 3.82,
   "gap_before": 0.91,
   "role": "reply",
   "block": "cooking.dlg19"
  },
  {
   "speaker": "user",
   "text": "Right. And how long",
   "est_sec": 1.34,
   "gap_before": 2.39,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg19"
  },
  {
   "speaker": "user",
   "text": "do they need in there?",
   "est_sec": 1.65,
   "gap_before": 2.48,
   "block": "cooking.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "About twenty minutes at a high setting, shaking the basket halfway through. Don't overfill it or they'll steam.",
   "est_sec": 5.68,
   "gap_before": 0.51,
   "role": "reply",
   "block": "cooking.dlg19"
  }
 ]
}
