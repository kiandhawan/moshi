 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.98,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "So I'm thirty one and moving back in with my parents to save for a house. Mixed feelings.",
   "est_sec": 5.68,
   "gap_before": 0.27,
   "block": "moving_house.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a really common and sensible move these days, even if it feels strange.",
   "est_sec": 4.44,
   "gap_before": 0.63,
   "role": "reply",
   "block": "moving_house.dlg15"
  },
  {
   "speaker": "user",
   "text": "I'm worried we'll drive each other mad.",
   "est_sec": 2.27,
   "gap_before": 1.25,
   "block": "moving_house.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Talk about expectations early. Things like chores, guests, cooking and whether they'll wait up for you.",
   "est_sec": 5.06,
   "gap_before": 0.41,
   "role": "reply",
   "block": "moving_house.dlg15"
  },
  {
   "speaker": "user",
   "text": "Ha, my mum will absolutely wait up.",
   "est_sec": 2.27,
   "gap_before": 0.77,
   "block": "moving_house.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then agree on something like a text if you're late. It's much easier to set the rules at the start than mid argument.",
   "est_sec": 7.23,
   "gap_before": 1.12,
   "role": "reply",
   "block": "moving_house.dlg15"
  },
  {
   "speaker": "user",
   "text": "Should I pay",
   "est_sec": 1.03,
   "gap_before": 0.7,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg15"
  },
  {
   "speaker": "user",
   "text": "rent or something?",
   "est_sec": 1.03,
   "gap_before": 2.19,
   "block": "moving_house.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Offering some money or covering the food shop shows respect, even if it's less than market rent. It also keeps you feeling like an adult.",
   "est_sec": 7.85,
   "gap_before": 0.84,
   "role": "reply",
   "block": "moving_house.dlg15"
  }
 ]
