 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.36,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.96,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "Hosting a dinner party for six on Saturday and I'm already stressing.",
   "est_sec": 3.82,
   "gap_before": 0.58,
   "block": "weekend_plans.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Keep the menu simple. One dish that cooks itself, like a slow roast or a big stew, while you're with guests.",
   "est_sec": 6.61,
   "gap_before": 0.39,
   "role": "reply",
   "block": "weekend_plans.dlg23"
  },
  {
   "speaker": "user",
   "text": "And a starter?",
   "est_sec": 1.03,
   "gap_before": 2.13,
   "block": "weekend_plans.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Skip anything that needs cooking. A nice bread, some dips or a salad you can make in advance.",
   "est_sec": 5.68,
   "gap_before": 0.53,
   "role": "reply",
   "block": "weekend_plans.dlg23"
  },
  {
   "speaker": "user",
   "text": "The car's making that noise again. Harper, did you book the garage?",
   "est_sec": 3.82,
   "gap_before": 0.43,
   "block": "nq_work_018",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_work_018",
   "name_pos": "middle",
   "addressee": "Harper"
  },
  {
   "speaker": "user",
   "text": "Dessert I'm thinking of buying.",
   "est_sec": 1.65,
   "gap_before": 2.99,
   "block": "weekend_plans.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Absolutely fine. A good shop bought tart with some cream is perfect.",
   "est_sec": 3.82,
   "gap_before": 0.72,
   "role": "reply",
   "block": "weekend_plans.dlg23"
  },
  {
   "speaker": "user",
   "text": "What about",
