   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.7,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "My lower back aches when I wake up. Could it be how I'm sleeping?",
   "est_sec": 4.44,
   "gap_before": 0.47,
   "block": "sleep.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Quite possibly. Do you sleep on your back, side, or stomach?",
