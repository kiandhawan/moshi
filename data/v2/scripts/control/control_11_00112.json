   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "So Moshi, I'm interviewing for a team lead job and the panel includes two of my current colleagues. That's so awkward.",
   "est_sec": 6.61,
   "gap_before": 0.49,
   "block": "job_interview.dlg10",
