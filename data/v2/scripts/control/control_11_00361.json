 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.79,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.34,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "I just found a flea on my cat. Do I need to panic?",
   "est_sec": 4.13,
   "gap_before": 0.47,
   "block": "pets.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "No panic needed, but it's worth acting now. Where there's one flea there are usually more.",
   "est_sec": 5.06,
   "gap_before": 0.9,
   "role": "reply",
   "block": "pets.dlg12"
  },
  {
   "speaker": "user",
   "text": "Gross. What do I do?",
   "est_sec": 1.65,
   "gap_before": 1.24,
   "block": "pets.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Get a vet recommended spot on treatment for cats. Never use a dog one, some of them are really toxic to cats.",
   "est_sec": 6.92,
   "gap_before": 0.91,
   "role": "reply",
   "block": "pets.dlg12"
  },
  {
   "speaker": "user",
   "text": "Oh wow, I didn't know that.",
   "est_sec": 1.96,
   "gap_before": 1.1,
   "block": "pets.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's an important one. Treat every pet in the house, not just her.",
   "est_sec": 4.13,
   "gap_before": 0.86,
   "role": "reply",
   "block": "pets.dlg12"
  },
  {
   "speaker": "user",
   "text": "And the house itself?",
   "est_sec": 1.34,
   "gap_before": 1.09,
   "event": "distractor",
   "kind": "pause",
   "block": "pets.dlg12"
  },
  {
   "speaker": "user",
   "text": "Do I have to burn the sofa?",
   "est_sec": 2.27,
   "gap_before": 1.99,
   "block": "pets.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "No burning required. Vacuum everything thoroughly for a few weeks, wash her bedding hot, and empty the vacuum bag outside each time.",
   "est_sec": 6.92,
   "gap_before": 0.83,
   "role": "reply",
   "block": "pets.dlg12"
  }
 ]
