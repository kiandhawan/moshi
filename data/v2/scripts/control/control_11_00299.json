 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.4,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.76,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "How do I work out how long a hike will take?",
   "est_sec": 3.51,
   "gap_before": 0.32,
   "block": "hiking.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A rough rule is about three miles an hour on flat ground, plus an extra half hour for every thousand feet you climb.",
   "est_sec": 7.23,
   "gap_before": 1.07,
   "role": "reply",
   "block": "hiking.dlg26"
  },
  {
   "speaker": "user",
   "text": "So ten miles with two thousand feet of climbing would take how long?",
   "est_sec": 4.13,
   "gap_before": 0.54,
   "block": "hiking.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Around three and a half hours of walking, then add time for breaks. I'd plan for four and a half to five.",
   "est_sec": 6.92,
   "gap_before": 1.63,
   "role": "reply",
   "block": "hiking.dlg26"
  },
  {
   "speaker": "user",
   "text": "That seems long.",
   "est_sec": 1.03,
   "gap_before": 1.04,
   "block": "hiking.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Breaks, photos and lunch add up fast. It's much nicer to finish early than to rush down in the dark.",
   "est_sec": 6.3,
   "gap_before": 1.18,
   "role": "reply",
   "block": "hiking.dlg26"
  },
  {
   "speaker": "user",
   "text": "True. Last time I",
   "est_sec": 1.34,
   "gap_before": 0.9,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg26"
  },
  {
   "speaker": "user",
   "text": "got back as the sun went down and it was stressful.",
   "est_sec": 3.51,
   "gap_before": 2.4,
   "block": "hiking.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's exactly why. And add a bit extra in winter, when daylight is short.",
   "est_sec": 4.44,
   "gap_before": 1.03,
   "role": "reply",
   "block": "hiking.dlg26"
  }
 ]
}
