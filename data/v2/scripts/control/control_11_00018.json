 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.74,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.7,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "I've got an hour on the train each way. I want to stop just scrolling and actually learn something.",
   "est_sec": 5.99,
   "gap_before": 0.3,
   "block": "public_transport.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Great use of the time. A language app works well in short bursts, and you can do listening exercises with headphones.",
   "est_sec": 6.61,
   "gap_before": 0.82,
   "role": "reply",
   "block": "public_transport.dlg13"
  },
  {
   "speaker": "user",
   "text": "I've tried apps. I get bored after a week.",
   "est_sec": 2.89,
   "gap_before": 0.54,
   "block": "public_transport.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then maybe pick something with a story. A course built around a podcast, or reading a novel in the language with a translation beside it.",
   "est_sec": 7.85,
   "gap_before": 0.99,
   "role": "reply",
   "block": "public_transport.dlg13"
  },
  {
   "speaker": "user",
   "text": "I do like",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg13"
  },
  {
   "speaker": "user",
   "text": "mystery novels.",
   "est_sec": 0.72,
   "gap_before": 2.37,
   "block": "public_transport.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Perfect. Easy mysteries written for learners exist in lots of languages. Each chapter fits nicely into a ride.",
   "est_sec": 5.68,
   "gap_before": 0.9,
   "role": "reply",
   "block": "public_transport.dlg13"
  },
  {
   "speaker": "user",
   "text": "And on the way home when I'm tired?",
   "est_sec": 2.58,
   "gap_before": 0.85,
   "block": "public_transport.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Make the evening ride lighter, just listening. Mornings for effort, evenings for review.",
   "est_sec": 4.13,
   "gap_before": 1.45,
   "role": "reply",
   "block": "public_transport.dlg13"
  }
 ]
