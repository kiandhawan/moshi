 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.58,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.36,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "I'm terrified of plagiarism. How do I use sources in my essay without getting in trouble?",
   "est_sec": 5.06,
   "gap_before": 0.3,
   "block": "studying.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good that you're thinking about it. The key rule is, whenever you use someone else's words or ideas, you say where they came from.",
   "est_sec": 7.54,
   "gap_before": 0.79,
   "role": "reply",
   "block": "studying.dlg23"
  },
  {
   "speaker": "user",
   "text": "Even if I put it in my own words?",
   "est_sec": 2.89,
   "gap_before": 0.81,
   "block": "studying.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes. Paraphrasing still needs a reference, because the idea is still theirs.",
   "est_sec": 3.82,
   "gap_before": 1.15,
   "role": "reply",
   "block": "studying.dlg23"
  },
  {
   "speaker": "user",
   "text": "And quotes?",
   "est_sec": 0.72,
   "gap_before": 0.68,
   "block": "studying.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Use quotation marks around the exact words, and reference them too. Most universities have a style guide that shows the format.",
   "est_sec": 6.61,
   "gap_before": 0.39,
   "role": "reply",
   "block": "studying.dlg23"
  },
  {
   "speaker": "user",
   "text": "There's software that checks, right?",
   "est_sec": 1.65,
   "gap_before": 1.41,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg23"
  },
  {
   "speaker": "user",
   "text": "What if it flags me by accident?",
   "est_sec": 2.27,
   "gap_before": 1.85,
   "block": "studying.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It flags matching text, but a properly referenced quote is fine. Teachers look at the context, not just the number.",
   "est_sec": 6.3,
   "gap_before": 0.75,
   "role": "reply",
   "block": "studying.dlg23"
  }
 ]
