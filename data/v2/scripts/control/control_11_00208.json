 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.74,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.49,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "My wife's birthday is Sunday and I've got nothing planned. I'm panicking a little.",
   "est_sec": 4.44,
   "gap_before": 0.45,
   "block": "birthday_party.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Don't worry, there's still time. What does she love doing on a free day?",
   "est_sec": 4.44,
   "gap_before": 0.49,
   "role": "reply",
   "block": "birthday_party.dlg2"
  },
  {
   "speaker": "user",
   "text": "She loves brunch, and anything near the water.",
   "est_sec": 2.58,
   "gap_before": 0.69,
   "block": "birthday_party.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then book a brunch spot with a view, and plan a walk along the water afterwards. Simple but thoughtful.",
   "est_sec": 5.99,
   "gap_before": 0.53,
   "role": "reply",
   "block": "birthday_party.dlg2"
  },
  {
   "speaker": "user",
   "text": "Should I invite her friends or",
   "est_sec": 1.96,
   "gap_before": 1.11,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg2"
  },
  {
   "speaker": "user",
   "text": "keep it just the two of us?",
   "est_sec": 2.27,
   "gap_before": 2.11,
   "block": "birthday_party.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You could do both. Brunch for two, then a small get together with friends in the evening.",
   "est_sec": 5.37,
   "gap_before": 0.99,
   "role": "reply",
   "block": "birthday_party.dlg2"
  },
  {
   "speaker": "user",
   "text": "I like that. What about a gift?",
   "est_sec": 2.27,
   "gap_before": 1.45,
   "block": "birthday_party.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
