 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.62,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.98,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "I'm planning a surprise party for my husband but he's getting suspicious. How do I keep it secret?",
   "est_sec": 5.68,
   "gap_before": 0.45,
   "block": "birthday_party.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "The trick is a believable cover story. What does he think is happening that evening?",
   "est_sec": 4.75,
   "gap_before": 1.82,
   "role": "reply",
   "block": "birthday_party.dlg31"
  },
  {
   "speaker": "user",
   "text": "Nothing yet. That's the problem. He keeps asking why I'm on my phone so much.",
   "est_sec": 4.75,
   "gap_before": 0.46,
   "block": "birthday_party.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Give him a boring explanation, like you're organising a gift with your sister. Half the truth is easier to keep straight.",
   "est_sec": 6.61,
   "gap_before": 1.12,
   "role": "reply",
   "block": "birthday_party.dlg31"
  },
  {
   "speaker": "user",
   "text": "Roman, did you see who got voted off last night?",
   "est_sec": 3.2,
   "gap_before": 1.37,
   "block": "nq_social_001",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_001",
   "name_pos": "start",
   "addressee": "Roman"
  },
  {
   "speaker": "other",
   "text": "Yeah, the baker. I was gutted.",
   "est_sec": 1.96,
   "gap_before": 0.87,
   "block": "nq_social_001"
  },
  {
   "speaker": "user",
   "text": "And for the night itself?",
   "est_sec": 1.65,
   "gap_before": 1.87,
   "block": "birthday_party.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Plan a simple dinner for two as the reason to go out, then have a friend call with a small emergency that brings you to the party venue.",
   "est_sec": 8.78,
   "gap_before": 0.99,
   "role": "reply",
   "block": "birthday_party.dlg31"
  },
  {
   "speaker": "user",
   "text": "That feels very spy film.",
   "est_sec": 1.65,
   "gap_before": 1.26,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg31"
  },
  {
   "speaker": "user",
   "text": "I'm terrible at lying.",
   "est_sec": 1.34,
   "gap_before": 2.28,
   "block": "birthday_party.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then say as little as possible. Short answers, change the subject, and let your friend do the acting.",
   "est_sec": 5.68,
   "gap_before": 0.82,
   "role": "reply",
   "block": "birthday_party.dlg31"
  }
 ]
