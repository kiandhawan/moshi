 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.48,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.6,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "All my photos look hazy lately. Like there's fog on everything.",
   "est_sec": 3.51,
   "gap_before": 0.24,
   "block": "smartphones.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "First thing to try sounds silly, but wipe the camera lens. Pocket grease is the most common cause.",
   "est_sec": 5.68,
   "gap_before": 1.49,
   "role": "reply",
   "block": "smartphones.dlg12"
  },
  {
   "speaker": "user",
   "text": "Oh. Wow. That's way better.",
   "est_sec": 1.65,
   "gap_before": 1.26,
   "block": "smartphones.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It happens to everyone. A soft cloth, your shirt in a pinch, but not paper towels, they can scratch.",
   "est_sec": 5.99,
   "gap_before": 0.31,
   "role": "reply",
   "block": "smartphones.dlg12"
  },
  {
   "speaker": "user",
   "text": "Is there anything else I should do",
   "est_sec": 2.27,
   "gap_before": 0.38,
   "event": "distractor",
   "kind": "pause",
   "block": "smartphones.dlg12"
  },
  {
   "speaker": "user",
   "text": "for sharper shots?",
   "est_sec": 1.03,
   "gap_before": 2.34,
   "block": "smartphones.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Tap on your subject before taking the photo so it focuses there, and hold still for a second after you press the button.",
   "est_sec": 7.23,
   "gap_before": 1.01,
   "role": "reply",
   "block": "smartphones.dlg12"
  },
  {
   "speaker": "user",
   "text": "Okay. I've been snapping and moving immediately.",
   "est_sec": 2.27,
   "gap_before": 0.88,
   "block": "smartphones.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most phones keep processing the image for a moment, so that little pause really helps.",
   "est_sec": 4.75,
   "gap_before": 0.81,
   "role": "reply",
   "block": "smartphones.dlg12"
  }
