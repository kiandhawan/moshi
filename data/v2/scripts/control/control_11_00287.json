 "est_speech_sec": 41.09,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.48,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.78,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "There's a rattle somewhere in my dashboard and it's driving me up the wall.",
   "est_sec": 4.44,
   "gap_before": 0.57,
   "block": "cars.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Rattles are maddening. Does it happen all the time, or only on bumpy roads or at certain speeds?",
   "est_sec": 5.68,
   "gap_before": 0.65,
   "role": "reply",
   "block": "cars.dlg31"
  },
  {
   "speaker": "user",
   "text": "Bumpy roads. And when it's cold.",
   "est_sec": 1.96,
   "gap_before": 0.97,
   "block": "cars.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Cold makes plastic shrink a little, so panels can rub. First check the simple stuff, the glovebox, the door pockets, sunglasses holder, loose coins.",
   "est_sec": 7.54,
   "gap_before": 1.03,
   "role": "reply",
   "block": "cars.dlg31"
  },
  {
   "speaker": "user",
   "text": "I already emptied the glovebox. Still rattles.",
   "est_sec": 2.27,
   "gap_before": 3.16,
   "block": "cars.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then try pressing on different parts of the dashboard while someone else drives over a bumpy patch. When the noise stops, you've found it.",
   "est_sec": 7.54,
   "gap_before": 1.24,
   "role": "reply",
   "block": "cars.dlg31"
  },
  {
   "speaker": "user",
   "text": "Then what,",
   "est_sec": 0.72,
   "gap_before": 2.35,
   "event": "distractor",
   "kind": "pause",
   "block": "cars.dlg31"
  },
  {
   "speaker": "user",
   "text": "glue it?",
   "est_sec": 0.72,
   "gap_before": 1.53,
   "block": "cars.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Usually a bit of felt tape or foam pushed into the gap does the trick. No glue needed, and it's easy to undo later.",
   "est_sec": 7.54,
   "gap_before": 0.98,
   "role": "reply",
   "block": "cars.dlg31"
  }
 ]
}
