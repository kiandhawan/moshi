 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.31,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "Hi, my washing machine shakes like crazy on the spin cycle, Moshi.",
   "est_sec": 3.82,
   "gap_before": 0.4,
   "block": "home_repair.dlg8",
   "kind": "moshi_name",
   "name_pos": "end",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's usually the machine not being level, or the load being unbalanced. Is it a big load?",
   "est_sec": 5.37,
   "gap_before": 0.99,
   "role": "reply",
   "block": "home_repair.dlg8"
  },
  {
   "speaker": "user",
   "text": "It does it even with just a few towels.",
   "est_sec": 2.89,
   "gap_before": 0.37,
   "block": "home_repair.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then check the feet. Put a level on top, and twist the feet up or down until it sits flat and doesn't rock.",
   "est_sec": 7.23,
   "gap_before": 0.58,
   "role": "reply",
   "block": "home_repair.dlg8"
  },
  {
   "speaker": "user",
   "text": "I don't have a level.",
   "est_sec": 1.65,
   "gap_before": 1.18,
   "block": "home_repair.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "There's probably a level app on your phone. Or put a glass of water on top and see if it looks even.",
   "est_sec": 6.92,
   "gap_before": 1.12,
   "role": "reply",
   "block": "home_repair.dlg8"
  },
  {
   "speaker": "user",
   "text": "Also, I moved house last month. Could that matter?",
   "est_sec": 2.89,
   "gap_before": 1.12,
   "block": "home_repair.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, actually. Check the back for transit bolts. If they weren't removed after the move, it'll shake terribly.",
   "est_sec": 5.68,
   "gap_before": 0.7,
   "role": "reply",
   "block": "home_repair.dlg8"
  }
 ]
}
