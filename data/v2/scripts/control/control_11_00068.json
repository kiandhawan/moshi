 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.62,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.96,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "I'm in Vienna for work and have Saturday to myself. I've never travelled alone.",
   "est_sec": 4.44,
   "gap_before": 0.24,
   "block": "weekend_plans.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a great chance. Start with a walking tour in the morning, it's a nice way to get your bearings.",
   "est_sec": 6.3,
   "gap_before": 1.13,
   "role": "reply",
   "block": "weekend_plans.dlg16"
  },
  {
   "speaker": "user",
   "text": "Eating alone in restaurants feels awkward.",
   "est_sec": 1.96,
   "gap_before": 3.5,
   "block": "weekend_plans.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Lunch alone is often easier than dinner. Sit at a counter or by a window, and take a book.",
   "est_sec": 5.99,
   "gap_before": 0.71,
   "role": "reply",
   "block": "weekend_plans.dlg16"
  },
  {
   "speaker": "user",
   "text": "Oh, I like the book idea.",
   "est_sec": 1.96,
   "gap_before": 0.67,
   "block": "weekend_plans.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Cafes in Vienna are perfect for that. People sit for hours with a coffee and a cake.",
   "est_sec": 5.37,
   "gap_before": 1.65,
   "role": "reply",
   "block": "weekend_plans.dlg16"
  },
  {
   "speaker": "user",
   "text": "Any museum",
   "est_sec": 0.72,
   "gap_before": 1.41,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg16"
  },
  {
   "speaker": "user",
   "text": "I absolutely shouldn't miss?",
   "est_sec": 1.34,
   "gap_before": 2.38,
   "block": "weekend_plans.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Pick one big one and give it a couple of hours, rather than rushing through three. Leave time to just wander.",
   "est_sec": 6.61,
   "gap_before": 0.7,
   "role": "reply",
   "block": "weekend_plans.dlg16"
  }
 ]
}
