 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.45,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.82,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "How long should I rest between sets? I usually scroll my phone until I feel like it.",
   "est_sec": 5.37,
   "gap_before": 0.54,
   "block": "fitness.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a very common approach. It depends on your goal, though.",
   "est_sec": 3.51,
   "gap_before": 0.55,
   "role": "reply",
   "block": "fitness.dlg28"
  },
  {
   "speaker": "user",
   "text": "Strength, mostly. Getting stronger.",
   "est_sec": 1.34,
   "gap_before": 1.85,
   "block": "fitness.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "For heavy strength work, two to three minutes is good. That lets your muscles recover enough to lift heavy again.",
   "est_sec": 6.3,
   "gap_before": 0.58,
   "role": "reply",
   "block": "fitness.dlg28"
  },
  {
   "speaker": "user",
   "text": "And for, like, arm stuff?",
   "est_sec": 1.65,
   "gap_before": 1.27,
   "block": "fitness.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "For smaller muscles or lighter weights, sixty to ninety seconds is usually enough.",
   "est_sec": 4.13,
   "gap_before": 0.55,
   "role": "reply",
   "block": "fitness.dlg28"
  },
  {
   "speaker": "user",
   "text": "So the scrolling",
   "est_sec": 1.03,
   "gap_before": 0.31,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg28"
  },
  {
   "speaker": "user",
   "text": "is fine as long as I time it?",
   "est_sec": 2.58,
   "gap_before": 2.88,
   "block": "fitness.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Set a timer on your phone so ten minutes of videos don't sneak in.",
