 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.45,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.86,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "I wake up drenched in sweat most nights. The room isn't even that warm.",
   "est_sec": 4.44,
   "gap_before": 0.38,
   "block": "sleep.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That can come from bedding that traps heat, alcohol, spicy food late, or sometimes medication or hormone changes.",
   "est_sec": 5.68,
   "gap_before": 1.15,
   "role": "reply",
   "block": "sleep.dlg7"
  },
  {
   "speaker": "user",
   "text": "I'm fifty two, so",
   "est_sec": 1.34,
   "gap_before": 0.7,
   "event": "distractor",
   "kind": "pause",
   "block": "sleep.dlg7"
  },
  {
   "speaker": "user",
   "text": "maybe hormones?",
   "est_sec": 0.72,
   "gap_before": 1.94,
   "block": "sleep.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Could well be. Many people notice night sweats around that age. Breathable cotton sheets, a fan, and a glass of cold water by the bed can help.",
   "est_sec": 8.47,
   "gap_before": 1.15,
   "role": "reply",
   "block": "sleep.dlg7"
  },
  {
   "speaker": "user",
   "text": "Should I see someone about it?",
   "est_sec": 1.96,
   "gap_before": 0.84,
   "block": "sleep.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, if it happens most nights, it's worth mentioning to your doctor, they can check what's behind it and suggest options.",
   "est_sec": 6.61,
   "gap_before": 0.67,
   "role": "reply",
   "block": "sleep.dlg7"
  },
  {
   "speaker": "user",
   "text": "Okay, I'll book something. And buy a fan today.",
   "est_sec": 2.89,
   "gap_before": 0.54,
   "block": "sleep.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A small fan pointed at you can make a big difference while you wait.",
   "est_sec": 4.44,
   "gap_before": 0.69,
   "role": "reply",
   "block": "sleep.dlg7"
  }
 ]
}
