 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.79,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "I need a new profile photo for a job site. I hate how I look in pictures.",
   "est_sec": 5.37,
   "gap_before": 0.59,
   "block": "photography.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Lots of people do. The good news is a calm, friendly headshot is simple to get right. Do you have someone who can take it?",
   "est_sec": 7.85,
   "gap_before": 1.18,
   "role": "reply",
   "block": "photography.dlg27"
  },
  {
   "speaker": "user",
   "text": "My flatmate, if I bribe her.",
   "est_sec": 1.96,
   "gap_before": 1.28,
   "block": "photography.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Great. Stand facing a window, about a metre from it, with a plain wall or some soft greenery behind you.",
   "est_sec": 6.3,
   "gap_before": 0.53,
   "role": "reply",
   "block": "photography.dlg27"
  },
  {
   "speaker": "user",
   "text": "What do I",
   "est_sec": 1.03,
   "gap_before": 0.84,
   "event": "distractor",
   "kind": "pause",
   "block": "photography.dlg27"
  },
  {
   "speaker": "user",
   "text": "do with my face, though? I always look terrified.",
   "est_sec": 2.89,
   "gap_before": 1.53,
   "block": "photography.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Think of someone you like and say their name just before the photo. It gives a real half smile instead of a frozen one.",
   "est_sec": 7.54,
   "gap_before": 1.19,
   "role": "reply",
   "block": "photography.dlg27"
  },
  {
   "speaker": "user",
   "text": "Ha. Okay.",
   "est_sec": 0.72,
   "gap_before": 1.36,
   "block": "photography.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Have her hold the phone just above your eye level, and take loads. Pick the one where you look like yourself on a good day.",
   "est_sec": 7.85,
   "gap_before": 1.08,
   "role": "reply",
   "block": "photography.dlg27"
  }
 ]
}
