 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.96,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "Is a stand mixer actually worth it, or is it one of those gadgets that sits on the counter?",
   "est_sec": 5.99,
   "gap_before": 0.27,
   "block": "baking.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Depends how you bake. If you make bread, meringues or big batches of cookies often, it saves a lot of time and effort.",
   "est_sec": 7.23,
   "gap_before": 0.69,
   "role": "reply",
   "block": "baking.dlg21"
  },
  {
   "speaker": "user",
   "text": "I bake maybe once a month. Banana bread, mostly.",
   "est_sec": 2.89,
   "gap_before": 2.72,
   "block": "baking.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then probably not. Banana bread is best mixed by hand anyway, overmixing makes it tough.",
   "est_sec": 4.75,
   "gap_before": 0.91,
   "role": "reply",
   "block": "baking.dlg21"
  },
  {
   "speaker": "user",
   "text": "My kitchen is tiny anyway.",
   "est_sec": 1.65,
   "gap_before": 2.63,
   "block": "baking.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A hand mixer might be the sweet spot. It whips cream and egg whites, and it fits in a drawer.",
   "est_sec": 6.3,
   "gap_before": 0.57,
   "role": "reply",
   "block": "baking.dlg21"
  },
  {
   "speaker": "user",
   "text": "That I could justify.",
   "est_sec": 1.34,
   "gap_before": 1.18,
   "block": "baking.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "And if you get hooked on baking later, you can always upgrade.",
   "est_sec": 3.82,
   "gap_before": 0.61,
   "role": "reply",
   "block": "baking.dlg21"
  }
 ]
}
