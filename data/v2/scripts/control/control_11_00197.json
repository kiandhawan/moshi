 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.47,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.73,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "I'm getting married next year. How do people pay for weddings without going broke?",
   "est_sec": 4.44,
   "gap_before": 0.29,
   "block": "personal_finance.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most couples set a total budget first, then decide what matters most to them and spend there.",
   "est_sec": 5.37,
   "gap_before": 1.14,
   "role": "reply",
   "block": "personal_finance.dlg23"
  },
  {
   "speaker": "user",
   "text": "We care about food and music. That's about it.",
   "est_sec": 2.89,
   "gap_before": 0.77,
   "block": "personal_finance.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Great, that makes it easier. Spend on the caterer and the band, and keep everything else simple.",
   "est_sec": 5.37,
   "gap_before": 1.03,
   "role": "reply",
   "block": "personal_finance.dlg23"
  },
  {
   "speaker": "user",
   "text": "Adam, is the stapler on your desk?",
   "est_sec": 2.27,
   "gap_before": 0.84,
   "block": "nq_work_015",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_work_015",
   "name_pos": "start",
   "addressee": "Adam"
  },
  {
   "speaker": "user",
   "text": "My mum wants a huge guest list though.",
   "est_sec": 2.58,
   "gap_before": 2.27,
   "block": "personal_finance.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Guest numbers drive almost every cost. You could agree on a maximum, and if she wants more, she could help fund them.",
   "est_sec": 6.92,
   "gap_before": 0.66,
   "role": "reply",
   "block": "personal_finance.dlg23"
  },
  {
   "speaker": "user",
   "text": "That's going to be a fun conversation.",
   "est_sec": 2.27,
   "gap_before": 1.14,
   "block": "personal_finance.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It might be, but it's better to have it early. Be warm but clear.",
   "est_sec": 4.44,
   "gap_before": 1.06,
   "role": "reply",
   "block": "personal_finance.dlg23"
  }
 ]
