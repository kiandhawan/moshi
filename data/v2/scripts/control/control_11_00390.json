 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.32,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.53,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "My boyfriend and I broke up and I'm moving out of our flat next week.",
   "est_sec": 4.75,
   "gap_before": 0.59,
   "block": "moving_house.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "I'm sorry, that's a lot at once. How are you holding up?",
   "est_sec": 3.82,
   "gap_before": 1.04,
   "role": "reply",
   "block": "moving_house.dlg21"
  },
  {
   "speaker": "user",
   "text": "Which one of you left the hob on, Jacob?",
   "est_sec": 2.89,
   "gap_before": 3.42,
   "block": "nq_home_075",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_075",
   "name_pos": "end",
   "addressee": "Jacob"
  },
  {
   "speaker": "user",
   "text": "Okay, I guess. The hardest bit is splitting all our stuff.",
   "est_sec": 3.51,
   "gap_before": 2.59,
   "block": "moving_house.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It helps to make a simple list together, while things are calm, rather than deciding item by item on the day.",
   "est_sec": 6.61,
   "gap_before": 0.37,
   "role": "reply",
   "block": "moving_house.dlg21"
  },
  {
   "speaker": "user",
   "text": "We bought the sofa together, though.",
   "est_sec": 1.96,
   "gap_before": 3.49,
   "block": "moving_house.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "One of you could keep it and pay the other half, or sell it and split the money. Either is fair.",
   "est_sec": 6.61,
   "gap_before": 0.99,
   "role": "reply",
   "block": "moving_house.dlg21"
  },
  {
   "speaker": "user",
   "text": "I think I'd rather",
   "est_sec": 1.34,
   "gap_before": 1.46,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg21"
  },
  {
   "speaker": "user",
   "text": "just start fresh, honestly.",
   "est_sec": 1.34,
   "gap_before": 2.57,
   "block": "moving_house.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's completely okay. Take what matters to you, and let a friend help on moving day so you're not alone.",
   "est_sec": 6.3,
   "gap_before": 1.61,
   "role": "reply",
   "block": "moving_house.dlg21"
  }
 ]
