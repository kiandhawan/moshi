 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.4,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.63,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "My neighbour is feeding my cats for a week. What should I write down for her?",
   "est_sec": 5.06,
   "gap_before": 0.41,
   "block": "pets.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Keep it simple. How much food, what time, and where the food and bowls are.",
   "est_sec": 4.75,
   "gap_before": 0.37,
   "role": "reply",
   "block": "pets.dlg28"
  },
  {
   "speaker": "user",
   "text": "Our neighbor got Moshi after seeing it at our place.",
   "est_sec": 3.2,
   "gap_before": 0.51,
   "block": "mm_038",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_038",
   "name_pos": "none"
  },
  {
   "speaker": "user",
   "text": "So the bus is late again. Agnieszka, could you give me a lift?",
   "est_sec": 4.13,
   "gap_before": 2.99,
   "block": "nq_work_044",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_work_044",
   "name_pos": "middle",
   "addressee": "Agnieszka"
  },
  {
   "speaker": "other",
   "text": "If you're ready in five.",
   "est_sec": 1.65,
   "gap_before": 0.92,
   "block": "nq_work_044"
  },
  {
   "speaker": "user",
   "text": "She's never had cats.",
   "est_sec": 1.34,
   "gap_before": 1.96,
   "block": "pets.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then add the basics, like how to scoop the litter, where the bags go, and to check they have fresh water.",
   "est_sec": 6.61,
   "gap_before": 0.52,
   "role": "reply",
   "block": "pets.dlg28"
  },
  {
   "speaker": "user",
   "text": "One of them is on tablets.",
   "est_sec": 1.96,
   "gap_before": 1.18,
   "block": "pets.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Write exactly how and when to give them, and maybe show her once before you go. Leave the pill packet out with the doses.",
   "est_sec": 7.54,
   "gap_before": 1.14,
   "role": "reply",
   "block": "pets.dlg28"
  },
  {
   "speaker": "user",
   "text": "And emergencies?",
   "est_sec": 0.72,
   "gap_before": 0.52,
   "block": "pets.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Put your vet's number and address at the top, plus your number and a friend's backup. It'll make her feel much more confident.",
   "est_sec": 7.23,
   "gap_before": 1.06,
   "role": "reply",
   "block": "pets.dlg28"
  },
  {
   "speaker": "user",
   "text": "Should I",
   "est_sec": 0.72,
   "gap_before": 1.08,
   "event": "distractor",
   "kind": "pause",
   "block": "pets.dlg28"
  },
  {
   "speaker": "user",
   "text": "leave her some money in case?",
   "est_sec": 1.96,
   "gap_before": 1.84,
   "block": "pets.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's thoughtful. A small amount in an envelope for a taxi to the vet or extra food would put both your minds at rest.",
   "est_sec": 7.54,
   "gap_before": 1.41,
   "role": "reply",
   "block": "pets.dlg28"
  }
 ]
