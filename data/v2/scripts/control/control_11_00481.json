 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.54,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.77,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I left my umbrella on the bus this morning. It was my grandad's. Any chance of getting it back?",
   "est_sec": 5.99,
   "gap_before": 0.52,
   "block": "public_transport.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Quite a good chance, actually. Lost items usually go to the depot first and then to a lost property office.",
   "est_sec": 6.3,
   "gap_before": 0.83,
   "role": "reply",
   "block": "public_transport.dlg7"
  },
  {
   "speaker": "user",
   "text": "How do I find them?",
   "est_sec": 1.65,
   "gap_before": 2.41,
   "block": "public_transport.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Call the bus company or fill in their lost property form. Tell them the route number, rough time, and describe the umbrella.",
   "est_sec": 6.92,
   "gap_before": 1.04,
   "role": "reply",
   "block": "public_transport.dlg7"
  },
  {
   "speaker": "user",
   "text": "It's black with a",
   "est_sec": 1.34,
   "gap_before": 2.97,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg7"
  },
  {
   "speaker": "user",
   "text": "wooden duck head handle.",
   "est_sec": 1.34,
   "gap_before": 1.6,
   "block": "public_transport.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's distinctive, which helps a lot. Mention the duck handle, it'll stand out among all the plain black ones.",
   "est_sec": 5.99,
   "gap_before": 0.79,
   "role": "reply",
   "block": "public_transport.dlg7"
  },
  {
   "speaker": "user",
   "text": "How long do they keep stuff?",
   "est_sec": 1.96,
   "gap_before": 1.31,
   "block": "public_transport.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Often a few weeks, so it's worth calling today.",
   "est_sec": 2.89,
   "gap_before": 1.07,
   "role": "reply",
   "block": "public_transport.dlg7"
  }
 ]
}
