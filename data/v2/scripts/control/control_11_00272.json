 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.33,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.98,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "So Moshi, is it true you can change hydrangea colours? My blue one went pink after I moved it.",
   "est_sec": 5.99,
   "gap_before": 0.52,
   "block": "gardening.dlg20",
   "kind": "moshi_name",
   "name_pos": "start",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's true for many mophead and lacecap hydrangeas. The colour depends on the soil. Acidic soil gives blue, alkaline gives pink.",
   "est_sec": 6.61,
   "gap_before": 0.99,
   "role": "reply",
   "block": "gardening.dlg20"
  },
  {
   "speaker": "user",
   "text": "So my new spot is alkaline.",
   "est_sec": 1.96,
   "gap_before": 0.84,
   "block": "gardening.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Very likely. If you want blue back, you can grow it in a pot of ericaceous compost, or add a blueing product to the soil.",
   "est_sec": 7.85,
   "gap_before": 0.34,
   "role": "reply",
   "block": "gardening.dlg20"
  },
  {
   "speaker": "user",
   "text": "Is that like chemicals?",
   "est_sec": 1.34,
   "gap_before": 1.18,
   "block": "gardening.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's aluminium sulphate usually, and it works slowly. Honestly, a pot of acidic compost is the easier route.",
   "est_sec": 5.68,
   "gap_before": 0.49,
   "role": "reply",
   "block": "gardening.dlg20"
  },
  {
   "speaker": "user",
   "text": "I kind of like the pink though. My wife",
   "est_sec": 2.89,
   "gap_before": 0.42,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg20"
  },
  {
   "speaker": "user",
   "text": "says it looks like candy floss.",
   "est_sec": 1.96,
   "gap_before": 2.26,
   "block": "gardening.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then leave it. It's happy, it's pink, and you get to skip the chemistry homework.",
   "est_sec": 4.75,
   "gap_before": 0.58,
   "role": "reply",
   "block": "gardening.dlg20"
  }
 ]
