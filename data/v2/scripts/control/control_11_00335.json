   "block": "movies.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "These days, often yes. Lots of big films hide a little scene during or after the credits.",
   "est_sec": 5.37,
   "gap_before": 0.48,
   "role": "reply",
   "block": "movies.dlg16"
  },
  {
   "speaker": "user",
   "text": "How do I know if there is one?",
   "est_sec": 2.58,
   "gap_before": 3.49,
   "block": "movies.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can search the film name plus credits scene before you go. People post about it without spoiling what happens.",
   "est_sec": 6.3,
   "gap_before": 0.51,
   "role": "reply",
   "block": "movies.dlg16"
  },
