   "est_sec": 1.65,
   "gap_before": 2.18,
   "block": "movies.dlg16",
   "kind": "wait_like",
   "phrasing": "waitlike_16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Fair enough. Sometimes the scene is right after the first set of names, and you can leave after that.",
