 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.4,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "It's pouring all half term. What can I do with two bored kids?",
   "est_sec": 4.13,
   "gap_before": 0.24,
   "block": "weather_plans.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Rainy days can still be fun. How about a den building afternoon with sofa cushions and blankets?",
   "est_sec": 5.37,
   "gap_before": 0.78,
   "role": "reply",
   "block": "weather_plans.dlg18"
  },
  {
   "speaker": "user",
   "text": "Done that. Twice.",
   "est_sec": 1.03,
   "gap_before": 1.36,
   "block": "weather_plans.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Okay, a puddle walk then. Proper waterproofs and wellies, and you go out looking for the biggest puddle.",
   "est_sec": 5.68,
   "gap_before": 0.4,
   "role": "reply",
   "block": "weather_plans.dlg18"
  },
  {
   "speaker": "user",
   "text": "Weirdly, Moshi's voice is kind of soothing when I can't sleep.",
   "est_sec": 3.51,
   "gap_before": 1.47,
   "block": "mm_042",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_042",
   "name_pos": "none"
  },
  {
   "speaker": "other",
   "text": "Bit weird, but okay.",
   "est_sec": 1.34,
   "gap_before": 0.93,
   "block": "mm_042"
  },
  {
   "speaker": "user",
   "text": "They would love that. I'd hate it.",
   "est_sec": 2.27,
   "gap_before": 0.86,
   "block": "weather_plans.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Take a flask of tea and stand under an umbrella. Then home for a warm bath and a film.",
   "est_sec": 5.99,
   "gap_before": 1.14,
   "role": "reply",
   "block": "weather_plans.dlg18"
  },
  {
