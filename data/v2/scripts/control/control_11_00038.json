 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.66,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.62,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "My dad keeps saying renting is throwing money away. Is he right?",
   "est_sec": 3.82,
   "gap_before": 0.53,
   "block": "moving_house.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not entirely. Renting gives you flexibility and no repair bills, while buying builds equity but ties you down.",
   "est_sec": 5.68,
   "gap_before": 0.76,
   "role": "reply",
   "block": "moving_house.dlg20"
  },
  {
   "speaker": "user",
   "text": "I might move cities in a couple of years.",
   "est_sec": 2.89,
   "gap_before": 0.57,
   "block": "moving_house.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then renting often makes more sense. Buying and selling within a few years can cost more than you'd save.",
   "est_sec": 5.99,
   "gap_before": 1.06,
   "role": "reply",
   "block": "moving_house.dlg20"
  },
  {
   "speaker": "user",
   "text": "He'll still",
   "est_sec": 0.72,
   "gap_before": 1.32,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg20"
  },
  {
   "speaker": "user",
   "text": "say I'm wasting money.",
   "est_sec": 1.34,
   "gap_before": 1.94,
   "block": "moving_house.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You could tell him you're paying for flexibility. That's worth something too.",
   "est_sec": 3.82,
   "gap_before": 0.35,
   "role": "reply",
   "block": "moving_house.dlg20"
  },
  {
   "speaker": "user",
   "text": "And if I want to buy eventually?",
   "est_sec": 2.27,
   "gap_before": 0.69,
   "block": "moving_house.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
