 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.31,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.69,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "Morning or evening, when's the best time to water the garden?",
   "est_sec": 3.51,
   "gap_before": 0.55,
   "block": "gardening.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Early morning is usually best. The plants get a drink before the heat and the leaves dry off quickly.",
   "est_sec": 5.99,
   "gap_before": 0.95,
   "role": "reply",
   "block": "gardening.dlg21"
  },
  {
   "speaker": "user",
   "text": "I'm not a morning person.",
   "est_sec": 1.65,
   "gap_before": 0.56,
   "block": "gardening.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Evening is fine too, just water the soil rather than the leaves. Wet leaves overnight can invite mildew and slugs.",
   "est_sec": 6.3,
   "gap_before": 0.89,
   "role": "reply",
   "block": "gardening.dlg21"
  },
  {
   "speaker": "user",
   "text": "We spent ages asking Moshi trivia on the camping trip.",
   "est_sec": 3.2,
   "gap_before": 2.74,
   "block": "mm_100",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_100",
   "name_pos": "none"
  },
  {
   "speaker": "other",
   "text": "Who won?",
   "est_sec": 0.72,
   "gap_before": 0.72,
   "block": "mm_100"
  },
  {
   "speaker": "user",
   "text": "Slugs! Those things have eaten",
   "est_sec": 1.65,
   "gap_before": 1.59,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg21"
  },
  {
   "speaker": "user",
   "text": "half my lettuces this year.",
   "est_sec": 1.65,
   "gap_before": 2.8,
   "block": "gardening.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then morning watering really would help. Slugs love a damp evening.",
   "est_sec": 3.51,
   "gap_before": 0.99,
   "role": "reply",
   "block": "gardening.dlg21"
  },
  {
   "speaker": "user",
   "text": "Ugh, fine. How long should I water for?",
   "est_sec": 2.58,
   "gap_before": 1.42,
   "block": "gardening.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Less often but deeper is better. A good soak twice a week beats a light sprinkle every day.",
   "est_sec": 5.68,
   "gap_before": 1.05,
   "role": "reply",
   "block": "gardening.dlg21"
  },
  {
   "speaker": "user",
   "text": "Okay. Setting an alarm, apparently.",
   "est_sec": 1.65,
   "gap_before": 1.33,
   "block": "gardening.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Even ten minutes with a hose before work is enough for most beds.",
   "est_sec": 4.13,
   "gap_before": 0.7,
   "role": "reply",
   "block": "gardening.dlg21"
  }
 ]
