  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.75,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.75,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "My grandson keeps telling me to do online banking. Is it safe?",
   "est_sec": 3.82,
   "gap_before": 0.53,
   "block": "personal_finance.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's generally very safe if you use your bank's official app or website and keep your password private.",
   "est_sec": 5.68,
   "gap_before": 1.18,
   "role": "reply",
   "block": "personal_finance.dlg7"
  },
  {
   "speaker": "user",
   "text": "I worry about those scam messages.",
   "est_sec": 1.96,
   "gap_before": 0.98,
   "block": "personal_finance.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a smart worry. Your bank will never ask for your full password or ask you to move money by text or phone call.",
   "est_sec": 7.54,
   "gap_before": 0.67,
   "role": "reply",
   "block": "personal_finance.dlg7"
  },
  {
   "speaker": "user",
   "text": "What if someone calls pretending to be the bank?",
   "est_sec": 2.89,
   "gap_before": 0.56,
   "block": "personal_finance.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Hang up and call the number on the back of your card yourself. If it was real, they'll still be there.",
   "est_sec": 6.61,
   "gap_before": 0.71,
   "role": "reply",
   "block": "personal_finance.dlg7"
  },
  {
   "speaker": "user",
   "text": "That's a good tip. I'll write",
   "est_sec": 1.96,
   "gap_before": 0.89,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg7"
  },
  {
   "speaker": "user",
   "text": "that down on the notepad by the phone.",
   "est_sec": 2.58,
   "gap_before": 2.26,
