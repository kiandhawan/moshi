 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.72,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "Do singers really need to warm up? I just sing in the car.",
   "est_sec": 4.13,
   "gap_before": 0.33,
   "block": "music.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "For casual car singing, not much. But before a rehearsal or a gig, warming up protects your voice and makes high notes easier.",
   "est_sec": 7.23,
   "gap_before": 0.71,
   "role": "reply",
   "block": "music.dlg9"
  },
  {
   "speaker": "user",
   "text": "What do people actually do?",
   "est_sec": 1.65,
   "gap_before": 1.15,
   "block": "music.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Gentle humming, lip trills, which are like blowing a raspberry while you sing, and slides from low to high.",
   "est_sec": 5.99,
   "gap_before": 0.95,
   "role": "reply",
   "block": "music.dlg9"
  },
  {
   "speaker": "user",
   "text": "Hang on, I missed that.",
   "est_sec": 1.65,
   "gap_before": 0.43,
   "block": "music.dlg9",
   "kind": "wait_like",
   "phrasing": "waitlike_04",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sure, here it is again. Gentle humming, lip trills, which are like blowing a raspberry while you sing, and slides from low to high.",
   "est_sec": 7.54,
   "gap_before": 0.49,
   "role": "reply",
   "block": "music.dlg9"
  },
  {
   "speaker": "user",
   "text": "Lip trills sound",
   "est_sec": 1.03,
   "gap_before": 1.48,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg9"
  },
  {
   "speaker": "user",
   "text": "incredibly silly.",
   "est_sec": 0.72,
   "gap_before": 1.74,
   "block": "music.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "They really do. Everyone looks ridiculous doing them, but they relax your voice without straining it.",
   "est_sec": 5.06,
   "gap_before": 0.33,
   "role": "reply",
   "block": "music.dlg9"
  },
  {
   "speaker": "user",
   "text": "How long for?",
