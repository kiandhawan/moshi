   "block": "nq_home_074",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_074",
   "name_pos": "end",
   "addressee": "Jack"
  },
  {
   "speaker": "user",
   "text": "So what, I just try harder?",
   "est_sec": 1.96,
   "gap_before": 3.27,
   "block": "studying.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not harder, differently. Go through the test and redo every question you missed, without looking at your notes first.",
   "est_sec": 5.99,
   "gap_before": 1.01,
   "role": "reply",
   "block": "studying.dlg14"
  },
  {
   "speaker": "user",
   "text": "That sounds painful.",
   "est_sec": 1.03,
