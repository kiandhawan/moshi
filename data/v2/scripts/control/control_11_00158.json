 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.68,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.96,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "Do I really need eight hours of sleep? I feel fine on six.",
   "est_sec": 4.13,
   "gap_before": 0.42,
   "block": "sleep.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most adults need about seven to nine, but there's some variation. A few people genuinely do well on less.",
   "est_sec": 5.99,
   "gap_before": 0.42,
   "role": "reply",
   "block": "sleep.dlg31"
  },
  {
   "speaker": "user",
   "text": "How would I know?",
   "est_sec": 1.34,
   "gap_before": 1.17,
   "block": "sleep.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Do you need an alarm to wake up? Do you crash in the afternoon, or doze off in meetings?",
   "est_sec": 5.99,
   "gap_before": 0.62,
   "role": "reply",
   "block": "sleep.dlg31"
  },
  {
   "speaker": "user",
   "text": "Okay, all three.",
   "est_sec": 1.03,
   "gap_before": 1.5,
   "event": "distractor",
   "kind": "pause",
   "block": "sleep.dlg31"
  },
  {
   "speaker": "user",
   "text": "Yes.",
   "est_sec": 0.41,
   "gap_before": 1.85,
   "block": "sleep.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then you might be running on a sleep debt you've got used to. Try seven hours for two weeks and see how you feel.",
   "est_sec": 7.54,
   "gap_before": 0.73,
   "role": "reply",
   "block": "sleep.dlg31"
  },
  {
   "speaker": "user",
   "text": "Seven. That's a whole extra hour of my evening gone.",
   "est_sec": 3.2,
   "gap_before": 0.67,
   "block": "sleep.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Maybe, but you might get more done in the hours you're awake.",
   "est_sec": 3.82,
   "gap_before": 0.95,
   "role": "reply",
   "block": "sleep.dlg31"
  }
 ]
