 "est_total_sec": 49.99,
 "est_speech_sec": 38.2,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.56,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.88,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "I found a load of board games at a car boot sale for really cheap. How do I check they've got all the pieces?",
   "est_sec": 7.54,
   "gap_before": 0.21,
   "block": "board_games.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most rulebooks have a list of components near the front. Count everything against that list.",
   "est_sec": 4.75,
   "gap_before": 0.93,
   "role": "reply",
   "block": "board_games.dlg16"
  },
  {
   "speaker": "user",
   "text": "What if there's no rulebook?",
   "est_sec": 1.65,
   "gap_before": 2.56,
   "block": "board_games.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Search the game name online, the component list is usually on the publisher's site.",
   "est_sec": 4.44,
   "gap_before": 0.78,
   "role": "reply",
   "block": "board_games.dlg16"
  },
  {
   "speaker": "user",
   "text": "One box rattles weirdly. Is that bad?",
   "est_sec": 2.27,
   "gap_before": 1.1,
   "block": "board_games.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not necessarily, loose pieces rattle. But if the box smells musty, check for damp, cards can warp or go mouldy.",
   "est_sec": 6.3,
   "gap_before": 0.88,
   "role": "reply",
   "block": "board_games.dlg16"
  },
  {
   "speaker": "user",
   "text": "Ugh. Can I save mouldy cards?",
   "est_sec": 1.96,
   "gap_before": 0.97,
   "block": "board_games.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not really, sadly. But missing or damaged pieces can often be replaced, some publishers sell or even send spares for free.",
   "est_sec": 6.61,
   "gap_before": 1.42,
   "role": "reply",
   "block": "board_games.dlg16"
  }
 ]
}
