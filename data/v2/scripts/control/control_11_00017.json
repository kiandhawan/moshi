 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.54,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.48,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "I need new running shoes but I have no idea what to look for.",
   "est_sec": 4.44,
   "gap_before": 0.28,
   "block": "shopping.dlg1",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Start with comfort. They should feel good right away, with about a thumb's width of space in front of your toes.",
   "est_sec": 6.61,
   "gap_before": 0.58,
   "role": "reply",
   "block": "shopping.dlg1"
  },
  {
   "speaker": "user",
   "text": "Should I buy them online or in a store?",
   "est_sec": 2.89,
   "gap_before": 0.87,
   "block": "shopping.dlg1",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "For your first pair, a store is better. Some running shops will even watch you jog and suggest a model.",
   "est_sec": 6.3,
   "gap_before": 0.85,
   "role": "reply",
   "block": "shopping.dlg1"
  },
  {
   "speaker": "user",
   "text": "Nina, is it your week for the hoovering or mine?",
   "est_sec": 3.2,
   "gap_before": 1.1,
   "block": "nq_home_010",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_010",
   "name_pos": "start",
   "addressee": "Nina"
  },
  {
   "speaker": "other",
   "text": "Yours. I did the stairs.",
   "est_sec": 1.65,
   "gap_before": 1.0,
   "block": "nq_home_010"
  },
  {
   "speaker": "user",
   "text": "And what time of day should I go? I heard",
   "est_sec": 3.2,
   "gap_before": 0.88,
   "event": "distractor",
   "kind": "pause",
   "block": "shopping.dlg1"
  },
  {
   "speaker": "user",
   "text": "feet swell or something?",
   "est_sec": 1.34,
   "gap_before": 1.65,
   "block": "shopping.dlg1",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You heard right. Try shoes in the late afternoon, when your feet are a bit bigger, like they get on a run.",
   "est_sec": 6.92,
   "gap_before": 1.15,
   "role": "reply",
   "block": "shopping.dlg1"
  },
  {
   "speaker": "user",
   "text": "Good to know. How often do they need replacing?",
   "est_sec": 2.89,
   "gap_before": 0.71,
   "block": "shopping.dlg1",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Roughly every few hundred miles, or when the cushioning feels flat. For most casual runners, about once a year.",
   "est_sec": 5.99,
   "gap_before": 0.68,
   "role": "reply",
   "block": "shopping.dlg1"
  }
 ]
}
