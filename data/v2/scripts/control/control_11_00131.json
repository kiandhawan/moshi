 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.73,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "What's the deal with people sniffing old books? My boyfriend does it in every secondhand shop.",
   "est_sec": 5.06,
   "gap_before": 0.38,
   "block": "books.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "He's not alone. Old paper breaks down slowly and gives off a sweet, slightly vanilla smell that a lot of people love.",
   "est_sec": 6.92,
   "gap_before": 0.59,
   "role": "reply",
   "block": "books.dlg13"
  },
  {
   "speaker": "user",
   "text": "Vanilla? Really?",
   "est_sec": 0.72,
   "gap_before": 2.21,
   "block": "books.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Really. One of the chemicals in aging paper is related to the one in vanilla. So he's basically smelling a dusty cake.",
   "est_sec": 6.92,
   "gap_before": 0.83,
   "role": "reply",
   "block": "books.dlg13"
  },
  {
   "speaker": "user",
   "text": "That's both lovely and a bit gross.",
   "est_sec": 2.27,
   "gap_before": 0.69,
   "block": "books.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ha, that's fair. Book lovers tend to get sentimental about it, it reminds them of libraries and childhood.",
   "est_sec": 5.68,
   "gap_before": 1.09,
   "role": "reply",
   "block": "books.dlg13"
  },
  {
   "speaker": "user",
   "text": "Okay, I'll",
   "est_sec": 0.72,
   "gap_before": 0.3,
   "event": "distractor",
   "kind": "pause",
   "block": "books.dlg13"
  },
  {
   "speaker": "user",
   "text": "stop teasing him so much. Maybe just a little.",
   "est_sec": 2.89,
   "gap_before": 2.0,
   "block": "books.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A little teasing seems healthy. You could buy him an old copy of something he loves and let him sniff in peace.",
