 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.72,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.94,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "Can I use bleach on my wooden cutting board?",
   "est_sec": 2.89,
   "gap_before": 0.45,
   "block": "cleaning.dlg3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Bleach can dry out and crack wood, so I'd avoid it. Hot soapy water and drying it standing up is usually enough.",
   "est_sec": 6.92,
   "gap_before": 0.87,
   "role": "reply",
   "block": "cleaning.dlg3"
  },
  {
   "speaker": "user",
   "text": "Wait a second, that doesn't sound right.",
   "est_sec": 2.27,
   "gap_before": 0.93,
   "block": "cleaning.dlg3",
   "kind": "wait_like",
   "phrasing": "waitlike_10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Hmm, I believe it is. Which part doesn't sound right?",
   "est_sec": 3.2,
   "gap_before": 0.62,
   "role": "reply",
   "block": "cleaning.dlg3"
  },
  {
   "speaker": "user",
   "text": "What if I cut raw chicken on it?",
   "est_sec": 2.58,
   "gap_before": 1.11,
   "block": "cleaning.dlg3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then scrub it well and wipe it with plain white vinegar. Even better, keep a plastic board just for raw meat.",
   "est_sec": 6.61,
   "gap_before": 0.33,
   "role": "reply",
   "block": "cleaning.dlg3"
  },
  {
   "speaker": "user",
   "text": "Okay. It also smells",
   "est_sec": 1.34,
   "gap_before": 0.85,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg3"
  },
  {
   "speaker": "user",
   "text": "kind of like onions all the time.",
   "est_sec": 2.27,
   "gap_before": 2.82,
   "block": "cleaning.dlg3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Rub it with half a lemon and some coarse salt, then rinse. That takes out most smells.",
   "est_sec": 5.37,
   "gap_before": 0.6,
   "role": "reply",
   "block": "cleaning.dlg3"
  },
  {
   "speaker": "user",
   "text": "And should I oil it?",
   "est_sec": 1.65,
   "gap_before": 1.37,
   "block": "cleaning.dlg3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, once a month with food safe mineral oil. It keeps the wood from drying out and cracking.",
   "est_sec": 5.68,
   "gap_before": 1.09,
   "role": "reply",
   "block": "cleaning.dlg3"
  }
 ]
}
