 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.65,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.52,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "I made chili and it's so hot I can't feel my face, Moshi.",
   "est_sec": 4.13,
   "gap_before": 0.38,
   "block": "cooking.dlg11",
   "kind": "moshi_name",
   "name_pos": "end",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ouch. Stir in something creamy or sweet to calm it down, like sour cream, yogurt, or a spoon of sugar.",
   "est_sec": 6.3,
   "gap_before": 0.51,
   "role": "reply",
   "block": "cooking.dlg11"
  },
  {
   "speaker": "user",
   "text": "I have yogurt. Do I mix it into the whole pot?",
   "est_sec": 3.51,
   "gap_before": 0.85,
   "block": "cooking.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "I'd add it to each bowl instead. That way the leftovers can still be adjusted, and the yogurt won't split when you reheat.",
   "est_sec": 7.23,
   "gap_before": 0.95,
   "role": "reply",
   "block": "cooking.dlg11"
  },
  {
   "speaker": "user",
   "text": "Smart. Anything else? My friends are coming in an hour.",
   "est_sec": 3.2,
   "gap_before": 0.3,
   "block": "cooking.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Add another tin of beans and tomatoes to dilute it. Serve it with rice and plenty of cheese.",
   "est_sec": 5.68,
   "gap_before": 1.08,
   "role": "reply",
   "block": "cooking.dlg11"
  },
  {
   "speaker": "user",
   "text": "I think I used the wrong peppers. The bag just said",
   "est_sec": 3.51,
   "gap_before": 1.15,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg11"
  },
  {
   "speaker": "user",
   "text": "hot red chili.",
   "est_sec": 1.03,
   "gap_before": 2.75,
   "block": "cooking.dlg11",
   "event": "ordinary_request"
  },
  {
