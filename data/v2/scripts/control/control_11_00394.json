 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.43,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.42,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "We've moved in, but the place still feels like someone else's house.",
   "est_sec": 3.82,
   "gap_before": 0.23,
   "block": "moving_house.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's normal for a while. Small touches make a big difference, like hanging a few of your own pictures.",
   "est_sec": 5.99,
   "gap_before": 0.74,
   "role": "reply",
   "block": "moving_house.dlg24"
  },
  {
   "speaker": "user",
   "text": "We haven't put a single thing on the walls.",
   "est_sec": 2.89,
   "gap_before": 0.54,
   "block": "moving_house.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Start there. Then add soft lighting, lamps instead of the big ceiling light make a room feel warmer instantly.",
   "est_sec": 5.99,
   "gap_before": 0.33,
   "role": "reply",
   "block": "moving_house.dlg24"
  },
  {
   "speaker": "user",
   "text": "Oh, we only have the ceiling lights.",
   "est_sec": 2.27,
   "gap_before": 1.19,
   "block": "moving_house.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A couple of cheap lamps would help a lot. Plants and a rug do the same.",
   "est_sec": 5.06,
   "gap_before": 1.18,
   "role": "reply",
   "block": "moving_house.dlg24"
  },
  {
   "speaker": "user",
   "text": "And maybe",
   "est_sec": 0.72,
   "gap_before": 3.38,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg24"
  },
  {
   "speaker": "user",
   "text": "cook something that smells nice?",
   "est_sec": 1.65,
   "gap_before": 2.14,
   "block": "moving_house.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. A big Sunday dinner in the new kitchen is one of the best ways to make it feel like yours.",
   "est_sec": 6.61,
   "gap_before": 0.85,
   "role": "reply",
   "block": "moving_house.dlg24"
