 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.45,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.71,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "I'm throwing a little winter party and I want a cosy spiced coffee. Ideas?",
   "est_sec": 4.44,
   "gap_before": 0.38,
   "block": "coffee.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Lovely. You could brew a big pot of coffee with a cinnamon stick, a few cardamom pods and a strip of orange peel.",
   "est_sec": 7.23,
   "gap_before": 0.37,
   "role": "reply",
   "block": "coffee.dlg24"
  },
  {
   "speaker": "user",
   "text": "Do I put the spices in the coffee grounds?",
   "est_sec": 2.89,
   "gap_before": 0.99,
   "block": "coffee.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can mix ground cinnamon into the grounds, or simmer whole spices in milk and pour the coffee into it. Simmering gives a gentler, rounder flavour.",
   "est_sec": 8.16,
   "gap_before": 0.84,
   "role": "reply",
   "block": "coffee.dlg24"
  },
  {
   "speaker": "user",
   "text": "Should I sweeten it",
   "est_sec": 1.34,
   "gap_before": 1.47,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg24"
  },
  {
   "speaker": "user",
   "text": "or let people choose?",
   "est_sec": 1.34,
   "gap_before": 2.44,
   "block": "coffee.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "I'd keep the coffee unsweetened and put out honey or brown sugar. People's tastes vary a lot.",
   "est_sec": 5.37,
   "gap_before": 0.54,
   "role": "reply",
   "block": "coffee.dlg24"
  },
  {
   "speaker": "user",
   "text": "Could I make it ahead?",
   "est_sec": 1.65,
   "gap_before": 0.92,
   "block": "coffee.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Brew the spiced milk ahead and keep it warm in a slow cooker. Add fresh coffee as guests arrive so it doesn't taste stewed.",
   "est_sec": 7.54,
   "gap_before": 0.47,
   "role": "reply",
   "block": "coffee.dlg24"
  }
 ]
