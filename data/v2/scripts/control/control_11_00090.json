 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.54,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.38,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "Our neighbour's music comes straight through the wall. Can I soundproof it myself?",
   "est_sec": 4.13,
   "gap_before": 0.31,
   "block": "home_repair.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can reduce it, though fully soundproofing a wall is a big job. How bad is it?",
   "est_sec": 5.37,
   "gap_before": 0.83,
   "role": "reply",
   "block": "home_repair.dlg14"
  },
  {
   "speaker": "user",
   "text": "Bass mostly. Every night until eleven.",
   "est_sec": 1.96,
   "gap_before": 0.93,
   "block": "home_repair.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Bass is the hardest to block. Heavy things help, like a full bookshelf against that wall, or thick curtains.",
   "est_sec": 5.99,
   "gap_before": 1.27,
   "role": "reply",
   "block": "home_repair.dlg14"
  },
  {
   "speaker": "user",
   "text": "Your phone keeps buzzing. Jose, is that your mum?",
   "est_sec": 2.89,
   "gap_before": 0.78,
   "block": "nq_home_044",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_044",
   "name_pos": "middle",
   "addressee": "Jose"
  },
  {
   "speaker": "other",
   "text": "Probably. I'll ring her later.",
   "est_sec": 1.65,
   "gap_before": 0.32,
   "block": "nq_home_044"
  },
  {
   "speaker": "user",
   "text": "What about those foam panels?",
   "est_sec": 1.65,
   "gap_before": 1.39,
   "block": "home_repair.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Those mostly stop echo inside your room, not sound coming through. They won't do much for bass.",
   "est_sec": 5.37,
   "gap_before": 0.71,
   "role": "reply",
   "block": "home_repair.dlg14"
  },
  {
   "speaker": "user",
   "text": "So the real fix is",
   "est_sec": 1.65,
   "gap_before": 1.42,
   "event": "distractor",
   "kind": "pause",
   "block": "home_repair.dlg14"
  },
  {
   "speaker": "user",
   "text": "talking to him, isn't it.",
   "est_sec": 1.65,
   "gap_before": 2.07,
   "block": "home_repair.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Honestly, often yes. A friendly chat about the time can go a long way. Then add the bookshelf too.",
   "est_sec": 5.99,
   "gap_before": 0.97,
   "role": "reply",
   "block": "home_repair.dlg14"
  }
 ]
}
