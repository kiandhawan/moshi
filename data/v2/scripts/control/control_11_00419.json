 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.95,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "My tortoise has gone very sleepy. Is she trying to hibernate?",
   "est_sec": 3.51,
   "gap_before": 0.2,
   "block": "pets.dlg10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Possibly, if the weather's cooling down. What kind of tortoise is she?",
   "est_sec": 3.82,
   "gap_before": 0.77,
   "role": "reply",
   "block": "pets.dlg10"
  },
  {
   "speaker": "user",
   "text": "A Hermann's, I think. She's about ten.",
   "est_sec": 2.27,
   "gap_before": 1.48,
   "block": "pets.dlg10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Hermann's do hibernate. But before letting her, it's important she's healthy and has had a vet check this autumn.",
   "est_sec": 5.99,
   "gap_before": 0.59,
   "role": "reply",
   "block": "pets.dlg10"
  },
  {
   "speaker": "user",
   "text": "Why a vet check?",
   "est_sec": 1.34,
   "gap_before": 2.45,
   "block": "pets.dlg10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A tortoise that's underweight or ill can struggle to survive the winter. The vet will weigh her and check she's ready.",
   "est_sec": 6.61,
   "gap_before": 1.33,
   "role": "reply",
   "block": "pets.dlg10"
  },
  {
   "speaker": "user",
   "text": "And then she just sleeps in a box?",
   "est_sec": 2.58,
   "gap_before": 1.11,
   "block": "pets.dlg10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Somewhere with a steady temperature, just above freezing, often in a fridge set up for it. Weigh her every couple of weeks to make sure she isn't losing too much.",
   "est_sec": 9.4,
   "gap_before": 0.9,
   "role": "reply",
   "block": "pets.dlg10"
  }
 ]
}
