 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.7,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.89,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "I just moved into an apartment and the oven is disgusting. Where do I even start?",
   "est_sec": 5.06,
   "gap_before": 0.52,
   "block": "cleaning.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Take the racks out and soak them in the bathtub with hot water and dish soap. Then coat the inside with a baking soda paste and leave it overnight.",
   "est_sec": 9.09,
   "gap_before": 0.97,
   "role": "reply",
   "block": "cleaning.dlg4"
  },
  {
   "speaker": "user",
   "text": "Overnight? I was hoping",
   "est_sec": 1.34,
   "gap_before": 1.08,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg4"
  },
  {
   "speaker": "user",
   "text": "to cook something tonight.",
   "est_sec": 1.34,
   "gap_before": 1.75,
   "block": "cleaning.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can cook tonight and start the paste after. Cleaning a slightly warm oven is actually a bit easier.",
   "est_sec": 5.99,
   "gap_before": 1.14,
   "role": "reply",
   "block": "cleaning.dlg4"
  },
  {
   "speaker": "user",
   "text": "I think Moshi got the train times wrong yesterday.",
   "est_sec": 2.89,
   "gap_before": 1.12,
   "block": "mm_011",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_011",
   "name_pos": "none"
  },
  {
   "speaker": "user",
   "text": "What do I do in the morning?",
   "est_sec": 2.27,
   "gap_before": 2.61,
   "block": "cleaning.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Wipe off the paste with a damp cloth, then spray a little vinegar on the leftover bits. It fizzes and loosens them.",
   "est_sec": 6.92,
   "gap_before": 0.96,
   "role": "reply",
   "block": "cleaning.dlg4"
  },
  {
   "speaker": "user",
   "text": "And the glass on the door?",
   "est_sec": 1.96,
   "gap_before": 0.59,
   "block": "cleaning.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Same paste, then a razor scraper held flat for the tough spots. Go gently so you don't scratch it.",
   "est_sec": 5.99,
