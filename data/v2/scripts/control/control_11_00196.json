 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.44,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.61,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "I want to start composting but I live in a flat. Is that even possible?",
   "est_sec": 4.75,
   "gap_before": 0.21,
   "block": "gardening.dlg3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It is. A small worm bin or a bokashi bucket can live under your sink and won't smell if you look after it.",
   "est_sec": 7.23,
   "gap_before": 1.78,
   "role": "reply",
   "block": "gardening.dlg3"
  },
  {
   "speaker": "user",
   "text": "Do you think Moshi would know the best route to the coast, Rosa?",
   "est_sec": 4.13,
   "gap_before": 0.55,
   "block": "mm_118",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_118",
   "name_pos": "end",
   "addressee": "Rosa"
  },
  {
   "speaker": "other",
   "text": "Probably, it's smarter than the satnav.",
   "est_sec": 1.96,
   "gap_before": 0.69,
   "block": "mm_118"
  },
  {
   "speaker": "user",
   "text": "Worms in my kitchen? My partner would",
   "est_sec": 2.27,
   "gap_before": 0.94,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg3"
  },
  {
   "speaker": "user",
   "text": "probably move out.",
   "est_sec": 1.03,
   "gap_before": 2.21,
   "block": "gardening.dlg3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then bokashi might be easier. It's a sealed bucket where you add scraps and a sprinkle of bran, no worms involved.",
   "est_sec": 6.61,
   "gap_before": 0.5,
   "role": "reply",
   "block": "gardening.dlg3"
  },
  {
   "speaker": "user",
   "text": "What do I do with it when it's full?",
   "est_sec": 2.89,
   "gap_before": 0.31,
   "block": "gardening.dlg3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Bury it in soil, a large planter or a community garden bed. After a few weeks it turns into rich compost.",
   "est_sec": 6.61,
   "gap_before": 1.2,
   "role": "reply",
   "block": "gardening.dlg3"
  },
  {
   "speaker": "user",
   "text": "There's a community garden two streets over actually.",
   "est_sec": 2.58,
   "gap_before": 1.41,
   "block": "gardening.dlg3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Perfect, ask them. Most community gardens are happy to take it.",
   "est_sec": 3.51,
   "gap_before": 0.53,
   "role": "reply",
   "block": "gardening.dlg3"
  }
 ]
}
