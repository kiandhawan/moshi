 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.4,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.63,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "Why do people keep telling me to take meter readings on moving day?",
   "est_sec": 4.13,
   "gap_before": 0.32,
   "block": "moving_house.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "So you only pay for the energy you used. Without readings, you might be charged for the last tenant's use, or the next one's.",
   "est_sec": 7.54,
   "gap_before": 0.73,
   "role": "reply",
   "block": "moving_house.dlg22"
  },
  {
   "speaker": "user",
   "text": "Did you remember to defrost the mince, Valeria?",
   "est_sec": 2.58,
   "gap_before": 0.91,
   "block": "nq_home_055",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_055",
   "name_pos": "end",
   "addressee": "Valeria"
  },
  {
   "speaker": "other",
   "text": "Oh. I'll microwave it.",
   "est_sec": 1.34,
   "gap_before": 0.54,
   "block": "nq_home_055"
  },
  {
   "speaker": "user",
   "text": "Where's the meter, though?",
   "est_sec": 1.34,
   "gap_before": 1.17,
   "block": "moving_house.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Often in a cupboard under the stairs, in the hall, or in a box outside. Ask the landlord or agent if you can't find it.",
   "est_sec": 7.85,
   "gap_before": 0.32,
   "role": "reply",
   "block": "moving_house.dlg22"
  },
  {
   "speaker": "user",
   "text": "Do I just write it down?",
   "est_sec": 1.96,
   "gap_before": 2.84,
   "block": "moving_house.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Take a clear photo with the date on it, then send the readings to your energy supplier.",
   "est_sec": 5.37,
   "gap_before": 0.75,
   "role": "reply",
   "block": "moving_house.dlg22"
  },
  {
   "speaker": "user",
   "text": "Both places? Old",
   "est_sec": 1.03,
   "gap_before": 2.46,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg22"
  },
  {
   "speaker": "user",
   "text": "and new?",
   "est_sec": 0.72,
   "gap_before": 2.35,
   "block": "moving_house.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, both. A final reading at the old place and a first reading at the new one.",
   "est_sec": 5.37,
   "gap_before": 1.78,
   "role": "reply",
   "block": "moving_house.dlg22"
  }
 ]
