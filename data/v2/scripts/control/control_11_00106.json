 "est_speech_sec": 32.62,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.74,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.74,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "My scones are always flat and tough. Like hockey pucks.",
   "est_sec": 3.2,
   "gap_before": 0.26,
   "block": "baking.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Two likely reasons. Butter that's too warm, and handling the dough too much.",
   "est_sec": 4.13,
   "gap_before": 0.63,
   "role": "reply",
   "block": "baking.dlg24"
  },
  {
   "speaker": "user",
   "text": "I knead it until it's smooth.",
   "est_sec": 1.96,
   "gap_before": 0.51,
   "block": "baking.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Skip that. Scone dough should look a bit shaggy and messy. Pat it together gently, don't knead it.",
   "est_sec": 5.68,
   "gap_before": 0.47,
   "role": "reply",
   "block": "baking.dlg24"
  },
  {
   "speaker": "user",
   "text": "What about the butter, though?",
   "est_sec": 1.65,
   "gap_before": 1.38,
   "block": "baking.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Straight from the fridge, or even grated from frozen. Those cold lumps melt in the oven and puff the scones up.",
   "est_sec": 6.61,
   "gap_before": 1.1,
   "role": "reply",
   "block": "baking.dlg24"
  },
  {
   "speaker": "user",
   "text": "Grated frozen butter. That's clever.",
   "est_sec": 1.65,
   "gap_before": 1.39,
   "block": "baking.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Also cut them straight down without twisting the cutter. Twisting seals the edges and stops them rising.",
   "est_sec": 5.37,
   "gap_before": 0.55,
   "role": "reply",
   "block": "baking.dlg24"
  }
 ]
}
