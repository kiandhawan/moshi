 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.31,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.93,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "Everyone at school is playing this horror game, but I get scared really easily.",
   "est_sec": 4.44,
   "gap_before": 0.41,
   "block": "video_games.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's okay, plenty of people do. You could watch someone else play first, so you know what's coming.",
   "est_sec": 5.68,
   "gap_before": 1.04,
   "role": "reply",
   "block": "video_games.dlg17"
  },
  {
   "speaker": "user",
   "text": "Wouldn't that spoil it?",
   "est_sec": 1.34,
   "gap_before": 1.02,
   "block": "video_games.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A little, but it makes it far less scary. Or play it in the daytime with the lights on and someone else in the room.",
   "est_sec": 7.85,
   "gap_before": 1.06,
   "role": "reply",
   "block": "video_games.dlg17"
  },
  {
   "speaker": "user",
   "text": "Wait, what did you say?",
   "est_sec": 1.65,
   "gap_before": 1.28,
   "block": "video_games.dlg17",
   "kind": "wait_like",
   "phrasing": "waitlike_01",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Of course. A little, but it makes it far less scary. Or play it in the daytime with the lights on and someone else in the room.",
   "est_sec": 8.47,
   "gap_before": 0.76,
   "role": "reply",
   "block": "video_games.dlg17"
  },
  {
   "speaker": "user",
   "text": "Ha, my little sister",
   "est_sec": 1.34,
   "gap_before": 0.49,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg17"
  },
  {
   "speaker": "user",
   "text": "could be my bodyguard.",
   "est_sec": 1.34,
   "gap_before": 2.2,
   "block": "video_games.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Perfect bodyguard. Lowering the volume also helps a lot, a big part of horror games is the sound.",
