   "block": "mm_086",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_086",
   "name_pos": "none"
  },
  {
   "speaker": "user",
   "text": "Like flashcards?",
   "est_sec": 0.72,
   "gap_before": 2.84,
   "block": "studying.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Flashcards are perfect. Podcasts or recorded lectures work too, and reading short sections on your phone.",
   "est_sec": 5.06,
   "gap_before": 0.52,
   "role": "reply",
   "block": "studying.dlg21"
  },
  {
   "speaker": "user",
   "text": "I get motion sick reading on buses.",
   "est_sec": 2.27,
   "gap_before": 1.19,
   "block": "studying.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then audio is your friend. Record yourself reading your notes and listen back, it's surprisingly effective.",
   "est_sec": 5.06,
   "gap_before": 0.77,
   "role": "reply",
   "block": "studying.dlg21"
  },
  {
   "speaker": "user",
   "text": "Listening to my own voice.",
   "est_sec": 1.65,
   "gap_before": 2.67,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg21"
  },
  {
