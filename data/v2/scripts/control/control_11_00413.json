 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.31,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I commute an hour each way on the bus. Can I actually study on it?",
   "est_sec": 4.75,
   "gap_before": 0.25,
   "block": "studying.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Definitely, it just needs the right kind of studying. Things that don't need much space or writing work best.",
   "est_sec": 5.99,
   "gap_before": 0.63,
   "role": "reply",
   "block": "studying.dlg21"
  },
  {
   "speaker": "user",
   "text": "You'd laugh, Moshi tried to give me a pep talk.",
