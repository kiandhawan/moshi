 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.49,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "We just adopted a dog and I don't drive. Can she come on the train with me?",
   "est_sec": 5.37,
   "gap_before": 0.51,
   "block": "public_transport.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "In lots of places, yes. Small dogs often travel free, and bigger ones might need a ticket or have to stay on a lead.",
   "est_sec": 7.54,
   "gap_before": 0.73,
   "role": "reply",
   "block": "public_transport.dlg32"
  },
  {
   "speaker": "user",
   "text": "She's medium sized. A bit nervous.",
   "est_sec": 1.96,
   "gap_before": 1.33,
   "block": "public_transport.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then start with short, quiet trips outside rush hour. Bring treats and a blanket that smells like home.",
   "est_sec": 5.68,
   "gap_before": 1.07,
   "role": "reply",
   "block": "public_transport.dlg32"
  },
  {
   "speaker": "user",
   "text": "Did you know Moshi can convert cups to grams, Hiro?",
   "est_sec": 3.2,
   "gap_before": 1.28,
   "block": "mm_009",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_009",
   "name_pos": "end",
   "addressee": "Hiro"
  },
  {
   "speaker": "other",
   "text": "Since when?",
   "est_sec": 0.72,
   "gap_before": 0.67,
   "block": "mm_009"
  },
  {
   "speaker": "user",
   "text": "Does she need",
   "est_sec": 1.03,
   "gap_before": 1.67,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg32"
  },
  {
   "speaker": "user",
   "text": "a muzzle or anything?",
   "est_sec": 1.34,
   "gap_before": 2.04,
   "block": "public_transport.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Some networks require one, others don't. Check your local rules, and practise with it at home first if needed.",
   "est_sec": 5.99,
   "gap_before": 0.93,
   "role": "reply",
   "block": "public_transport.dlg32"
  },
  {
   "speaker": "user",
   "text": "I didn't think about practising.",
   "est_sec": 1.65,
   "gap_before": 0.35,
   "block": "public_transport.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It really helps. A calm first trip makes the next ones much easier for both of you.",
   "est_sec": 5.37,
   "gap_before": 0.61,
   "role": "reply",
   "block": "public_transport.dlg32"
  }
 ]
}
