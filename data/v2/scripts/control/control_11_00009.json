 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.42,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.33,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I've been studying ten hours a day for a month and I'm starting to feel numb.",
   "est_sec": 5.06,
   "gap_before": 0.42,
   "block": "studying.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That sounds like burnout creeping in. Ten hours every day is a lot for anyone.",
   "est_sec": 4.75,
   "gap_before": 1.07,
   "role": "reply",
   "block": "studying.dlg19"
  },
  {
   "speaker": "user",
   "text": "Wait, what did you say?",
   "est_sec": 1.65,
   "gap_before": 1.13,
   "block": "studying.dlg19",
   "kind": "wait_like",
   "phrasing": "waitlike_01",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "No problem. That sounds like burnout creeping in. Ten hours every day is a lot for anyone.",
   "est_sec": 5.37,
   "gap_before": 1.05,
   "role": "reply",
   "block": "studying.dlg19"
  },
  {
   "speaker": "user",
   "text": "But my exams are so close. I can't stop now.",
   "est_sec": 3.2,
   "gap_before": 1.45,
   "block": "studying.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You don't have to stop. But cutting back to six focused hours with real breaks will probably get you more than ten tired ones.",
   "est_sec": 7.54,
   "gap_before": 0.46,
   "role": "reply",
   "block": "studying.dlg19"
  },
  {
   "speaker": "user",
   "text": "What counts as a real break?",
   "est_sec": 1.96,
   "gap_before": 1.6,
   "block": "studying.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Away from the desk and away from screens. A walk, a meal with someone, a shower. Anything that lets your brain switch off.",
   "est_sec": 7.23,
   "gap_before": 0.65,
   "role": "reply",
   "block": "studying.dlg19"
  },
  {
   "speaker": "user",
   "text": "And a day off?",
   "est_sec": 1.34,
   "gap_before": 1.03,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg19"
  },
  {
   "speaker": "user",
   "text": "That feels impossible.",
   "est_sec": 1.03,
   "gap_before": 1.59,
   "block": "studying.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Even half a day a week helps. Rest is part of the plan, not a break from it.",
   "est_sec": 5.68,
   "gap_before": 1.19,
   "role": "reply",
   "block": "studying.dlg19"
  }
 ]
