 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.45,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.52,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "Is it a good idea to work out with a hangover? Asking for, um, me.",
   "est_sec": 4.75,
   "gap_before": 0.54,
   "block": "fitness.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ha. Light exercise can make you feel better, but a hard workout is not a great plan.",
   "est_sec": 5.37,
   "gap_before": 0.76,
   "role": "reply",
   "block": "fitness.dlg30"
  },
  {
   "speaker": "user",
   "text": "What counts as light?",
   "est_sec": 1.34,
   "gap_before": 1.3,
   "block": "fitness.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A gentle walk or some easy stretching. Skip heavy lifting and high intensity stuff today.",
   "est_sec": 4.75,
   "gap_before": 0.52,
   "role": "reply",
   "block": "fitness.dlg30"
  },
  {
   "speaker": "user",
   "text": "I was going to do a spin class.",
   "est_sec": 2.58,
   "gap_before": 0.64,
   "block": "fitness.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Probably not the day for it. You're likely dehydrated, and intense sweating makes that worse.",
   "est_sec": 4.75,
   "gap_before": 0.45,
   "role": "reply",
   "block": "fitness.dlg30"
  },
  {
   "speaker": "user",
   "text": "Water and a walk then. Maybe",
   "est_sec": 1.96,
   "gap_before": 1.58,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg30"
  },
  {
   "speaker": "user",
   "text": "some toast first.",
   "est_sec": 1.03,
   "gap_before": 1.87,
   "block": "fitness.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good plan. Drink plenty of water and maybe something with salt in it.",
   "est_sec": 4.13,
