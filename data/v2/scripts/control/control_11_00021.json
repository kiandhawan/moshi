 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.61,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.3,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "Hand grinder or electric grinder? I only make one cup a day.",
   "est_sec": 3.82,
   "gap_before": 0.57,
   "block": "coffee.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "For one cup, a good hand grinder is great value. You get a consistent grind for much less money than a similar electric one.",
   "est_sec": 7.54,
   "gap_before": 0.71,
   "role": "reply",
   "block": "coffee.dlg12"
  },
  {
   "speaker": "user",
   "text": "How long does it take to grind by hand?",
   "est_sec": 2.89,
   "gap_before": 1.11,
   "block": "coffee.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Usually somewhere between thirty seconds and a minute for one cup, depending on how fine you go.",
   "est_sec": 5.37,
   "gap_before": 0.71,
   "role": "reply",
   "block": "coffee.dlg12"
  },
  {
   "speaker": "user",
   "text": "That's fine for filter, but",
   "est_sec": 1.65,
   "gap_before": 0.55,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg12"
  },
  {
   "speaker": "user",
   "text": "what about espresso?",
   "est_sec": 1.03,
   "gap_before": 2.11,
   "block": "coffee.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Espresso takes longer by hand because it's very fine. Some people find it a nice morning ritual, others find it tiring.",
   "est_sec": 6.61,
   "gap_before": 1.65,
   "role": "reply",
   "block": "coffee.dlg12"
  },
  {
   "speaker": "user",
   "text": "I'm not exactly a morning person.",
   "est_sec": 1.96,
   "gap_before": 1.32,
   "block": "coffee.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then an electric burr grinder might be worth the extra. Just avoid blade grinders, they chop the beans unevenly.",
   "est_sec": 5.99,
   "gap_before": 1.08,
   "role": "reply",
   "block": "coffee.dlg12"
  }
 ]
}
