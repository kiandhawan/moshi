 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.41,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "My wife talks in her sleep. Last night she said, very clearly, the penguins are late.",
   "est_sec": 5.06,
   "gap_before": 0.55,
   "block": "sleep.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a great one. Sleep talking is really common and usually harmless, especially if she's stressed or overtired.",
   "est_sec": 5.68,
   "gap_before": 0.74,
   "role": "reply",
   "block": "sleep.dlg6"
  },
  {
   "speaker": "user",
   "text": "Should I wake her up?",
   "est_sec": 1.65,
   "gap_before": 0.43,
   "block": "sleep.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "No need. She probably won't remember it and waking her can just confuse her.",
   "est_sec": 4.44,
   "gap_before": 0.83,
   "role": "reply",
   "block": "sleep.dlg6"
  },
  {
   "speaker": "user",
   "text": "It's mostly funny but sometimes it",
   "est_sec": 1.96,
   "gap_before": 0.34,
   "event": "distractor",
   "kind": "pause",
   "block": "sleep.dlg6"
  },
  {
   "speaker": "user",
   "text": "keeps me awake.",
   "est_sec": 1.03,
   "gap_before": 2.65,
   "block": "sleep.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Earplugs or a soft white noise in the background can help you sleep through it.",
   "est_sec": 4.75,
   "gap_before": 1.11,
   "role": "reply",
   "block": "sleep.dlg6"
  },
  {
   "speaker": "user",
   "text": "I might start writing them down instead. The penguin one is going on the fridge.",
   "est_sec": 4.75,
   "gap_before": 1.52,
   "block": "sleep.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
