 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.54,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.38,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "Is haggling at a flea market rude, or is it expected?",
   "est_sec": 3.51,
   "gap_before": 0.36,
   "block": "shopping.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "At most flea markets it's expected, especially on bigger items. Sellers often price things with a bit of room built in.",
   "est_sec": 6.61,
   "gap_before": 0.88,
   "role": "reply",
   "block": "shopping.dlg15"
  },
  {
   "speaker": "user",
   "text": "I'm terrible at it. I just pay whatever they say.",
   "est_sec": 3.2,
   "gap_before": 1.25,
   "block": "shopping.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Start friendly. Ask how much, then offer around two thirds and see where you meet.",
   "est_sec": 4.75,
   "gap_before": 0.31,
   "role": "reply",
   "block": "shopping.dlg15"
  },
  {
   "speaker": "user",
   "text": "What if they get annoyed?",
   "est_sec": 1.65,
   "gap_before": 1.35,
   "block": "shopping.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Smile and say no worries. If they won't budge, you can still buy it or walk away, both are fine.",
   "est_sec": 6.3,
   "gap_before": 0.78,
   "role": "reply",
   "block": "shopping.dlg15"
  },
  {
   "speaker": "user",
   "text": "There's this old lamp I've had my eye on",
   "est_sec": 2.89,
   "gap_before": 1.29,
   "event": "distractor",
   "kind": "pause",
   "block": "shopping.dlg15"
  },
  {
   "speaker": "user",
   "text": "for three weekends now.",
   "est_sec": 1.34,
   "gap_before": 1.96,
   "block": "shopping.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then you know it hasn't sold. Go late in the day, sellers are happier to drop the price than carry things home.",
   "est_sec": 6.92,
   "gap_before": 0.47,
   "role": "reply",
   "block": "shopping.dlg15"
  },
  {
   "speaker": "user",
   "text": "Sneaky. I like it.",
   "est_sec": 1.34,
   "gap_before": 1.31,
   "block": "shopping.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Bring cash in small notes too. Offering exact money makes a lower price feel easier to say yes to.",
   "est_sec": 5.99,
   "gap_before": 1.17,
   "role": "reply",
   "block": "shopping.dlg15"
  }
 ]
}
