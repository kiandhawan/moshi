 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.67,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.85,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "My daughter is fourteen and starting pre-season for football. How can she get fitter without overdoing it?",
   "est_sec": 5.37,
   "gap_before": 0.52,
   "block": "fitness.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good that you're thinking about it. A mix of running, some short sprints and basic strength work is ideal.",
   "est_sec": 5.99,
   "gap_before": 0.71,
   "role": "reply",
   "block": "fitness.dlg29"
  },
  {
   "speaker": "user",
   "text": "Strength work at fourteen?",
   "est_sec": 1.34,
   "gap_before": 0.99,
   "block": "fitness.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Bodyweight exercises like squats, lunges and planks are safe and help prevent injuries.",
   "est_sec": 4.13,
   "gap_before": 0.89,
   "role": "reply",
   "block": "fitness.dlg29"
  },
  {
   "speaker": "user",
   "text": "How many days a week?",
   "est_sec": 1.65,
   "gap_before": 0.85,
   "block": "fitness.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Three or four sessions, with rest days in between. Keep the sprints short and the jogging easy.",
   "est_sec": 5.37,
   "gap_before": 1.15,
   "role": "reply",
   "block": "fitness.dlg29"
  },
  {
   "speaker": "user",
   "text": "She tends to",
   "est_sec": 1.03,
   "gap_before": 0.62,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg29"
  },
  {
   "speaker": "user",
   "text": "go all out every time.",
   "est_sec": 1.65,
   "gap_before": 1.99,
   "block": "fitness.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then remind her that rest is part of training. Sleep and good food matter just as much at her age.",
   "est_sec": 6.3,
   "gap_before": 0.94,
   "role": "reply",
   "block": "fitness.dlg29"
  },
  {
   "speaker": "user",
   "text": "She'll roll her eyes at me.",
   "est_sec": 1.96,
   "gap_before": 1.25,
   "block": "fitness.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Maybe let her coach say it then. It often lands better.",
   "est_sec": 3.51,
   "gap_before": 0.83,
   "role": "reply",
   "block": "fitness.dlg29"
  }
 ]
}
