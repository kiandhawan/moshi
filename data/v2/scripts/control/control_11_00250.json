 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.79,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "The paint is peeling off my window frames outside. Do I need to strip all of it?",
   "est_sec": 5.37,
   "gap_before": 0.49,
   "block": "home_repair.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not necessarily all. Scrape off anything loose or flaky until you hit paint that's firmly stuck.",
   "est_sec": 5.06,
   "gap_before": 0.46,
   "role": "reply",
   "block": "home_repair.dlg30"
  },
  {
   "speaker": "user",
   "text": "Then sand?",
   "est_sec": 0.72,
   "gap_before": 0.78,
   "block": "home_repair.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, sand the edges so there's no ridge, then fill any cracks in the wood with exterior filler.",
   "est_sec": 5.68,
   "gap_before": 0.4,
   "role": "reply",
   "block": "home_repair.dlg30"
  },
  {
   "speaker": "user",
   "text": "Can you take the dog out before it gets dark, Hailey?",
   "est_sec": 3.51,
   "gap_before": 1.22,
   "block": "nq_home_056",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_056",
   "name_pos": "end",
   "addressee": "Hailey"
  },
  {
   "speaker": "user",
   "text": "Is there special paint for outside?",
   "est_sec": 1.96,
   "gap_before": 2.68,
   "block": "home_repair.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Use an exterior wood paint, and a primer on any bare wood. It'll last much longer against the rain.",
   "est_sec": 5.99,
   "gap_before": 0.97,
   "role": "reply",
   "block": "home_repair.dlg30"
  },
  {
   "speaker": "user",
   "text": "My house is",
   "est_sec": 1.03,
   "gap_before": 1.35,
   "event": "distractor",
   "kind": "pause",
   "block": "home_repair.dlg30"
  },
  {
   "speaker": "user",
   "text": "pretty close to the sea. Does that matter?",
   "est_sec": 2.58,
   "gap_before": 2.71,
   "block": "home_repair.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It does. Salt air is tough on paint, so pick a high quality marine or coastal grade product if you can.",
   "est_sec": 6.61,
   "gap_before": 1.06,
   "role": "reply",
   "block": "home_repair.dlg30"
  }
 ]
