 "est_total_sec": 54.76,
 "est_speech_sec": 42.33,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.36,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.85,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "My tyre pressure light just came on. Is that urgent?",
   "est_sec": 3.2,
   "gap_before": 0.37,
   "block": "cars.dlg1",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's worth dealing with today. It usually means at least one tyre is low, which hurts grip and wears the tyre faster.",
   "est_sec": 6.92,
   "gap_before": 1.53,
   "role": "reply",
   "block": "cars.dlg1"
  },
  {
   "speaker": "user",
   "text": "So Moshi, how do I know what pressure they should be?",
   "est_sec": 3.51,
   "gap_before": 0.99,
   "block": "cars.dlg1",
   "kind": "moshi_name",
   "name_pos": "start",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "There's usually a sticker inside the driver's door frame, or it's in the manual. Most petrol stations have a pump you can set to that number.",
   "est_sec": 8.16,
   "gap_before": 1.08,
   "role": "reply",
   "block": "cars.dlg1"
  },
  {
   "speaker": "user",
   "text": "And if it comes back on after I",
   "est_sec": 2.58,
   "gap_before": 1.47,
   "event": "distractor",
   "kind": "pause",
   "block": "cars.dlg1"
  },
  {
   "speaker": "user",
   "text": "fill them up?",
   "est_sec": 1.03,
   "gap_before": 1.54,
   "block": "cars.dlg1",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then you might have a slow puncture. A tyre shop can check it quickly, often for free.",
   "est_sec": 5.37,
   "gap_before": 1.17,
   "role": "reply",
   "block": "cars.dlg1"
  },
  {
   "speaker": "user",
   "text": "Okay, I'll stop at the station on the way home.",
   "est_sec": 3.2,
   "gap_before": 0.97,
   "block": "cars.dlg1",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good plan. Check them when the tyres are cold if you can, it gives a more accurate reading.",
   "est_sec": 5.68,
   "gap_before": 0.6,
   "role": "reply",
   "block": "cars.dlg1"
  }
 ]
}
