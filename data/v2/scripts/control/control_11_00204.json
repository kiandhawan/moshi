   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "Can you recommend a good movie for a ten year old who loves animals?",
   "est_sec": 4.44,
   "gap_before": 0.47,
   "block": "movies.dlg1",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "An animated adventure about a lost dog or a fox trying to get home would be perfect. Funny, warm and not too scary.",
   "est_sec": 7.23,
   "gap_before": 1.27,
   "role": "reply",
   "block": "movies.dlg1"
  },
  {
   "speaker": "user",
   "text": "Are you coming to Gran's for Sunday lunch, Ezra?",
   "est_sec": 2.89,
   "gap_before": 0.98,
   "block": "nq_social_080",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_080",
   "name_pos": "end",
   "addressee": "Ezra"
  },
  {
   "speaker": "other",
   "text": "If she's doing the roast, absolutely.",
   "est_sec": 1.96,
   "gap_before": 0.97,
   "block": "nq_social_080"
  },
  {
   "speaker": "user",
   "text": "She cries at sad endings though.",
   "est_sec": 1.96,
   "gap_before": 0.97,
   "block": "movies.dlg1",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then skip the classic animal dramas. Lots of them have a heartbreaking twist.",
   "est_sec": 4.13,
   "gap_before": 0.46,
   "role": "reply",
   "block": "movies.dlg1"
  },
  {
