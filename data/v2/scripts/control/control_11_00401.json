 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.43,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.82,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "Should I warn my neighbours about a party? It's a Saturday, not huge.",
   "est_sec": 4.13,
   "gap_before": 0.58,
   "block": "birthday_party.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A quick heads up is always a good idea. It turns a possible complaint into goodwill.",
   "est_sec": 5.06,
   "gap_before": 0.41,
   "role": "reply",
   "block": "birthday_party.dlg19"
  },
  {
   "speaker": "user",
   "text": "What do I even say?",
   "est_sec": 1.65,
   "gap_before": 1.04,
   "block": "birthday_party.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Just a short note with the date, a rough end time, and your number in case it gets too loud.",
   "est_sec": 6.3,
   "gap_before": 0.52,
   "role": "reply",
   "block": "birthday_party.dlg19"
  },
  {
   "speaker": "user",
   "text": "Do I invite them? I barely know the guy downstairs",
   "est_sec": 3.2,
   "gap_before": 0.94,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg19"
  },
  {
   "speaker": "user",
   "text": "and he seems kind of grumpy.",
   "est_sec": 1.96,
   "gap_before": 1.99,
   "block": "birthday_party.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Inviting them is a nice touch even if they won't come. People complain far less about a party they were invited to.",
   "est_sec": 6.92,
   "gap_before": 0.8,
   "role": "reply",
   "block": "birthday_party.dlg19"
  },
  {
   "speaker": "user",
   "text": "Ha, sneaky.",
   "est_sec": 0.72,
   "gap_before": 0.71,
   "block": "birthday_party.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Friendly, not sneaky. And try to move things indoors and quieter after eleven.",
   "est_sec": 4.13,
   "gap_before": 0.36,
   "role": "reply",
   "block": "birthday_party.dlg19"
  }
 ]
}
