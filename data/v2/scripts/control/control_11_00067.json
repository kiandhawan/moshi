 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.54,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.96,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "I'm completely broke until payday. What can I do in the city this weekend for free?",
   "est_sec": 5.06,
   "gap_before": 0.56,
   "block": "weekend_plans.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Quite a lot. Most big museums and galleries are free, and many have late openings on Fridays or Saturdays.",
   "est_sec": 5.99,
   "gap_before": 0.38,
   "role": "reply",
   "block": "weekend_plans.dlg5"
  },
  {
   "speaker": "user",
   "text": "I've done the main museum loads of times.",
   "est_sec": 2.58,
   "gap_before": 0.74,
   "block": "weekend_plans.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then try a free walking tour, or check the local listings for open rehearsals, talks and markets.",
   "est_sec": 5.37,
   "gap_before": 0.57,
   "role": "reply",
   "block": "weekend_plans.dlg5"
  },
  {
   "speaker": "user",
   "text": "Walking tours are",
   "est_sec": 1.03,
   "gap_before": 1.29,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg5"
  },
  {
   "speaker": "user",
   "text": "free? Like actually free?",
   "est_sec": 1.34,
   "gap_before": 1.62,
   "block": "weekend_plans.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Usually pay what you like at the end, so you can just give a little. Parks often have free events at weekends too.",
   "est_sec": 7.23,
   "gap_before": 1.02,
   "role": "reply",
   "block": "weekend_plans.dlg5"
  },
  {
   "speaker": "user",
   "text": "Okay, that's a start.",
   "est_sec": 1.34,
   "gap_before": 1.45,
   "block": "weekend_plans.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Pack a lunch and a flask, and you can easily spend a whole day out for nothing.",
   "est_sec": 5.37,
   "gap_before": 0.67,
   "role": "reply",
   "block": "weekend_plans.dlg5"
  }
 ]
}
