 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.47,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.76,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "My coworker puts butter in his coffee and says it's the secret to productivity. Is that a thing?",
   "est_sec": 5.68,
   "gap_before": 0.48,
   "block": "coffee.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's a trend, often called butter coffee. People blend coffee with butter and sometimes coconut oil.",
   "est_sec": 5.06,
   "gap_before": 1.2,
   "role": "reply",
   "block": "coffee.dlg32"
  },
  {
   "speaker": "user",
   "text": "I booked the table for eight, Thabo, is that too late for you?",
   "est_sec": 4.13,
   "gap_before": 0.89,
   "block": "nq_social_043",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_043",
   "name_pos": "middle",
   "addressee": "Thabo"
  },
  {
   "speaker": "other",
   "text": "Eight's perfect, I finish at seven.",
   "est_sec": 1.96,
   "gap_before": 0.76,
   "block": "nq_social_043"
  },
  {
   "speaker": "user",
   "text": "Does it actually do anything?",
   "est_sec": 1.65,
   "gap_before": 1.6,
   "block": "coffee.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "The fat makes it more filling, so some people feel steady energy without wanting breakfast. But there isn't strong evidence that it boosts focus.",
   "est_sec": 7.54,
   "gap_before": 0.57,
   "role": "reply",
   "block": "coffee.dlg32"
  },
  {
   "speaker": "user",
   "text": "It sounds like",
   "est_sec": 1.03,
   "gap_before": 1.04,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg32"
  },
  {
   "speaker": "user",
   "text": "a lot of calories.",
   "est_sec": 1.34,
   "gap_before": 2.95,
   "block": "coffee.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It can be, often as much as a small meal. If it replaces breakfast, fine, but on top of breakfast it adds up quickly.",
   "est_sec": 7.54,
   "gap_before": 0.58,
   "role": "reply",
   "block": "coffee.dlg32"
  },
  {
   "speaker": "user",
   "text": "Should I try it?",
   "est_sec": 1.34,
   "gap_before": 2.76,
   "block": "coffee.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "If you're curious, try it once with a small amount. Blend it well, otherwise you just get an oily layer on top.",
   "est_sec": 6.92,
   "gap_before": 0.72,
   "role": "reply",
   "block": "coffee.dlg32"
  }
 ]
}
