 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.7,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.49,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "I want to see the sunrise this weekend. Never done it on purpose.",
   "est_sec": 4.13,
   "gap_before": 0.56,
   "block": "weekend_plans.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Lovely idea. Check the sunrise time for Saturday, then pick a spot with a clear view to the east, like a hill or the coast.",
   "est_sec": 7.85,
   "gap_before": 0.51,
   "role": "reply",
   "block": "weekend_plans.dlg14"
  },
  {
   "speaker": "user",
   "text": "How early do I need to be there?",
   "est_sec": 2.58,
   "gap_before": 0.31,
   "block": "weekend_plans.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "About half an hour before. The sky starts glowing well before the sun actually appears.",
   "est_sec": 4.75,
   "gap_before": 1.14,
   "role": "reply",
   "block": "weekend_plans.dlg14"
  },
  {
   "speaker": "user",
   "text": "Coffee?",
   "est_sec": 0.41,
   "gap_before": 0.61,
   "block": "weekend_plans.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Definitely, in a flask. Bring a warm layer too, dawn is often the coldest part of the day.",
   "est_sec": 5.68,
   "gap_before": 0.95,
   "role": "reply",
   "block": "weekend_plans.dlg14"
  },
  {
   "speaker": "user",
   "text": "And afterwards? I'll",
   "est_sec": 1.03,
   "gap_before": 0.83,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg14"
  },
  {
   "speaker": "user",
   "text": "be wide awake by seven.",
