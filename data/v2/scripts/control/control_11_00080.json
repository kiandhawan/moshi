 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.4,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.74,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "I'm moving to a big city and I'm not taking my car. How do I plan my life around transit?",
   "est_sec": 6.3,
   "gap_before": 0.36,
   "block": "public_transport.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Start with where you'll live. Pick somewhere within a short walk of a frequent line, ideally one that runs late.",
   "est_sec": 6.3,
   "gap_before": 1.69,
   "role": "reply",
   "block": "public_transport.dlg28"
  },
  {
   "speaker": "user",
   "text": "What counts as frequent?",
   "est_sec": 1.34,
   "gap_before": 0.4,
   "block": "public_transport.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Every ten minutes or better. Then you never really need a timetable, you just turn up.",
   "est_sec": 5.06,
   "gap_before": 0.81,
   "role": "reply",
   "block": "public_transport.dlg28"
  },
  {
   "speaker": "user",
   "text": "And groceries? I'm worried",
   "est_sec": 1.34,
   "gap_before": 1.45,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg28"
  },
  {
   "speaker": "user",
   "text": "about carrying everything.",
   "est_sec": 1.03,
   "gap_before": 2.56,
   "block": "public_transport.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A small shop near home for daily things, and online delivery for the heavy stuff. A folding trolley also helps a lot.",
   "est_sec": 6.92,
   "gap_before": 0.93,
   "role": "reply",
   "block": "public_transport.dlg28"
  },
  {
   "speaker": "user",
   "text": "What about weekends away?",
   "est_sec": 1.34,
   "gap_before": 1.19,
   "block": "public_transport.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Rent a car or use car share for the odd trip. It's usually still cheaper than owning one.",
   "est_sec": 5.68,
   "gap_before": 0.87,
   "role": "reply",
   "block": "public_transport.dlg28"
  }
 ]
}
