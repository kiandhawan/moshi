 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.31,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.81,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "I'm doing brunch for eight on Sunday and I want cinnamon rolls without getting up at five.",
   "est_sec": 5.37,
   "gap_before": 0.28,
   "block": "baking.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good news, they're perfect for an overnight rise. Make and shape them Saturday, cover the tray, and put it in the fridge.",
   "est_sec": 6.92,
   "gap_before": 1.0,
   "role": "reply",
   "block": "baking.dlg29"
  },
  {
   "speaker": "user",
   "text": "Then in the morning?",
   "est_sec": 1.34,
   "gap_before": 1.16,
   "block": "baking.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Take them out about an hour before baking so they warm up and puff a bit. Then into the oven for twenty five minutes or so.",
   "est_sec": 8.16,
   "gap_before": 0.47,
   "role": "reply",
   "block": "baking.dlg29"
  },
  {
   "speaker": "user",
   "text": "And the icing, should I",
   "est_sec": 1.65,
   "gap_before": 0.85,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg29"
  },
  {
   "speaker": "user",
   "text": "make that ahead too?",
   "est_sec": 1.34,
   "gap_before": 1.99,
   "block": "baking.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, a cream cheese icing keeps fine in the fridge. Spread it on while the rolls are still warm so it melts into the swirls.",
   "est_sec": 7.85,
   "gap_before": 0.52,
   "role": "reply",
   "block": "baking.dlg29"
  },
  {
   "speaker": "user",
   "text": "Eight people, how many rolls?",
   "est_sec": 1.65,
   "gap_before": 0.7,
   "block": "baking.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "One tray of twelve should do, with a couple of greedy seconds.",
   "est_sec": 3.82,
   "gap_before": 0.75,
   "role": "reply",
   "block": "baking.dlg29"
  }
 ]
}
