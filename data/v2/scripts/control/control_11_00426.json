 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.53,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 1.0,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "My friend and I want to sing harmonies together but I always end up singing her part.",
   "est_sec": 5.37,
   "gap_before": 0.47,
   "block": "music.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Very common. Your ear naturally follows the melody. Practise your harmony line alone first until it's solid.",
   "est_sec": 5.37,
   "gap_before": 1.61,
   "role": "reply",
   "block": "music.dlg24"
  },
  {
   "speaker": "user",
   "text": "Like on my own?",
   "est_sec": 1.34,
   "gap_before": 0.67,
   "block": "music.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes. Record the melody on your phone, then sing your part over it. When you can hold it against the recording, try it with her.",
   "est_sec": 7.85,
   "gap_before": 0.94,
   "role": "reply",
   "block": "music.dlg24"
  },
  {
   "speaker": "user",
   "text": "We tried that and I",
   "est_sec": 1.65,
   "gap_before": 1.19,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg24"
  },
  {
   "speaker": "user",
   "text": "still drifted after a while.",
   "est_sec": 1.65,
   "gap_before": 2.69,
   "block": "music.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then stand a bit apart, or cover one ear. Hearing yourself more clearly helps you stay on your own note.",
   "est_sec": 6.3,
   "gap_before": 0.87,
   "role": "reply",
   "block": "music.dlg24"
  },
  {
   "speaker": "user",
   "text": "Covering one ear, like proper singers do.",
   "est_sec": 2.27,
   "gap_before": 0.77,
   "block": "music.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. It looks dramatic, but it works.",
   "est_sec": 2.27,
   "gap_before": 0.58,
