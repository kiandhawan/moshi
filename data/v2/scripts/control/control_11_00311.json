 "est_total_sec": 56.35,
 "est_speech_sec": 44.81,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.7,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "I've got a long haul flight next week, eleven hours. What should I put on my handheld?",
   "est_sec": 5.37,
   "gap_before": 0.41,
   "block": "video_games.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Eleven hours is a lot of time. I'd bring one big game you can sink into and a few short ones for when you're tired.",
   "est_sec": 7.85,
   "gap_before": 0.64,
   "role": "reply",
   "block": "video_games.dlg5"
  },
  {
   "speaker": "user",
   "text": "What counts as a big one?",
   "est_sec": 1.96,
   "gap_before": 1.23,
   "block": "video_games.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A long role playing game or an open world adventure. Just make sure it works offline, a lot of games need internet these days.",
   "est_sec": 7.54,
   "gap_before": 0.6,
   "role": "reply",
   "block": "video_games.dlg5"
  },
  {
   "speaker": "user",
   "text": "Oh, I didn't think of that.",
   "est_sec": 1.96,
   "gap_before": 1.37,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg5"
  },
  {
   "speaker": "user",
   "text": "Plane wifi is useless.",
   "est_sec": 1.34,
   "gap_before": 2.86,
   "block": "video_games.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Download everything and launch each game once at home to check. Some need updates the first time you open them.",
   "est_sec": 6.61,
   "gap_before": 0.42,
   "role": "reply",
   "block": "video_games.dlg5"
  },
  {
   "speaker": "user",
   "text": "And battery?",
   "est_sec": 0.72,
   "gap_before": 0.58,
   "block": "video_games.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Bring a power bank and lower the screen brightness. Turn on flight mode on the handheld too, it saves a surprising amount of charge.",
   "est_sec": 7.54,
   "gap_before": 0.77,
   "role": "reply",
   "block": "video_games.dlg5"
  }
 ]
}
