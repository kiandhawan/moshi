 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.67,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.87,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "It's damp and grey for weeks. How do I dry washing indoors without the flat smelling musty?",
   "est_sec": 5.37,
   "gap_before": 0.37,
   "block": "weather_plans.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Space the clothes out on the rack so air can move between them. Don't cram everything together.",
   "est_sec": 5.37,
   "gap_before": 1.53,
   "role": "reply",
   "block": "weather_plans.dlg17"
  },
  {
   "speaker": "user",
   "text": "Mateus, did you hear Moshi pronounce croissant earlier?",
   "est_sec": 2.58,
   "gap_before": 0.72,
   "block": "mm_035",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_035",
   "name_pos": "start",
   "addressee": "Mateus"
  },
  {
   "speaker": "other",
   "text": "It was better than yours.",
   "est_sec": 1.65,
   "gap_before": 0.92,
   "block": "mm_035"
  },
  {
   "speaker": "user",
   "text": "I've got a small flat and one rack.",
   "est_sec": 2.58,
   "gap_before": 1.72,
   "block": "weather_plans.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then do smaller loads more often. Use the highest spin on your washing machine to get more water out.",
   "est_sec": 5.99,
   "gap_before": 0.6,
   "role": "reply",
   "block": "weather_plans.dlg17"
  },
  {
   "speaker": "user",
   "text": "Windows open or closed?",
   "est_sec": 1.34,
   "gap_before": 0.75,
   "block": "weather_plans.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Open a little if you can, or put the rack near an extractor fan. A dehumidifier is even better and dries things fast.",
   "est_sec": 7.23,
   "gap_before": 0.62,
   "role": "reply",
   "block": "weather_plans.dlg17"
  },
  {
   "speaker": "user",
   "text": "Are those expensive to run?",
   "est_sec": 1.65,
   "gap_before": 2.55,
   "block": "weather_plans.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Less than a tumble dryer usually. And it'll help stop mould on the walls, which is often the real musty smell.",
   "est_sec": 6.61,
   "gap_before": 0.63,
   "role": "reply",
   "block": "weather_plans.dlg17"
  }
 ]
}
