 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.88,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "A landlord wants me to send a holding deposit before I've seen the flat. He says he's abroad.",
   "est_sec": 5.68,
   "gap_before": 0.43,
   "block": "moving_house.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Please be careful. That's one of the most common rental scams.",
   "est_sec": 3.51,
   "gap_before": 0.36,
   "role": "reply",
   "block": "moving_house.dlg12"
  },
  {
   "speaker": "user",
   "text": "Hold on, really? The photos look amazing.",
   "est_sec": 2.27,
   "gap_before": 1.16,
   "block": "moving_house.dlg12",
   "kind": "wait_like",
   "phrasing": "waitlike_14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Scammers often copy photos from real listings. A rent that seems too good for the area is another warning sign.",
   "est_sec": 6.3,
   "gap_before": 0.37,
   "role": "reply",
   "block": "moving_house.dlg12"
  },
  {
   "speaker": "user",
   "text": "It is really cheap for the area, now that",
   "est_sec": 2.89,
   "gap_before": 1.3,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg12"
  },
  {
   "speaker": "user",
   "text": "I think about it.",
   "est_sec": 1.34,
   "gap_before": 2.3,
   "block": "moving_house.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Never pay before you've seen the place in person, or had a trusted person view it. And never send money by bank transfer to someone you can't verify.",
   "est_sec": 8.78,
   "gap_before": 0.55,
   "role": "reply",
   "block": "moving_house.dlg12"
  },
  {
   "speaker": "user",
   "text": "What should I do with the listing?",
   "est_sec": 2.27,
   "gap_before": 1.47,
   "block": "moving_house.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Report it to the website. You might save someone else from losing their money.",
   "est_sec": 4.44,
   "gap_before": 0.83,
   "role": "reply",
   "block": "moving_house.dlg12"
  }
 ]
}
