 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.6,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.67,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "We just moved up to the mountains and my cakes keep overflowing the tin.",
   "est_sec": 4.44,
   "gap_before": 0.24,
   "block": "baking.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's the altitude. Air pressure is lower, so the bubbles grow faster and the batter rises too much before it sets.",
   "est_sec": 6.61,
   "gap_before": 1.16,
   "role": "reply",
   "block": "baking.dlg6"
  },
  {
   "speaker": "user",
   "text": "So what do I change?",
   "est_sec": 1.65,
   "gap_before": 0.52,
   "block": "baking.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Use a little less baking powder, maybe a quarter less, and bump the oven up by about fifteen degrees so it sets sooner.",
   "est_sec": 7.23,
   "gap_before": 0.65,
   "role": "reply",
   "block": "baking.dlg6"
  },
  {
   "speaker": "user",
   "text": "Anything about",
   "est_sec": 0.72,
   "gap_before": 1.79,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg6"
  },
  {
   "speaker": "user",
   "text": "the sugar or the liquid?",
   "est_sec": 1.65,
   "gap_before": 1.7,
   "block": "baking.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, a spoonful less sugar and a spoonful more liquid usually helps. Things dry out faster up there.",
   "est_sec": 5.68,
   "gap_before": 1.0,
   "role": "reply",
   "block": "baking.dlg6"
  },
  {
   "speaker": "user",
   "text": "This is a lot of fiddling.",
   "est_sec": 1.96,
   "gap_before": 0.61,
   "block": "baking.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It is at first. Change one recipe, note what works, and you'll have a system in a couple of bakes.",
   "est_sec": 6.3,
   "gap_before": 1.6,
   "role": "reply",
   "block": "baking.dlg6"
  }
 ]
}
