 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.54,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.51,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "My friends keep saying my headset mic sounds terrible. Like I'm underwater.",
   "est_sec": 3.82,
   "gap_before": 0.37,
   "block": "video_games.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's annoying for everyone. First, is it plugged in through a cable or connected wirelessly?",
   "est_sec": 4.75,
   "gap_before": 0.61,
   "role": "reply",
   "block": "video_games.dlg20"
  },
  {
   "speaker": "user",
   "text": "Wireless, through the controller.",
   "est_sec": 1.34,
   "gap_before": 1.16,
   "block": "video_games.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Check the console's audio settings. Sometimes the mic is set to very low quality to save bandwidth, or a monitor setting adds an echo.",
   "est_sec": 7.54,
   "gap_before": 0.78,
   "role": "reply",
   "block": "video_games.dlg20"
  },
  {
   "speaker": "user",
   "text": "The cat's crying at the door. Elif, has she been fed?",
   "est_sec": 3.51,
   "gap_before": 1.33,
   "block": "nq_home_041",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_041",
   "name_pos": "middle",
   "addressee": "Elif"
  },
  {
   "speaker": "other",
   "text": "Twice. She's lying to you.",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "block": "nq_home_041"
  },
  {
   "speaker": "user",
   "text": "There is a",
   "est_sec": 1.03,
   "gap_before": 1.46,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg20"
  },
  {
   "speaker": "user",
   "text": "mic level slider.",
   "est_sec": 1.03,
   "gap_before": 2.9,
   "block": "video_games.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Try lowering the input level a bit. If it's too high, it distorts, which can sound muffled. Also check the mic isn't touching your face or cheek.",
   "est_sec": 8.47,
   "gap_before": 1.02,
   "role": "reply",
   "block": "video_games.dlg20"
  },
  {
   "speaker": "user",
   "text": "It kind of is.",
   "est_sec": 1.34,
   "gap_before": 0.78,
   "block": "video_games.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Move it about two fingers' width from your mouth, slightly to the side. That alone often fixes the underwater sound.",
   "est_sec": 6.3,
   "gap_before": 1.19,
   "role": "reply",
   "block": "video_games.dlg20"
