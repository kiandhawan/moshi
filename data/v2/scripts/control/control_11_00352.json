 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.88,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "Honestly, music was just better when I was young.",
   "est_sec": 2.89,
   "gap_before": 0.57,
   "block": "music.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Lots of people feel that. The music from your teens often sticks with us the most, because it's tied to so many big moments.",
   "est_sec": 7.54,
   "gap_before": 1.49,
   "role": "reply",
   "block": "music.dlg27"
  },
  {
   "speaker": "user",
   "text": "So it's not actually better, Moshi?",
   "est_sec": 1.96,
   "gap_before": 1.15,
   "block": "music.dlg27",
   "kind": "moshi_name",
   "name_pos": "end",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's better for you, maybe. Every decade has great songs and terrible ones. We just remember the great ones from our own time.",
   "est_sec": 7.23,
   "gap_before": 0.39,
   "role": "reply",
   "block": "music.dlg27"
  },
  {
   "speaker": "user",
   "text": "Hmm. That's annoyingly",
   "est_sec": 1.03,
   "gap_before": 0.96,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg27"
  },
  {
   "speaker": "user",
   "text": "reasonable.",
   "est_sec": 0.41,
   "gap_before": 2.85,
   "block": "music.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ha. If you want, tell me a couple of songs you loved back then, and I'll suggest some newer stuff with a similar feel.",
   "est_sec": 7.54,
   "gap_before": 0.63,
   "role": "reply",
   "block": "music.dlg27"
  },
  {
   "speaker": "user",
   "text": "Okay, mostly guitar bands with big choruses.",
   "est_sec": 2.27,
   "gap_before": 1.3,
   "block": "music.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then there's plenty out there now. Lots of newer indie bands are clearly inspired by that sound.",
   "est_sec": 5.37,
   "gap_before": 0.88,
   "role": "reply",
   "block": "music.dlg27"
  }
 ]
