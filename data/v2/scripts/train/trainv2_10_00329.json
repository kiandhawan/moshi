 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.37,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "I want a photo booth at my party but renting one is crazy expensive.",
   "est_sec": 4.44,
   "gap_before": 0.24,
   "block": "birthday_party.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can make one easily. Do you have a blank wall and a phone tripod?",
   "est_sec": 4.75,
   "gap_before": 0.93,
   "role": "reply",
   "block": "birthday_party.dlg29"
  },
  {
   "speaker": "user",
   "text": "Wall yes, tripod no.",
   "est_sec": 1.34,
   "gap_before": 0.37,
   "block": "birthday_party.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A stack of books works as a tripod. Hang a sheet of shiny curtain or wrapping paper on the wall and add a lamp in front for good light.",
   "est_sec": 9.09,
   "gap_before": 0.48,
   "role": "reply",
   "block": "birthday_party.dlg29"
  },
  {
   "speaker": "user",
   "text": "And props?",
   "est_sec": 0.72,
   "gap_before": 1.04,
   "block": "birthday_party.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Cardboard speech bubbles, silly hats, big sunglasses. Charity shops are brilliant for cheap props.",
   "est_sec": 4.44,
   "gap_before": 0.69,
   "role": "reply",
   "block": "birthday_party.dlg29"
  },
  {
   "speaker": "user",
   "text": "Changing the subject, I keep getting those pay later offers when I shop online.",
   "est_sec": 4.44,
   "gap_before": 0.86,
   "block": "personal_finance.ctx8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "They're tempting. Do you want to stop using them completely, or set yourself a rule, like only one at a time?",
   "est_sec": 6.61,
   "gap_before": 1.06,
   "role": "reply",
   "block": "personal_finance.ctx8"
  },
  {
   "speaker": "user",
   "text": "Let me mull it over for twenty seconds. Then ask me again.",
   "est_sec": 3.82,
   "gap_before": 0.57,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 20,
   "phrasing": "think_instr_13"
  },
  {
   "speaker": "moshi",
   "text": "So, no more pay later, or one at a time?",
