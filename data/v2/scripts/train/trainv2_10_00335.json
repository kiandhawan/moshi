 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.47,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "Help, I'm hosting book club tonight and I didn't finish the book.",
   "est_sec": 3.82,
   "gap_before": 0.42,
   "block": "books.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Don't panic. How far did you get?",
   "est_sec": 2.27,
   "gap_before": 1.12,
   "role": "reply",
   "block": "books.dlg17"
  },
  {
   "speaker": "user",
   "text": "About halfway. Everyone is going to know.",
   "est_sec": 2.27,
   "gap_before": 0.82,
   "block": "books.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Honestly, half the club probably didn't finish either. You could ask open questions and let others lead.",
   "est_sec": 5.37,
   "gap_before": 1.18,
   "role": "reply",
   "block": "books.dlg17"
  },
  {
   "speaker": "user",
   "text": "Like what?",
   "est_sec": 0.72,
   "gap_before": 0.44,
   "block": "books.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Things like which character people related to most, or whether the title makes sense now. Those work no matter where you stopped.",
   "est_sec": 6.92,
   "gap_before": 0.66,
   "role": "reply",
   "block": "books.dlg17"
  },
  {
   "speaker": "user",
   "text": "Should I just confess?",
   "est_sec": 1.34,
   "gap_before": 1.31,
   "block": "books.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A cheerful confession at the start often goes down well. Then ask them not to spoil the ending, and you're the one with the most to look forward to.",
   "est_sec": 9.09,
   "gap_before": 1.62,
   "role": "reply",
   "block": "books.dlg17"
  }
