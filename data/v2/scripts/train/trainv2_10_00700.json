 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.99,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "My dog's breath could strip paint. What can I do?",
   "est_sec": 3.2,
   "gap_before": 0.34,
   "block": "pets.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Bad breath is often a sign of plaque or gum problems. A vet check is a good first step to look at his teeth.",
   "est_sec": 7.54,
   "gap_before": 0.95,
   "role": "reply",
   "block": "pets.dlg19"
  },
  {
   "speaker": "user",
   "text": "Can I just brush them?",
   "est_sec": 1.65,
   "gap_before": 1.44,
   "block": "pets.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, brushing is the gold standard. Use a dog toothpaste, never human, and a soft brush or a finger brush.",
   "est_sec": 6.3,
   "gap_before": 1.04,
   "role": "reply",
   "block": "pets.dlg19"
  },
  {
   "speaker": "user",
   "text": "He'd bite the brush in half.",
   "est_sec": 1.96,
   "gap_before": 0.35,
   "block": "pets.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Start small. Let him lick the toothpaste off your finger for a few days, then rub his gums gently, and build up from there.",
   "est_sec": 7.54,
   "gap_before": 0.42,
   "role": "reply",
   "block": "pets.dlg19"
  },
  {
   "speaker": "user",
   "text": "And dental chews?",
   "est_sec": 1.03,
   "gap_before": 0.81,
   "block": "pets.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "They help a bit, but they're not a replacement for brushing. Pick ones approved for dental health and count them as part of his food.",
   "est_sec": 7.85,
   "gap_before": 0.71,
   "role": "reply",
   "block": "pets.dlg19"
  }
 ]
}
