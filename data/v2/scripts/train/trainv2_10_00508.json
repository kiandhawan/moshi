   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ha, autocorrect strikes again. Save Saoirse as a contact, phones usually learn names from your contacts.",
   "est_sec": 5.06,
   "gap_before": 1.47,
   "role": "reply",
   "block": "smartphones.dlg30"
  },
  {
   "speaker": "user",
   "text": "You're not going out in shorts in this cold, Violet?",
