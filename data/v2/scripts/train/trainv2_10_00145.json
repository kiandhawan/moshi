   "text": "special editions with extras.",
   "est_sec": 1.34,
   "gap_before": 1.75,
   "block": "movies.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Those are worth checking. Collectors sometimes pay well for rare editions, especially boxed sets.",
   "est_sec": 4.44,
   "gap_before": 0.95,
   "role": "reply",
   "block": "movies.dlg29"
  },
  {
   "speaker": "user",
   "text": "Okay, sorting weekend it is.",
   "est_sec": 1.65,
   "gap_before": 1.03,
   "block": "movies.dlg29",
