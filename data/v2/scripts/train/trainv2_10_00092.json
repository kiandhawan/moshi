 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.66,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.47,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "How do I pick a good vet? We've just moved here.",
   "est_sec": 3.51,
   "gap_before": 0.25,
   "block": "pets.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ask neighbours with pets and check local reviews. Then ring a couple of practices and see how they treat you on the phone.",
   "est_sec": 7.23,
   "gap_before": 1.1,
   "role": "reply",
   "block": "pets.dlg18"
  },
  {
   "speaker": "user",
   "text": "What should I ask them?",
   "est_sec": 1.65,
   "gap_before": 1.44,
   "block": "pets.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ask about out of hours emergencies, whether they have a vet that likes cats or exotics if you need that, and how easy appointments are to get.",
   "est_sec": 8.47,
   "gap_before": 1.05,
   "role": "reply",
   "block": "pets.dlg18"
  },
  {
   "speaker": "user",
   "text": "Unrelated, but It's supposed to be really hot tomorrow.",
   "est_sec": 2.89,
   "gap_before": 0.79,
   "block": "weather_plans.ctx2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "How hot are we talking?",
   "est_sec": 1.65,
   "gap_before": 0.76,
   "role": "reply",
   "block": "weather_plans.ctx2"
  },
  {
   "speaker": "user",
   "text": "Close to a hundred, and I promised the kids an outing.",
   "est_sec": 3.51,
   "gap_before": 1.02,
   "block": "weather_plans.ctx2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then maybe the pool, or somewhere indoors like a museum. Which would they enjoy more?",
   "est_sec": 4.75,
   "gap_before": 0.51,
   "role": "reply",
   "block": "weather_plans.ctx2"
  },
  {
   "speaker": "user",
   "text": "I'm not sure. Wait twenty-two seconds and ask me again.",
   "est_sec": 3.2,
   "gap_before": 0.39,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 22,
   "phrasing": "think_instr_08"
  },
  {
   "speaker": "moshi",
   "text": "So, pool day or a cool museum for the kids tomorrow?",
   "est_sec": 3.51,
   "role": "resume",
   "block": "weather_plans.ctx2",
   "anchor": {
    "turn": 10,
    "offset": 22.33
   }
  },
  {
   "speaker": "user",
   "text": "Museum. My youngest burns way too easily.",
