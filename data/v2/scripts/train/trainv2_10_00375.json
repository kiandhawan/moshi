 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.38,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.51,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "I have to recite a poem in English class on Monday. Forty lines. I'm going to die.",
   "est_sec": 5.37,
   "gap_before": 0.41,
   "block": "studying.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You'll survive, I promise. Have you got a favourite way of learning things by heart?",
   "est_sec": 4.75,
   "gap_before": 0.54,
   "role": "reply",
   "block": "studying.dlg7"
  },
  {
   "speaker": "user",
   "text": "Not really. I just read it again and again.",
   "est_sec": 2.89,
   "gap_before": 1.05,
   "block": "studying.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Try learning it in chunks of four lines. Say the first chunk out loud until you can do it without looking, then add the next.",
   "est_sec": 7.85,
   "gap_before": 1.06,
   "role": "reply",
   "block": "studying.dlg7"
  },
  {
   "speaker": "user",
   "text": "Hi Hiro, did you bring the spare key for the meeting room?",
   "est_sec": 3.82,
   "gap_before": 0.77,
   "block": "nq_work_037",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_work_037",
   "name_pos": "start",
   "addressee": "Hiro"
  },
  {
   "speaker": "other",
   "text": "It's on my lanyard.",
   "est_sec": 1.34,
   "gap_before": 0.8,
   "block": "nq_work_037"
  },
  {
   "speaker": "user",
   "text": "That takes forever.",
   "est_sec": 1.03,
   "gap_before": 1.55,
   "block": "studying.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's faster than rereading. Walk around while you practise, moving actually helps memory.",
   "est_sec": 4.13,
   "gap_before": 0.77,
   "role": "reply",
   "block": "studying.dlg7"
  },
  {
   "speaker": "user",
   "text": "And if I forget a line",
   "est_sec": 1.96,
   "gap_before": 1.5,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg7"
  },
  {
   "speaker": "user",
   "text": "in front of everyone?",
   "est_sec": 1.34,
   "gap_before": 1.56,
   "block": "studying.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Pause, breathe, and carry on from where you remember. Most people won't even notice.",
   "est_sec": 4.44,
   "gap_before": 1.93,
   "role": "reply",
   "block": "studying.dlg7"
  }
