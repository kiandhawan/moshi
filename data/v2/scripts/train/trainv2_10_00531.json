 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.74,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.95,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I'm seventy-two and I've never read any poetry. Is it too late to start?",
   "est_sec": 4.44,
   "gap_before": 0.58,
   "block": "books.ctx6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not at all. Would you like to begin with short modern poems, or with the older classics you might have heard of?",
   "est_sec": 6.92,
   "gap_before": 0.64,
   "role": "reply",
   "block": "books.ctx6"
  },
  {
   "speaker": "user",
   "text": "Sorry, can you wait? My friend is talking to me. Keep quiet until I come back.",
   "est_sec": 5.06,
   "gap_before": 0.8,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_17"
  },
  {
   "speaker": "user",
   "text": "Leo, which stop do we get off at for the museum?",
   "est_sec": 3.51,
   "gap_before": 0.97,
   "event": "distractor",
   "kind": "friend_question",
   "block": "public_transport.side1"
  },
  {
   "speaker": "friend",
   "text": "I think it's the one after the big park. Central Square?",
   "est_sec": 3.51,
   "gap_before": 1.4,
   "block": "public_transport.side1"
  },
  {
   "speaker": "user",
   "text": "Are you sure? The map says there's a stop called Museum Road.",
   "est_sec": 3.82,
   "gap_before": 3.35,
   "block": "public_transport.side1"
  },
  {
   "speaker": "friend",
   "text": "Oh, maybe that's closer. Let me look.",
   "est_sec": 2.27,
   "gap_before": 2.66,
   "block": "public_transport.side1"
  },
  {
   "speaker": "user",
   "text": "It's two stops from here.",
   "est_sec": 1.65,
   "gap_before": 2.7,
   "block": "public_transport.side1"
  },
  {
   "speaker": "friend",
   "text": "Okay, Museum Road then. Get ready, it's coming up fast.",
   "est_sec": 3.2,
   "gap_before": 1.08,
   "block": "public_transport.side1"
  },
  {
   "speaker": "user",
   "text": "Is the dryer done, or is it still going?",
   "est_sec": 2.89,
   "gap_before": 1.0,
   "event": "distractor",
   "kind": "near_miss",
   "phrasing": "dn_49"
  },
  {
   "speaker": "friend",
   "text": "It beeped a minute ago.",
   "est_sec": 1.65,
   "gap_before": 1.67,
   "phrasing": "dn_49"
  },
  {
   "speaker": "user",
   "text": "Right, she's sorted. Over to you, Moshi.",
   "est_sec": 2.27,
   "gap_before": 0.79,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_v2_19"
  },
  {
   "speaker": "moshi",
   "text": "No problem. About starting poetry. Modern and short, or the old classics?",
   "est_sec": 3.82,
   "gap_before": 0.69,
   "role": "resume",
   "block": "books.ctx6"
  },
  {
   "speaker": "user",
   "text": "Right, next thing. Why does my washing machine smell like a swamp? It's supposed to clean things.",
   "est_sec": 5.37,
   "gap_before": 1.98,
   "block": "cleaning.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ironic, right? Usually it's damp left in the rubber seal and the detergent drawer. Mould loves it.",
   "est_sec": 5.37,
   "gap_before": 1.08,
   "role": "reply",
   "block": "cleaning.dlg7"
  }
 ]
