 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.81,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "My friend is visiting this weekend and she doesn't drink. Most of my plans involve pubs. Oops.",
   "est_sec": 5.37,
   "gap_before": 0.59,
   "block": "weekend_plans.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Easy fix. There's lots to do without alcohol, like a bowling alley, a food market or a comedy show.",
   "est_sec": 5.99,
   "gap_before": 0.77,
   "role": "reply",
   "block": "weekend_plans.dlg9"
  },
  {
   "speaker": "user",
   "text": "Are you feeling any better today, Darnell?",
   "est_sec": 2.27,
   "gap_before": 0.31,
   "block": "nq_social_070",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_070",
   "name_pos": "end",
   "addressee": "Darnell"
  },
  {
   "speaker": "user",
   "text": "Comedy could be good. She loves to laugh.",
   "est_sec": 2.58,
   "gap_before": 2.11,
   "block": "weekend_plans.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Book a small club night, they're cheap and often really fun. You could grab dinner first.",
   "est_sec": 5.06,
   "gap_before": 1.17,
   "role": "reply",
   "block": "weekend_plans.dlg9"
  },
  {
   "speaker": "user",
   "text": "And Sunday?",
   "est_sec": 0.72,
   "gap_before": 1.3,
   "block": "weekend_plans.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Maybe a long walk and brunch, or a cooking class together if there's one nearby.",
   "est_sec": 4.75,
   "gap_before": 0.58,
   "role": "reply",
   "block": "weekend_plans.dlg9"
  },
  {
   "speaker": "user",
   "text": "Okay, that's",
   "est_sec": 0.72,
   "gap_before": 0.52,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg9"
  },
  {
