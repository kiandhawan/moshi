 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.36,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.8,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "We've got a week off in spring and want somewhere warm, but not a twelve hour flight.",
   "est_sec": 5.37,
   "gap_before": 0.5,
   "block": "travel_planning.ctx1",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Lisbon, Seville or one of the Greek islands would all fit. Are you more in the mood for a city or a beach?",
   "est_sec": 7.23,
   "gap_before": 0.75,
   "role": "reply",
   "block": "travel_planning.ctx1"
  },
  {
   "speaker": "user",
   "text": "Let me chew on that for seventeen seconds.",
   "est_sec": 2.58,
   "gap_before": 0.36,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 17,
   "phrasing": "think_instruction_v2_17"
  },
  {
   "speaker": "moshi",
   "text": "So, have you made up your mind? City break or beach?",
   "est_sec": 3.51,
   "role": "resume",
   "block": "travel_planning.ctx1",
   "anchor": {
    "turn": 4,
    "offset": 17.17
   }
  },
  {
   "speaker": "user",
   "text": "Beach. We need a proper rest this time.",
   "est_sec": 2.58,
   "gap_before": 0.51,
   "event": "ordinary_request",
   "block": "travel_planning.ctx1"
  },
  {
   "speaker": "moshi",
   "text": "A Greek island it is. Crete is easy to reach and still quiet in spring.",
   "est_sec": 4.75,
   "gap_before": 1.01,
   "role": "followup",
   "block": "travel_planning.ctx1"
  },
  {
   "speaker": "user",
   "text": "Right, next thing. I found a load of board games at a car boot sale for really cheap. How do I check they've got all the pieces?",
   "est_sec": 8.47,
   "gap_before": 1.02,
   "block": "board_games.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most rulebooks have a list of components near the front. Count everything against that list.",
   "est_sec": 4.75,
   "gap_before": 0.54,
   "role": "reply",
   "block": "board_games.dlg16"
  },
  {
   "speaker": "user",
   "text": "What if there's no rulebook?",
   "est_sec": 1.65,
   "gap_before": 1.26,
   "block": "board_games.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Search the game name online, the component list is usually on the publisher's site.",
   "est_sec": 4.44,
   "gap_before": 1.04,
   "role": "reply",
   "block": "board_games.dlg16"
  }
 ]
}
