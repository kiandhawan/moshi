 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.63,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "How do I use my phone abroad without paying a fortune?",
   "est_sec": 3.51,
   "gap_before": 0.6,
   "block": "travel_planning.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "The cheapest option is usually a local or travel eSIM. You buy a data plan online and install it before you leave.",
   "est_sec": 6.92,
   "gap_before": 0.7,
   "role": "reply",
   "block": "travel_planning.dlg16"
  },
  {
   "speaker": "user",
   "text": "Hold on a sec, what's an eSIM? Is it a physical thing?",
   "est_sec": 3.82,
   "gap_before": 1.68,
   "block": "travel_planning.dlg16",
   "kind": "wait_like",
   "phrasing": "waitlike_17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "No, it's digital. Your phone downloads it, like an app, as long as your phone supports it.",
   "est_sec": 5.37,
   "gap_before": 0.72,
   "role": "reply",
   "block": "travel_planning.dlg16"
  },
  {
   "speaker": "user",
   "text": "How do I check that?",
   "est_sec": 1.65,
   "gap_before": 0.35,
   "block": "travel_planning.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Look in your settings under mobile data or cellular. If there's an option to add an eSIM, you're good.",
   "est_sec": 5.99,
   "gap_before": 1.16,
   "role": "reply",
   "block": "travel_planning.dlg16"
  },
  {
   "speaker": "user",
   "text": "And my normal number",
   "est_sec": 1.34,
   "gap_before": 1.25,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg16"
  },
  {
   "speaker": "user",
   "text": "still works for texts?",
   "est_sec": 1.34,
   "gap_before": 1.75,
   "block": "travel_planning.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, you can keep your normal SIM active for calls and texts. Just turn off its data roaming so you're not charged.",
   "est_sec": 6.92,
   "gap_before": 0.98,
   "role": "reply",
   "block": "travel_planning.dlg16"
  }
 ]
}
