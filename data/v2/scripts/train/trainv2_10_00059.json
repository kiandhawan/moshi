 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.66,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.7,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "I'm a retired teacher and I just bought my first camera. I want to photograph birds in my garden.",
   "est_sec": 5.99,
   "gap_before": 0.22,
   "block": "photography.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Lovely hobby. A bird feeder near a window gives you a steady stream of subjects without scaring them off.",
   "est_sec": 5.99,
   "gap_before": 0.64,
   "role": "reply",
   "block": "photography.dlg4"
  },
  {
   "speaker": "user",
   "text": "They fly off as soon as",
   "est_sec": 1.96,
   "gap_before": 0.59,
   "event": "distractor",
   "kind": "pause",
   "block": "photography.dlg4"
  },
  {
   "speaker": "user",
   "text": "I open the back door.",
   "est_sec": 1.65,
   "gap_before": 1.81,
   "block": "photography.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Shoot from inside through an open window, or sit very still outside for ten minutes. Birds get used to a quiet person surprisingly fast.",
   "est_sec": 7.54,
   "gap_before": 0.76,
   "role": "reply",
   "block": "photography.dlg4"
  },
  {
   "speaker": "user",
   "text": "And what setting should I use? They move so quickly.",
   "est_sec": 3.2,
   "gap_before": 0.93,
   "block": "photography.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Use a fast shutter speed, around one thousandth of a second, and burst mode. Then keep the sharpest shot.",
   "est_sec": 5.99,
   "gap_before": 1.14,
   "role": "reply",
   "block": "photography.dlg4"
  },
  {
   "speaker": "user",
   "text": "Burst mode is the one that clicks a lot?",
   "est_sec": 2.89,
   "gap_before": 0.32,
   "block": "photography.dlg4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's the one. Hold the button down and it takes several photos per second.",
   "est_sec": 4.44,
   "gap_before": 1.14,
   "role": "reply",
   "block": "photography.dlg4"
  }
 ]
}
