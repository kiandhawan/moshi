   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "My kids want to camp in the garden on Saturday night.",
   "est_sec": 3.51,
   "gap_before": 0.34,
   "block": "weekend_plans.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a lovely adventure without the long drive. Do you have a tent?",
   "est_sec": 4.13,
   "gap_before": 1.08,
   "role": "reply",
   "block": "weekend_plans.dlg26"
  },
  {
   "speaker": "user",
   "text": "So Aaliyah, did your mum like the hotel?",
