  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.47,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "When should I plant tulip bulbs?",
   "est_sec": 1.96,
   "gap_before": 0.48,
   "block": "gardening.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "In autumn, once the soil has cooled down. Late October to November is usually ideal.",
   "est_sec": 4.75,
   "gap_before": 0.34,
   "role": "reply",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "user",
   "text": "How deep do they go?",
   "est_sec": 1.65,
   "gap_before": 1.44,
   "block": "gardening.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "About three times the height of the bulb, so roughly fifteen to twenty centimeters, pointy end up.",
   "est_sec": 5.37,
   "gap_before": 0.83,
   "role": "reply",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "user",
   "text": "Wait, and can I put them in pots? I was hoping to",
   "est_sec": 3.82,
   "gap_before": 0.89,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "user",
   "text": "put a few by the front door.",
   "est_sec": 2.27,
   "gap_before": 2.37,
   "block": "gardening.dlg2",
   "kind": "wait_like",
   "phrasing": "waitlike_13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, tulips look great in pots. Pack them closely together and make sure the pot drains well.",
   "est_sec": 5.37,
   "gap_before": 0.84,
   "role": "reply",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "user",
   "text": "Do they come back every year?",
   "est_sec": 1.96,
   "gap_before": 1.14,
   "block": "gardening.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Some do, but many fade after the first year. Lots of people just plant fresh ones each autumn.",
   "est_sec": 5.68,
   "gap_before": 0.51,
   "role": "reply",
   "block": "gardening.dlg2"
  }
 ]
