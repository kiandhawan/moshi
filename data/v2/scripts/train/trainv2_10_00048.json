  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.48,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.98,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "What are my chances of seeing the northern lights in Iceland in late February?",
   "est_sec": 4.44,
   "gap_before": 0.23,
   "block": "travel_planning.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Late February is actually a decent time. The nights are still long, and the season runs roughly from September to April.",
   "est_sec": 6.61,
   "gap_before": 0.46,
   "role": "reply",
   "block": "travel_planning.dlg24"
  },
  {
   "speaker": "user",
   "text": "There's a snowstorm coming Thursday night and I'm supposed to drive to my sister's on Friday.",
   "est_sec": 5.06,
   "gap_before": 1.11,
   "block": "weather_plans.ctx3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That could make the roads rough. Would you rather leave Thursday afternoon before it hits, or wait and go Saturday?",
   "est_sec": 6.3,
   "gap_before": 0.86,
   "role": "reply",
   "block": "weather_plans.ctx3"
  },
  {
   "speaker": "user",
   "text": "You've stumped me. I reckon twenty-four seconds should do it.",
   "est_sec": 3.2,
   "gap_before": 1.19,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 24,
   "phrasing": "think_instruction_v2_47"
  },
  {
   "speaker": "moshi",
   "text": "Okay, no rush.",
   "est_sec": 1.03,
   "gap_before": 0.33,
   "role": "ack",
   "phrasing": "ack_10"
  },
  {
   "speaker": "user",
   "text": "Hmm, decisions, decisions.",
   "est_sec": 1.03,
   "anchor": {
    "turn": 6,
    "offset": 12.55
   },
   "event": "distractor",
   "kind": "self_talk",
   "phrasing": "self_26"
  },
  {
