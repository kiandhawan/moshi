   "text": "So, are you leaving early on Thursday or holding off until Saturday?",
   "est_sec": 3.82,
   "role": "resume",
   "block": "weather_plans.ctx3",
   "anchor": {
    "turn": 6,
    "offset": 24.07
   }
  },
