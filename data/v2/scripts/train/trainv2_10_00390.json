 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.45,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.31,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I'm making an album for my gran's eightieth. Printing about sixty photos.",
   "est_sec": 3.82,
   "gap_before": 0.3,
   "block": "photography.ctx5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a lovely gift. Do you want glossy prints that really pop, or matte ones that feel softer and don't show fingerprints?",
   "est_sec": 6.92,
   "gap_before": 0.63,
   "role": "reply",
   "block": "photography.ctx5"
  },
  {
   "speaker": "user",
   "text": "I haven't the foggiest yet, Moshi. Circle round to me in twenty-one seconds.",
   "est_sec": 4.13,
   "gap_before": 1.47,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 21,
   "phrasing": "think_instruction_v2_46"
  },
  {
   "speaker": "moshi",
   "text": "Take your time.",
   "est_sec": 1.03,
   "gap_before": 0.24,
   "role": "ack",
   "phrasing": "ack_09"
  },
  {
   "speaker": "user",
   "text": "Okay, let me just picture it.",
   "est_sec": 1.96,
   "anchor": {
    "turn": 4,
    "offset": 12.29
   },
   "event": "distractor",
   "kind": "self_talk",
   "phrasing": "self_29"
  },
  {
   "speaker": "moshi",
   "text": "Back to the prints. Have you landed on glossy or matte?",
   "est_sec": 3.51,
   "role": "resume",
   "block": "photography.ctx5",
   "anchor": {
    "turn": 4,
    "offset": 21.33
   }
  },
  {
   "speaker": "user",
   "text": "Matte. She'll be passing it round the whole family, there'll be fingers everywhere.",
   "est_sec": 4.13,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "photography.ctx5"
  },
  {
   "speaker": "moshi",
   "text": "Smart. Matte also hides glare under her reading lamp, so she'll see the faces better.",
   "est_sec": 4.75,
   "gap_before": 0.43,
   "role": "followup",
   "block": "photography.ctx5"
  },
  {
   "speaker": "user",
   "text": "The ref's blind. Elif, was that a penalty or not?",
   "est_sec": 3.2,
   "gap_before": 0.96,
   "block": "nq_social_052",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_052",
   "name_pos": "middle",
   "addressee": "Elif"
  },
  {
   "speaker": "user",
   "text": "How long should I rest between sets? I usually scroll my phone until I feel like it.",
   "est_sec": 5.37,
   "gap_before": 2.06,
   "block": "fitness.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a very common approach. It depends on your goal, though.",
   "est_sec": 3.51,
   "gap_before": 0.8,
   "role": "reply",
   "block": "fitness.dlg28"
  },
  {
   "speaker": "user",
   "text": "Strength, mostly. Getting stronger.",
