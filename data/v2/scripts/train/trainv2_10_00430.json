   "event": "distractor",
   "kind": "friend_interrupt",
   "phrasing": "friend_interrupt_v2_04"
  },
  {
   "speaker": "user",
   "text": "Sorry, Moshi, I need to answer him. I'll check in again when we're finished.",
   "est_sec": 4.44,
   "gap_before": 0.85,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instruction_v2_59"
  },
  {
