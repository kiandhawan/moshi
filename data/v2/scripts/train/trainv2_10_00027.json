 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.91,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "I'm sixty three and applying for a part time job at a garden centre. I'm worried they'll think I'm overqualified.",
   "est_sec": 6.3,
   "gap_before": 0.3,
   "block": "job_interview.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "What did you do before?",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "role": "reply",
   "block": "job_interview.dlg9"
  },
  {
   "speaker": "user",
   "text": "Thirty years as a bank branch manager.",
   "est_sec": 2.27,
   "gap_before": 1.05,
   "block": "job_interview.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a lot of experience with customers and teams. The key is showing why you genuinely want this particular job now.",
   "est_sec": 6.61,
   "gap_before": 0.43,
   "role": "reply",
   "block": "job_interview.dlg9"
  },
  {
   "speaker": "user",
   "text": "Jose, how many eggs are left in the fridge?",
   "est_sec": 2.89,
   "gap_before": 1.35,
   "block": "nq_home_012",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_012",
   "name_pos": "start",
   "addressee": "Jose"
  },
  {
   "speaker": "other",
   "text": "Two, and one's cracked.",
   "est_sec": 1.34,
   "gap_before": 0.68,
   "block": "nq_home_012"
  },
  {
   "speaker": "user",
   "text": "Honestly, I just love plants and I want less stress.",
   "est_sec": 3.2,
   "gap_before": 1.99,
   "block": "job_interview.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Say exactly that. It's honest and it reassures them you won't leave for something bigger in a month.",
   "est_sec": 5.68,
   "gap_before": 1.15,
   "role": "reply",
   "block": "job_interview.dlg9"
  },
  {
   "speaker": "user",
   "text": "Should I play down the manager thing",
   "est_sec": 2.27,
   "gap_before": 0.52,
   "event": "distractor",
   "kind": "pause",
   "block": "job_interview.dlg9"
  },
  {
   "speaker": "user",
   "text": "or is that silly?",
   "est_sec": 1.34,
   "gap_before": 2.7,
   "block": "job_interview.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Don't hide it. Just frame it as, I've done the big job, now I want to work with my hands and help people.",
   "est_sec": 7.23,
   "gap_before": 0.51,
   "role": "reply",
   "block": "job_interview.dlg9"
  }
