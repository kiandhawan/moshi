 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.65,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.71,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "I want to make bagels. Do I really have to boil them?",
   "est_sec": 3.82,
   "gap_before": 0.36,
   "block": "baking.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You do, if you want a proper bagel. The boil sets the crust and gives them that chewy, shiny outside.",
   "est_sec": 6.3,
   "gap_before": 0.36,
   "role": "reply",
   "block": "baking.dlg23"
  },
  {
   "speaker": "user",
   "text": "Did Moshi ever find that song you were humming, Ji-woo?",
   "est_sec": 3.2,
   "gap_before": 0.34,
   "block": "mm_084",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_084",
   "name_pos": "end",
   "addressee": "Ji-woo"
  },
  {
   "speaker": "other",
   "text": "No, I hummed it badly.",
   "est_sec": 1.65,
   "gap_before": 0.47,
   "block": "mm_084"
  },
  {
   "speaker": "user",
   "text": "Have you seen my slippers, Alex?",
   "est_sec": 1.96,
   "gap_before": 1.56,
   "block": "nq_home_053",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_053",
   "name_pos": "end",
   "addressee": "Alex"
  },
  {
   "speaker": "user",
   "text": "For how long?",
   "est_sec": 1.03,
   "gap_before": 1.99,
   "block": "baking.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "About a minute on each side. Add a spoonful of honey or baking soda to the water for colour.",
   "est_sec": 5.99,
   "gap_before": 1.17,
   "role": "reply",
   "block": "baking.dlg23"
  },
  {
   "speaker": "user",
   "text": "How do you even",
   "est_sec": 1.34,
   "gap_before": 1.24,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg23"
  },
  {
   "speaker": "user",
   "text": "shape them? Mine always look like lumpy doughnuts.",
   "est_sec": 2.58,
   "gap_before": 2.63,
   "block": "baking.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Roll a rope, wrap it around your hand, overlap the ends under your palm and roll them together on the counter.",
   "est_sec": 6.61,
   "gap_before": 0.3,
   "role": "reply",
   "block": "baking.dlg23"
  },
  {
   "speaker": "user",
   "text": "Okay that sounds more doable than poking a hole.",
   "est_sec": 2.89,
   "gap_before": 0.63,
   "block": "baking.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Both work, but the rope method gives a more even ring. And don't worry about lumps, homemade looks charming.",
   "est_sec": 5.99,
   "gap_before": 0.36,
   "role": "reply",
   "block": "baking.dlg23"
  }
 ]
