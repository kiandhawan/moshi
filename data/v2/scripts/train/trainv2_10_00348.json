   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "I'm nineteen and I just got my first proper paycheck.",
   "est_sec": 3.2,
   "gap_before": 0.6,
   "block": "personal_finance.ctx6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Congrats! Before it disappears, do you want to set up an automatic transfer to savings, or try a budget for a month first and see where it goes?",
   "est_sec": 8.78,
   "gap_before": 0.94,
   "role": "reply",
   "block": "personal_finance.ctx6"
  },
  {
   "speaker": "user",
   "text": "Wait for me, I need to talk to Rosa about something. Don't say a word until I'm back.",
   "est_sec": 5.68,
   "gap_before": 1.25,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_28"
  },
  {
   "speaker": "user",
   "text": "Rosa, have you seen my ticket? I swear I had it at the barrier.",
   "est_sec": 4.44,
   "gap_before": 0.69,
   "block": "public_transport.side5"
  },
  {
   "speaker": "friend",
   "text": "Check your coat pocket.",
