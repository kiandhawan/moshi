 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.55,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "I sell jam at an outdoor market on Saturdays. Rain's forecast. Should I still go?",
   "est_sec": 4.75,
   "gap_before": 0.3,
   "block": "weather_plans.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "If it's light showers, people still come, especially regulars. Heavy rain all day is another story.",
   "est_sec": 5.06,
   "gap_before": 1.01,
   "role": "reply",
   "block": "weather_plans.dlg21"
  },
  {
   "speaker": "user",
   "text": "My gazebo leaks at the corners.",
   "est_sec": 1.96,
   "gap_before": 3.15,
   "block": "weather_plans.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A cheap tarp over the top or a bit of seam sealer could save you. Keep your stock in plastic boxes under the table.",
   "est_sec": 7.54,
   "gap_before": 1.11,
   "role": "reply",
   "block": "weather_plans.dlg21"
  },
  {
   "speaker": "user",
   "text": "Do people buy jam in the rain?",
   "est_sec": 2.27,
   "gap_before": 3.46,
   "block": "weather_plans.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Comfort food sells well on grim days. A little sign saying something like rainy day treats can help.",
   "est_sec": 5.68,
   "gap_before": 0.51,
   "role": "reply",
   "block": "weather_plans.dlg21"
  },
  {
   "speaker": "user",
   "text": "Ha, I like that.",
   "est_sec": 1.34,
   "gap_before": 0.41,
   "block": "weather_plans.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "And bring a towel for your jars and a warm hat for you. Standing still in the rain gets cold fast.",
   "est_sec": 6.61,
   "gap_before": 0.85,
   "role": "reply",
   "block": "weather_plans.dlg21"
  }
 ]
}
