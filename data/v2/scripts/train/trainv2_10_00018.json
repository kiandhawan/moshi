   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "I finally want to patch the hole my kid put in the hallway wall.",
   "est_sec": 4.44,
   "gap_before": 0.27,
   "block": "home_repair.ctx2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Oh no. How big is it?",
