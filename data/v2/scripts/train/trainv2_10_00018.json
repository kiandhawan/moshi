   "block": "home_repair.ctx2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then you can use a mesh patch kit or cut in a small piece of new drywall. Which sounds more like you?",
   "est_sec": 6.92,
   "gap_before": 1.07,
   "role": "reply",
   "block": "home_repair.ctx2"
  },
  {
   "speaker": "user",
