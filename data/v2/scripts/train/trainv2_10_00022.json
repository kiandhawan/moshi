   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "I'm useless at chess. Should I be memorising openings?",
   "est_sec": 2.89,
   "gap_before": 0.42,
   "block": "board_games.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not yet. At the start, a few simple ideas matter much more than memorised moves.",
   "est_sec": 4.75,
   "gap_before": 0.96,
   "role": "reply",
   "block": "board_games.dlg7"
  },
  {
   "speaker": "user",
   "text": "Okay, something else. My work trip to Chicago ends on a Friday. My company says I can stay the weekend if I pay for the hotel.",
   "est_sec": 8.16,
   "gap_before": 1.27,
   "block": "travel_planning.ctx6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a good deal, the flight's already covered. Do you want to explore the city, or would you rather get home to your family?",
   "est_sec": 7.54,
   "gap_before": 1.07,
   "role": "reply",
   "block": "travel_planning.ctx6"
  },
  {
   "speaker": "user",
   "text": "Could you give me twenty-six seconds to think that through, and then ask me again?",
   "est_sec": 4.75,
   "gap_before": 3.24,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 26,
   "phrasing": "think_instruction_v2_01"
  },
  {
   "speaker": "moshi",
   "text": "So, a weekend in Chicago, or straight home on Friday?",
   "est_sec": 3.2,
   "role": "resume",
   "block": "travel_planning.ctx6",
   "anchor": {
    "turn": 6,
    "offset": 26.32
   }
  },
  {
   "speaker": "user",
   "text": "Home. My kids would never forgive me.",
