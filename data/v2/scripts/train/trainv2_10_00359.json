 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.47,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "I've got a free weekend and I want to start a new game.",
   "est_sec": 4.13,
   "gap_before": 0.31,
   "block": "video_games.ctx1",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Fun. Are you in the mood for a big story you can sink into, or something quick you can pick up and put down?",
   "est_sec": 7.54,
   "gap_before": 0.65,
   "role": "reply",
   "block": "video_games.ctx1"
  },
  {
   "speaker": "user",
   "text": "Your laptop's been updating for an hour. Isabella, is that normal?",
   "est_sec": 3.51,
   "gap_before": 1.21,
   "block": "nq_work_025",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_work_025",
   "name_pos": "middle",
   "addressee": "Isabella"
  },
  {
   "speaker": "other",
   "text": "Apparently it's installing everything.",
   "est_sec": 1.34,
   "gap_before": 0.81,
   "block": "nq_work_025"
  },
  {
   "speaker": "user",
   "text": "Two minutes. Kids.",
   "est_sec": 1.03,
   "gap_before": 1.92,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instruction_v2_28"
  },
  {
   "speaker": "user",
   "text": "Have you been practicing your guitar this week?",
   "est_sec": 2.58,
   "gap_before": 1.07,
   "event": "distractor",
   "kind": "friend_question",
   "block": "music.side2"
  },
  {
   "speaker": "friend",
   "text": "A little. My fingertips still hurt on the steel strings.",
   "est_sec": 3.2,
   "gap_before": 1.44,
   "block": "music.side2"
  },
  {
   "speaker": "user",
   "text": "That goes away after a few weeks. Which song are you learning?",
   "est_sec": 3.82,
   "gap_before": 0.61,
   "event": "distractor",
   "kind": "friend_question",
   "block": "music.side2"
  },
  {
   "speaker": "friend",
   "text": "Just the easy campfire ones. Four chords, over and over.",
   "est_sec": 3.2,
   "gap_before": 1.39,
   "block": "music.side2"
  },
  {
   "speaker": "user",
   "text": "That's how everyone starts. Play me one later?",
   "est_sec": 2.58,
   "gap_before": 1.32,
   "event": "distractor",
   "kind": "friend_question",
   "block": "music.side2"
  },
  {
   "speaker": "friend",
   "text": "Only if you promise not to laugh.",
   "est_sec": 2.27,
   "gap_before": 0.38,
   "block": "music.side2"
  },
  {
   "speaker": "user",
   "text": "Right, she's sorted. Over to you, Moshi.",
   "est_sec": 2.27,
   "gap_before": 1.58,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_v2_19"
  },
  {
