   "text": "No problem. You were picking a game for the weekend, big story or something quick?",
   "est_sec": 4.75,
   "gap_before": 1.1,
   "role": "resume",
   "block": "video_games.ctx1"
  },
  {
   "speaker": "user",
   "text": "Unrelated, but My partner wants to do a full moon night hike. Is that a terrible idea?",
   "est_sec": 5.37,
   "gap_before": 1.74,
   "block": "hiking.dlg17",
