 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.39,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "Is it safe to hike alone?",
   "est_sec": 1.96,
   "gap_before": 0.36,
   "block": "hiking.dlg3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It can be, with some precautions. Pick a well used trail, and always tell someone where you're going and when you'll be back.",
   "est_sec": 7.23,
   "gap_before": 0.42,
   "role": "reply",
   "block": "hiking.dlg3"
  },
  {
   "speaker": "user",
   "text": "What if I get lost?",
   "est_sec": 1.65,
   "gap_before": 2.18,
   "block": "hiking.dlg3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Download an offline map before you go and carry a small battery pack for your phone. If you're unsure, stay where you are and call for help.",
   "est_sec": 8.47,
   "gap_before": 1.12,
   "role": "reply",
   "block": "hiking.dlg3"
  },
  {
   "speaker": "user",
   "text": "The thing is, Miles, Moshi keeps mishearing the word quinoa.",
   "est_sec": 3.2,
   "gap_before": 3.2,
   "block": "mm_007",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_007",
   "name_pos": "middle",
   "addressee": "Miles"
  },
  {
   "speaker": "other",
   "text": "Everyone mishears quinoa.",
   "est_sec": 1.03,
   "gap_before": 0.48,
   "block": "mm_007"
  },
  {
   "speaker": "user",
   "text": "I'm retired, so I can go on weekdays when it's",
   "est_sec": 3.2,
   "gap_before": 0.86,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg3"
  },
  {
   "speaker": "user",
   "text": "really quiet.",
   "est_sec": 0.72,
   "gap_before": 2.63,
   "block": "hiking.dlg3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's lovely, but quieter trails mean fewer people to help. Stick to routes you know until you're confident.",
   "est_sec": 5.68,
   "gap_before": 1.16,
   "role": "reply",
   "block": "hiking.dlg3"
  },
  {
   "speaker": "user",
   "text": "Good point. Maybe I'll join a walking group too.",
   "est_sec": 2.89,
   "gap_before": 2.4,
   "block": "hiking.dlg3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a great idea. Many groups do weekday hikes, and you'll learn new trails from them.",
   "est_sec": 5.06,
   "gap_before": 0.63,
   "role": "reply",
   "block": "hiking.dlg3"
  }
 ]
