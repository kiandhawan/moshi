 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.49,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "My lavender's gone all woody and bald at the bottom. Can I cut it hard?",
   "est_sec": 4.75,
   "gap_before": 0.37,
   "block": "gardening.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Unfortunately lavender usually doesn't regrow from old bare wood. If you cut into it, those stems often stay bare.",
   "est_sec": 5.99,
   "gap_before": 0.34,
   "role": "reply",
   "block": "gardening.dlg28"
  },
  {
   "speaker": "user",
   "text": "Well that's depressing.",
   "est_sec": 1.03,
   "gap_before": 2.96,
   "block": "gardening.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It is. The good news is lavender is cheap and easy to replace, and you can take cuttings from the green tips first.",
   "est_sec": 7.23,
   "gap_before": 0.5,
   "role": "reply",
   "block": "gardening.dlg28"
  },
  {
   "speaker": "user",
   "text": "How do I stop the new ones going the same way?",
   "est_sec": 3.51,
   "gap_before": 0.65,
   "block": "gardening.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Trim them every year right after flowering, taking off the flower stalks and a bit of the green. Never go into the brown.",
   "est_sec": 7.23,
   "gap_before": 0.43,
   "role": "reply",
   "block": "gardening.dlg28"
  },
  {
   "speaker": "user",
   "text": "I've literally never",
   "est_sec": 1.03,
   "gap_before": 0.6,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg28"
  },
  {
   "speaker": "user",
   "text": "pruned it once in six years.",
   "est_sec": 1.96,
   "gap_before": 1.94,
   "block": "gardening.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then it did really well to last that long. Start fresh and give the new ones a trim every August.",
   "est_sec": 6.3,
   "gap_before": 0.33,
   "role": "reply",
   "block": "gardening.dlg28"
  }
 ]
}
