   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "How often should I be washing my bed sheets? Be honest.",
   "est_sec": 3.51,
   "gap_before": 0.54,
   "block": "cleaning.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Honestly, about once a week. Every two weeks at most.",
   "est_sec": 3.2,
   "gap_before": 0.88,
   "role": "reply",
   "block": "cleaning.dlg14"
  },
  {
   "speaker": "user",
   "text": "Oh no. It's been",
   "est_sec": 1.34,
