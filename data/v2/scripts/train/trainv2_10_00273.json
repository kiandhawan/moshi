   "text": "Sure.",
   "est_sec": 0.41,
   "gap_before": 0.31,
   "role": "ack",
   "phrasing": "ack_01"
  },
  {
   "speaker": "user",
   "text": "There's a ten year old compact that our neighbor is selling, runs fine, but the paint is pretty rough.",
   "est_sec": 5.99,
   "gap_before": 1.0,
   "block": "cars.opt2",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "Another option is a newer small SUV from a dealer, safer, but the payments would be steep for her.",
