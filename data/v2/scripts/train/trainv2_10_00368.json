 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.87,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "Weirdly, Moshi's voice is kind of soothing when I can't sleep.",
   "est_sec": 3.51,
   "gap_before": 1.3,
   "block": "mm_042",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_042",
   "name_pos": "none"
  },
  {
   "speaker": "other",
   "text": "Bit weird, but okay.",
   "est_sec": 1.34,
   "gap_before": 0.87,
   "block": "mm_042"
  },
  {
   "speaker": "user",
   "text": "I need a new rain jacket before the autumn and the shop gave me three to try.",
   "est_sec": 5.37,
   "gap_before": 0.89,
   "block": "hiking.opt6"
  },
  {
   "speaker": "user",
   "text": "Hear me out on all the options before you comment.",
   "est_sec": 3.2,
   "gap_before": 0.51,
   "event": "instruction",
   "kind": "describe_options",
   "phrasing": "describe_instr_19"
  },
  {
   "speaker": "moshi",
   "text": "Sure, go ahead.",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "role": "ack",
   "phrasing": "ack_08"
  },
  {
   "speaker": "user",
   "text": "A really light packable shell that folds into its own pocket, but the guy said it's not great in long downpours.",
   "est_sec": 6.61,
   "gap_before": 0.88,
   "block": "hiking.opt6",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "A heavier three layer jacket, totally waterproof and breathable, but nearly double the price.",
   "est_sec": 4.44,
   "gap_before": 5.19,
   "block": "hiking.opt6",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "A cheap plastic poncho type thing that covers me and my backpack, ugly but it works.",
   "est_sec": 5.06,
   "gap_before": 6.62,
   "block": "hiking.opt6"
  },
  {
   "speaker": "user",
   "text": "All set, those are the choices. Help me pick.",
   "est_sec": 2.89,
   "gap_before": 0.63,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "describe_cue_v2_26"
  },
  {
   "speaker": "moshi",
   "text": "For autumn, I'd spend more on the three layer jacket. The light shell is great in summer showers, but it'll let you down in all day rain, and the poncho turns into a sail on windy ridges.",
   "est_sec": 11.57,
   "gap_before": 1.36,
   "role": "resume",
   "block": "hiking.opt6"
  },
  {
   "speaker": "user",
   "text": "And the laces?",
   "est_sec": 1.03,
   "gap_before": 1.9,
   "event": "ordinary_request",
   "block": "cleaning.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Soak them in warm soapy water while you scrub, or just buy new white ones, they're cheap.",
   "est_sec": 5.37,
   "gap_before": 1.3,
   "role": "reply",
   "block": "cleaning.dlg25"
