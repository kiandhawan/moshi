 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.81,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "My mum's in a care home and her memory isn't great. Are there games we could still play together when I visit?",
   "est_sec": 6.92,
   "gap_before": 0.52,
   "block": "board_games.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, definitely. Simple, familiar games tend to work best, things she might have played years ago, like dominoes or snakes and ladders.",
   "est_sec": 6.92,
   "gap_before": 0.39,
   "role": "reply",
   "block": "board_games.dlg19"
  },
  {
   "speaker": "user",
   "text": "Ten pounds for popcorn. Alice, is that normal now?",
   "est_sec": 2.89,
   "gap_before": 0.73,
   "block": "nq_social_051",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_051",
   "name_pos": "middle",
   "addressee": "Alice"
  },
  {
   "speaker": "user",
   "text": "She used to love dominoes.",
   "est_sec": 1.65,
   "gap_before": 2.52,
   "block": "board_games.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then dominoes is perfect. Big tiles with clear dots are easier to see and handle.",
   "est_sec": 4.75,
   "gap_before": 1.24,
   "role": "reply",
   "block": "board_games.dlg19"
  },
  {
   "speaker": "user",
   "text": "What if she",
   "est_sec": 1.03,
   "gap_before": 1.42,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg19"
  },
  {
   "speaker": "user",
   "text": "forgets the rules halfway?",
   "est_sec": 1.34,
   "gap_before": 2.09,
   "block": "board_games.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Just play gently alongside her and don't correct much. The point is the time together, not playing it perfectly.",
   "est_sec": 5.99,
   "gap_before": 0.99,
   "role": "reply",
   "block": "board_games.dlg19"
  },
  {
   "speaker": "user",
   "text": "That's a nice way to think about it.",
   "est_sec": 2.58,
   "gap_before": 0.88,
   "block": "board_games.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Picture matching games and simple card games like snap are good too. Some care homes have a games box you could borrow.",
   "est_sec": 6.92,
   "gap_before": 0.75,
   "role": "reply",
   "block": "board_games.dlg19"
  }
 ]
}
