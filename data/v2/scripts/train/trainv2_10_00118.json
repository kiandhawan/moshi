 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.51,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.52,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "Every time I brake there's this high pitched squeal. It's embarrassing at traffic lights.",
   "est_sec": 4.44,
   "gap_before": 0.48,
   "block": "cars.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's usually the brake pads. Many pads have a little metal tab that squeals on purpose when they're getting thin.",
   "est_sec": 6.3,
   "gap_before": 0.74,
   "role": "reply",
   "block": "cars.dlg6"
  },
  {
   "speaker": "user",
   "text": "On purpose? That's a cruel design.",
   "est_sec": 1.96,
   "gap_before": 0.63,
   "block": "cars.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Annoying, but useful. It's the car telling you to book a brake check before the pads wear down to metal.",
   "est_sec": 6.3,
   "gap_before": 0.39,
   "role": "reply",
   "block": "cars.dlg6"
  },
  {
   "speaker": "user",
   "text": "How long can I",
   "est_sec": 1.34,
   "gap_before": 0.66,
   "event": "distractor",
   "kind": "pause",
   "block": "cars.dlg6"
  },
  {
   "speaker": "user",
   "text": "leave it?",
   "est_sec": 0.72,
   "gap_before": 2.03,
   "block": "cars.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "I wouldn't leave it more than a couple of weeks. If it turns into a grinding sound, stop driving and get it looked at straight away.",
   "est_sec": 8.16,
   "gap_before": 1.18,
   "role": "reply",
   "block": "cars.dlg6"
  },
  {
   "speaker": "user",
   "text": "Is it a big job?",
   "est_sec": 1.65,
   "gap_before": 0.96,
   "block": "cars.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Swapping pads is one of the cheaper repairs, usually under an hour. It gets pricey if the discs get damaged too, so sooner is better.",
   "est_sec": 7.85,
   "gap_before": 1.09,
   "role": "reply",
   "block": "cars.dlg6"
  }
 ]
}
