 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.72,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.59,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "A cabinet door in my kitchen is hanging crooked.",
   "est_sec": 2.89,
   "gap_before": 0.52,
   "block": "home_repair.ctx4",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's usually the hinge screws. Would you rather tighten what's there, or swap in new hinges while you're at it?",
   "est_sec": 6.3,
   "gap_before": 1.71,
   "role": "reply",
   "block": "home_repair.ctx4"
  },
  {
   "speaker": "user",
   "text": "Oh, my sister just got home. Give me a few minutes.",
   "est_sec": 3.51,
   "gap_before": 0.67,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instruction_v2_41"
  },
  {
   "speaker": "moshi",
   "text": "Okay, I'll wait.",
   "est_sec": 1.03,
   "gap_before": 0.62,
   "role": "ack",
   "phrasing": "ack_05"
  },
  {
   "speaker": "user",
   "text": "Hey Chloe, can you drive us to the airport on Friday morning?",
   "est_sec": 3.82,
   "gap_before": 0.65,
   "event": "distractor",
   "kind": "friend_question",
   "block": "travel_planning.side3"
  },
  {
   "speaker": "friend",
   "text": "What time is the flight?",
   "est_sec": 1.65,
   "gap_before": 0.84,
   "block": "travel_planning.side3"
  },
  {
   "speaker": "user",
   "text": "Seven forty, so we'd need to leave around five.",
   "est_sec": 2.89,
   "gap_before": 1.1,
   "block": "travel_planning.side3"
  },
  {
   "speaker": "friend",
   "text": "Five in the morning? You owe me big for that one.",
   "est_sec": 3.51,
   "gap_before": 2.59,
   "block": "travel_planning.side3"
  },
  {
   "speaker": "user",
   "text": "I'll bring you back something nice, I promise. What do you want?",
   "est_sec": 3.82,
   "gap_before": 0.55,
   "event": "distractor",
   "kind": "friend_question",
   "block": "travel_planning.side3"
  },
  {
   "speaker": "friend",
   "text": "Chocolate. Lots of chocolate.",
   "est_sec": 1.34,
   "gap_before": 0.79,
   "block": "travel_planning.side3"
  },
  {
   "speaker": "user",
   "text": "Done.",
   "est_sec": 0.41,
   "gap_before": 1.14,
   "block": "travel_planning.side3"
  },
  {
   "speaker": "user",
   "text": "I'm back, sorry for the wait.",
   "est_sec": 1.96,
   "gap_before": 0.7,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_04"
  },
  {
   "speaker": "moshi",
   "text": "Alright. The cabinet door. Tightening it up, or new hinges?",
   "est_sec": 3.2,
   "gap_before": 0.47,
   "role": "resume",
   "block": "home_repair.ctx4"
  },
  {
   "speaker": "user",
   "text": "Oh, also, My partner and I want to rent a campervan for a week in the mountains. Is that a silly idea if we've never driven one?",
   "est_sec": 8.47,
   "gap_before": 0.84,
   "block": "cars.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not silly at all, lots of people do it. Smaller vans drive a lot like a big car. The main things are the height and the width.",
   "est_sec": 8.47,
   "gap_before": 0.38,
   "role": "reply",
   "block": "cars.dlg24"
  },
  {
   "speaker": "user",
   "text": "Height, like bridges?",
   "est_sec": 1.03,
   "gap_before": 0.51,
   "block": "cars.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Bridges, car parks, drive throughs, low branches. Write the height on a sticky note on the dashboard so you don't forget.",
   "est_sec": 6.61,
   "gap_before": 1.04,
   "role": "reply",
   "block": "cars.dlg24"
  }
 ]
}
