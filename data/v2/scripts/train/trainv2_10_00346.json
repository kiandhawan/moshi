 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.54,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "Every autumn I throw out my geraniums and buy new ones in spring. Feels wasteful.",
   "est_sec": 4.75,
   "gap_before": 0.47,
   "block": "gardening.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It is a bit. You can keep them over winter quite easily if you've got a cool, frost free spot, like a porch or a spare room.",
   "est_sec": 8.47,
   "gap_before": 1.0,
   "role": "reply",
   "block": "gardening.dlg9"
  },
  {
   "speaker": "user",
   "text": "Oh, and another thing. It's movie night and nobody can agree on anything. Help.",
   "est_sec": 4.44,
   "gap_before": 1.02,
   "block": "movies.ctx1",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Let's narrow it down. Are you in the mood for something funny, something scary, or a big action film?",
   "est_sec": 5.99,
   "gap_before": 1.81,
   "role": "reply",
   "block": "movies.ctx1"
  },
  {
   "speaker": "user",
   "text": "Please give me twelve seconds and then repeat the question.",
   "est_sec": 3.2,
   "gap_before": 0.92,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 12,
   "phrasing": "think_instruction_v2_23"
  },
  {
   "speaker": "user",
   "text": "Hmm, what did I do last time?",
   "est_sec": 2.27,
   "anchor": {
    "turn": 6,
    "offset": 4.93
   },
   "event": "distractor",
   "kind": "self_talk",
   "phrasing": "self_04"
  },
  {
   "speaker": "user",
   "text": "Hmm, tough.",
   "est_sec": 0.72,
   "anchor": {
    "turn": 6,
    "offset": 9.01
   },
   "event": "distractor",
   "kind": "self_talk",
   "phrasing": "self_16"
  },
  {
   "speaker": "moshi",
   "text": "Alright, what's the verdict? Funny, scary or action?",
   "est_sec": 2.58,
   "role": "resume",
   "block": "movies.ctx1",
   "anchor": {
    "turn": 6,
    "offset": 12.59
   }
  },
  {
   "speaker": "user",
   "text": "Funny. Everyone's had a long week.",
   "est_sec": 1.96,
   "gap_before": 0.51,
   "event": "ordinary_request",
   "block": "movies.ctx1"
  },
  {
   "speaker": "moshi",
   "text": "Then go for a light comedy you can all talk over. Nothing too long, under two hours.",
   "est_sec": 5.37,
   "gap_before": 0.62,
   "role": "followup",
   "block": "movies.ctx1"
  },
  {
   "speaker": "user",
   "text": "There's an unheated porch. Gets cold but never freezes.",
   "est_sec": 2.89,
   "gap_before": 1.93,
   "event": "ordinary_request",
   "block": "gardening.dlg9"
  },
  {
