   "est_sec": 4.75,
   "gap_before": 0.35,
   "block": "studying.ctx6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a lot. Would it be better to study right after your shift, or after you've slept, before the next one?",
   "est_sec": 6.61,
   "gap_before": 0.38,
   "role": "reply",
   "block": "studying.ctx6"
  },
  {
   "speaker": "user",
   "text": "Would you mind not chiming in for a minute? My flatmate needs me.",
   "est_sec": 4.13,
