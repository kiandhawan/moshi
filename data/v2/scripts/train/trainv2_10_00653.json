   "text": "Only if it comes with a drink. Otherwise it's a rip off.",
   "est_sec": 3.82,
   "gap_before": 0.97,
   "block": "movies.side5"
  },
  {
   "speaker": "user",
   "text": "It does. Okay, two tickets, half past seven.",
   "est_sec": 2.58,
   "gap_before": 0.5,
   "block": "movies.side5"
  },
  {
