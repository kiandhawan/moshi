   "text": "Oh, I ran out of bookmarks. Yours was just lying there.",
   "est_sec": 3.51,
   "gap_before": 2.57,
   "block": "books.side4"
  },
  {
   "speaker": "user",
   "text": "That's my lucky bookmark. I've had it since college.",
   "est_sec": 2.89,
   "gap_before": 0.88,
   "block": "books.side4"
  },
  {
   "speaker": "friend",
   "text": "It's a train ticket.",
   "est_sec": 1.34,
   "gap_before": 1.43,
   "block": "books.side4"
  },
  {
   "speaker": "user",
   "text": "It's a lucky train ticket. Can I have it back after this chapter?",
   "est_sec": 4.13,
   "gap_before": 0.52,
   "event": "distractor",
   "kind": "friend_question",
   "block": "books.side4"
  },
  {
