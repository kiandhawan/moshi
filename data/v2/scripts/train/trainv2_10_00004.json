  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.44,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.3,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "Hey Moshi, I want one good kitchen knife instead of my drawer full of terrible ones.",
   "est_sec": 5.06,
   "gap_before": 0.26,
   "block": "shopping.dlg22",
   "kind": "moshi_name",
   "name_pos": "start",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Great plan. A chef's knife of around eight inches handles nearly everything.",
   "est_sec": 3.82,
   "gap_before": 0.87,
   "role": "reply",
   "block": "shopping.dlg22"
  },
  {
   "speaker": "user",
   "text": "Wait, is a really expensive one worth it?",
   "est_sec": 2.58,
   "gap_before": 2.33,
   "block": "shopping.dlg22",
   "kind": "wait_like",
   "phrasing": "waitlike_13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not necessarily. A mid priced knife that feels good in your hand and that you keep sharp will beat a pricey one you neglect.",
   "est_sec": 7.54,
   "gap_before": 1.18,
   "role": "reply",
   "block": "shopping.dlg22"
  },
  {
   "speaker": "user",
   "text": "How do I know it feels good?",
   "est_sec": 2.27,
   "gap_before": 0.44,
   "block": "shopping.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Hold it in the shop if you can. It should feel balanced, not too heavy at the blade, and the handle shouldn't dig into your fingers.",
   "est_sec": 8.16,
   "gap_before": 1.55,
   "role": "reply",
   "block": "shopping.dlg22"
  },
  {
   "speaker": "user",
   "text": "And then never put it in the dishwasher, right?",
   "est_sec": 2.89,
   "gap_before": 1.37,
   "block": "shopping.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Hand wash, dry it straight away, and get a simple sharpener. It'll last for years.",
   "est_sec": 5.06,
   "gap_before": 0.96,
   "role": "reply",
   "block": "shopping.dlg22"
  }
