 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.67,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "Why does my dog eat grass and then throw up? Is he sick?",
   "est_sec": 4.13,
   "gap_before": 0.55,
   "block": "pets.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Lots of dogs eat grass, and most of the time it's harmless. Some just like the taste, others do it when their tummy feels a bit off.",
   "est_sec": 8.47,
   "gap_before": 0.73,
   "role": "reply",
   "block": "pets.dlg5"
  },
  {
   "speaker": "user",
   "text": "Oh Dmitri, did your sister ever have the baby?",
   "est_sec": 2.89,
   "gap_before": 0.42,
   "block": "nq_social_005",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_005",
   "name_pos": "start",
   "addressee": "Dmitri"
  },
  {
   "speaker": "user",
   "text": "He does it every single walk.",
   "est_sec": 1.96,
   "gap_before": 3.25,
   "block": "pets.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "If he's otherwise eating, playing and pooping normally, it's usually nothing to worry about.",
   "est_sec": 4.44,
   "gap_before": 0.65,
   "role": "reply",
   "block": "pets.dlg5"
  },
  {
   "speaker": "user",
   "text": "He seems totally fine.",
   "est_sec": 1.34,
   "gap_before": 0.37,
   "event": "distractor",
   "kind": "pause",
   "block": "pets.dlg5"
  },
  {
   "speaker": "user",
   "text": "Annoyingly fine, actually.",
   "est_sec": 1.03,
   "gap_before": 2.75,
   "block": "pets.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then it's probably habit. Just keep him off grass that might be sprayed with weedkiller.",
   "est_sec": 4.75,
   "gap_before": 0.58,
   "role": "reply",
   "block": "pets.dlg5"
  },
  {
   "speaker": "user",
   "text": "And when should I worry?",
   "est_sec": 1.65,
   "gap_before": 1.4,
   "block": "pets.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "If he's vomiting a lot, not eating, seems tired or the sick has blood in it, call your vet.",
   "est_sec": 5.99,
   "gap_before": 1.26,
   "role": "reply",
   "block": "pets.dlg5"
  }
 ]
