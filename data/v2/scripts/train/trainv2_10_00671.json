   "gap_before": 1.14,
   "event": "ordinary_request",
   "block": "weekend_plans.ctx5"
  },
  {
   "speaker": "moshi",
   "text": "Sounds right. Maybe ask if a friend can come with you.",
   "est_sec": 3.51,
