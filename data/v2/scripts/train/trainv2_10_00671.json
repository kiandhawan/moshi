 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.58,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.69,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "My baby's high chair is crusted with porridge. It sets like cement.",
   "est_sec": 3.82,
   "gap_before": 0.2,
   "block": "cleaning.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Porridge is the worst. Soak the tray in hot soapy water for ten minutes, it softens right up.",
   "est_sec": 5.68,
   "gap_before": 0.47,
   "role": "reply",
   "block": "cleaning.dlg30"
  },
  {
   "speaker": "user",
   "text": "Oh, and another thing. Saturday there's a sleepover and a concert, and my parents say I can only do one.",
   "est_sec": 6.3,
   "gap_before": 0.88,
   "block": "weekend_plans.ctx5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Tough call. Is it a band you might not see again soon?",
   "est_sec": 3.82,
   "gap_before": 0.32,
   "role": "reply",
   "block": "weekend_plans.ctx5"
  },
  {
   "speaker": "user",
   "text": "Probably not for years.",
   "est_sec": 1.34,
   "gap_before": 3.17,
   "block": "weekend_plans.ctx5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "And the sleepover, is it a big one or just your usual crowd?",
   "est_sec": 4.13,
   "gap_before": 0.32,
   "role": "reply",
   "block": "weekend_plans.ctx5"
  },
  {
   "speaker": "user",
   "text": "Give me thirteen seconds to crunch the numbers.",
   "est_sec": 2.58,
   "gap_before": 1.44,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 13,
   "phrasing": "think_instruction_v2_19"
  },
  {
   "speaker": "moshi",
   "text": "Rare concert or your usual crowd? Have you picked?",
   "est_sec": 2.89,
   "role": "resume",
   "block": "weekend_plans.ctx5",
   "anchor": {
    "turn": 8,
    "offset": 13.56
   }
  },
  {
