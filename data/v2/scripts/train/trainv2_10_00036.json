 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.58,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.3,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "The bathroom faucet keeps dripping all night and it's driving me nuts.",
   "est_sec": 3.82,
   "gap_before": 0.49,
   "block": "home_repair.ctx1",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's usually a worn washer or cartridge. Do you want to try fixing it yourself, or would you rather call a plumber?",
   "est_sec": 6.92,
   "gap_before": 0.71,
   "role": "reply",
   "block": "home_repair.ctx1"
  },
  {
   "speaker": "friend",
   "text": "Sorry to bother you, I've got a quick question.",
   "est_sec": 2.89,
   "gap_before": 1.3,
   "event": "distractor",
   "kind": "friend_interrupt",
   "phrasing": "friend_interrupt_v2_07"
  },
  {
   "speaker": "user",
   "text": "Moshi, pause, she's asking me something. I'll say when I'm back.",
   "est_sec": 3.51,
   "gap_before": 0.39,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instruction_v2_50"
  },
  {
   "speaker": "user",
   "text": "Ethan, where do the spare vacuum bags live? This one's full.",
   "est_sec": 3.51,
   "gap_before": 0.93,
   "block": "cleaning.side4"
  },
  {
   "speaker": "friend",
   "text": "Hall cupboard, top shelf. Have you ever actually changed one before?",
   "est_sec": 3.51,
   "gap_before": 0.6,
   "block": "cleaning.side4"
  },
  {
   "speaker": "user",
   "text": "Of course I have.",
   "est_sec": 1.34,
   "gap_before": 0.9,
   "block": "cleaning.side4"
  },
  {
   "speaker": "friend",
   "text": "When?",
   "est_sec": 0.41,
   "gap_before": 0.91,
   "block": "cleaning.side4"
  },
  {
   "speaker": "user",
   "text": "Okay, never. Show me?",
   "est_sec": 1.34,
   "gap_before": 0.88,
   "event": "distractor",
   "kind": "friend_question",
   "block": "cleaning.side4"
  },
  {
   "speaker": "friend",
   "text": "Pull the little tab, slide it out, don't shake it, unless you want to vacuum twice.",
   "est_sec": 5.06,
   "gap_before": 0.32,
   "block": "cleaning.side4"
  },
  {
   "speaker": "user",
   "text": "Okay, okay, I'm back. Hit me.",
   "est_sec": 1.96,
   "gap_before": 0.55,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_v2_23"
  },
  {
   "speaker": "moshi",
   "text": "Alright. We were deciding whether you'd fix the dripping faucet yourself or call a plumber.",
   "est_sec": 4.75,
   "gap_before": 0.83,
   "role": "resume",
   "block": "home_repair.ctx1"
  },
  {
   "speaker": "user",
   "text": "Right, next thing. We had our baby last week and I want some newborn photos, but I don't want to put her in weird poses.",
   "est_sec": 7.85,
   "gap_before": 1.34,
   "block": "photography.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Congratulations. Honestly, the simple ones are often the most loved. Her tiny hands, feet, yawns, her asleep on someone's chest.",
   "est_sec": 6.3,
   "gap_before": 1.16,
   "role": "reply",
   "block": "photography.dlg16"
  },
  {
   "speaker": "user",
   "text": "That's what I want. Natural stuff.",
   "est_sec": 1.96,
   "gap_before": 1.53,
   "block": "photography.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Shoot in the room with the biggest window, mid morning, flash off. Keep the room warm, sleeping babies are happiest when they're cosy.",
   "est_sec": 7.23,
   "gap_before": 0.74,
   "role": "reply",
   "block": "photography.dlg16"
  },
  {
   "speaker": "user",
   "text": "That's actually doable.",
   "est_sec": 1.03,
   "gap_before": 1.35,
   "block": "photography.dlg16"
  }
 ]
}
