 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.44,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.98,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "The light in my hallway flickers. Is my house haunted?",
   "est_sec": 3.2,
   "gap_before": 0.44,
   "block": "home_repair.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ha, probably not. The most common cause is a loose bulb, or a bulb that doesn't match the dimmer.",
   "est_sec": 5.99,
   "gap_before": 0.56,
   "role": "reply",
   "block": "home_repair.dlg6"
  },
  {
   "speaker": "user",
   "text": "There is a dimmer, yeah.",
   "est_sec": 1.65,
   "gap_before": 1.19,
   "block": "home_repair.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Some LED bulbs don't play nicely with older dimmers. Look on the box for the word dimmable.",
   "est_sec": 5.37,
   "gap_before": 0.71,
   "role": "reply",
   "block": "home_repair.dlg6"
  },
  {
   "speaker": "user",
   "text": "Jayden, what time does the post office shut?",
   "est_sec": 2.58,
   "gap_before": 1.03,
   "block": "nq_work_022",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_work_022",
   "name_pos": "start",
   "addressee": "Jayden"
  },
  {
   "speaker": "other",
   "text": "Half five on weekdays.",
   "est_sec": 1.34,
   "gap_before": 0.99,
   "block": "nq_work_022"
  },
  {
   "speaker": "user",
   "text": "Oh. I bought the cheapest ones.",
   "est_sec": 1.96,
   "gap_before": 1.68,
   "block": "home_repair.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's likely it. Swap in a dimmable bulb and see if the flicker stops.",
   "est_sec": 4.44,
   "gap_before": 0.46,
   "role": "reply",
   "block": "home_repair.dlg6"
  },
  {
   "speaker": "user",
   "text": "And if it doesn't?",
   "est_sec": 1.34,
   "gap_before": 0.67,
   "block": "home_repair.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then it could be a loose connection in the switch or fitting. That one's worth having an electrician check.",
   "est_sec": 5.99,
   "gap_before": 1.13,
   "role": "reply",
   "block": "home_repair.dlg6"
  }
 ]
