 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.54,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.88,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "Should I stay for the credits? My friends always just leave.",
   "est_sec": 3.51,
   "gap_before": 0.41,
   "block": "movies.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "These days, often yes. Lots of big films hide a little scene during or after the credits.",
   "est_sec": 5.37,
   "gap_before": 0.34,
   "role": "reply",
   "block": "movies.dlg16"
  },
  {
   "speaker": "user",
   "text": "How do I know if there is one?",
   "est_sec": 2.58,
   "gap_before": 0.42,
   "block": "movies.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can search the film name plus credits scene before you go. People post about it without spoiling what happens.",
   "est_sec": 6.3,
   "gap_before": 0.89,
   "role": "reply",
   "block": "movies.dlg16"
  },
  {
   "speaker": "user",
   "text": "Unrelated, but Help me pack for a long weekend in Edinburgh in October.",
   "est_sec": 4.13,
   "gap_before": 1.16,
   "block": "travel_planning.ctx3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It'll be cool and probably rainy. First, carry-on only, or are you checking a bag?",
   "est_sec": 4.75,
   "gap_before": 0.98,
   "role": "reply",
   "block": "travel_planning.ctx3"
  },
  {
   "speaker": "user",
   "text": "Oh, I hadn't thought about that.",
   "est_sec": 1.96,
   "gap_before": 0.85,
   "block": "travel_planning.ctx3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It changes what you can bring, so it's worth deciding now.",
   "est_sec": 3.51,
   "gap_before": 0.39,
   "role": "reply",
   "block": "travel_planning.ctx3"
  },
  {
   "speaker": "user",
   "text": "I'm taking twenty seconds to decide. Ask me again when they're up.",
   "est_sec": 3.82,
   "gap_before": 2.55,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 20,
   "phrasing": "think_instruction_v2_16"
  },
  {
   "speaker": "moshi",
   "text": "Okay, no rush.",
   "est_sec": 1.03,
   "gap_before": 0.39,
   "role": "ack",
   "phrasing": "ack_10"
  },
  {
   "speaker": "user",
   "text": "Okay, so, the thing is",
