 "est_total_sec": 57.26,
 "est_speech_sec": 40.78,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.61,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I'm retired now and finally have time to fix up the deck. Where do I even begin?",
   "est_sec": 5.37,
   "gap_before": 0.4,
   "block": "home_repair.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Start with a good look for loose boards, popped nails and soft spots. Soft wood means rot and should be replaced first.",
   "est_sec": 6.92,
   "gap_before": 1.08,
   "role": "reply",
   "block": "home_repair.dlg2"
  },
  {
   "speaker": "user",
   "text": "There are a few soft boards near the steps, yes.",
   "est_sec": 3.2,
   "gap_before": 2.6,
   "block": "home_repair.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Replace those, then give the whole deck a scrub with a deck cleaner and let it dry for a couple of days.",
   "est_sec": 6.92,
   "gap_before": 1.39,
   "role": "reply",
   "block": "home_repair.dlg2"
  },
  {
   "speaker": "user",
   "text": "Then stain it?",
   "est_sec": 1.03,
   "gap_before": 2.89,
   "block": "home_repair.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Pick a dry stretch of weather and apply a thin, even coat. Two thin coats beat one thick one.",
   "est_sec": 6.3,
   "gap_before": 1.04,
   "role": "reply",
   "block": "home_repair.dlg2"
  },
  {
   "speaker": "user",
   "text": "I was going to do it all",
   "est_sec": 2.27,
   "gap_before": 1.08,
   "event": "distractor",
   "kind": "pause",
   "block": "home_repair.dlg2"
  },
  {
   "speaker": "user",
   "text": "well, maybe over two weekends instead.",
   "est_sec": 1.96,
   "gap_before": 2.13,
   "block": "home_repair.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a sensible pace. Repairs and cleaning one weekend, staining the next.",
   "est_sec": 3.82,
   "gap_before": 1.13,
   "role": "reply",
   "block": "home_repair.dlg2"
  }
 ]
}
