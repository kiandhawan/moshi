 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.6,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.52,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "It's going to be super humid tomorrow and I'm meant to do a long run. Good idea?",
   "est_sec": 5.37,
   "gap_before": 0.42,
   "block": "weather_plans.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can, but slow down. Sweat doesn't evaporate well in humidity, so your body struggles more to cool off.",
   "est_sec": 5.99,
   "gap_before": 0.36,
   "role": "reply",
   "block": "weather_plans.dlg11"
  },
  {
   "speaker": "user",
   "text": "So run slower than usual?",
   "est_sec": 1.65,
   "gap_before": 1.49,
   "block": "weather_plans.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, and don't chase your normal times. Running by feel or heart rate is better on days like that.",
   "est_sec": 5.99,
   "gap_before": 0.35,
   "role": "reply",
   "block": "weather_plans.dlg11"
  },
  {
   "speaker": "user",
   "text": "Is it bath night or shower night, Aurora?",
   "est_sec": 2.58,
   "gap_before": 1.16,
   "block": "nq_home_068",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_068",
   "name_pos": "end",
   "addressee": "Aurora"
  },
  {
   "speaker": "other",
   "text": "Bath! With bubbles!",
   "est_sec": 1.03,
   "gap_before": 0.93,
   "block": "nq_home_068"
  },
  {
   "speaker": "user",
   "text": "What time's best?",
   "est_sec": 1.03,
   "gap_before": 1.75,
   "block": "weather_plans.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Early morning usually, it's cooler, even if the humidity's still high.",
   "est_sec": 3.51,
   "gap_before": 0.39,
   "role": "reply",
   "block": "weather_plans.dlg11"
  },
  {
   "speaker": "user",
   "text": "And water? I usually don't carry any.",
   "est_sec": 2.27,
   "gap_before": 0.46,
   "block": "weather_plans.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Tomorrow, I'd carry some, or plan a loop past a tap. Stop if you feel dizzy, sick or stop sweating.",
   "est_sec": 6.3,
   "gap_before": 0.5,
   "role": "reply",
   "block": "weather_plans.dlg11"
