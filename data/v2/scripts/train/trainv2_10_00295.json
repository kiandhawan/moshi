 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.73,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.4,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "My son keeps telling me to track my hikes on an app. I don't see the point.",
   "est_sec": 5.37,
   "gap_before": 0.26,
   "block": "hiking.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You don't need to. But some people enjoy seeing their routes on a map and how far they've gone over a year.",
   "est_sec": 6.92,
   "gap_before": 1.81,
   "role": "reply",
   "block": "hiking.dlg32"
  },
  {
   "speaker": "user",
   "text": "I've been walking these hills for forty years without a phone.",
   "est_sec": 3.51,
   "gap_before": 1.09,
   "block": "hiking.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a lot of knowledge in your head. An app won't replace that.",
   "est_sec": 4.13,
   "gap_before": 1.1,
   "role": "reply",
   "block": "hiking.dlg32"
  },
  {
   "speaker": "user",
   "text": "So what's he on about?",
   "est_sec": 1.65,
   "gap_before": 1.36,
   "block": "hiking.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Probably safety. Some apps let you share your location live with family, so they know you're okay if you're out alone.",
   "est_sec": 6.61,
   "gap_before": 0.66,
   "role": "reply",
   "block": "hiking.dlg32"
  },
  {
   "speaker": "user",
   "text": "Hm. That might stop",
   "est_sec": 1.34,
   "gap_before": 2.02,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg32"
  },
  {
   "speaker": "user",
   "text": "his mother worrying, I suppose.",
   "est_sec": 1.65,
   "gap_before": 2.02,
   "block": "hiking.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That might be the real reason. You could just turn it on for solo walks and ignore the rest.",
   "est_sec": 5.99,
   "gap_before": 0.9,
   "role": "reply",
   "block": "hiking.dlg32"
  }
