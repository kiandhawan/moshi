 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.54,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.92,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "It's going to drop to minus ten tonight. Will my pipes freeze?",
   "est_sec": 3.82,
   "gap_before": 0.32,
   "block": "weather_plans.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "They might, especially any in the loft, garage, or along outside walls. Let's make sure they don't.",
   "est_sec": 5.37,
   "gap_before": 0.53,
   "role": "reply",
   "block": "weather_plans.dlg26"
  },
  {
   "speaker": "user",
   "text": "What do I do?",
   "est_sec": 1.34,
   "gap_before": 1.29,
   "block": "weather_plans.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Keep the heating on low through the night, even if you're out. Open the cupboard under the sink so warm air reaches the pipes.",
   "est_sec": 7.54,
   "gap_before": 0.91,
   "role": "reply",
   "block": "weather_plans.dlg26"
  },
  {
   "speaker": "user",
   "text": "And outside taps?",
   "est_sec": 1.03,
   "gap_before": 0.67,
   "block": "weather_plans.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Turn them off from inside if you can, and drain them. Cover them with an insulating jacket or wrap them in old towels.",
   "est_sec": 7.23,
   "gap_before": 0.63,
   "role": "reply",
   "block": "weather_plans.dlg26"
  },
  {
   "speaker": "user",
   "text": "What if one freezes anyway?",
   "est_sec": 1.65,
   "gap_before": 0.53,
   "block": "weather_plans.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Thaw it slowly with a hairdryer or a hot water bottle, never a flame. And know where your stopcock is in case it bursts.",
   "est_sec": 7.54,
   "gap_before": 0.46,
   "role": "reply",
   "block": "weather_plans.dlg26"
  }
 ]
}
