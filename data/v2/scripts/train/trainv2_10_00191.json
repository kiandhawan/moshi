 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.74,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.61,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "Jamal, did you remember to cancel that free trial?",
   "est_sec": 2.89,
   "gap_before": 2.11,
   "block": "nq_social_015",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_015",
   "name_pos": "start",
   "addressee": "Jamal"
  },
  {
   "speaker": "other",
   "text": "Oh no. It's charged me already.",
   "est_sec": 1.96,
   "gap_before": 0.56,
   "block": "nq_social_015"
  },
  {
   "speaker": "user",
   "text": "My cousin is visiting from Canada for one weekend only and I need to show her a good time.",
   "est_sec": 5.99,
   "gap_before": 1.88,
   "block": "weekend_plans.opt6"
  },
  {
   "speaker": "user",
   "text": "So I think I'd go with— actually no, let me list all the options first, then you tell me.",
   "est_sec": 5.99,
   "gap_before": 0.65,
   "event": "instruction",
   "kind": "describe_options",
   "phrasing": "describe_instruction_v2_25"
  },
  {
   "speaker": "user",
   "text": "A day in the city centre, the market, the castle, maybe a show in the evening.",
   "est_sec": 5.06,
   "gap_before": 1.24,
   "block": "weekend_plans.opt6",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "A countryside day with a pub lunch and a walk through some proper old villages.",
   "est_sec": 4.75,
   "gap_before": 2.68,
   "block": "weekend_plans.opt6",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "Or a day at the seaside, fish and chips, the pier and the arcades.",
   "est_sec": 4.44,
   "gap_before": 2.77,
   "block": "weekend_plans.opt6"
  },
  {
   "speaker": "user",
   "text": "Sorry, that's all, I promise. Go ahead and weigh in.",
   "est_sec": 3.2,
   "gap_before": 0.91,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "describe_cue_v2_14"
  },
  {
   "speaker": "moshi",
   "text": "If she's never been here before, the city day shows her the most in a short time. The countryside walk with a pub lunch would be a lovely, gentler contrast for Sunday.",
   "est_sec": 10.02,
   "gap_before": 1.15,
   "role": "resume",
   "block": "weekend_plans.opt6"
  },
  {
   "speaker": "user",
   "text": "Sevens and eights, mostly.",
   "est_sec": 1.34,
   "gap_before": 1.72,
   "event": "ordinary_request",
   "block": "studying.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "There's a little rhyme for eight times eight. I ate and I ate till I was sick on the floor, eight times eight is sixty four.",
   "est_sec": 8.16,
