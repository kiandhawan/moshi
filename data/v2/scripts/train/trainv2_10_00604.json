 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.35,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.38,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "We've lost the rulebook for a game we got second hand. Are we stuck?",
   "est_sec": 4.44,
   "gap_before": 0.31,
   "block": "board_games.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Probably not. Most publishers put the rules as free downloads on their website. What's the game called?",
   "est_sec": 5.37,
   "gap_before": 0.96,
   "role": "reply",
   "block": "board_games.dlg8"
  },
  {
   "speaker": "user",
   "text": "It's about building castles, it's in German on the box, Moshi.",
   "est_sec": 3.51,
   "gap_before": 1.92,
   "block": "board_games.dlg8",
   "kind": "moshi_name",
   "name_pos": "end",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "If the title is on the box, try searching it with the words rules in English. Fan sites often have translations too.",
   "est_sec": 6.92,
   "gap_before": 0.37,
   "role": "reply",
   "block": "board_games.dlg8"
  },
  {
   "speaker": "user",
   "text": "Oh nice. And if it's",
   "est_sec": 1.65,
   "gap_before": 0.63,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg8"
  },
  {
   "speaker": "user",
   "text": "some really obscure one?",
   "est_sec": 1.34,
   "gap_before": 1.59,
   "block": "board_games.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then board game forums are great. Post a photo of the box and the pieces, someone usually knows it.",
   "est_sec": 5.99,
   "gap_before": 0.6,
   "role": "reply",
   "block": "board_games.dlg8"
  },
  {
   "speaker": "user",
   "text": "Hold on, that's not right.",
   "est_sec": 1.65,
   "gap_before": 0.36,
   "block": "board_games.dlg8",
   "kind": "wait_like",
   "phrasing": "waitlike_07",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good to question it. I still think it's right, though you know your situation best.",
   "est_sec": 4.75,
   "gap_before": 0.78,
   "role": "reply",
   "block": "board_games.dlg8"
  },
  {
   "speaker": "user",
   "text": "People are that helpful?",
   "est_sec": 1.34,
   "gap_before": 1.33,
   "block": "board_games.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "In this hobby, very. Board gamers love explaining rules, almost more than playing.",
   "est_sec": 4.13,
   "gap_before": 0.38,
   "role": "reply",
   "block": "board_games.dlg8"
  }
 ]
