   "gap_before": 0.81,
   "block": "weather_plans.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then take your antihistamine a few hours before, not when symptoms start. It works better ahead of time.",
   "est_sec": 5.68,
   "gap_before": 0.46,
   "role": "reply",
   "block": "weather_plans.dlg6"
  },
  {
   "speaker": "user",
   "text": "Okay, something else. I'm making soup for my grandmother, she's just had her teeth out.",
