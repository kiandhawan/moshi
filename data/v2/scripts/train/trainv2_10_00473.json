 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.33,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "We booked a sailing trip for tomorrow but the wind's picking up a lot.",
   "est_sec": 4.44,
   "gap_before": 0.45,
   "block": "weather_plans.ctx8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Strong winds can be thrilling or miserable. Are you happy to go anyway with an experienced skipper, or would you rather rebook?",
   "est_sec": 6.92,
   "gap_before": 0.49,
   "role": "reply",
   "block": "weather_plans.ctx8"
  },
  {
   "speaker": "user",
   "text": "Pause for a bit, my kid needs me. I'll come back to you when I'm done.",
   "est_sec": 5.06,
   "gap_before": 1.0,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_29"
  },
  {
   "speaker": "moshi",
   "text": "Sure, go ahead.",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "role": "ack",
   "phrasing": "ack_08"
  },
  {
   "speaker": "user",
   "text": "I'm here for the snacks, not the movie.",
   "est_sec": 2.58,
   "gap_before": 0.68,
   "event": "distractor",
   "kind": "near_miss",
   "phrasing": "dn_58"
  },
  {
   "speaker": "friend",
   "text": "At least you're honest.",
   "est_sec": 1.34,
   "gap_before": 0.34,
   "phrasing": "dn_58"
  },
  {
   "speaker": "user",
   "text": "Sam, what should we bring to the neighbors' game night?",
   "est_sec": 3.2,
   "gap_before": 1.43,
   "event": "distractor",
   "kind": "friend_question",
   "block": "board_games.side3"
  },
  {
   "speaker": "friend",
   "text": "Maybe that card game with the cats. Everyone laughed last time.",
   "est_sec": 3.51,
   "gap_before": 0.49,
   "block": "board_games.side3"
  },
  {
   "speaker": "user",
   "text": "We played that twice already though. What about the new one?",
   "est_sec": 3.51,
   "gap_before": 0.97,
   "event": "distractor",
   "kind": "friend_question",
   "block": "board_games.side3"
  },
  {
   "speaker": "friend",
   "text": "The rules are pretty long. Have you read them?",
   "est_sec": 2.89,
   "gap_before": 0.7,
   "block": "board_games.side3"
  },
  {
   "speaker": "user",
   "text": "Half of them. I could watch a video tonight.",
   "est_sec": 2.89,
   "gap_before": 0.34,
   "block": "board_games.side3"
  },
  {
   "speaker": "friend",
   "text": "Okay, bring both, and we'll see what people feel like.",
   "est_sec": 3.2,
   "gap_before": 0.88,
   "block": "board_games.side3"
  },
  {
   "speaker": "user",
   "text": "Okay, I'm done. Talk to me, Moshi.",
   "est_sec": 2.27,
   "gap_before": 1.53,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_v2_44"
  },
  {
