 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.77,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "We had a birthday party last night and the flat is wrecked. Moshi, what comes first?",
   "est_sec": 5.06,
   "gap_before": 0.22,
   "block": "cleaning.dlg20",
   "kind": "moshi_name",
   "name_pos": "middle",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Bin bags first. Walk through every room collecting rubbish and cans, it makes the biggest visual difference.",
   "est_sec": 5.37,
   "gap_before": 0.4,
   "role": "reply",
   "block": "cleaning.dlg20"
  },
  {
   "speaker": "user",
   "text": "Wait a second, that doesn't sound right.",
   "est_sec": 2.27,
   "gap_before": 0.7,
   "block": "cleaning.dlg20",
   "kind": "wait_like",
   "phrasing": "waitlike_10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Let me double-check. I'd still stand by it, but tell me what you heard.",
   "est_sec": 4.44,
   "gap_before": 0.76,
   "role": "reply",
   "block": "cleaning.dlg20"
  },
  {
   "speaker": "user",
   "text": "Done. Now it's the sticky floor. Someone spilled punch everywhere.",
   "est_sec": 3.2,
   "gap_before": 0.98,
   "block": "cleaning.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Dishes next, so the sink is free, and save floors for last, because you'll drip things while cleaning.",
   "est_sec": 5.68,
   "gap_before": 0.73,
   "role": "reply",
   "block": "cleaning.dlg20"
  },
  {
   "speaker": "user",
   "text": "Makes sense. Should I",
   "est_sec": 1.34,
   "gap_before": 1.5,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg20"
  },
  {
   "speaker": "user",
   "text": "should I mop twice?",
   "est_sec": 1.34,
   "gap_before": 1.93,
   "block": "cleaning.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Mop once with warm soapy water, then once with clean water to lift the sticky film.",
   "est_sec": 5.06,
   "gap_before": 0.36,
   "role": "reply",
   "block": "cleaning.dlg20"
  },
  {
   "speaker": "user",
   "text": "Okay. I'm putting music on.",
   "est_sec": 1.65,
   "gap_before": 0.96,
   "block": "cleaning.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good plan. And drink some water, I'm guessing it was a good party.",
