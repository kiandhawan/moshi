 "est_total_sec": 63.18,
 "est_speech_sec": 47.39,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.51,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.3,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "I've bought a game with all these grey plastic figures. People paint them, apparently. I've never painted anything.",
   "est_sec": 5.68,
   "gap_before": 0.23,
   "block": "board_games.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Painting miniatures is a lovely relaxing hobby. You only need a few brushes, a handful of paints and a primer to start.",
   "est_sec": 6.92,
   "gap_before": 0.96,
   "role": "reply",
   "block": "board_games.dlg11"
  },
  {
   "speaker": "user",
   "text": "Before bed, Yusuf, did you set an alarm for school?",
   "est_sec": 3.2,
   "gap_before": 1.33,
   "block": "nq_home_042",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_042",
   "name_pos": "middle",
   "addressee": "Yusuf"
  },
  {
   "speaker": "user",
   "text": "Primer?",
   "est_sec": 0.41,
   "gap_before": 1.83,
   "block": "board_games.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A spray undercoat that helps paint stick to the plastic. Do it outside on a dry day, in short bursts.",
   "est_sec": 6.3,
   "gap_before": 1.17,
   "role": "reply",
   "block": "board_games.dlg11"
  },
  {
   "speaker": "user",
   "text": "Maybe have a word with Moshi about the volume, Lily.",
   "est_sec": 3.2,
   "gap_before": 3.4,
   "block": "mm_115",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_115",
   "name_pos": "end",
   "addressee": "Lily"
  },
  {
   "speaker": "user",
   "text": "My hands shake a bit. Will that ruin it?",
   "est_sec": 2.89,
   "gap_before": 2.75,
   "block": "board_games.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Rest your wrists on the table, and hold the figure on a cork or a bottle top. And don't worry, from arm's length nobody sees the wobbles.",
   "est_sec": 8.47,
   "gap_before": 0.76,
   "role": "reply",
   "block": "board_games.dlg11"
  },
  {
   "speaker": "user",
   "text": "That's very comforting.",
   "est_sec": 1.03,
   "gap_before": 0.59,
   "block": "board_games.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Start with the biggest figure, three colours, and let a wash do the shadows for you. You'll be amazed at the result.",
   "est_sec": 6.92,
   "gap_before": 0.46,
   "role": "reply",
   "block": "board_games.dlg11"
  }
 ]
}
