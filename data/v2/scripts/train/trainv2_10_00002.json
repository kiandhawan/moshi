   "gap_before": 1.14,
   "role": "reply",
   "block": "movies.dlg22"
  },
  {
   "speaker": "user",
   "text": "Is this one a comedy?",
   "est_sec": 1.65,
   "gap_before": 0.4,
   "block": "movies.dlg22",
   "event": "ordinary_request"
  },
  {
