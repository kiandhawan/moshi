 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.33,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "Are expensive hiking socks really worth it? They're like fifteen quid a pair.",
   "est_sec": 4.13,
   "gap_before": 0.3,
   "block": "hiking.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Honestly, yes, at least one or two good pairs. Merino wool socks stay warm when damp, wick sweat, and don't smell after a long day.",
   "est_sec": 7.85,
   "gap_before": 0.95,
   "role": "reply",
   "block": "hiking.dlg24"
  },
  {
   "speaker": "user",
   "text": "Mine smell after an hour.",
   "est_sec": 1.65,
   "gap_before": 0.67,
   "block": "hiking.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then you'll notice the difference. Merino also tends to reduce blisters because your feet stay drier.",
   "est_sec": 5.06,
   "gap_before": 0.62,
   "role": "reply",
   "block": "hiking.dlg24"
  },
  {
   "speaker": "user",
   "text": "Do they wear out fast?",
   "est_sec": 1.65,
   "gap_before": 1.25,
   "block": "hiking.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Faster than synthetic ones, usually. Blends with a bit of nylon last longer.",
   "est_sec": 4.13,
   "gap_before": 1.12,
   "role": "reply",
   "block": "hiking.dlg24"
  },
  {
   "speaker": "user",
   "text": "Okay, I'll buy two pairs and",
   "est_sec": 1.96,
   "gap_before": 1.49,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg24"
  },
  {
   "speaker": "user",
   "text": "see how it goes.",
   "est_sec": 1.34,
   "gap_before": 2.99,
   "block": "hiking.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good plan. Wash them cool and skip the tumble dryer, they'll last much longer.",
   "est_sec": 4.44,
   "gap_before": 0.51,
   "role": "reply",
   "block": "hiking.dlg24"
  }
 ]
