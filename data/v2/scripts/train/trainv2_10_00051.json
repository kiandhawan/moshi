   "gap_before": 1.28,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 57,
   "phrasing": "think_instruction_v2_38"
  },
  {
   "speaker": "moshi",
   "text": "Okay, sure.",
   "est_sec": 0.72,
   "gap_before": 0.21,
   "role": "ack",
   "phrasing": "ack_16"
  },
  {
   "speaker": "user",
   "text": "Right, I'm ready.",
