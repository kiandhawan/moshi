 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.71,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.33,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I got fined on the tram because my ticket app crashed. I had actually paid! It's infuriating.",
   "est_sec": 5.37,
   "gap_before": 0.32,
   "block": "public_transport.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's maddening. You can usually appeal. Did the app show the purchase anywhere, like in your email or bank statement?",
   "est_sec": 6.3,
   "gap_before": 0.66,
   "role": "reply",
   "block": "public_transport.dlg24"
  },
  {
   "speaker": "user",
   "text": "My bank shows the payment.",
   "est_sec": 1.65,
   "gap_before": 0.97,
   "block": "public_transport.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good, that's your evidence. Screenshot the payment with the date and time and send it along with your appeal.",
   "est_sec": 5.99,
   "gap_before": 0.6,
   "role": "reply",
   "block": "public_transport.dlg24"
  },
  {
   "speaker": "user",
   "text": "Where do I",
   "est_sec": 1.03,
   "gap_before": 0.39,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg24"
  },
  {
   "speaker": "user",
   "text": "even send it?",
   "est_sec": 1.03,
   "gap_before": 2.51,
   "block": "public_transport.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "The fine notice should list an address or website for appeals. Do it soon, there's often a short deadline.",
   "est_sec": 5.99,
   "gap_before": 0.67,
   "role": "reply",
   "block": "public_transport.dlg24"
  },
  {
   "speaker": "user",
   "text": "They'll probably ignore me.",
   "est_sec": 1.34,
   "gap_before": 0.67,
   "block": "public_transport.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Proof of payment usually wins these cases. Keep it calm and factual.",
   "est_sec": 3.82,
   "gap_before": 0.82,
   "role": "reply",
   "block": "public_transport.dlg24"
  }
 ]
