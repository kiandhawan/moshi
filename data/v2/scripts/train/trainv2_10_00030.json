 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.57,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "The silicone around my kitchen sink is peeling off. Can I just glue it back down, Moshi?",
   "est_sec": 5.37,
   "gap_before": 0.28,
   "block": "home_repair.dlg16",
   "kind": "moshi_name",
   "name_pos": "end",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sadly no, silicone won't stick to itself well. You need to cut all the old stuff out and start fresh.",
   "est_sec": 6.3,
   "gap_before": 1.3,
   "role": "reply",
   "block": "home_repair.dlg16"
  },
  {
   "speaker": "user",
   "text": "How do I get it all off?",
   "est_sec": 2.27,
   "gap_before": 0.56,
   "block": "home_repair.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Use a sharp blade or a special silicone remover tool. Then wipe with surgical spirit so there's no residue left.",
   "est_sec": 6.3,
   "gap_before": 0.69,
   "role": "reply",
   "block": "home_repair.dlg16"
  },
  {
   "speaker": "user",
   "text": "Then I just squeeze in new silicone?",
   "est_sec": 2.27,
   "gap_before": 0.5,
   "block": "home_repair.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, but tape both sides first with masking tape. It gives you crisp neat lines.",
   "est_sec": 4.75,
   "gap_before": 0.34,
   "role": "reply",
   "block": "home_repair.dlg16"
  },
  {
   "speaker": "user",
   "text": "Oh, clever. And then",
   "est_sec": 1.34,
   "gap_before": 0.7,
   "event": "distractor",
   "kind": "pause",
   "block": "home_repair.dlg16"
  },
  {
   "speaker": "user",
   "text": "peel the tape off when it's dry?",
   "est_sec": 2.27,
   "gap_before": 2.37,
   "block": "home_repair.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Peel it off while the silicone is still wet, right after smoothing. If you wait, it can tear the edge.",
   "est_sec": 6.3,
   "gap_before": 0.49,
   "role": "reply",
   "block": "home_repair.dlg16"
  }
 ]
