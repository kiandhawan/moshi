 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.79,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.31,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "How do I stop impulse buying at the supermarket?",
   "est_sec": 2.89,
   "gap_before": 0.32,
   "block": "personal_finance.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Make a list before you go and stick to it. Eating before you shop helps a surprising amount too.",
   "est_sec": 5.99,
   "gap_before": 1.18,
   "role": "reply",
   "block": "personal_finance.dlg13"
  },
  {
   "speaker": "user",
   "text": "I always end up with snacks I didn't plan.",
   "est_sec": 2.89,
   "gap_before": 0.46,
   "block": "personal_finance.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Try shopping online for groceries. You see the total as you go, and there are no tempting displays at the checkout.",
   "est_sec": 6.61,
   "gap_before": 0.38,
   "role": "reply",
   "block": "personal_finance.dlg13"
  },
  {
   "speaker": "user",
   "text": "Hang on, I missed that.",
   "est_sec": 1.65,
   "gap_before": 1.31,
   "block": "personal_finance.dlg13",
   "kind": "wait_like",
   "phrasing": "waitlike_04",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sure, here it is again. Try shopping online for groceries. You see the total as you go, and there are no tempting displays at the checkout.",
   "est_sec": 8.16,
   "gap_before": 1.11,
   "role": "reply",
   "block": "personal_finance.dlg13"
  },
  {
   "speaker": "user",
   "text": "Online has delivery fees though.",
   "est_sec": 1.65,
   "gap_before": 1.11,
   "block": "personal_finance.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Many shops offer free click and collect. Or compare the fee to what you spend on unplanned snacks, it might be cheaper.",
   "est_sec": 6.92,
   "gap_before": 0.96,
   "role": "reply",
   "block": "personal_finance.dlg13"
  },
  {
   "speaker": "user",
   "text": "Ha. Probably",
   "est_sec": 0.72,
   "gap_before": 0.92,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg13"
  },
  {
   "speaker": "user",
   "text": "way cheaper, honestly.",
   "est_sec": 1.03,
   "gap_before": 2.47,
   "block": "personal_finance.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then it might be worth a try for a month. Keep the receipts and compare.",
   "est_sec": 4.75,
   "gap_before": 0.32,
   "role": "reply",
   "block": "personal_finance.dlg13"
  }
 ]
