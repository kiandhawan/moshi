 "est_total_sec": 56.98,
 "est_speech_sec": 43.67,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.41,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.41,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "I get really panicky on packed trains. Like, heart racing, need to get off.",
   "est_sec": 4.44,
   "gap_before": 0.33,
   "block": "public_transport.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That sounds really hard. A few things can help. Standing near the doors gives a sense of space and an easy way out.",
   "est_sec": 7.23,
   "gap_before": 0.51,
   "role": "reply",
   "block": "public_transport.dlg15"
  },
  {
   "speaker": "user",
   "text": "Gabriella, can you fold the towels while I do the sheets?",
   "est_sec": 3.51,
   "gap_before": 0.56,
   "block": "nq_home_017",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_017",
   "name_pos": "start",
   "addressee": "Gabriella"
  },
  {
   "speaker": "user",
   "text": "I do try to stand there.",
   "est_sec": 1.96,
   "gap_before": 3.27,
   "block": "public_transport.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good. Slow breathing helps too, in for four counts and out for six. A longer out breath calms the body.",
   "est_sec": 6.3,
   "gap_before": 0.42,
   "role": "reply",
   "block": "public_transport.dlg15"
  },
  {
   "speaker": "user",
   "text": "Could I",
   "est_sec": 0.72,
   "gap_before": 1.11,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg15"
  },
  {
   "speaker": "user",
   "text": "just travel at a different time?",
   "est_sec": 1.96,
   "gap_before": 2.51,
   "block": "public_transport.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "If your work allows it, even half an hour earlier or later can make a huge difference to the crowds.",
   "est_sec": 6.3,
   "gap_before": 0.56,
   "role": "reply",
   "block": "public_transport.dlg15"
  },
  {
   "speaker": "user",
   "text": "My boss is pretty flexible.",
   "est_sec": 1.65,
   "gap_before": 1.38,
   "block": "public_transport.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then that's worth asking about. And if the panic keeps getting in the way, talking to a doctor is a good idea too.",
   "est_sec": 7.23,
   "gap_before": 0.34,
   "role": "reply",
   "block": "public_transport.dlg15"
  }
 ]
}
