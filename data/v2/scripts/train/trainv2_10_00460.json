 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.54,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "I'm in a dorm with just a microwave and a kettle. Is real cooking even possible?",
   "est_sec": 5.06,
   "gap_before": 0.44,
   "block": "cooking.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "More than you'd think. You can steam vegetables, cook eggs, even make a mug risotto in the microwave.",
   "est_sec": 5.68,
   "gap_before": 0.66,
   "role": "reply",
   "block": "cooking.dlg5"
  },
  {
   "speaker": "user",
   "text": "Hi Ngozi, did you sleep at all last night?",
   "est_sec": 2.89,
   "gap_before": 1.26,
   "block": "nq_home_026",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_026",
   "name_pos": "start",
   "addressee": "Ngozi"
  },
  {
   "speaker": "user",
   "text": "Wait, eggs in a microwave? Don't they explode?",
   "est_sec": 2.58,
   "gap_before": 2.24,
   "block": "cooking.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Only if they're in the shell. Scramble them in a mug, cook for thirty seconds, stir, and repeat until set.",
   "est_sec": 6.3,
   "gap_before": 0.47,
   "role": "reply",
   "block": "cooking.dlg5"
  },
  {
   "speaker": "user",
   "text": "Okay that's actually useful. What about something filling for",
   "est_sec": 2.89,
   "gap_before": 0.57,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg5"
  },
  {
   "speaker": "user",
   "text": "after a late lecture?",
   "est_sec": 1.34,
   "gap_before": 2.85,
   "block": "cooking.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Instant noodles with an egg and frozen peas thrown in. Pour boiling water from the kettle, cover, and wait four minutes.",
   "est_sec": 6.61,
   "gap_before": 1.11,
   "role": "reply",
   "block": "cooking.dlg5"
  },
  {
   "speaker": "user",
   "text": "Frozen peas, nice. I don't have a freezer though, just a tiny fridge.",
   "est_sec": 4.13,
   "gap_before": 1.27,
   "block": "cooking.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then use a tin of sweetcorn or some spinach. Spinach wilts in seconds in hot noodles.",
   "est_sec": 5.06,
   "gap_before": 0.6,
   "role": "reply",
   "block": "cooking.dlg5"
  }
 ]
