   "text": "Should I memorize it?",
   "est_sec": 1.34,
   "gap_before": 0.78,
   "block": "books.dlg24",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "No need. Print it in large font on a card. Looking up now and then is plenty.",
   "est_sec": 5.37,
   "gap_before": 0.73,
   "role": "reply",
   "block": "books.dlg24"
  },
  {
   "speaker": "user",
   "text": "Wait, are you sure about that?",
   "est_sec": 1.96,
   "gap_before": 0.38,
   "block": "books.dlg24",
   "kind": "wait_like",
   "phrasing": "waitlike_08",
   "event": "ordinary_request"
  },
  {
