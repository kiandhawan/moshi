 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.38,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.32,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "I don't drive. Can I still do proper hikes?",
   "est_sec": 2.89,
   "gap_before": 0.45,
   "block": "hiking.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Absolutely. Linear walks are great for that, you take a bus or train to the start and catch another one home from the end.",
   "est_sec": 7.54,
   "gap_before": 0.99,
   "role": "reply",
   "block": "hiking.dlg21"
  },
  {
   "speaker": "user",
   "text": "Oh, I'd never thought of walking from one station to another.",
   "est_sec": 3.51,
   "gap_before": 1.17,
   "block": "hiking.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Lots of good routes work that way, and you never have to walk back the same path.",
   "est_sec": 5.37,
   "gap_before": 0.66,
   "role": "reply",
   "block": "hiking.dlg21"
  },
  {
   "speaker": "user",
   "text": "But what if I miss the last bus?",
   "est_sec": 2.58,
   "gap_before": 0.62,
   "block": "hiking.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Check the timetable before you set off and plan to arrive with an hour to spare. Save a local taxi number as a backup.",
   "est_sec": 7.54,
   "gap_before": 0.56,
   "role": "reply",
   "block": "hiking.dlg21"
  },
  {
   "speaker": "user",
   "text": "Smart. Any",
   "est_sec": 0.72,
   "gap_before": 0.35,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg21"
  },
  {
   "speaker": "user",
   "text": "tips for finding these routes?",
   "est_sec": 1.65,
   "gap_before": 2.64,
   "block": "hiking.dlg21",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Rambling clubs and walking guidebooks often list public transport routes. Search for car free walks too.",
   "est_sec": 5.06,
   "gap_before": 0.67,
   "role": "reply",
   "block": "hiking.dlg21"
  }
 ]
