 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.41,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.41,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "We're hiking in the hills and I can hear thunder. Moshi, what do I do?",
   "est_sec": 4.75,
   "gap_before": 0.59,
   "block": "weather_plans.dlg13",
   "kind": "moshi_name",
   "name_pos": "middle",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Head downhill and away from ridges and peaks straight away. Don't shelter under a lone tree.",
   "est_sec": 5.06,
   "gap_before": 0.79,
   "role": "reply",
   "block": "weather_plans.dlg13"
  },
  {
   "speaker": "user",
   "text": "We're on a ridge.",
   "est_sec": 1.34,
   "gap_before": 0.62,
   "event": "distractor",
   "kind": "pause",
   "block": "weather_plans.dlg13"
  },
  {
   "speaker": "user",
   "text": "Like, right on top of it.",
   "est_sec": 1.96,
   "gap_before": 2.33,
   "block": "weather_plans.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then get off it as fast as you safely can. Lower ground with lots of shorter trees is better than open space.",
   "est_sec": 6.92,
   "gap_before": 1.19,
   "role": "reply",
   "block": "weather_plans.dlg13"
  },
  {
   "speaker": "user",
   "text": "What if it's right on top of us?",
   "est_sec": 2.58,
   "gap_before": 0.43,
   "block": "weather_plans.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Spread out from each other, keep away from metal fences, and crouch low on your pack if it gets close.",
   "est_sec": 6.3,
   "gap_before": 1.17,
   "role": "reply",
   "block": "weather_plans.dlg13"
  },
  {
   "speaker": "user",
   "text": "Okay, we're moving.",
   "est_sec": 1.03,
   "gap_before": 1.23,
   "block": "weather_plans.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good. Wait about half an hour after the last thunder before going back up high.",
   "est_sec": 4.75,
   "gap_before": 0.73,
   "role": "reply",
   "block": "weather_plans.dlg13"
  }
 ]
