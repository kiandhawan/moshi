 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.74,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.32,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "Can you explain backgammon really simply? I've got a board from my uncle.",
   "est_sec": 4.13,
   "gap_before": 0.41,
   "block": "board_games.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sure. Each player has fifteen checkers. You roll two dice and move your checkers around the board toward your home corner.",
   "est_sec": 6.61,
   "gap_before": 0.51,
   "role": "reply",
   "block": "board_games.dlg22"
  },
  {
   "speaker": "user",
   "text": "Hold on, that's not right.",
   "est_sec": 1.65,
   "gap_before": 1.26,
   "block": "board_games.dlg22",
   "kind": "wait_like",
   "phrasing": "waitlike_07",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Hmm, I believe it is. Which part doesn't sound right?",
   "est_sec": 3.2,
   "gap_before": 1.16,
   "role": "reply",
   "block": "board_games.dlg22"
  },
  {
   "speaker": "user",
   "text": "And then?",
   "est_sec": 0.72,
   "gap_before": 1.43,
   "block": "board_games.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Once all your checkers are home, you start taking them off the board. First to remove all fifteen wins.",
   "est_sec": 5.99,
   "gap_before": 0.69,
   "role": "reply",
   "block": "board_games.dlg22"
  },
  {
   "speaker": "user",
   "text": "What's the hitting thing? My uncle always shouted when he hit me.",
   "est_sec": 3.82,
   "gap_before": 0.91,
   "block": "board_games.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "If one of your checkers is alone on a point and the other player lands there, it's sent to the start and has to come back in.",
   "est_sec": 8.47,
   "gap_before": 0.72,
   "role": "reply",
   "block": "board_games.dlg22"
  },
  {
   "speaker": "user",
   "text": "Ah, so that's why he was always so pleased.",
   "est_sec": 2.89,
   "gap_before": 0.76,
   "block": "board_games.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Keep your checkers in pairs where you can, then they're safe. That alone will annoy your uncle a lot.",
   "est_sec": 6.3,
   "gap_before": 0.79,
   "role": "reply",
   "block": "board_games.dlg22"
  }
 ]
}
