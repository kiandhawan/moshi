   "gap_before": 0.39,
   "block": "sleep.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can soften it. Starting Thursday, go to bed and get up fifteen minutes earlier each day.",
   "est_sec": 5.37,
   "gap_before": 0.64,
   "role": "reply",
   "block": "sleep.dlg11"
  },
  {
   "speaker": "user",
   "text": "Did you ever ring the bank about that charge, Fiona?",
