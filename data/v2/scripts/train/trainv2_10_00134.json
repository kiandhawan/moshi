   "gap_before": 0.67,
   "role": "reply",
   "block": "movies.dlg21"
  },
  {
   "speaker": "user",
   "text": "Grandma stopped driving last year and her little car is just sitting in the drive.",
   "est_sec": 4.75,
   "gap_before": 1.44,
   "block": "cars.ctx6",
   "event": "ordinary_request"
  },
  {
