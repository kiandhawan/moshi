   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "They offered me the job! But the salary is a bit lower than I hoped. Can I negotiate?",
   "est_sec": 5.68,
   "gap_before": 0.21,
   "block": "job_interview.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Congratulations! And yes, negotiating a fair offer is normal. How far off is it?",
   "est_sec": 4.44,
   "gap_before": 0.54,
   "role": "reply",
   "block": "job_interview.dlg18"
  },
  {
   "speaker": "user",
   "text": "Is the new series of that baking show out yet, Hana?",
