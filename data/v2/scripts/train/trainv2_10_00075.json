   "addressee": "Hana"
  },
  {
   "speaker": "other",
   "text": "Next Friday, I checked.",
   "est_sec": 1.34,
   "gap_before": 0.6,
   "block": "nq_social_063"
  },
  {
   "speaker": "user",
   "text": "About three thousand less than what I asked for.",
   "est_sec": 2.89,
   "gap_before": 1.26,
   "block": "job_interview.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a reasonable gap to try closing. Thank them warmly, then say you're excited but were hoping for a figure closer to your original number.",
   "est_sec": 7.85,
   "gap_before": 1.08,
   "role": "reply",
   "block": "job_interview.dlg18"
  },
  {
   "speaker": "user",
   "text": "Is it me, or does Moshi talk faster in the mornings?",
   "est_sec": 3.51,
   "gap_before": 2.2,
   "block": "mm_075",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_075",
   "name_pos": "none"
  },
  {
