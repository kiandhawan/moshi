 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "Hey. Random question. Why do my doors swing open on their own?",
   "est_sec": 3.82,
   "gap_before": 0.34,
   "block": "home_repair.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Usually the door isn't hanging quite straight, so gravity pulls it. Older houses with sloping floors do this a lot.",
   "est_sec": 6.3,
   "gap_before": 0.84,
   "role": "reply",
   "block": "home_repair.dlg29"
  },
  {
   "speaker": "user",
   "text": "Unrelated, but I'm retiring next year and I've no idea how to budget without a salary.",
   "est_sec": 5.06,
   "gap_before": 1.04,
   "block": "personal_finance.ctx12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Big change. Do you want to start by working out your monthly costs, or by figuring out how much income you'll actually have?",
   "est_sec": 7.23,
   "gap_before": 0.42,
   "role": "reply",
   "block": "personal_finance.ctx12"
  },
  {
   "speaker": "friend",
   "text": "Come look at this.",
   "est_sec": 1.34,
   "gap_before": 1.14,
   "event": "distractor",
   "kind": "friend_interrupt",
   "phrasing": "friend_interrupt_v2_11"
  },
  {
   "speaker": "user",
   "text": "Just a second, Moshi, let me deal with this.",
   "est_sec": 2.89,
   "gap_before": 0.51,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instruction_v2_55"
  },
  {
   "speaker": "user",
   "text": "Leo, which of these two pans do you think is better?",
   "est_sec": 3.51,
   "gap_before": 1.32,
   "event": "distractor",
   "kind": "friend_question",
   "block": "shopping.side3"
  },
  {
   "speaker": "friend",
   "text": "The heavier one. Thin pans burn everything.",
   "est_sec": 2.27,
   "gap_before": 1.39,
   "block": "shopping.side3"
  },
  {
   "speaker": "user",
   "text": "It's almost twice the price though.",
   "est_sec": 1.96,
   "gap_before": 0.36,
   "block": "shopping.side3"
  },
  {
   "speaker": "friend",
   "text": "It'll last you ten years. The other one will be scratched by spring.",
   "est_sec": 4.13,
   "gap_before": 0.74,
   "block": "shopping.side3"
  },
  {
   "speaker": "user",
   "text": "Okay, you've convinced me. Can you hold it while I find a basket?",
   "est_sec": 4.13,
   "gap_before": 0.47,
   "event": "distractor",
   "kind": "friend_question",
   "block": "shopping.side3"
  },
  {
   "speaker": "friend",
   "text": "Sure, go ahead.",
   "est_sec": 1.03,
   "gap_before": 3.31,
   "block": "shopping.side3"
  },
  {
   "speaker": "user",
   "text": "Done. Talk to me.",
   "est_sec": 1.34,
   "gap_before": 1.84,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_v2_07"
  },
  {
   "speaker": "moshi",
   "text": "Okay. Your retirement budget. Starting with costs or with income?",
   "est_sec": 3.2,
   "gap_before": 1.18,
   "role": "resume",
   "block": "personal_finance.ctx12"
  },
  {
   "speaker": "user",
   "text": "Ours is from the twenties, so yeah, sloping everything.",
   "est_sec": 2.89,
   "gap_before": 1.48,
   "event": "ordinary_request",
   "block": "home_repair.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "A simple trick is to take one hinge pin out and give it a very slight bend. It adds friction so the door stays where you leave it.",
   "est_sec": 8.78,
   "gap_before": 1.08,
   "role": "reply",
   "block": "home_repair.dlg29"
  }
 ]
