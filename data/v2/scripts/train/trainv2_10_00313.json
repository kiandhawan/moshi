 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.51,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.68,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "The wind is crazy this morning. Do I even bother with an umbrella for the school run?",
   "est_sec": 5.37,
   "gap_before": 0.29,
   "block": "weather_plans.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Probably not. In strong wind umbrellas just flip inside out or try to take off.",
   "est_sec": 4.75,
   "gap_before": 0.99,
   "role": "reply",
   "block": "weather_plans.dlg22"
  },
  {
   "speaker": "user",
   "text": "My son loves his dinosaur umbrella though.",
   "est_sec": 2.27,
   "gap_before": 0.75,
   "block": "weather_plans.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Maybe save it for a calm rainy day. Today, a hooded coat for everyone works better.",
   "est_sec": 5.06,
   "gap_before": 1.13,
   "role": "reply",
   "block": "weather_plans.dlg22"
  },
  {
   "speaker": "user",
   "text": "He'll be devastated.",
   "est_sec": 1.03,
   "gap_before": 0.88,
   "event": "distractor",
   "kind": "pause",
   "block": "weather_plans.dlg22"
  },
  {
   "speaker": "user",
   "text": "He takes his umbrella very seriously.",
   "est_sec": 1.96,
   "gap_before": 2.85,
   "block": "weather_plans.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Let him bring it closed, he can hold it like a sword. He still gets to have it.",
   "est_sec": 5.68,
   "gap_before": 1.8,
   "role": "reply",
   "block": "weather_plans.dlg22"
  },
  {
   "speaker": "user",
   "text": "That might actually work.",
   "est_sec": 1.34,
   "gap_before": 1.29,
   "block": "weather_plans.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Kids love a compromise that sounds like an adventure. Stay away from trees and building sites on the way too.",
   "est_sec": 6.3,
   "gap_before": 0.31,
