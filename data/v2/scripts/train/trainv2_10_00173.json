 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.69,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "The shelf said three ninety nine and the till charged me five. Can I do anything?",
   "est_sec": 5.06,
   "gap_before": 0.24,
   "block": "shopping.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, definitely. Go to customer service with your receipt and tell them the shelf price was different.",
   "est_sec": 5.37,
   "gap_before": 0.68,
   "role": "reply",
   "block": "shopping.dlg29"
  },
  {
   "speaker": "user",
   "text": "I already left the shop.",
   "est_sec": 1.65,
   "gap_before": 1.32,
   "block": "shopping.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can still go back with the receipt. It helps if you snapped a photo of the shelf label, but staff can check it themselves.",
   "est_sec": 7.85,
   "gap_before": 0.41,
   "role": "reply",
   "block": "shopping.dlg29"
  },
  {
   "speaker": "user",
   "text": "Hold on, I didn't take a photo.",
   "est_sec": 2.27,
   "gap_before": 0.72,
   "block": "shopping.dlg29",
   "kind": "wait_like",
   "phrasing": "waitlike_14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's okay. Most shops will honour the shelf price, and some even refund the item entirely as a goodwill gesture.",
   "est_sec": 6.3,
   "gap_before": 0.48,
   "role": "reply",
   "block": "shopping.dlg29"
  },
  {
   "speaker": "user",
   "text": "For a pound I don't know if it's worth the trip.",
   "est_sec": 3.51,
   "gap_before": 2.1,
   "block": "shopping.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Fair. Next time you're in, just mention it. And it's worth telling them so they fix the label for everyone else.",
   "est_sec": 6.61,
   "gap_before": 0.42,
   "role": "reply",
   "block": "shopping.dlg29"
  }
 ]
