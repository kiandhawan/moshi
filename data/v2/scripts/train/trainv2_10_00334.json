 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.95,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "We want to keep our weekly game night but now there's a toddler in the house. Tiny pieces everywhere.",
   "est_sec": 5.99,
   "gap_before": 0.45,
   "block": "board_games.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a real worry, small pieces are a choking risk. Play after bedtime when you can, and do a quick count of the pieces when you pack up.",
   "est_sec": 8.78,
   "gap_before": 0.73,
   "role": "reply",
   "block": "board_games.dlg27"
  },
  {
   "speaker": "user",
   "text": "He doesn't go to bed till eight.",
   "est_sec": 2.27,
   "gap_before": 1.31,
   "block": "board_games.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then before eight, pick games with bigger parts, like card games or tile games with chunky tiles.",
   "est_sec": 5.37,
   "gap_before": 1.27,
   "role": "reply",
   "block": "board_games.dlg27"
  },
  {
   "speaker": "user",
   "text": "He grabs cards too. And chews them.",
   "est_sec": 2.27,
   "gap_before": 1.69,
   "block": "board_games.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Give him his own set of big, safe pieces to play with next to you. Toddlers love feeling included.",
   "est_sec": 5.99,
   "gap_before": 1.08,
   "role": "reply",
   "block": "board_games.dlg27"
  },
  {
   "speaker": "user",
   "text": "That's sweet actually.",
   "est_sec": 1.03,
   "gap_before": 0.82,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg27"
  },
  {
   "speaker": "user",
   "text": "He'd love having his own game.",
   "est_sec": 1.96,
   "gap_before": 1.74,
   "block": "board_games.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "And a tray with a lip under the board helps. Things don't roll off the table, and you can lift the whole game out of reach.",
   "est_sec": 8.16,
   "gap_before": 0.5,
   "role": "reply",
   "block": "board_games.dlg27"
  }
 ]
}
