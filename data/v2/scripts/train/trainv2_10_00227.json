   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.87,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "My cat knocked a glass of water onto my library book. The pages are all wavy.",
   "est_sec": 5.06,
   "gap_before": 0.56,
   "block": "books.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Oh no. Is it still dripping, or just damp?",
   "est_sec": 2.89,
   "gap_before": 0.37,
   "role": "reply",
   "block": "books.dlg28"
  },
  {
   "speaker": "user",
   "text": "Just damp now. It happened an hour ago.",
   "est_sec": 2.58,
   "gap_before": 1.19,
   "block": "books.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Stand it up with the pages fanned out, near a fan but not a heater. Paper towels between the wettest pages help too.",
   "est_sec": 7.23,
   "gap_before": 0.54,
   "role": "reply",
   "block": "books.dlg28"
  },
  {
   "speaker": "user",
   "text": "When's your next match, Tanisha?",
