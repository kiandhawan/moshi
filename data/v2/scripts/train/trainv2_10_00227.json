   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_060",
   "name_pos": "end",
   "addressee": "Tanisha"
  },
  {
   "speaker": "user",
   "text": "Will the library make me pay for it?",
   "est_sec": 2.58,
   "gap_before": 3.03,
   "block": "books.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "They might, if it's badly damaged. Being honest usually helps, and some libraries just charge a small fee.",
   "est_sec": 5.68,
   "gap_before": 1.2,
   "role": "reply",
   "block": "books.dlg28"
  },
  {
   "speaker": "user",
   "text": "I feel so guilty. It's",
   "est_sec": 1.65,
   "gap_before": 0.51,
   "event": "distractor",
   "kind": "pause",
   "block": "books.dlg28"
  },
  {
