 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.33,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.72,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "Every Swiss roll I make cracks when I roll it up.",
   "est_sec": 3.51,
   "gap_before": 0.6,
   "block": "baking.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Are you rolling it while it's still warm?",
   "est_sec": 2.58,
   "gap_before": 1.03,
   "role": "reply",
   "block": "baking.dlg26"
  },
  {
   "speaker": "user",
   "text": "No, I let it cool first so the cream doesn't melt.",
   "est_sec": 3.51,
   "gap_before": 1.43,
   "block": "baking.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's the trick most people miss. Roll the sponge up warm in a clean tea towel without any filling, let it cool in that shape, then unroll and fill.",
   "est_sec": 9.09,
   "gap_before": 1.49,
   "role": "reply",
   "block": "baking.dlg26"
  },
  {
   "speaker": "user",
   "text": "So it sort of",
   "est_sec": 1.34,
   "gap_before": 0.66,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg26"
  },
