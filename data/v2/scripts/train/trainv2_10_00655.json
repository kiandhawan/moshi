   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "How do I tell if online reviews are fake? This bluetooth speaker has like five thousand stars and I don't believe it.",
   "est_sec": 6.92,
   "gap_before": 0.48,
   "block": "shopping.dlg10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Healthy suspicion. Look at the bad reviews first, they're often more honest about what actually breaks.",
   "est_sec": 5.06,
   "gap_before": 0.56,
   "role": "reply",
   "block": "shopping.dlg10"
  },
  {
   "speaker": "user",
   "text": "Unrelated, but We've played the same three games every week for a year. I'm bored.",
   "est_sec": 4.75,
   "gap_before": 1.26,
   "block": "board_games.ctx3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Time for something new. Do you want a short game you can play a few rounds of, or one long epic game for the whole evening?",
   "est_sec": 8.16,
   "gap_before": 0.43,
   "role": "reply",
   "block": "board_games.ctx3"
  },
  {
   "speaker": "user",
   "text": "Give me a minute, my friend just walked in. Don't say anything until I'm back.",
   "est_sec": 4.75,
   "gap_before": 1.41,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_02"
  },
  {
   "speaker": "user",
   "text": "Alex, are you sure about that move? You'll lose your whole army.",
