   "gap_before": 0.41,
   "block": "board_games.side6"
  },
  {
   "speaker": "user",
   "text": "Ones. All three ones.",
   "est_sec": 1.34,
   "gap_before": 1.35,
   "block": "board_games.side6"
  },
  {
   "speaker": "friend",
   "text": "I don't want to talk about it.",
   "est_sec": 2.27,
   "gap_before": 1.4,
   "block": "board_games.side6"
  },
  {
