   "gap_before": 0.92,
   "block": "board_games.side6"
  },
  {
   "speaker": "friend",
   "text": "Are you trying to help me or trick me?",
   "est_sec": 2.89,
   "gap_before": 1.42,
   "block": "board_games.side6"
  },
  {
   "speaker": "user",
   "text": "Honestly, a bit of both.",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "block": "board_games.side6"
  },
  {
   "speaker": "friend",
   "text": "Then I'm doing it. Three dice. Come on.",
