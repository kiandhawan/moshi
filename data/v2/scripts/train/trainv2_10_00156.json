 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.71,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.61,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "How many hours of gaming a day is okay for a twelve year old?",
   "est_sec": 4.44,
   "gap_before": 0.48,
   "block": "video_games.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "There's no magic number, but many parents aim for about an hour or two on school days, a bit more on weekends.",
   "est_sec": 6.92,
   "gap_before": 0.32,
   "role": "reply",
   "block": "video_games.dlg2"
  },
  {
   "speaker": "user",
   "text": "Okay Moshi, he'd play all day if I let him.",
   "est_sec": 3.2,
   "gap_before": 0.93,
   "block": "video_games.dlg2",
   "kind": "moshi_name",
   "name_pos": "start",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most kids would. It helps to agree on rules together, so it feels less like a punishment.",
   "est_sec": 5.37,
   "gap_before": 0.77,
   "role": "reply",
   "block": "video_games.dlg2"
  },
  {
   "speaker": "user",
   "text": "Wait, are you sure about that?",
   "est_sec": 1.96,
   "gap_before": 0.33,
   "block": "video_games.dlg2",
   "kind": "wait_like",
   "phrasing": "waitlike_08",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Hmm, I believe it is. Which part doesn't sound right?",
   "est_sec": 3.2,
   "gap_before": 0.78,
   "role": "reply",
   "block": "video_games.dlg2"
  },
  {
   "speaker": "user",
   "text": "What if he's in the middle of a match when time's up?",
   "est_sec": 3.82,
   "gap_before": 1.2,
   "block": "video_games.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Give a warning about ten minutes before, so he can finish the round. Cutting off a match mid game usually causes a fight.",
   "est_sec": 7.23,
   "gap_before": 0.58,
   "role": "reply",
   "block": "video_games.dlg2"
  },
  {
   "speaker": "user",
   "text": "That makes sense. I've been",
   "est_sec": 1.65,
   "gap_before": 1.42,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg2"
  },
  {
   "speaker": "user",
   "text": "just turning it off.",
   "est_sec": 1.34,
   "gap_before": 2.9,
   "block": "video_games.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A lot of parents do. The warning tends to make the whole thing much calmer.",
   "est_sec": 4.75,
