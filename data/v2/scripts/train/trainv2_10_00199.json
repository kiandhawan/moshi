 "est_total_sec": 63.36,
 "est_speech_sec": 44.39,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.52,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.42,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "My teenagers hate sightseeing. How do I plan a city trip they won't sulk through?",
   "est_sec": 4.75,
   "gap_before": 0.55,
   "block": "travel_planning.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Let each of them choose one thing for the trip. Ownership makes a huge difference with teens.",
   "est_sec": 5.37,
   "gap_before": 0.72,
   "role": "reply",
   "block": "travel_planning.dlg25"
  },
  {
   "speaker": "user",
   "text": "Maybe Moshi can sort out the chore rota, since we can't.",
   "est_sec": 3.51,
   "gap_before": 3.41,
   "block": "mm_064",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_064",
   "name_pos": "none"
  },
  {
   "speaker": "other",
   "text": "Good luck with that.",
   "est_sec": 1.34,
   "gap_before": 0.82,
   "block": "mm_064"
  },
  {
   "speaker": "user",
   "text": "One of them will choose a shopping mall.",
   "est_sec": 2.58,
   "gap_before": 1.16,
   "block": "travel_planning.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's okay. Balance it with activities that don't feel like sightseeing, like bike tours, food markets or a climbing park.",
   "est_sec": 6.3,
   "gap_before": 0.53,
   "role": "reply",
   "block": "travel_planning.dlg25"
  },
  {
   "speaker": "user",
   "text": "Food markets might work. They're always hungry.",
   "est_sec": 2.27,
   "gap_before": 2.99,
   "block": "travel_planning.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Perfect, use that. A street food tour can feel more like an adventure than a museum.",
   "est_sec": 5.06,
   "gap_before": 1.49,
   "role": "reply",
   "block": "travel_planning.dlg25"
  },
  {
   "speaker": "user",
   "text": "And mornings? They",
   "est_sec": 1.03,
   "gap_before": 2.21,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg25"
  },
  {
   "speaker": "user",
   "text": "sleep until noon on holiday.",
   "est_sec": 1.65,
   "gap_before": 1.69,
   "block": "travel_planning.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Let them. Plan the big activity for the afternoon and keep mornings for things you and your partner want to do.",
   "est_sec": 6.61,
   "gap_before": 0.96,
   "role": "reply",
   "block": "travel_planning.dlg25"
  }
 ]
}
