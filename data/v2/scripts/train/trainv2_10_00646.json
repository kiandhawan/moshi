  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.32,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.71,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "How do I write a good introduction to an essay? Mine always sound so boring.",
   "est_sec": 4.75,
   "gap_before": 0.46,
   "block": "studying.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A good intro usually does three things. Hooks the reader, gives a bit of context, and states your main argument.",
   "est_sec": 6.3,
   "gap_before": 0.9,
   "role": "reply",
   "block": "studying.dlg17"
  },
  {
   "speaker": "user",
   "text": "What counts as a hook?",
   "est_sec": 1.65,
   "gap_before": 0.5,
   "block": "studying.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A surprising fact, a short story, or a strong question. Something that makes the reader want to keep going.",
   "est_sec": 5.99,
   "gap_before": 0.37,
   "role": "reply",
   "block": "studying.dlg17"
  },
  {
   "speaker": "user",
   "text": "My teacher says no rhetorical questions.",
   "est_sec": 1.96,
   "gap_before": 0.64,
   "block": "studying.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then try a fact or a short scene. For example, for an essay on cities, start with a busy street at rush hour.",
   "est_sec": 7.23,
   "gap_before": 1.01,
   "role": "reply",
   "block": "studying.dlg17"
  },
  {
   "speaker": "user",
   "text": "And the argument bit,",
   "est_sec": 1.34,
   "gap_before": 0.66,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg17"
  },
  {
   "speaker": "user",
   "text": "how long should that be?",
   "est_sec": 1.65,
   "gap_before": 1.76,
   "block": "studying.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "One or two clear sentences. The reader should know exactly what you're going to argue.",
   "est_sec": 4.75,
   "gap_before": 0.5,
   "role": "reply",
   "block": "studying.dlg17"
  }
 ]
