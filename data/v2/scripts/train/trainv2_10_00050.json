 "est_total_sec": 54.33,
 "est_speech_sec": 42.33,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.61,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.86,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "I'm trying to declutter my clothes before I move, but I can't let anything go.",
   "est_sec": 4.75,
   "gap_before": 0.54,
   "block": "moving_house.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Try asking yourself whether you'd buy it again today. If the answer is no, it's probably time.",
   "est_sec": 5.37,
   "gap_before": 1.15,
   "role": "reply",
   "block": "moving_house.dlg16"
  },
  {
   "speaker": "user",
   "text": "What about stuff I might fit into again one day?",
   "est_sec": 3.2,
   "gap_before": 0.84,
   "block": "moving_house.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Keep a small box of those, and set a date. If you haven't worn them by then, they go.",
   "est_sec": 5.99,
   "gap_before": 0.56,
   "role": "reply",
   "block": "moving_house.dlg16"
  },
  {
   "speaker": "user",
   "text": "That's a bit harsh. But",
   "est_sec": 1.65,
   "gap_before": 1.03,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg16"
  },
  {
   "speaker": "user",
   "text": "probably fair.",
   "est_sec": 0.72,
   "gap_before": 2.15,
   "block": "moving_house.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Another trick is turning all your hangers backwards. Turn them the right way when you wear something, and after a few months you'll see what you never touch.",
   "est_sec": 8.78,
   "gap_before": 0.56,
   "role": "reply",
   "block": "moving_house.dlg16"
  },
  {
   "speaker": "user",
   "text": "I don't have a few months. I move in three weeks.",
   "est_sec": 3.51,
   "gap_before": 1.08,
   "block": "moving_house.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then just keep what you've worn in the last year, and donate the rest.",
   "est_sec": 4.44,
   "gap_before": 1.12,
   "role": "reply",
   "block": "moving_house.dlg16"
  }
 ]
}
