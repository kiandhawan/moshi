 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.33,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.66,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "During exams my heart races and my mind goes blank, even when I know the stuff.",
   "est_sec": 5.06,
   "gap_before": 0.21,
   "block": "studying.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That sounds really stressful, and it's very common. Your body's alarm system is just going off at the wrong time.",
   "est_sec": 6.3,
   "gap_before": 0.48,
   "role": "reply",
   "block": "studying.dlg6"
  },
  {
   "speaker": "user",
   "text": "How do I switch it off?",
   "est_sec": 1.96,
   "gap_before": 1.13,
   "block": "studying.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Slow breathing helps quickly. Breathe in for four counts, out for six, a few times before you start and whenever you freeze.",
   "est_sec": 6.92,
   "gap_before": 1.17,
   "role": "reply",
   "block": "studying.dlg6"
  },
  {
   "speaker": "user",
   "text": "And if I go blank on a question?",
   "est_sec": 2.58,
   "gap_before": 0.57,
   "block": "studying.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Skip it, do one you're sure about, then come back. Getting a few answers down calms the panic.",
   "est_sec": 5.68,
   "gap_before": 1.42,
   "role": "reply",
   "block": "studying.dlg6"
  },
  {
   "speaker": "user",
   "text": "I just feel like",
   "est_sec": 1.34,
   "gap_before": 0.65,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg6"
  },
  {
   "speaker": "user",
   "text": "everyone else is so calm.",
   "est_sec": 1.65,
   "gap_before": 2.25,
   "block": "studying.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Lots of them aren't, they're just hiding it. It might also help to talk to your school's support team, they can sometimes arrange a quieter room.",
   "est_sec": 8.16,
   "gap_before": 0.81,
   "role": "reply",
   "block": "studying.dlg6"
  }
 ]
