 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.58,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.56,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "I use a wheelchair and I'm nervous about the train trip next week. Moshi, how does it work with ramps?",
   "est_sec": 6.3,
   "gap_before": 0.34,
   "block": "public_transport.dlg17",
   "kind": "moshi_name",
   "name_pos": "middle",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most rail companies let you book assistance in advance. Staff meet you at the platform with a ramp and help you on and off.",
   "est_sec": 7.54,
   "gap_before": 0.55,
   "role": "reply",
   "block": "public_transport.dlg17"
  },
  {
   "speaker": "user",
   "text": "Wait a second, how far in advance?",
   "est_sec": 2.27,
   "gap_before": 2.89,
   "block": "public_transport.dlg17",
   "kind": "wait_like",
   "phrasing": "waitlike_16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Often a day or two ahead is enough, though booking earlier is safer. You can usually do it by phone or online.",
   "est_sec": 6.92,
   "gap_before": 0.77,
   "role": "reply",
   "block": "public_transport.dlg17"
  },
  {
   "speaker": "user",
   "text": "What if the",
   "est_sec": 1.03,
   "gap_before": 1.33,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg17"
  },
  {
   "speaker": "user",
   "text": "staff don't show up at my stop?",
   "est_sec": 2.27,
   "gap_before": 2.65,
   "block": "public_transport.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ask the guard on the train to radio ahead. They can also deploy the ramp themselves on many trains.",
   "est_sec": 5.99,
   "gap_before": 0.36,
   "role": "reply",
   "block": "public_transport.dlg17"
  },
  {
   "speaker": "user",
   "text": "That's reassuring.",
   "est_sec": 0.72,
   "gap_before": 0.33,
   "block": "public_transport.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Keep your booking reference handy, it makes everything go faster.",
   "est_sec": 3.2,
   "gap_before": 0.87,
   "role": "reply",
   "block": "public_transport.dlg17"
  }
 ]
