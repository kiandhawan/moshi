   "gap_before": 0.49,
   "role": "reply",
   "block": "books.dlg1"
  },
  {
   "speaker": "user",
   "text": "Okay, something else. We need a hedge along the front for privacy, the road's got really busy.",
   "est_sec": 5.37,
   "gap_before": 1.33,
   "block": "gardening.ctx9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Okay. Do you want it thick and tall quickly, even if it's a bit plain, or would you wait a few extra years for a mixed native hedge that birds love?",
   "est_sec": 9.71,
   "gap_before": 0.54,
   "role": "reply",
   "block": "gardening.ctx9"
  },
  {
   "speaker": "user",
   "text": "Give me a minute, my friend just walked in. Don't say anything until I'm back.",
