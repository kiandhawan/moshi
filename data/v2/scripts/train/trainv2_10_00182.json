   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_02"
  },
  {
   "speaker": "moshi",
   "text": "Take your time.",
   "est_sec": 1.03,
   "gap_before": 0.2,
   "role": "ack",
   "phrasing": "ack_09"
  },
  {
   "speaker": "user",
   "text": "Ben, did you hear that rattling noise when we pulled in?",
