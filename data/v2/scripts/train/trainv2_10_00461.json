 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.45,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.59,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "Long distance train tickets are so expensive. Any tricks?",
   "est_sec": 2.89,
   "gap_before": 0.47,
   "block": "public_transport.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Booking ahead is the biggest one. Cheaper tickets usually go on sale about two or three months out.",
   "est_sec": 5.68,
   "gap_before": 1.02,
   "role": "reply",
   "block": "public_transport.dlg11"
  },
  {
   "speaker": "user",
   "text": "I never know my plans that far ahead.",
   "est_sec": 2.58,
   "gap_before": 0.35,
   "block": "public_transport.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then look into railcards if your country has them. They often cut a third off for a small yearly fee.",
   "est_sec": 6.3,
   "gap_before": 1.18,
   "role": "reply",
   "block": "public_transport.dlg11"
  },
  {
   "speaker": "user",
   "text": "Is there one for me? I'm",
   "est_sec": 1.96,
   "gap_before": 0.41,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg11"
  },
  {
   "speaker": "user",
   "text": "thirty one, so no student stuff.",
   "est_sec": 1.96,
   "gap_before": 1.96,
   "block": "public_transport.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "There are often cards for people under thirty, for couples, for families, or for anyone travelling regularly. Check what's offered where you live.",
   "est_sec": 7.23,
   "gap_before": 1.11,
   "role": "reply",
   "block": "public_transport.dlg11"
  },
  {
   "speaker": "user",
   "text": "Anything else?",
   "est_sec": 0.72,
   "gap_before": 0.74,
   "block": "public_transport.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Travelling off peak helps a lot. And splitting a journey into two tickets is sometimes cheaper than one.",
   "est_sec": 5.68,
   "gap_before": 0.98,
   "role": "reply",
   "block": "public_transport.dlg11"
  }
 ]
}
