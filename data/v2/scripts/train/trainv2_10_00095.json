 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.79,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.39,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "We're on holiday at the coast and it's meant to rain every day this week.",
   "est_sec": 4.75,
   "gap_before": 0.32,
   "block": "weather_plans.ctx12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's rotten luck. Would you ride it out here with indoor plans, or drive inland where it looks drier?",
   "est_sec": 5.99,
   "gap_before": 0.8,
   "role": "reply",
   "block": "weather_plans.ctx12"
  },
  {
   "speaker": "user",
   "text": "Can you give me twenty-nine seconds? Then ask me again.",
   "est_sec": 3.2,
   "gap_before": 1.1,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 29,
   "phrasing": "think_instr_05"
  },
  {
   "speaker": "user",
   "text": "Hmm, tough.",
   "est_sec": 0.72,
   "anchor": {
    "turn": 4,
    "offset": 5.84
   },
   "event": "distractor",
   "kind": "self_talk",
   "phrasing": "self_16"
  },
  {
   "speaker": "user",
   "text": "Okay, never mind, I figured it out.",
   "est_sec": 2.27,
   "anchor": {
    "turn": 4,
    "offset": 21.43
   },
   "event": "return_cue",
   "kind": "early_end",
   "phrasing": "early_end_07"
  },
  {
   "speaker": "moshi",
   "text": "So, stick it out at the coast, or head inland?",
   "est_sec": 3.2,
   "gap_before": 0.96,
   "role": "resume",
   "block": "weather_plans.ctx12"
  },
  {
   "speaker": "user",
   "text": "Inland. A couple of day trips at least.",
