 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.51,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.6,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "I own about five hundred books. Moving them is going to destroy me.",
   "est_sec": 4.13,
   "gap_before": 0.26,
   "block": "moving_house.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Use small boxes only. A big box full of books is too heavy to lift safely.",
   "est_sec": 5.06,
   "gap_before": 1.06,
   "role": "reply",
   "block": "moving_house.dlg11"
  },
  {
   "speaker": "user",
   "text": "Small boxes, got it.",
   "est_sec": 1.34,
   "gap_before": 1.13,
   "block": "moving_house.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Pack them flat or with the spines down, not standing on their edges or they'll warp. Fill gaps with paper so they don't slide.",
   "est_sec": 7.54,
   "gap_before": 1.12,
   "role": "reply",
   "block": "moving_house.dlg11"
  },
  {
   "speaker": "user",
   "text": "Should I get rid of some?",
   "est_sec": 1.96,
   "gap_before": 1.35,
   "block": "moving_house.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "This is the perfect moment to cull. Keep what you'd reread or love on your shelf, and donate the rest.",
   "est_sec": 6.3,
   "gap_before": 0.42,
   "role": "reply",
   "block": "moving_house.dlg11"
  },
  {
   "speaker": "user",
   "text": "Hold on, that's going to be",
   "est_sec": 1.96,
   "gap_before": 0.47,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg11"
  },
  {
   "speaker": "user",
   "text": "emotionally difficult.",
   "est_sec": 0.72,
   "gap_before": 1.86,
   "block": "moving_house.dlg11",
   "kind": "wait_like",
   "phrasing": "waitlike_14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Take it slowly. A good rule is, if you can't remember what it's about, it can go.",
   "est_sec": 5.37,
