 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.66,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "Taking a ferry tomorrow and the sea's meant to be rough. I get so seasick.",
   "est_sec": 4.75,
   "gap_before": 0.34,
   "block": "weather_plans.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sorry, that's no fun. Take seasickness tablets an hour or so before boarding, they work better before symptoms start.",
   "est_sec": 5.99,
   "gap_before": 0.51,
   "role": "reply",
   "block": "weather_plans.dlg28"
  },
  {
   "speaker": "user",
   "text": "Where should I sit?",
   "est_sec": 1.34,
   "gap_before": 0.93,
   "block": "weather_plans.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "In the middle of the boat and as low down as possible. That's where the movement is smallest.",
   "est_sec": 5.68,
   "gap_before": 0.39,
   "role": "reply",
   "block": "weather_plans.dlg28"
  },
  {
   "speaker": "user",
   "text": "Should I eat?",
   "est_sec": 1.03,
   "gap_before": 0.67,
   "block": "weather_plans.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A light, plain meal beforehand helps. An empty stomach can make it worse, and so can greasy food.",
   "est_sec": 5.68,
   "gap_before": 0.68,
   "role": "reply",
   "block": "weather_plans.dlg28"
  },
  {
   "speaker": "user",
   "text": "Anything else?",
   "est_sec": 0.72,
   "gap_before": 2.12,
   "block": "weather_plans.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Look at the horizon if you can, and get some fresh air on deck. Avoid reading or staring at your phone.",
   "est_sec": 6.61,
   "gap_before": 1.14,
   "role": "reply",
   "block": "weather_plans.dlg28"
  }
 ]
}
