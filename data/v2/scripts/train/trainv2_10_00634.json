 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.36,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.47,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "The puppy peed on the rug again. It's the third time this week.",
   "est_sec": 4.13,
   "gap_before": 0.56,
   "block": "cleaning.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Puppies, eh. Blot up as much as you can with kitchen paper, pressing hard. Don't rub.",
   "est_sec": 5.06,
   "gap_before": 0.87,
   "role": "reply",
   "block": "cleaning.dlg27"
  },
  {
   "speaker": "user",
   "text": "Done. Now?",
   "est_sec": 0.72,
   "gap_before": 0.72,
   "block": "cleaning.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Use an enzyme cleaner if you have one. It breaks down the smell completely, otherwise the puppy smells it and goes there again.",
   "est_sec": 7.23,
   "gap_before": 0.42,
   "role": "reply",
   "block": "cleaning.dlg27"
  },
  {
   "speaker": "user",
   "text": "I don't have one. I could",
   "est_sec": 1.96,
   "gap_before": 0.45,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg27"
  },
  {
   "speaker": "user",
   "text": "get one tomorrow?",
   "est_sec": 1.03,
   "gap_before": 2.97,
   "block": "cleaning.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "For tonight, a mix of white vinegar and water helps, then baking soda once it's dry. Get the enzyme cleaner tomorrow for a proper fix.",
   "est_sec": 7.85,
   "gap_before": 0.97,
   "role": "reply",
   "block": "cleaning.dlg27"
  },
  {
   "speaker": "user",
   "text": "It's going to be thirty five degrees tomorrow and I'm supposed to do the canyon trail.",
   "est_sec": 5.06,
   "gap_before": 0.74,
   "block": "hiking.ctx9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's brutal heat with no shade. You could start at dawn and be out by ten, or swap to the shady forest trail. Which would you prefer?",
   "est_sec": 8.47,
   "gap_before": 0.53,
   "role": "reply",
   "block": "hiking.ctx9"
  },
  {
   "speaker": "user",
   "text": "Can you give me fourteen seconds? Then ask me again.",
   "est_sec": 3.2,
   "gap_before": 0.87,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 14,
   "phrasing": "think_instr_05"
  },
  {
   "speaker": "moshi",
   "text": "Okay, I'll hold on.",
   "est_sec": 1.34,
   "gap_before": 0.37,
   "role": "ack",
   "phrasing": "ack_13"
  },
