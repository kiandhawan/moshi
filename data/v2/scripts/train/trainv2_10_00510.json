 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.55,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "I'm decorating biscuits with royal icing for a baby shower and my lines keep running into each other.",
   "est_sec": 5.68,
   "gap_before": 0.36,
   "block": "baking.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sounds like the icing is too thin for outlining. You want two consistencies, a thick one for borders and a runnier one for filling.",
   "est_sec": 7.54,
   "gap_before": 0.41,
   "role": "reply",
   "block": "baking.dlg20"
  },
  {
   "speaker": "user",
   "text": "How thick is thick?",
   "est_sec": 1.34,
   "gap_before": 1.08,
   "block": "baking.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Like toothpaste. It should hold a sharp line. For flooding, add water a few drops at a time until a ribbon of it disappears in about ten seconds.",
   "est_sec": 8.78,
   "gap_before": 0.43,
   "role": "reply",
   "block": "baking.dlg20"
  },
  {
   "speaker": "user",
   "text": "Ten seconds. Okay. And between",
   "est_sec": 1.65,
   "gap_before": 2.57,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg20"
  },
  {
   "speaker": "user",
   "text": "outline and flooding, do I wait?",
   "est_sec": 1.96,
   "gap_before": 2.07,
   "block": "baking.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Give the outline ten minutes or so to firm up. Then flood inside it.",
   "est_sec": 4.44,
   "gap_before": 0.58,
   "role": "reply",
   "block": "baking.dlg20"
  },
  {
   "speaker": "user",
   "text": "This is very soothing actually.",
   "est_sec": 1.65,
   "gap_before": 0.51,
   "block": "baking.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It is, once it clicks. Let them dry overnight before stacking, or the colours smudge.",
   "est_sec": 4.75,
   "gap_before": 0.73,
   "role": "reply",
   "block": "baking.dlg20"
  }
 ]
