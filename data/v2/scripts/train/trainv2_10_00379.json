 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.59,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "My old boots finally fell apart.",
   "est_sec": 1.96,
   "gap_before": 0.39,
   "block": "hiking.ctx2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Time for new ones. Do you want proper leather boots with ankle support, or lighter trail shoes?",
   "est_sec": 5.37,
   "gap_before": 0.63,
   "role": "reply",
   "block": "hiking.ctx2"
  },
  {
   "speaker": "user",
   "text": "Sit tight for eleven seconds and then check in with me.",
   "est_sec": 3.51,
   "gap_before": 1.18,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 11,
   "phrasing": "think_instruction_v2_20"
  },
  {
   "speaker": "moshi",
   "text": "Have you decided? Ankle support or something lighter?",
   "est_sec": 2.58,
   "role": "resume",
   "block": "hiking.ctx2",
   "anchor": {
    "turn": 4,
    "offset": 11.46
   }
  },
  {
   "speaker": "user",
   "text": "Boots. I twisted my ankle last year and I don't want that again.",
   "est_sec": 4.13,
   "gap_before": 2.39,
   "event": "ordinary_request",
   "block": "hiking.ctx2"
  },
  {
   "speaker": "moshi",
   "text": "Makes sense. Break them in on short walks before any big hike.",
   "est_sec": 3.82,
   "gap_before": 0.73,
   "role": "followup",
   "block": "hiking.ctx2"
  },
  {
   "speaker": "user",
   "text": "Okay, something else. My flatmate keeps our coffee beans in the freezer. Is that right? It seems weird.",
   "est_sec": 5.68,
   "gap_before": 1.09,
   "block": "coffee.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's a common debate. For beans you'll use within a couple of weeks, an airtight container in a cool, dark cupboard is best.",
   "est_sec": 7.23,
   "gap_before": 0.78,
   "role": "reply",
   "block": "coffee.dlg11"
  },
  {
   "speaker": "user",
   "text": "So the freezer is wrong?",
   "est_sec": 1.65,
   "gap_before": 0.8,
   "block": "coffee.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not wrong, just not needed for everyday beans. Taking them in and out of the freezer causes condensation, which isn't great for flavour.",
   "est_sec": 7.23,
   "gap_before": 0.58,
   "role": "reply",
   "block": "coffee.dlg11"
  },
  {
   "speaker": "user",
   "text": "When would freezing",
   "est_sec": 1.03,
   "gap_before": 0.84,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg11"
  },
  {
   "speaker": "user",
   "text": "make sense?",
   "est_sec": 0.72,
   "gap_before": 2.24,
   "block": "coffee.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "If you buy a big bag and won't use it for a month or more. Freeze it in small portions and only take out what you need.",
   "est_sec": 8.47,
   "gap_before": 1.05,
   "role": "reply",
   "block": "coffee.dlg11"
  }
