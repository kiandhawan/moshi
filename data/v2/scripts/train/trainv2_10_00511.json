 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.93,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "Gran's old upright piano hasn't been tuned in about twenty years. Is it a lost cause?",
   "est_sec": 5.06,
   "gap_before": 0.36,
   "block": "music.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not necessarily. Many old pianos come back nicely, though it might need a few tunings to settle.",
   "est_sec": 5.37,
   "gap_before": 1.09,
   "role": "reply",
   "block": "music.dlg26"
  },
  {
   "speaker": "user",
   "text": "Why a few?",
   "est_sec": 1.03,
   "gap_before": 1.84,
   "block": "music.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "After so long, the strings have dropped way below pitch. Pulling them up all at once is risky, so tuners often do it in stages.",
   "est_sec": 7.85,
   "gap_before": 0.74,
   "role": "reply",
   "block": "music.dlg26"
  },
  {
   "speaker": "user",
   "text": "Somebody ate my yoghurt. Jason, was it you or your sister?",
   "est_sec": 3.51,
   "gap_before": 0.3,
   "block": "nq_home_040",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_040",
   "name_pos": "middle",
   "addressee": "Jason"
  },
  {
   "speaker": "other",
   "text": "I plead the fifth.",
   "est_sec": 1.34,
   "gap_before": 0.85,
   "block": "nq_home_040"
  },
  {
   "speaker": "user",
   "text": "Is it expensive?",
   "est_sec": 1.03,
   "gap_before": 1.95,
   "block": "music.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A single tuning isn't too bad, but if it needs repairs as well, it adds up. A tuner can tell you on the first visit if it's worth it.",
   "est_sec": 9.09,
   "gap_before": 0.61,
   "role": "reply",
   "block": "music.dlg26"
  },
  {
   "speaker": "user",
   "text": "I'd love to keep it. It",
   "est_sec": 1.96,
   "gap_before": 1.3,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg26"
  },
  {
   "speaker": "user",
   "text": "was the centre of every Christmas.",
   "est_sec": 1.96,
   "gap_before": 2.34,
   "block": "music.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then it's worth a look. Even if it's not perfect, it carries a lot of memories, and that matters too.",
   "est_sec": 6.3,
   "gap_before": 0.38,
   "role": "reply",
   "block": "music.dlg26"
  }
 ]
}
