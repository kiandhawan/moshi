 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.43,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "I completely forgot my friend's birthday. It was three days ago and I feel awful, Moshi.",
   "est_sec": 5.06,
   "gap_before": 0.25,
   "block": "birthday_party.dlg18",
   "kind": "moshi_name",
   "name_pos": "end",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It happens to everyone. Have you said anything to her yet?",
   "est_sec": 3.51,
   "gap_before": 1.83,
   "role": "reply",
   "block": "birthday_party.dlg18"
  },
  {
   "speaker": "user",
   "text": "No. I've been too embarrassed to text.",
   "est_sec": 2.27,
   "gap_before": 1.43,
   "block": "birthday_party.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Text her today. Don't over explain, just say you're sorry you missed it and you'd love to take her out to make up for it.",
   "est_sec": 7.85,
   "gap_before": 1.74,
   "role": "reply",
   "block": "birthday_party.dlg18"
  },
  {
   "speaker": "user",
   "text": "Should I get her something big to make up for it?",
   "est_sec": 3.51,
   "gap_before": 0.73,
   "block": "birthday_party.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not big, thoughtful. Something that shows you know her is better than something expensive.",
   "est_sec": 4.44,
   "gap_before": 1.2,
   "role": "reply",
   "block": "birthday_party.dlg18"
  },
  {
   "speaker": "user",
   "text": "She mentioned a pottery class once.",
   "est_sec": 1.96,
   "gap_before": 2.31,
   "block": "birthday_party.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Perfect. Book one for the two of you. A belated birthday that's actually fun can mean more than a text on the day.",
   "est_sec": 7.23,
   "gap_before": 1.04,
   "role": "reply",
   "block": "birthday_party.dlg18"
  }
 ]
