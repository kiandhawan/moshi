 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.83,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "I want to save but I literally have nothing left at the end of the month.",
   "est_sec": 5.06,
   "gap_before": 0.48,
   "block": "personal_finance.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's really common. Do you know roughly where the money goes?",
   "est_sec": 3.51,
   "gap_before": 1.08,
   "role": "reply",
   "block": "personal_finance.dlg6"
  },
  {
   "speaker": "user",
   "text": "Rent, bills, food. And takeaway. A lot of takeaway.",
   "est_sec": 2.89,
   "gap_before": 1.11,
   "block": "personal_finance.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Takeaway is often the easiest place to find a little. Even cutting it from four nights a week to two adds up fast.",
   "est_sec": 7.23,
   "gap_before": 1.08,
   "role": "reply",
   "block": "personal_finance.dlg6"
  },
  {
   "speaker": "user",
   "text": "But I'm so tired after work.",
   "est_sec": 1.96,
   "gap_before": 1.12,
   "block": "personal_finance.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then make tired dinners easy. Cook a big batch on Sunday, or keep a few frozen meals ready.",
   "est_sec": 5.68,
   "gap_before": 0.49,
   "role": "reply",
   "block": "personal_finance.dlg6"
  },
  {
   "speaker": "user",
   "text": "Okay. And then save the difference?",
   "est_sec": 1.96,
   "gap_before": 1.32,
   "block": "personal_finance.dlg6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Move it to savings on the same day you'd normally order. That way you actually see the progress.",
   "est_sec": 5.99,
   "gap_before": 0.37,
   "role": "reply",
   "block": "personal_finance.dlg6"
  }
 ]
}
