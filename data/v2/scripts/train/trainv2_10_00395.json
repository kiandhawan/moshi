 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.79,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.69,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "I've got this little camera from my son for my birthday. How do I get the pictures onto my phone to send to the grandchildren?",
   "est_sec": 7.85,
   "gap_before": 0.26,
   "block": "photography.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Lovely present. Many cameras have an app that connects by wireless. Do you know the make of the camera?",
   "est_sec": 5.99,
   "gap_before": 1.01,
   "role": "reply",
   "block": "photography.dlg30"
  },
  {
   "speaker": "user",
   "text": "Elijah, how much was that takeaway in the end?",
   "est_sec": 2.89,
   "gap_before": 0.85,
   "block": "nq_social_004",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_004",
   "name_pos": "start",
   "addressee": "Elijah"
  },
  {
   "speaker": "user",
   "text": "It's written on the front, hang on. Yes, it's a Canon.",
   "est_sec": 3.51,
   "gap_before": 3.12,
   "block": "photography.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then there's a free Canon app for your phone. Install it, turn on wireless in the camera menu, and the app walks you through pairing them.",
   "est_sec": 8.16,
   "gap_before": 0.41,
   "role": "reply",
   "block": "photography.dlg30"
  },
  {
   "speaker": "user",
   "text": "And after it's paired?",
   "est_sec": 1.34,
   "gap_before": 1.41,
   "block": "photography.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You'll see the camera's photos in the app. Tap the ones you like and save them, then they'll be in your phone's gallery to send as usual.",
   "est_sec": 8.47,
   "gap_before": 1.51,
   "role": "reply",
   "block": "photography.dlg30"
  },
  {
   "speaker": "user",
   "text": "That sounds manageable.",
   "est_sec": 1.03,
   "gap_before": 1.35,
   "event": "distractor",
   "kind": "pause",
   "block": "photography.dlg30"
  },
  {
   "speaker": "user",
   "text": "My grandson said it was easy, but he says that about everything.",
   "est_sec": 3.82,
   "gap_before": 1.99,
   "block": "photography.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ha, they always do. Give it a try, and if it gets fiddly, a card reader that plugs into the phone is a simple backup.",
   "est_sec": 7.85,
   "gap_before": 0.33,
   "role": "reply",
   "block": "photography.dlg30"
  }
 ]
}
