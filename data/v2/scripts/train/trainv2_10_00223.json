 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.85,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "I spent twelve years in the army and civilian employers don't seem to get what I did.",
   "est_sec": 5.37,
   "gap_before": 0.43,
   "block": "job_interview.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a common challenge. The trick is translating military language into everyday business terms.",
   "est_sec": 4.44,
   "gap_before": 0.39,
   "role": "reply",
   "block": "job_interview.dlg22"
  },
  {
   "speaker": "user",
   "text": "Like what? I was a logistics sergeant.",
   "est_sec": 2.27,
   "gap_before": 0.72,
   "block": "job_interview.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Instead of rank, talk about responsibilities. For example, I managed a team of fifteen and moved equipment worth millions across three countries.",
   "est_sec": 6.92,
   "gap_before": 0.73,
   "role": "reply",
   "block": "job_interview.dlg22"
  },
  {
   "speaker": "user",
   "text": "Wait, what was the last part?",
   "est_sec": 1.96,
   "gap_before": 0.89,
   "block": "job_interview.dlg22",
   "kind": "wait_like",
   "phrasing": "waitlike_05",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sure, here it is again. Instead of rank, talk about responsibilities. For example, I managed a team of fifteen and moved equipment worth millions across three countries.",
   "est_sec": 8.47,
   "gap_before": 0.41,
   "role": "reply",
   "block": "job_interview.dlg22"
  },
  {
   "speaker": "user",
   "text": "That sounds way more impressive.",
   "est_sec": 1.65,
   "gap_before": 0.71,
   "block": "job_interview.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It is impressive. You just need to say it in their language. Leadership, planning, working under pressure, these are all huge.",
   "est_sec": 6.61,
   "gap_before": 1.04,
   "role": "reply",
   "block": "job_interview.dlg22"
  },
  {
   "speaker": "user",
   "text": "What about the jargon",
   "est_sec": 1.34,
   "gap_before": 1.06,
   "event": "distractor",
   "kind": "pause",
   "block": "job_interview.dlg22"
  },
  {
   "speaker": "user",
   "text": "I use without even noticing?",
   "est_sec": 1.65,
   "gap_before": 2.07,
   "block": "job_interview.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ask a civilian friend to listen to your answers and stop you every time they don't understand a word.",
   "est_sec": 5.99,
   "gap_before": 1.07,
   "role": "reply",
   "block": "job_interview.dlg22"
  }
 ]
