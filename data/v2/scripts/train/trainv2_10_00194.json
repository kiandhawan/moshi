 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.32,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "My dog ignores me completely at the park. He comes back when he feels like it.",
   "est_sec": 5.06,
   "gap_before": 0.24,
   "block": "pets.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's frustrating and can be dangerous. Recall is all about making coming back the best thing ever.",
   "est_sec": 5.37,
   "gap_before": 0.9,
   "role": "reply",
   "block": "pets.dlg27"
  },
  {
   "speaker": "user",
   "text": "Are we out of washing powder, Aria?",
   "est_sec": 2.27,
   "gap_before": 1.82,
   "block": "nq_home_073",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_073",
   "name_pos": "end",
   "addressee": "Aria"
  },
  {
   "speaker": "other",
   "text": "There's a few pods left.",
   "est_sec": 1.65,
   "gap_before": 0.41,
   "block": "nq_home_073"
  },
  {
   "speaker": "user",
   "text": "I give him treats.",
   "est_sec": 1.34,
   "gap_before": 1.96,
   "block": "pets.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Use the really good stuff for recall only, like chicken or cheese, not his normal biscuits.",
   "est_sec": 5.06,
   "gap_before": 0.46,
   "role": "reply",
   "block": "pets.dlg27"
  },
  {
   "speaker": "user",
   "text": "Okay. And when he ignores me?",
   "est_sec": 1.96,
   "gap_before": 2.67,
   "block": "pets.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Don't keep repeating his name. Practise in the garden first, then on a long training lead at the park, so he can't practise ignoring you.",
   "est_sec": 7.85,
   "gap_before": 1.03,
   "role": "reply",
   "block": "pets.dlg27"
  },
  {
   "speaker": "user",
   "text": "A long lead? Like a really long one?",
   "est_sec": 2.58,
   "gap_before": 0.86,
   "block": "pets.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Five or ten metres. It gives him freedom while you can still reel him in.",
   "est_sec": 4.75,
   "gap_before": 0.61,
   "role": "reply",
   "block": "pets.dlg27"
  },
  {
   "speaker": "user",
   "text": "That sounds like a tangle waiting to happen.",
   "est_sec": 2.58,
   "gap_before": 1.12,
   "block": "pets.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It can be, so wear gloves and keep it short in busy areas. It's worth it, recall can save his life one day.",
   "est_sec": 7.23,
   "gap_before": 0.42,
   "role": "reply",
   "block": "pets.dlg27"
  }
 ]
}
