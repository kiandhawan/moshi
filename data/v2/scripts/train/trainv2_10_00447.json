 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.76,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.86,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "My husky is shedding so much the house looks like it snowed.",
   "est_sec": 3.82,
   "gap_before": 0.37,
   "block": "pets.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Huskies blow their coat twice a year, it's a lot. Brushing every day during these weeks really helps.",
   "est_sec": 5.68,
   "gap_before": 0.6,
   "role": "reply",
   "block": "pets.dlg30"
  },
  {
   "speaker": "user",
   "text": "Every day? I barely brush my own hair.",
   "est_sec": 2.58,
   "gap_before": 0.67,
   "block": "pets.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ha, I get it. A good undercoat rake gets most of it out in ten minutes or so.",
   "est_sec": 5.68,
   "gap_before": 0.91,
   "role": "reply",
   "block": "pets.dlg30"
  },
  {
   "speaker": "user",
   "text": "Tell me you didn't watch the next episode without me, Marisol.",
   "est_sec": 3.51,
   "gap_before": 2.67,
   "block": "nq_social_061",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_061",
   "name_pos": "end",
   "addressee": "Marisol"
  },
  {
   "speaker": "other",
   "text": "I didn't. Well, half of it.",
   "est_sec": 1.96,
   "gap_before": 0.7,
   "block": "nq_social_061"
  },
  {
   "speaker": "user",
   "text": "Should I shave him for summer?",
   "est_sec": 1.96,
   "gap_before": 1.55,
   "block": "pets.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Please don't. That double coat actually helps keep him cool, and it might not grow back properly.",
   "est_sec": 5.37,
   "gap_before": 1.05,
   "role": "reply",
   "block": "pets.dlg30"
  },
  {
   "speaker": "user",
   "text": "Fine.",
   "est_sec": 0.41,
   "gap_before": 1.43,
   "event": "distractor",
   "kind": "pause",
   "block": "pets.dlg30"
  },
  {
   "speaker": "user",
   "text": "So just suffer?",
   "est_sec": 1.03,
   "gap_before": 2.32,
   "block": "pets.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Brush outside, vacuum often, and put a washable throw on his favourite spot. It passes in a few weeks.",
   "est_sec": 5.99,
   "gap_before": 1.11,
   "role": "reply",
   "block": "pets.dlg30"
  }
 ]
}
