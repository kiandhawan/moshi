 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.39,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "My parents offered to lend me money for a deposit on a flat.",
   "est_sec": 4.13,
   "gap_before": 0.39,
   "block": "personal_finance.ctx9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's generous. A proper loan with a repayment plan, or keep saving alone?",
   "est_sec": 4.13,
   "gap_before": 0.62,
   "role": "reply",
   "block": "personal_finance.ctx9"
  },
  {
   "speaker": "user",
   "text": "Both feel weird.",
   "est_sec": 1.03,
   "gap_before": 1.23,
   "block": "personal_finance.ctx9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Fair. Which is less weird, owing them, or waiting longer?",
   "est_sec": 3.2,
   "gap_before": 0.73,
   "role": "reply",
   "block": "personal_finance.ctx9"
  },
  {
   "speaker": "user",
   "text": "It's either Tuesday or— right, forty-four seconds, Moshi, then ask me again.",
   "est_sec": 3.82,
   "gap_before": 1.35,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 44,
   "phrasing": "think_instruction_v2_40"
  },
  {
   "speaker": "moshi",
   "text": "Okay, sure.",
   "est_sec": 0.72,
   "gap_before": 0.33,
   "role": "ack",
   "phrasing": "ack_16"
  },
  {
   "speaker": "user",
   "text": "Okay, never mind, I figured it out.",
   "est_sec": 2.27,
   "anchor": {
    "turn": 6,
    "offset": 31.79
   },
   "event": "return_cue",
   "kind": "early_end",
   "phrasing": "early_end_07"
  },
  {
   "speaker": "user",
   "text": "I'll take it, but with a written plan so it's clear.",
   "est_sec": 3.51,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "personal_finance.ctx9"
  },
  {
   "speaker": "moshi",
   "text": "Good, writing it down protects the relationship. Include what happens if you miss a month.",
   "est_sec": 4.75,
   "gap_before": 0.57,
   "role": "followup",
   "block": "personal_finance.ctx9"
  },
  {
   "speaker": "user",
   "text": "Different question. Is there a smart way to label boxes?",
   "est_sec": 3.2,
   "gap_before": 0.85,
   "block": "moving_house.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Colour coding works well. Pick one colour for each room, then put a sticker or tape on every box and on the door of that room.",
   "est_sec": 8.16,
