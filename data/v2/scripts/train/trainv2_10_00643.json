 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.94,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "Can I take a cello on the train? It's in a hard case.",
   "est_sec": 4.13,
   "gap_before": 0.55,
   "block": "public_transport.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Usually yes. Most trains allow musical instruments as long as they fit in the luggage space or you can hold them without blocking the aisle.",
   "est_sec": 7.85,
   "gap_before": 0.57,
   "role": "reply",
   "block": "public_transport.dlg8"
  },
  {
   "speaker": "user",
   "text": "Oh, also, I want to start budgeting with my husband but we can't agree on how.",
   "est_sec": 5.06,
   "gap_before": 0.63,
   "block": "personal_finance.opt4"
  },
  {
   "speaker": "user",
   "text": "Options first, Moshi, then your take.",
   "est_sec": 1.96,
   "gap_before": 0.43,
   "event": "instruction",
   "kind": "describe_options",
   "phrasing": "describe_instruction_v2_20"
  },
  {
   "speaker": "moshi",
   "text": "Okay, sure.",
   "est_sec": 0.72,
   "gap_before": 0.23,
   "role": "ack",
   "phrasing": "ack_16"
  },
  {
   "speaker": "user",
   "text": "We could put both salaries into one joint account and pay everything from there.",
   "est_sec": 4.44,
   "gap_before": 1.19,
   "block": "personal_finance.opt4",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "Or keep our own accounts and each pay half of the shared bills.",
   "est_sec": 4.13,
   "gap_before": 7.41,
   "block": "personal_finance.opt4",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "Another idea is to pay bills in proportion to what we earn, since he earns quite a bit more.",
   "est_sec": 5.99,
   "gap_before": 3.55,
   "block": "personal_finance.opt4",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "Or a joint account just for bills, and the rest stays separate as our own fun money.",
   "est_sec": 5.37,
   "gap_before": 7.61,
   "block": "personal_finance.opt4"
  },
  {
   "speaker": "user",
   "text": "Sorry, that's all, I promise. Go ahead and weigh in.",
   "est_sec": 3.2,
   "gap_before": 0.57,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "describe_cue_v2_14"
  },
  {
   "speaker": "moshi",
   "text": "Half and half can feel unfair if one of you earns much more. The joint bills account combined with paying in proportion to income is a nice middle ground.",
   "est_sec": 9.09,
   "gap_before": 0.41,
   "role": "resume",
   "block": "personal_finance.opt4"
  }
 ]
}
