 "est_speech_sec": 40.78,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.53,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.48,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "My strawberry plants are sending out long stringy runners everywhere.",
   "est_sec": 3.2,
   "gap_before": 0.57,
   "block": "gardening.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Those runners are baby plants on a leash. You can either snip them off or use them to make new plants for free.",
   "est_sec": 7.23,
   "gap_before": 0.74,
   "role": "reply",
   "block": "gardening.dlg19"
  },
  {
   "speaker": "user",
   "text": "Free plants, go on.",
   "est_sec": 1.34,
   "gap_before": 1.47,
   "block": "gardening.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Pin the little plantlet onto a pot of compost with a bent wire or a stone. Once it's rooted in a few weeks, cut the runner.",
   "est_sec": 8.16,
   "gap_before": 0.72,
   "role": "reply",
   "block": "gardening.dlg19"
  },
  {
   "speaker": "user",
   "text": "Is there a catch?",
   "est_sec": 1.34,
   "gap_before": 1.33,
   "block": "gardening.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "If you leave too many on, the mother plant puts energy into them instead of fruit. Keep two or three per plant, cut the rest.",
   "est_sec": 7.85,
   "gap_before": 0.65,
   "role": "reply",
   "block": "gardening.dlg19"
  },
  {
   "speaker": "user",
   "text": "And how long do",
   "est_sec": 1.34,
   "gap_before": 1.38,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg19"
  },
  {
   "speaker": "user",
   "text": "the old plants last?",
   "est_sec": 1.34,
   "gap_before": 2.04,
   "block": "gardening.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "About three or four years before they tire out. That's why rooting runners every summer keeps the bed going.",
   "est_sec": 5.99,
   "gap_before": 1.94,
   "role": "reply",
   "block": "gardening.dlg19"
  }
 ]
}
