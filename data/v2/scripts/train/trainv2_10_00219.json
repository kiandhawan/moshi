 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.31,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.63,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "My grandma's coming over to teach me her dumplings and I want to impress her by prepping the filling. Pork and cabbage.",
   "est_sec": 6.92,
   "gap_before": 0.26,
   "block": "cooking.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a classic. Finely chop the cabbage, salt it and squeeze out the water before mixing it with the pork.",
   "est_sec": 6.3,
   "gap_before": 0.9,
   "role": "reply",
   "block": "cooking.dlg22"
  },
  {
   "speaker": "user",
   "text": "Why squeeze it?",
   "est_sec": 1.03,
   "gap_before": 1.05,
   "block": "cooking.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Otherwise the filling gets watery and the dumplings tear when you fold them.",
   "est_sec": 4.13,
   "gap_before": 1.05,
   "role": "reply",
   "block": "cooking.dlg22"
  },
  {
   "speaker": "user",
   "text": "What else goes in?",
   "est_sec": 1.34,
   "gap_before": 0.69,
   "block": "cooking.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ginger, spring onion, soy sauce, a little sesame oil and white pepper. Stir it in one direction until it turns sticky.",
   "est_sec": 6.61,
   "gap_before": 0.62,
   "role": "reply",
   "block": "cooking.dlg22"
  },
  {
   "speaker": "user",
   "text": "One direction? That sounds like",
   "est_sec": 1.65,
   "gap_before": 0.31,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg22"
  },
  {
   "speaker": "user",
   "text": "something she would say.",
   "est_sec": 1.34,
   "gap_before": 2.66,
   "block": "cooking.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's real advice. It helps the filling bind, so it stays juicy.",
   "est_sec": 3.82,
   "gap_before": 0.7,
   "role": "reply",
   "block": "cooking.dlg22"
  },
  {
   "speaker": "user",
   "text": "Okay, I'm doing that and hoping she doesn't redo it all.",
   "est_sec": 3.51,
   "gap_before": 0.44,
   "block": "cooking.dlg22",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Even if she adjusts it, she'll love that you tried.",
   "est_sec": 3.2,
   "gap_before": 0.84,
   "role": "reply",
   "block": "cooking.dlg22"
  }
 ]
