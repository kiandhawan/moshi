 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.34,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "I've got a ten hour layover in Istanbul and I'm not sure what to do with it.",
   "est_sec": 5.37,
   "gap_before": 0.41,
   "block": "travel_planning.opt4"
  },
  {
   "speaker": "user",
   "text": "Ooh, okay, listen to all of these first and then tell me your favorite.",
   "est_sec": 4.44,
   "gap_before": 0.88,
   "event": "instruction",
   "kind": "describe_options",
   "phrasing": "describe_instruction_v2_17"
  },
  {
   "speaker": "user",
   "text": "I could stay in the airport lounge, shower, nap and eat, nice and stress free.",
   "est_sec": 4.75,
   "gap_before": 0.79,
   "block": "travel_planning.opt4",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "Or take the metro into the old city, see a mosque or two and get back in time, hopefully.",
   "est_sec": 5.99,
   "gap_before": 6.2,
   "block": "travel_planning.opt4",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "There's also a short guided tour the airline offers for transit passengers, about six hours with a guide.",
   "est_sec": 5.68,
   "gap_before": 5.07,
   "block": "travel_planning.opt4"
  },
  {
   "speaker": "user",
   "text": "All set, those are the choices. Help me pick.",
   "est_sec": 2.89,
   "gap_before": 0.82,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "describe_cue_v2_26"
  },
  {
   "speaker": "moshi",
   "text": "If you've never seen the city, the guided tour gives you a taste without the risk of missing your flight. Doing it alone gives more freedom but you'd have to watch the clock. The lounge is a sensible fallback if you're tired.",
   "est_sec": 13.12,
   "gap_before": 0.94,
   "role": "resume",
   "block": "travel_planning.opt4"
  },
  {
   "speaker": "user",
   "text": "Is your camera on, Jacob?",
   "est_sec": 1.65,
