 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.53,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.83,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "Who keeps leaving the printer on overnight, Bao?",
   "est_sec": 2.58,
   "gap_before": 0.33,
   "block": "nq_work_045",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_work_045",
   "name_pos": "end",
   "addressee": "Bao"
  },
  {
   "speaker": "other",
   "text": "Not me, I swear.",
   "est_sec": 1.34,
   "gap_before": 0.43,
   "block": "nq_work_045"
  },
  {
   "speaker": "user",
   "text": "Right, next thing. My rest days are a mess. I've got some ideas for what to do on them.",
   "est_sec": 5.99,
   "gap_before": 1.55,
   "block": "fitness.opt6"
  },
  {
   "speaker": "user",
   "text": "Let me lay out all the options first. Don't interrupt.",
   "est_sec": 3.2,
   "gap_before": 0.48,
   "event": "instruction",
   "kind": "describe_options",
   "phrasing": "describe_instr_14"
  },
  {
   "speaker": "user",
   "text": "Total rest, sofa, films, nothing at all, which feels great but makes me stiff the next day.",
   "est_sec": 5.37,
   "gap_before": 1.05,
   "block": "fitness.opt6",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "A long easy walk with the dog, maybe an hour, just to keep moving.",
   "est_sec": 4.44,
   "gap_before": 2.72,
   "block": "fitness.opt6",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "A stretching and foam rolling session, about thirty minutes, which I always say I'll do and never do.",
   "est_sec": 5.68,
   "gap_before": 2.62,
   "block": "fitness.opt6",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "Or a gentle swim, which loosens everything up but means going to the pool and back.",
   "est_sec": 5.06,
   "gap_before": 2.46,
   "block": "fitness.opt6"
  },
  {
   "speaker": "user",
   "text": "That's the last option, I'm finished. Go ahead.",
   "est_sec": 2.58,
   "gap_before": 1.25,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "describe_cue_v2_22"
  },
  {
   "speaker": "moshi",
   "text": "Active recovery usually beats doing nothing, so the walk or the swim are good bets. Stretching is useful but only if you'll actually do it, so keep it short. Total rest is fine now and then, just not every time.",
   "est_sec": 12.5,
   "gap_before": 0.54,
   "role": "resume",
   "block": "fitness.opt6"
  },
  {
   "speaker": "user",
   "text": "Hey Moshi, I'm worried he'll spend it all on snacks and games.",
   "est_sec": 3.82,
   "gap_before": 1.56,
   "kind": "moshi_name",
   "name_pos": "start",
   "addressee": "Moshi",
   "event": "ordinary_request",
   "block": "personal_finance.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "He probably will at first, and that's part of learning. You can set spending limits and get alerts for each purchase.",
   "est_sec": 6.61,
   "gap_before": 0.48,
   "role": "reply",
   "block": "personal_finance.dlg2"
  }
 ]
