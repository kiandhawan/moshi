 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.62,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.79,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "Winter is coming and my commute always falls apart when it snows.",
   "est_sec": 3.82,
   "gap_before": 0.58,
   "block": "public_transport.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's a common story. Checking live updates before you leave is the easiest habit to start.",
   "est_sec": 5.06,
   "gap_before": 0.77,
   "role": "reply",
   "block": "public_transport.dlg19"
  },
  {
   "speaker": "user",
   "text": "I usually just go to the stop and hope.",
   "est_sec": 2.89,
   "gap_before": 1.92,
   "block": "public_transport.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Try setting up alerts in your transit app for your route. You'll know about cancellations before you're standing in the cold.",
   "est_sec": 6.61,
   "gap_before": 0.35,
   "role": "reply",
   "block": "public_transport.dlg19"
  },
  {
   "speaker": "user",
   "text": "And when it's",
   "est_sec": 1.03,
   "gap_before": 1.09,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg19"
  },
  {
   "speaker": "user",
   "text": "properly snowing, what then?",
   "est_sec": 1.34,
   "gap_before": 2.05,
   "block": "public_transport.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Have a backup plan ready, maybe a different line or working from home. Decide it the night before so the morning isn't chaos.",
   "est_sec": 7.23,
   "gap_before": 0.79,
   "role": "reply",
   "block": "public_transport.dlg19"
  },
  {
   "speaker": "user",
   "text": "Good point. Anything for the actual waiting?",
   "est_sec": 2.27,
   "gap_before": 1.22,
   "block": "public_transport.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Layers, warm socks, and gloves you can use your phone in. A flask of tea doesn't hurt either.",
   "est_sec": 5.68,
   "gap_before": 0.93,
   "role": "reply",
   "block": "public_transport.dlg19"
  }
 ]
}
