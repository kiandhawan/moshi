 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.91,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "My boyfriend lives in another country and he's visiting this weekend. I want it to be perfect.",
   "est_sec": 5.37,
   "gap_before": 0.27,
   "block": "weekend_plans.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's exciting. Don't overplan, though. Leave time just to be together.",
   "est_sec": 3.51,
   "gap_before": 0.39,
   "role": "reply",
   "block": "weekend_plans.dlg32"
  },
  {
   "speaker": "user",
   "text": "I want to show him my favourite spots.",
   "est_sec": 2.58,
   "gap_before": 0.74,
   "block": "weekend_plans.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Pick two or three, not ten. Your favourite cafe, a walk you love, a place with a view.",
   "est_sec": 5.68,
   "gap_before": 0.95,
   "role": "reply",
   "block": "weekend_plans.dlg32"
  },
  {
   "speaker": "user",
   "text": "And the evenings?",
   "est_sec": 1.03,
   "gap_before": 0.49,
   "block": "weekend_plans.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Maybe one special dinner out and one cosy night in. That balance usually feels best.",
   "est_sec": 4.75,
   "gap_before": 0.43,
   "role": "reply",
   "block": "weekend_plans.dlg32"
  },
  {
   "speaker": "user",
   "text": "I'm already",
   "est_sec": 0.72,
   "gap_before": 1.38,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg32"
  },
  {
   "speaker": "user",
   "text": "dreading saying goodbye on Sunday.",
   "est_sec": 1.65,
   "gap_before": 1.98,
   "block": "weekend_plans.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's natural. Plan something small for Sunday evening, like a call with a friend, so it's not too empty when he's gone.",
   "est_sec": 6.92,
   "gap_before": 0.84,
   "role": "reply",
   "block": "weekend_plans.dlg32"
  }
 ]
