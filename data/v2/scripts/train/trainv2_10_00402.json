 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.76,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.45,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "I can swim, but I can't breathe properly doing front crawl. I end up gasping after one length.",
   "est_sec": 5.68,
   "gap_before": 0.5,
   "block": "fitness.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's usually because people hold their breath underwater. Breathe out slowly through your nose or mouth while your face is in the water.",
   "est_sec": 7.23,
   "gap_before": 0.96,
   "role": "reply",
   "block": "fitness.dlg25"
  },
  {
   "speaker": "user",
   "text": "Can I ask about something else? Me and my dad want to build a shelf for my records.",
   "est_sec": 5.68,
   "gap_before": 0.73,
   "block": "home_repair.ctx8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Fun project together. Are you picturing floating shelves on the wall, or a standing unit you build on the floor?",
   "est_sec": 6.3,
   "gap_before": 0.88,
   "role": "reply",
   "block": "home_repair.ctx8"
  },
  {
   "speaker": "friend",
   "text": "I have the best news, you're going to love this.",
   "est_sec": 3.2,
   "gap_before": 0.67,
   "event": "distractor",
   "kind": "friend_interrupt",
   "phrasing": "friend_interrupt_v2_10"
  },
  {
   "speaker": "user",
   "text": "Excuse me a moment, Moshi, I'll tell you when I'm back.",
   "est_sec": 3.51,
   "gap_before": 0.49,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instruction_v2_53"
  },
  {
   "speaker": "user",
   "text": "When's the library book due back?",
   "est_sec": 1.96,
   "gap_before": 1.03,
   "event": "distractor",
   "kind": "near_miss",
   "phrasing": "dn_35"
  },
  {
   "speaker": "friend",
   "text": "I think next Wednesday.",
   "est_sec": 1.34,
   "gap_before": 1.46,
   "phrasing": "dn_35"
  },
  {
   "speaker": "user",
   "text": "Ryan, can you stand over by the window? The light is perfect right now.",
   "est_sec": 4.44,
   "gap_before": 1.01,
   "block": "photography.side1"
  },
  {
   "speaker": "friend",
   "text": "Like this? I never know what to do with my hands.",
   "est_sec": 3.51,
   "gap_before": 0.35,
   "block": "photography.side1"
  },
  {
   "speaker": "user",
   "text": "Just put them in your pockets. Now look at me and relax.",
   "est_sec": 3.82,
   "gap_before": 1.12,
   "block": "photography.side1"
  },
  {
   "speaker": "friend",
   "text": "I'm trying not to laugh.",
   "est_sec": 1.65,
   "gap_before": 0.49,
   "block": "photography.side1"
  },
  {
   "speaker": "user",
   "text": "Laughing is good, actually. Do you want to see how it looks?",
