   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "Is ten thousand steps a day actually a thing, or just a number someone made up?",
   "est_sec": 5.06,
   "gap_before": 0.37,
   "block": "fitness.dlg10",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's a bit of both. It started partly as a marketing number, but research does show more steps help your health.",
   "est_sec": 6.61,
   "gap_before": 0.75,
   "role": "reply",
   "block": "fitness.dlg10"
  },
  {
   "speaker": "user",
   "text": "Last time Moshi helped me, the cake actually rose.",
