 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.31,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.35,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "I have about sixty thousand air miles. Is it smarter to use them for flights or upgrades?",
   "est_sec": 5.37,
   "gap_before": 0.44,
   "block": "travel_planning.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Usually, long haul business class upgrades or reward seats give the most value per mile.",
   "est_sec": 4.75,
   "gap_before": 1.03,
   "role": "reply",
   "block": "travel_planning.dlg23"
  },
  {
   "speaker": "user",
   "text": "What about short flights?",
   "est_sec": 1.34,
   "gap_before": 0.82,
   "block": "travel_planning.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Short flights often give poor value, since cash fares are cheap and taxes on rewards can be high.",
   "est_sec": 5.68,
   "gap_before": 0.98,
   "role": "reply",
   "block": "travel_planning.dlg23"
  },
  {
   "speaker": "user",
   "text": "My partner wants to use them for a hotel.",
   "est_sec": 2.89,
   "gap_before": 1.2,
   "block": "travel_planning.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Hotels are usually one of the worst uses of airline miles. I'd save them for a flight.",
   "est_sec": 5.37,
   "gap_before": 1.14,
   "role": "reply",
   "block": "travel_planning.dlg23"
  },
  {
   "speaker": "user",
   "text": "Wait, what was the last part?",
   "est_sec": 1.96,
   "gap_before": 1.29,
   "block": "travel_planning.dlg23",
   "kind": "wait_like",
   "phrasing": "waitlike_05",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sure, here it is again. Hotels are usually one of the worst uses of airline miles. I'd save them for a flight.",
   "est_sec": 6.92,
   "gap_before": 1.98,
   "role": "reply",
   "block": "travel_planning.dlg23"
  },
  {
   "speaker": "user",
   "text": "We were looking at New York in spring. Could I",
   "est_sec": 3.2,
   "gap_before": 0.99,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg23"
  },
  {
   "speaker": "user",
   "text": "get two economy tickets with that?",
   "est_sec": 1.96,
   "gap_before": 2.09,
   "block": "travel_planning.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Quite possibly, depending on where you're flying from and the airline. Check the reward chart and book early, reward seats sell out.",
   "est_sec": 6.92,
   "gap_before": 0.65,
   "role": "reply",
   "block": "travel_planning.dlg23"
  }
 ]
