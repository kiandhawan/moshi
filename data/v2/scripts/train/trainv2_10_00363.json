  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.43,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.52,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "I don't have buttermilk and the recipe needs it. Any way around that?",
   "est_sec": 4.13,
   "gap_before": 0.35,
   "block": "baking.dlg3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Easy fix. Stir a tablespoon of lemon juice or vinegar into a cup of regular milk and let it sit five minutes.",
   "est_sec": 6.92,
   "gap_before": 0.93,
   "role": "reply",
   "block": "baking.dlg3"
  },
  {
   "speaker": "user",
   "text": "It'll curdle, right? Is that okay?",
   "est_sec": 1.96,
   "gap_before": 0.57,
   "block": "baking.dlg3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's exactly what you want. It thickens and gets tangy like buttermilk.",
   "est_sec": 3.82,
   "gap_before": 0.68,
   "role": "reply",
   "block": "baking.dlg3"
  },
  {
   "speaker": "user",
