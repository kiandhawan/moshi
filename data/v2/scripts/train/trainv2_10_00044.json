 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.75,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "I'm getting a leopard gecko. What temperature does the tank need to be?",
   "est_sec": 4.13,
   "gap_before": 0.42,
   "block": "pets.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "They need a warm side and a cool side, so they can move between them. The warm spot should be around thirty degrees.",
   "est_sec": 7.23,
   "gap_before": 0.38,
   "role": "reply",
   "block": "pets.dlg26"
  },
  {
   "speaker": "user",
   "text": "The Wi-Fi's buffering again. Tunde, are you downloading a game?",
   "est_sec": 3.2,
   "gap_before": 0.84,
   "block": "nq_social_042",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_042",
   "name_pos": "middle",
   "addressee": "Tunde"
  },
  {
   "speaker": "other",
   "text": "Just a small update. Forty gigs.",
   "est_sec": 1.96,
   "gap_before": 0.47,
   "block": "nq_social_042"
  },
  {
   "speaker": "user",
   "text": "Celsius?",
   "est_sec": 0.41,
   "gap_before": 1.38,
   "block": "pets.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, Celsius. The cool end can be a lot lower, more like room temperature.",
   "est_sec": 4.44,
   "gap_before": 0.85,
   "role": "reply",
   "block": "pets.dlg26"
  },
  {
   "speaker": "user",
   "text": "How do I heat it?",
   "est_sec": 1.65,
   "gap_before": 0.45,
   "block": "pets.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most people use a heat mat under one end controlled by a thermostat, or an overhead heat lamp. The thermostat is the important bit, so it doesn't overheat.",
   "est_sec": 8.78,
   "gap_before": 1.15,
   "role": "reply",
   "block": "pets.dlg26"
  },
  {
   "speaker": "user",
   "text": "And a light at night?",
   "est_sec": 1.65,
   "gap_before": 0.74,
   "block": "pets.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "No, they need darkness at night to keep a healthy rhythm. Just keep the room from getting too cold.",
   "est_sec": 5.99,
   "gap_before": 1.0,
