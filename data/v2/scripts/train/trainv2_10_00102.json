 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.35,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.86,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "I'm flying to Sydney from London next month. How do I not die of jet lag?",
   "est_sec": 5.06,
   "gap_before": 0.5,
   "block": "travel_planning.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Start shifting your sleep a little in the few days before you leave, going to bed an hour earlier each night.",
   "est_sec": 6.61,
   "gap_before": 0.31,
   "role": "reply",
   "block": "travel_planning.dlg5"
  },
  {
   "speaker": "user",
   "text": "Earlier? I'm a total night owl.",
   "est_sec": 1.96,
   "gap_before": 0.83,
   "block": "travel_planning.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "I know, but Sydney is way ahead of London, so even small shifts help. On the plane, set your watch to Sydney time and sleep when it's night there.",
   "est_sec": 9.09,
   "gap_before": 0.5,
   "role": "reply",
   "block": "travel_planning.dlg5"
  },
  {
   "speaker": "user",
   "text": "Oh, and another thing. I keep getting a bit lost on hikes. Nothing dramatic, just wrong turns.",
   "est_sec": 5.37,
   "gap_before": 0.97,
   "block": "hiking.ctx12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Happens to everyone.",
   "est_sec": 1.03,
   "gap_before": 1.06,
   "role": "reply",
   "block": "hiking.ctx12"
  },
  {
   "speaker": "user",
   "text": "Should I just buy a GPS watch?",
   "est_sec": 2.27,
   "gap_before": 3.23,
   "block": "hiking.ctx12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You could, or take a one day map and compass course so you never depend on batteries. Gadget or skill, which suits you?",
   "est_sec": 7.23,
   "gap_before": 0.5,
   "role": "reply",
   "block": "hiking.ctx12"
  },
  {
   "speaker": "user",
   "text": "Can you, uh, let me sit with that for fourteen seconds?",
   "est_sec": 3.51,
   "gap_before": 3.35,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 14,
   "phrasing": "think_instruction_v2_07"
  },
  {
   "speaker": "user",
   "text": "Hmm, decisions, decisions.",
   "est_sec": 1.03,
