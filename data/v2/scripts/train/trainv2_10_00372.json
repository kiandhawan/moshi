 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.98,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "We're moving from Edinburgh to Bristol with a one bedroom flat's worth of stuff.",
   "est_sec": 4.44,
   "gap_before": 0.21,
   "block": "moving_house.ctx7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Big trip. You could rent a van and drive it yourselves over two days, or pay a removal company and take the train down. Is it more about money or about sanity?",
   "est_sec": 10.02,
   "gap_before": 0.68,
   "role": "reply",
   "block": "moving_house.ctx7"
  },
  {
   "speaker": "user",
   "text": "Honestly, I need a good twenty-five seconds before I can answer. Then ask me again.",
   "est_sec": 4.75,
   "gap_before": 2.12,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 25,
   "phrasing": "think_instruction_v2_10"
  },
  {
   "speaker": "user",
   "text": "Hmm, either way, really.",
   "est_sec": 1.34,
   "anchor": {
    "turn": 4,
    "offset": 21.82
   },
   "event": "distractor",
   "kind": "self_talk",
   "phrasing": "self_07"
  },
  {
   "speaker": "moshi",
   "text": "So, the two day van road trip, or removals and a train?",
   "est_sec": 3.82,
   "role": "resume",
   "block": "moving_house.ctx7",
   "anchor": {
    "turn": 4,
    "offset": 25.54
   }
  },
  {
   "speaker": "user",
   "text": "Oh, and another thing. This Saturday, my son has a birthday party at two, and I promised my mum I'd visit her for lunch.",
   "est_sec": 7.54,
   "gap_before": 0.82,
   "block": "weekend_plans.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Busy. How far is your mum from the party?",
   "est_sec": 2.89,
   "gap_before": 0.89,
   "role": "reply",
   "block": "weekend_plans.dlg18"
  },
  {
   "speaker": "user",
   "text": "About half an hour.",
   "est_sec": 1.34,
   "gap_before": 1.09,
   "block": "weekend_plans.dlg18",
   "event": "ordinary_request"
  },
  {
