 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.83,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "Quick question. My bundt cake always sticks in the tin and comes out in pieces.",
   "est_sec": 4.75,
   "gap_before": 0.25,
   "block": "baking.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Bundt tins are tricky with all those ridges. Are you greasing it with butter or spray?",
   "est_sec": 5.06,
   "gap_before": 1.17,
   "role": "reply",
   "block": "baking.dlg9"
  },
  {
   "speaker": "user",
   "text": "Spray, mostly.",
   "est_sec": 0.72,
   "gap_before": 0.89,
   "block": "baking.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Try brushing melted butter into every groove with a pastry brush, then dust it with flour and tap out the extra.",
   "est_sec": 6.61,
   "gap_before": 1.51,
   "role": "reply",
   "block": "baking.dlg9"
  },
  {
   "speaker": "user",
   "text": "And when should I",
   "est_sec": 1.34,
   "gap_before": 0.99,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg9"
  },
  {
   "speaker": "user",
   "text": "turn it out? Straight away?",
   "est_sec": 1.65,
   "gap_before": 2.09,
   "block": "baking.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "About ten minutes after it comes out. Too soon and it's fragile, too late and the sugars start gluing it to the tin.",
   "est_sec": 7.23,
   "gap_before": 0.93,
   "role": "reply",
   "block": "baking.dlg9"
  },
  {
   "speaker": "user",
   "text": "Ten minutes. Got it.",
   "est_sec": 1.34,
   "gap_before": 1.35,
   "block": "baking.dlg9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Set a timer, it's easy to forget. Then flip it onto a rack with confidence, no hesitating.",
   "est_sec": 5.37,
   "gap_before": 0.92,
   "role": "reply",
   "block": "baking.dlg9"
  }
