 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.36,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.7,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "Can I mix bleach and vinegar to make a super strong cleaner? My mould won't budge.",
   "est_sec": 5.06,
   "gap_before": 0.22,
   "block": "cleaning.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Please don't. Bleach mixed with vinegar, or with ammonia, gives off toxic gas. It's genuinely dangerous.",
   "est_sec": 5.06,
   "gap_before": 0.38,
   "role": "reply",
   "block": "cleaning.dlg15"
  },
  {
   "speaker": "user",
   "text": "There's a big storm on my commute day tomorrow and I'm stuck on how to get to work.",
   "est_sec": 5.68,
   "gap_before": 0.99,
   "block": "weather_plans.opt5"
  },
  {
   "speaker": "user",
   "text": "Okay, I've got a long list here and I'll want your verdict once I've read the last one.",
   "est_sec": 5.68,
   "gap_before": 0.61,
   "event": "instruction",
   "kind": "describe_options",
   "phrasing": "describe_instruction_v2_32"
  },
  {
   "speaker": "moshi",
   "text": "Sure, take your time.",
   "est_sec": 1.34,
   "gap_before": 0.28,
   "role": "ack",
   "phrasing": "ack_03"
  },
  {
   "speaker": "user",
   "text": "My usual bus takes forty minutes, but in bad weather it's packed and always late.",
   "est_sec": 4.75,
   "gap_before": 1.27,
   "block": "weather_plans.opt5",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "I could drive, which would be warm and dry, but parking near the office costs a fortune.",
   "est_sec": 5.37,
   "gap_before": 4.82,
   "block": "weather_plans.opt5",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "Or I could ask my boss if I can work from home, which she allows, though she doesn't love it.",
   "est_sec": 6.3,
   "gap_before": 6.61,
   "block": "weather_plans.opt5"
  },
  {
   "speaker": "user",
   "text": "Alright, I'm finished. What's your opinion?",
   "est_sec": 1.96,
   "gap_before": 1.4,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "describe_cue_14"
  },
  {
   "speaker": "moshi",
   "text": "If you've got meetings in person, drive and accept the parking fee as a one off. Otherwise just ask your boss to work from home tomorrow, most managers understand on a stormy day.",
   "est_sec": 10.33,
   "gap_before": 0.67,
