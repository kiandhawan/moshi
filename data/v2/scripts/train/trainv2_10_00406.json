   "gap_before": 0.75,
   "block": "movies.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Use very fine salt, even blitzed in a blender. It clings much better than chunky flakes.",
   "est_sec": 5.06,
   "gap_before": 1.15,
   "role": "reply",
   "block": "movies.dlg12"
  },
  {
