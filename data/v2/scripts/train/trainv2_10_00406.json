   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "How do I make proper cinema popcorn at home? Mine always tastes like cardboard.",
   "est_sec": 4.44,
   "gap_before": 0.42,
   "block": "movies.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "The secret is fat and salt. Pop the kernels in a heavy pot with a good coating of oil, rather than in the microwave.",
   "est_sec": 7.54,
   "gap_before": 1.06,
   "role": "reply",
   "block": "movies.dlg12"
  },
  {
   "speaker": "user",
   "text": "What oil?",
   "est_sec": 0.72,
   "gap_before": 0.44,
   "block": "movies.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Coconut oil gives that cinema taste. A neutral oil works too, but coconut is the classic.",
   "est_sec": 5.06,
   "gap_before": 0.69,
   "role": "reply",
   "block": "movies.dlg12"
  },
  {
   "speaker": "user",
   "text": "And the salt never sticks to mine.",
