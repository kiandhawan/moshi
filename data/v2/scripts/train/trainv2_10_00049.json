 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.7,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.94,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "I'm selling my car privately for the first time. What do I need to watch out for?",
   "est_sec": 5.37,
   "gap_before": 0.55,
   "block": "cars.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Mainly paperwork and safety. Have the logbook, service history and any receipts ready, buyers love a tidy folder.",
   "est_sec": 5.68,
   "gap_before": 1.03,
   "role": "reply",
   "block": "cars.dlg14"
  },
  {
   "speaker": "user",
   "text": "What about test drives? Some stranger driving off in my car scares me.",
   "est_sec": 4.13,
   "gap_before": 1.45,
   "block": "cars.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Fair worry. Ask to see their licence and check they're insured, and always go along with them. Keep your keys in your pocket when you swap seats.",
   "est_sec": 8.47,
   "gap_before": 0.69,
   "role": "reply",
   "block": "cars.dlg14"
  },
  {
   "speaker": "user",
   "text": "Ooh, good point. And payment?",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "block": "cars.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A bank transfer that has fully cleared is safest. Don't hand over the keys until the money is actually in your account, not just showing as pending.",
   "est_sec": 8.47,
   "gap_before": 1.16,
   "role": "reply",
   "block": "cars.dlg14"
  },
  {
   "speaker": "user",
   "text": "Someone offered to",
   "est_sec": 1.03,
   "gap_before": 1.12,
   "event": "distractor",
   "kind": "pause",
   "block": "cars.dlg14"
  },
  {
   "speaker": "user",
   "text": "pay half now and half later.",
   "est_sec": 1.96,
   "gap_before": 2.79,
   "block": "cars.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "I'd politely say no. Full payment before the car leaves, that's the standard for private sales.",
   "est_sec": 5.06,
   "gap_before": 0.53,
   "role": "reply",
   "block": "cars.dlg14"
  }
 ]
}
