 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.32,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.9,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "Vienna to Venice. Night train or a quick flight?",
   "est_sec": 2.89,
   "gap_before": 0.55,
   "block": "travel_planning.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "The night train saves you a hotel night and drops you in the city center. The flight is faster but you'd still need to get from the airport.",
   "est_sec": 8.78,
   "gap_before": 0.98,
   "role": "reply",
   "block": "travel_planning.dlg30"
  },
  {
   "speaker": "user",
   "text": "Do night trains have proper beds?",
   "est_sec": 1.96,
   "gap_before": 1.01,
   "block": "travel_planning.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, you can book a sleeper cabin with beds, or a cheaper couchette that you share.",
   "est_sec": 5.06,
   "gap_before": 1.83,
   "role": "reply",
   "block": "travel_planning.dlg30"
  },
  {
   "speaker": "user",
   "text": "Shared with strangers? Hmm.",
   "est_sec": 1.34,
   "gap_before": 1.31,
   "block": "travel_planning.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Couchettes can be fine, but if you want privacy, a private sleeper is worth it. Book early, they're popular.",
   "est_sec": 5.99,
   "gap_before": 0.87,
   "role": "reply",
   "block": "travel_planning.dlg30"
  },
  {
   "speaker": "user",
   "text": "Okay, private. And I arrive",
   "est_sec": 1.65,
   "gap_before": 1.42,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg30"
  },
  {
   "speaker": "user",
   "text": "around breakfast time, right?",
   "est_sec": 1.34,
   "gap_before": 1.54,
   "block": "travel_planning.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Usually in the morning, yes. Arriving in Venice by train and walking straight out onto the Grand Canal is a lovely way to start.",
   "est_sec": 7.54,
   "gap_before": 0.4,
   "role": "reply",
   "block": "travel_planning.dlg30"
  }
 ]
