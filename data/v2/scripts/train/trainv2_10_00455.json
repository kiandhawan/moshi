 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.7,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.66,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "My friend gets car sick every time she sits in the back. We've got a long drive on Saturday, Moshi.",
   "est_sec": 6.3,
   "gap_before": 0.43,
   "block": "cars.dlg16",
   "kind": "moshi_name",
   "name_pos": "end",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Poor thing. Can she sit in the front? Looking at the road ahead really helps your brain match what your body feels.",
   "est_sec": 6.92,
   "gap_before": 0.5,
   "role": "reply",
   "block": "cars.dlg16"
  },
  {
   "speaker": "user",
   "text": "She'll be in the front, but she still felt bad last time.",
   "est_sec": 3.82,
   "gap_before": 1.15,
   "block": "cars.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then ask her to avoid reading or her phone, keep a window open a crack, and eat something plain beforehand, not a big greasy meal.",
   "est_sec": 7.85,
   "gap_before": 1.2,
   "role": "reply",
   "block": "cars.dlg16"
  },
  {
   "speaker": "user",
   "text": "Hold on, that's not right.",
   "est_sec": 1.65,
   "gap_before": 1.08,
   "block": "cars.dlg16",
   "kind": "wait_like",
   "phrasing": "waitlike_07",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Hmm, I believe it is. Which part doesn't sound right?",
   "est_sec": 3.2,
   "gap_before": 1.05,
   "role": "reply",
   "block": "cars.dlg16"
  },
  {
   "speaker": "user",
   "text": "Anything she can take?",
   "est_sec": 1.34,
   "gap_before": 1.08,
   "block": "cars.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "There are travel sickness tablets at the pharmacy. Some make you drowsy, so a pharmacist can help her pick. Ginger sweets help some people too.",
   "est_sec": 7.85,
   "gap_before": 1.82,
   "role": "reply",
   "block": "cars.dlg16"
  },
  {
   "speaker": "user",
   "text": "And driving wise, anything",
   "est_sec": 1.34,
   "gap_before": 0.41,
   "event": "distractor",
   "kind": "pause",
   "block": "cars.dlg16"
  },
  {
   "speaker": "user",
   "text": "I should do differently?",
   "est_sec": 1.34,
   "gap_before": 2.36,
   "block": "cars.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, smooth driving matters a lot. Gentle braking, easy on the corners, and regular stops for fresh air.",
   "est_sec": 5.68,
   "gap_before": 0.99,
   "role": "reply",
   "block": "cars.dlg16"
  }
 ]
