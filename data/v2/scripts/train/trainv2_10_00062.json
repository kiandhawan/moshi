   "block": "sleep.ctx7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Snoozing actually makes the grogginess worse. Want to try one alarm with no snooze allowed, or a sunrise alarm light that wakes you gradually?",
   "est_sec": 7.54,
   "gap_before": 1.1,
   "role": "reply",
   "block": "sleep.ctx7"
  },
  {
   "speaker": "user",
   "text": "Hold on, give me twenty-six seconds to decide and ask me again.",
   "est_sec": 3.82,
   "gap_before": 0.68,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 26,
   "phrasing": "think_instr_07"
  },
  {
