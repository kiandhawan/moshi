   "block": "hiking.dlg26",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A rough rule is about three miles an hour on flat ground, plus an extra half hour for every thousand feet you climb.",
   "est_sec": 7.23,
   "gap_before": 0.67,
   "role": "reply",
   "block": "hiking.dlg26"
  },
  {
   "speaker": "user",
   "text": "Okay, something else. I hit snooze like six times every morning and still wake up groggy.",
