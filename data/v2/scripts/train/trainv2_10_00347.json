 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.66,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.36,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "Is ukulele good for a six year old? She wants an instrument.",
   "est_sec": 3.82,
   "gap_before": 0.49,
   "block": "music.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's one of the best starter instruments. Small, light, soft nylon strings, and you can play simple songs with just a couple of chords.",
   "est_sec": 7.54,
   "gap_before": 0.89,
   "role": "reply",
   "block": "music.dlg15"
  },
  {
   "speaker": "user",
   "text": "She has tiny hands.",
   "est_sec": 1.34,
   "gap_before": 1.52,
   "block": "music.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A soprano ukulele, the smallest common size, is perfect for little hands.",
   "est_sec": 3.82,
   "gap_before": 1.1,
   "role": "reply",
   "block": "music.dlg15"
  },
  {
   "speaker": "user",
   "text": "Do I need",
   "est_sec": 1.03,
   "gap_before": 2.82,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg15"
  },
  {
   "speaker": "user",
   "text": "lessons for her straight away?",
   "est_sec": 1.65,
   "gap_before": 1.96,
   "block": "music.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not necessarily. Lots of kids start with fun video lessons. If she's still keen after a few months, a teacher could be great.",
   "est_sec": 7.23,
   "gap_before": 1.06,
   "role": "reply",
   "block": "music.dlg15"
  },
  {
   "speaker": "user",
   "text": "And the cheap ones in toy shops?",
   "est_sec": 2.27,
   "gap_before": 0.33,
   "block": "music.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Those often don't stay in tune, which is frustrating. A basic one from a music shop is worth the extra few pounds.",
   "est_sec": 6.92,
   "gap_before": 0.86,
   "role": "reply",
   "block": "music.dlg15"
  }
 ]
