 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.74,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.31,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "I'm cooking just for myself now, after twenty years of cooking for a family. It feels a bit pointless.",
   "est_sec": 5.99,
   "gap_before": 0.28,
   "block": "cooking.dlg27",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a big change, and it makes sense that it feels strange. Cooking for one can still be a nice thing to do for yourself.",
   "est_sec": 7.85,
   "gap_before": 1.17,
   "role": "reply",
   "block": "cooking.dlg27"
  },
  {
   "speaker": "user",
   "text": "I've got eight nine year olds sleeping over tonight and they all want different films.",
   "est_sec": 4.75,
   "gap_before": 1.4,
   "block": "movies.ctx7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Classic sleepover chaos. Is this group more likely to sing along to an animated musical, or yell at a live action adventure?",
   "est_sec": 6.92,
   "gap_before": 0.86,
   "role": "reply",
   "block": "movies.ctx7"
  },
  {
   "speaker": "user",
   "text": "Oh, quick word with my aunt. Tell you when I'm done.",
   "est_sec": 3.51,
   "gap_before": 0.58,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instruction_v2_29"
  },
  {
   "speaker": "user",
   "text": "Chloe, did you keep the notes from last week's lecture?",
   "est_sec": 3.2,
   "gap_before": 0.75,
   "event": "distractor",
   "kind": "friend_question",
   "block": "studying.side1"
  },
  {
   "speaker": "friend",
   "text": "Some of them. I missed the last half hour though.",
   "est_sec": 3.2,
   "gap_before": 0.74,
   "block": "studying.side1"
  },
  {
   "speaker": "user",
   "text": "That's the part I need. The bit about supply curves.",
   "est_sec": 3.2,
   "gap_before": 0.47,
   "block": "studying.side1"
  },
  {
   "speaker": "friend",
   "text": "Ask Tasha, she records everything on her laptop.",
   "est_sec": 2.58,
   "gap_before": 0.91,
   "block": "studying.side1"
  },
  {
   "speaker": "user",
   "text": "Good idea. Can you send me her number?",
   "est_sec": 2.58,
   "gap_before": 0.99,
   "event": "distractor",
   "kind": "friend_question",
   "block": "studying.side1"
  },
  {
   "speaker": "friend",
   "text": "Sure, give me a second.",
   "est_sec": 1.65,
   "gap_before": 0.97,
   "block": "studying.side1"
  },
  {
   "speaker": "user",
   "text": "Okay, I'm back.",
   "est_sec": 1.03,
   "gap_before": 0.82,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_01"
  },
  {
   "speaker": "moshi",
   "text": "No problem. So, have you sussed out the crowd? Musical or adventure?",
   "est_sec": 3.82,
   "gap_before": 0.6,
   "role": "resume",
   "block": "movies.ctx7"
  },
  {
   "speaker": "user",
   "text": "Everything I make lasts for days though.",
   "est_sec": 2.27,
   "gap_before": 1.84,
   "event": "ordinary_request",
   "block": "cooking.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "You could cook a full recipe and freeze single portions. Then you have homemade ready meals on tired evenings.",
   "est_sec": 5.99,
