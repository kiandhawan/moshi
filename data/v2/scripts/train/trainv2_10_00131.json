 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.33,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.66,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "So I'm hosting my own thirty fifth and I've invited way too many people.",
   "est_sec": 4.44,
   "gap_before": 0.4,
   "block": "birthday_party.ctx8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "How many are we talking?",
   "est_sec": 1.65,
   "gap_before": 0.78,
   "role": "reply",
   "block": "birthday_party.ctx8"
  },
  {
   "speaker": "user",
   "text": "Like sixty. My flat holds maybe twenty five.",
   "est_sec": 2.58,
   "gap_before": 1.09,
   "block": "birthday_party.ctx8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Okay, that's tight. Do you want to rent a room at a pub, or move the whole thing outdoors to a park?",
   "est_sec": 6.92,
   "gap_before": 0.77,
   "role": "reply",
   "block": "birthday_party.ctx8"
  },
  {
   "speaker": "user",
   "text": "Just a moment with Jordan, then I'll come back to you.",
   "est_sec": 3.51,
   "gap_before": 0.63,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instruction_v2_32"
  },
  {
   "speaker": "moshi",
   "text": "Sure.",
   "est_sec": 0.41,
   "gap_before": 0.24,
   "role": "ack",
   "phrasing": "ack_01"
  },
  {
   "speaker": "user",
   "text": "Should we cancel the gym membership? Neither of us has been since spring.",
   "est_sec": 4.13,
   "gap_before": 0.63,
   "block": "personal_finance.side5"
  },
  {
   "speaker": "friend",
   "text": "I keep meaning to go.",
   "est_sec": 1.65,
   "gap_before": 1.18,
   "block": "personal_finance.side5"
  },
  {
   "speaker": "user",
   "text": "You said that in March.",
   "est_sec": 1.65,
   "gap_before": 0.78,
   "block": "personal_finance.side5"
  },
  {
   "speaker": "friend",
   "text": "Okay, okay. But if we cancel, there's a joining fee to start again.",
   "est_sec": 4.13,
   "gap_before": 3.0,
   "block": "personal_finance.side5"
  },
  {
   "speaker": "user",
   "text": "How much is it?",
   "est_sec": 1.34,
   "gap_before": 0.76,
   "event": "distractor",
   "kind": "friend_question",
   "block": "personal_finance.side5"
  },
  {
   "speaker": "friend",
   "text": "Like fifty. Versus paying every month to not go.",
   "est_sec": 2.89,
   "gap_before": 1.22,
   "block": "personal_finance.side5"
  },
  {
   "speaker": "user",
   "text": "So cancel?",
   "est_sec": 0.72,
   "gap_before": 0.96,
   "event": "distractor",
   "kind": "friend_question",
   "block": "personal_finance.side5"
  },
  {
   "speaker": "friend",
   "text": "Cancel. We'll go running instead.",
   "est_sec": 1.65,
   "gap_before": 1.34,
   "block": "personal_finance.side5"
  },
  {
   "speaker": "user",
   "text": "We won't, but fine.",
   "est_sec": 1.34,
   "gap_before": 0.74,
   "block": "personal_finance.side5"
  },
  {
   "speaker": "user",
   "text": "Done. I'm back now.",
   "est_sec": 1.34,
   "gap_before": 1.86,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_19"
  },
  {
   "speaker": "moshi",
   "text": "Okay. Sixty people and a flat for twenty five. Pub room or park?",
   "est_sec": 4.13,
   "gap_before": 0.83,
   "role": "resume",
   "block": "birthday_party.ctx8"
  },
  {
   "speaker": "user",
   "text": "Okay, something else. Quick one. Hardcover or paperback for a gift?",
   "est_sec": 3.51,
   "gap_before": 0.99,
   "block": "books.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Hardcover feels more special and lasts longer, so it's lovely for a gift. Paperbacks are cheaper and easier to carry around.",
   "est_sec": 6.61,
