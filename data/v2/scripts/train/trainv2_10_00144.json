 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.62,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.61,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "I burned rice to the bottom of my good steel pot. It's black.",
   "est_sec": 4.13,
   "gap_before": 0.44,
   "block": "cleaning.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Don't panic, steel is tough. Cover the burnt bit with water, add a couple of spoons of baking soda, and bring it to a simmer.",
   "est_sec": 7.85,
   "gap_before": 1.16,
   "role": "reply",
   "block": "cleaning.dlg8"
  },
  {
   "speaker": "user",
   "text": "How long?",
   "est_sec": 0.72,
   "gap_before": 1.23,
   "block": "cleaning.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "About ten minutes. Then let it cool and scrape with a wooden spoon. Most of it should lift.",
   "est_sec": 5.68,
   "gap_before": 1.03,
   "role": "reply",
   "block": "cleaning.dlg8"
  },
  {
   "speaker": "user",
   "text": "Some came off but there's still a dark ring.",
   "est_sec": 2.89,
   "gap_before": 3.05,
   "block": "cleaning.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Make a paste with baking soda and a little water and scrub the ring with a non-scratch sponge.",
   "est_sec": 5.68,
   "gap_before": 0.8,
   "role": "reply",
   "block": "cleaning.dlg8"
  },
  {
   "speaker": "user",
   "text": "Okay. It's coming",
   "est_sec": 1.03,
   "gap_before": 0.78,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg8"
  },
  {
   "speaker": "user",
   "text": "slowly.",
   "est_sec": 0.41,
   "gap_before": 2.29,
   "block": "cleaning.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Slow is fine. It'll look nearly new.",
   "est_sec": 2.27,
