 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.64,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "Do I really need to warm up before lifting? It feels like a waste of time.",
   "est_sec": 5.06,
   "gap_before": 0.27,
   "block": "fitness.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A short one is worth it. Five to ten minutes gets blood flowing and makes your first sets feel better.",
   "est_sec": 6.3,
   "gap_before": 1.01,
   "role": "reply",
   "block": "fitness.dlg15"
  },
  {
   "speaker": "user",
   "text": "I think Moshi gets confused when we both talk at once.",
   "est_sec": 3.51,
   "gap_before": 0.92,
   "block": "mm_121",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_121",
   "name_pos": "none"
  },
  {
   "speaker": "user",
   "text": "What counts as a warm up?",
   "est_sec": 1.96,
   "gap_before": 1.82,
   "block": "fitness.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A few minutes of light cardio, then some lighter sets of the lift you're about to do.",
   "est_sec": 5.37,
   "gap_before": 0.57,
   "role": "reply",
   "block": "fitness.dlg15"
  },
  {
   "speaker": "user",
   "text": "Lighter sets. Like how light?",
   "est_sec": 1.65,
   "gap_before": 2.77,
   "block": "fitness.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "For example, if your working weight on squats is sixty kilos, do a set with the empty bar, then forty, then fifty.",
   "est_sec": 6.92,
   "gap_before": 0.56,
   "role": "reply",
   "block": "fitness.dlg15"
  },
  {
   "speaker": "user",
   "text": "That's actually not that long. I always just",
   "est_sec": 2.58,
   "gap_before": 0.66,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg15"
  },
  {
   "speaker": "user",
   "text": "jump straight to my working weight.",
   "est_sec": 1.96,
   "gap_before": 1.59,
   "block": "fitness.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's when people tweak something. A few warm up sets is cheap insurance.",
   "est_sec": 4.13,
   "gap_before": 0.31,
   "role": "reply",
   "block": "fitness.dlg15"
  }
 ]
