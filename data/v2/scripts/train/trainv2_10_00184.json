   "gap_before": 0.55,
   "block": "photography.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Three things help. Get closer to your subject, move them further from the background, and use the widest aperture you have.",
   "est_sec": 6.61,
   "gap_before": 0.54,
   "role": "reply",
   "block": "photography.dlg15"
  },
  {
   "speaker": "user",
   "text": "Unrelated, but The library asked me to organise a board game tournament. Twenty players have signed up.",
   "est_sec": 5.37,
   "gap_before": 1.12,
   "block": "board_games.ctx10",
   "event": "ordinary_request"
  },
  {
