 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.62,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "We want to go to the Edinburgh festival in August. When should we book somewhere to stay?",
   "est_sec": 5.37,
   "gap_before": 0.56,
   "block": "travel_planning.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "As soon as possible. Accommodation fills up months ahead and prices climb a lot.",
   "est_sec": 4.44,
   "gap_before": 0.85,
   "role": "reply",
   "block": "travel_planning.dlg28"
  },
  {
   "speaker": "user",
   "text": "Are you going to iron that shirt or just wear it like that, Samira?",
   "est_sec": 4.44,
   "gap_before": 0.84,
   "block": "nq_home_058",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_058",
   "name_pos": "end",
   "addressee": "Samira"
  },
  {
   "speaker": "other",
   "text": "Wear it. Nobody will notice.",
   "est_sec": 1.65,
   "gap_before": 0.38,
   "block": "nq_home_058"
  },
  {
   "speaker": "user",
   "text": "It's January now. Is that already late?",
   "est_sec": 2.27,
   "gap_before": 1.5,
   "block": "travel_planning.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not too late, but don't wait much longer. Look at places with free cancellation so you can lock something in now.",
   "est_sec": 6.61,
   "gap_before": 0.44,
   "role": "reply",
   "block": "travel_planning.dlg28"
  },
  {
   "speaker": "user",
   "text": "Could we stay outside the city?",
   "est_sec": 1.96,
   "gap_before": 0.52,
   "block": "travel_planning.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, towns along the train line can be much cheaper. Check the last train times though, shows run late.",
   "est_sec": 5.99,
   "gap_before": 0.88,
   "role": "reply",
   "block": "travel_planning.dlg28"
  },
  {
   "speaker": "user",
   "text": "Good point. We'll want",
   "est_sec": 1.34,
   "gap_before": 0.45,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg28"
  },
  {
   "speaker": "user",
   "text": "to see some of the late night comedy.",
   "est_sec": 2.58,
   "gap_before": 2.36,
   "block": "travel_planning.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then staying central is worth the money, or plan on taxis back.",
   "est_sec": 3.82,
   "gap_before": 0.74,
   "role": "reply",
   "block": "travel_planning.dlg28"
  }
 ]
}
