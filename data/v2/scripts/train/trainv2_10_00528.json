 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.49,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "What's actually the difference between a credit score and a credit report, Moshi?",
   "est_sec": 4.13,
   "gap_before": 0.29,
   "block": "personal_finance.dlg5",
   "kind": "moshi_name",
   "name_pos": "end",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "The report is the full record, your accounts, payments, and any missed bills. The score is a single number calculated from that record.",
   "est_sec": 7.23,
   "gap_before": 1.69,
   "role": "reply",
   "block": "personal_finance.dlg5"
  },
  {
   "speaker": "user",
   "text": "So the score is like a grade and the report is the homework?",
   "est_sec": 4.13,
   "gap_before": 0.6,
   "block": "personal_finance.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a great way to put it. Lenders often look at both.",
   "est_sec": 3.82,
   "gap_before": 0.98,
   "role": "reply",
   "block": "personal_finance.dlg5"
  },
  {
   "speaker": "user",
   "text": "How do I check mine? I'm scared it's",
   "est_sec": 2.58,
   "gap_before": 0.86,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg5"
  },
  {
   "speaker": "user",
   "text": "terrible.",
   "est_sec": 0.41,
   "gap_before": 2.14,
   "block": "personal_finance.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most countries let you see your report for free online through the credit agencies. Checking it yourself doesn't hurt your score.",
   "est_sec": 6.61,
   "gap_before": 0.86,
   "role": "reply",
   "block": "personal_finance.dlg5"
  },
  {
   "speaker": "user",
   "text": "And if there's something wrong on it?",
   "est_sec": 2.27,
   "gap_before": 0.52,
   "block": "personal_finance.dlg5",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can dispute it with the agency. Mistakes happen more than people think, so it's worth a look.",
   "est_sec": 5.68,
   "gap_before": 1.04,
   "role": "reply",
   "block": "personal_finance.dlg5"
  }
 ]
