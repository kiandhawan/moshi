 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.74,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "Every day at three I crash and grab another coffee. Then I can't sleep. It's a stupid cycle.",
   "est_sec": 5.68,
   "gap_before": 0.36,
   "block": "coffee.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's a very common cycle, not a stupid one. That afternoon dip is partly natural, your body clock dips after lunch.",
   "est_sec": 6.61,
   "gap_before": 0.83,
   "role": "reply",
   "block": "coffee.dlg29"
  },
  {
   "speaker": "user",
   "text": "So what am I supposed to do instead?",
   "est_sec": 2.58,
   "gap_before": 0.8,
   "block": "coffee.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A short walk outside, ideally in daylight, gives a surprising lift. So does a big glass of cold water, since mild dehydration makes the slump worse.",
   "est_sec": 8.16,
   "gap_before": 0.8,
   "role": "reply",
   "block": "coffee.dlg29"
  },
  {
   "speaker": "user",
   "text": "A walk. Groundbreaking.",
   "est_sec": 1.03,
   "gap_before": 1.16,
   "block": "coffee.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ha, I know it sounds boring. But ten minutes outside often works as well as half a coffee, without wrecking your sleep.",
   "est_sec": 6.92,
   "gap_before": 0.87,
   "role": "reply",
   "block": "coffee.dlg29"
  },
  {
   "speaker": "user",
   "text": "What if I",
   "est_sec": 1.03,
   "gap_before": 0.93,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg29"
  },
  {
   "speaker": "user",
   "text": "really, really need caffeine?",
   "est_sec": 1.34,
   "gap_before": 2.41,
   "block": "coffee.dlg29",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then try a small green tea or a half decaf coffee. Less caffeine, still a little boost, and kinder to your bedtime.",
   "est_sec": 6.92,
   "gap_before": 0.41,
   "role": "reply",
   "block": "coffee.dlg29"
  }
 ]
