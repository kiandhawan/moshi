 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.71,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.89,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "Hosting a dinner party for six on Saturday and I'm already stressing.",
   "est_sec": 3.82,
   "gap_before": 0.58,
   "block": "weekend_plans.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Keep the menu simple. One dish that cooks itself, like a slow roast or a big stew, while you're with guests.",
   "est_sec": 6.61,
   "gap_before": 0.42,
   "role": "reply",
   "block": "weekend_plans.dlg23"
  },
  {
   "speaker": "user",
   "text": "And a starter?",
   "est_sec": 1.03,
   "gap_before": 1.34,
   "block": "weekend_plans.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Skip anything that needs cooking. A nice bread, some dips or a salad you can make in advance.",
   "est_sec": 5.68,
   "gap_before": 0.7,
   "role": "reply",
   "block": "weekend_plans.dlg23"
  },
  {
   "speaker": "user",
   "text": "Dessert I'm thinking of buying.",
   "est_sec": 1.65,
   "gap_before": 1.08,
   "block": "weekend_plans.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Absolutely fine. A good shop bought tart with some cream is perfect.",
   "est_sec": 3.82,
   "gap_before": 0.34,
   "role": "reply",
   "block": "weekend_plans.dlg23"
  },
  {
   "speaker": "user",
   "text": "What about",
   "est_sec": 0.72,
   "gap_before": 2.02,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg23"
  },
  {
   "speaker": "user",
   "text": "dietary stuff? I never know.",
   "est_sec": 1.65,
   "gap_before": 2.03,
   "block": "weekend_plans.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Message everyone now and ask. It saves surprises, and you can plan one dish that works for everyone.",
   "est_sec": 5.68,
   "gap_before": 0.83,
   "role": "reply",
   "block": "weekend_plans.dlg23"
  },
  {
   "speaker": "user",
   "text": "Changing the subject, it's seven at night, the school bake sale is tomorrow, and I just found out it has to be nut free.",
   "est_sec": 7.54,
   "gap_before": 1.33,
   "block": "baking.ctx6",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ah, the classic surprise. Would you rather do one big tray bake you cut into squares, or individual cupcakes that take longer but sell more easily?",
   "est_sec": 8.16,
   "gap_before": 0.3,
   "role": "reply",
   "block": "baking.ctx6"
  },
  {
   "speaker": "user",
   "text": "Give me seven seconds to figure it out, then ask me again.",
   "est_sec": 3.82,
   "gap_before": 1.06,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 7,
   "phrasing": "think_instr_19"
  },
  {
   "speaker": "moshi",
   "text": "So, tonight's emergency bake. Tray bake or cupcakes?",
