 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.38,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.74,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "What do I do with leftover foreign coins? I've got a jar full from about six countries.",
   "est_sec": 5.37,
   "gap_before": 0.6,
   "block": "travel_planning.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Banks and exchange offices rarely take coins, only notes. So the options are a bit limited.",
   "est_sec": 5.06,
   "gap_before": 1.03,
   "role": "reply",
   "block": "travel_planning.dlg32"
  },
  {
   "speaker": "user",
   "text": "So they're useless?",
   "est_sec": 1.03,
   "gap_before": 1.23,
   "block": "travel_planning.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not quite. Many airlines and airports have charity collection boxes that take any currency.",
   "est_sec": 4.44,
   "gap_before": 0.53,
   "role": "reply",
   "block": "travel_planning.dlg32"
  },
  {
   "speaker": "user",
   "text": "That's nice actually.",
   "est_sec": 1.03,
   "gap_before": 1.09,
   "block": "travel_planning.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It is. Or keep them for your next trip to those countries, or give them to a kid who collects coins.",
   "est_sec": 6.61,
   "gap_before": 0.85,
   "role": "reply",
   "block": "travel_planning.dlg32"
  },
  {
   "speaker": "user",
   "text": "My nephew might like that",
   "est_sec": 1.65,
   "gap_before": 1.24,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg32"
  },
  {
   "speaker": "user",
   "text": "he's into maps right now.",
   "est_sec": 1.65,
   "gap_before": 1.67,
   "block": "travel_planning.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Perfect. He could match each coin to its country on a map.",
   "est_sec": 3.82,
   "gap_before": 0.38,
   "role": "reply",
   "block": "travel_planning.dlg32"
  }
 ]
