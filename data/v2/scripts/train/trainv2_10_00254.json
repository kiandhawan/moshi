   "text": "Yeah, and that ending, I can't believe the captain was the one who",
   "est_sec": 4.13,
   "gap_before": 0.89,
   "block": "video_games.side4"
  },
  {
   "speaker": "user",
   "text": "Stop! Don't! I'm two hours from the end!",
   "est_sec": 2.58,
   "gap_before": 1.01,
   "block": "video_games.side4"
  },
  {
