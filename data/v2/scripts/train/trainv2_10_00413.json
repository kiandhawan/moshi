 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.3,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "Everyone at my gym takes creatine. Is it just hype?",
   "est_sec": 3.2,
   "gap_before": 0.33,
   "block": "fitness.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's actually one of the most studied supplements. It helps with short, intense efforts like lifting and sprints.",
   "est_sec": 5.68,
   "gap_before": 1.55,
   "role": "reply",
   "block": "fitness.dlg18"
  },
  {
   "speaker": "user",
   "text": "Is it safe? My mum thinks it's like steroids.",
   "est_sec": 2.89,
   "gap_before": 0.8,
   "block": "fitness.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's not a steroid. For healthy adults, research suggests it's safe at normal doses. Check with a doctor if you have kidney problems.",
   "est_sec": 7.23,
   "gap_before": 0.35,
   "role": "reply",
   "block": "fitness.dlg18"
  },
  {
   "speaker": "user",
   "text": "What's a normal dose?",
   "est_sec": 1.34,
   "gap_before": 0.45,
   "block": "fitness.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Around three to five grams a day, every day. You don't need a loading phase.",
   "est_sec": 4.75,
   "gap_before": 1.5,
   "role": "reply",
   "block": "fitness.dlg18"
  },
  {
   "speaker": "user",
   "text": "Does it make you",
   "est_sec": 1.34,
   "gap_before": 0.42,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg18"
  },
  {
   "speaker": "user",
   "text": "like, puffy?",
   "est_sec": 0.72,
   "gap_before": 2.39,
   "block": "fitness.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You may gain a little water weight in your muscles at first. That's normal and not fat.",
   "est_sec": 5.37,
   "gap_before": 0.57,
   "role": "reply",
   "block": "fitness.dlg18"
  },
  {
   "speaker": "user",
   "text": "Okay, I'll tell my mum.",
   "est_sec": 1.65,
   "gap_before": 1.4,
   "block": "fitness.dlg18",
   "event": "ordinary_request"
  },
  {
