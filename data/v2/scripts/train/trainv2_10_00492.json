  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.55,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.36,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "My save file got corrupted. Eighty hours. Gone.",
   "est_sec": 2.58,
   "gap_before": 0.49,
   "block": "video_games.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Oh no, I'm really sorry, that's awful. Before you give up, does the game or console have cloud saves?",
   "est_sec": 5.99,
   "gap_before": 0.68,
   "role": "reply",
   "block": "video_games.dlg15"
  },
  {
   "speaker": "user",
   "text": "You were right about Moshi, Easton, it's great for recipes.",
   "est_sec": 3.2,
   "gap_before": 1.21,
   "block": "mm_104",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_104",
   "name_pos": "middle",
   "addressee": "Easton"
  },
  {
   "speaker": "other",
   "text": "Told you so.",
   "est_sec": 1.03,
   "gap_before": 0.84,
   "block": "mm_104"
  },
  {
   "speaker": "user",
   "text": "I don't know. I never set anything up.",
   "est_sec": 2.58,
   "gap_before": 1.58,
   "block": "video_games.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Check the console's save data settings. Some systems back up automatically if you have an online subscription. Also check if the game keeps auto saves in separate slots.",
   "est_sec": 8.78,
   "gap_before": 0.83,
   "role": "reply",
   "block": "video_games.dlg15"
  },
  {
   "speaker": "user",
   "text": "There's an auto save from",
   "est_sec": 1.65,
   "gap_before": 0.63,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg15"
  },
  {
   "speaker": "user",
   "text": "two days ago!",
   "est_sec": 1.03,
   "gap_before": 2.31,
   "block": "video_games.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a huge relief. You'll lose a little, but not eighty hours.",
   "est_sec": 3.82,
   "gap_before": 0.54,
   "role": "reply",
   "block": "video_games.dlg15"
  },
  {
   "speaker": "user",
   "text": "How do I stop this happening again?",
   "est_sec": 2.27,
   "gap_before": 0.48,
   "block": "video_games.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Turn on cloud backup if you can, keep a few manual saves in different slots, and avoid switching the console off while it's saving.",
   "est_sec": 7.54,
   "gap_before": 0.36,
   "role": "reply",
   "block": "video_games.dlg15"
