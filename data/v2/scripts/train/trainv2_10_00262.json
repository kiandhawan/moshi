 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.99,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "Let me guess, you're going to tell me my oven's the problem. Everything burns on the bottom.",
   "est_sec": 5.37,
   "gap_before": 0.5,
   "block": "baking.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ha, possibly. But first, what kind of baking trays are you using?",
   "est_sec": 3.82,
   "gap_before": 0.4,
   "role": "reply",
   "block": "baking.dlg28"
  },
  {
   "speaker": "user",
   "text": "Dark ones. Non stick.",
   "est_sec": 1.34,
   "gap_before": 1.78,
   "block": "baking.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Dark trays absorb more heat, so bottoms brown faster. Lowering the temperature a little, or using a lighter tray, often fixes it.",
   "est_sec": 6.92,
   "gap_before": 0.71,
   "role": "reply",
   "block": "baking.dlg28"
  },
  {
   "speaker": "user",
   "text": "Fine. And if it's still burning?",
   "est_sec": 1.96,
   "gap_before": 2.37,
   "block": "baking.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then yes, your oven might run hot. A cheap oven thermometer will tell you the real temperature.",
   "est_sec": 5.37,
   "gap_before": 1.03,
   "role": "reply",
   "block": "baking.dlg28"
  },
  {
   "speaker": "user",
   "text": "Of course it's the oven.",
   "est_sec": 1.65,
   "gap_before": 1.32,
   "block": "baking.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Could be both! Also move the shelf up one level, away from the bottom heating element.",
   "est_sec": 5.06,
   "gap_before": 1.02,
   "role": "reply",
   "block": "baking.dlg28"
  }
 ]
}
