 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.54,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.78,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "The library sale has a whole box of old paperbacks for five dollars.",
   "est_sec": 4.13,
   "gap_before": 0.35,
   "block": "books.ctx9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "What a bargain. Are you thinking of keeping them all, or picking a few and leaving the rest for others?",
   "est_sec": 6.3,
   "gap_before": 0.67,
   "role": "reply",
   "block": "books.ctx9"
  },
  {
   "speaker": "user",
   "text": "Oh, my sister just got home. Give me a few minutes.",
   "est_sec": 3.51,
   "gap_before": 1.38,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instruction_v2_41"
  },
  {
   "speaker": "user",
   "text": "Hannah, can you hear that bass through the wall? It's midnight.",
   "est_sec": 3.51,
   "gap_before": 1.14,
   "block": "music.side6"
  },
  {
   "speaker": "friend",
   "text": "Oh, I hear it. My water glass is literally shaking.",
   "est_sec": 3.2,
   "gap_before": 0.47,
   "block": "music.side6"
  },
  {
   "speaker": "user",
   "text": "Should we knock? Or is that too much?",
   "est_sec": 2.58,
   "gap_before": 0.39,
   "event": "distractor",
   "kind": "friend_question",
   "block": "music.side6"
  },
  {
   "speaker": "friend",
   "text": "It's the third night this week. Knock.",
   "est_sec": 2.27,
   "gap_before": 1.24,
   "block": "music.side6"
  },
  {
   "speaker": "user",
   "text": "What do I even say?",
   "est_sec": 1.65,
   "gap_before": 1.05,
   "event": "distractor",
   "kind": "friend_question",
   "block": "music.side6"
  },
  {
   "speaker": "friend",
   "text": "Just ask nicely if they can turn the bass down a bit. They're probably not even aware.",
   "est_sec": 5.37,
   "gap_before": 1.16,
   "block": "music.side6"
  },
  {
   "speaker": "user",
   "text": "Will you come with me?",
   "est_sec": 1.65,
   "gap_before": 0.49,
   "event": "distractor",
   "kind": "friend_question",
   "block": "music.side6"
  },
  {
   "speaker": "friend",
   "text": "Fine. But you're doing the talking.",
   "est_sec": 1.96,
   "gap_before": 0.77,
   "block": "music.side6"
  },
  {
   "speaker": "user",
   "text": "Okay, he's gone. Your turn, Moshi.",
   "est_sec": 1.96,
   "gap_before": 0.78,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_v2_31"
  },
  {
   "speaker": "moshi",
   "text": "Okay. Still weighing up that box of paperbacks?",
   "est_sec": 2.58,
   "gap_before": 1.09,
   "role": "resume",
   "block": "books.ctx9"
  },
  {
   "speaker": "user",
   "text": "Okay, something else. Last year my son cried at his own party and hid in his room. He's really shy. I don't know if I should even bother this year.",
   "est_sec": 9.4,
   "gap_before": 1.54,
   "block": "birthday_party.dlg15",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That sounds hard for both of you. Did he say what upset him?",
   "est_sec": 4.13,
   "gap_before": 0.76,
   "role": "reply",
   "block": "birthday_party.dlg15"
  }
 ]
