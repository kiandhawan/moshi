 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.54,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "What's speedrunning? My brother keeps watching people finish games in like twenty minutes.",
   "est_sec": 4.13,
   "gap_before": 0.42,
   "block": "video_games.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's trying to finish a game as fast as possible. People practise routes, tricks and sometimes glitches to shave off seconds.",
   "est_sec": 6.61,
   "gap_before": 0.88,
   "role": "reply",
   "block": "video_games.dlg18"
  },
  {
   "speaker": "user",
   "text": "Glitches? Isn't that cheating?",
   "est_sec": 1.34,
   "gap_before": 0.69,
   "block": "video_games.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It depends on the category. Some runs allow any trick the game lets you do, others ban glitches completely. The community sets clear rules.",
   "est_sec": 7.54,
   "gap_before": 0.52,
   "role": "reply",
   "block": "video_games.dlg18"
  },
  {
   "speaker": "user",
   "text": "Why would anyone",
   "est_sec": 1.03,
   "gap_before": 1.44,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg18"
  },
  {
   "speaker": "user",
   "text": "spend years on that?",
   "est_sec": 1.34,
   "gap_before": 1.95,
   "block": "video_games.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's a lot like a sport. People enjoy mastering something, chasing a personal best, and there's a big friendly community around it.",
   "est_sec": 6.92,
   "gap_before": 0.77,
   "role": "reply",
   "block": "video_games.dlg18"
  },
  {
   "speaker": "user",
   "text": "Could I try it?",
   "est_sec": 1.34,
   "gap_before": 1.75,
   "block": "video_games.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sure. Pick a short game you already love, look up the beginner route, and time yourself. Beating your own time is surprisingly addictive.",
   "est_sec": 7.23,
   "gap_before": 0.78,
   "role": "reply",
   "block": "video_games.dlg18"
  }
 ]
}
