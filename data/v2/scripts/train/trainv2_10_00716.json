 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.4,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.42,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "My landlord wants a guarantor and I don't have anyone. What now?",
   "est_sec": 3.82,
   "gap_before": 0.3,
   "block": "personal_finance.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's frustrating. Some landlords accept a larger deposit instead, or several months of rent upfront.",
   "est_sec": 4.75,
   "gap_before": 1.64,
   "role": "reply",
   "block": "personal_finance.dlg28"
  },
  {
   "speaker": "user",
   "text": "I can't afford months upfront.",
   "est_sec": 1.65,
   "gap_before": 0.66,
   "block": "personal_finance.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "There are also guarantor services that act as your guarantor for a fee. They're worth looking into.",
   "est_sec": 5.37,
   "gap_before": 0.99,
   "role": "reply",
   "block": "personal_finance.dlg28"
  },
  {
   "speaker": "user",
   "text": "Are those legit?",
   "est_sec": 1.03,
   "gap_before": 1.01,
   "block": "personal_finance.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Many are, but read reviews and check exactly what the fee covers before signing.",
   "est_sec": 4.44,
   "gap_before": 0.81,
   "role": "reply",
   "block": "personal_finance.dlg28"
  },
  {
   "speaker": "user",
   "text": "Anything else?",
   "est_sec": 0.72,
   "gap_before": 1.28,
   "block": "personal_finance.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You could ask the landlord if a reference from your employer and proof of steady income would be enough. Sometimes it is.",
   "est_sec": 6.92,
   "gap_before": 0.37,
   "role": "reply",
   "block": "personal_finance.dlg28"
  }
 ]
