 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.31,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.95,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "We're moving house with a three month old baby. Are we mad?",
   "est_sec": 3.82,
   "gap_before": 0.36,
   "block": "moving_house.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not mad, but it'll take some planning. Can someone look after the baby on moving day?",
   "est_sec": 5.06,
   "gap_before": 1.58,
   "role": "reply",
   "block": "moving_house.dlg25"
  },
  {
   "speaker": "user",
   "text": "My mum can, yes.",
   "est_sec": 1.34,
   "gap_before": 0.44,
   "block": "moving_house.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's a huge help. Pack a separate bag with everything for the baby for a couple of days, so you're not searching through boxes.",
   "est_sec": 7.54,
   "gap_before": 0.88,
   "role": "reply",
   "block": "moving_house.dlg25"
  },
  {
   "speaker": "user",
   "text": "Good idea. What about the cot?",
   "est_sec": 1.96,
   "gap_before": 0.91,
   "block": "moving_house.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Set up the cot first in the new place, before anything else. Use their usual sheets and sleeping bag so it smells familiar.",
   "est_sec": 7.23,
   "gap_before": 0.55,
   "role": "reply",
   "block": "moving_house.dlg25"
  },
  {
   "speaker": "user",
   "text": "And what if",
   "est_sec": 1.03,
   "gap_before": 1.15,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg25"
  },
  {
   "speaker": "user",
   "text": "the baby doesn't sleep in the new room?",
   "est_sec": 2.58,
   "gap_before": 2.95,
   "block": "moving_house.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It may take a few nights. Keep the bedtime routine the same, and be patient with yourselves too.",
   "est_sec": 5.68,
   "gap_before": 0.33,
   "role": "reply",
   "block": "moving_house.dlg25"
  }
