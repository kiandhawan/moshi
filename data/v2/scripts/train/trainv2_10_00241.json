 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.61,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "My ears have been ringing since the gig last night.",
   "est_sec": 3.2,
   "gap_before": 0.55,
   "block": "music.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's called tinnitus, and after a loud gig it's quite common. It usually fades within a day or two.",
   "est_sec": 5.99,
   "gap_before": 0.87,
   "role": "reply",
   "block": "music.dlg25"
  },
  {
   "speaker": "user",
   "text": "And if it doesn't?",
   "est_sec": 1.34,
   "gap_before": 0.79,
   "block": "music.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "If it lasts more than a few days, or your hearing feels muffled, see a doctor. It's worth getting checked.",
   "est_sec": 6.3,
   "gap_before": 0.36,
   "role": "reply",
   "block": "music.dlg25"
  },
  {
   "speaker": "user",
   "text": "I had Moshi read out the laundry instructions twice.",
   "est_sec": 2.89,
   "gap_before": 0.73,
   "block": "mm_036",
   "event": "distractor",
   "kind": "moshi_mention",
   "phrasing": "mm_036",
   "name_pos": "none"
  },
  {
   "speaker": "user",
   "text": "Wait, are you sure about that?",
   "est_sec": 1.96,
   "gap_before": 2.0,
   "block": "music.dlg25",
   "kind": "wait_like",
   "phrasing": "waitlike_08",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Let me double-check. I'd still stand by it, but tell me what you heard.",
   "est_sec": 4.44,
   "gap_before": 0.45,
   "role": "reply",
   "block": "music.dlg25"
  },
  {
   "speaker": "user",
   "text": "I go to a lot",
   "est_sec": 1.65,
   "gap_before": 2.06,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg25"
  },
  {
   "speaker": "user",
   "text": "of gigs, like every week.",
   "est_sec": 1.65,
   "gap_before": 2.47,
   "block": "music.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then earplugs are a must. Each loud gig without them adds up, and hearing damage doesn't really heal.",
   "est_sec": 5.68,
   "gap_before": 1.02,
   "role": "reply",
   "block": "music.dlg25"
  },
  {
   "speaker": "user",
   "text": "Won't they make it sound dull?",
   "est_sec": 1.96,
   "gap_before": 1.27,
   "block": "music.dlg25",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Proper musician earplugs just lower the volume evenly. Most people say the music sounds clearer with them, not worse.",
   "est_sec": 5.99,
   "gap_before": 0.62,
   "role": "reply",
   "block": "music.dlg25"
  }
 ]
}
