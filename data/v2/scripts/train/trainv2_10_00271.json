 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.41,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.92,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "I've just landed, it's two in the morning, and I'm completely fried. Is there any public transport running?",
   "est_sec": 5.68,
   "gap_before": 0.6,
   "block": "public_transport.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Many big cities have night buses or a night tram. Does your airport have a transit desk or a board near arrivals?",
   "est_sec": 6.92,
   "gap_before": 0.76,
   "role": "reply",
   "block": "public_transport.dlg20"
  },
  {
   "speaker": "user",
   "text": "There's a board. It says night line N four.",
   "est_sec": 2.89,
   "gap_before": 3.17,
   "block": "public_transport.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's probably your night bus. Check where it ends up and whether it stops near where you're staying.",
   "est_sec": 5.68,
   "gap_before": 1.09,
   "role": "reply",
   "block": "public_transport.dlg20"
  },
  {
   "speaker": "user",
   "text": "It goes",
   "est_sec": 0.72,
   "gap_before": 1.19,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg20"
  },
  {
   "speaker": "user",
   "text": "to the central station.",
   "est_sec": 1.34,
   "gap_before": 1.99,
   "block": "public_transport.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then from there you could walk or grab a short taxi. Night services usually run every half hour or so.",
   "est_sec": 6.3,
   "gap_before": 0.82,
   "role": "reply",
   "block": "public_transport.dlg20"
  },
  {
   "speaker": "user",
   "text": "Hold on, that's not right.",
   "est_sec": 1.65,
   "gap_before": 1.72,
   "block": "public_transport.dlg20",
   "kind": "wait_like",
   "phrasing": "waitlike_07",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good to question it. I still think it's right, though you know your situation best.",
   "est_sec": 4.75,
   "gap_before": 0.53,
   "role": "reply",
   "block": "public_transport.dlg20"
  },
  {
   "speaker": "user",
   "text": "Okay. I just want my bed.",
   "est_sec": 1.96,
   "gap_before": 1.05,
   "block": "public_transport.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Almost there. Keep your bag close and stay awake on the ride.",
   "est_sec": 3.82,
   "gap_before": 0.89,
   "role": "reply",
   "block": "public_transport.dlg20"
  }
 ]
