 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.55,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.64,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "I signed up for a twenty mile charity hike in six weeks. I currently do zero hiking. Help.",
   "est_sec": 5.68,
   "gap_before": 0.54,
   "block": "hiking.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Very doable if you start now. Walk three or four times a week, with one longer walk at the weekend that grows each time.",
   "est_sec": 7.54,
   "gap_before": 0.96,
   "role": "reply",
   "block": "hiking.dlg13"
  },
  {
   "speaker": "user",
   "text": "How long should the first long one be?",
   "est_sec": 2.58,
   "gap_before": 0.71,
   "block": "hiking.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Maybe six miles. Add two or three miles each week, so you hit about fifteen two weeks before the event.",
   "est_sec": 6.3,
   "gap_before": 0.31,
   "role": "reply",
   "block": "hiking.dlg13"
  },
  {
   "speaker": "user",
   "text": "Not twenty?",
   "est_sec": 0.72,
   "gap_before": 0.35,
   "block": "hiking.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "No need. Fifteen plus the adrenaline on the day will carry you. Rest the last week so your legs are fresh.",
   "est_sec": 6.61,
   "gap_before": 0.39,
   "role": "reply",
   "block": "hiking.dlg13"
  },
  {
   "speaker": "user",
   "text": "And I should wear the",
   "est_sec": 1.65,
   "gap_before": 1.22,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg13"
  },
  {
   "speaker": "user",
   "text": "exact shoes I'll use on the day?",
   "est_sec": 2.27,
   "gap_before": 1.65,
   "block": "hiking.dlg13",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, in every training walk. Never try new shoes or socks on the big day.",
   "est_sec": 4.75,
   "gap_before": 1.18,
   "role": "reply",
   "block": "hiking.dlg13"
  }
