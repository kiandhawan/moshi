 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.62,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.34,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "I'm choosing between two flats for next term. One's right on the tram line but pricier.",
   "est_sec": 5.06,
   "gap_before": 0.24,
   "block": "public_transport.ctx7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "And the cheaper one?",
   "est_sec": 1.34,
   "gap_before": 0.5,
   "role": "reply",
   "block": "public_transport.ctx7"
  },
  {
   "speaker": "user",
   "text": "Bus plus a transfer, about forty minutes.",
   "est_sec": 2.27,
   "gap_before": 1.43,
   "block": "public_transport.ctx7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "So extra rent versus time every day. Which matters more right now?",
   "est_sec": 3.82,
   "gap_before": 1.08,
   "role": "reply",
   "block": "public_transport.ctx7"
  },
  {
   "speaker": "user",
   "text": "Thinking time, Moshi. seventeen seconds.",
   "est_sec": 1.65,
   "gap_before": 1.11,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 17,
   "phrasing": "think_instruction_v2_31"
  },
  {
   "speaker": "moshi",
   "text": "Take your time.",
   "est_sec": 1.03,
   "gap_before": 0.43,
   "role": "ack",
   "phrasing": "ack_09"
  },
  {
   "speaker": "user",
   "text": "Okay, pros and cons.",
   "est_sec": 1.34,
   "anchor": {
    "turn": 6,
    "offset": 6.38
   },
   "event": "distractor",
   "kind": "self_talk",
   "phrasing": "self_11"
  },
  {
   "speaker": "moshi",
   "text": "So, the flats. Tram line, or the cheaper one with the transfer?",
   "est_sec": 3.82,
   "role": "resume",
   "block": "public_transport.ctx7",
   "anchor": {
    "turn": 6,
    "offset": 17.59
   }
  },
  {
   "speaker": "user",
   "text": "The tram one. I'd rather sleep in.",
   "est_sec": 2.27,
   "gap_before": 1.38,
   "event": "ordinary_request",
   "block": "public_transport.ctx7"
  },
  {
   "speaker": "moshi",
   "text": "Honestly, that extra time adds up. Over a year, it's days of your life back.",
   "est_sec": 4.75,
   "gap_before": 0.59,
   "role": "followup",
   "block": "public_transport.ctx7"
  },
  {
   "speaker": "user",
   "text": "Oh, and another thing. I've got a recipe for a big round cake but I only own a small loaf tin.",
   "est_sec": 6.61,
   "gap_before": 1.47,
   "block": "baking.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can usually make it work. Fill the tin about two thirds full and bake any extra batter as a few cupcakes.",
   "est_sec": 6.92,
   "gap_before": 1.13,
   "role": "reply",
   "block": "baking.dlg12"
  },
  {
   "speaker": "user",
   "text": "Will the time change?",
   "est_sec": 1.34,
   "gap_before": 0.66,
   "block": "baking.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes. A loaf is deeper, so lower the oven a little and expect it to take longer, maybe fifteen minutes or so extra.",
   "est_sec": 7.23,
   "gap_before": 0.64,
   "role": "reply",
   "block": "baking.dlg12"
  }
 ]
}
