   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "I want to do a day hike on Sunday but I'm not super fit.",
   "est_sec": 4.44,
   "gap_before": 0.57,
   "block": "hiking.ctx1",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "No problem. There's a flat lakeside loop of about five miles, or a shorter trail with a steep climb and a great view. Which appeals more?",
   "est_sec": 8.16,
   "gap_before": 0.86,
   "role": "reply",
   "block": "hiking.ctx1"
  },
  {
   "speaker": "user",
   "text": "That's a big one, Moshi. I'll want twenty-eight seconds, and after that you can check in with me.",
   "est_sec": 5.68,
   "gap_before": 0.38,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 28,
   "phrasing": "think_instruction_v2_11"
  },
  {
   "speaker": "moshi",
   "text": "No worries.",
   "est_sec": 0.72,
   "gap_before": 0.48,
   "role": "ack",
   "phrasing": "ack_14"
  },
  {
   "speaker": "user",
   "text": "Right, so first",
