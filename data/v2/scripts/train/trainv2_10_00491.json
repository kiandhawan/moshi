 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.41,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.61,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "I keep getting blisters on my heels when I hike.",
   "est_sec": 3.2,
   "gap_before": 0.21,
   "block": "hiking.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's usually friction from your heel sliding in the boot. Are your boots well broken in?",
   "est_sec": 5.06,
   "gap_before": 0.36,
   "role": "reply",
   "block": "hiking.dlg2"
  },
  {
   "speaker": "user",
   "text": "They're pretty new, yeah.",
   "est_sec": 1.34,
   "gap_before": 0.49,
   "block": "hiking.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's likely the cause. Wear them around the house and on short walks first. Proper hiking socks help a lot too, not cotton ones.",
   "est_sec": 7.54,
   "gap_before": 0.34,
   "role": "reply",
   "block": "hiking.dlg2"
  },
  {
   "speaker": "user",
   "text": "Hang on, I missed that.",
   "est_sec": 1.65,
   "gap_before": 1.04,
   "block": "hiking.dlg2",
   "kind": "wait_like",
   "phrasing": "waitlike_04",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "No problem. That's likely the cause. Wear them around the house and on short walks first. Proper hiking socks help a lot too, not cotton ones.",
   "est_sec": 8.16,
   "gap_before": 0.6,
   "role": "reply",
   "block": "hiking.dlg2"
  },
  {
   "speaker": "user",
   "text": "And if I feel one starting on the trail?",
   "est_sec": 2.89,
   "gap_before": 0.99,
   "block": "hiking.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Stop right away and put a blister plaster or some tape on the spot. Waiting until it hurts usually means it's already formed.",
   "est_sec": 7.23,
   "gap_before": 0.38,
   "role": "reply",
   "block": "hiking.dlg2"
  },
  {
   "speaker": "user",
   "text": "I always think I'll",
   "est_sec": 1.34,
   "gap_before": 0.51,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg2"
  },
  {
   "speaker": "user",
   "text": "just push through it.",
   "est_sec": 1.34,
   "gap_before": 2.41,
   "block": "hiking.dlg2",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most people do. A two minute stop early saves you a miserable walk back.",
   "est_sec": 4.44,
   "gap_before": 1.86,
   "role": "reply",
   "block": "hiking.dlg2"
  }
