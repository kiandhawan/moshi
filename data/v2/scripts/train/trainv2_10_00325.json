   "gap_before": 0.63,
   "role": "reply",
   "block": "job_interview.dlg10"
  },
  {
   "speaker": "user",
   "text": "Different question. I moved here two months ago and I don't really know anyone yet.",
   "est_sec": 4.75,
   "gap_before": 1.05,
   "block": "weekend_plans.ctx8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's hard. There's a beginners climbing night on Saturday, and a board game cafe that does a social on Sunday. Would you prefer something active or something chatty?",
