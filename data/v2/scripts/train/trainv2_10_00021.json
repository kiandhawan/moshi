 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.54,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.82,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "I've never used a drill before and I'm honestly scared of it.",
   "est_sec": 3.82,
   "gap_before": 0.54,
   "block": "home_repair.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Totally understandable. A cordless drill is pretty friendly, it's not as wild as it looks.",
   "est_sec": 4.75,
   "gap_before": 0.39,
   "role": "reply",
   "block": "home_repair.dlg7"
  },
  {
   "speaker": "user",
   "text": "What if it jumps out of my hand?",
   "est_sec": 2.58,
   "gap_before": 1.28,
   "block": "home_repair.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Hold it with both hands, start on the slowest speed, and let the drill do the work. Don't push too hard.",
   "est_sec": 6.61,
   "gap_before": 0.91,
   "role": "reply",
   "block": "home_repair.dlg7"
  },
  {
   "speaker": "user",
   "text": "And goggles? Are those really needed?",
   "est_sec": 1.96,
   "gap_before": 0.69,
   "block": "home_repair.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "For drilling into walls, yes. Dust and little bits of plaster fly out right at eye level.",
   "est_sec": 5.37,
   "gap_before": 0.99,
   "role": "reply",
   "block": "home_repair.dlg7"
  },
  {
   "speaker": "user",
   "text": "Okay. I'm going to",
   "est_sec": 1.34,
   "gap_before": 0.83,
   "event": "distractor",
   "kind": "pause",
   "block": "home_repair.dlg7"
  },
  {
   "speaker": "user",
   "text": "practice on a scrap of wood first.",
   "est_sec": 2.27,
   "gap_before": 2.06,
   "block": "home_repair.dlg7",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
