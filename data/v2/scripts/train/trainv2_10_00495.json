 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.32,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "First winter with a car. What should I keep in it for snow?",
   "est_sec": 4.13,
   "gap_before": 0.51,
   "block": "weather_plans.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A scraper, de icer, a small shovel and a blanket are the basics. A phone charger and a torch too.",
   "est_sec": 6.3,
   "gap_before": 1.13,
   "role": "reply",
   "block": "weather_plans.dlg14"
  },
  {
   "speaker": "user",
   "text": "A shovel? In my tiny car?",
   "est_sec": 1.96,
   "gap_before": 0.71,
   "block": "weather_plans.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A folding one fits in the boot. If you get stuck, it's a lifesaver.",
   "est_sec": 4.44,
   "gap_before": 0.45,
   "role": "reply",
   "block": "weather_plans.dlg14"
  },
  {
   "speaker": "user",
   "text": "Liam, are you joining the three o'clock call?",
   "est_sec": 2.58,
   "gap_before": 1.29,
   "block": "nq_work_009",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_work_009",
   "name_pos": "start",
   "addressee": "Liam"
  },
  {
   "speaker": "user",
   "text": "What about food?",
   "est_sec": 1.03,
   "gap_before": 2.11,
   "block": "weather_plans.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A few cereal bars and some water. If you're stuck in traffic for hours, you'll be glad.",
   "est_sec": 5.37,
   "gap_before": 0.84,
   "role": "reply",
   "block": "weather_plans.dlg14"
  },
  {
   "speaker": "user",
   "text": "And tyres?",
   "est_sec": 0.72,
   "gap_before": 1.08,
   "block": "weather_plans.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Check the tread and the pressure. If you live somewhere hilly or snowy, winter tyres are really worth it.",
   "est_sec": 5.99,
   "gap_before": 0.87,
   "role": "reply",
   "block": "weather_plans.dlg14"
  },
  {
   "speaker": "user",
   "text": "My dad says I need a bag of cat litter.",
   "est_sec": 3.2,
   "gap_before": 0.53,
   "event": "distractor",
   "kind": "pause",
   "block": "weather_plans.dlg14"
  },
  {
   "speaker": "user",
   "text": "He was very serious about it.",
   "est_sec": 1.96,
   "gap_before": 1.85,
   "block": "weather_plans.dlg14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "He's right. Sprinkle it under the wheels if you're spinning on ice, it gives the tyres grip.",
   "est_sec": 5.37,
   "gap_before": 0.49,
   "role": "reply",
   "block": "weather_plans.dlg14"
  }
 ]
