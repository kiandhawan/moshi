 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.79,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.49,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "I'm going to my first ever classical concert. When am I supposed to clap?",
   "est_sec": 4.44,
   "gap_before": 0.4,
   "block": "music.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Good question, it confuses lots of people. Generally you clap at the end of a whole piece, not between the movements.",
   "est_sec": 6.61,
   "gap_before": 0.79,
   "role": "reply",
   "block": "music.dlg18"
  },
  {
   "speaker": "user",
   "text": "What's a movement?",
   "est_sec": 1.03,
   "gap_before": 1.03,
   "block": "music.dlg18",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A big piece is often split into sections with short pauses between them. People stay quiet during those pauses.",
   "est_sec": 5.99,
   "gap_before": 0.75,
   "role": "reply",
   "block": "music.dlg18"
  },
  {
   "speaker": "user",
   "text": "Different question. My front door sticks every time it rains. I have to shove it with my shoulder.",
   "est_sec": 5.68,
   "gap_before": 0.75,
   "block": "home_repair.ctx3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "The wood is probably swelling. You could tighten the hinges first or plane down the edge. Where would you like to start?",
   "est_sec": 6.92,
   "gap_before": 1.05,
   "role": "reply",
   "block": "home_repair.ctx3"
  },
  {
   "speaker": "user",
   "text": "Hang on, I need nineteen seconds to think. Then ask me again.",
   "est_sec": 3.82,
   "gap_before": 1.3,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 19,
   "phrasing": "think_instr_20"
  },
  {
   "speaker": "user",
   "text": "Let's see, let's see.",
   "est_sec": 1.34,
   "anchor": {
    "turn": 8,
    "offset": 6.48
   },
   "event": "distractor",
   "kind": "self_talk",
   "phrasing": "self_20"
  },
  {
   "speaker": "moshi",
   "text": "Alright, so for the sticky door, hinges first or straight to planing the edge?",
   "est_sec": 4.44,
   "role": "resume",
   "block": "home_repair.ctx3",
   "anchor": {
    "turn": 8,
    "offset": 19.24
   }
  },
  {
   "speaker": "user",
   "text": "I think I'll just plane it. It's been like this for years.",
   "est_sec": 3.82,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "home_repair.ctx3"
  },
  {
   "speaker": "moshi",
   "text": "Okay. Mark where it rubs, take the door off its hinges, and shave off only a little at a time.",
   "est_sec": 6.3,
   "gap_before": 0.45,
   "role": "followup",
   "block": "home_repair.ctx3"
  }
