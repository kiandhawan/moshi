   "gap_before": 0.84,
   "role": "reply",
   "block": "moving_house.ctx5"
  },
  {
   "speaker": "user",
   "text": "Hmm, wait twenty-one seconds and then ask me again, okay?",
   "est_sec": 3.2,
   "gap_before": 0.39,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 21,
   "phrasing": "think_instr_26"
