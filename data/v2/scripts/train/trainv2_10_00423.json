 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.88,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "I'd like to volunteer on weekends, but I don't know where to start.",
   "est_sec": 4.13,
   "gap_before": 0.37,
   "block": "weekend_plans.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Think about what you enjoy. Animals, outdoors, people, or something practical like fixing things?",
   "est_sec": 4.44,
   "gap_before": 0.39,
   "role": "reply",
   "block": "weekend_plans.dlg12"
  },
  {
   "speaker": "user",
   "text": "Bins go out tonight, so Lerato, can you do the recycling?",
   "est_sec": 3.51,
   "gap_before": 1.27,
   "block": "nq_home_047",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_047",
   "name_pos": "middle",
   "addressee": "Lerato"
  },
  {
   "speaker": "other",
   "text": "Only if you do the glass.",
   "est_sec": 1.96,
   "gap_before": 0.77,
   "block": "nq_home_047"
  },
  {
   "speaker": "user",
   "text": "Outdoors, definitely.",
   "est_sec": 0.72,
   "gap_before": 1.48,
   "block": "weekend_plans.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then look for conservation groups. They often do weekend days planting trees, clearing paths or cleaning up rivers.",
   "est_sec": 5.68,
   "gap_before": 0.55,
   "role": "reply",
   "block": "weekend_plans.dlg12"
  },
  {
   "speaker": "user",
   "text": "Do I need experience?",
   "est_sec": 1.34,
   "gap_before": 1.08,
   "block": "weekend_plans.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Usually not. They'll give you tools and show you what to do. It's a great way to meet people too.",
   "est_sec": 6.3,
   "gap_before": 0.68,
   "role": "reply",
   "block": "weekend_plans.dlg12"
  },
  {
   "speaker": "user",
   "text": "I'm a bit worried about",
   "est_sec": 1.65,
   "gap_before": 0.91,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg12"
  },
  {
   "speaker": "user",
   "text": "committing every weekend.",
   "est_sec": 1.03,
   "gap_before": 2.28,
   "block": "weekend_plans.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Many groups let you drop in when you can. Try one day and see how it feels.",
   "est_sec": 5.37,
   "gap_before": 0.45,
   "role": "reply",
   "block": "weekend_plans.dlg12"
  }
 ]
}
