 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.44,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.68,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "I've always wanted to try pottery. Can you learn it in a weekend?",
   "est_sec": 4.13,
   "gap_before": 0.54,
   "block": "weekend_plans.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You can definitely get a taste. Lots of studios run weekend taster workshops, usually a few hours on the wheel.",
   "est_sec": 6.3,
   "gap_before": 0.36,
   "role": "reply",
   "block": "weekend_plans.dlg11"
  },
  {
   "speaker": "user",
   "text": "Will I make anything decent?",
   "est_sec": 1.65,
   "gap_before": 1.16,
   "block": "weekend_plans.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Probably something wonky, but that's part of the fun. Most people make a little bowl or a cup.",
   "est_sec": 5.68,
   "gap_before": 0.83,
   "role": "reply",
   "block": "weekend_plans.dlg11"
  },
  {
   "speaker": "user",
   "text": "Do I get to",
   "est_sec": 1.34,
   "gap_before": 0.94,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg11"
  },
  {
   "speaker": "user",
   "text": "take it home?",
   "est_sec": 1.03,
   "gap_before": 1.95,
   "block": "weekend_plans.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Usually yes, but not straight away. It needs to dry, be fired, and glazed, so it often takes a few weeks.",
   "est_sec": 6.61,
   "gap_before": 1.14,
   "role": "reply",
   "block": "weekend_plans.dlg11"
  },
  {
   "speaker": "user",
   "text": "Okay, a wonky bowl in a month. I'm in.",
   "est_sec": 2.89,
   "gap_before": 1.07,
   "block": "weekend_plans.dlg11",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Great. Wear clothes you don't mind getting messy, clay goes everywhere.",
   "est_sec": 3.51,
   "gap_before": 0.69,
   "role": "reply",
   "block": "weekend_plans.dlg11"
  }
 ]
