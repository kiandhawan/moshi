 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.67,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.76,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "Hey, quick sanity check. Is it dumb to lease a car?",
   "est_sec": 3.51,
   "gap_before": 0.48,
   "block": "personal_finance.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Not dumb, but it suits some people more than others. Do you like having a new car every few years?",
   "est_sec": 6.3,
   "gap_before": 0.81,
   "role": "reply",
   "block": "personal_finance.dlg31"
  },
  {
   "speaker": "user",
   "text": "I like not worrying about repairs.",
   "est_sec": 1.96,
   "gap_before": 1.27,
   "block": "personal_finance.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Leasing helps with that, since newer cars rarely break. The downside is you never own it, and there are mileage limits.",
   "est_sec": 6.61,
   "gap_before": 0.64,
   "role": "reply",
   "block": "personal_finance.dlg31"
  },
  {
   "speaker": "user",
   "text": "I drive a lot for work.",
   "est_sec": 1.96,
   "gap_before": 1.07,
   "block": "personal_finance.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then watch out for those limits. Going over can get expensive.",
   "est_sec": 3.51,
   "gap_before": 1.01,
   "role": "reply",
   "block": "personal_finance.dlg31"
  },
  {
   "speaker": "user",
   "text": "So buying a used one might be",
   "est_sec": 2.27,
   "gap_before": 0.95,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg31"
  },
  {
   "speaker": "user",
   "text": "smarter for me.",
   "est_sec": 1.03,
   "gap_before": 1.86,
   "block": "personal_finance.dlg31",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Probably, if you drive a lot. A reliable used car with a warranty gives you peace of mind without the mileage cap.",
   "est_sec": 6.92,
   "gap_before": 1.14,
   "role": "reply",
   "block": "personal_finance.dlg31"
  }
 ]
