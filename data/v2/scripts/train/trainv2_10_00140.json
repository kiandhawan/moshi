   "text": "She cancelled, the baby's got a cold.",
   "est_sec": 2.27,
   "gap_before": 0.99,
   "block": "weekend_plans.side3"
  },
  {
   "speaker": "user",
   "text": "Oh no, poor thing. So we're free all day then?",
   "est_sec": 3.2,
   "gap_before": 2.93,
   "event": "distractor",
   "kind": "friend_question",
   "block": "weekend_plans.side3"
  },
