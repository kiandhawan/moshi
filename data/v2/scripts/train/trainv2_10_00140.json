   "gap_before": 0.84,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instruction_v2_37"
  },
  {
   "speaker": "moshi",
   "text": "Okay, no rush.",
   "est_sec": 1.03,
   "gap_before": 0.22,
   "role": "ack",
   "phrasing": "ack_10"
  },
  {
   "speaker": "user",
   "text": "Are we still going to your sister's on Saturday?",
