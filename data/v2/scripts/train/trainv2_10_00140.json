   "text": "Looks like it. We could finally clear out the garage.",
   "est_sec": 3.2,
   "gap_before": 0.88,
   "block": "weekend_plans.side3"
  },
  {
   "speaker": "user",
   "text": "Or we could not do that and go for a long lunch instead.",
   "est_sec": 4.13,
   "gap_before": 2.01,
   "block": "weekend_plans.side3"
