 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.79,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.85,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "My cat has started weeing on the bath mat instead of in her tray.",
   "est_sec": 4.44,
   "gap_before": 0.36,
   "block": "pets.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's frustrating. The first step is a vet visit, because urinary problems are a really common cause.",
   "est_sec": 5.37,
   "gap_before": 1.09,
   "role": "reply",
   "block": "pets.dlg16"
  },
  {
   "speaker": "user",
   "text": "She seems healthy otherwise.",
   "est_sec": 1.34,
   "gap_before": 1.44,
   "block": "pets.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Cats hide pain well, so it's still worth ruling out. If she's fine, then it's usually something about the tray.",
   "est_sec": 6.3,
   "gap_before": 0.32,
   "role": "reply",
   "block": "pets.dlg16"
  },
  {
   "speaker": "user",
   "text": "I did change the litter brand last week.",
   "est_sec": 2.58,
   "gap_before": 0.5,
   "event": "distractor",
   "kind": "pause",
   "block": "pets.dlg16"
  },
  {
   "speaker": "user",
   "text": "Because it was on offer.",
   "est_sec": 1.65,
   "gap_before": 2.41,
   "block": "pets.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That could be it. Cats can be really fussy about texture and smell. Go back to the old one and see if she returns.",
   "est_sec": 7.54,
   "gap_before": 1.1,
   "role": "reply",
   "block": "pets.dlg16"
  },
  {
   "speaker": "user",
   "text": "And should I clean the bath mat with bleach?",
   "est_sec": 2.89,
   "gap_before": 1.24,
   "block": "pets.dlg16",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Use an enzyme cleaner instead. Bleach can smell like urine to cats and might draw her back to the same spot.",
   "est_sec": 6.61,
   "gap_before": 0.79,
   "role": "reply",
   "block": "pets.dlg16"
  }
 ]
}
