 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.61,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.68,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "My rhubarb has these tall stalks with big frilly flower things on top. Is that okay?",
   "est_sec": 5.06,
   "gap_before": 0.3,
   "block": "gardening.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's it trying to flower, which pulls energy away from the stalks. Cut the flower stems off at the base as soon as you see them.",
   "est_sec": 8.16,
   "gap_before": 0.57,
   "role": "reply",
   "block": "gardening.dlg17"
  },
  {
   "speaker": "user",
   "text": "Can I still eat the normal stalks?",
   "est_sec": 2.27,
   "gap_before": 0.31,
   "block": "gardening.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, they're fine. Pull them rather than cutting, give a little twist near the base.",
   "est_sec": 4.75,
   "gap_before": 0.97,
   "role": "reply",
   "block": "gardening.dlg17"
  },
  {
   "speaker": "user",
   "text": "When should I stop picking? I've been",
   "est_sec": 2.27,
   "gap_before": 0.84,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg17"
  },
  {
   "speaker": "user",
   "text": "taking loads.",
   "est_sec": 0.72,
   "gap_before": 2.62,
   "block": "gardening.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Stop around early summer. The plant needs its leaves after that to build up strength for next year.",
   "est_sec": 5.68,
   "gap_before": 1.02,
   "role": "reply",
   "block": "gardening.dlg17"
  },
  {
   "speaker": "user",
   "text": "And the leaves, those are poisonous right?",
   "est_sec": 2.27,
   "gap_before": 1.7,
   "block": "gardening.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, don't eat the leaves. They're fine on the compost heap though.",
   "est_sec": 3.82,
   "gap_before": 0.47,
   "role": "reply",
   "block": "gardening.dlg17"
  }
