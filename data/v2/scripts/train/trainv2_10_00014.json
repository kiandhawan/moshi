 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.47,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.84,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "I played cello until I was eighteen. Now I'm forty and I want to join a community orchestra.",
   "est_sec": 5.68,
   "gap_before": 0.31,
   "block": "music.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's wonderful. Community orchestras love returning players, especially cellists.",
   "est_sec": 2.89,
   "gap_before": 0.35,
   "role": "reply",
   "block": "music.dlg32"
  },
  {
   "speaker": "user",
   "text": "I'm so rusty though.",
   "est_sec": 1.34,
   "gap_before": 0.64,
   "block": "music.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most people are. Spend a few weeks on scales and easy pieces first, just to get your fingers back.",
   "est_sec": 5.99,
   "gap_before": 1.03,
   "role": "reply",
   "block": "music.dlg32"
  },
  {
   "speaker": "user",
   "text": "Should I get lessons again or",
   "est_sec": 1.96,
   "gap_before": 1.0,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg32"
  },
  {
   "speaker": "user",
   "text": "just dive in?",
   "est_sec": 1.03,
   "gap_before": 2.73,
   "block": "music.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "A few lessons can help a lot after a long break. A teacher will spot old habits and get your bowing smooth again.",
   "est_sec": 7.23,
   "gap_before": 0.68,
   "role": "reply",
   "block": "music.dlg32"
  },
  {
   "speaker": "user",
   "text": "And the audition?",
   "est_sec": 1.03,
   "gap_before": 0.64,
   "block": "music.dlg32",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Many community orchestras don't even hold a proper audition. Email them, ask if you can sit in on a rehearsal, and see how it feels.",
   "est_sec": 7.85,
   "gap_before": 0.77,
   "role": "reply",
   "block": "music.dlg32"
  }
 ]
