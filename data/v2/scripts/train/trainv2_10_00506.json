   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "Moshi, I'm turning forty and I kind of don't want a party at all.",
   "est_sec": 4.44,
   "gap_before": 0.52,
   "block": "birthday_party.dlg4",
   "kind": "moshi_name",
   "name_pos": "start",
   "addressee": "Moshi",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's completely okay. Some people prefer something quiet. What would make the day feel good to you?",
   "est_sec": 5.37,
   "gap_before": 0.93,
   "role": "reply",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "user",
   "text": "Wait, what was the last part?",
   "est_sec": 1.96,
