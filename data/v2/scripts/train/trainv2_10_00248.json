 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.66,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.51,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "I'm packing for a week in Greece and I can't decide whether to bring my laptop.",
   "est_sec": 5.06,
   "gap_before": 0.52,
   "block": "travel_planning.ctx9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Is it for work you really need to do, or just in case?",
   "est_sec": 4.13,
   "gap_before": 0.32,
   "role": "reply",
   "block": "travel_planning.ctx9"
  },
  {
   "speaker": "user",
   "text": "Just in case. Probably.",
   "est_sec": 1.34,
   "gap_before": 2.87,
   "block": "travel_planning.ctx9",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then it's mostly about whether you'll actually switch off without it. Would leaving it home be a relief or a worry?",
   "est_sec": 6.61,
   "gap_before": 0.6,
   "role": "reply",
   "block": "travel_planning.ctx9"
  },
  {
   "speaker": "user",
   "text": "Can you give me eleven seconds? Then ask me again.",
   "est_sec": 3.2,
   "gap_before": 1.2,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 11,
   "phrasing": "think_instr_05"
  },
  {
   "speaker": "user",
   "text": "Hmm, decisions, decisions.",
   "est_sec": 1.03,
   "anchor": {
    "turn": 6,
    "offset": 3.33
   },
   "event": "distractor",
   "kind": "self_talk",
   "phrasing": "self_26"
  },
  {
   "speaker": "moshi",
   "text": "Relief or worry, what did you decide?",
   "est_sec": 2.27,
   "role": "resume",
   "block": "travel_planning.ctx9",
   "anchor": {
    "turn": 6,
    "offset": 11.52
   }
  },
  {
   "speaker": "user",
   "text": "Leaving it. My phone is enough.",
   "est_sec": 1.96,
   "gap_before": 0.79,
   "event": "ordinary_request",
   "block": "travel_planning.ctx9"
  },
  {
   "speaker": "moshi",
   "text": "Good for you. Tell your team you're offline and set an out of office before you go.",
   "est_sec": 5.37,
   "gap_before": 1.11,
   "role": "followup",
   "block": "travel_planning.ctx9"
  },
  {
   "speaker": "user",
   "text": "Okay, something else. My headlights have gone all yellow and cloudy. It looks really dodgy at night.",
   "est_sec": 5.37,
   "gap_before": 1.08,
   "block": "cars.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's the plastic lens oxidising from the sun. It also makes the lights dimmer, so it's worth fixing.",
   "est_sec": 5.68,
   "gap_before": 0.31,
   "role": "reply",
   "block": "cars.dlg23"
  },
  {
   "speaker": "user",
   "text": "Do I need new headlights?",
   "est_sec": 1.65,
   "gap_before": 0.48,
   "block": "cars.dlg23",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Usually not. A headlight restoration kit sands the cloudy layer off and polishes it clear, then adds a protective coating.",
   "est_sec": 6.3,
   "gap_before": 0.82,
   "role": "reply",
   "block": "cars.dlg23"
  }
 ]
