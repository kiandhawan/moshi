 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.36,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "Our front path is a sheet of ice. Salt or grit?",
   "est_sec": 3.51,
   "gap_before": 0.46,
   "block": "weather_plans.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Grit is just salt mixed with sand or small stones. Salt melts the ice, grit also adds some grip.",
   "est_sec": 5.99,
   "gap_before": 0.56,
   "role": "reply",
   "block": "weather_plans.dlg20"
  },
  {
   "speaker": "user",
   "text": "I have table salt. Does that work?",
   "est_sec": 2.27,
   "gap_before": 0.65,
   "block": "weather_plans.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It does, for a small area. Sprinkle it thinly before the ice forms, it works best that way.",
   "est_sec": 5.68,
   "gap_before": 0.81,
   "role": "reply",
   "block": "weather_plans.dlg20"
  },
  {
   "speaker": "user",
   "text": "What about hot water?",
   "est_sec": 1.34,
   "gap_before": 0.63,
   "block": "weather_plans.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Avoid it. It melts the ice for a bit, then refreezes, often even slipperier.",
   "est_sec": 4.44,
   "gap_before": 1.2,
   "role": "reply",
   "block": "weather_plans.dlg20"
  },
  {
   "speaker": "user",
   "text": "Oh no, I did that this morning.",
   "est_sec": 2.27,
   "gap_before": 1.37,
   "block": "weather_plans.dlg20",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Easy mistake. Scatter some salt on it now and wear shoes with good soles until it's gone.",
   "est_sec": 5.37,
   "gap_before": 0.48,
   "role": "reply",
   "block": "weather_plans.dlg20"
  }
 ]
}
