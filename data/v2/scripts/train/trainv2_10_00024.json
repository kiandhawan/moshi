 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.49,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "Going uphill is fine, but my knees kill me on the way down.",
   "est_sec": 4.13,
   "gap_before": 0.51,
   "block": "hiking.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "That's really common. Downhill puts a lot more load on the front of the knee.",
   "est_sec": 4.75,
   "gap_before": 0.99,
   "role": "reply",
   "block": "hiking.dlg8"
  },
  {
   "speaker": "user",
   "text": "Is there a trick?",
   "est_sec": 1.34,
   "gap_before": 0.31,
   "block": "hiking.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Take shorter steps, keep your knees slightly bent, and don't lock them. Zigzagging on wide paths helps too.",
   "est_sec": 5.68,
   "gap_before": 0.34,
   "role": "reply",
   "block": "hiking.dlg8"
  },
  {
   "speaker": "user",
   "text": "Hang on, I missed that.",
   "est_sec": 1.65,
   "gap_before": 1.29,
   "block": "hiking.dlg8",
   "kind": "wait_like",
   "phrasing": "waitlike_04",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Of course. Take shorter steps, keep your knees slightly bent, and don't lock them. Zigzagging on wide paths helps too.",
   "est_sec": 6.3,
   "gap_before": 0.83,
   "role": "reply",
   "block": "hiking.dlg8"
  },
  {
   "speaker": "user",
   "text": "My friend swears by poles.",
   "est_sec": 1.65,
   "gap_before": 1.73,
   "block": "hiking.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "She's right. Poles take a good chunk of the strain off your knees on steep descents. Lengthen them a bit before you head down.",
   "est_sec": 7.54,
   "gap_before": 0.98,
   "role": "reply",
   "block": "hiking.dlg8"
  },
  {
   "speaker": "user",
   "text": "Okay. And should I",
   "est_sec": 1.34,
   "gap_before": 1.55,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg8"
  },
  {
   "speaker": "user",
   "text": "be doing exercises at home?",
   "est_sec": 1.65,
   "gap_before": 2.8,
   "block": "hiking.dlg8",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, squats and step downs off a stair build the muscles that protect your knees. A few minutes a day makes a difference within weeks.",
   "est_sec": 7.85,
   "gap_before": 0.39,
   "role": "reply",
   "block": "hiking.dlg8"
  }
