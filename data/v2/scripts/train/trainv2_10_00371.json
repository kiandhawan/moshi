 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.4,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.48,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "I'm hosting brunch and my hollandaise always splits. What am I doing wrong?",
   "est_sec": 4.13,
   "gap_before": 0.26,
   "block": "cooking.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Usually the butter goes in too fast or the bowl gets too hot.",
   "est_sec": 4.13,
   "gap_before": 0.52,
   "role": "reply",
   "block": "cooking.dlg30"
  },
  {
   "speaker": "user",
   "text": "I'm doing it over a pan of simmering water.",
   "est_sec": 2.89,
   "gap_before": 0.54,
   "block": "cooking.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Make sure the bowl isn't touching the water, and keep it at a gentle simmer. Add the melted butter in a very thin stream while whisking.",
   "est_sec": 8.16,
   "gap_before": 0.88,
   "role": "reply",
   "block": "cooking.dlg30"
  },
  {
   "speaker": "user",
   "text": "Hold on, and if it splits anyway, is it ruined?",
   "est_sec": 3.2,
   "gap_before": 2.81,
   "block": "cooking.dlg30",
   "kind": "wait_like",
   "phrasing": "waitlike_14",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "No. Put a fresh egg yolk in a clean bowl and slowly whisk the split sauce into it. It usually comes back.",
   "est_sec": 6.92,
   "gap_before": 0.89,
   "role": "reply",
   "block": "cooking.dlg30"
  },
  {
   "speaker": "user",
   "text": "Oh, that's a relief. Can I make it",
   "est_sec": 2.58,
   "gap_before": 3.18,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg30"
  },
  {
   "speaker": "user",
   "text": "an hour before people arrive?",
   "est_sec": 1.65,
   "gap_before": 1.52,
   "block": "cooking.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's best fresh, but you can keep it warm in a thermos for about an hour.",
   "est_sec": 5.06,
   "gap_before": 1.72,
   "role": "reply",
   "block": "cooking.dlg30"
  },
  {
   "speaker": "user",
   "text": "A thermos. That's genius.",
   "est_sec": 1.34,
   "gap_before": 1.07,
   "block": "cooking.dlg30",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's an old cafe trick. Enjoy the brunch.",
   "est_sec": 2.58,
   "gap_before": 0.61,
   "role": "reply",
   "block": "cooking.dlg30"
  }
 ]
