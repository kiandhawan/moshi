 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.48,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.54,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "My watch keeps talking about zone two training. What even is that?",
   "est_sec": 3.82,
   "gap_before": 0.46,
   "block": "fitness.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It's easy, steady exercise at a low heart rate, where you can still talk in full sentences.",
   "est_sec": 5.37,
   "gap_before": 1.99,
   "role": "reply",
   "block": "fitness.dlg19"
  },
  {
   "speaker": "user",
   "text": "That sounds too easy to do anything.",
   "est_sec": 2.27,
   "gap_before": 0.58,
   "block": "fitness.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "It builds your aerobic base, so your heart and muscles get better at using oxygen. Lots of endurance athletes spend most of their time there.",
   "est_sec": 7.85,
   "gap_before": 0.64,
   "role": "reply",
   "block": "fitness.dlg19"
  },
  {
   "speaker": "user",
   "text": "How long do I have to do it?",
   "est_sec": 2.58,
   "gap_before": 0.7,
   "block": "fitness.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sessions of thirty to sixty minutes, a few times a week, tend to work well.",
   "est_sec": 4.75,
   "gap_before": 0.58,
   "role": "reply",
   "block": "fitness.dlg19"
  },
  {
   "speaker": "user",
   "text": "So I should slow down my runs?",
   "est_sec": 2.27,
   "gap_before": 0.37,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg19"
  },
  {
   "speaker": "user",
   "text": "My ego hates that.",
   "est_sec": 1.34,
   "gap_before": 2.15,
   "block": "fitness.dlg19",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Most of them, yes. Keep one harder session a week for speed. Your ego will recover when you get faster.",
   "est_sec": 6.3,
   "gap_before": 0.34,
   "role": "reply",
   "block": "fitness.dlg19"
  }
 ]
}
