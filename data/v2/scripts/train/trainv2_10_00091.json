 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.65,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I don't get the fare zones on this metro map at all.",
   "est_sec": 3.82,
   "gap_before": 0.46,
   "block": "public_transport.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "They're usually rings around the centre. The more rings you cross, the more you pay.",
   "est_sec": 4.75,
   "gap_before": 0.93,
   "role": "reply",
   "block": "public_transport.dlg12"
  },
  {
   "speaker": "user",
   "text": "So if I live in zone three and work in zone one?",
   "est_sec": 3.82,
   "gap_before": 0.6,
   "block": "public_transport.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "You'd need a ticket covering zones one to three, even if you never stop in zone two.",
   "est_sec": 5.37,
   "gap_before": 1.81,
   "role": "reply",
   "block": "public_transport.dlg12"
  },
  {
   "speaker": "user",
   "text": "Look at this receipt. Selin, did they charge us twice for wine?",
   "est_sec": 3.82,
   "gap_before": 1.42,
   "block": "nq_social_039",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_039",
   "name_pos": "middle",
   "addressee": "Selin"
  },
  {
   "speaker": "user",
   "text": "Even though I",
   "est_sec": 1.03,
   "gap_before": 3.05,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg12"
  },
  {
   "speaker": "user",
   "text": "just pass through it?",
   "est_sec": 1.34,
   "gap_before": 1.54,
   "block": "public_transport.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Yes, annoyingly. The fare is based on the whole area your journey covers, not just the ends.",
   "est_sec": 5.37,
   "gap_before": 1.09,
   "role": "reply",
   "block": "public_transport.dlg12"
  },
  {
   "speaker": "user",
   "text": "What if I get off in zone four by accident?",
   "est_sec": 3.2,
   "gap_before": 0.71,
   "block": "public_transport.dlg12",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Then you'd technically need to pay the difference. Most ticket machines can sort that out on the way out.",
   "est_sec": 5.99,
   "gap_before": 0.36,
   "role": "reply",
   "block": "public_transport.dlg12"
  }
 ]
}
