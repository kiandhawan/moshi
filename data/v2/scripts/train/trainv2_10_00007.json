 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.52,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.3,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "I have something like twenty thousand photos and they're a total mess.",
   "est_sec": 3.82,
   "gap_before": 0.47,
   "block": "photography.ctx3",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Let's tame them. Would you rather organize them by year, or by events like trips and birthdays?",
   "est_sec": 5.37,
   "gap_before": 0.73,
   "role": "reply",
   "block": "photography.ctx3"
  },
  {
   "speaker": "user",
   "text": "Wait twenty-nine seconds, then ask me that again.",
   "est_sec": 2.58,
   "gap_before": 0.39,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 29,
   "phrasing": "think_instr_14"
  },
  {
   "speaker": "user",
   "text": "Hmm, either way, really.",
   "est_sec": 1.34,
   "anchor": {
    "turn": 4,
    "offset": 14.82
   },
   "event": "distractor",
   "kind": "self_talk",
   "phrasing": "self_07"
  },
  {
   "speaker": "moshi",
   "text": "Back to your photo pile. Which system feels right?",
   "est_sec": 2.89,
   "role": "resume",
   "block": "photography.ctx3",
   "anchor": {
    "turn": 4,
    "offset": 29.0
   }
  },
  {
   "speaker": "user",
   "text": "By event, I think. That's how I remember things.",
   "est_sec": 2.89,
   "gap_before": 2.43,
   "event": "ordinary_request",
   "block": "photography.ctx3"
  },
  {
   "speaker": "moshi",
   "text": "Nice. Start each folder name with the year so they still sort in order.",
   "est_sec": 4.44,
   "gap_before": 1.75,
   "role": "followup",
   "block": "photography.ctx3"
  },
  {
