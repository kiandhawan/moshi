 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.75,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.43,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "Why does bread get big and puffy? My dad says there are tiny animals in it.",
   "est_sec": 5.06,
   "gap_before": 0.32,
   "block": "baking.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Your dad's kind of right! Yeast is a tiny living thing, too small to see. It eats the sugar in the dough.",
   "est_sec": 6.92,
   "gap_before": 0.84,
   "role": "reply",
   "block": "baking.dlg17"
  },
  {
   "speaker": "user",
   "text": "Ew. Then what?",
   "est_sec": 1.03,
   "gap_before": 0.7,
   "block": "baking.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "When it eats, it burps out little bubbles of gas. The dough is stretchy, so it traps the bubbles and puffs up like a balloon.",
   "est_sec": 7.85,
   "gap_before": 0.5,
   "role": "reply",
   "block": "baking.dlg17"
  },
  {
   "speaker": "user",
   "text": "Darnell, put the cereal box in the cupboard, please.",
   "est_sec": 2.89,
   "gap_before": 1.37,
   "block": "nq_home_029",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_home_029",
   "name_pos": "start",
   "addressee": "Darnell"
  },
  {
   "speaker": "other",
   "text": "After I finish my bowl.",
   "est_sec": 1.65,
   "gap_before": 0.62,
   "block": "nq_home_029"
  },
  {
   "speaker": "user",
   "text": "Bread burps! Does it",
   "est_sec": 1.34,
   "gap_before": 1.82,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg17"
  },
  {
   "speaker": "user",
   "text": "hurt the yeast when it goes in the oven?",
   "est_sec": 2.89,
   "gap_before": 1.81,
   "block": "baking.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "The oven heat makes the yeast stop working. That's what sets the bubbles in place, so the bread stays fluffy.",
   "est_sec": 6.3,
   "gap_before": 0.31,
   "role": "reply",
   "block": "baking.dlg17"
  },
  {
   "speaker": "user",
   "text": "Can we make bread today?",
   "est_sec": 1.65,
   "gap_before": 1.47,
   "block": "baking.dlg17",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Ask your dad! You could be in charge of the kneading, it's like squishing playdough.",
   "est_sec": 4.75,
   "gap_before": 0.81,
   "role": "reply",
   "block": "baking.dlg17"
  }
 ]
