 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.95,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "It's my younger son's birthday Saturday and his big brother is already sulking about it.",
   "est_sec": 4.75,
   "gap_before": 0.21,
   "block": "birthday_party.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Sibling jealousy around birthdays is so normal. How old are they?",
   "est_sec": 3.51,
   "gap_before": 0.66,
   "role": "reply",
   "block": "birthday_party.dlg28"
  },
  {
   "speaker": "user",
   "text": "Four and seven. The seven year old just keeps saying it's not fair.",
   "est_sec": 4.13,
   "gap_before": 0.84,
   "block": "birthday_party.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Give the older one a job. Something important, like being in charge of the music or handing out the party bags.",
   "est_sec": 6.61,
   "gap_before": 1.19,
   "role": "reply",
   "block": "birthday_party.dlg28"
  },
  {
   "speaker": "user",
   "text": "William, have we paid the electric bill yet?",
   "est_sec": 2.58,
   "gap_before": 0.72,
   "block": "nq_social_023",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_social_023",
   "name_pos": "start",
   "addressee": "William"
  },
  {
   "speaker": "user",
   "text": "Huh. He would love being in charge of something.",
   "est_sec": 2.89,
   "gap_before": 1.84,
   "block": "birthday_party.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "And maybe plan a little one to one time with him on Sunday, so he knows his turn for attention is coming.",
   "est_sec": 6.92,
   "gap_before": 0.92,
   "role": "reply",
   "block": "birthday_party.dlg28"
  },
  {
   "speaker": "user",
   "text": "Like a trip just",
   "est_sec": 1.34,
   "gap_before": 1.24,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg28"
  },
  {
   "speaker": "user",
   "text": "the two of us to the park?",
   "est_sec": 2.27,
   "gap_before": 2.33,
   "block": "birthday_party.dlg28",
   "event": "ordinary_request"
  },
  {
   "speaker": "moshi",
   "text": "Exactly that. It doesn't need to be big, just his.",
   "est_sec": 3.2,
   "gap_before": 0.69,
   "role": "reply",
   "block": "birthday_party.dlg28"
  }
 ]
