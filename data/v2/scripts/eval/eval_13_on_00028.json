 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there, how are you doing today?",
   "est_sec": 2.27,
   "gap_before": 0.76,
   "role": "greeting",
   "phrasing": "greet_12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm doing great.",
   "est_sec": 1.03,
   "gap_before": 0.82,
   "event": "greeting_answer",
   "phrasing": "greet_ans_18"
  },
  {
   "speaker": "user",
   "text": "How high should my monitor be?",
   "est_sec": 1.96,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "block": "home_office.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "The top of the screen should be at about eye level or slightly below. You should be looking a bit down, not up.",
   "est_sec": 7.23,
   "gap_before": 0.51,
   "role": "reply",
   "block": "home_office.dlg1",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Last load, I promise. Min-jun, is the van door locked?",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_eval_044",
   "block": "nq_eval_044",
   "name_pos": "middle",
   "addressee": "Min-jun",
   "est_sec": 3.2,
   "gap_before": 0.71
  },
  {
   "speaker": "other",
   "text": "Locked and checked twice.",
   "block": "nq_eval_044",
   "est_sec": 1.34,
   "gap_before": 0.98
  },
  {
   "speaker": "user",
   "text": "And how far away?",
   "est_sec": 1.34,
   "gap_before": 1.25,
   "event": "ordinary_request",
   "block": "home_office.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Roughly an arm's length. If you have to lean forward to read, make the text bigger rather than moving closer.",
   "est_sec": 6.3,
   "gap_before": 0.36,
   "role": "reply",
   "block": "home_office.dlg1",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I only have a laptop, so",
   "est_sec": 1.96,
   "gap_before": 0.8,
   "event": "distractor",
   "kind": "pause",
   "block": "home_office.dlg1"
  },
  {
   "speaker": "user",
   "text": "it's always too low.",
   "est_sec": 1.34,
   "gap_before": 1.6,
   "event": "ordinary_request",
   "block": "home_office.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "A laptop stand with a separate keyboard and mouse fixes that. Even a stack of books works in a pinch.",
   "est_sec": 6.3,
   "gap_before": 0.33,
   "role": "reply",
   "block": "home_office.dlg1",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Ha, I'll use my old textbooks then.",
