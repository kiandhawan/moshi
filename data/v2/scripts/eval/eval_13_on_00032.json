 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how's your day going?",
   "est_sec": 1.65,
   "gap_before": 0.67,
   "role": "greeting",
   "phrasing": "greet_03",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm fine, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.9,
   "event": "greeting_answer",
   "phrasing": "greet_ans_15"
  },
  {
   "speaker": "user",
   "text": "My laptop keeps overheating. Should I just buy a new one?",
   "est_sec": 3.51,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Not necessarily. Overheating is often just dust in the fans. Have you ever cleaned it?",
   "est_sec": 4.75,
   "gap_before": 1.07,
   "role": "reply",
   "block": "laptop_buying.dlg11",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Henry, any idea where the bottle opener went?",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_eval_018",
   "block": "nq_eval_018",
   "name_pos": "start",
   "addressee": "Henry",
   "est_sec": 2.58,
   "gap_before": 1.49
  },
  {
   "speaker": "other",
   "text": "Your uncle's got it in his pocket.",
   "block": "nq_eval_018",
   "est_sec": 2.27,
   "gap_before": 0.38
  },
  {
   "speaker": "user",
   "text": "Never. It's four years old.",
   "est_sec": 1.65,
   "gap_before": 0.98,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Then a cleaning could make a big difference. A repair shop can do it cheaply if you don't want to open it.",
   "est_sec": 6.92,
   "gap_before": 0.62,
   "role": "reply",
   "block": "laptop_buying.dlg11",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Anything else I can do?",
   "est_sec": 1.65,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Use it on a hard surface, not a bed or a couch. A cheap cooling pad can help too.",
   "est_sec": 5.99,
   "gap_before": 1.08,
   "role": "reply",
   "block": "laptop_buying.dlg11",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And if that doesn't work?",
   "est_sec": 1.65,
   "gap_before": 0.7,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Then it might be the thermal paste drying out. A shop can replace it, it's still way cheaper than a new laptop.",
   "est_sec": 6.92,
   "gap_before": 0.5,
   "role": "reply",
   "block": "laptop_buying.dlg11",
   "reference_only": true
  }
 ],
