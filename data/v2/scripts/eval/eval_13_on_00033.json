   "event": "greeting_answer",
   "phrasing": "greet_ans_12"
  },
  {
   "speaker": "user",
   "text": "Can you help me plan my day? I've got a report, three calls and a pile of emails.",
   "est_sec": 5.68,
   "gap_before": 0.34,
   "event": "ordinary_request",
   "block": "home_office.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Sure. When are the calls?",
   "est_sec": 1.65,
   "gap_before": 0.88,
   "role": "reply",
   "block": "home_office.dlg9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Did you zip the tent all the way up, Chidi?",
   "event": "distractor",
   "kind": "other_name",
   "phrasing": "nq_eval_013",
   "block": "nq_eval_013",
