   "text": "I check it constantly.",
   "est_sec": 1.34,
   "gap_before": 2.12,
   "event": "ordinary_request",
   "block": "home_office.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Close the tab completely and turn off the notifications for the morning. If something's urgent, people will call.",
   "est_sec": 5.68,
   "gap_before": 0.32,
   "role": "reply",
   "block": "home_office.dlg9",
   "reference_only": true
  },
  {
