    {
      "kind": "greeting",
      "start": 0.7,
      "end": 2.06,
      "text": "Good to hear from you. How are you?"
    },
    {
      "kind": "reply",
      "start": 9.05,
      "end": 14.41,
      "text": "Start with a cold cooler. Bring it inside the night before, and if you can, chill it with a bag of ice first."
    },
    {
      "kind": "reply",
      "start": 19.65,
      "end": 24.96,
      "text": "Blocks last much longer. Frozen water bottles work great too, and you can drink them when they melt."
    },
    {
      "kind": "reply",
      "start": 28.78,
      "end": 34.52,
      "text": "Keep drinks in a separate cooler. People open the drinks one constantly, and every opening lets the cold out."
    },
    {
      "kind": "reply",
      "start": 40.08,
      "end": 44.0,
      "text": "Then give him his own cooler. Also keep it in the shade and throw a blanket over it."
    },
    {
      "kind": "reply",
      "start": 47.25,
      "end": 51.73,
      "text": "Leave it in while it's icy, it actually helps. Drain it once it starts getting warm."
    }
  ]
