    {
      "kind": "greeting",
      "start": 0.52,
      "end": 2.13,
      "text": "Hey, what's up? How are you doing?"
    },
    {
      "kind": "reply",
      "start": 8.45,
      "end": 14.36,
      "text": "Drawing is much more a skill than a talent. It's mostly learning to look carefully, and that improves with practice."
    },
    {
      "kind": "reply",
      "start": 17.06,
      "end": 23.04,
      "text": "Simple objects. A mug, an apple, your own hand. Draw what you see, not what you think it looks like."
    },
    {
      "kind": "reply",
      "start": 25.31,
      "end": 30.64,
      "text": "Your brain has symbols for things, like an eye shape. Real eyes look different, so you have to really observe."
    },
    {
      "kind": "reply",
      "start": 37.64,
      "end": 43.26,
      "text": "Then you have the most room to grow. Try ten minutes a day for a month and compare your first and last drawing."
    }
