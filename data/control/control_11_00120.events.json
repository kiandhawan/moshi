  "moshi_turns": [
    {
      "kind": "greeting",
      "start": 0.67,
      "end": 2.48,
      "text": "Hi! How are you doing these days?"
    },
    {
      "kind": "reply",
      "start": 10.16,
      "end": 15.58,
      "text": "The best ones usually believe they're right. Their goal makes some kind of sense, even if their methods are awful."
    },
    {
      "kind": "reply",
      "start": 19.42,
      "end": 26.64,
      "text": "Exactly. When you can almost see their point, they become scary. A cartoon baddie who only wants chaos is harder to care about."
    },
    {
      "kind": "reply",
      "start": 36.95,
      "end": 43.73,
      "text": "Presence matters too. A calm, quiet villain who appears in a few scenes can feel more threatening than one who's shouting all the time."
    },
    {
      "kind": "reply",
      "start": 47.18,
      "end": 52.65,
      "text": "Less is often more. If the hero talks about them before they ever show up, the tension builds on its own."
    }
