  "moshi_turns": [
    {
      "kind": "greeting",
      "start": 0.56,
      "end": 1.64,
      "text": "Hey, how are you doing?"
    },
    {
      "kind": "reply",
      "start": 10.41,
      "end": 16.24,
      "text": "Not hopeless at all. There are free game engines with visual scripting, where you connect blocks instead of writing code."
    },
    {
      "kind": "reply",
      "start": 19.86,
      "end": 27.76,
      "text": "Something tiny. A single screen where you jump over obstacles, or a simple maze. Finishing a small game teaches you more than starting a huge one."
    },
    {
      "kind": "reply",
      "start": 34.37,
      "end": 40.71,
      "text": "Keep that idea in a notebook. Build a few small games first, and you'll have the skills to make that world much better later."
    },
    {
      "kind": "reply",
      "start": 44.85,
      "end": 51.41,
      "text": "A weekend or two, if you follow a beginner tutorial. Game jams are fun too, people make a game in a few days around a theme."
    },
    {
      "kind": "reply",
      "start": 54.266,
      "end": 56.716,
      "text": "That's exactly the right mix. Have fun with it."
    }
  ]
}
