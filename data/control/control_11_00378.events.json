  "moshi_turns": [
    {
      "kind": "greeting",
      "start": 0.39,
      "end": 1.9,
      "text": "Hey! How's everything going?"
    },
    {
      "kind": "reply",
      "start": 8.17,
      "end": 14.73,
      "text": "It's called motion sickness, and it's really common. Your eyes see movement but your body is sitting still, and your brain gets confused."
    },
    {
      "kind": "reply",
      "start": 22.48,
      "end": 29.27,
      "text": "Not doomed. Try increasing the field of view in the settings, so you see more of the world around you. That helps a lot of people."
    },
    {
      "kind": "reply",
      "start": 35.25,
      "end": 43.18,
      "text": "Usually, yes. Turning off motion blur and camera shake helps too. Some games also let you add a little dot in the centre of the screen."
    },
    {
      "kind": "reply",
      "start": 48.37,
      "end": 56.37,
      "text": "It sounds silly, but it gives your eyes a fixed point. Also play in a bright room, sit a bit further from the screen, and take breaks before you feel bad."
    }
  ]
