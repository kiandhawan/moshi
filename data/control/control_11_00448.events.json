    {
      "kind": "greeting",
      "start": 0.52,
      "end": 2.25,
      "text": "Hi! How's life treating you?"
    },
    {
      "kind": "reply",
      "start": 10.36,
      "end": 15.74,
      "text": "That smooth water needs a slow shutter, usually half a second or longer, with the camera on a tripod."
    },
    {
      "kind": "reply",
      "start": 20.81,
      "end": 28.16,
      "text": "Too much light is getting in. In daytime you need an ND filter, basically sunglasses for your lens, so you can keep the shutter open longer."
    },
    {
      "kind": "reply",
      "start": 32.51,
      "end": 39.33,
      "text": "A six stop filter is a good all rounder for waterfalls. Or go on an overcast day, early, when there's less light anyway."
    },
    {
      "kind": "reply",
      "start": 43.26,
      "end": 50.53,
      "text": "Use a two second timer so pressing the button doesn't shake anything, and keep the rocks sharp. The contrast with the smooth water is what makes it work."
    }
  ]
