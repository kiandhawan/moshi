    {
      "kind": "greeting",
      "start": 0.58,
      "end": 2.5,
      "text": "Hey, good to have you here. How are you?"
    },
    {
      "kind": "reply",
      "start": 8.94,
      "end": 13.8,
      "text": "Early morning is usually best. The plants get a drink before the heat and the leaves dry off quickly."
    },
    {
      "kind": "reply",
      "start": 17.35,
      "end": 23.55,
      "text": "Evening is fine too, just water the soil rather than the leaves. Wet leaves overnight can invite mildew and slugs."
    },
    {
      "kind": "reply",
      "start": 32.24,
      "end": 36.277,
      "text": "Then morning watering really would help. Slugs love a damp evening."
    },
    {
      "kind": "reply",
      "start": 41.437,
      "end": 46.527,
      "text": "Less often but deeper is better. A good soak twice a week beats a light sprinkle every day."
    },
    {
      "kind": "reply",
      "start": 50.007,
      "end": 53.347,
      "text": "Even ten minutes with a hose before work is enough for most beds."
    }
  ]
