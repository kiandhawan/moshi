    {
      "kind": "greeting",
      "start": 0.47,
      "end": 2.15,
      "text": "Hi, how are you doing right now?"
    },
    {
      "kind": "reply",
      "start": 9.53,
      "end": 14.19,
      "text": "Ferries can be gentler than you'd think, especially bigger ones. Where you sit makes a huge difference."
    },
    {
      "kind": "reply",
      "start": 17.71,
      "end": 24.14,
      "text": "Low down and in the middle of the boat, where it moves least. Looking out at the horizon helps your brain make sense of the motion."
    },
    {
      "kind": "reply",
      "start": 31.328,
      "end": 37.948,
      "text": "Travel sickness tablets help many people, but some make you drowsy. A pharmacist can suggest one that's fine for work."
    },
    {
      "kind": "reply",
      "start": 41.468,
      "end": 47.168,
      "text": "Fresh air on deck can be better than sitting inside. And eat something light before, an empty stomach often makes it worse."
    },
    {
      "kind": "reply",
      "start": 51.078,
      "end": 54.218,
      "text": "Most regular passengers get used to it after a few weeks."
    }
  ]
