 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.42,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.79,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "What do I do with leftover foreign coins? I've got a jar full from about six countries.",
   "est_sec": 5.37,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "travel_planning.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Banks and exchange offices rarely take coins, only notes. So the options are a bit limited.",
   "est_sec": 5.06,
   "gap_before": 0.33,
   "role": "reply",
   "block": "travel_planning.dlg32"
  },
  {
   "speaker": "user",
   "text": "So they're useless?",
   "est_sec": 1.03,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "travel_planning.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Not quite. Many airlines and airports have charity collection boxes that take any currency.",
   "est_sec": 4.44,
   "gap_before": 0.88,
   "role": "reply",
   "block": "travel_planning.dlg32"
  },
  {
   "speaker": "user",
   "text": "That's nice actually.",
   "est_sec": 1.03,
   "gap_before": 1.16,
   "event": "ordinary_request",
   "block": "travel_planning.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "It is. Or keep them for your next trip to those countries, or give them to a kid who collects coins.",
   "est_sec": 6.61,
   "gap_before": 1.0,
   "role": "reply",
   "block": "travel_planning.dlg32"
  },
  {
   "speaker": "user",
   "text": "My nephew might like that",
   "est_sec": 1.65,
   "gap_before": 0.49,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg32"
  },
  {
   "speaker": "user",
   "text": "he's into maps right now.",
   "est_sec": 1.65,
   "gap_before": 1.81,
   "event": "ordinary_request",
   "block": "travel_planning.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Perfect. He could match each coin to its country on a map.",
   "est_sec": 3.82,
   "gap_before": 0.59,
   "role": "reply",
   "block": "travel_planning.dlg32"
  }
 ]
}
