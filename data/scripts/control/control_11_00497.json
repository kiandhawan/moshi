 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.46,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "Is there a smart way to label boxes?",
   "est_sec": 2.58,
   "gap_before": 0.41,
   "event": "ordinary_request",
   "block": "moving_house.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Colour coding works well. Pick one colour for each room, then put a sticker or tape on every box and on the door of that room.",
   "est_sec": 8.16,
   "gap_before": 0.49,
   "role": "reply",
   "block": "moving_house.dlg29"
  },
  {
   "speaker": "user",
   "text": "Oh, that's nice. So the movers just match colours.",
   "est_sec": 2.89,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "moving_house.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Exactly, no reading needed. Write a short list of contents on the side too, not just the top.",
   "est_sec": 5.68,
   "gap_before": 0.68,
   "role": "reply",
   "block": "moving_house.dlg29"
  },
  {
   "speaker": "user",
   "text": "Why the side?",
   "est_sec": 1.03,
   "gap_before": 0.36,
   "event": "ordinary_request",
   "block": "moving_house.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Boxes get stacked, so you can't see the tops. Numbering them helps you check nothing's missing.",
   "est_sec": 5.06,
   "gap_before": 1.1,
   "role": "reply",
   "block": "moving_house.dlg29"
  },
  {
   "speaker": "user",
   "text": "I'm",
   "est_sec": 0.41,
   "gap_before": 1.07,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg29"
  },
  {
   "speaker": "user",
   "text": "definitely buying coloured tape.",
   "est_sec": 1.34,
   "gap_before": 2.7,
   "event": "ordinary_request",
   "block": "moving_house.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Get a few extra rolls, you'll use more than you think.",
