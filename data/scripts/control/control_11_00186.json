 "est_total_sec": 49.01,
 "est_speech_sec": 39.13,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.38,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.82,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "Should I put sleeves on my cards? My mate says I'm ruining my games without them.",
   "est_sec": 5.06,
   "gap_before": 0.22,
   "event": "ordinary_request",
   "block": "board_games.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "It depends how much you shuffle. Games where you shuffle constantly wear out quickly, so sleeves help a lot there.",
   "est_sec": 6.3,
   "gap_before": 1.05,
   "role": "reply",
   "block": "board_games.dlg6"
  },
  {
   "speaker": "user",
   "text": "Most of mine you barely shuffle.",
   "est_sec": 1.96,
   "gap_before": 0.98,
   "event": "ordinary_request",
   "block": "board_games.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Then you probably don't need them. Clean hands and no drinks on the table do most of the protecting.",
   "est_sec": 5.99,
   "gap_before": 0.8,
   "role": "reply",
   "block": "board_games.dlg6"
  },
  {
   "speaker": "user",
   "text": "He sleeves everything. Even the instructions, nearly.",
   "est_sec": 2.27,
   "gap_before": 1.09,
   "event": "ordinary_request",
   "block": "board_games.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Some people love it, it's part of the hobby. For you, I'd only sleeve your favourite game, or anything that's hard to replace.",
   "est_sec": 7.23,
   "gap_before": 0.77,
   "role": "reply",
   "block": "board_games.dlg6"
  },
  {
   "speaker": "user",
   "text": "Good. Saves me a fortune.",
   "est_sec": 1.65,
   "gap_before": 1.22,
   "event": "ordinary_request",
   "block": "board_games.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "It does add up. And sleeved decks get thicker, sometimes they don't fit back in the box.",
   "est_sec": 5.37,
   "gap_before": 1.05,
   "role": "reply",
   "block": "board_games.dlg6"
  }
 ]
}
