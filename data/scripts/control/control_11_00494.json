 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.32,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.43,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "The clocks go forward on Sunday and I always feel wrecked for a week.",
   "est_sec": 4.44,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "sleep.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "You can soften it. Starting Thursday, go to bed and get up fifteen minutes earlier each day.",
   "est_sec": 5.37,
   "gap_before": 0.78,
   "role": "reply",
   "block": "sleep.dlg11"
  },
  {
   "speaker": "user",
   "text": "Just fifteen minutes?",
   "est_sec": 1.03,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "sleep.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Yes, small steps add up. By Sunday you've shifted most of the hour already.",
   "est_sec": 4.44,
   "gap_before": 0.86,
   "role": "reply",
   "block": "sleep.dlg11"
  },
  {
   "speaker": "user",
   "text": "And on Sunday itself?",
   "est_sec": 1.34,
   "gap_before": 1.11,
   "event": "ordinary_request",
   "block": "sleep.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Get outside in the morning light as soon as you can. It tells your body clock it's a new morning.",
   "est_sec": 6.3,
   "gap_before": 1.02,
   "role": "reply",
   "block": "sleep.dlg11"
  },
  {
   "speaker": "user",
   "text": "I usually stay inside",
   "est_sec": 1.34,
   "gap_before": 1.01,
   "event": "distractor",
   "kind": "pause",
   "block": "sleep.dlg11"
  },
  {
   "speaker": "user",
   "text": "on Sundays and binge something.",
   "est_sec": 1.65,
   "gap_before": 2.3,
   "event": "ordinary_request",
   "block": "sleep.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Then maybe a short walk to get coffee first, then the binge.",
   "est_sec": 3.82,
   "gap_before": 0.93,
   "role": "reply",
   "block": "sleep.dlg11"
  }
 ]
