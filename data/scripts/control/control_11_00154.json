 "est_total_sec": 60.21,
 "est_speech_sec": 46.36,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.73,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.99,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "So my nephew put an avocado stone in water with toothpicks and now it's got a root. What now?",
   "est_sec": 5.99,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "gardening.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "That's a great start. Once the root is a few centimetres long and a shoot appears at the top, it's ready for a pot.",
   "est_sec": 7.54,
   "gap_before": 1.11,
   "role": "reply",
   "block": "gardening.dlg12"
  },
  {
   "speaker": "user",
   "text": "Will it ever make avocados?",
   "est_sec": 1.65,
   "gap_before": 2.37,
   "event": "ordinary_request",
   "block": "gardening.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Honestly, probably not indoors. Trees from stones can take ten years or more and often need warmth we can't give them. But it makes a lovely leafy houseplant.",
   "est_sec": 8.78,
   "gap_before": 0.93,
   "role": "reply",
   "block": "gardening.dlg12"
  },
  {
   "speaker": "user",
   "text": "He's going to be gutted. He wanted guacamole.",
   "est_sec": 2.58,
   "gap_before": 0.99,
   "event": "ordinary_request",
   "block": "gardening.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Maybe sell it to him as a tree he grew himself. Kids usually love watching it shoot up, it can grow really fast.",
   "est_sec": 7.23,
   "gap_before": 0.82,
   "role": "reply",
   "block": "gardening.dlg12"
  },
  {
   "speaker": "user",
   "text": "Fair point. What pot",
   "est_sec": 1.34,
   "gap_before": 0.58,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg12"
  },
  {
   "speaker": "user",
   "text": "should we use, something big?",
   "est_sec": 1.65,
   "gap_before": 2.62,
   "event": "ordinary_request",
   "block": "gardening.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Medium to start, with good drainage. Leave the top half of the stone above the soil, and keep it in a bright spot.",
   "est_sec": 7.23,
   "gap_before": 0.71,
   "role": "reply",
   "block": "gardening.dlg12"
  }
 ]
}
