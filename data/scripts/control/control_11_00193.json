 "est_total_sec": 55.22,
 "est_speech_sec": 41.09,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.72,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.97,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "I rent a basement flat. One small north facing window. Can I grow herbs at all?",
   "est_sec": 5.06,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "gardening.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Some, yes. Mint, parsley and chives handle lower light better than sunny herbs like basil or rosemary.",
   "est_sec": 5.37,
   "gap_before": 0.42,
   "role": "reply",
   "block": "gardening.dlg29"
  },
  {
   "speaker": "user",
   "text": "Basil was the one I wanted, of course.",
   "est_sec": 2.58,
   "gap_before": 1.5,
   "event": "ordinary_request",
   "block": "gardening.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Of course. You could grow basil under a small clip on grow light. They're cheap now, and it makes a huge difference.",
   "est_sec": 6.92,
   "gap_before": 0.77,
   "role": "reply",
   "block": "gardening.dlg29"
  },
  {
   "speaker": "user",
   "text": "Does it need to be on all day?",
   "est_sec": 2.58,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "gardening.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "About twelve to fourteen hours. A plug timer makes it effortless.",
   "est_sec": 3.51,
   "gap_before": 0.58,
   "role": "reply",
   "block": "gardening.dlg29"
  },
  {
   "speaker": "user",
   "text": "Okay, so chives and parsley on the sill, basil under the light. Do I",
   "est_sec": 4.44,
   "gap_before": 2.46,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg29"
  },
  {
   "speaker": "user",
   "text": "buy seeds or plants?",
   "est_sec": 1.34,
   "gap_before": 2.5,
   "event": "ordinary_request",
   "block": "gardening.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "For basil, honestly, a supermarket pot works. Split it into three or four clumps and repot them, they'll grow much better.",
   "est_sec": 6.61,
   "gap_before": 1.98,
   "role": "reply",
   "block": "gardening.dlg29"
  }
 ]
}
