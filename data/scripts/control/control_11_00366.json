 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.53,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.6,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "How do I actually read a textbook chapter? I get to the end and remember nothing.",
   "est_sec": 5.06,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "studying.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Try reading it in three passes. First, skim the headings, pictures and summary, just for two minutes.",
   "est_sec": 5.37,
   "gap_before": 1.13,
   "role": "reply",
   "block": "studying.dlg13"
  },
  {
   "speaker": "user",
   "text": "Then read it properly?",
   "est_sec": 1.34,
   "gap_before": 1.36,
   "event": "ordinary_request",
   "block": "studying.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Then read it, but stop after each section and say out loud, in your own words, what it was about.",
   "est_sec": 6.3,
   "gap_before": 1.03,
   "role": "reply",
   "block": "studying.dlg13"
  },
  {
   "speaker": "user",
   "text": "Out loud, alone in my room? I'll feel ridiculous.",
   "est_sec": 2.89,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "block": "studying.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Whisper it if you like. Explaining it to yourself is what makes it stick.",
   "est_sec": 4.44,
   "gap_before": 1.09,
   "role": "reply",
   "block": "studying.dlg13"
  },
  {
   "speaker": "user",
   "text": "And the third pass?",
   "est_sec": 1.34,
   "gap_before": 2.33,
   "event": "ordinary_request",
   "block": "studying.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Close the book and jot down everything you remember. Then check what you missed. That's where the learning really happens.",
   "est_sec": 6.3,
   "gap_before": 0.96,
   "role": "reply",
   "block": "studying.dlg13"
  }
 ]
}
