 "est_total_sec": 62.05,
 "est_speech_sec": 45.63,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.61,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "I've just retired and I'd love to see the country by train. Where would you even start?",
   "est_sec": 5.37,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "public_transport.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "What a lovely plan. Scenic routes through mountains or along the coast are a good place to begin.",
   "est_sec": 5.68,
   "gap_before": 1.5,
   "role": "reply",
   "block": "public_transport.dlg23"
  },
  {
   "speaker": "user",
   "text": "I'm not in a hurry at all.",
   "est_sec": 2.27,
   "gap_before": 1.19,
   "event": "ordinary_request",
   "block": "public_transport.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Then slow regional lines are your friend. They stop in small towns, and you can break the journey wherever you like.",
   "est_sec": 6.61,
   "gap_before": 0.7,
   "role": "reply",
   "block": "public_transport.dlg23"
  },
  {
   "speaker": "user",
   "text": "My wife likes",
   "est_sec": 1.03,
   "gap_before": 0.47,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg23"
  },
  {
   "speaker": "user",
   "text": "comfort, though. She won't rough it.",
   "est_sec": 1.96,
   "gap_before": 1.74,
   "event": "ordinary_request",
   "block": "public_transport.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Then mix it up. Take the slow scenic line by day, and book a nice hotel each evening. Some countries even have rail passes for older travellers.",
   "est_sec": 8.47,
   "gap_before": 1.98,
   "role": "reply",
   "block": "public_transport.dlg23"
  },
  {
   "speaker": "user",
   "text": "A pass sounds useful.",
   "est_sec": 1.34,
   "gap_before": 3.27,
   "event": "ordinary_request",
   "block": "public_transport.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "It can be great value if you're taking lots of trains in a few weeks. Shall I explain how they usually work?",
   "est_sec": 6.92,
   "gap_before": 0.87,
   "role": "reply",
   "block": "public_transport.dlg23"
  },
  {
   "speaker": "user",
   "text": "Yes please, another time.",
   "est_sec": 1.34,
   "gap_before": 1.23,
   "event": "ordinary_request",
   "block": "public_transport.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Of course. Enjoy planning it.",
   "est_sec": 1.65,
   "gap_before": 0.42,
   "role": "reply",
   "block": "public_transport.dlg23"
  }
 ]
}
