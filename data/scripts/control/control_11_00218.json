 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.6,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.75,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "Clear skies are forecast on Saturday night. I want to go stargazing.",
   "est_sec": 3.82,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Brilliant. Get away from town lights if you can, even a half hour drive makes a huge difference.",
   "est_sec": 5.68,
   "gap_before": 0.88,
   "role": "reply",
   "block": "weekend_plans.dlg20"
  },
  {
   "speaker": "user",
   "text": "Do I need a telescope?",
   "est_sec": 1.65,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "No need. Your eyes are great for a start, and binoculars are a lovely bonus.",
   "est_sec": 4.75,
   "gap_before": 0.79,
   "role": "reply",
   "block": "weekend_plans.dlg20"
  },
  {
   "speaker": "user",
   "text": "How long until I",
   "est_sec": 1.34,
   "gap_before": 1.14,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg20"
  },
  {
   "speaker": "user",
   "text": "actually see stuff?",
   "est_sec": 1.03,
   "gap_before": 2.38,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Give your eyes around twenty minutes to adjust. Avoid looking at your phone screen, or use red light mode if it has one.",
   "est_sec": 7.23,
   "gap_before": 0.57,
   "role": "reply",
   "block": "weekend_plans.dlg20"
  },
  {
   "speaker": "user",
   "text": "And is the moon a problem?",
   "est_sec": 1.96,
   "gap_before": 0.9,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "A bright moon washes out faint stars. Check the moon phase, a thin crescent or new moon is ideal.",
   "est_sec": 5.99,
   "gap_before": 1.15,
   "role": "reply",
   "block": "weekend_plans.dlg20"
  }
 ]
}
