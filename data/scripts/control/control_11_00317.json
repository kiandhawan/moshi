 "est_total_sec": 53.88,
 "est_speech_sec": 44.19,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.67,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "I found a box of my old game cartridges in my mum's loft. Are they worth anything?",
   "est_sec": 5.37,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "video_games.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Some can be! It depends on the console, which games, and their condition. Do you still have the boxes and manuals?",
   "est_sec": 6.61,
   "gap_before": 0.94,
   "role": "reply",
   "block": "video_games.dlg10"
  },
  {
   "speaker": "user",
   "text": "A few have boxes. Most are just the cartridges.",
   "est_sec": 2.89,
   "gap_before": 0.76,
   "event": "ordinary_request",
   "block": "video_games.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Loose cartridges of common games usually sell for a little. Rare titles or complete boxed ones can be worth a lot more.",
   "est_sec": 6.92,
   "gap_before": 0.4,
   "role": "reply",
   "block": "video_games.dlg10"
  },
  {
   "speaker": "user",
   "text": "How do I find out",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg10"
  },
  {
   "speaker": "user",
   "text": "which ones are rare?",
   "est_sec": 1.34,
   "gap_before": 1.53,
   "event": "ordinary_request",
   "block": "video_games.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Search for each title with the word sold on auction sites. Sold prices tell you what people actually pay, not what sellers hope for.",
   "est_sec": 7.54,
   "gap_before": 0.39,
   "role": "reply",
   "block": "video_games.dlg10"
  },
  {
   "speaker": "user",
   "text": "I might just keep them, honestly. Nostalgia.",
   "est_sec": 2.27,
   "gap_before": 1.2,
   "event": "ordinary_request",
   "block": "video_games.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "That's a lovely reason too. If you do keep them, store them somewhere dry and cool, not back in a hot loft.",
   "est_sec": 6.92,
   "gap_before": 0.72,
   "role": "reply",
   "block": "video_games.dlg10"
  }
 ]
}
