   "est_sec": 1.03,
   "gap_before": 0.5,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "My cat wakes me up at five every day screaming for breakfast.",
   "est_sec": 3.82,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "sleep.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "She's trained you well. Cats learn quickly that yowling gets food.",
   "est_sec": 3.51,
   "gap_before": 0.38,
   "role": "reply",
   "block": "sleep.dlg27"
  },
  {
   "speaker": "user",
   "text": "So how do I untrain",
   "est_sec": 1.65,
   "gap_before": 0.55,
   "event": "distractor",
   "kind": "pause",
   "block": "sleep.dlg27"
  },
  {
