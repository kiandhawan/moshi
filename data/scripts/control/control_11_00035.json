   "text": "her?",
   "est_sec": 0.41,
   "gap_before": 1.78,
   "event": "ordinary_request",
   "block": "sleep.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Don't feed her straight after the yowling, even if it's hard. Wait until your usual time.",
