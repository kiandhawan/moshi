   "gap_before": 2.58,
   "event": "ordinary_request",
   "block": "sleep.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "For a few days, yes. An automatic feeder set for five can also help, she starts waiting for the machine instead of you.",
   "est_sec": 7.23,
   "gap_before": 0.66,
   "role": "reply",
   "block": "sleep.dlg27"
  },
  {
