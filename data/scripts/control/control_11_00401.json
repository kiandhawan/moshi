 "est_total_sec": 51.07,
 "est_speech_sec": 41.09,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.75,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.58,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "My son keeps telling me to track my hikes on an app. I don't see the point.",
   "est_sec": 5.37,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "hiking.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "You don't need to. But some people enjoy seeing their routes on a map and how far they've gone over a year.",
   "est_sec": 6.92,
   "gap_before": 0.79,
   "role": "reply",
   "block": "hiking.dlg32"
  },
  {
   "speaker": "user",
   "text": "I've been walking these hills for forty years without a phone.",
   "est_sec": 3.51,
   "gap_before": 0.64,
   "event": "ordinary_request",
   "block": "hiking.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "That's a lot of knowledge in your head. An app won't replace that.",
   "est_sec": 4.13,
   "gap_before": 0.84,
   "role": "reply",
   "block": "hiking.dlg32"
  },
  {
   "speaker": "user",
   "text": "So what's he on about?",
   "est_sec": 1.65,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "hiking.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Probably safety. Some apps let you share your location live with family, so they know you're okay if you're out alone.",
   "est_sec": 6.61,
   "gap_before": 0.79,
   "role": "reply",
   "block": "hiking.dlg32"
  },
  {
   "speaker": "user",
   "text": "Hm. That might stop",
   "est_sec": 1.34,
   "gap_before": 0.65,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg32"
  },
  {
   "speaker": "user",
   "text": "his mother worrying, I suppose.",
   "est_sec": 1.65,
   "gap_before": 1.69,
   "event": "ordinary_request",
   "block": "hiking.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "That might be the real reason. You could just turn it on for solo walks and ignore the rest.",
   "est_sec": 5.99,
   "gap_before": 0.85,
   "role": "reply",
   "block": "hiking.dlg32"
  }
 ]
}
