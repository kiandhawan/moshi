 "est_total_sec": 50.49,
 "est_speech_sec": 37.99,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.53,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.88,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "Should I warn my neighbours about a party? It's a Saturday, not huge.",
   "est_sec": 4.13,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "birthday_party.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "A quick heads up is always a good idea. It turns a possible complaint into goodwill.",
   "est_sec": 5.06,
   "gap_before": 0.68,
   "role": "reply",
   "block": "birthday_party.dlg19"
  },
  {
   "speaker": "user",
   "text": "What do I even say?",
   "est_sec": 1.65,
   "gap_before": 1.29,
   "event": "ordinary_request",
   "block": "birthday_party.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Just a short note with the date, a rough end time, and your number in case it gets too loud.",
   "est_sec": 6.3,
   "gap_before": 1.04,
   "role": "reply",
   "block": "birthday_party.dlg19"
  },
  {
   "speaker": "user",
   "text": "Do I invite them? I barely know the guy downstairs",
   "est_sec": 3.2,
   "gap_before": 0.31,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg19"
  },
  {
   "speaker": "user",
   "text": "and he seems kind of grumpy.",
   "est_sec": 1.96,
   "gap_before": 2.92,
   "event": "ordinary_request",
   "block": "birthday_party.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Inviting them is a nice touch even if they won't come. People complain far less about a party they were invited to.",
   "est_sec": 6.92,
   "gap_before": 1.15,
   "role": "reply",
   "block": "birthday_party.dlg19"
  },
  {
   "speaker": "user",
   "text": "Ha, sneaky.",
   "est_sec": 0.72,
   "gap_before": 1.35,
   "event": "ordinary_request",
   "block": "birthday_party.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Friendly, not sneaky. And try to move things indoors and quieter after eleven.",
   "est_sec": 4.13,
   "gap_before": 0.4,
   "role": "reply",
   "block": "birthday_party.dlg19"
  }
 ]
}
