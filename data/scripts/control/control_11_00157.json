 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.71,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.42,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "I just moved into a block of flats and I don't know a single neighbour.",
   "est_sec": 4.75,
   "gap_before": 0.34,
   "event": "ordinary_request",
   "block": "moving_house.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Pretty normal in flats. A quick hello in the corridor or lift is a fine start.",
   "est_sec": 5.06,
   "gap_before": 0.49,
   "role": "reply",
   "block": "moving_house.dlg8"
  },
  {
   "speaker": "user",
   "text": "I'm quite shy.",
   "est_sec": 1.03,
   "gap_before": 0.3,
   "event": "ordinary_request",
   "block": "moving_house.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Then keep it tiny. Hi, I've just moved into number twelve, is enough. Most people are happy to be friendly back.",
   "est_sec": 6.61,
   "gap_before": 0.32,
   "role": "reply",
   "block": "moving_house.dlg8"
  },
  {
   "speaker": "user",
   "text": "Is it weird to",
   "est_sec": 1.34,
   "gap_before": 0.49,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg8"
  },
  {
   "speaker": "user",
   "text": "leave a note under doors?",
   "est_sec": 1.65,
   "gap_before": 2.07,
   "event": "ordinary_request",
   "block": "moving_house.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Not weird in the slightest. A short friendly note introducing yourself is lovely, especially if you mention being shy about knocking.",
   "est_sec": 6.61,
   "gap_before": 0.95,
   "role": "reply",
   "block": "moving_house.dlg8"
  },
  {
   "speaker": "user",
   "text": "Maybe with biscuits.",
   "est_sec": 1.03,
   "gap_before": 3.24,
   "event": "ordinary_request",
   "block": "moving_house.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Biscuits always help. You'll probably get invited for tea.",
   "est_sec": 2.89,
   "gap_before": 0.77,
   "role": "reply",
   "block": "moving_house.dlg8"
  }
 ]
}
