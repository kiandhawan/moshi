 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.47,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.98,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "I'm thinking of doing a little day trip on Sunday. Somewhere I can get to by train.",
   "est_sec": 5.37,
   "gap_before": 0.32,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Sounds fun. Do you prefer the seaside, a historic town, or countryside walks?",
   "est_sec": 4.13,
   "gap_before": 0.59,
   "role": "reply",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "user",
   "text": "Seaside, I think. I haven't seen the sea in ages.",
   "est_sec": 3.2,
   "gap_before": 1.26,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Then pick a coastal town within about two hours by train. Leave early so you get a full day there.",
   "est_sec": 6.3,
   "gap_before": 0.89,
   "role": "reply",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "user",
   "text": "What if the weather's bad?",
   "est_sec": 1.65,
   "gap_before": 2.01,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Seaside towns are still nice in grey weather. A cozy cafe, the pier, maybe an aquarium if there's one.",
   "est_sec": 5.99,
   "gap_before": 0.36,
   "role": "reply",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "user",
   "text": "Actually, I might",
   "est_sec": 1.03,
   "gap_before": 1.11,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "user",
   "text": "bring my sister along.",
   "est_sec": 1.34,
   "gap_before": 1.53,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Even better. Check if there's a two together railcard or group ticket, it can save you a lot.",
   "est_sec": 5.68,
   "gap_before": 0.74,
   "role": "reply",
   "block": "weekend_plans.dlg3"
  }
 ]
}
