 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.6,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.55,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "Is a high yield savings account actually worth it or is it a gimmick?",
   "est_sec": 4.44,
   "gap_before": 0.25,
   "event": "ordinary_request",
   "block": "personal_finance.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "It's real. Online banks often pay noticeably more interest because they have lower costs.",
   "est_sec": 4.44,
   "gap_before": 1.39,
   "role": "reply",
   "block": "personal_finance.dlg24"
  },
  {
   "speaker": "user",
   "text": "Is my money safe there?",
   "est_sec": 1.65,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "personal_finance.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "If the bank is covered by your country's deposit protection scheme, your money is protected up to a certain limit.",
   "est_sec": 6.3,
   "gap_before": 0.43,
   "role": "reply",
   "block": "personal_finance.dlg24"
  },
  {
   "speaker": "user",
   "text": "Wait, are you sure about that?",
   "est_sec": 1.96,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_08",
   "block": "personal_finance.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "Hmm, I believe it is. Which part doesn't sound right?",
   "est_sec": 3.2,
   "gap_before": 0.8,
   "role": "reply",
   "block": "personal_finance.dlg24"
  },
  {
   "speaker": "user",
   "text": "How do I know if it's covered?",
   "est_sec": 2.27,
   "gap_before": 0.94,
   "event": "ordinary_request",
   "block": "personal_finance.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "The bank usually says so clearly on its website. You can also check the official regulator's list.",
   "est_sec": 5.37,
   "gap_before": 0.56,
   "role": "reply",
   "block": "personal_finance.dlg24"
  },
  {
   "speaker": "user",
   "text": "And if rates drop?",
   "est_sec": 1.34,
   "gap_before": 1.32,
   "event": "ordinary_request",
   "block": "personal_finance.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "Then the interest drops too, it's variable. But it'll usually still beat a normal current account.",
   "est_sec": 5.06,
   "gap_before": 2.0,
   "role": "reply",
   "block": "personal_finance.dlg24"
  }
 ]
}
