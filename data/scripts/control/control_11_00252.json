 "est_total_sec": 58.54,
 "est_speech_sec": 44.81,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.53,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.64,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "My partner's family plays mahjong every New Year and I don't want to embarrass myself.",
   "est_sec": 4.75,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "board_games.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "That's a lovely thing to learn for them. The basic idea is collecting sets of tiles, a bit like rummy with tiles.",
   "est_sec": 6.92,
   "gap_before": 0.4,
   "role": "reply",
   "block": "board_games.dlg31"
  },
  {
   "speaker": "user",
   "text": "Like sets of three?",
   "est_sec": 1.34,
   "gap_before": 2.65,
   "event": "ordinary_request",
   "block": "board_games.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Yes, mostly sets of three matching or in a row, plus one pair. You take and throw away a tile each turn until your hand is complete.",
   "est_sec": 8.47,
   "gap_before": 0.93,
   "role": "reply",
   "block": "board_games.dlg31"
  },
  {
   "speaker": "user",
   "text": "There are so many tiles with symbols I can't read.",
   "est_sec": 3.2,
   "gap_before": 1.07,
   "event": "ordinary_request",
   "block": "board_games.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Learn the three suits first, dots, bamboo and characters. The numbers on the character tiles are the trickiest, a cheat sheet helps.",
   "est_sec": 6.92,
   "gap_before": 1.19,
   "role": "reply",
   "block": "board_games.dlg31"
  },
  {
   "speaker": "user",
   "text": "Will they mind if",
   "est_sec": 1.34,
   "gap_before": 1.04,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg31"
  },
  {
   "speaker": "user",
   "text": "I bring a cheat sheet?",
   "est_sec": 1.65,
   "gap_before": 2.79,
   "event": "ordinary_request",
   "block": "board_games.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Most families love that you're trying. Ask your partner which rules they use, because they vary a lot between regions.",
   "est_sec": 6.3,
   "gap_before": 0.68,
   "role": "reply",
   "block": "board_games.dlg31"
  }
 ]
}
