 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.38,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "My game box is a disaster. All the cards and tokens are mixed together.",
   "est_sec": 4.44,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "board_games.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Small zip bags are the cheapest fix. One bag per type of piece, and setup gets much quicker.",
   "est_sec": 5.68,
   "gap_before": 1.01,
   "role": "reply",
   "block": "board_games.dlg3"
  },
  {
   "speaker": "user",
   "text": "Some people buy",
   "est_sec": 1.03,
   "gap_before": 0.86,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg3"
  },
  {
   "speaker": "user",
   "text": "those fancy wooden inserts, right?",
   "est_sec": 1.65,
   "gap_before": 1.83,
   "event": "ordinary_request",
   "block": "board_games.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Yes, they're nice for games you play a lot. For everything else, bags or little plastic boxes do the job.",
   "est_sec": 6.3,
   "gap_before": 0.85,
   "role": "reply",
   "block": "board_games.dlg3"
  },
  {
   "speaker": "user",
   "text": "What about cards getting worn out?",
   "est_sec": 1.96,
   "gap_before": 0.76,
   "event": "ordinary_request",
   "block": "board_games.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Card sleeves protect them. They're worth it for games where you shuffle a lot.",
   "est_sec": 4.44,
   "gap_before": 0.89,
   "role": "reply",
   "block": "board_games.dlg3"
  },
  {
   "speaker": "user",
   "text": "Okay, I'll start with the bags this weekend.",
   "est_sec": 2.58,
   "gap_before": 1.49,
   "event": "ordinary_request",
   "block": "board_games.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Good plan. Label each bag and your future self will thank you.",
   "est_sec": 3.82,
   "gap_before": 0.36,
   "role": "reply",
   "block": "board_games.dlg3"
  }
 ]
}
