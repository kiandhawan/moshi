 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.6,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.77,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "My birthday is on Christmas Eve, and every year it just disappears into Christmas.",
   "est_sec": 4.44,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "birthday_party.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "That's really common for December birthdays. Have you ever tried celebrating on a different day?",
   "est_sec": 4.75,
   "gap_before": 0.61,
   "role": "reply",
   "block": "birthday_party.dlg26"
  },
  {
   "speaker": "user",
   "text": "My family thinks that's weird.",
   "est_sec": 1.65,
   "gap_before": 2.39,
   "event": "ordinary_request",
   "block": "birthday_party.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "It isn't. Plenty of people pick a half birthday in June, when nobody's busy and the weather's better.",
   "est_sec": 5.68,
   "gap_before": 0.4,
   "role": "reply",
   "block": "birthday_party.dlg26"
  },
  {
   "speaker": "user",
   "text": "A half birthday. That sounds a bit childish though.",
   "est_sec": 2.89,
   "gap_before": 1.1,
   "event": "ordinary_request",
   "block": "birthday_party.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Call it a summer party then. Same idea, no explaining needed.",
   "est_sec": 3.51,
   "gap_before": 0.91,
   "role": "reply",
   "block": "birthday_party.dlg26"
  },
  {
   "speaker": "user",
   "text": "I like that. And on the actual day",
   "est_sec": 2.58,
   "gap_before": 1.32,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg26"
  },
  {
   "speaker": "user",
   "text": "just let it be Christmas?",
   "est_sec": 1.65,
   "gap_before": 1.93,
   "event": "ordinary_request",
   "block": "birthday_party.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "You could ask for one small thing that's just yours, like a birthday breakfast before the Christmas chaos starts.",
   "est_sec": 5.99,
   "gap_before": 0.69,
   "role": "reply",
   "block": "birthday_party.dlg26"
  }
 ]
}
