 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.33,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.68,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "Is it a good idea to work out with a hangover? Asking for, um, me.",
   "est_sec": 4.75,
   "gap_before": 0.21,
   "event": "ordinary_request",
   "block": "fitness.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Ha. Light exercise can make you feel better, but a hard workout is not a great plan.",
   "est_sec": 5.37,
   "gap_before": 1.08,
   "role": "reply",
   "block": "fitness.dlg30"
  },
  {
   "speaker": "user",
   "text": "What counts as light?",
   "est_sec": 1.34,
   "gap_before": 1.37,
   "event": "ordinary_request",
   "block": "fitness.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "A gentle walk or some easy stretching. Skip heavy lifting and high intensity stuff today.",
   "est_sec": 4.75,
   "gap_before": 0.75,
   "role": "reply",
   "block": "fitness.dlg30"
  },
  {
   "speaker": "user",
   "text": "I was going to do a spin class.",
   "est_sec": 2.58,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "fitness.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Probably not the day for it. You're likely dehydrated, and intense sweating makes that worse.",
   "est_sec": 4.75,
   "gap_before": 0.53,
   "role": "reply",
   "block": "fitness.dlg30"
  },
  {
   "speaker": "user",
   "text": "Water and a walk then. Maybe",
   "est_sec": 1.96,
   "gap_before": 0.65,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg30"
  },
  {
   "speaker": "user",
   "text": "some toast first.",
   "est_sec": 1.03,
   "gap_before": 2.2,
   "event": "ordinary_request",
   "block": "fitness.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Good plan. Drink plenty of water and maybe something with salt in it.",
   "est_sec": 4.13,
   "gap_before": 1.12,
   "role": "reply",
   "block": "fitness.dlg30"
  }
