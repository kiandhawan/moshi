 "est_total_sec": 54.72,
 "est_speech_sec": 43.26,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.44,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.79,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "Petrol's so expensive now. I'm retired and I want to squeeze every mile out of a tank.",
   "est_sec": 5.37,
   "gap_before": 0.26,
   "event": "ordinary_request",
   "block": "cars.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "There's quite a lot you can do. Smooth driving is the biggest one, accelerating gently and anticipating stops so you brake less.",
   "est_sec": 6.92,
   "gap_before": 0.42,
   "role": "reply",
   "block": "cars.dlg17"
  },
  {
   "speaker": "user",
   "text": "I'm a pretty calm driver already.",
   "est_sec": 1.96,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "cars.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Then check the tyre pressures monthly, soft tyres use more fuel. And take any roof box or bike rack off when you're not using it.",
   "est_sec": 7.85,
   "gap_before": 1.41,
   "role": "reply",
   "block": "cars.dlg17"
  },
  {
   "speaker": "user",
   "text": "I've had a roof box on",
   "est_sec": 1.96,
   "gap_before": 1.56,
   "event": "distractor",
   "kind": "pause",
   "block": "cars.dlg17"
  },
  {
   "speaker": "user",
   "text": "since the summer.",
   "est_sec": 1.03,
   "gap_before": 2.42,
   "event": "ordinary_request",
   "block": "cars.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "That's probably costing you a fair bit, they create a lot of drag. Also clear heavy stuff out of the boot.",
   "est_sec": 6.61,
   "gap_before": 0.88,
   "role": "reply",
   "block": "cars.dlg17"
  },
  {
   "speaker": "user",
   "text": "What about the air conditioning?",
   "est_sec": 1.65,
   "gap_before": 0.89,
   "event": "ordinary_request",
   "block": "cars.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "At low speeds, windows down is usually cheaper. On the motorway, windows up with air con is better, because open windows add drag.",
   "est_sec": 7.23,
   "gap_before": 0.31,
   "role": "reply",
   "block": "cars.dlg17"
  }
 ]
}
