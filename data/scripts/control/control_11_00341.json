 "est_total_sec": 56.64,
 "est_speech_sec": 43.46,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.92,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "My four year old won't eat anything green. Not even peas.",
   "est_sec": 3.51,
   "gap_before": 0.34,
   "event": "ordinary_request",
   "block": "cooking.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Very common at that age. Hiding veg in sauces can help, but so can letting him see the green stuff over and over without pressure.",
   "est_sec": 7.85,
   "gap_before": 1.03,
   "role": "reply",
   "block": "cooking.dlg14"
  },
  {
   "speaker": "user",
   "text": "Hiding where, though?",
   "est_sec": 1.03,
   "gap_before": 0.62,
   "event": "ordinary_request",
   "block": "cooking.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Blend spinach or courgette into a tomato pasta sauce. Grated carrot disappears in meatballs.",
   "est_sec": 4.44,
   "gap_before": 0.93,
   "role": "reply",
   "block": "cooking.dlg14"
  },
  {
   "speaker": "user",
   "text": "He does love meatballs.",
   "est_sec": 1.34,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "cooking.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Perfect then. You could even let him roll them with you, kids are more likely to eat what they've made.",
   "est_sec": 6.3,
   "gap_before": 0.99,
   "role": "reply",
   "block": "cooking.dlg14"
  },
  {
   "speaker": "user",
   "text": "And the not pressuring part? Because",
   "est_sec": 1.96,
   "gap_before": 1.13,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg14"
  },
  {
   "speaker": "user",
   "text": "honestly I've been begging.",
   "est_sec": 1.34,
   "gap_before": 1.91,
   "event": "ordinary_request",
   "block": "cooking.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Put a tiny bit of green on his plate and say nothing about it. Eat yours happily. It can take ten or fifteen tries before they accept something new.",
   "est_sec": 9.09,
   "gap_before": 0.57,
   "role": "reply",
   "block": "cooking.dlg14"
  },
  {
   "speaker": "user",
   "text": "Fifteen. Wow. Okay.",
   "est_sec": 1.03,
   "gap_before": 1.42,
   "event": "ordinary_request",
   "block": "cooking.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "It's slow, but it does work. Hang in there.",
   "est_sec": 2.89,
   "gap_before": 0.47,
   "role": "reply",
   "block": "cooking.dlg14"
  }
 ]
}
