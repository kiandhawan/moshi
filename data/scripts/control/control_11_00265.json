 "est_speech_sec": 37.68,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.68,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.82,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "We want to go to the Edinburgh festival in August. When should we book somewhere to stay?",
   "est_sec": 5.37,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "travel_planning.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "As soon as possible. Accommodation fills up months ahead and prices climb a lot.",
   "est_sec": 4.44,
   "gap_before": 1.17,
   "role": "reply",
   "block": "travel_planning.dlg28"
  },
  {
   "speaker": "user",
   "text": "It's January now. Is that already late?",
   "est_sec": 2.27,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "travel_planning.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Not too late, but don't wait much longer. Look at places with free cancellation so you can lock something in now.",
   "est_sec": 6.61,
   "gap_before": 0.66,
   "role": "reply",
   "block": "travel_planning.dlg28"
  },
  {
   "speaker": "user",
   "text": "Could we stay outside the city?",
   "est_sec": 1.96,
   "gap_before": 1.3,
   "event": "ordinary_request",
   "block": "travel_planning.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Yes, towns along the train line can be much cheaper. Check the last train times though, shows run late.",
   "est_sec": 5.99,
   "gap_before": 0.63,
   "role": "reply",
   "block": "travel_planning.dlg28"
  },
  {
   "speaker": "user",
   "text": "Good point. We'll want",
   "est_sec": 1.34,
   "gap_before": 1.29,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg28"
  },
  {
   "speaker": "user",
   "text": "to see some of the late night comedy.",
   "est_sec": 2.58,
   "gap_before": 2.48,
   "event": "ordinary_request",
   "block": "travel_planning.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Then staying central is worth the money, or plan on taxis back.",
   "est_sec": 3.82,
   "gap_before": 0.75,
   "role": "reply",
   "block": "travel_planning.dlg28"
  }
 ]
}
