 "est_total_sec": 61.57,
 "est_speech_sec": 45.94,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.97,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I spent twelve years in the army and civilian employers don't seem to get what I did.",
   "est_sec": 5.37,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "job_interview.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "That's a common challenge. The trick is translating military language into everyday business terms.",
   "est_sec": 4.44,
   "gap_before": 0.32,
   "role": "reply",
   "block": "job_interview.dlg22"
  },
  {
   "speaker": "user",
   "text": "Wait, what did you say?",
   "est_sec": 1.65,
   "gap_before": 1.15,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_01",
   "block": "job_interview.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Of course. That's a common challenge. The trick is translating military language into everyday business terms.",
   "est_sec": 5.06,
   "gap_before": 0.85,
   "role": "reply",
   "block": "job_interview.dlg22"
  },
  {
   "speaker": "user",
   "text": "Like what? I was a logistics sergeant.",
   "est_sec": 2.27,
   "gap_before": 1.24,
   "event": "ordinary_request",
   "block": "job_interview.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Instead of rank, talk about responsibilities. For example, I managed a team of fifteen and moved equipment worth millions across three countries.",
   "est_sec": 6.92,
   "gap_before": 1.82,
   "role": "reply",
   "block": "job_interview.dlg22"
  },
  {
   "speaker": "user",
   "text": "That sounds way more impressive.",
   "est_sec": 1.65,
   "gap_before": 0.75,
   "event": "ordinary_request",
   "block": "job_interview.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "It is impressive. You just need to say it in their language. Leadership, planning, working under pressure, these are all huge.",
   "est_sec": 6.61,
   "gap_before": 0.57,
   "role": "reply",
   "block": "job_interview.dlg22"
  },
  {
   "speaker": "user",
   "text": "What about the jargon",
   "est_sec": 1.34,
   "gap_before": 1.48,
   "event": "distractor",
   "kind": "pause",
   "block": "job_interview.dlg22"
  },
  {
   "speaker": "user",
   "text": "I use without even noticing?",
   "est_sec": 1.65,
   "gap_before": 2.98,
   "event": "ordinary_request",
   "block": "job_interview.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Ask a civilian friend to listen to your answers and stop you every time they don't understand a word.",
   "est_sec": 5.99,
   "gap_before": 0.93,
   "role": "reply",
   "block": "job_interview.dlg22"
  }
 ]
}
