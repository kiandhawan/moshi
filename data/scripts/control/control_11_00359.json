 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.36,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.59,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "Quick one. Is it okay to throw an orange peel into the bushes? It's natural, right?",
   "est_sec": 5.06,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "hiking.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "It feels harmless, but it's better to take it home. Peel takes a long time to break down, sometimes months or more.",
   "est_sec": 6.92,
   "gap_before": 0.55,
   "role": "reply",
   "block": "hiking.dlg9"
  },
  {
   "speaker": "user",
   "text": "Seriously? Months?",
   "est_sec": 0.72,
   "gap_before": 1.43,
   "event": "ordinary_request",
   "block": "hiking.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Yes, especially in dry or cold places. And it's not part of what animals there would normally eat.",
   "est_sec": 5.68,
   "gap_before": 0.36,
   "role": "reply",
   "block": "hiking.dlg9"
  },
  {
   "speaker": "user",
   "text": "Huh. Same with apple cores?",
   "est_sec": 1.65,
   "gap_before": 0.32,
   "event": "ordinary_request",
   "block": "hiking.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Same idea. On busy trails, hundreds of people dropping cores adds up quickly.",
   "est_sec": 4.13,
   "gap_before": 1.66,
   "role": "reply",
   "block": "hiking.dlg9"
  },
  {
   "speaker": "user",
   "text": "Fine, I'll",
   "est_sec": 0.72,
   "gap_before": 1.17,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg9"
  },
  {
   "speaker": "user",
   "text": "bring a little bag for scraps.",
   "est_sec": 1.96,
   "gap_before": 2.77,
   "event": "ordinary_request",
   "block": "hiking.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "That's all it takes. A small zip bag in the side pocket and you're sorted.",
   "est_sec": 4.75,
   "gap_before": 1.14,
   "role": "reply",
   "block": "hiking.dlg9"
  }
 ]
}
