 "est_total_sec": 57.7,
 "est_speech_sec": 43.88,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.83,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "I have asthma, mostly under control. Any tips for hiking with it?",
   "est_sec": 3.82,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "hiking.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Plenty of people with asthma hike happily. The main thing is always carrying your reliever inhaler where you can reach it, not buried in the bag.",
   "est_sec": 8.16,
   "gap_before": 1.1,
   "role": "reply",
   "block": "hiking.dlg12"
  },
  {
   "speaker": "user",
   "text": "Cold air sets mine off.",
   "est_sec": 1.65,
   "gap_before": 0.83,
   "event": "ordinary_request",
   "block": "hiking.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "A buff or scarf over your mouth on cold mornings warms the air a bit. Start slowly to let your lungs adjust.",
   "est_sec": 6.92,
   "gap_before": 0.37,
   "role": "reply",
   "block": "hiking.dlg12"
  },
  {
   "speaker": "user",
   "text": "What about pollen? Spring is",
   "est_sec": 1.65,
   "gap_before": 2.55,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg12"
  },
  {
   "speaker": "user",
   "text": "pretty bad for me.",
   "est_sec": 1.34,
   "gap_before": 2.95,
   "event": "ordinary_request",
   "block": "hiking.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Check the pollen forecast and pick days after rain, or routes higher up and by the coast, where counts are often lower.",
   "est_sec": 6.92,
   "gap_before": 0.58,
   "role": "reply",
   "block": "hiking.dlg12"
  },
  {
   "speaker": "user",
   "text": "Hold on, good idea. I'll talk to my nurse before the big one in May.",
   "est_sec": 4.75,
   "gap_before": 1.17,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_14",
   "block": "hiking.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "That's a great plan. She might suggest using your preventer more regularly in the weeks before.",
   "est_sec": 5.06,
   "gap_before": 0.78,
   "role": "reply",
   "block": "hiking.dlg12"
  }
 ]
}
