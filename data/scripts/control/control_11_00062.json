 "est_total_sec": 64.2,
 "est_speech_sec": 51.83,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.77,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "I want to grow potatoes but I've only got a patio. Is that daft?",
   "est_sec": 4.44,
   "gap_before": 0.6,
   "event": "ordinary_request",
   "block": "gardening.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Not daft at all. Potatoes grow well in big bags or tubs, and tipping them out at harvest is honestly the best bit.",
   "est_sec": 7.23,
   "gap_before": 0.51,
   "role": "reply",
   "block": "gardening.dlg8"
  },
  {
   "speaker": "user",
   "text": "How big are we talking?",
   "est_sec": 1.65,
   "gap_before": 1.45,
   "event": "ordinary_request",
   "block": "gardening.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Something around the size of a laundry basket, with drainage holes. Three seed potatoes per bag is plenty.",
   "est_sec": 5.68,
   "gap_before": 0.66,
   "role": "reply",
   "block": "gardening.dlg8"
  },
  {
   "speaker": "user",
   "text": "Do I fill it all the way up from the start?",
   "est_sec": 3.51,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "gardening.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "No, start with a bit of compost, put the potatoes in, and cover them lightly. As the leaves grow, keep adding compost around them.",
   "est_sec": 7.54,
   "gap_before": 0.6,
   "role": "reply",
   "block": "gardening.dlg8"
  },
  {
   "speaker": "user",
   "text": "Wait a second, why's that?",
   "est_sec": 1.65,
   "gap_before": 1.11,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_16",
   "block": "gardening.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "The buried stem makes more potatoes, and it keeps them out of the light so they don't turn green.",
   "est_sec": 5.99,
   "gap_before": 0.68,
   "role": "reply",
   "block": "gardening.dlg8"
  },
  {
   "speaker": "user",
   "text": "Oh, green potatoes are bad, right? My dad always",
   "est_sec": 2.89,
   "gap_before": 1.13,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg8"
  },
  {
   "speaker": "user",
   "text": "cut those bits off.",
   "est_sec": 1.34,
   "gap_before": 2.35,
   "event": "ordinary_request",
   "block": "gardening.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Your dad was right. The green parts can upset your stomach, so cut them away or skip them.",
   "est_sec": 5.68,
   "gap_before": 0.32,
   "role": "reply",
   "block": "gardening.dlg8"
  }
 ]
}
