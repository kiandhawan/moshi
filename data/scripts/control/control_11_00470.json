 "est_total_sec": 59.8,
 "est_speech_sec": 42.84,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.54,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.5,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "How much should I budget per day in Mexico City? I'm a student, so, not much.",
   "est_sec": 5.06,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "travel_planning.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "You can do it fairly cheaply. A hostel bed, street food and the metro keep costs very low.",
   "est_sec": 5.68,
   "gap_before": 0.86,
   "role": "reply",
   "block": "travel_planning.dlg29"
  },
  {
   "speaker": "user",
   "text": "Like how low?",
   "est_sec": 1.03,
   "gap_before": 1.37,
   "event": "ordinary_request",
   "block": "travel_planning.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Many backpackers spend somewhere around thirty to forty dollars a day, but prices change, so check recent travel forums.",
   "est_sec": 5.99,
   "gap_before": 1.17,
   "role": "reply",
   "block": "travel_planning.dlg29"
  },
  {
   "speaker": "user",
   "text": "Is street food safe?",
   "est_sec": 1.34,
   "gap_before": 2.45,
   "event": "ordinary_request",
   "block": "travel_planning.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Busy stalls with lots of locals are usually a good sign. Avoid tap water and ice from places you're unsure about.",
   "est_sec": 6.61,
   "gap_before": 1.26,
   "role": "reply",
   "block": "travel_planning.dlg29"
  },
  {
   "speaker": "user",
   "text": "What's the one thing",
   "est_sec": 1.34,
   "gap_before": 1.43,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg29"
  },
  {
   "speaker": "user",
   "text": "I shouldn't skip?",
   "est_sec": 1.03,
   "gap_before": 2.81,
   "event": "ordinary_request",
   "block": "travel_planning.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "A day at Teotihuacan, the ancient pyramids just outside the city. Get there early to beat the heat and the crowds.",
   "est_sec": 6.61,
   "gap_before": 0.66,
   "role": "reply",
   "block": "travel_planning.dlg29"
  },
  {
   "speaker": "user",
   "text": "Pyramids. Okay, adding it.",
   "est_sec": 1.34,
   "gap_before": 1.05,
   "event": "ordinary_request",
   "block": "travel_planning.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "And try the tacos al pastor. They're worth the trip on their own.",
   "est_sec": 4.13,
   "gap_before": 0.89,
   "role": "reply",
   "block": "travel_planning.dlg29"
  }
 ]
}
