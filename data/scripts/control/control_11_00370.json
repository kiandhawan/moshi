 "est_total_sec": 47.63,
 "est_speech_sec": 36.44,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.73,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.48,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "I keep getting blisters on my heels when I hike.",
   "est_sec": 3.2,
   "gap_before": 0.41,
   "event": "ordinary_request",
   "block": "hiking.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "That's usually friction from your heel sliding in the boot. Are your boots well broken in?",
   "est_sec": 5.06,
   "gap_before": 1.49,
   "role": "reply",
   "block": "hiking.dlg2"
  },
  {
   "speaker": "user",
   "text": "They're pretty new, yeah.",
   "est_sec": 1.34,
   "gap_before": 1.24,
   "event": "ordinary_request",
   "block": "hiking.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "That's likely the cause. Wear them around the house and on short walks first. Proper hiking socks help a lot too, not cotton ones.",
   "est_sec": 7.54,
   "gap_before": 0.37,
   "role": "reply",
   "block": "hiking.dlg2"
  },
  {
   "speaker": "user",
   "text": "And if I feel one starting on the trail?",
   "est_sec": 2.89,
   "gap_before": 0.75,
   "event": "ordinary_request",
   "block": "hiking.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Stop right away and put a blister plaster or some tape on the spot. Waiting until it hurts usually means it's already formed.",
   "est_sec": 7.23,
   "gap_before": 0.37,
   "role": "reply",
   "block": "hiking.dlg2"
  },
  {
   "speaker": "user",
   "text": "I always think I'll",
   "est_sec": 1.34,
   "gap_before": 0.53,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg2"
  },
  {
   "speaker": "user",
   "text": "just push through it.",
   "est_sec": 1.34,
   "gap_before": 1.82,
   "event": "ordinary_request",
   "block": "hiking.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Most people do. A two minute stop early saves you a miserable walk back.",
   "est_sec": 4.44,
   "gap_before": 1.5,
   "role": "reply",
   "block": "hiking.dlg2"
  }
 ]
}
