 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.32,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "My baby is six months old and I feel like I haven't slept since she was born.",
   "est_sec": 5.37,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "sleep.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "That sounds exhausting. Can you and your partner take turns with night feeds, so each of you gets one longer stretch?",
   "est_sec": 6.61,
   "gap_before": 0.98,
   "role": "reply",
   "block": "sleep.dlg2"
  },
  {
   "speaker": "user",
   "text": "I'm breastfeeding, so",
   "est_sec": 1.03,
   "gap_before": 0.87,
   "event": "distractor",
   "kind": "pause",
   "block": "sleep.dlg2"
  },
  {
   "speaker": "user",
   "text": "it's mostly me.",
   "est_sec": 1.03,
   "gap_before": 2.78,
   "event": "ordinary_request",
   "block": "sleep.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "You could pump one bottle in the evening so your partner can handle one feed. Even four hours in a row can make a big difference.",
   "est_sec": 8.16,
   "gap_before": 0.95,
   "role": "reply",
   "block": "sleep.dlg2"
  },
  {
   "speaker": "user",
   "text": "That might work. What about naps?",
   "est_sec": 1.96,
   "gap_before": 1.51,
   "event": "ordinary_request",
   "block": "sleep.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Sleep when she naps, at least once a day, even if the house is messy. Rest matters more than chores right now.",
   "est_sec": 6.92,
   "gap_before": 1.27,
   "role": "reply",
   "block": "sleep.dlg2"
  },
  {
   "speaker": "user",
   "text": "That's hard for me, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "sleep.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "It is hard. Be kind to yourself, this stage really does pass.",
   "est_sec": 3.82,
   "gap_before": 0.84,
   "role": "reply",
   "block": "sleep.dlg2"
  }
 ]
}
