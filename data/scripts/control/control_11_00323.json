 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.35,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "My son has a spelling test tomorrow and he's getting really upset about it.",
   "est_sec": 4.44,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "studying.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Poor thing. How many words does he need to learn?",
   "est_sec": 3.2,
   "gap_before": 0.41,
   "role": "reply",
   "block": "studying.dlg2"
  },
  {
   "speaker": "user",
   "text": "Fifteen, and he's only got about half of them.",
   "est_sec": 2.89,
   "gap_before": 1.26,
   "event": "ordinary_request",
   "block": "studying.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "That's a good start. Focus on the ones he's missing and make it a game, like spelling them out loud while bouncing a ball.",
   "est_sec": 7.54,
   "gap_before": 0.68,
   "role": "reply",
   "block": "studying.dlg2"
  },
  {
   "speaker": "user",
   "text": "He'd love that actually. Should we keep going tonight or",
   "est_sec": 3.2,
   "gap_before": 0.74,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg2"
  },
  {
   "speaker": "user",
   "text": "let him rest?",
   "est_sec": 1.03,
   "gap_before": 2.42,
   "event": "ordinary_request",
   "block": "studying.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Do one short round of ten minutes, then stop. A quick review at breakfast will help more than a long session tonight.",
   "est_sec": 6.92,
   "gap_before": 0.66,
   "role": "reply",
   "block": "studying.dlg2"
  },
  {
   "speaker": "user",
   "text": "Breakfast, good idea. He's always more cheerful in the morning.",
   "est_sec": 3.2,
   "gap_before": 1.88,
   "event": "ordinary_request",
   "block": "studying.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Perfect. And remind him that getting most of them right is still a great result.",
   "est_sec": 4.75,
   "gap_before": 0.74,
   "role": "reply",
   "block": "studying.dlg2"
  }
 ]
}
