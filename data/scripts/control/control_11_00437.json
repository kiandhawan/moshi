 "est_speech_sec": 42.33,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.55,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.76,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "My son just turned sixteen and wants a debit card. Is that a good idea?",
   "est_sec": 4.75,
   "gap_before": 0.29,
   "event": "ordinary_request",
   "block": "personal_finance.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "It can be a great way to learn. Many banks offer teen accounts that you can monitor from your own app.",
   "est_sec": 6.61,
   "gap_before": 0.41,
   "role": "reply",
   "block": "personal_finance.dlg2"
  },
  {
   "speaker": "user",
   "text": "I'm worried he'll spend it all on snacks and games.",
   "est_sec": 3.2,
   "gap_before": 1.4,
   "event": "ordinary_request",
   "block": "personal_finance.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "He probably will at first, and that's part of learning. You can set spending limits and get alerts for each purchase.",
   "est_sec": 6.61,
   "gap_before": 1.07,
   "role": "reply",
   "block": "personal_finance.dlg2"
  },
  {
   "speaker": "user",
   "text": "Should I give him an allowance on it, or",
   "est_sec": 2.89,
   "gap_before": 0.54,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg2"
  },
  {
   "speaker": "user",
   "text": "make him earn it?",
   "est_sec": 1.34,
   "gap_before": 2.0,
   "event": "ordinary_request",
   "block": "personal_finance.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "A mix works well. A small base allowance, plus extra for bigger chores or a part time job.",
   "est_sec": 5.68,
   "gap_before": 0.76,
   "role": "reply",
   "block": "personal_finance.dlg2"
  },
  {
   "speaker": "user",
   "text": "I like that. What about teaching him to save?",
   "est_sec": 2.89,
   "gap_before": 1.32,
   "event": "ordinary_request",
   "block": "personal_finance.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Try matching whatever he saves toward a goal he picks, like a bike. Seeing it grow is very motivating.",
   "est_sec": 5.99,
   "gap_before": 1.04,
   "role": "reply",
   "block": "personal_finance.dlg2"
  }
 ]
}
