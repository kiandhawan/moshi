 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.65,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.97,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "Everyone in my family loves jazz and I just don't get it.",
   "est_sec": 3.82,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "music.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "That's okay, jazz can feel a bit slippery at first. What have you heard so far?",
   "est_sec": 5.06,
   "gap_before": 1.55,
   "role": "reply",
   "block": "music.dlg12"
  },
  {
   "speaker": "user",
   "text": "Mostly long, messy stuff with lots of sax solos.",
   "est_sec": 2.89,
   "gap_before": 1.48,
   "event": "ordinary_request",
   "block": "music.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Ah, that's the deep end. Try something more melodic, like vocal jazz or a relaxed piano trio. There's usually a clear tune to hold onto.",
   "est_sec": 7.85,
   "gap_before": 1.2,
   "role": "reply",
   "block": "music.dlg12"
  },
  {
   "speaker": "user",
   "text": "Is there a trick",
   "est_sec": 1.34,
   "gap_before": 1.3,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg12"
  },
  {
   "speaker": "user",
   "text": "to listening to it?",
   "est_sec": 1.34,
   "gap_before": 2.92,
   "event": "ordinary_request",
   "block": "music.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Listen for the main tune at the start. Then the players take turns improvising around it, and the tune comes back at the end.",
   "est_sec": 7.54,
   "gap_before": 1.31,
   "role": "reply",
   "block": "music.dlg12"
  },
  {
   "speaker": "user",
   "text": "Oh, so it's like a theme and they all riff on it.",
   "est_sec": 3.82,
   "gap_before": 0.99,
   "event": "ordinary_request",
   "block": "music.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Once you hear that shape, the solos make much more sense.",
   "est_sec": 3.82,
   "gap_before": 0.7,
   "role": "reply",
   "block": "music.dlg12"
  }
 ]
