 "est_total_sec": 53.49,
 "est_speech_sec": 39.23,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.43,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.73,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "I keep buying books and never reading them. Is that a problem?",
   "est_sec": 3.82,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "books.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "There's even a word for it in Japanese, for a pile of unread books. You're in good company.",
   "est_sec": 5.68,
   "gap_before": 1.56,
   "role": "reply",
   "block": "books.dlg23"
  },
  {
   "speaker": "user",
   "text": "My partner says it's out of control. There's a pile by the bed taller than the lamp.",
   "est_sec": 5.37,
   "gap_before": 1.35,
   "event": "ordinary_request",
   "block": "books.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Ha, that's a strong pile. Maybe set a little rule, like reading one from the pile before buying a new one.",
   "est_sec": 6.61,
   "gap_before": 0.94,
   "role": "reply",
   "block": "books.dlg23"
  },
  {
   "speaker": "user",
   "text": "That sounds horrible.",
   "est_sec": 1.03,
   "gap_before": 1.47,
   "event": "ordinary_request",
   "block": "books.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "It sounds strict, but it can make the pile feel less like guilt and more like a treasure chest.",
   "est_sec": 5.99,
   "gap_before": 0.93,
   "role": "reply",
   "block": "books.dlg23"
  },
  {
   "speaker": "user",
   "text": "What if I",
   "est_sec": 1.03,
   "gap_before": 1.41,
   "event": "distractor",
   "kind": "pause",
   "block": "books.dlg23"
  },
  {
   "speaker": "user",
   "text": "start one and hate it?",
   "est_sec": 1.65,
   "gap_before": 2.8,
   "event": "ordinary_request",
   "block": "books.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Then give it fifty pages and move on. That still counts as clearing it from the pile.",
   "est_sec": 5.37,
   "gap_before": 0.66,
   "role": "reply",
   "block": "books.dlg23"
  }
 ]
}
