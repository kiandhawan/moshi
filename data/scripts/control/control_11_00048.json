 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.71,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.36,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "How do I use my phone abroad without paying a fortune?",
   "est_sec": 3.51,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "travel_planning.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "The cheapest option is usually a local or travel eSIM. You buy a data plan online and install it before you leave.",
   "est_sec": 6.92,
   "gap_before": 0.69,
   "role": "reply",
   "block": "travel_planning.dlg16"
  },
  {
   "speaker": "user",
   "text": "What's an eSIM? Is it a physical thing?",
   "est_sec": 2.58,
   "gap_before": 0.36,
   "event": "ordinary_request",
   "block": "travel_planning.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "No, it's digital. Your phone downloads it, like an app, as long as your phone supports it.",
   "est_sec": 5.37,
   "gap_before": 1.24,
   "role": "reply",
   "block": "travel_planning.dlg16"
  },
  {
   "speaker": "user",
   "text": "How do I check that?",
   "est_sec": 1.65,
   "gap_before": 1.42,
   "event": "ordinary_request",
   "block": "travel_planning.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Look in your settings under mobile data or cellular. If there's an option to add an eSIM, you're good.",
   "est_sec": 5.99,
   "gap_before": 0.66,
   "role": "reply",
   "block": "travel_planning.dlg16"
  },
  {
   "speaker": "user",
   "text": "And my normal number",
   "est_sec": 1.34,
   "gap_before": 1.18,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg16"
  },
  {
   "speaker": "user",
   "text": "still works for texts?",
   "est_sec": 1.34,
   "gap_before": 2.58,
   "event": "ordinary_request",
   "block": "travel_planning.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Yes, you can keep your normal SIM active for calls and texts. Just turn off its data roaming so you're not charged.",
   "est_sec": 6.92,
   "gap_before": 0.81,
   "role": "reply",
   "block": "travel_planning.dlg16"
  }
 ]
}
