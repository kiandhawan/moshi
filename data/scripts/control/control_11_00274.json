 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.32,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.38,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "Can I make fresh pasta without a pasta machine?",
   "est_sec": 2.89,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "block": "cooking.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Definitely. You just need flour, eggs, a rolling pin and some patience.",
   "est_sec": 3.82,
   "gap_before": 0.51,
   "role": "reply",
   "block": "cooking.dlg29"
  },
  {
   "speaker": "user",
   "text": "How much flour per egg?",
   "est_sec": 1.65,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "block": "cooking.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Roughly a hundred grams of flour for each egg. Knead it for about ten minutes until it's smooth.",
   "est_sec": 5.68,
   "gap_before": 0.59,
   "role": "reply",
   "block": "cooking.dlg29"
  },
  {
   "speaker": "user",
   "text": "My arms are going to fall off.",
   "est_sec": 2.27,
   "gap_before": 3.37,
   "event": "ordinary_request",
   "block": "cooking.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Maybe a little. Let the dough rest for half an hour wrapped up, it gets much easier to roll after.",
   "est_sec": 6.3,
   "gap_before": 0.52,
   "role": "reply",
   "block": "cooking.dlg29"
  },
  {
   "speaker": "user",
   "text": "Then roll it super thin?",
   "est_sec": 1.65,
   "gap_before": 1.07,
   "event": "ordinary_request",
   "block": "cooking.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Thin enough that you can almost see your hand through it. Dust it with flour, roll it up loosely and slice it into ribbons.",
   "est_sec": 7.54,
   "gap_before": 0.68,
   "role": "reply",
   "block": "cooking.dlg29"
  },
  {
   "speaker": "user",
   "text": "And cooking time? I'm guessing it's not",
   "est_sec": 2.27,
   "gap_before": 1.36,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg29"
  },
  {
   "speaker": "user",
   "text": "the same as dried pasta.",
   "est_sec": 1.65,
   "gap_before": 1.69,
   "event": "ordinary_request",
   "block": "cooking.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Much shorter, two or three minutes in salted boiling water. Taste one to check.",
   "est_sec": 4.44,
   "gap_before": 0.7,
   "role": "reply",
   "block": "cooking.dlg29"
  }
 ]
}
