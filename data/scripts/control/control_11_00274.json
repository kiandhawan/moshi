 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.45,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "I'm sixty-eight and my doctor said I should do more exercise. I'm not really a gym person.",
   "est_sec": 5.37,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "fitness.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "You don't need a gym. Brisk walking, swimming or a gentle yoga class are all excellent choices.",
   "est_sec": 5.37,
   "gap_before": 0.57,
   "role": "reply",
   "block": "fitness.dlg4"
  },
  {
   "speaker": "user",
   "text": "I do like swimming. How often should I go?",
   "est_sec": 2.89,
   "gap_before": 1.32,
   "event": "ordinary_request",
   "block": "fitness.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Two or three times a week is a great target. Start with twenty minutes and build up as you feel comfortable.",
   "est_sec": 6.61,
   "gap_before": 0.56,
   "role": "reply",
   "block": "fitness.dlg4"
  },
  {
   "speaker": "user",
   "text": "What about strength? My doctor mentioned that too.",
   "est_sec": 2.58,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "fitness.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Simple things help a lot, like standing up from a chair without using your hands, or light weights at home.",
   "est_sec": 6.3,
   "gap_before": 0.33,
   "role": "reply",
   "block": "fitness.dlg4"
  },
  {
   "speaker": "user",
   "text": "I have some old dumbbells",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg4"
  },
  {
   "speaker": "user",
   "text": "somewhere in the garage, I think.",
   "est_sec": 1.96,
   "gap_before": 2.03,
   "event": "ordinary_request",
   "block": "fitness.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Perfect. Try a few slow bicep curls and shoulder raises while watching television.",
   "est_sec": 4.13,
   "gap_before": 1.46,
   "role": "reply",
   "block": "fitness.dlg4"
  },
  {
   "speaker": "user",
   "text": "Ha, that I can manage.",
   "est_sec": 1.65,
   "gap_before": 1.3,
   "block": "fitness.dlg4"
  }
 ]
