 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.33,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.93,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "My five year old says she's scared to sleep in her new room.",
   "est_sec": 4.13,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "block": "moving_house.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "That's really common after a move. Everything sounds and looks different at night.",
   "est_sec": 4.13,
   "gap_before": 0.81,
   "role": "reply",
   "block": "moving_house.dlg30"
  },
  {
   "speaker": "user",
   "text": "She keeps saying there are noises.",
   "est_sec": 1.96,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "moving_house.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Try a little nightlight and leave her door open a bit. You could listen to the noises together in daylight and name them, like the pipes or the wind.",
   "est_sec": 9.09,
   "gap_before": 0.61,
   "role": "reply",
   "block": "moving_house.dlg30"
  },
  {
   "speaker": "user",
   "text": "Oh, that's good. She does",
   "est_sec": 1.65,
   "gap_before": 0.91,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg30"
  },
  {
   "speaker": "user",
   "text": "love naming things.",
   "est_sec": 1.03,
   "gap_before": 2.53,
   "event": "ordinary_request",
   "block": "moving_house.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Then let her name the house too, or decorate her room with her favourite things from before.",
   "est_sec": 5.37,
   "gap_before": 1.11,
   "role": "reply",
   "block": "moving_house.dlg30"
  },
  {
   "speaker": "user",
   "text": "And if she ends up in our bed?",
   "est_sec": 2.58,
   "gap_before": 0.72,
   "event": "ordinary_request",
   "block": "moving_house.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "A few nights is fine. Gently walk her back once she's settled, she'll adjust in a week or two.",
   "est_sec": 5.99,
   "gap_before": 0.93,
   "role": "reply",
   "block": "moving_house.dlg30"
  }
 ]
}
