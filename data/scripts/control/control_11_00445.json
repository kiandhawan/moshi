 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.3,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.56,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "My baby is six months old and I feel like I haven't slept since she was born.",
   "est_sec": 5.37,
   "gap_before": 0.42,
   "event": "ordinary_request",
   "block": "sleep.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "That sounds exhausting. Can you and your partner take turns with night feeds, so each of you gets one longer stretch?",
   "est_sec": 6.61,
   "gap_before": 0.78,
   "role": "reply",
   "block": "sleep.dlg2"
  },
  {
   "speaker": "user",
   "text": "I'm breastfeeding, so",
   "est_sec": 1.03,
   "gap_before": 0.81,
   "event": "distractor",
   "kind": "pause",
   "block": "sleep.dlg2"
  },
  {
   "speaker": "user",
   "text": "it's mostly me.",
   "est_sec": 1.03,
   "gap_before": 1.89,
   "event": "ordinary_request",
   "block": "sleep.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "You could pump one bottle in the evening so your partner can handle one feed. Even four hours in a row can make a big difference.",
   "est_sec": 8.16,
   "gap_before": 0.42,
   "role": "reply",
   "block": "sleep.dlg2"
  },
  {
   "speaker": "user",
   "text": "That might work. What about naps?",
   "est_sec": 1.96,
   "gap_before": 1.14,
   "event": "ordinary_request",
   "block": "sleep.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Sleep when she naps, at least once a day, even if the house is messy. Rest matters more than chores right now.",
   "est_sec": 6.92,
   "gap_before": 0.64,
   "role": "reply",
   "block": "sleep.dlg2"
  },
  {
   "speaker": "user",
   "text": "That's hard for me, but okay.",
   "est_sec": 1.96,
   "gap_before": 2.29,
   "event": "ordinary_request",
   "block": "sleep.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "It is hard. Be kind to yourself, this stage really does pass.",
   "est_sec": 3.82,
   "gap_before": 0.66,
   "role": "reply",
   "block": "sleep.dlg2"
  }
 ]
