 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.45,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.46,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "Can I swap regular flour for whole wheat in my muffin recipe?",
   "est_sec": 3.82,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "baking.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "You can, but start by swapping only half. Whole wheat makes muffins denser and a little drier.",
   "est_sec": 5.37,
   "gap_before": 1.08,
   "role": "reply",
   "block": "baking.dlg2"
  },
  {
   "speaker": "user",
   "text": "Should I add more liquid then?",
   "est_sec": 1.96,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "baking.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Yes, a couple of extra spoonfuls of milk helps. Letting the batter rest ten minutes also softens the bran.",
   "est_sec": 5.99,
   "gap_before": 0.48,
   "role": "reply",
   "block": "baking.dlg2"
  },
  {
   "speaker": "user",
   "text": "And if I want to cut",
   "est_sec": 1.96,
   "gap_before": 2.04,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg2"
  },
  {
   "speaker": "user",
   "text": "some of the sugar too?",
   "est_sec": 1.65,
   "gap_before": 2.55,
   "event": "ordinary_request",
   "block": "baking.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "You can cut about a quarter without problems. Mashed banana or a bit of applesauce adds sweetness back.",
   "est_sec": 5.68,
   "gap_before": 0.68,
   "role": "reply",
   "block": "baking.dlg2"
  },
  {
   "speaker": "user",
   "text": "Banana sounds good. I have some brown ones.",
   "est_sec": 2.58,
   "gap_before": 0.32,
   "event": "ordinary_request",
   "block": "baking.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Perfect, the browner the better for baking.",
   "est_sec": 2.27,
   "gap_before": 0.74,
   "role": "reply",
   "block": "baking.dlg2"
  }
 ]
}
