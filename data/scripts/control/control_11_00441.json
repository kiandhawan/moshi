 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.58,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.9,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "How do I make proper cinema popcorn at home? Mine always tastes like cardboard.",
   "est_sec": 4.44,
   "gap_before": 0.24,
   "event": "ordinary_request",
   "block": "movies.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "The secret is fat and salt. Pop the kernels in a heavy pot with a good coating of oil, rather than in the microwave.",
   "est_sec": 7.54,
   "gap_before": 0.69,
   "role": "reply",
   "block": "movies.dlg12"
  },
  {
   "speaker": "user",
   "text": "What oil?",
   "est_sec": 0.72,
   "gap_before": 1.4,
   "event": "ordinary_request",
   "block": "movies.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Coconut oil gives that cinema taste. A neutral oil works too, but coconut is the classic.",
   "est_sec": 5.06,
   "gap_before": 0.96,
   "role": "reply",
   "block": "movies.dlg12"
  },
  {
   "speaker": "user",
   "text": "And the salt never sticks to mine.",
   "est_sec": 2.27,
   "gap_before": 1.38,
   "event": "ordinary_request",
   "block": "movies.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Use very fine salt, even blitzed in a blender. It clings much better than chunky flakes.",
   "est_sec": 5.06,
   "gap_before": 1.92,
   "role": "reply",
   "block": "movies.dlg12"
  },
  {
   "speaker": "user",
   "text": "Butter too? I",
   "est_sec": 1.03,
   "gap_before": 0.69,
   "event": "distractor",
   "kind": "pause",
   "block": "movies.dlg12"
  },
  {
   "speaker": "user",
   "text": "feel like butter is the whole point.",
   "est_sec": 2.27,
   "gap_before": 2.96,
   "event": "ordinary_request",
   "block": "movies.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Melt it and pour it on in thin streams while you toss the popcorn. Not too much at once, or it goes soggy.",
   "est_sec": 7.23,
   "gap_before": 1.72,
   "role": "reply",
   "block": "movies.dlg12"
  },
  {
   "speaker": "user",
   "text": "This is a game changer.",
   "est_sec": 1.65,
   "gap_before": 0.99,
   "event": "ordinary_request",
   "block": "movies.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Keep the lid slightly open while it pops. The steam escapes and you get crunchier popcorn.",
   "est_sec": 5.06,
   "gap_before": 0.95,
   "role": "reply",
   "block": "movies.dlg12"
  }
 ]
}
