 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.62,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.38,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "So I want to have a sleepover for my thirteenth and my mum says only if I plan it properly.",
   "est_sec": 6.3,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "birthday_party.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "That sounds fair. How many friends do you want to invite?",
   "est_sec": 3.51,
   "gap_before": 0.48,
   "role": "reply",
   "block": "birthday_party.dlg9"
  },
  {
   "speaker": "user",
   "text": "Five. Is that too many?",
   "est_sec": 1.65,
   "gap_before": 2.62,
   "event": "ordinary_request",
   "block": "birthday_party.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Five is a good number. Make sure there's room for everyone's sleeping bags, and maybe agree a lights out time with your mum so she's happy.",
   "est_sec": 8.16,
   "gap_before": 1.9,
   "role": "reply",
   "block": "birthday_party.dlg9"
  },
  {
   "speaker": "user",
   "text": "Lights out? That kills the whole point.",
   "est_sec": 2.27,
   "gap_before": 1.35,
   "event": "ordinary_request",
   "block": "birthday_party.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "It doesn't have to be early. Suggesting it yourself shows her you've thought about it, and she might be more relaxed in return.",
   "est_sec": 7.23,
   "gap_before": 1.01,
   "role": "reply",
   "block": "birthday_party.dlg9"
  },
  {
   "speaker": "user",
   "text": "Okay smart. What should we actually do",
   "est_sec": 2.27,
   "gap_before": 0.42,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg9"
  },
  {
   "speaker": "user",
   "text": "besides watching films?",
   "est_sec": 1.03,
   "gap_before": 1.94,
   "event": "ordinary_request",
   "block": "birthday_party.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "A make your own pancakes breakfast is fun, and a little quiz about each other at night always gets people laughing.",
   "est_sec": 6.61,
   "gap_before": 0.34,
   "role": "reply",
   "block": "birthday_party.dlg9"
  }
 ]
}
