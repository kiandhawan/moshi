 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.63,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "Help me understand compound interest like I'm five.",
   "est_sec": 2.58,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "personal_finance.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Sure. Imagine you plant one apple seed and it grows a tree. The tree gives apples, and you plant those seeds too.",
   "est_sec": 6.92,
   "gap_before": 0.71,
   "role": "reply",
   "block": "personal_finance.dlg9"
  },
  {
   "speaker": "user",
   "text": "So the apples make more apples.",
   "est_sec": 1.96,
   "gap_before": 0.73,
   "event": "ordinary_request",
   "block": "personal_finance.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Your money earns interest, then that interest earns interest too. Over many years, it snowballs.",
   "est_sec": 5.06,
   "gap_before": 0.8,
   "role": "reply",
   "block": "personal_finance.dlg9"
  },
  {
   "speaker": "user",
   "text": "How many years before it's",
   "est_sec": 1.65,
   "gap_before": 0.73,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg9"
  },
  {
   "speaker": "user",
   "text": "noticeable?",
   "est_sec": 0.41,
   "gap_before": 2.0,
   "event": "ordinary_request",
   "block": "personal_finance.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "It's slow at first, but after about ten years you start to see it, and after twenty or thirty it can be huge.",
   "est_sec": 7.23,
   "gap_before": 0.66,
   "role": "reply",
   "block": "personal_finance.dlg9"
  },
  {
   "speaker": "user",
   "text": "Okay, so starting young matters.",
   "est_sec": 1.65,
   "gap_before": 1.25,
   "event": "ordinary_request",
   "block": "personal_finance.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "A lot. Small amounts saved early often beat bigger amounts saved later.",
   "est_sec": 3.82,
   "gap_before": 0.84,
   "role": "reply",
   "block": "personal_finance.dlg9"
  }
 ]
}
