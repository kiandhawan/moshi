 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.65,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "My flatmate keeps our coffee beans in the freezer. Is that right? It seems weird.",
   "est_sec": 4.75,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "coffee.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "It's a common debate. For beans you'll use within a couple of weeks, an airtight container in a cool, dark cupboard is best.",
   "est_sec": 7.23,
   "gap_before": 0.93,
   "role": "reply",
   "block": "coffee.dlg11"
  },
  {
   "speaker": "user",
   "text": "So the freezer is wrong?",
   "est_sec": 1.65,
   "gap_before": 0.91,
   "event": "ordinary_request",
   "block": "coffee.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Not wrong, just not needed for everyday beans. Taking them in and out of the freezer causes condensation, which isn't great for flavour.",
   "est_sec": 7.23,
   "gap_before": 1.72,
   "role": "reply",
   "block": "coffee.dlg11"
  },
  {
   "speaker": "user",
   "text": "When would freezing",
   "est_sec": 1.03,
   "gap_before": 0.66,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg11"
  },
  {
   "speaker": "user",
   "text": "make sense?",
   "est_sec": 0.72,
   "gap_before": 1.94,
   "event": "ordinary_request",
   "block": "coffee.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "If you buy a big bag and won't use it for a month or more. Freeze it in small portions and only take out what you need.",
   "est_sec": 8.47,
   "gap_before": 1.74,
   "role": "reply",
   "block": "coffee.dlg11"
  },
  {
   "speaker": "user",
   "text": "Okay. I'll negotiate with him.",
   "est_sec": 1.65,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "coffee.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Diplomacy is key. And keep them away from the fridge, beans soak up smells like onions surprisingly fast.",
   "est_sec": 5.68,
   "gap_before": 0.58,
   "role": "reply",
   "block": "coffee.dlg11"
  }
 ]
}
