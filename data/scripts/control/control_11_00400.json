 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.55,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "My kitchen sink drains really slowly. I've tried that blue gel stuff.",
   "est_sec": 3.82,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "home_repair.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Chemical drain cleaners often don't reach the real clog. Have you tried a plunger?",
   "est_sec": 4.44,
   "gap_before": 0.64,
   "role": "reply",
   "block": "home_repair.dlg12"
  },
  {
   "speaker": "user",
   "text": "On a kitchen sink? I thought those were for toilets.",
   "est_sec": 3.2,
   "gap_before": 0.51,
   "event": "ordinary_request",
   "block": "home_repair.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "A small cup plunger works on sinks too. Fill the sink a little so it seals, and give it some firm pumps.",
   "est_sec": 6.92,
   "gap_before": 1.19,
   "role": "reply",
   "block": "home_repair.dlg12"
  },
  {
   "speaker": "user",
   "text": "And if that doesn't do it?",
   "est_sec": 1.96,
   "gap_before": 1.05,
   "event": "ordinary_request",
   "block": "home_repair.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Then check the U shaped pipe under the sink. Put a bucket underneath, unscrew it, and clean out the gunk.",
   "est_sec": 6.3,
   "gap_before": 1.11,
   "role": "reply",
   "block": "home_repair.dlg12"
  },
  {
   "speaker": "user",
   "text": "That sounds disgusting.",
   "est_sec": 1.03,
   "gap_before": 0.65,
   "event": "ordinary_request",
   "block": "home_repair.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "It is, honestly. Wear gloves. But it's the most common spot for grease and food to build up.",
   "est_sec": 5.68,
   "gap_before": 0.89,
   "role": "reply",
   "block": "home_repair.dlg12"
  },
  {
   "speaker": "user",
   "text": "Okay, gloves and",
   "est_sec": 1.03,
   "gap_before": 0.34,
   "event": "distractor",
   "kind": "pause",
   "block": "home_repair.dlg12"
  },
  {
   "speaker": "user",
   "text": "a lot of courage. Got it.",
   "est_sec": 1.96,
   "gap_before": 2.11,
   "event": "ordinary_request",
   "block": "home_repair.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "You'll be fine. It's one of those jobs that looks scary and takes ten minutes.",
   "est_sec": 4.75,
   "gap_before": 0.38,
   "role": "reply",
   "block": "home_repair.dlg12"
  }
 ]
}
