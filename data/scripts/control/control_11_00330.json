 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.67,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "I've got about two hundred DVDs in the loft. Worth keeping?",
   "est_sec": 3.51,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "movies.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Depends. Some films vanish from streaming, and a disc means you always have them. Others you'll never watch again.",
   "est_sec": 5.99,
   "gap_before": 1.28,
   "role": "reply",
   "block": "movies.dlg29"
  },
  {
   "speaker": "user",
   "text": "I barely have a DVD player anymore.",
   "est_sec": 2.27,
   "gap_before": 0.78,
   "event": "ordinary_request",
   "block": "movies.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Then keep the ones you love or can't easily stream, and donate the rest. Charity shops and libraries often take them.",
   "est_sec": 6.61,
   "gap_before": 1.04,
   "role": "reply",
   "block": "movies.dlg29"
  },
  {
   "speaker": "user",
   "text": "Some are",
   "est_sec": 0.72,
   "gap_before": 0.4,
   "event": "distractor",
   "kind": "pause",
   "block": "movies.dlg29"
  },
  {
   "speaker": "user",
   "text": "special editions with extras.",
   "est_sec": 1.34,
   "gap_before": 1.83,
   "event": "ordinary_request",
   "block": "movies.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Those are worth checking. Collectors sometimes pay well for rare editions, especially boxed sets.",
   "est_sec": 4.44,
   "gap_before": 0.33,
   "role": "reply",
   "block": "movies.dlg29"
  },
  {
   "speaker": "user",
   "text": "Okay, sorting weekend it is.",
   "est_sec": 1.65,
   "gap_before": 1.53,
   "event": "ordinary_request",
   "block": "movies.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Make three piles, keep, sell, donate. And don't watch them all while you sort, or it'll take a month.",
   "est_sec": 5.99,
   "gap_before": 0.36,
   "role": "reply",
   "block": "movies.dlg29"
  }
 ]
}
