 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.57,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "My partner wants to do a full moon night hike. Is that a terrible idea?",
   "est_sec": 4.75,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "hiking.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Not terrible, it can be magical. Just pick a trail you both know well in daylight.",
   "est_sec": 5.06,
   "gap_before": 0.83,
   "role": "reply",
   "block": "hiking.dlg17"
  },
  {
   "speaker": "user",
   "text": "We've walked the forest loop loads of times, so",
   "est_sec": 2.89,
   "gap_before": 1.32,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg17"
  },
  {
   "speaker": "user",
   "text": "that one probably.",
   "est_sec": 1.03,
   "gap_before": 2.5,
   "event": "ordinary_request",
   "block": "hiking.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Good choice. Bring head torches even if the moon is bright, clouds can roll in fast.",
   "est_sec": 5.06,
   "gap_before": 0.69,
   "role": "reply",
   "block": "hiking.dlg17"
  },
  {
   "speaker": "user",
   "text": "Red light or normal?",
   "est_sec": 1.34,
   "gap_before": 0.94,
   "event": "ordinary_request",
   "block": "hiking.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Red keeps your night vision better for walking under the moon. Switch to white for anything tricky, like rocky steps.",
   "est_sec": 6.3,
   "gap_before": 0.8,
   "role": "reply",
   "block": "hiking.dlg17"
  },
  {
   "speaker": "user",
   "text": "And it gets cold, I guess.",
   "est_sec": 1.96,
   "gap_before": 1.28,
   "event": "ordinary_request",
   "block": "hiking.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Much colder than you'd expect. Take a warm layer and a hot drink, and tell someone your plan and when you'll be back.",
   "est_sec": 7.23,
   "gap_before": 0.4,
   "role": "reply",
   "block": "hiking.dlg17"
  }
 ]
