 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.66,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.71,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "I spent my whole Saturday on the sofa and now I feel guilty.",
   "est_sec": 4.13,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Why guilty? Rest is a perfectly good use of a weekend.",
   "est_sec": 3.51,
   "gap_before": 0.97,
   "role": "reply",
   "block": "weekend_plans.dlg7"
  },
  {
   "speaker": "user",
   "text": "Everyone else seems to do so much.",
   "est_sec": 2.27,
   "gap_before": 1.07,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Social media makes it look that way. Plenty of people had a quiet Saturday too, they just didn't post about it.",
   "est_sec": 6.61,
   "gap_before": 1.68,
   "role": "reply",
   "block": "weekend_plans.dlg7"
  },
  {
   "speaker": "user",
   "text": "I suppose. I was",
   "est_sec": 1.34,
   "gap_before": 0.75,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg7"
  },
  {
   "speaker": "user",
   "text": "really tired after this week.",
   "est_sec": 1.65,
   "gap_before": 2.74,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Then your body needed it. If you want, plan one small thing for Sunday, like a walk or a coffee somewhere nice.",
   "est_sec": 6.92,
   "gap_before": 0.68,
   "role": "reply",
   "block": "weekend_plans.dlg7"
  },
  {
   "speaker": "user",
   "text": "A walk sounds good, actually.",
   "est_sec": 1.65,
   "gap_before": 0.87,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "There you go. A bit of fresh air and you'll feel like the weekend was well spent.",
   "est_sec": 5.37,
   "gap_before": 1.28,
   "role": "reply",
   "block": "weekend_plans.dlg7"
  }
 ]
}
