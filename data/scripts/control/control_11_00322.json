 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.62,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.58,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "Toast for my best mate's thirtieth. Short. Help.",
   "est_sec": 2.58,
   "gap_before": 0.36,
   "event": "ordinary_request",
   "block": "birthday_party.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Happy to. Give me one thing he's known for.",
   "est_sec": 2.89,
   "gap_before": 0.59,
   "role": "reply",
   "block": "birthday_party.dlg8"
  },
  {
   "speaker": "user",
   "text": "Getting lost. Always. Even with a map.",
   "est_sec": 2.27,
   "gap_before": 1.03,
   "event": "ordinary_request",
   "block": "birthday_party.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Good. You could open with how he once got lost on the way to his own party, then turn it into how he always finds his way to his friends when it matters.",
   "est_sec": 10.33,
   "gap_before": 0.43,
   "role": "reply",
   "block": "birthday_party.dlg8"
  },
  {
   "speaker": "user",
   "text": "Wait a second, too cheesy?",
   "est_sec": 1.65,
   "gap_before": 1.09,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_16",
   "block": "birthday_party.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Only if you drag it out. Keep the joke quick, the warm bit even quicker, then raise your glass.",
   "est_sec": 5.99,
   "gap_before": 0.73,
   "role": "reply",
   "block": "birthday_party.dlg8"
  },
  {
   "speaker": "user",
   "text": "Right. And I end with",
   "est_sec": 1.65,
   "gap_before": 0.81,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg8"
  },
  {
   "speaker": "user",
   "text": "what, just cheers?",
   "est_sec": 1.03,
   "gap_before": 2.69,
   "event": "ordinary_request",
   "block": "birthday_party.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Cheers to thirty years and finally learning to use a map. Short, a little teasing, done.",
   "est_sec": 5.06,
   "gap_before": 0.8,
   "role": "reply",
   "block": "birthday_party.dlg8"
  }
 ]
