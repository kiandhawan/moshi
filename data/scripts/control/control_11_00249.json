 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.47,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "Can I mix bleach and vinegar to make a super strong cleaner? My mould won't budge.",
   "est_sec": 5.06,
   "gap_before": 0.3,
   "event": "ordinary_request",
   "block": "cleaning.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Please don't. Bleach mixed with vinegar, or with ammonia, gives off toxic gas. It's genuinely dangerous.",
   "est_sec": 5.06,
   "gap_before": 0.84,
   "role": "reply",
   "block": "cleaning.dlg15"
  },
  {
   "speaker": "user",
   "text": "Wait a second, that doesn't sound right.",
   "est_sec": 2.27,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_10",
   "block": "cleaning.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Good to question it. I still think it's right, though you know your situation best.",
   "est_sec": 4.75,
   "gap_before": 0.66,
   "role": "reply",
   "block": "cleaning.dlg15"
  },
  {
   "speaker": "user",
   "text": "Oh wow. I almost did it.",
   "est_sec": 1.96,
   "gap_before": 0.74,
   "event": "ordinary_request",
   "block": "cleaning.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Glad you asked. Use one or the other, never together, and rinse well between them if you try both.",
   "est_sec": 5.99,
   "gap_before": 1.38,
   "role": "reply",
   "block": "cleaning.dlg15"
  },
  {
   "speaker": "user",
   "text": "Which one for mould?",
   "est_sec": 1.34,
   "gap_before": 1.23,
   "event": "ordinary_request",
   "block": "cleaning.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "On hard surfaces, a diluted bleach spray works well. Wear gloves and keep the window open.",
   "est_sec": 5.06,
   "gap_before": 0.81,
   "role": "reply",
   "block": "cleaning.dlg15"
  },
  {
   "speaker": "user",
   "text": "And I'll keep",
   "est_sec": 1.03,
   "gap_before": 1.14,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg15"
  },
  {
   "speaker": "user",
   "text": "the vinegar for the kettle.",
   "est_sec": 1.65,
   "gap_before": 1.87,
   "event": "ordinary_request",
   "block": "cleaning.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Perfect use for it.",
