 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.65,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.58,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "My cat knocked a glass of water onto my library book. The pages are all wavy.",
   "est_sec": 5.06,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "books.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Oh no. Is it still dripping, or just damp?",
   "est_sec": 2.89,
   "gap_before": 1.62,
   "role": "reply",
   "block": "books.dlg28"
  },
  {
   "speaker": "user",
   "text": "Just damp now. It happened an hour ago.",
   "est_sec": 2.58,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "books.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Stand it up with the pages fanned out, near a fan but not a heater. Paper towels between the wettest pages help too.",
   "est_sec": 7.23,
   "gap_before": 0.77,
   "role": "reply",
   "block": "books.dlg28"
  },
  {
   "speaker": "user",
   "text": "Will the library make me pay for it?",
   "est_sec": 2.58,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "books.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "They might, if it's badly damaged. Being honest usually helps, and some libraries just charge a small fee.",
   "est_sec": 5.68,
   "gap_before": 0.5,
   "role": "reply",
   "block": "books.dlg28"
  },
  {
   "speaker": "user",
   "text": "I feel so guilty. It's",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "event": "distractor",
   "kind": "pause",
   "block": "books.dlg28"
  },
  {
   "speaker": "user",
   "text": "a brand new book too.",
   "est_sec": 1.65,
   "gap_before": 2.49,
   "event": "ordinary_request",
   "block": "books.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Accidents happen, and cats are cats. Bring it back with an apology and you'll probably be fine.",
   "est_sec": 5.37,
   "gap_before": 1.09,
   "role": "reply",
   "block": "books.dlg28"
  }
 ]
}
