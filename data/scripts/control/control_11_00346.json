 "est_total_sec": 51.62,
 "est_speech_sec": 40.78,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.56,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.36,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "The movers said I have to wait before switching my fridge back on. Is that true?",
   "est_sec": 5.06,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "moving_house.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "It's good advice. If a fridge has been tipped or laid down, the oil in the compressor needs time to settle back.",
   "est_sec": 6.92,
   "gap_before": 0.54,
   "role": "reply",
   "block": "moving_house.dlg28"
  },
  {
   "speaker": "user",
   "text": "How long?",
   "est_sec": 0.72,
   "gap_before": 1.08,
   "event": "ordinary_request",
   "block": "moving_house.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Usually a few hours, often the same amount of time it was on its side. Check the manual to be sure.",
   "est_sec": 6.61,
   "gap_before": 1.18,
   "role": "reply",
   "block": "moving_house.dlg28"
  },
  {
   "speaker": "user",
   "text": "Even if it travelled",
   "est_sec": 1.34,
   "gap_before": 0.99,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg28"
  },
  {
   "speaker": "user",
   "text": "standing up?",
   "est_sec": 0.72,
   "gap_before": 1.96,
   "event": "ordinary_request",
   "block": "moving_house.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Then you can usually switch it on sooner, maybe after an hour. Just give it a bit of time to cool down before you put food in.",
   "est_sec": 8.47,
   "gap_before": 0.67,
   "role": "reply",
   "block": "moving_house.dlg28"
  },
  {
   "speaker": "user",
   "text": "So I need a cool box for the first day.",
   "est_sec": 3.2,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "block": "moving_house.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Pack the cold food with some ice packs and you'll be fine.",
   "est_sec": 4.13,
   "gap_before": 0.9,
   "role": "reply",
   "block": "moving_house.dlg28"
  }
 ]
}
