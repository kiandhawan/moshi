 "est_total_sec": 50.85,
 "est_speech_sec": 39.23,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.66,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.91,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "Going uphill is fine, but my knees kill me on the way down.",
   "est_sec": 4.13,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "hiking.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "That's really common. Downhill puts a lot more load on the front of the knee.",
   "est_sec": 4.75,
   "gap_before": 0.96,
   "role": "reply",
   "block": "hiking.dlg8"
  },
  {
   "speaker": "user",
   "text": "Is there a trick?",
   "est_sec": 1.34,
   "gap_before": 1.15,
   "event": "ordinary_request",
   "block": "hiking.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Take shorter steps, keep your knees slightly bent, and don't lock them. Zigzagging on wide paths helps too.",
   "est_sec": 5.68,
   "gap_before": 0.37,
   "role": "reply",
   "block": "hiking.dlg8"
  },
  {
   "speaker": "user",
   "text": "My friend swears by poles.",
   "est_sec": 1.65,
   "gap_before": 0.91,
   "event": "ordinary_request",
   "block": "hiking.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "She's right. Poles take a good chunk of the strain off your knees on steep descents. Lengthen them a bit before you head down.",
   "est_sec": 7.54,
   "gap_before": 1.1,
   "role": "reply",
   "block": "hiking.dlg8"
  },
  {
   "speaker": "user",
   "text": "Okay. And should I",
   "est_sec": 1.34,
   "gap_before": 0.93,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg8"
  },
  {
   "speaker": "user",
   "text": "be doing exercises at home?",
   "est_sec": 1.65,
   "gap_before": 2.11,
   "event": "ordinary_request",
   "block": "hiking.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Yes, squats and step downs off a stair build the muscles that protect your knees. A few minutes a day makes a difference within weeks.",
   "est_sec": 7.85,
   "gap_before": 0.49,
   "role": "reply",
   "block": "hiking.dlg8"
  }
 ]
}
