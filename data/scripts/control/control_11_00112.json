 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.56,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.5,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "Is it safe to hike alone?",
   "est_sec": 1.96,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "hiking.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "It can be, with some precautions. Pick a well used trail, and always tell someone where you're going and when you'll be back.",
   "est_sec": 7.23,
   "gap_before": 0.38,
   "role": "reply",
   "block": "hiking.dlg3"
  },
  {
   "speaker": "user",
   "text": "What if I get lost?",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "hiking.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Download an offline map before you go and carry a small battery pack for your phone. If you're unsure, stay where you are and call for help.",
   "est_sec": 8.47,
   "gap_before": 0.43,
   "role": "reply",
   "block": "hiking.dlg3"
  },
  {
   "speaker": "user",
   "text": "I'm retired, so I can go on weekdays when it's",
   "est_sec": 3.2,
   "gap_before": 0.64,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg3"
  },
  {
   "speaker": "user",
   "text": "really quiet.",
   "est_sec": 0.72,
   "gap_before": 1.56,
   "event": "ordinary_request",
   "block": "hiking.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "That's lovely, but quieter trails mean fewer people to help. Stick to routes you know until you're confident.",
   "est_sec": 5.68,
   "gap_before": 0.91,
   "role": "reply",
   "block": "hiking.dlg3"
  },
  {
   "speaker": "user",
   "text": "Good point. Maybe I'll join a walking group too.",
   "est_sec": 2.89,
   "gap_before": 0.81,
   "event": "ordinary_request",
   "block": "hiking.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "That's a great idea. Many groups do weekday hikes, and you'll learn new trails from them.",
   "est_sec": 5.06,
   "gap_before": 0.55,
   "role": "reply",
   "block": "hiking.dlg3"
  }
 ]
}
