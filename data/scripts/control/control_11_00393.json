 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.48,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.78,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "Five students, one house, one bathroom. It's grim. How do we split the cleaning?",
   "est_sec": 4.44,
   "gap_before": 0.6,
   "event": "ordinary_request",
   "block": "cleaning.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Make a rotating rota with five jobs, one per person, changing every week. Bathroom, kitchen, bins, hoover, and the shared living room.",
   "est_sec": 6.92,
   "gap_before": 0.53,
   "role": "reply",
   "block": "cleaning.dlg29"
  },
  {
   "speaker": "user",
   "text": "Someone will just not do it.",
   "est_sec": 1.96,
   "gap_before": 1.5,
   "event": "ordinary_request",
   "block": "cleaning.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Probably. Agree a small penalty together, like the slacker buys the next round of toilet roll and bin bags.",
   "est_sec": 5.99,
   "gap_before": 0.61,
   "role": "reply",
   "block": "cleaning.dlg29"
  },
  {
   "speaker": "user",
   "text": "Ha, that might actually work. Toilet roll is",
   "est_sec": 2.58,
   "gap_before": 0.37,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg29"
  },
  {
   "speaker": "user",
   "text": "weirdly expensive.",
   "est_sec": 0.72,
   "gap_before": 1.61,
   "event": "ordinary_request",
   "block": "cleaning.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Put the rota in your group chat and on the fridge, and do a quick check-in every Sunday.",
   "est_sec": 5.99,
   "gap_before": 1.14,
   "role": "reply",
   "block": "cleaning.dlg29"
  },
  {
   "speaker": "user",
   "text": "I'll draw it up tonight.",
   "est_sec": 1.65,
   "gap_before": 0.65,
   "event": "ordinary_request",
   "block": "cleaning.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "And maybe start with yourself on bathroom duty, it sets a good tone.",
   "est_sec": 4.13,
   "gap_before": 0.58,
   "role": "reply",
   "block": "cleaning.dlg29"
  }
 ]
