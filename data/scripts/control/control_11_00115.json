 "est_total_sec": 55.4,
 "est_speech_sec": 39.54,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.42,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.83,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "I left my umbrella on the bus this morning. It was my grandad's. Any chance of getting it back?",
   "est_sec": 5.99,
   "gap_before": 0.25,
   "event": "ordinary_request",
   "block": "public_transport.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Quite a good chance, actually. Lost items usually go to the depot first and then to a lost property office.",
   "est_sec": 6.3,
   "gap_before": 0.99,
   "role": "reply",
   "block": "public_transport.dlg7"
  },
  {
   "speaker": "user",
   "text": "How do I find them?",
   "est_sec": 1.65,
   "gap_before": 1.19,
   "event": "ordinary_request",
   "block": "public_transport.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Call the bus company or fill in their lost property form. Tell them the route number, rough time, and describe the umbrella.",
   "est_sec": 6.92,
   "gap_before": 1.01,
   "role": "reply",
   "block": "public_transport.dlg7"
  },
  {
   "speaker": "user",
   "text": "It's black with a",
   "est_sec": 1.34,
   "gap_before": 1.38,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg7"
  },
  {
   "speaker": "user",
   "text": "wooden duck head handle.",
   "est_sec": 1.34,
   "gap_before": 2.62,
   "event": "ordinary_request",
   "block": "public_transport.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "That's distinctive, which helps a lot. Mention the duck handle, it'll stand out among all the plain black ones.",
   "est_sec": 5.99,
   "gap_before": 1.62,
   "role": "reply",
   "block": "public_transport.dlg7"
  },
  {
   "speaker": "user",
   "text": "Hold on a sec, how long do they keep stuff?",
   "est_sec": 3.2,
   "gap_before": 3.32,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_17",
   "block": "public_transport.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Often a few weeks, so it's worth calling today.",
   "est_sec": 2.89,
   "gap_before": 0.73,
   "role": "reply",
   "block": "public_transport.dlg7"
  }
 ]
}
