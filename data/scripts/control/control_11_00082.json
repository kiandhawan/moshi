 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.67,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.73,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "The light in my hallway flickers. Is my house haunted?",
   "est_sec": 3.2,
   "gap_before": 0.34,
   "event": "ordinary_request",
   "block": "home_repair.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Ha, probably not. The most common cause is a loose bulb, or a bulb that doesn't match the dimmer.",
   "est_sec": 5.99,
   "gap_before": 0.63,
   "role": "reply",
   "block": "home_repair.dlg6"
  },
  {
   "speaker": "user",
   "text": "There is a dimmer, yeah.",
   "est_sec": 1.65,
   "gap_before": 1.18,
   "event": "ordinary_request",
   "block": "home_repair.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Some LED bulbs don't play nicely with older dimmers. Look on the box for the word dimmable.",
   "est_sec": 5.37,
   "gap_before": 0.65,
   "role": "reply",
   "block": "home_repair.dlg6"
  },
  {
   "speaker": "user",
   "text": "Wait, oh. I bought the cheapest ones.",
   "est_sec": 2.27,
   "gap_before": 0.7,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_13",
   "block": "home_repair.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "That's likely it. Swap in a dimmable bulb and see if the flicker stops.",
   "est_sec": 4.44,
   "gap_before": 1.49,
   "role": "reply",
   "block": "home_repair.dlg6"
  },
  {
   "speaker": "user",
   "text": "And if it doesn't?",
   "est_sec": 1.34,
   "gap_before": 1.15,
   "event": "ordinary_request",
   "block": "home_repair.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Then it could be a loose connection in the switch or fitting. That one's worth having an electrician check.",
   "est_sec": 5.99,
   "gap_before": 0.33,
   "role": "reply",
   "block": "home_repair.dlg6"
  }
 ]
}
