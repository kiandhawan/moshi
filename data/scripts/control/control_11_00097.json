 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.75,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.65,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "The school says if you hand out invitations in class you have to invite everyone. That's twenty eight kids.",
   "est_sec": 5.99,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "birthday_party.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "That's a common rule to avoid hurt feelings. Do you want the whole class, or just a few close friends?",
   "est_sec": 6.3,
   "gap_before": 0.38,
   "role": "reply",
   "block": "birthday_party.dlg23"
  },
  {
   "speaker": "user",
   "text": "Just a few. Like six.",
   "est_sec": 1.65,
   "gap_before": 1.25,
   "event": "ordinary_request",
   "block": "birthday_party.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Then skip the classroom route and invite those six privately, by message to their parents or by post.",
   "est_sec": 5.68,
   "gap_before": 0.34,
   "role": "reply",
   "block": "birthday_party.dlg23"
  },
  {
   "speaker": "user",
   "text": "Won't the others hear about it anyway?",
   "est_sec": 2.27,
   "gap_before": 2.4,
   "event": "ordinary_request",
   "block": "birthday_party.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Possibly. You can ask your child to keep it low key at school, and most kids understand that not every party is for everyone.",
   "est_sec": 7.54,
   "gap_before": 0.52,
   "role": "reply",
   "block": "birthday_party.dlg23"
  },
  {
   "speaker": "user",
   "text": "I just don't want her",
   "est_sec": 1.65,
   "gap_before": 1.51,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg23"
  },
  {
   "speaker": "user",
   "text": "to be the mean girl, you know?",
   "est_sec": 2.27,
   "gap_before": 2.7,
   "event": "ordinary_request",
   "block": "birthday_party.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "A small party isn't mean. What matters is how she talks about it at school, and you can help her with that.",
   "est_sec": 6.92,
   "gap_before": 0.5,
   "role": "reply",
   "block": "birthday_party.dlg23"
  }
 ]
}
