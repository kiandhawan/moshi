 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.98,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "I just moved into an apartment and the oven is disgusting. Where do I even start?",
   "est_sec": 5.06,
   "gap_before": 0.41,
   "event": "ordinary_request",
   "block": "cleaning.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Take the racks out and soak them in the bathtub with hot water and dish soap. Then coat the inside with a baking soda paste and leave it overnight.",
   "est_sec": 9.09,
   "gap_before": 1.6,
   "role": "reply",
   "block": "cleaning.dlg4"
  },
  {
   "speaker": "user",
   "text": "Overnight? I was hoping",
   "est_sec": 1.34,
   "gap_before": 1.25,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg4"
  },
  {
   "speaker": "user",
   "text": "to cook something tonight.",
   "est_sec": 1.34,
   "gap_before": 1.87,
   "event": "ordinary_request",
   "block": "cleaning.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "You can cook tonight and start the paste after. Cleaning a slightly warm oven is actually a bit easier.",
   "est_sec": 5.99,
   "gap_before": 0.36,
   "role": "reply",
   "block": "cleaning.dlg4"
  },
  {
   "speaker": "user",
   "text": "What do I do in the morning?",
   "est_sec": 2.27,
   "gap_before": 2.49,
   "event": "ordinary_request",
   "block": "cleaning.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Wipe off the paste with a damp cloth, then spray a little vinegar on the leftover bits. It fizzes and loosens them.",
   "est_sec": 6.92,
   "gap_before": 0.79,
   "role": "reply",
   "block": "cleaning.dlg4"
  },
  {
   "speaker": "user",
   "text": "And the glass on the door?",
   "est_sec": 1.96,
   "gap_before": 0.32,
   "event": "ordinary_request",
   "block": "cleaning.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Same paste, then a razor scraper held flat for the tough spots. Go gently so you don't scratch it.",
   "est_sec": 5.99,
   "gap_before": 0.72,
   "role": "reply",
   "block": "cleaning.dlg4"
  }
 ]
}
