 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.39,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "Honestly, is a first birthday party worth it? The baby won't remember it.",
   "est_sec": 4.13,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "birthday_party.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "True, she won't. But the party is often more for the parents and the family who've helped this year.",
   "est_sec": 5.99,
   "gap_before": 1.89,
   "role": "reply",
   "block": "birthday_party.dlg21"
  },
  {
   "speaker": "user",
   "text": "That's kind of how I feel. Everyone's been amazing.",
   "est_sec": 2.89,
   "gap_before": 2.69,
   "event": "ordinary_request",
   "block": "birthday_party.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Then a small thank you gathering could be lovely. Keep it short and around nap times so nobody ends up in tears.",
   "est_sec": 6.92,
   "gap_before": 0.94,
   "role": "reply",
   "block": "birthday_party.dlg21"
  },
  {
   "speaker": "user",
   "text": "Including me.",
   "est_sec": 0.72,
   "gap_before": 0.82,
   "event": "ordinary_request",
   "block": "birthday_party.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Including you. Two hours, simple food, and a smash cake for the photos is plenty.",
   "est_sec": 4.75,
   "gap_before": 0.54,
   "role": "reply",
   "block": "birthday_party.dlg21"
  },
  {
   "speaker": "user",
   "text": "What's a smash cake?",
   "est_sec": 1.34,
   "gap_before": 1.41,
   "event": "ordinary_request",
   "block": "birthday_party.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "A small cake just for the baby to grab and squash. Messy, but it makes great pictures.",
   "est_sec": 5.37,
   "gap_before": 1.01,
   "role": "reply",
   "block": "birthday_party.dlg21"
  }
 ]
}
