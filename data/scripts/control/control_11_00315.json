 "est_total_sec": 62.21,
 "est_speech_sec": 47.8,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.88,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "Someone's selling a fridge freezer online for cheap. What should I check before I hand over money?",
   "est_sec": 5.37,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "shopping.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Ask to see it running. It should be cold inside and the freezer should be properly frozen, not just cool.",
   "est_sec": 6.3,
   "gap_before": 0.98,
   "role": "reply",
   "block": "shopping.dlg18"
  },
  {
   "speaker": "user",
   "text": "Hold on, that's not right.",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_07",
   "block": "shopping.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "I'm fairly sure about it, but I could be wrong. What sounds off to you?",
   "est_sec": 4.75,
   "gap_before": 1.16,
   "role": "reply",
   "block": "shopping.dlg18"
  },
  {
   "speaker": "user",
   "text": "Anything else?",
   "est_sec": 0.72,
   "gap_before": 0.72,
   "event": "ordinary_request",
   "block": "shopping.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Look at the door seals. Close the door on a piece of paper, if it slides out easily, the seal is worn.",
   "est_sec": 6.92,
   "gap_before": 1.91,
   "role": "reply",
   "block": "shopping.dlg18"
  },
  {
   "speaker": "user",
   "text": "Ooh, that's a good trick.",
   "est_sec": 1.65,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "shopping.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Also check for rust at the bottom, smells, and a loud buzzing or rattling. Ask how old it is.",
   "est_sec": 5.99,
   "gap_before": 0.65,
   "role": "reply",
   "block": "shopping.dlg18"
  },
  {
   "speaker": "user",
   "text": "They said around six years, I think.",
   "est_sec": 2.27,
   "gap_before": 0.6,
   "event": "distractor",
   "kind": "pause",
   "block": "shopping.dlg18"
  },
  {
   "speaker": "user",
   "text": "Or seven.",
   "est_sec": 0.72,
   "gap_before": 2.39,
   "event": "ordinary_request",
   "block": "shopping.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "That's fine for a fridge, many last over a decade. Just remember it should stand upright for a few hours after moving before you switch it on.",
   "est_sec": 8.47,
   "gap_before": 1.67,
   "role": "reply",
   "block": "shopping.dlg18"
  }
 ]
}
