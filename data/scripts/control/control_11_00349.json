 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.37,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "My wife talks in her sleep. Last night she said, very clearly, the penguins are late.",
   "est_sec": 5.06,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "sleep.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "That's a great one. Sleep talking is really common and usually harmless, especially if she's stressed or overtired.",
   "est_sec": 5.68,
   "gap_before": 0.97,
   "role": "reply",
   "block": "sleep.dlg6"
  },
  {
   "speaker": "user",
   "text": "Should I wake her up?",
   "est_sec": 1.65,
   "gap_before": 3.29,
   "event": "ordinary_request",
   "block": "sleep.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "No need. She probably won't remember it and waking her can just confuse her.",
   "est_sec": 4.44,
   "gap_before": 0.41,
   "role": "reply",
   "block": "sleep.dlg6"
  },
  {
   "speaker": "user",
   "text": "Hold on a sec, it's mostly funny but sometimes it",
   "est_sec": 3.2,
   "gap_before": 1.47,
   "event": "distractor",
   "kind": "pause",
   "block": "sleep.dlg6"
  },
  {
   "speaker": "user",
   "text": "keeps me awake.",
   "est_sec": 1.03,
   "gap_before": 2.22,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_17",
   "block": "sleep.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Earplugs or a soft white noise in the background can help you sleep through it.",
   "est_sec": 4.75,
   "gap_before": 0.97,
   "role": "reply",
   "block": "sleep.dlg6"
  },
  {
   "speaker": "user",
   "text": "I might start writing them down instead. The penguin one is going on the fridge.",
   "est_sec": 4.75,
   "gap_before": 1.03,
   "event": "ordinary_request",
   "block": "sleep.dlg6"
  },
  {
