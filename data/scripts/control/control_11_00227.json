 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.73,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.75,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "I've listened to the same five albums for a year. How do I find new music?",
   "est_sec": 5.06,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "music.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "A good start is going one step out from what you like. Look up the bands that toured with your favourites, they often have a similar sound.",
   "est_sec": 8.47,
   "gap_before": 0.6,
   "role": "reply",
   "block": "music.dlg31"
  },
  {
   "speaker": "user",
   "text": "Oh, I never",
   "est_sec": 1.03,
   "gap_before": 0.32,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg31"
  },
  {
   "speaker": "user",
   "text": "thought of the support acts.",
   "est_sec": 1.65,
   "gap_before": 2.68,
   "event": "ordinary_request",
   "block": "music.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "They're a goldmine. Also, local radio and small venue listings are great for fresh stuff.",
   "est_sec": 4.75,
   "gap_before": 1.02,
   "role": "reply",
   "block": "music.dlg31"
  },
  {
   "speaker": "user",
   "text": "Algorithms just give me the same thing.",
   "est_sec": 2.27,
   "gap_before": 0.85,
   "event": "ordinary_request",
   "block": "music.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "True, they lean safe. Try asking a friend for three songs they love right now. People's picks are much more surprising.",
   "est_sec": 6.61,
   "gap_before": 1.2,
   "role": "reply",
   "block": "music.dlg31"
  },
  {
   "speaker": "user",
   "text": "Okay, that's actually a fun idea.",
   "est_sec": 1.96,
   "gap_before": 1.08,
   "event": "ordinary_request",
   "block": "music.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Swap with them too. You'll both end up with something new.",
   "est_sec": 3.51,
   "gap_before": 0.46,
   "role": "reply",
   "block": "music.dlg31"
  }
 ]
}
