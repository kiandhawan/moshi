 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.68,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.63,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "I don't have buttermilk and the recipe needs it. Any way around that?",
   "est_sec": 4.13,
   "gap_before": 0.4,
   "event": "ordinary_request",
   "block": "baking.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Easy fix. Stir a tablespoon of lemon juice or vinegar into a cup of regular milk and let it sit five minutes.",
   "est_sec": 6.92,
   "gap_before": 0.67,
   "role": "reply",
   "block": "baking.dlg3"
  },
  {
   "speaker": "user",
   "text": "It'll curdle, right? Is that okay?",
   "est_sec": 1.96,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "baking.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "That's exactly what you want. It thickens and gets tangy like buttermilk.",
   "est_sec": 3.82,
   "gap_before": 1.11,
   "role": "reply",
   "block": "baking.dlg3"
  },
  {
   "speaker": "user",
   "text": "Great. Oh, and I'm also",
   "est_sec": 1.65,
   "gap_before": 1.03,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg3"
  },
  {
   "speaker": "user",
   "text": "out of eggs. Is that a disaster?",
   "est_sec": 2.27,
   "gap_before": 2.02,
   "event": "ordinary_request",
   "block": "baking.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Not for most cakes. A quarter cup of plain yogurt or mashed banana can replace one egg.",
   "est_sec": 5.37,
   "gap_before": 0.68,
   "role": "reply",
   "block": "baking.dlg3"
  },
  {
   "speaker": "user",
   "text": "I have yogurt. Okay, I'm saved.",
   "est_sec": 1.96,
   "gap_before": 1.1,
   "event": "ordinary_request",
   "block": "baking.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Nice save. Enjoy your baking.",
