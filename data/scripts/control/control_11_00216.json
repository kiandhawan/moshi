 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.49,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "I always waste my weekends. How do people actually get stuff done?",
   "est_sec": 3.82,
   "gap_before": 0.34,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "One trick is to pick just one or two things you really want to do, and leave the rest of the time free.",
   "est_sec": 7.23,
   "gap_before": 0.54,
   "role": "reply",
   "block": "weekend_plans.dlg4"
  },
  {
   "speaker": "user",
   "text": "Only two? That seems like nothing.",
   "est_sec": 1.96,
   "gap_before": 1.3,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "It's enough. Most people try to cram in ten and end up doing none of them.",
   "est_sec": 5.06,
   "gap_before": 0.46,
   "role": "reply",
   "block": "weekend_plans.dlg4"
  },
  {
   "speaker": "user",
   "text": "Fair. This weekend I want to",
   "est_sec": 1.96,
   "gap_before": 1.37,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg4"
  },
  {
   "speaker": "user",
   "text": "finally sort out my wardrobe.",
   "est_sec": 1.65,
   "gap_before": 2.64,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Great. Do it Saturday morning while you've got energy, then you'll have the rest of the weekend to relax.",
   "est_sec": 5.99,
   "gap_before": 0.35,
   "role": "reply",
   "block": "weekend_plans.dlg4"
  },
  {
   "speaker": "user",
   "text": "And the second thing could be seeing a friend.",
   "est_sec": 2.89,
   "gap_before": 1.06,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Perfect balance, one chore and one treat. You'll feel like you had a real weekend.",
   "est_sec": 4.75,
   "gap_before": 0.55,
   "role": "reply",
   "block": "weekend_plans.dlg4"
  }
 ]
}
