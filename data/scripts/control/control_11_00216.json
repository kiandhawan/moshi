 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.66,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.89,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "My first piano recital is in two weeks and I keep imagining my hands shaking.",
   "est_sec": 4.75,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "music.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Very normal. The best thing you can do is practise performing, not just practising. Play your piece for family or friends, or even your phone camera.",
   "est_sec": 8.16,
   "gap_before": 0.99,
   "role": "reply",
   "block": "music.dlg14"
  },
  {
   "speaker": "user",
   "text": "Even the camera makes me nervous.",
   "est_sec": 1.96,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "music.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "That's good actually, it's the same feeling in a safer place. The more you do it, the less scary it gets.",
   "est_sec": 6.61,
   "gap_before": 0.86,
   "role": "reply",
   "block": "music.dlg14"
  },
  {
   "speaker": "user",
   "text": "What if I",
   "est_sec": 1.03,
   "gap_before": 2.78,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg14"
  },
  {
   "speaker": "user",
   "text": "mess up in the middle?",
   "est_sec": 1.65,
   "gap_before": 1.67,
   "event": "ordinary_request",
   "block": "music.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Keep going no matter what. Practise starting from a few spots in the piece, so if you slip, you can jump back in.",
   "est_sec": 7.23,
   "gap_before": 0.65,
   "role": "reply",
   "block": "music.dlg14"
  },
  {
   "speaker": "user",
   "text": "And on the day?",
   "est_sec": 1.34,
   "gap_before": 1.46,
   "event": "ordinary_request",
   "block": "music.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Warm your hands, breathe slowly before you start, and remember the audience wants you to do well.",
   "est_sec": 5.37,
   "gap_before": 0.5,
   "role": "reply",
   "block": "music.dlg14"
  }
 ]
