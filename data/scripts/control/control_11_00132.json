 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.53,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.43,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "My flight lands in Madrid at half past eleven at night. Taxi or train into the city?",
   "est_sec": 5.37,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "travel_planning.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "At that hour, a taxi is probably easiest. Madrid has a fixed taxi fare from the airport to the center.",
   "est_sec": 6.3,
   "gap_before": 0.89,
   "role": "reply",
   "block": "travel_planning.dlg20"
  },
  {
   "speaker": "user",
   "text": "Oh, fixed? So no surprises.",
   "est_sec": 1.65,
   "gap_before": 1.33,
   "event": "ordinary_request",
   "block": "travel_planning.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Just use the official taxi rank outside arrivals.",
   "est_sec": 2.89,
   "gap_before": 1.86,
   "role": "reply",
   "block": "travel_planning.dlg20"
  },
  {
   "speaker": "user",
   "text": "Would the metro still be running?",
   "est_sec": 1.96,
   "gap_before": 0.39,
   "event": "ordinary_request",
   "block": "travel_planning.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "It usually runs until about half past one, but with luggage and a late arrival, it's more hassle.",
   "est_sec": 5.68,
   "gap_before": 0.98,
   "role": "reply",
   "block": "travel_planning.dlg20"
  },
  {
   "speaker": "user",
   "text": "Right. I'll be tired and",
   "est_sec": 1.65,
   "gap_before": 2.11,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg20"
  },
  {
   "speaker": "user",
   "text": "probably grumpy, honestly.",
   "est_sec": 1.03,
   "gap_before": 2.26,
   "event": "ordinary_request",
   "block": "travel_planning.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Then the taxi is worth it. You'll be at your hotel in about half an hour.",
   "est_sec": 5.06,
   "gap_before": 1.19,
   "role": "reply",
   "block": "travel_planning.dlg20"
  }
 ]
}
