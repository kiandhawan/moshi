 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.8,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.35,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "I don't have buttermilk and the recipe needs it. Any way around that?",
   "est_sec": 4.13,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "baking.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Easy fix. Stir a tablespoon of lemon juice or vinegar into a cup of regular milk and let it sit five minutes.",
   "est_sec": 6.92,
   "gap_before": 0.34,
   "role": "reply",
   "block": "baking.dlg3"
  },
  {
   "speaker": "user",
   "text": "It'll curdle, right? Is that okay?",
   "est_sec": 1.96,
   "gap_before": 0.73,
   "event": "ordinary_request",
   "block": "baking.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "That's exactly what you want. It thickens and gets tangy like buttermilk.",
   "est_sec": 3.82,
   "gap_before": 0.39,
   "role": "reply",
   "block": "baking.dlg3"
  },
  {
   "speaker": "user",
   "text": "Great. Oh, and I'm also",
   "est_sec": 1.65,
   "gap_before": 1.49,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg3"
  },
  {
   "speaker": "user",
   "text": "out of eggs. Is that a disaster?",
   "est_sec": 2.27,
   "gap_before": 1.99,
   "event": "ordinary_request",
   "block": "baking.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Not for most cakes. A quarter cup of plain yogurt or mashed banana can replace one egg.",
   "est_sec": 5.37,
   "gap_before": 1.19,
   "role": "reply",
   "block": "baking.dlg3"
  },
  {
   "speaker": "user",
   "text": "I have yogurt. Okay, I'm saved.",
   "est_sec": 1.96,
   "gap_before": 1.22,
   "event": "ordinary_request",
   "block": "baking.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Nice save. Enjoy your baking.",
   "est_sec": 1.65,
   "gap_before": 1.15,
   "role": "reply",
   "block": "baking.dlg3"
  }
