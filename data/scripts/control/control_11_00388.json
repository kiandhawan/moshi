 "est_total_sec": 48.98,
 "est_speech_sec": 37.68,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.94,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I have six minutes to change trains tomorrow. Is that crazy?",
   "est_sec": 3.51,
   "gap_before": 0.23,
   "event": "ordinary_request",
   "block": "public_transport.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Tight, but often fine if both trains are at the same station and on time. Is it one ticket for the whole trip?",
   "est_sec": 7.23,
   "gap_before": 0.42,
   "role": "reply",
   "block": "public_transport.dlg18"
  },
  {
   "speaker": "user",
   "text": "Yeah, one booking.",
   "est_sec": 1.03,
   "gap_before": 0.87,
   "event": "ordinary_request",
   "block": "public_transport.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Then if you miss the connection because of a delay, you're usually allowed on the next train without paying again.",
   "est_sec": 6.3,
   "gap_before": 1.94,
   "role": "reply",
   "block": "public_transport.dlg18"
  },
  {
   "speaker": "user",
   "text": "Oh good. How can I make the change faster?",
   "est_sec": 2.89,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "public_transport.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Look up the platform numbers in advance, and sit near the doors in the carriage closest to the exit.",
   "est_sec": 5.99,
   "gap_before": 1.22,
   "role": "reply",
   "block": "public_transport.dlg18"
  },
  {
   "speaker": "user",
   "text": "And if it's",
   "est_sec": 1.03,
   "gap_before": 0.51,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg18"
  },
  {
   "speaker": "user",
   "text": "like a huge station?",
   "est_sec": 1.34,
   "gap_before": 2.28,
   "event": "ordinary_request",
   "block": "public_transport.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Then study the station map tonight. Knowing which way to turn saves more time than running.",
   "est_sec": 5.06,
   "gap_before": 0.39,
   "role": "reply",
   "block": "public_transport.dlg18"
  }
 ]
}
