 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.62,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.86,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "How far in advance should I send invitations for a birthday party?",
   "est_sec": 3.82,
   "gap_before": 0.22,
   "event": "ordinary_request",
   "block": "birthday_party.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "About three to four weeks ahead is ideal. For a kids' party, two to three weeks is usually fine.",
   "est_sec": 5.99,
   "gap_before": 1.08,
   "role": "reply",
   "block": "birthday_party.dlg3"
  },
  {
   "speaker": "user",
   "text": "And when should people reply by?",
   "est_sec": 1.96,
   "gap_before": 1.21,
   "event": "ordinary_request",
   "block": "birthday_party.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Ask for replies about a week before. That gives you time to order food and plan seating.",
   "est_sec": 5.37,
   "gap_before": 1.2,
   "role": "reply",
   "block": "birthday_party.dlg3"
  },
  {
   "speaker": "user",
   "text": "What if half of them never answer? That always happens",
   "est_sec": 3.2,
   "gap_before": 0.88,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg3"
  },
  {
   "speaker": "user",
   "text": "every single year.",
   "est_sec": 1.03,
   "gap_before": 2.78,
   "event": "ordinary_request",
   "block": "birthday_party.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Send a friendly reminder a couple of days after the deadline. Then plan for most of the quiet ones not coming.",
   "est_sec": 6.61,
   "gap_before": 0.3,
   "role": "reply",
   "block": "birthday_party.dlg3"
  },
  {
   "speaker": "user",
   "text": "Good point. Paper invites or just a group message?",
   "est_sec": 2.89,
   "gap_before": 0.78,
   "event": "ordinary_request",
   "block": "birthday_party.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "A group message is quicker and easier to track. Paper is lovely for a milestone birthday, though.",
   "est_sec": 5.37,
   "gap_before": 1.36,
   "role": "reply",
   "block": "birthday_party.dlg3"
  }
 ]
}
