 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.58,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.66,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "How many hours of gaming a day is okay for a twelve year old?",
   "est_sec": 4.44,
   "gap_before": 0.21,
   "event": "ordinary_request",
   "block": "video_games.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "There's no magic number, but many parents aim for about an hour or two on school days, a bit more on weekends.",
   "est_sec": 6.92,
   "gap_before": 1.18,
   "role": "reply",
   "block": "video_games.dlg2"
  },
  {
   "speaker": "user",
   "text": "He'd play all day if I let him.",
   "est_sec": 2.58,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "video_games.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Most kids would. It helps to agree on rules together, so it feels less like a punishment.",
   "est_sec": 5.37,
   "gap_before": 0.45,
   "role": "reply",
   "block": "video_games.dlg2"
  },
  {
   "speaker": "user",
   "text": "What if he's in the middle of a match when time's up?",
   "est_sec": 3.82,
   "gap_before": 1.31,
   "event": "ordinary_request",
   "block": "video_games.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Give a warning about ten minutes before, so he can finish the round. Cutting off a match mid game usually causes a fight.",
   "est_sec": 7.23,
   "gap_before": 1.12,
   "role": "reply",
   "block": "video_games.dlg2"
  },
  {
   "speaker": "user",
   "text": "Wait, what did you say?",
   "est_sec": 1.65,
   "gap_before": 1.16,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_01",
   "block": "video_games.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Of course. Give a warning about ten minutes before, so he can finish the round. Cutting off a match mid game usually causes a fight.",
   "est_sec": 7.85,
   "gap_before": 0.47,
   "role": "reply",
   "block": "video_games.dlg2"
  },
  {
   "speaker": "user",
   "text": "That makes sense. I've been",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg2"
  },
  {
   "speaker": "user",
   "text": "just turning it off.",
   "est_sec": 1.34,
   "gap_before": 2.76,
   "event": "ordinary_request",
   "block": "video_games.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "A lot of parents do. The warning tends to make the whole thing much calmer.",
   "est_sec": 4.75,
   "gap_before": 0.57,
   "role": "reply",
   "block": "video_games.dlg2"
  }
 ]
