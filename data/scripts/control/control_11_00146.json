 "est_total_sec": 41.27,
 "est_speech_sec": 32.93,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.3,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "Can we talk about people eating hot food on the bus? Someone had a curry this morning.",
   "est_sec": 5.37,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "public_transport.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Ha, a classic commuter complaint. Strong smelling food in an enclosed space is definitely a common annoyance.",
   "est_sec": 5.37,
   "gap_before": 0.37,
   "role": "reply",
   "block": "public_transport.dlg25"
  },
  {
   "speaker": "user",
   "text": "Is it even allowed?",
   "est_sec": 1.34,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "public_transport.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "It depends on the city. Some networks ban eating altogether, others just ask people to be considerate.",
   "est_sec": 5.37,
   "gap_before": 1.14,
   "role": "reply",
   "block": "public_transport.dlg25"
  },
  {
   "speaker": "user",
   "text": "So I just suffer.",
   "est_sec": 1.34,
   "gap_before": 0.75,
   "event": "ordinary_request",
   "block": "public_transport.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Pretty much, unless there's a clear rule. You could move seats or open a window if there is one.",
   "est_sec": 5.99,
   "gap_before": 1.1,
   "role": "reply",
   "block": "public_transport.dlg25"
  },
  {
   "speaker": "user",
   "text": "I did move. Three times.",
   "est_sec": 1.65,
   "gap_before": 1.4,
   "event": "ordinary_request",
   "block": "public_transport.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "That's commitment. Maybe a little bottle of peppermint oil for emergencies?",
   "est_sec": 3.51,
   "gap_before": 0.4,
   "role": "reply",
   "block": "public_transport.dlg25"
  }
 ]
}
