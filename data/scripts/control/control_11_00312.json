 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.36,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "Hey, quick one. The garden centre has peat free compost and normal compost. Does it matter which?",
   "est_sec": 5.37,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "gardening.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "It matters for the environment. Peat comes from bogs that take thousands of years to form, so peat free is the kinder choice.",
   "est_sec": 7.23,
   "gap_before": 0.73,
   "role": "reply",
   "block": "gardening.dlg11"
  },
  {
   "speaker": "user",
   "text": "Is it worse for the plants though?",
   "est_sec": 2.27,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "gardening.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "The good peat free brands are pretty much as good now. They can dry out on top while still being wet underneath, so check with your finger before watering.",
   "est_sec": 9.09,
   "gap_before": 0.85,
   "role": "reply",
   "block": "gardening.dlg11"
  },
  {
   "speaker": "user",
   "text": "Okay. And for seeds? I'm doing",
   "est_sec": 1.96,
   "gap_before": 1.49,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg11"
  },
  {
   "speaker": "user",
   "text": "chillies and some flowers.",
   "est_sec": 1.34,
   "gap_before": 1.7,
   "event": "ordinary_request",
   "block": "gardening.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Get a fine peat free seed compost for those. It's lighter and has fewer nutrients, which seedlings actually prefer.",
   "est_sec": 5.99,
   "gap_before": 1.69,
   "role": "reply",
   "block": "gardening.dlg11"
  },
  {
   "speaker": "user",
   "text": "Right, seed compost for seeds, the big bag for everything else.",
   "est_sec": 3.51,
   "gap_before": 1.21,
   "event": "ordinary_request",
   "block": "gardening.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "That's it. Simple as that.",
   "est_sec": 1.65,
   "gap_before": 1.92,
   "role": "reply",
   "block": "gardening.dlg11"
  }
 ]
}
