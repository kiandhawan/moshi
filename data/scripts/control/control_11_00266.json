 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.66,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "My son wants a drum kit for his birthday. Please talk me out of it.",
   "est_sec": 4.75,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "music.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "I might talk you into an electronic kit instead. With headphones, you'd barely hear a thing.",
   "est_sec": 5.06,
   "gap_before": 0.32,
   "role": "reply",
   "block": "music.dlg4"
  },
  {
   "speaker": "user",
   "text": "Wait, really? How quiet are they?",
   "est_sec": 1.96,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "music.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Much quieter than real drums. You'll hear a soft tapping, but nothing like the full noise.",
   "est_sec": 5.06,
   "gap_before": 1.78,
   "role": "reply",
   "block": "music.dlg4"
  },
  {
   "speaker": "user",
   "text": "Are they expensive?",
   "est_sec": 1.03,
   "gap_before": 1.48,
   "event": "ordinary_request",
   "block": "music.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Beginner kits are often cheaper than acoustic ones. And they take up less room too.",
   "est_sec": 4.75,
   "gap_before": 0.61,
   "role": "reply",
   "block": "music.dlg4"
  },
  {
   "speaker": "user",
   "text": "Okay, you've",
   "est_sec": 0.72,
   "gap_before": 0.74,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg4"
  },
  {
   "speaker": "user",
   "text": "sort of convinced me. Should he take lessons?",
   "est_sec": 2.58,
   "gap_before": 2.16,
   "event": "ordinary_request",
   "block": "music.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "A few lessons early on are really worth it. Good habits from the start make practice much more fun.",
   "est_sec": 5.99,
   "gap_before": 1.11,
