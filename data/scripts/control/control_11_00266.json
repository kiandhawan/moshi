 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.55,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.65,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "My espresso shots taste really sour, and they come out in like ten seconds.",
   "est_sec": 4.44,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "coffee.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "That's a classic sign of the grind being too coarse. Water rushes through without pulling out enough flavour.",
   "est_sec": 5.68,
   "gap_before": 0.56,
   "role": "reply",
   "block": "coffee.dlg5"
  },
  {
   "speaker": "user",
   "text": "So, finer?",
   "est_sec": 0.72,
   "gap_before": 1.07,
   "event": "ordinary_request",
   "block": "coffee.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Yes, a little finer at a time. You're aiming for roughly twenty five to thirty seconds for a standard shot.",
   "est_sec": 6.3,
   "gap_before": 0.83,
   "role": "reply",
   "block": "coffee.dlg5"
  },
  {
   "speaker": "user",
   "text": "And if it starts",
   "est_sec": 1.34,
   "gap_before": 2.25,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg5"
  },
  {
   "speaker": "user",
   "text": "dripping really slowly?",
   "est_sec": 1.03,
   "gap_before": 2.68,
   "event": "ordinary_request",
   "block": "coffee.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Then you've gone too fine, and it'll taste bitter. Somewhere in the middle is the sweet spot.",
   "est_sec": 5.37,
   "gap_before": 0.92,
   "role": "reply",
   "block": "coffee.dlg5"
  },
  {
   "speaker": "user",
   "text": "How much coffee should I put in?",
   "est_sec": 2.27,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "coffee.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Weigh it if you can. Keep the dose the same each time and only change the grind, so you know what's making the difference.",
   "est_sec": 7.54,
   "gap_before": 0.33,
   "role": "reply",
   "block": "coffee.dlg5"
  }
 ]
}
