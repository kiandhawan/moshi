 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.8,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.62,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "I want to start a game night but I'm broke. Like properly broke.",
   "est_sec": 4.13,
   "gap_before": 0.26,
   "event": "ordinary_request",
   "block": "board_games.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "You can do it really cheaply. A deck of cards, paper and pens already give you dozens of games.",
   "est_sec": 5.99,
   "gap_before": 0.93,
   "role": "reply",
   "block": "board_games.dlg23"
  },
  {
   "speaker": "user",
   "text": "Paper games? Like what?",
   "est_sec": 1.34,
   "gap_before": 1.75,
   "event": "ordinary_request",
   "block": "board_games.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Things like word guessing games, drawing games, or making your own quiz. There are also print and play games you print at home for free.",
   "est_sec": 7.85,
   "gap_before": 0.33,
   "role": "reply",
   "block": "board_games.dlg23"
  },
  {
   "speaker": "user",
   "text": "I don't have a printer.",
   "est_sec": 1.65,
   "gap_before": 1.15,
   "event": "ordinary_request",
   "block": "board_games.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "A library often lets you print a few pages cheaply. Or ask friends to bring one game each, it costs you nothing.",
   "est_sec": 6.92,
   "gap_before": 0.4,
   "role": "reply",
   "block": "board_games.dlg23"
  },
  {
   "speaker": "user",
   "text": "And snacks, I guess they",
   "est_sec": 1.65,
   "gap_before": 3.33,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg23"
  },
  {
   "speaker": "user",
   "text": "could bring those too.",
   "est_sec": 1.34,
   "gap_before": 1.63,
   "event": "ordinary_request",
   "block": "board_games.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Definitely. Call it bring a snack, bring a game. People like contributing, and it makes it feel like everyone's night.",
   "est_sec": 6.3,
   "gap_before": 1.11,
   "role": "reply",
   "block": "board_games.dlg23"
  }
 ]
}
