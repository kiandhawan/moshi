   "gap_before": 1.0,
   "event": "ordinary_request",
   "block": "smartphones.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "It's in the accessibility settings. You can also turn up the call volume beyond normal and use video calls so he can lip-read.",
   "est_sec": 7.23,
   "gap_before": 0.64,
   "role": "reply",
   "block": "smartphones.dlg16"
  },
  {
   "speaker": "user",
   "text": "He'd love video calls. He'd get to see",
   "est_sec": 2.58,
   "gap_before": 2.83,
   "event": "distractor",
