 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.94,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "I run a little bakery and I need music for the shop. What works?",
   "est_sec": 4.44,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "music.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Something warm and relaxed that doesn't distract. Acoustic, soft soul or gentle jazz all work well in cafes and bakeries.",
   "est_sec": 6.3,
   "gap_before": 0.77,
   "role": "reply",
   "block": "music.dlg30"
  },
  {
   "speaker": "user",
   "text": "In the morning rush too?",
   "est_sec": 1.65,
   "gap_before": 1.46,
   "event": "ordinary_request",
   "block": "music.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "You could go a bit more upbeat in the morning and slower in the quiet afternoon. Music can actually change how fast people move.",
   "est_sec": 7.54,
   "gap_before": 0.8,
   "role": "reply",
   "block": "music.dlg30"
  },
  {
   "speaker": "user",
   "text": "Is there",
   "est_sec": 0.72,
   "gap_before": 1.58,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg30"
  },
  {
   "speaker": "user",
   "text": "a legal thing I need for that?",
   "est_sec": 2.27,
   "gap_before": 2.3,
   "event": "ordinary_request",
   "block": "music.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Usually yes. Playing music in a business often needs a licence, separate from your personal streaming account. Check what applies where you are.",
   "est_sec": 7.23,
   "gap_before": 0.31,
   "role": "reply",
   "block": "music.dlg30"
  },
  {
   "speaker": "user",
   "text": "Ugh, of course there is.",
   "est_sec": 1.65,
   "gap_before": 0.84,
   "event": "ordinary_request",
   "block": "music.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "There are business music services that include the licence, so you can sort it in one go.",
   "est_sec": 5.37,
   "gap_before": 0.36,
   "role": "reply",
   "block": "music.dlg30"
  }
 ]
