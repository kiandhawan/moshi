 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.55,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "Every interview asks where do you see yourself in five years and I just have no idea.",
   "est_sec": 5.37,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "job_interview.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "That's fine, they don't need a master plan. They mostly want to know you'll grow and stick around for a while.",
   "est_sec": 6.61,
   "gap_before": 1.08,
   "role": "reply",
   "block": "job_interview.dlg16"
  },
  {
   "speaker": "user",
   "text": "So I can just make something up?",
   "est_sec": 2.27,
   "gap_before": 2.47,
   "event": "ordinary_request",
   "block": "job_interview.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Better to say something honest but general. For example, I'd like to be really skilled at this work and maybe leading small projects.",
   "est_sec": 7.23,
   "gap_before": 0.43,
   "role": "reply",
   "block": "job_interview.dlg16"
  },
  {
   "speaker": "user",
   "text": "And if I actually want to change careers eventually?",
   "est_sec": 2.89,
   "gap_before": 1.21,
   "event": "ordinary_request",
   "block": "job_interview.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Leave that out. Focus on the next few years in this kind of role.",
   "est_sec": 4.44,
   "gap_before": 0.85,
   "role": "reply",
   "block": "job_interview.dlg16"
  },
  {
   "speaker": "user",
   "text": "Okay. So",
   "est_sec": 0.72,
   "gap_before": 1.07,
   "event": "distractor",
   "kind": "pause",
   "block": "job_interview.dlg16"
  },
  {
   "speaker": "user",
   "text": "honest, but not every detail.",
   "est_sec": 1.65,
   "gap_before": 2.23,
   "event": "ordinary_request",
   "block": "job_interview.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Honest, focused, and tied to what this job can offer you.",
   "est_sec": 3.82,
   "gap_before": 0.81,
   "role": "reply",
   "block": "job_interview.dlg16"
  }
 ]
}
