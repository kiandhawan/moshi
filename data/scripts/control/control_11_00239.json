 "est_total_sec": 50.12,
 "est_speech_sec": 38.61,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.67,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.34,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "I don't get the fare zones on this metro map at all.",
   "est_sec": 3.82,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "public_transport.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "They're usually rings around the centre. The more rings you cross, the more you pay.",
   "est_sec": 4.75,
   "gap_before": 1.71,
   "role": "reply",
   "block": "public_transport.dlg12"
  },
  {
   "speaker": "user",
   "text": "So if I live in zone three and work in zone one?",
   "est_sec": 3.82,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "public_transport.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "You'd need a ticket covering zones one to three, even if you never stop in zone two.",
   "est_sec": 5.37,
   "gap_before": 0.65,
   "role": "reply",
   "block": "public_transport.dlg12"
  },
  {
   "speaker": "user",
   "text": "Even though I",
   "est_sec": 1.03,
   "gap_before": 1.34,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg12"
  },
  {
   "speaker": "user",
   "text": "just pass through it?",
   "est_sec": 1.34,
   "gap_before": 1.67,
   "event": "ordinary_request",
   "block": "public_transport.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Yes, annoyingly. The fare is based on the whole area your journey covers, not just the ends.",
   "est_sec": 5.37,
   "gap_before": 0.86,
   "role": "reply",
   "block": "public_transport.dlg12"
  },
  {
   "speaker": "user",
   "text": "What if I get off in zone four by accident?",
   "est_sec": 3.2,
   "gap_before": 1.48,
   "event": "ordinary_request",
   "block": "public_transport.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Then you'd technically need to pay the difference. Most ticket machines can sort that out on the way out.",
   "est_sec": 5.99,
   "gap_before": 0.3,
   "role": "reply",
   "block": "public_transport.dlg12"
  }
 ]
}
