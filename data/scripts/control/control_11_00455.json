 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.38,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "We had a birthday party last night and the flat is wrecked. What comes first?",
   "est_sec": 4.75,
   "gap_before": 0.25,
   "event": "ordinary_request",
   "block": "cleaning.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Bin bags first. Walk through every room collecting rubbish and cans, it makes the biggest visual difference.",
   "est_sec": 5.37,
   "gap_before": 1.03,
   "role": "reply",
   "block": "cleaning.dlg20"
  },
  {
   "speaker": "user",
   "text": "Done. Now it's the sticky floor. Someone spilled punch everywhere.",
   "est_sec": 3.2,
   "gap_before": 2.1,
   "event": "ordinary_request",
   "block": "cleaning.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Dishes next, so the sink is free, and save floors for last, because you'll drip things while cleaning.",
   "est_sec": 5.68,
   "gap_before": 0.66,
   "role": "reply",
   "block": "cleaning.dlg20"
  },
  {
   "speaker": "user",
   "text": "Makes sense. Should I",
   "est_sec": 1.34,
   "gap_before": 0.66,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg20"
  },
  {
   "speaker": "user",
   "text": "should I mop twice?",
   "est_sec": 1.34,
   "gap_before": 1.7,
   "event": "ordinary_request",
   "block": "cleaning.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Mop once with warm soapy water, then once with clean water to lift the sticky film.",
   "est_sec": 5.06,
   "gap_before": 1.1,
   "role": "reply",
   "block": "cleaning.dlg20"
  },
  {
   "speaker": "user",
   "text": "Okay. I'm putting music on.",
   "est_sec": 1.65,
   "gap_before": 0.7,
   "event": "ordinary_request",
   "block": "cleaning.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Good plan. And drink some water, I'm guessing it was a good party.",
   "est_sec": 4.13,
   "gap_before": 1.47,
   "role": "reply",
   "block": "cleaning.dlg20"
  }
 ]
