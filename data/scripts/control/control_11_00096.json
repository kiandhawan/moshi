 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.71,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "How do I unclog a shower drain? It's basically a lake in there every morning.",
   "est_sec": 4.75,
   "gap_before": 0.22,
   "event": "ordinary_request",
   "block": "home_repair.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Most of the time it's hair. Can you remove the drain cover?",
   "est_sec": 3.82,
   "gap_before": 0.76,
   "role": "reply",
   "block": "home_repair.dlg21"
  },
  {
   "speaker": "user",
   "text": "Hold on, really?",
   "est_sec": 1.03,
   "gap_before": 0.86,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_11",
   "block": "home_repair.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Hmm, I believe it is. Which part doesn't sound right?",
   "est_sec": 3.2,
   "gap_before": 0.62,
   "role": "reply",
   "block": "home_repair.dlg21"
  },
  {
   "speaker": "user",
   "text": "There's one screw in the middle, so yeah.",
   "est_sec": 2.58,
   "gap_before": 1.39,
   "event": "ordinary_request",
   "block": "home_repair.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Great. Take it off and look. A cheap plastic drain snake, the long thing with little teeth, pulls hair out brilliantly.",
   "est_sec": 6.61,
   "gap_before": 1.48,
   "role": "reply",
   "block": "home_repair.dlg21"
  },
  {
   "speaker": "user",
   "text": "I don't have one of those.",
   "est_sec": 1.96,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "home_repair.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "You can bend a wire coat hanger into a small hook as a backup. Fish around gently and pull up.",
   "est_sec": 6.3,
   "gap_before": 0.5,
   "role": "reply",
   "block": "home_repair.dlg21"
  },
  {
   "speaker": "user",
   "text": "My housemate has very",
   "est_sec": 1.34,
   "gap_before": 2.6,
   "event": "distractor",
   "kind": "pause",
   "block": "home_repair.dlg21"
  },
  {
   "speaker": "user",
   "text": "very long hair, so I'm expecting horrors.",
   "est_sec": 2.27,
   "gap_before": 1.73,
   "event": "ordinary_request",
   "block": "home_repair.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Brace yourself then. Afterwards, a hair catcher over the drain will save you from doing this again.",
   "est_sec": 5.37,
   "gap_before": 0.59,
   "role": "reply",
   "block": "home_repair.dlg21"
  }
 ]
