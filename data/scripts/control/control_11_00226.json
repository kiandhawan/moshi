 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.42,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.82,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "I own about five hundred books. Moving them is going to destroy me.",
   "est_sec": 4.13,
   "gap_before": 0.36,
   "event": "ordinary_request",
   "block": "moving_house.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Use small boxes only. A big box full of books is too heavy to lift safely.",
   "est_sec": 5.06,
   "gap_before": 0.47,
   "role": "reply",
   "block": "moving_house.dlg11"
  },
  {
   "speaker": "user",
   "text": "Small boxes, got it.",
   "est_sec": 1.34,
   "gap_before": 0.89,
   "event": "ordinary_request",
   "block": "moving_house.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Pack them flat or with the spines down, not standing on their edges or they'll warp. Fill gaps with paper so they don't slide.",
   "est_sec": 7.54,
   "gap_before": 0.47,
   "role": "reply",
   "block": "moving_house.dlg11"
  },
  {
   "speaker": "user",
   "text": "Should I get rid of some?",
   "est_sec": 1.96,
   "gap_before": 0.85,
   "event": "ordinary_request",
   "block": "moving_house.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "This is the perfect moment to cull. Keep what you'd reread or love on your shelf, and donate the rest.",
   "est_sec": 6.3,
   "gap_before": 1.47,
   "role": "reply",
   "block": "moving_house.dlg11"
  },
  {
   "speaker": "user",
   "text": "That's going to be",
   "est_sec": 1.34,
   "gap_before": 0.31,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg11"
  },
  {
   "speaker": "user",
   "text": "emotionally difficult.",
   "est_sec": 0.72,
   "gap_before": 2.81,
   "event": "ordinary_request",
   "block": "moving_house.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Take it slowly. A good rule is, if you can't remember what it's about, it can go.",
   "est_sec": 5.37,
   "gap_before": 0.78,
   "role": "reply",
   "block": "moving_house.dlg11"
  }
 ]
}
