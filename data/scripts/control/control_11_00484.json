 "est_total_sec": 47.16,
 "est_speech_sec": 36.96,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.33,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.33,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "Is a park and ride worth it? I drive in every day and parking costs a fortune.",
   "est_sec": 5.37,
   "gap_before": 0.25,
   "event": "ordinary_request",
   "block": "public_transport.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Often, yes. You park on the edge of town for a flat fee and a bus takes you into the centre, usually with its own lanes.",
   "est_sec": 8.16,
   "gap_before": 0.32,
   "role": "reply",
   "block": "public_transport.dlg14"
  },
  {
   "speaker": "user",
   "text": "Doesn't the bus make it slower?",
   "est_sec": 1.96,
   "gap_before": 1.39,
   "event": "ordinary_request",
   "block": "public_transport.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Sometimes it's actually quicker at rush hour, since buses skip the queues. And you don't circle around looking for a space.",
   "est_sec": 6.61,
   "gap_before": 0.43,
   "role": "reply",
   "block": "public_transport.dlg14"
  },
  {
   "speaker": "user",
   "text": "How much",
   "est_sec": 0.72,
   "gap_before": 1.22,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg14"
  },
  {
   "speaker": "user",
   "text": "would I save, roughly?",
   "est_sec": 1.34,
   "gap_before": 2.7,
   "event": "ordinary_request",
   "block": "public_transport.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "It depends on your city, but many people save more than half compared to central parking. Check the weekly ticket, it's often cheaper still.",
   "est_sec": 7.54,
   "gap_before": 0.95,
   "role": "reply",
   "block": "public_transport.dlg14"
  },
  {
   "speaker": "user",
   "text": "I'll give it a go next week.",
   "est_sec": 2.27,
   "gap_before": 0.78,
   "block": "public_transport.dlg14"
  }
 ]
}
