 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.3,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.95,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "My son's in reception and he's supposed to read with me every night. He hates it.",
   "est_sec": 5.06,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "studying.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Lots of little ones push back. How long are the sessions now?",
   "est_sec": 3.82,
   "gap_before": 0.55,
   "role": "reply",
   "block": "studying.dlg10"
  },
  {
   "speaker": "user",
   "text": "About fifteen minutes, and it ends in a fight.",
   "est_sec": 2.89,
   "gap_before": 1.45,
   "event": "ordinary_request",
   "block": "studying.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Try five minutes instead, and stop while he's still enjoying it. Short and happy builds the habit better.",
   "est_sec": 5.68,
   "gap_before": 0.57,
   "role": "reply",
   "block": "studying.dlg10"
  },
  {
   "speaker": "user",
   "text": "Will the teacher mind?",
   "est_sec": 1.34,
   "gap_before": 0.82,
   "event": "ordinary_request",
   "block": "studying.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Teachers usually care much more about regular reading than long reading. A few calm minutes each night is great.",
   "est_sec": 5.99,
   "gap_before": 1.14,
   "role": "reply",
   "block": "studying.dlg10"
  },
  {
   "speaker": "user",
   "text": "He only wants",
   "est_sec": 1.03,
   "gap_before": 0.94,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg10"
  },
  {
   "speaker": "user",
   "text": "books about trucks.",
   "est_sec": 1.03,
   "gap_before": 2.11,
   "event": "ordinary_request",
   "block": "studying.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Then read about trucks. Any book that keeps him excited about reading is doing its job.",
   "est_sec": 5.06,
   "gap_before": 0.82,
   "role": "reply",
   "block": "studying.dlg10"
  }
 ]
