 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.65,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "I'm fifty two and I want to learn to read sheet music. Feeling a bit silly about it.",
   "est_sec": 5.68,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "music.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Not silly at all. Adults often pick it up faster than kids, because you can understand the logic behind it.",
   "est_sec": 6.3,
   "gap_before": 0.53,
   "role": "reply",
   "block": "music.dlg19"
  },
  {
   "speaker": "user",
   "text": "Where do I begin?",
   "est_sec": 1.34,
   "gap_before": 0.32,
   "event": "ordinary_request",
   "block": "music.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Start with the lines of the treble clef. The notes on the lines from bottom to top are E, G, B, D, F.",
   "est_sec": 7.23,
   "gap_before": 0.58,
   "role": "reply",
   "block": "music.dlg19"
  },
  {
   "speaker": "user",
   "text": "Is there a trick to",
   "est_sec": 1.65,
   "gap_before": 0.97,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg19"
  },
  {
   "speaker": "user",
   "text": "remembering that?",
   "est_sec": 0.72,
   "gap_before": 2.62,
   "event": "ordinary_request",
   "block": "music.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "A classic one is every good boy deserves fruit. The spaces in between spell face.",
   "est_sec": 4.75,
   "gap_before": 0.43,
   "role": "reply",
   "block": "music.dlg19"
  },
  {
   "speaker": "user",
   "text": "Oh, that's handy. And rhythm?",
   "est_sec": 1.65,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "music.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Learn a few note lengths first, like whole, half and quarter notes. Clap along to simple rhythms and you'll start reading them quickly.",
   "est_sec": 7.23,
   "gap_before": 0.62,
   "role": "reply",
   "block": "music.dlg19"
  },
  {
   "speaker": "user",
   "text": "This is less scary than I thought.",
   "est_sec": 2.27,
   "gap_before": 0.39,
   "event": "ordinary_request",
   "block": "music.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Ten minutes a day with a beginner book and you'll be surprised in a month.",
   "est_sec": 4.75,
   "gap_before": 0.98,
   "role": "reply",
   "block": "music.dlg19"
  }
 ]
