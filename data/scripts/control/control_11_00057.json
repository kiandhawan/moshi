 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.66,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "Why are films so badly mixed? I can't hear anyone talking and then an explosion wakes the baby.",
   "est_sec": 5.68,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "movies.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "It's a very common complaint. Films are mixed for big cinema speakers, so the quiet bits get very quiet at home.",
   "est_sec": 6.61,
   "gap_before": 0.88,
   "role": "reply",
   "block": "movies.dlg14"
  },
  {
   "speaker": "user",
   "text": "Can I do anything?",
   "est_sec": 1.34,
   "gap_before": 1.47,
   "event": "ordinary_request",
   "block": "movies.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Check your TV settings for something like night mode or dialogue boost. It squashes the loud and quiet parts together.",
   "est_sec": 6.3,
   "gap_before": 0.32,
   "role": "reply",
   "block": "movies.dlg14"
  },
  {
   "speaker": "user",
   "text": "I've never even",
   "est_sec": 1.03,
   "gap_before": 2.9,
   "event": "distractor",
   "kind": "pause",
   "block": "movies.dlg14"
  },
  {
   "speaker": "user",
   "text": "looked at those settings.",
   "est_sec": 1.34,
   "gap_before": 2.91,
   "event": "ordinary_request",
   "block": "movies.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Most people haven't. A small soundbar with a speech mode helps a lot too, since TV speakers are tiny.",
   "est_sec": 5.99,
   "gap_before": 1.06,
   "role": "reply",
   "block": "movies.dlg14"
  },
  {
   "speaker": "user",
   "text": "And subtitles, I guess.",
   "est_sec": 1.34,
   "gap_before": 1.01,
   "event": "ordinary_request",
   "block": "movies.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Honestly, loads of people use them now. Combined with night mode, you'll catch every line and the baby stays asleep.",
   "est_sec": 6.3,
   "gap_before": 0.53,
   "role": "reply",
   "block": "movies.dlg14"
  }
 ]
}
