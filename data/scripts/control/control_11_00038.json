 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.91,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "Can I take my dog on a long hike?",
   "est_sec": 2.89,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "hiking.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Most healthy adult dogs love it. How old is your dog, and what breed?",
   "est_sec": 4.44,
   "gap_before": 0.41,
   "role": "reply",
   "block": "hiking.dlg4"
  },
  {
   "speaker": "user",
   "text": "She's a three year old border collie.",
   "est_sec": 2.27,
   "gap_before": 1.99,
   "event": "ordinary_request",
   "block": "hiking.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Perfect, collies have tons of energy. She'll probably outlast you. Just build up the distance gradually.",
   "est_sec": 5.06,
   "gap_before": 1.17,
   "role": "reply",
   "block": "hiking.dlg4"
  },
  {
   "speaker": "user",
   "text": "What does she need to bring?",
   "est_sec": 1.96,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "block": "hiking.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Water and a collapsible bowl, some treats, and poo bags. Check her paws during breaks, rocky trails can hurt them.",
   "est_sec": 6.3,
   "gap_before": 1.04,
   "role": "reply",
   "block": "hiking.dlg4"
  },
  {
   "speaker": "user",
   "text": "Should I",
   "est_sec": 0.72,
   "gap_before": 1.3,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg4"
  },
  {
   "speaker": "user",
   "text": "keep her on the lead the whole time?",
   "est_sec": 2.58,
   "gap_before": 1.88,
   "event": "ordinary_request",
   "block": "hiking.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Check the trail rules first. Near livestock or wildlife, a lead is always the safer choice.",
   "est_sec": 5.06,
   "gap_before": 0.93,
   "role": "reply",
   "block": "hiking.dlg4"
  }
 ]
