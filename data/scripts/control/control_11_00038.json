 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.67,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.58,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "I commute an hour each way on the bus. Can I actually study on it?",
   "est_sec": 4.75,
   "gap_before": 0.22,
   "event": "ordinary_request",
   "block": "studying.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Definitely, it just needs the right kind of studying. Things that don't need much space or writing work best.",
   "est_sec": 5.99,
   "gap_before": 0.7,
   "role": "reply",
   "block": "studying.dlg21"
  },
  {
   "speaker": "user",
   "text": "Like flashcards?",
   "est_sec": 0.72,
   "gap_before": 2.67,
   "event": "ordinary_request",
   "block": "studying.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Flashcards are perfect. Podcasts or recorded lectures work too, and reading short sections on your phone.",
   "est_sec": 5.06,
   "gap_before": 1.11,
   "role": "reply",
   "block": "studying.dlg21"
  },
  {
   "speaker": "user",
   "text": "I get motion sick reading on buses.",
   "est_sec": 2.27,
   "gap_before": 1.5,
   "event": "ordinary_request",
   "block": "studying.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Then audio is your friend. Record yourself reading your notes and listen back, it's surprisingly effective.",
   "est_sec": 5.06,
   "gap_before": 1.06,
   "role": "reply",
   "block": "studying.dlg21"
  },
  {
   "speaker": "user",
   "text": "Listening to my own voice.",
   "est_sec": 1.65,
   "gap_before": 0.49,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg21"
  },
  {
   "speaker": "user",
   "text": "That sounds horrible.",
   "est_sec": 1.03,
   "gap_before": 2.29,
   "event": "ordinary_request",
   "block": "studying.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Everyone hates their own voice at first. You'll stop noticing it after a few days.",
   "est_sec": 4.75,
   "gap_before": 0.85,
   "role": "reply",
   "block": "studying.dlg21"
  }
