 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.64,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "Can I catch up on sleep at the weekend? I do five hours on weeknights.",
   "est_sec": 4.75,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "sleep.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "A little, but not fully. Weekend lie-ins help, but your body still feels the deficit during the week.",
   "est_sec": 5.68,
   "gap_before": 0.31,
   "role": "reply",
   "block": "sleep.dlg22"
  },
  {
   "speaker": "user",
   "text": "So it's pointless?",
   "est_sec": 1.03,
   "gap_before": 0.89,
   "event": "ordinary_request",
   "block": "sleep.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Not pointless, but sleeping in until noon can shift your body clock, and Monday morning hurts more.",
   "est_sec": 5.37,
   "gap_before": 0.49,
   "role": "reply",
   "block": "sleep.dlg22"
  },
  {
   "speaker": "user",
   "text": "Monday is",
   "est_sec": 0.72,
   "gap_before": 1.48,
   "event": "distractor",
   "kind": "pause",
   "block": "sleep.dlg22"
  },
  {
   "speaker": "user",
   "text": "always brutal, yeah.",
   "est_sec": 1.03,
   "gap_before": 2.06,
   "event": "ordinary_request",
   "block": "sleep.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Try to get even thirty more minutes on weeknights, and keep weekend lie-ins to an hour or so.",
   "est_sec": 5.68,
   "gap_before": 0.39,
   "role": "reply",
   "block": "sleep.dlg22"
  },
  {
   "speaker": "user",
   "text": "Thirty minutes I can probably manage.",
   "est_sec": 1.96,
   "gap_before": 0.88,
   "event": "ordinary_request",
   "block": "sleep.dlg22"
  },
  {
   "speaker": "moshi",
