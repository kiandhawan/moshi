 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.58,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.67,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "I took a year off before uni and now I feel like I've forgotten everything from school.",
   "est_sec": 5.37,
   "gap_before": 0.29,
   "event": "ordinary_request",
   "block": "studying.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Totally normal after a gap year. The good news is it comes back faster than you'd think.",
   "est_sec": 5.37,
   "gap_before": 0.82,
   "role": "reply",
   "block": "studying.dlg29"
  },
  {
   "speaker": "user",
   "text": "Should I study before term starts?",
   "est_sec": 1.96,
   "gap_before": 2.63,
   "event": "ordinary_request",
   "block": "studying.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "A little can help. Look at the reading list for your first module and pick one or two key texts.",
   "est_sec": 6.3,
   "gap_before": 0.99,
   "role": "reply",
   "block": "studying.dlg29"
  },
  {
   "speaker": "user",
   "text": "I'm doing engineering. There's a lot of maths.",
   "est_sec": 2.58,
   "gap_before": 0.75,
   "event": "ordinary_request",
   "block": "studying.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Then refresh your maths basics. Algebra, trigonometry and calculus from school are the foundations they'll build on.",
   "est_sec": 5.37,
   "gap_before": 1.91,
   "role": "reply",
   "block": "studying.dlg29"
  },
  {
   "speaker": "user",
   "text": "Ugh, calculus.",
   "est_sec": 0.72,
   "gap_before": 0.47,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg29"
  },
  {
   "speaker": "user",
   "text": "I was never good at that.",
   "est_sec": 1.96,
   "gap_before": 2.0,
   "event": "ordinary_request",
   "block": "studying.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Try a few online practice problems each day. Even an hour a week for a month will make the first lectures much easier.",
   "est_sec": 7.23,
