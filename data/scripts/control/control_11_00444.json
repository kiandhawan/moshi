 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.74,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.64,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "My train was over an hour late yesterday. Can I get money back?",
   "est_sec": 4.13,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "public_transport.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Very likely. Most operators pay compensation for delays, and an hour usually gets you a good chunk of the fare.",
   "est_sec": 6.3,
   "gap_before": 0.67,
   "role": "reply",
   "block": "public_transport.dlg6"
  },
  {
   "speaker": "user",
   "text": "How do I claim?",
   "est_sec": 1.34,
   "gap_before": 1.11,
   "event": "ordinary_request",
   "block": "public_transport.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Go to the operator's website and look for delay repay or something similar. You'll need your ticket details and the train time.",
   "est_sec": 6.92,
   "gap_before": 1.17,
   "role": "reply",
   "block": "public_transport.dlg6"
  },
  {
   "speaker": "user",
   "text": "I bought it",
   "est_sec": 1.03,
   "gap_before": 0.61,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg6"
  },
  {
   "speaker": "user",
   "text": "at the station though, a paper one.",
   "est_sec": 2.27,
   "gap_before": 2.82,
   "event": "ordinary_request",
   "block": "public_transport.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "That's fine. Take a photo of the ticket before you throw it away, and upload it with the claim.",
   "est_sec": 5.99,
   "gap_before": 0.46,
   "role": "reply",
   "block": "public_transport.dlg6"
  },
  {
   "speaker": "user",
   "text": "Is there a deadline?",
   "est_sec": 1.34,
   "gap_before": 0.96,
   "event": "ordinary_request",
   "block": "public_transport.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Usually around a month, so do it this week while you remember.",
   "est_sec": 3.82,
   "gap_before": 0.61,
   "role": "reply",
   "block": "public_transport.dlg6"
  },
  {
   "speaker": "user",
   "text": "Brilliant, I didn't know this existed.",
   "est_sec": 1.96,
   "gap_before": 0.71,
   "block": "public_transport.dlg6"
  }
 ]
}
