 "est_speech_sec": 38.3,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.65,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "Is it a good idea to plant tomatoes this weekend? It's been warm.",
   "est_sec": 4.13,
   "gap_before": 0.39,
   "event": "ordinary_request",
   "block": "weather_plans.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "It depends on the nights. Tomatoes don't like it when nights drop much below fifty degrees.",
   "est_sec": 5.06,
   "gap_before": 0.57,
   "role": "reply",
   "block": "weather_plans.dlg4"
  },
  {
   "speaker": "user",
   "text": "The forecast says one more cold night next Tuesday.",
   "est_sec": 2.89,
   "gap_before": 0.79,
   "event": "ordinary_request",
   "block": "weather_plans.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Then you could plant them and cover them that night with a sheet or a bucket. Or just wait a week.",
   "est_sec": 6.61,
   "gap_before": 0.9,
   "role": "reply",
   "block": "weather_plans.dlg4"
  },
  {
   "speaker": "user",
   "text": "I'm impatient, I want to plant them now",
   "est_sec": 2.58,
   "gap_before": 0.93,
   "event": "distractor",
   "kind": "pause",
   "block": "weather_plans.dlg4"
  },
  {
   "speaker": "user",
   "text": "but I don't want to lose them.",
   "est_sec": 2.27,
   "gap_before": 2.74,
   "event": "ordinary_request",
   "block": "weather_plans.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Plant them now and set a reminder for Tuesday evening to cover them. That's a fair compromise.",
   "est_sec": 5.37,
   "gap_before": 0.78,
   "role": "reply",
   "block": "weather_plans.dlg4"
  },
  {
   "speaker": "user",
   "text": "Would an old blanket work?",
   "est_sec": 1.65,
   "gap_before": 0.87,
   "event": "ordinary_request",
   "block": "weather_plans.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Yes, just take it off in the morning so the plants get light and don't overheat.",
   "est_sec": 5.06,
   "gap_before": 0.38,
   "role": "reply",
   "block": "weather_plans.dlg4"
  }
 ]
}
