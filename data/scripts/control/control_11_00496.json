 "est_total_sec": 54.69,
 "est_speech_sec": 42.02,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.48,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.78,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "Why is every photo I take in my kitchen orange? It's driving me mad.",
   "est_sec": 4.44,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "photography.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "That's white balance. Your kitchen bulbs are warm, and the camera isn't correcting for them.",
   "est_sec": 4.75,
   "gap_before": 0.71,
   "role": "reply",
   "block": "photography.dlg7"
  },
  {
   "speaker": "user",
   "text": "So it's the bulbs' fault.",
   "est_sec": 1.65,
   "gap_before": 0.95,
   "event": "ordinary_request",
   "block": "photography.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Partly. You can set white balance to the little light bulb icon, or tungsten, and it'll cool everything down.",
   "est_sec": 5.99,
   "gap_before": 0.84,
   "role": "reply",
   "block": "photography.dlg7"
  },
  {
   "speaker": "user",
   "text": "Wait a second, I'm on a phone, I don't have icons like that.",
   "est_sec": 4.13,
   "gap_before": 2.76,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_16",
   "block": "photography.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Most phone editors have a warmth or temperature slider. Pull it toward blue until the white plates look white again.",
   "est_sec": 6.3,
   "gap_before": 0.97,
   "role": "reply",
   "block": "photography.dlg7"
  },
  {
   "speaker": "user",
   "text": "That's a faff every single time.",
   "est_sec": 1.96,
   "gap_before": 1.22,
   "event": "ordinary_request",
   "block": "photography.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Then the easier fix is daylight bulbs in the kitchen. They make photos look natural and you'll see your food better while cooking too.",
   "est_sec": 7.54,
   "gap_before": 0.47,
   "role": "reply",
   "block": "photography.dlg7"
  },
  {
   "speaker": "user",
   "text": "Hm. I'll pick some up this weekend.",
   "est_sec": 2.27,
   "gap_before": 1.43,
   "block": "photography.dlg7"
  }
 ]
}
