 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.71,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.82,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I have tickets for an outdoor concert and it's meant to pour. What do I wear?",
   "est_sec": 5.06,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "weather_plans.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "A proper poncho or rain jacket with a hood. Many festivals don't allow umbrellas because they block the view.",
   "est_sec": 5.99,
   "gap_before": 0.75,
   "role": "reply",
   "block": "weather_plans.dlg24"
  },
  {
   "speaker": "user",
   "text": "What about shoes? I was going to wear trainers.",
   "est_sec": 2.89,
   "gap_before": 1.3,
   "event": "ordinary_request",
   "block": "weather_plans.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "If the ground is grass, it'll turn to mud quickly. Old boots or wellies would be much happier.",
   "est_sec": 5.68,
   "gap_before": 0.49,
   "role": "reply",
   "block": "weather_plans.dlg24"
  },
  {
   "speaker": "user",
   "text": "Can I bring a bag?",
   "est_sec": 1.65,
   "gap_before": 0.79,
   "event": "ordinary_request",
   "block": "weather_plans.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "Check the venue rules, many only allow small clear bags. A dry bag or a zip lock for your phone is a good idea.",
   "est_sec": 7.54,
   "gap_before": 0.52,
   "role": "reply",
   "block": "weather_plans.dlg24"
  },
  {
   "speaker": "user",
   "text": "Should I",
   "est_sec": 0.72,
   "gap_before": 1.33,
   "event": "distractor",
   "kind": "pause",
   "block": "weather_plans.dlg24"
  },
  {
   "speaker": "user",
   "text": "bring a change of clothes?",
   "est_sec": 1.65,
   "gap_before": 2.7,
   "event": "ordinary_request",
   "block": "weather_plans.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "Leave them in the car or a locker if you can. A dry pair of socks for the trip home feels amazing.",
   "est_sec": 6.92,
   "gap_before": 0.95,
   "role": "reply",
   "block": "weather_plans.dlg24"
  }
 ]
}
