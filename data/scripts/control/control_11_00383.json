 "est_speech_sec": 39.23,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.38,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "How do I write no gifts please on an invitation without sounding snooty?",
   "est_sec": 4.13,
   "gap_before": 0.23,
   "event": "ordinary_request",
   "block": "birthday_party.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Keep it warm and give a reason. For example, your company is the only present we need.",
   "est_sec": 5.37,
   "gap_before": 0.58,
   "role": "reply",
   "block": "birthday_party.dlg12"
  },
  {
   "speaker": "user",
   "text": "That's nice. But some people will bring something anyway.",
   "est_sec": 2.89,
   "gap_before": 0.74,
   "event": "ordinary_request",
   "block": "birthday_party.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "They will, and that's fine. Just thank them and don't open gifts in front of everyone, so nobody who came empty handed feels awkward.",
   "est_sec": 7.54,
   "gap_before": 1.12,
   "role": "reply",
   "block": "birthday_party.dlg12"
  },
  {
   "speaker": "user",
   "text": "Could I suggest a charity instead?",
   "est_sec": 1.96,
   "gap_before": 1.09,
   "event": "ordinary_request",
   "block": "birthday_party.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Sure. A line like, if you'd really like to give something, a donation to the local animal shelter would make her day.",
   "est_sec": 6.92,
   "gap_before": 0.85,
   "role": "reply",
   "block": "birthday_party.dlg12"
  },
  {
   "speaker": "user",
   "text": "She does love that shelter.",
   "est_sec": 1.65,
   "gap_before": 1.5,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg12"
  },
  {
   "speaker": "user",
   "text": "Okay, I'll use that.",
   "est_sec": 1.34,
   "gap_before": 2.4,
   "event": "ordinary_request",
   "block": "birthday_party.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Lovely. It turns the gift question into something she actually cares about.",
   "est_sec": 3.82,
   "gap_before": 0.81,
   "role": "reply",
   "block": "birthday_party.dlg12"
  }
 ]
}
