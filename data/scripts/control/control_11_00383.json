 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.41,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "What's the best way to get from Paris to Amsterdam?",
   "est_sec": 3.2,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "travel_planning.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "The train is easiest. It takes a bit over three hours and drops you right in the city center.",
   "est_sec": 5.99,
   "gap_before": 0.72,
   "role": "reply",
   "block": "travel_planning.dlg1"
  },
  {
   "speaker": "user",
   "text": "Is it expensive?",
   "est_sec": 1.03,
   "gap_before": 1.25,
   "event": "ordinary_request",
   "block": "travel_planning.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "It can be if you book late. Book a few weeks ahead and you'll often find much cheaper fares.",
   "est_sec": 5.99,
   "gap_before": 0.77,
   "role": "reply",
   "block": "travel_planning.dlg1"
  },
  {
   "speaker": "user",
   "text": "What about flying? It's only",
   "est_sec": 1.65,
   "gap_before": 1.39,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg1"
  },
  {
   "speaker": "user",
   "text": "like an hour in the air, right?",
   "est_sec": 2.27,
   "gap_before": 1.61,
   "event": "ordinary_request",
   "block": "travel_planning.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "About an hour, yes, but with getting to the airport and security it usually ends up slower than the train.",
   "est_sec": 6.3,
   "gap_before": 0.55,
   "role": "reply",
   "block": "travel_planning.dlg1"
  },
  {
   "speaker": "user",
   "text": "Okay, train it is. Should I stop somewhere on the way?",
   "est_sec": 3.51,
   "gap_before": 0.62,
   "event": "ordinary_request",
   "block": "travel_planning.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Brussels or Antwerp make a nice stop. You could spend an afternoon there and catch a later train.",
   "est_sec": 5.68,
   "gap_before": 0.65,
   "role": "reply",
   "block": "travel_planning.dlg1"
  }
 ]
