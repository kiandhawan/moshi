 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.94,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "I use a wheelchair and I want to build upper body strength. Where should I start?",
   "est_sec": 5.06,
   "gap_before": 0.27,
   "event": "ordinary_request",
   "block": "fitness.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Great goal. Resistance bands are a flexible place to start, you can anchor them to a door or your chair.",
   "est_sec": 6.3,
   "gap_before": 0.33,
   "role": "reply",
   "block": "fitness.dlg20"
  },
  {
   "speaker": "user",
   "text": "What exercises, though?",
   "est_sec": 1.03,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "fitness.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Seated rows, chest presses, shoulder presses and bicep curls all work well from your chair.",
   "est_sec": 4.75,
   "gap_before": 0.38,
   "role": "reply",
   "block": "fitness.dlg20"
  },
  {
   "speaker": "user",
   "text": "I've also got a pair of dumbbells somewhere.",
   "est_sec": 2.58,
   "gap_before": 1.06,
   "event": "ordinary_request",
   "block": "fitness.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Perfect. Add them for curls, overhead presses and lateral raises. Start light and focus on control.",
   "est_sec": 5.06,
   "gap_before": 0.42,
   "role": "reply",
   "block": "fitness.dlg20"
  },
  {
   "speaker": "user",
   "text": "My shoulders already",
   "est_sec": 1.03,
   "gap_before": 0.55,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg20"
  },
  {
   "speaker": "user",
   "text": "work hard pushing all day.",
   "est_sec": 1.65,
   "gap_before": 2.1,
   "event": "ordinary_request",
   "block": "fitness.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "That's an important point. Balance pushing with lots of pulling, like rows, to protect your shoulders. A physio with wheelchair experience could tailor a plan.",
   "est_sec": 7.85,
   "gap_before": 1.17,
   "role": "reply",
   "block": "fitness.dlg20"
  }
 ]
