 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.51,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.85,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "Gore really bothers me. Is there a way to check a film before I see it?",
   "est_sec": 5.06,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "movies.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Yes. Age ratings give you a rough idea, but parents' guide websites are much more detailed. They list violence and gore scene by scene.",
   "est_sec": 7.54,
   "gap_before": 1.38,
   "role": "reply",
   "block": "movies.dlg26"
  },
  {
   "speaker": "user",
   "text": "Without spoiling the plot?",
   "est_sec": 1.34,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "movies.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Mostly they describe the kind of content, like a stabbing in the second half, not the story. You can skim just the violence section.",
   "est_sec": 7.54,
   "gap_before": 0.96,
   "role": "reply",
   "block": "movies.dlg26"
  },
  {
   "speaker": "user",
   "text": "That's actually",
   "est_sec": 0.72,
   "gap_before": 1.12,
   "event": "distractor",
   "kind": "pause",
   "block": "movies.dlg26"
  },
  {
   "speaker": "user",
   "text": "really helpful, I didn't know those existed.",
   "est_sec": 2.27,
   "gap_before": 2.31,
   "event": "ordinary_request",
   "block": "movies.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "They're popular with parents, but anyone can use them. Plenty of adults are squeamish.",
   "est_sec": 4.44,
   "gap_before": 0.53,
   "role": "reply",
   "block": "movies.dlg26"
  },
  {
   "speaker": "user",
   "text": "And if I'm already in the cinema?",
   "est_sec": 2.27,
   "gap_before": 0.94,
   "event": "ordinary_request",
   "block": "movies.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Look slightly away from the screen, or focus on the exit sign. Tense music usually warns you a few seconds before.",
   "est_sec": 6.61,
   "gap_before": 0.72,
   "role": "reply",
   "block": "movies.dlg26"
  }
 ]
}
