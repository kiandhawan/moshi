 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.67,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.34,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "My son's eleven and wants to take the bus to school on his own. I'm terrified.",
   "est_sec": 5.06,
   "gap_before": 0.42,
   "event": "ordinary_request",
   "block": "public_transport.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Totally normal feeling. Lots of parents do a few trial runs together first, then let him lead while you follow.",
   "est_sec": 6.3,
   "gap_before": 1.01,
   "role": "reply",
   "block": "public_transport.dlg10"
  },
  {
   "speaker": "user",
   "text": "What should he know?",
   "est_sec": 1.34,
   "gap_before": 1.3,
   "event": "ordinary_request",
   "block": "public_transport.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Which stop to get off at, what to do if he misses it, and who to ask for help, like the driver.",
   "est_sec": 6.92,
   "gap_before": 0.41,
   "role": "reply",
   "block": "public_transport.dlg10"
  },
  {
   "speaker": "user",
   "text": "He has a phone, but",
   "est_sec": 1.65,
   "gap_before": 0.32,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg10"
  },
  {
   "speaker": "user",
   "text": "it's always on low battery.",
   "est_sec": 1.65,
   "gap_before": 2.89,
   "event": "ordinary_request",
   "block": "public_transport.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Then a small power bank in his bag is worth it. Also agree on a quick text when he arrives.",
   "est_sec": 6.3,
   "gap_before": 0.61,
   "role": "reply",
   "block": "public_transport.dlg10"
  },
  {
   "speaker": "user",
   "text": "Just one text?",
   "est_sec": 1.03,
   "gap_before": 0.64,
   "event": "ordinary_request",
   "block": "public_transport.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "One text, so it feels like independence and not surveillance. He'll be prouder than you expect.",
   "est_sec": 5.06,
   "gap_before": 1.98,
   "role": "reply",
   "block": "public_transport.dlg10"
  }
 ]
}
