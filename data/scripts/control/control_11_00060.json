 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.44,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.35,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "Is it actually cheaper to buy in bulk?",
   "est_sec": 2.58,
   "gap_before": 0.26,
   "event": "ordinary_request",
   "block": "shopping.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Often, yes, but only for things you'll use before they go bad. Toilet paper, rice and canned goods are safe bets.",
   "est_sec": 6.61,
   "gap_before": 0.62,
   "role": "reply",
   "block": "shopping.dlg2"
  },
  {
   "speaker": "user",
   "text": "What about fresh stuff?",
   "est_sec": 1.34,
   "gap_before": 2.16,
   "event": "ordinary_request",
   "block": "shopping.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "That's where people waste money. A huge bag of spinach is no deal if half of it wilts.",
   "est_sec": 5.68,
   "gap_before": 0.33,
   "role": "reply",
   "block": "shopping.dlg2"
  },
  {
   "speaker": "user",
   "text": "Fair. I live alone, so maybe bulk",
   "est_sec": 2.27,
   "gap_before": 1.37,
   "event": "distractor",
   "kind": "pause",
   "block": "shopping.dlg2"
  },
  {
   "speaker": "user",
   "text": "isn't really for me.",
   "est_sec": 1.34,
   "gap_before": 2.61,
   "event": "ordinary_request",
   "block": "shopping.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "It can still work. Split a bulk order with a friend or neighbor, or stick to things that freeze well.",
   "est_sec": 6.3,
   "gap_before": 0.47,
   "role": "reply",
   "block": "shopping.dlg2"
  },
  {
   "speaker": "user",
   "text": "Like what?",
   "est_sec": 0.72,
   "gap_before": 0.59,
   "event": "ordinary_request",
   "block": "shopping.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Bread, chicken, berries and butter all freeze nicely. Just portion them out before freezing.",
   "est_sec": 4.44,
   "gap_before": 1.05,
   "role": "reply",
   "block": "shopping.dlg2"
  }
 ]
}
