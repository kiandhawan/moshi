 "est_total_sec": 55.27,
 "est_speech_sec": 42.02,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.79,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "Every time I brake there's this high pitched squeal. It's embarrassing at traffic lights.",
   "est_sec": 4.44,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "cars.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "That's usually the brake pads. Many pads have a little metal tab that squeals on purpose when they're getting thin.",
   "est_sec": 6.3,
   "gap_before": 1.05,
   "role": "reply",
   "block": "cars.dlg6"
  },
  {
   "speaker": "user",
   "text": "On purpose? That's a cruel design.",
   "est_sec": 1.96,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "cars.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Annoying, but useful. It's the car telling you to book a brake check before the pads wear down to metal.",
   "est_sec": 6.3,
   "gap_before": 1.05,
   "role": "reply",
   "block": "cars.dlg6"
  },
  {
   "speaker": "user",
   "text": "How long can I",
   "est_sec": 1.34,
   "gap_before": 2.91,
   "event": "distractor",
   "kind": "pause",
   "block": "cars.dlg6"
  },
  {
   "speaker": "user",
   "text": "leave it?",
   "est_sec": 0.72,
   "gap_before": 1.66,
   "event": "ordinary_request",
   "block": "cars.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "I wouldn't leave it more than a couple of weeks. If it turns into a grinding sound, stop driving and get it looked at straight away.",
   "est_sec": 8.16,
   "gap_before": 0.46,
   "role": "reply",
   "block": "cars.dlg6"
  },
  {
   "speaker": "user",
   "text": "Is it a big job?",
   "est_sec": 1.65,
   "gap_before": 1.15,
   "event": "ordinary_request",
   "block": "cars.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Swapping pads is one of the cheaper repairs, usually under an hour. It gets pricey if the discs get damaged too, so sooner is better.",
   "est_sec": 7.85,
   "gap_before": 1.08,
   "role": "reply",
   "block": "cars.dlg6"
  }
 ]
}
