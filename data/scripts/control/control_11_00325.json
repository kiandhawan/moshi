 "est_speech_sec": 38.3,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.53,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "I freelance and my income is all over the place. How do I budget?",
   "est_sec": 4.44,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "block": "personal_finance.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Irregular income needs a slightly different approach. Start by working out your bare minimum monthly costs.",
   "est_sec": 5.06,
   "gap_before": 0.8,
   "role": "reply",
   "block": "personal_finance.dlg10"
  },
  {
   "speaker": "user",
   "text": "Like rent and food?",
   "est_sec": 1.34,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "personal_finance.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Yes, plus bills and any debt payments. That's your baseline. Then pay yourself a steady salary from a business account.",
   "est_sec": 6.3,
   "gap_before": 0.52,
   "role": "reply",
   "block": "personal_finance.dlg10"
  },
  {
   "speaker": "user",
   "text": "Even in months when I earn loads?",
   "est_sec": 2.27,
   "gap_before": 0.59,
   "event": "ordinary_request",
   "block": "personal_finance.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Especially then. Leave the extra in the business account to cover the slow months. And set some aside for tax.",
   "est_sec": 6.3,
   "gap_before": 1.18,
   "role": "reply",
   "block": "personal_finance.dlg10"
  },
  {
   "speaker": "user",
   "text": "Tax. Right. I always",
   "est_sec": 1.34,
   "gap_before": 1.11,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg10"
  },
  {
   "speaker": "user",
   "text": "forget about tax until it's too late.",
   "est_sec": 2.27,
   "gap_before": 2.77,
   "event": "ordinary_request",
   "block": "personal_finance.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Lots of freelancers do. A separate tax pot where you put a fixed percentage of every invoice makes it painless.",
   "est_sec": 6.3,
   "gap_before": 0.41,
   "role": "reply",
   "block": "personal_finance.dlg10"
  }
 ]
}
