 "est_speech_sec": 37.27,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.66,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.93,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "What's a good way to budget for Christmas so January isn't a disaster?",
   "est_sec": 4.13,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "personal_finance.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Start by deciding on a total limit, then split it between gifts, food, travel and decorations.",
   "est_sec": 5.06,
   "gap_before": 0.97,
   "role": "reply",
   "block": "personal_finance.dlg22"
  },
  {
   "speaker": "user",
   "text": "I always overspend on gifts.",
   "est_sec": 1.65,
   "gap_before": 1.13,
   "event": "ordinary_request",
   "block": "personal_finance.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Write down each person and a fixed amount next to their name. It's much easier to stick to.",
   "est_sec": 5.68,
   "gap_before": 0.31,
   "role": "reply",
   "block": "personal_finance.dlg22"
  },
  {
   "speaker": "user",
   "text": "My family does a lot of gifts, though.",
   "est_sec": 2.58,
   "gap_before": 1.06,
   "event": "ordinary_request",
   "block": "personal_finance.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "You could suggest a secret Santa for the adults. One nice gift each is often more fun than lots of small ones.",
   "est_sec": 6.92,
   "gap_before": 1.56,
   "role": "reply",
   "block": "personal_finance.dlg22"
  },
  {
   "speaker": "user",
   "text": "When should I start saving?",
   "est_sec": 1.65,
   "gap_before": 0.84,
   "event": "ordinary_request",
   "block": "personal_finance.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "If you put a little aside each month from January, it barely feels like anything by December.",
   "est_sec": 5.37,
   "gap_before": 0.36,
   "role": "reply",
   "block": "personal_finance.dlg22"
  }
 ]
}
