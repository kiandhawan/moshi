 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.85,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "I'm going to my first ever classical concert. When am I supposed to clap?",
   "est_sec": 4.44,
   "gap_before": 0.59,
   "event": "ordinary_request",
   "block": "music.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Good question, it confuses lots of people. Generally you clap at the end of a whole piece, not between the movements.",
   "est_sec": 6.61,
   "gap_before": 0.69,
   "role": "reply",
   "block": "music.dlg18"
  },
  {
   "speaker": "user",
   "text": "Hold on a sec, what's a movement?",
   "est_sec": 2.27,
   "gap_before": 1.07,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_17",
   "block": "music.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "A big piece is often split into sections with short pauses between them. People stay quiet during those pauses.",
   "est_sec": 5.99,
   "gap_before": 0.43,
   "role": "reply",
   "block": "music.dlg18"
  },
  {
   "speaker": "user",
   "text": "How do I know",
   "est_sec": 1.34,
   "gap_before": 1.38,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg18"
  },
  {
   "speaker": "user",
   "text": "if it's really over?",
   "est_sec": 1.34,
   "gap_before": 2.85,
   "event": "ordinary_request",
   "block": "music.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Watch the conductor. When they lower their arms and turn around, it's over. Or just wait for everyone else to clap first.",
   "est_sec": 6.92,
   "gap_before": 1.01,
   "role": "reply",
   "block": "music.dlg18"
  },
  {
   "speaker": "user",
   "text": "Do I have to dress up?",
   "est_sec": 1.96,
   "gap_before": 1.43,
   "event": "ordinary_request",
   "block": "music.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Not at all these days. Smart casual is fine, and lots of people come straight from work.",
   "est_sec": 5.37,
   "gap_before": 0.41,
   "role": "reply",
   "block": "music.dlg18"
  }
 ]
}
