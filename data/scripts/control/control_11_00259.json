 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.35,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.48,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "Roughly how many boxes do I need for a one bed flat?",
   "est_sec": 3.82,
   "gap_before": 0.23,
   "event": "ordinary_request",
   "block": "moving_house.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Usually somewhere between thirty and forty, depending on how much you own. Books and kitchen stuff take up more than people expect.",
   "est_sec": 6.92,
   "gap_before": 0.65,
   "role": "reply",
   "block": "moving_house.dlg5"
  },
  {
   "speaker": "user",
   "text": "Thirty! I thought maybe ten.",
   "est_sec": 1.65,
   "gap_before": 1.3,
   "event": "ordinary_request",
   "block": "moving_house.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Everyone does. Get a mix of sizes, small for heavy things like books, big for light things like bedding.",
   "est_sec": 5.99,
   "gap_before": 0.5,
   "role": "reply",
   "block": "moving_house.dlg5"
  },
  {
   "speaker": "user",
   "text": "Where do I even get that many? Buying them",
   "est_sec": 2.89,
   "gap_before": 0.33,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg5"
  },
  {
   "speaker": "user",
   "text": "seems like a waste.",
   "est_sec": 1.34,
   "gap_before": 1.85,
   "event": "ordinary_request",
   "block": "moving_house.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Ask supermarkets and off licences, or check local groups where people give away boxes after moving.",
   "est_sec": 5.06,
   "gap_before": 0.95,
   "role": "reply",
   "block": "moving_house.dlg5"
  },
  {
   "speaker": "user",
   "text": "Good shout. My neighbour just moved in, actually.",
   "est_sec": 2.58,
   "gap_before": 2.03,
   "event": "ordinary_request",
   "block": "moving_house.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Perfect. Knock and ask, she'll probably be thrilled to get rid of them.",
   "est_sec": 4.13,
   "gap_before": 0.71,
   "role": "reply",
   "block": "moving_house.dlg5"
  }
 ]
}
