 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.31,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.39,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "Quick question. How do you get garlic smell off your hands?",
   "est_sec": 3.51,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "cooking.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Rub them on something stainless steel under cold water, like the side of the sink or a spoon. Then wash with soap.",
   "est_sec": 6.92,
   "gap_before": 1.18,
   "role": "reply",
   "block": "cooking.dlg32"
  },
  {
   "speaker": "user",
   "text": "That sounds made up.",
   "est_sec": 1.34,
   "gap_before": 0.64,
   "event": "ordinary_request",
   "block": "cooking.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "It does, but plenty of people swear by it. Lemon juice and a little salt also help.",
   "est_sec": 5.37,
   "gap_before": 0.32,
   "role": "reply",
   "block": "cooking.dlg32"
  },
  {
   "speaker": "user",
   "text": "And peeling garlic faster? I have twenty cloves to do.",
   "est_sec": 3.2,
   "gap_before": 1.41,
   "event": "ordinary_request",
   "block": "cooking.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Crush each clove lightly with the flat of your knife, the skin slips right off.",
   "est_sec": 4.75,
   "gap_before": 0.68,
   "role": "reply",
   "block": "cooking.dlg32"
  },
  {
   "speaker": "user",
   "text": "Twenty cloves for one dish. My girlfriend's mum",
   "est_sec": 2.58,
   "gap_before": 0.47,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg32"
  },
  {
   "speaker": "user",
   "text": "doesn't believe in subtle.",
   "est_sec": 1.34,
   "gap_before": 2.5,
   "event": "ordinary_request",
   "block": "cooking.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Then she'll be very happy with you tonight.",
   "est_sec": 2.58,
   "gap_before": 0.54,
   "role": "reply",
   "block": "cooking.dlg32"
  }
 ]
