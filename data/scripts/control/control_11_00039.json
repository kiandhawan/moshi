 "est_total_sec": 49.38,
 "est_speech_sec": 37.58,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.97,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "Can you tell me how to bleed a radiator? My mum says I should.",
   "est_sec": 4.44,
   "gap_before": 0.4,
   "event": "ordinary_request",
   "block": "home_repair.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Sure. If it's hot at the bottom and cold at the top, there's air trapped inside. Bleeding lets it out.",
   "est_sec": 6.3,
   "gap_before": 1.62,
   "role": "reply",
   "block": "home_repair.dlg9"
  },
  {
   "speaker": "user",
   "text": "It is cold at the top, yeah.",
   "est_sec": 2.27,
   "gap_before": 1.38,
   "event": "ordinary_request",
   "block": "home_repair.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Turn the heating off first. Then use a radiator key on the little valve at the top corner, and turn it slowly a quarter turn.",
   "est_sec": 7.85,
   "gap_before": 1.09,
   "role": "reply",
   "block": "home_repair.dlg9"
  },
  {
   "speaker": "user",
   "text": "Where do I get a radiator key?",
   "est_sec": 2.27,
   "gap_before": 2.09,
   "event": "ordinary_request",
   "block": "home_repair.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Any hardware store, they're cheap. Some valves just take a flat screwdriver.",
   "est_sec": 3.82,
   "gap_before": 0.38,
   "role": "reply",
   "block": "home_repair.dlg9"
  },
  {
   "speaker": "user",
   "text": "What happens then?",
   "est_sec": 1.03,
   "gap_before": 0.71,
   "event": "ordinary_request",
   "block": "home_repair.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "You'll hear hissing. When water starts to dribble out, close it. Keep a cloth under it, the water can be dirty.",
   "est_sec": 6.61,
   "gap_before": 1.03,
   "role": "reply",
   "block": "home_repair.dlg9"
  }
 ]
}
