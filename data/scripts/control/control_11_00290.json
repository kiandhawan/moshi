 "est_total_sec": 51.99,
 "est_speech_sec": 40.78,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.42,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.62,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "Give me some party game ideas for a bunch of eight year olds.",
   "est_sec": 4.13,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "birthday_party.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Musical chairs and freeze dance are always hits. A treasure hunt with little clues around the yard is great too.",
   "est_sec": 6.3,
   "gap_before": 1.14,
   "role": "reply",
   "block": "birthday_party.dlg1"
  },
  {
   "speaker": "user",
   "text": "Ooh, a treasure hunt. How would that work?",
   "est_sec": 2.58,
   "gap_before": 1.11,
   "event": "ordinary_request",
   "block": "birthday_party.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Hide simple rhyming clues that lead from one spot to the next, ending at a box of small prizes.",
   "est_sec": 5.99,
   "gap_before": 0.58,
   "role": "reply",
   "block": "birthday_party.dlg1"
  },
  {
   "speaker": "user",
   "text": "I'm not great at rhymes",
   "est_sec": 1.65,
   "gap_before": 1.24,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg1"
  },
  {
   "speaker": "user",
   "text": "could you give me one example?",
   "est_sec": 1.96,
   "gap_before": 1.98,
   "event": "ordinary_request",
   "block": "birthday_party.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Sure. Where you wash your hands each day, the next clue is hiding away. That one leads to the bathroom sink.",
   "est_sec": 6.61,
   "gap_before": 0.36,
   "role": "reply",
   "block": "birthday_party.dlg1"
  },
  {
   "speaker": "user",
   "text": "Ha, perfect. How many clues should I do?",
   "est_sec": 2.58,
   "gap_before": 1.26,
   "event": "ordinary_request",
   "block": "birthday_party.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Six to eight is about right for that age. Long enough to be exciting, short enough that nobody gets bored.",
   "est_sec": 6.3,
   "gap_before": 0.55,
   "role": "reply",
   "block": "birthday_party.dlg1"
  }
 ]
}
