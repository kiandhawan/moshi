 "est_speech_sec": 38.61,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.48,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.6,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "My cookies are lovely and chewy on day one, then they're like rocks by day two.",
   "est_sec": 5.06,
   "gap_before": 0.25,
   "event": "ordinary_request",
   "block": "baking.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "They're losing moisture to the air. Keep them in a sealed tin as soon as they're cool.",
   "est_sec": 5.37,
   "gap_before": 0.5,
   "role": "reply",
   "block": "baking.dlg14"
  },
  {
   "speaker": "user",
   "text": "I do, but they still go hard.",
   "est_sec": 2.27,
   "gap_before": 1.34,
   "event": "ordinary_request",
   "block": "baking.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Pop a slice of plain bread in the tin with them. The cookies pull moisture from the bread and stay soft.",
   "est_sec": 6.61,
   "gap_before": 0.47,
   "role": "reply",
   "block": "baking.dlg14"
  },
  {
   "speaker": "user",
   "text": "Wait, seriously? That works?",
   "est_sec": 1.34,
   "gap_before": 1.19,
   "event": "ordinary_request",
   "block": "baking.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "It really does. Swap the bread out every couple of days when it goes stale.",
   "est_sec": 4.75,
   "gap_before": 0.7,
   "role": "reply",
   "block": "baking.dlg14"
  },
  {
   "speaker": "user",
   "text": "And if I want to",
   "est_sec": 1.65,
   "gap_before": 2.07,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg14"
  },
  {
   "speaker": "user",
   "text": "bake ahead for a party next week?",
   "est_sec": 2.27,
   "gap_before": 1.55,
   "event": "ordinary_request",
   "block": "baking.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Freeze the dough in balls instead. Bake them straight from frozen, adding a minute or two, and they taste freshly made.",
   "est_sec": 6.61,
   "gap_before": 0.87,
   "role": "reply",
   "block": "baking.dlg14"
  }
 ]
}
