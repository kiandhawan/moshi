 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.45,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.72,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "My grandad's hearing is going and he's stopped coming to family film nights.",
   "est_sec": 4.13,
   "gap_before": 0.39,
   "event": "ordinary_request",
   "block": "movies.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "That's a shame, but very fixable. Turning on captions is the simplest step, and they're on almost everything now.",
   "est_sec": 5.99,
   "gap_before": 0.7,
   "role": "reply",
   "block": "movies.dlg24"
  },
  {
   "speaker": "user",
   "text": "He says captions make him feel old.",
   "est_sec": 2.27,
   "gap_before": 1.06,
   "event": "ordinary_request",
   "block": "movies.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "You could just turn them on for everyone. Lots of younger people use them anyway, so he won't feel singled out.",
   "est_sec": 6.61,
   "gap_before": 0.54,
   "role": "reply",
   "block": "movies.dlg24"
  },
  {
   "speaker": "user",
   "text": "Wait a second, that doesn't sound right.",
   "est_sec": 2.27,
   "gap_before": 0.64,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_10",
   "block": "movies.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "I'm fairly sure about it, but I could be wrong. What sounds off to you?",
   "est_sec": 4.75,
   "gap_before": 0.99,
   "role": "reply",
   "block": "movies.dlg24"
  },
  {
   "speaker": "user",
   "text": "That's sweet. What else?",
   "est_sec": 1.34,
   "gap_before": 1.21,
   "event": "ordinary_request",
   "block": "movies.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "Some TVs connect to wireless headphones, so he can have his own volume while everyone else listens normally.",
   "est_sec": 5.68,
   "gap_before": 0.61,
   "role": "reply",
   "block": "movies.dlg24"
  },
  {
   "speaker": "user",
   "text": "Oh, he'd like that. He",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "event": "distractor",
   "kind": "pause",
   "block": "movies.dlg24"
  },
  {
   "speaker": "user",
   "text": "loves his gadgets, actually.",
   "est_sec": 1.34,
   "gap_before": 2.29,
   "event": "ordinary_request",
   "block": "movies.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "Then pitch it as a cool new gadget. Seat him nearest the screen too, it helps with both the captions and the sound.",
   "est_sec": 7.23,
   "gap_before": 0.76,
   "role": "reply",
   "block": "movies.dlg24"
  }
 ]
