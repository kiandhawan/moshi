 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.56,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "Why does my coffee taste different at my parents' house? Same beans, same press.",
   "est_sec": 4.44,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "coffee.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "The water is probably the difference. Hard water, with lots of minerals, can make coffee taste flat or chalky.",
   "est_sec": 5.99,
   "gap_before": 0.74,
   "role": "reply",
   "block": "coffee.dlg13"
  },
  {
   "speaker": "user",
   "text": "Their kettle is full of white crust.",
   "est_sec": 2.27,
   "gap_before": 2.7,
   "event": "ordinary_request",
   "block": "coffee.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "That's a sure sign of hard water. You could try filtered water there, or a bottle of still water, and compare.",
   "est_sec": 6.61,
   "gap_before": 0.74,
   "role": "reply",
   "block": "coffee.dlg13"
  },
  {
   "speaker": "user",
   "text": "Is soft water",
   "est_sec": 1.03,
   "gap_before": 1.06,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg13"
  },
  {
   "speaker": "user",
   "text": "always better then?",
   "est_sec": 1.03,
   "gap_before": 2.38,
   "event": "ordinary_request",
   "block": "coffee.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Not always. Water with almost no minerals can make coffee taste thin and sour. Something in the middle is ideal.",
   "est_sec": 6.3,
   "gap_before": 1.08,
   "role": "reply",
   "block": "coffee.dlg13"
  },
  {
   "speaker": "user",
   "text": "Huh. I never thought water mattered.",
   "est_sec": 1.96,
   "gap_before": 0.88,
   "event": "ordinary_request",
   "block": "coffee.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "It's most of what's in your cup, so it matters a lot. Fresh cold water and a clean kettle make a real difference.",
   "est_sec": 7.23,
   "gap_before": 0.36,
   "role": "reply",
   "block": "coffee.dlg13"
  }
 ]
}
