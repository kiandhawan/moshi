 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.54,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.76,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "Can you explain what a budget category is? My app keeps asking me to set them.",
   "est_sec": 5.06,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "personal_finance.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "It's just a label for groups of spending, like rent, groceries, transport, fun, so you can see where money goes.",
   "est_sec": 6.3,
   "gap_before": 0.59,
   "role": "reply",
   "block": "personal_finance.dlg26"
  },
  {
   "speaker": "user",
   "text": "How many should I have?",
   "est_sec": 1.65,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "personal_finance.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Keep it simple, maybe eight to ten. Too many and it feels like a chore.",
   "est_sec": 4.75,
   "gap_before": 0.92,
   "role": "reply",
   "block": "personal_finance.dlg26"
  },
  {
   "speaker": "user",
   "text": "Where do coffees go? Food or fun?",
   "est_sec": 2.27,
   "gap_before": 1.19,
   "event": "ordinary_request",
   "block": "personal_finance.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Whatever helps you most. If coffee is a big spending area for you, give it its own category.",
   "est_sec": 5.68,
   "gap_before": 0.77,
   "role": "reply",
   "block": "personal_finance.dlg26"
  },
  {
   "speaker": "user",
   "text": "Its own category. Wow. That feels like",
   "est_sec": 2.27,
   "gap_before": 0.83,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg26"
  },
  {
   "speaker": "user",
   "text": "an intervention.",
   "est_sec": 0.72,
   "gap_before": 1.88,
   "event": "ordinary_request",
   "block": "personal_finance.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Ha, it's just information. Seeing it clearly is the first step to deciding if you're happy with it.",
   "est_sec": 5.68,
   "gap_before": 0.91,
   "role": "reply",
   "block": "personal_finance.dlg26"
  }
 ]
