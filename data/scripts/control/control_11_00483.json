 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 1.0,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "When should I plant tulip bulbs?",
   "est_sec": 1.96,
   "gap_before": 0.21,
   "event": "ordinary_request",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "In autumn, once the soil has cooled down. Late October to November is usually ideal.",
   "est_sec": 4.75,
   "gap_before": 0.94,
   "role": "reply",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "user",
   "text": "How deep do they go?",
   "est_sec": 1.65,
   "gap_before": 0.42,
   "event": "ordinary_request",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "About three times the height of the bulb, so roughly fifteen to twenty centimeters, pointy end up.",
   "est_sec": 5.37,
   "gap_before": 0.71,
   "role": "reply",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "user",
   "text": "And can I put them in pots? I was hoping to",
   "est_sec": 3.51,
   "gap_before": 2.92,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "user",
   "text": "put a few by the front door.",
   "est_sec": 2.27,
   "gap_before": 2.84,
   "event": "ordinary_request",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Yes, tulips look great in pots. Pack them closely together and make sure the pot drains well.",
   "est_sec": 5.37,
   "gap_before": 1.13,
   "role": "reply",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "user",
   "text": "Do they come back every year?",
   "est_sec": 1.96,
   "gap_before": 0.7,
   "event": "ordinary_request",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Some do, but many fade after the first year. Lots of people just plant fresh ones each autumn.",
   "est_sec": 5.68,
   "gap_before": 1.85,
   "role": "reply",
   "block": "gardening.dlg2"
  }
 ]
}
