 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.31,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.96,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "I've got a cupboard full of kitchen gadgets I never use. Spiralizer, waffle maker, and three blenders.",
   "est_sec": 5.37,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "cleaning.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Sounds like a museum. A quick test, when did you last use each one?",
   "est_sec": 4.44,
   "gap_before": 1.65,
   "role": "reply",
   "block": "cleaning.dlg26"
  },
  {
   "speaker": "user",
   "text": "Honestly? The spiralizer was a January thing. Two years ago.",
   "est_sec": 3.2,
   "gap_before": 1.12,
   "event": "ordinary_request",
   "block": "cleaning.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Then it can go. If you haven't touched something in a year, and it's not seasonal, it's probably clutter.",
   "est_sec": 5.99,
   "gap_before": 0.55,
   "role": "reply",
   "block": "cleaning.dlg26"
  },
  {
   "speaker": "user",
   "text": "The waffle maker is for when my nieces visit.",
   "est_sec": 2.89,
   "gap_before": 0.41,
   "event": "ordinary_request",
   "block": "cleaning.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "That's a keeper then, it has a job. But three blenders is two too many.",
   "est_sec": 4.75,
   "gap_before": 1.84,
   "role": "reply",
   "block": "cleaning.dlg26"
  },
  {
   "speaker": "user",
   "text": "Fair. I'll keep the",
   "est_sec": 1.34,
   "gap_before": 1.61,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg26"
  },
  {
   "speaker": "user",
   "text": "the good one and donate the rest.",
   "est_sec": 2.27,
   "gap_before": 2.6,
   "event": "ordinary_request",
   "block": "cleaning.dlg26"
  },
