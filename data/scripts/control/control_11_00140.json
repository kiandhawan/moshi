 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.32,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.56,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "Is it better to stretch before or after a run?",
   "est_sec": 3.2,
   "gap_before": 0.24,
   "event": "ordinary_request",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Before a run, do a dynamic warm-up like leg swings and easy jogging. Save the longer, held stretches for after.",
   "est_sec": 6.3,
   "gap_before": 0.92,
   "role": "reply",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "user",
   "text": "Why not hold stretches before?",
   "est_sec": 1.65,
   "gap_before": 1.04,
   "event": "ordinary_request",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Long static stretches can make your muscles feel a bit weaker right away. Moving warm-ups get them ready instead.",
   "est_sec": 5.99,
   "gap_before": 0.81,
   "role": "reply",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "user",
   "text": "Makes sense. I usually just",
   "est_sec": 1.65,
   "gap_before": 1.34,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "user",
   "text": "start running and hope for the best.",
   "est_sec": 2.27,
   "gap_before": 2.61,
   "event": "ordinary_request",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Lots of people do. Even five minutes of brisk walking first makes a real difference.",
   "est_sec": 4.75,
   "gap_before": 0.74,
   "role": "reply",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "user",
   "text": "Okay. And after, how long should I hold each stretch?",
   "est_sec": 3.2,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "About thirty seconds each. Focus on calves, hamstrings and hips, those get tight from running.",
   "est_sec": 4.75,
   "gap_before": 0.94,
   "role": "reply",
   "block": "fitness.dlg3"
  }
 ]
}
