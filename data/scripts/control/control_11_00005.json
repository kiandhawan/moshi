 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.85,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "I feel bad throwing away sourdough discard every day. Is there anything useful to do with it?",
   "est_sec": 5.37,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "baking.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Loads! Pancakes are the classic. Mix the discard with an egg, a little milk, sugar and a pinch of baking soda.",
   "est_sec": 6.61,
   "gap_before": 1.19,
   "role": "reply",
   "block": "baking.dlg32"
  },
  {
   "speaker": "user",
   "text": "Does it taste sour?",
   "est_sec": 1.34,
   "gap_before": 2.78,
   "event": "ordinary_request",
   "block": "baking.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Slightly tangy, which is lovely with maple syrup. You can also make crackers, just spread it thin with olive oil, salt and herbs.",
   "est_sec": 7.23,
   "gap_before": 1.1,
   "role": "reply",
   "block": "baking.dlg32"
  },
  {
   "speaker": "user",
   "text": "Crackers sounds fancy.",
   "est_sec": 1.03,
   "gap_before": 0.79,
   "event": "ordinary_request",
   "block": "baking.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "They're dead easy. Bake until crisp and break into shards.",
   "est_sec": 3.2,
   "gap_before": 0.82,
   "role": "reply",
   "block": "baking.dlg32"
  },
  {
   "speaker": "user",
   "text": "Can I store it for a while?",
   "est_sec": 2.27,
   "gap_before": 1.06,
   "event": "ordinary_request",
   "block": "baking.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Keep it in a jar in the fridge for up to a week and use it when you've collected enough.",
   "est_sec": 6.3,
   "gap_before": 1.13,
   "role": "reply",
   "block": "baking.dlg32"
  },
  {
   "speaker": "user",
   "text": "So that's my weekend breakfast sorted.",
   "est_sec": 1.96,
   "gap_before": 1.2,
   "block": "baking.dlg32"
  }
 ]
}
