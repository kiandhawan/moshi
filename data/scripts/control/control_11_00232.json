 "est_total_sec": 58.28,
 "est_speech_sec": 43.26,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.64,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.63,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "Every day at three I crash and grab another coffee. Then I can't sleep. It's a stupid cycle.",
   "est_sec": 5.68,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "coffee.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "It's a very common cycle, not a stupid one. That afternoon dip is partly natural, your body clock dips after lunch.",
   "est_sec": 6.61,
   "gap_before": 0.47,
   "role": "reply",
   "block": "coffee.dlg29"
  },
  {
   "speaker": "user",
   "text": "So what am I supposed to do instead?",
   "est_sec": 2.58,
   "gap_before": 2.62,
   "event": "ordinary_request",
   "block": "coffee.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "A short walk outside, ideally in daylight, gives a surprising lift. So does a big glass of cold water, since mild dehydration makes the slump worse.",
   "est_sec": 8.16,
   "gap_before": 0.8,
   "role": "reply",
   "block": "coffee.dlg29"
  },
  {
   "speaker": "user",
   "text": "A walk. Groundbreaking.",
   "est_sec": 1.03,
   "gap_before": 1.35,
   "event": "ordinary_request",
   "block": "coffee.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Ha, I know it sounds boring. But ten minutes outside often works as well as half a coffee, without wrecking your sleep.",
   "est_sec": 6.92,
   "gap_before": 0.91,
   "role": "reply",
   "block": "coffee.dlg29"
  },
  {
   "speaker": "user",
   "text": "What if I",
   "est_sec": 1.03,
   "gap_before": 1.37,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg29"
  },
  {
   "speaker": "user",
   "text": "really, really need caffeine?",
   "est_sec": 1.34,
   "gap_before": 2.74,
   "event": "ordinary_request",
   "block": "coffee.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Then try a small green tea or a half decaf coffee. Less caffeine, still a little boost, and kinder to your bedtime.",
   "est_sec": 6.92,
   "gap_before": 1.46,
   "role": "reply",
   "block": "coffee.dlg29"
  }
 ]
}
