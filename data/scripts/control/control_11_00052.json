 "est_total_sec": 61.4,
 "est_speech_sec": 48.73,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.42,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.66,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "There's a local tournament for a fighting game I love. I want to enter but I'm scared I'll get destroyed.",
   "est_sec": 6.3,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "video_games.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "That's how almost everyone feels before their first one. Local events are usually very welcoming to newcomers.",
   "est_sec": 5.37,
   "gap_before": 1.09,
   "role": "reply",
   "block": "video_games.dlg14"
  },
  {
   "speaker": "user",
   "text": "What if I lose in the first round?",
   "est_sec": 2.58,
   "gap_before": 0.62,
   "event": "ordinary_request",
   "block": "video_games.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "You might, and that's okay. Most tournaments use double elimination, so you get at least two matches. And people often play casual games all day.",
   "est_sec": 7.85,
   "gap_before": 0.58,
   "role": "reply",
   "block": "video_games.dlg14"
  },
  {
   "speaker": "user",
   "text": "Should I practise anything",
   "est_sec": 1.34,
   "gap_before": 1.06,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg14"
  },
  {
   "speaker": "user",
   "text": "specific before?",
   "est_sec": 0.72,
   "gap_before": 1.95,
   "event": "ordinary_request",
   "block": "video_games.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Pick one character and learn a few reliable moves really well, rather than a bit of everything. Practise blocking too, beginners forget to defend.",
   "est_sec": 7.54,
   "gap_before": 1.11,
   "role": "reply",
   "block": "video_games.dlg14"
  },
  {
   "speaker": "user",
   "text": "And etiquette?",
   "est_sec": 0.72,
   "gap_before": 0.61,
   "event": "ordinary_request",
   "block": "video_games.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Shake hands or say good games after a match, bring your own controller if you can, and ask people for tips. Players love talking shop.",
   "est_sec": 7.85,
   "gap_before": 0.52,
   "role": "reply",
   "block": "video_games.dlg14"
  },
  {
   "speaker": "user",
   "text": "Okay. I'm signing up tonight.",
   "est_sec": 1.65,
   "gap_before": 0.64,
   "event": "ordinary_request",
   "block": "video_games.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Brilliant. Have fun, and go in to learn, not to win.",
   "est_sec": 3.51,
   "gap_before": 1.58,
   "role": "reply",
   "block": "video_games.dlg14"
  }
 ]
}
