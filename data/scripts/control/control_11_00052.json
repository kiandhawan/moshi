 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.53,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.3,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "I always waste my weekends. How do people actually get stuff done?",
   "est_sec": 3.82,
   "gap_before": 0.21,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "One trick is to pick just one or two things you really want to do, and leave the rest of the time free.",
   "est_sec": 7.23,
   "gap_before": 0.89,
   "role": "reply",
   "block": "weekend_plans.dlg4"
  },
  {
   "speaker": "user",
   "text": "Only two? That seems like nothing.",
   "est_sec": 1.96,
   "gap_before": 2.32,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "It's enough. Most people try to cram in ten and end up doing none of them.",
   "est_sec": 5.06,
   "gap_before": 1.87,
   "role": "reply",
   "block": "weekend_plans.dlg4"
  },
  {
   "speaker": "user",
   "text": "Fair. This weekend I want to",
   "est_sec": 1.96,
   "gap_before": 0.65,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg4"
  },
  {
   "speaker": "user",
   "text": "finally sort out my wardrobe.",
   "est_sec": 1.65,
   "gap_before": 1.93,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Great. Do it Saturday morning while you've got energy, then you'll have the rest of the weekend to relax.",
   "est_sec": 5.99,
   "gap_before": 0.38,
   "role": "reply",
   "block": "weekend_plans.dlg4"
  },
  {
   "speaker": "user",
   "text": "And the second thing could be seeing a friend.",
   "est_sec": 2.89,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Perfect balance, one chore and one treat. You'll feel like you had a real weekend.",
   "est_sec": 4.75,
   "gap_before": 0.95,
   "role": "reply",
   "block": "weekend_plans.dlg4"
  }
 ]
}
