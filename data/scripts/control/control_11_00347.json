 "est_total_sec": 49.59,
 "est_speech_sec": 37.68,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.55,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.83,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "My ears have been ringing since the gig last night.",
   "est_sec": 3.2,
   "gap_before": 0.41,
   "event": "ordinary_request",
   "block": "music.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "That's called tinnitus, and after a loud gig it's quite common. It usually fades within a day or two.",
   "est_sec": 5.99,
   "gap_before": 0.62,
   "role": "reply",
   "block": "music.dlg25"
  },
  {
   "speaker": "user",
   "text": "And if it doesn't?",
   "est_sec": 1.34,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "music.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "If it lasts more than a few days, or your hearing feels muffled, see a doctor. It's worth getting checked.",
   "est_sec": 6.3,
   "gap_before": 1.06,
   "role": "reply",
   "block": "music.dlg25"
  },
  {
   "speaker": "user",
   "text": "I go to a lot",
   "est_sec": 1.65,
   "gap_before": 0.94,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg25"
  },
  {
   "speaker": "user",
   "text": "of gigs, like every week.",
   "est_sec": 1.65,
   "gap_before": 2.06,
   "event": "ordinary_request",
   "block": "music.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Then earplugs are a must. Each loud gig without them adds up, and hearing damage doesn't really heal.",
   "est_sec": 5.68,
   "gap_before": 0.53,
   "role": "reply",
   "block": "music.dlg25"
  },
  {
   "speaker": "user",
   "text": "Won't they make it sound dull?",
   "est_sec": 1.96,
   "gap_before": 1.36,
   "event": "ordinary_request",
   "block": "music.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Proper musician earplugs just lower the volume evenly. Most people say the music sounds clearer with them, not worse.",
   "est_sec": 5.99,
   "gap_before": 1.61,
   "role": "reply",
   "block": "music.dlg25"
  }
 ]
}
