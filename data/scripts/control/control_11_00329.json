 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.52,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.52,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "Coffee keeps upsetting my stomach, but I really don't want to quit.",
   "est_sec": 3.82,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "coffee.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "That's frustrating. Do you usually drink it on an empty stomach, first thing in the morning?",
   "est_sec": 5.06,
   "gap_before": 0.62,
   "role": "reply",
   "block": "coffee.dlg10"
  },
  {
   "speaker": "user",
   "text": "Hold on, can you say that again?",
   "est_sec": 2.27,
   "gap_before": 1.32,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_02",
   "block": "coffee.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Sure. That's frustrating. Do you usually drink it on an empty stomach, first thing in the morning?",
   "est_sec": 5.37,
   "gap_before": 0.64,
   "role": "reply",
   "block": "coffee.dlg10"
  },
  {
   "speaker": "user",
   "text": "Yep. Before breakfast, always.",
   "est_sec": 1.34,
   "gap_before": 0.89,
   "event": "ordinary_request",
   "block": "coffee.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "That might be part of it. Try having it with or after some food, even a piece of toast can help a lot.",
   "est_sec": 7.23,
   "gap_before": 1.49,
   "role": "reply",
   "block": "coffee.dlg10"
  },
  {
   "speaker": "user",
   "text": "Are some coffees",
   "est_sec": 1.03,
   "gap_before": 1.02,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg10"
  },
  {
   "speaker": "user",
   "text": "easier on the stomach?",
   "est_sec": 1.34,
   "gap_before": 2.51,
   "event": "ordinary_request",
   "block": "coffee.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Many people find darker roasts or cold brew gentler. Cold brew tends to taste less acidic, and dark roasts are often softer on the stomach.",
   "est_sec": 7.85,
   "gap_before": 1.85,
   "role": "reply",
   "block": "coffee.dlg10"
  },
  {
   "speaker": "user",
   "text": "I drink about four cups a day, too.",
   "est_sec": 2.58,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "coffee.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Cutting down to two might help as well. If it keeps bothering you, it's worth mentioning to a doctor.",
   "est_sec": 5.99,
   "gap_before": 0.65,
   "role": "reply",
   "block": "coffee.dlg10"
  }
 ]
