 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.7,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.89,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "I'm putting a water butt by the shed. Is it worth it?",
   "est_sec": 3.82,
   "gap_before": 0.34,
   "event": "ordinary_request",
   "block": "gardening.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Very. Plants actually prefer rainwater, and you'll save on your bill in summer.",
   "est_sec": 4.13,
   "gap_before": 0.73,
   "role": "reply",
   "block": "gardening.dlg23"
  },
  {
   "speaker": "user",
   "text": "How do I connect it?",
   "est_sec": 1.65,
   "gap_before": 1.4,
   "event": "ordinary_request",
   "block": "gardening.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "You fit a diverter kit into the shed's downpipe. It sends rain into the butt and back down the pipe once the butt is full.",
   "est_sec": 7.85,
   "gap_before": 0.87,
   "role": "reply",
   "block": "gardening.dlg23"
  },
  {
   "speaker": "user",
   "text": "The shed doesn't have a gutter.",
   "est_sec": 1.96,
   "gap_before": 0.36,
   "event": "ordinary_request",
   "block": "gardening.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Ah, then you'll need to add one. A short length of plastic gutter and a downpipe is cheap and pretty easy to screw on.",
   "est_sec": 7.54,
   "gap_before": 1.18,
   "role": "reply",
   "block": "gardening.dlg23"
  },
  {
   "speaker": "user",
   "text": "Right. Anything else I",
   "est_sec": 1.34,
   "gap_before": 0.37,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg23"
  },
  {
   "speaker": "user",
   "text": "should know before buying?",
   "est_sec": 1.34,
   "gap_before": 2.74,
   "event": "ordinary_request",
   "block": "gardening.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Get one with a lid so it doesn't breed mosquitoes, and raise it on a stand so a watering can fits under the tap.",
   "est_sec": 7.54,
   "gap_before": 0.53,
   "role": "reply",
   "block": "gardening.dlg23"
  }
 ]
}
