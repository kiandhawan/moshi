 "est_speech_sec": 38.61,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.56,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.66,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "Can I use bleach on my wooden cutting board?",
   "est_sec": 2.89,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "cleaning.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Bleach can dry out and crack wood, so I'd avoid it. Hot soapy water and drying it standing up is usually enough.",
   "est_sec": 6.92,
   "gap_before": 0.72,
   "role": "reply",
   "block": "cleaning.dlg3"
  },
  {
   "speaker": "user",
   "text": "What if I cut raw chicken on it?",
   "est_sec": 2.58,
   "gap_before": 0.83,
   "event": "ordinary_request",
   "block": "cleaning.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Then scrub it well and wipe it with plain white vinegar. Even better, keep a plastic board just for raw meat.",
   "est_sec": 6.61,
   "gap_before": 0.3,
   "role": "reply",
   "block": "cleaning.dlg3"
  },
  {
   "speaker": "user",
   "text": "Okay. It also smells",
   "est_sec": 1.34,
   "gap_before": 0.64,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg3"
  },
  {
   "speaker": "user",
   "text": "kind of like onions all the time.",
   "est_sec": 2.27,
   "gap_before": 2.96,
   "event": "ordinary_request",
   "block": "cleaning.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Rub it with half a lemon and some coarse salt, then rinse. That takes out most smells.",
   "est_sec": 5.37,
   "gap_before": 0.98,
   "role": "reply",
   "block": "cleaning.dlg3"
  },
  {
   "speaker": "user",
   "text": "And should I oil it?",
   "est_sec": 1.65,
   "gap_before": 1.37,
   "event": "ordinary_request",
   "block": "cleaning.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Yes, once a month with food safe mineral oil. It keeps the wood from drying out and cracking.",
   "est_sec": 5.68,
   "gap_before": 0.84,
   "role": "reply",
   "block": "cleaning.dlg3"
  }
 ]
}
