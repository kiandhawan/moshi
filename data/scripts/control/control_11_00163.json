 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.99,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "My son wants a drum kit for his birthday. Please talk me out of it.",
   "est_sec": 4.75,
   "gap_before": 0.26,
   "event": "ordinary_request",
   "block": "music.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "I might talk you into an electronic kit instead. With headphones, you'd barely hear a thing.",
   "est_sec": 5.06,
   "gap_before": 0.57,
   "role": "reply",
   "block": "music.dlg4"
  },
  {
   "speaker": "user",
   "text": "Wait, really? How quiet are they?",
   "est_sec": 1.96,
   "gap_before": 0.7,
   "event": "ordinary_request",
   "block": "music.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Much quieter than real drums. You'll hear a soft tapping, but nothing like the full noise.",
   "est_sec": 5.06,
   "gap_before": 0.38,
   "role": "reply",
   "block": "music.dlg4"
  },
  {
   "speaker": "user",
   "text": "Are they expensive?",
   "est_sec": 1.03,
   "gap_before": 0.84,
   "event": "ordinary_request",
   "block": "music.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Beginner kits are often cheaper than acoustic ones. And they take up less room too.",
   "est_sec": 4.75,
   "gap_before": 1.43,
   "role": "reply",
   "block": "music.dlg4"
  },
  {
   "speaker": "user",
   "text": "Okay, you've",
   "est_sec": 0.72,
   "gap_before": 1.42,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg4"
  },
  {
   "speaker": "user",
   "text": "sort of convinced me. Should he take lessons?",
   "est_sec": 2.58,
   "gap_before": 1.9,
   "event": "ordinary_request",
   "block": "music.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "A few lessons early on are really worth it. Good habits from the start make practice much more fun.",
   "est_sec": 5.99,
