 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.4,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "Is it true flights are cheaper if you book on a Tuesday?",
   "est_sec": 3.82,
   "gap_before": 0.21,
   "event": "ordinary_request",
   "block": "travel_planning.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "That's mostly an old myth. Prices change all the time based on demand, not the day you search.",
   "est_sec": 5.68,
   "gap_before": 0.43,
   "role": "reply",
   "block": "travel_planning.dlg13"
  },
  {
   "speaker": "user",
   "text": "So when should I book?",
   "est_sec": 1.65,
   "gap_before": 0.7,
   "event": "ordinary_request",
   "block": "travel_planning.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "For short flights, roughly one to three months ahead tends to be good. For long haul, a bit earlier.",
   "est_sec": 5.99,
   "gap_before": 1.17,
   "role": "reply",
   "block": "travel_planning.dlg13"
  },
  {
   "speaker": "user",
   "text": "What about incognito mode? My brother insists the prices go up if you keep searching.",
   "est_sec": 4.75,
   "gap_before": 2.24,
   "event": "ordinary_request",
   "block": "travel_planning.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "There's little evidence for that. Setting up a price alert is more useful than hiding your browsing.",
   "est_sec": 5.37,
   "gap_before": 1.08,
   "role": "reply",
   "block": "travel_planning.dlg13"
  },
  {
   "speaker": "user",
   "text": "A price alert. Where do I do that?",
   "est_sec": 2.58,
   "gap_before": 1.18,
   "event": "ordinary_request",
   "block": "travel_planning.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Most flight search sites have a button for it. You'll get an email when the fare for your route drops.",
   "est_sec": 6.3,
   "gap_before": 1.01,
   "role": "reply",
   "block": "travel_planning.dlg13"
  },
  {
   "speaker": "user",
   "text": "Okay, setting one up",
   "est_sec": 1.34,
   "gap_before": 0.43,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg13"
  },
  {
   "speaker": "user",
   "text": "for Toronto right now.",
   "est_sec": 1.34,
   "gap_before": 2.68,
   "event": "ordinary_request",
   "block": "travel_planning.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Good luck. If it drops to a price you're happy with, just book it.",
   "est_sec": 4.44,
   "gap_before": 0.43,
   "role": "reply",
   "block": "travel_planning.dlg13"
  }
 ]
}
