 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.47,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.4,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "I've never driven a big van before and I'm moving with one next week.",
   "est_sec": 4.44,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "moving_house.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Practise a bit before the big day if you can, maybe a short drive around quiet streets.",
   "est_sec": 5.37,
   "gap_before": 0.84,
   "role": "reply",
   "block": "moving_house.dlg32"
  },
  {
   "speaker": "user",
   "text": "What's the hardest part?",
   "est_sec": 1.34,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "moving_house.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "The height and width. Know the van's height and watch for low bridges and car park barriers.",
   "est_sec": 5.37,
   "gap_before": 0.78,
   "role": "reply",
   "block": "moving_house.dlg32"
  },
  {
   "speaker": "user",
   "text": "There's a",
   "est_sec": 0.72,
   "gap_before": 1.1,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg32"
  },
  {
   "speaker": "user",
   "text": "multi storey near the new flat.",
   "est_sec": 1.96,
   "gap_before": 2.55,
   "event": "ordinary_request",
   "block": "moving_house.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Check its height limit, most vans won't fit. Also, use your mirrors a lot, you can't see out the back.",
   "est_sec": 6.3,
   "gap_before": 1.13,
   "role": "reply",
   "block": "moving_house.dlg32"
  },
  {
   "speaker": "user",
   "text": "Reversing scares me.",
   "est_sec": 1.03,
   "gap_before": 0.99,
   "event": "ordinary_request",
   "block": "moving_house.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Get a friend to guide you from outside. Go slowly, and if in doubt, stop and look.",
   "est_sec": 5.37,
   "gap_before": 0.79,
   "role": "reply",
   "block": "moving_house.dlg32"
  }
 ]
