 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.56,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.82,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "How do I work out how long a hike will take?",
   "est_sec": 3.51,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "hiking.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "A rough rule is about three miles an hour on flat ground, plus an extra half hour for every thousand feet you climb.",
   "est_sec": 7.23,
   "gap_before": 1.02,
   "role": "reply",
   "block": "hiking.dlg26"
  },
  {
   "speaker": "user",
   "text": "So ten miles with two thousand feet of climbing would take how long?",
   "est_sec": 4.13,
   "gap_before": 0.89,
   "event": "ordinary_request",
   "block": "hiking.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Around three and a half hours of walking, then add time for breaks. I'd plan for four and a half to five.",
   "est_sec": 6.92,
   "gap_before": 0.4,
   "role": "reply",
   "block": "hiking.dlg26"
  },
  {
   "speaker": "user",
   "text": "That seems long.",
   "est_sec": 1.03,
   "gap_before": 0.89,
   "event": "ordinary_request",
   "block": "hiking.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Breaks, photos and lunch add up fast. It's much nicer to finish early than to rush down in the dark.",
   "est_sec": 6.3,
   "gap_before": 0.77,
   "role": "reply",
   "block": "hiking.dlg26"
  },
  {
   "speaker": "user",
   "text": "True. Last time I",
   "est_sec": 1.34,
   "gap_before": 0.95,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg26"
  },
  {
   "speaker": "user",
   "text": "got back as the sun went down and it was stressful.",
   "est_sec": 3.51,
   "gap_before": 2.33,
   "event": "ordinary_request",
   "block": "hiking.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "That's exactly why. And add a bit extra in winter, when daylight is short.",
   "est_sec": 4.44,
   "gap_before": 0.75,
   "role": "reply",
   "block": "hiking.dlg26"
  }
 ]
}
