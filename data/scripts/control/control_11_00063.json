 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.47,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.86,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "What should I ask when I go to see a flat?",
   "est_sec": 3.51,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "moving_house.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Ask what's included in the rent, how much bills usually are, and how long the lease is. Also ask why the last tenant left.",
   "est_sec": 7.54,
   "gap_before": 0.89,
   "role": "reply",
   "block": "moving_house.dlg1"
  },
  {
   "speaker": "user",
   "text": "Anything I should check myself?",
   "est_sec": 1.65,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "moving_house.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Run the taps and the shower to test the water pressure, look for damp or mould in corners, and check your phone signal in each room.",
   "est_sec": 8.16,
   "gap_before": 0.61,
   "role": "reply",
   "block": "moving_house.dlg1"
  },
  {
   "speaker": "user",
   "text": "Phone signal, I never would have thought of that.",
   "est_sec": 2.89,
   "gap_before": 0.87,
   "event": "ordinary_request",
   "block": "moving_house.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "It's easy to miss. Same with noise, try to visit in the evening if you can.",
   "est_sec": 5.06,
   "gap_before": 0.41,
   "role": "reply",
   "block": "moving_house.dlg1"
  },
  {
   "speaker": "user",
   "text": "And if I like it, should I",
   "est_sec": 2.27,
   "gap_before": 0.36,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg1"
  },
  {
   "speaker": "user",
   "text": "just say yes on the spot?",
   "est_sec": 1.96,
   "gap_before": 1.56,
   "event": "ordinary_request",
   "block": "moving_house.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "In a busy market you might have to move fast. Have your documents ready so you can apply the same day.",
   "est_sec": 6.61,
   "gap_before": 1.11,
   "role": "reply",
   "block": "moving_house.dlg1"
  }
 ]
}
