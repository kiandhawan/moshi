 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.88,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "I've just landed, it's two in the morning, and I'm completely fried. Is there any public transport running?",
   "est_sec": 5.68,
   "gap_before": 0.32,
   "event": "ordinary_request",
   "block": "public_transport.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Many big cities have night buses or a night tram. Does your airport have a transit desk or a board near arrivals?",
   "est_sec": 6.92,
   "gap_before": 1.57,
   "role": "reply",
   "block": "public_transport.dlg20"
  },
  {
   "speaker": "user",
   "text": "There's a board. It says night line N four.",
   "est_sec": 2.89,
   "gap_before": 0.71,
   "event": "ordinary_request",
   "block": "public_transport.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "That's probably your night bus. Check where it ends up and whether it stops near where you're staying.",
   "est_sec": 5.68,
   "gap_before": 0.68,
   "role": "reply",
   "block": "public_transport.dlg20"
  },
  {
   "speaker": "user",
   "text": "It goes",
   "est_sec": 0.72,
   "gap_before": 0.57,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg20"
  },
  {
   "speaker": "user",
   "text": "to the central station.",
   "est_sec": 1.34,
   "gap_before": 2.21,
   "event": "ordinary_request",
   "block": "public_transport.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Then from there you could walk or grab a short taxi. Night services usually run every half hour or so.",
   "est_sec": 6.3,
   "gap_before": 0.65,
   "role": "reply",
   "block": "public_transport.dlg20"
  },
  {
   "speaker": "user",
   "text": "Okay. I just want my bed.",
   "est_sec": 1.96,
   "gap_before": 1.47,
   "event": "ordinary_request",
   "block": "public_transport.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Almost there. Keep your bag close and stay awake on the ride.",
   "est_sec": 3.82,
   "gap_before": 1.96,
   "role": "reply",
   "block": "public_transport.dlg20"
  }
 ]
}
