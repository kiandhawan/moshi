 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.53,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.91,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "I've never used a drill before and I'm honestly scared of it.",
   "est_sec": 3.82,
   "gap_before": 0.3,
   "event": "ordinary_request",
   "block": "home_repair.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Totally understandable. A cordless drill is pretty friendly, it's not as wild as it looks.",
   "est_sec": 4.75,
   "gap_before": 0.68,
   "role": "reply",
   "block": "home_repair.dlg7"
  },
  {
   "speaker": "user",
   "text": "What if it jumps out of my hand?",
   "est_sec": 2.58,
   "gap_before": 1.79,
   "event": "ordinary_request",
   "block": "home_repair.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Hold it with both hands, start on the slowest speed, and let the drill do the work. Don't push too hard.",
   "est_sec": 6.61,
   "gap_before": 0.85,
   "role": "reply",
   "block": "home_repair.dlg7"
  },
  {
   "speaker": "user",
   "text": "And goggles? Are those really needed?",
   "est_sec": 1.96,
   "gap_before": 1.18,
   "event": "ordinary_request",
   "block": "home_repair.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "For drilling into walls, yes. Dust and little bits of plaster fly out right at eye level.",
   "est_sec": 5.37,
   "gap_before": 1.5,
   "role": "reply",
   "block": "home_repair.dlg7"
  },
  {
   "speaker": "user",
   "text": "Okay. I'm going to",
   "est_sec": 1.34,
   "gap_before": 1.2,
   "event": "distractor",
   "kind": "pause",
   "block": "home_repair.dlg7"
  },
  {
   "speaker": "user",
   "text": "practice on a scrap of wood first.",
   "est_sec": 2.27,
   "gap_before": 2.31,
   "event": "ordinary_request",
   "block": "home_repair.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Great idea. Drill a few holes, drive a few screws, and you'll feel much more confident.",
   "est_sec": 5.06,
   "gap_before": 1.05,
   "role": "reply",
   "block": "home_repair.dlg7"
  }
 ]
}
