 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.56,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "My bathroom sink smells awful. Like old eggs.",
   "est_sec": 2.58,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "cleaning.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "That's usually gunk built up in the drain. Pull out the plug or stopper if you can, there's often hair wrapped around it.",
   "est_sec": 7.23,
   "gap_before": 1.18,
   "role": "reply",
   "block": "cleaning.dlg22"
  },
  {
   "speaker": "user",
   "text": "Oh, that is horrible.",
   "est_sec": 1.34,
   "gap_before": 0.93,
   "event": "ordinary_request",
   "block": "cleaning.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Sorry. Clear it out, then pour half a cup of baking soda down, followed by a cup of vinegar.",
   "est_sec": 5.99,
   "gap_before": 1.05,
   "role": "reply",
   "block": "cleaning.dlg22"
  },
  {
   "speaker": "user",
   "text": "It's fizzing like",
   "est_sec": 1.03,
   "gap_before": 1.01,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg22"
  },
  {
   "speaker": "user",
   "text": "a science project.",
   "est_sec": 1.03,
   "gap_before": 2.53,
   "event": "ordinary_request",
   "block": "cleaning.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Let it fizz for fifteen minutes, then flush with a kettle of hot water, not boiling if you have plastic pipes.",
   "est_sec": 6.61,
   "gap_before": 0.51,
   "role": "reply",
   "block": "cleaning.dlg22"
  },
  {
   "speaker": "user",
   "text": "The smell's already better.",
   "est_sec": 1.34,
   "gap_before": 0.83,
   "event": "ordinary_request",
   "block": "cleaning.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Do the fizz trick once a month and it should stay that way.",
   "est_sec": 4.13,
   "gap_before": 0.39,
   "role": "reply",
   "block": "cleaning.dlg22"
  }
 ]
}
