 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.43,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.71,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "I get really motion sick on buses. Is there anything that helps?",
   "est_sec": 3.82,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "public_transport.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Sit near the front, facing forward, and look out the window at the horizon. Reading or scrolling usually makes it worse.",
   "est_sec": 6.61,
   "gap_before": 1.11,
   "role": "reply",
   "block": "public_transport.dlg2"
  },
  {
   "speaker": "user",
   "text": "I always read",
   "est_sec": 1.03,
   "gap_before": 0.37,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg2"
  },
  {
   "speaker": "user",
   "text": "on my commute, though.",
   "est_sec": 1.34,
   "gap_before": 2.4,
   "event": "ordinary_request",
   "block": "public_transport.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Audiobooks or podcasts are a great swap. You keep the story without staring at a page.",
   "est_sec": 5.06,
   "gap_before": 0.49,
   "role": "reply",
   "block": "public_transport.dlg2"
  },
  {
   "speaker": "user",
   "text": "Hmm, I never thought of that. Anything else?",
   "est_sec": 2.58,
   "gap_before": 0.6,
   "event": "ordinary_request",
   "block": "public_transport.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Fresh air helps, so open a window if you can. Some people also find ginger candies settle their stomach.",
   "est_sec": 5.99,
   "gap_before": 0.3,
   "role": "reply",
   "block": "public_transport.dlg2"
  },
  {
   "speaker": "user",
   "text": "I'll try the podcast thing first.",
   "est_sec": 1.96,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "public_transport.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Good plan. Let me know if you want some podcast suggestions.",
   "est_sec": 3.51,
   "gap_before": 0.67,
   "role": "reply",
   "block": "public_transport.dlg2"
  }
 ]
