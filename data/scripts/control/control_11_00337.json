 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.64,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.3,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "Is there an easy way to clean a ceiling fan? Every time I try, dust rains on my head.",
   "est_sec": 5.99,
   "gap_before": 0.27,
   "event": "ordinary_request",
   "block": "cleaning.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Use an old pillowcase. Slide it over each blade and pull back, the dust stays inside the case.",
   "est_sec": 5.68,
   "gap_before": 1.05,
   "role": "reply",
   "block": "cleaning.dlg28"
  },
  {
   "speaker": "user",
   "text": "That's genius.",
   "est_sec": 0.72,
   "gap_before": 1.23,
   "event": "ordinary_request",
   "block": "cleaning.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "It's one of the best little tricks. Stand on a sturdy step stool, not a wobbly chair.",
   "est_sec": 5.37,
   "gap_before": 0.9,
   "role": "reply",
   "block": "cleaning.dlg28"
  },
  {
   "speaker": "user",
   "text": "My chair is pretty wobbly",
   "est_sec": 1.65,
   "gap_before": 0.47,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg28"
  },
  {
   "speaker": "user",
   "text": "to be fair.",
   "est_sec": 1.03,
   "gap_before": 2.52,
   "event": "ordinary_request",
   "block": "cleaning.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Then definitely the stool. Shake the pillowcase out outside, then wash it.",
   "est_sec": 3.82,
   "gap_before": 0.86,
   "role": "reply",
   "block": "cleaning.dlg28"
  },
  {
   "speaker": "user",
   "text": "Doing it right now.",
   "est_sec": 1.34,
   "gap_before": 0.91,
   "block": "cleaning.dlg28"
  }
 ]
}
