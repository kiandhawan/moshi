 "est_total_sec": 54.32,
 "est_speech_sec": 42.64,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.73,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.52,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "Every checkout online now offers pay in four instalments. Is that a trap?",
   "est_sec": 4.13,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "shopping.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "It can be. It's a form of credit, so it's easy to lose track if you use it for lots of small things.",
   "est_sec": 7.23,
   "gap_before": 0.44,
   "role": "reply",
   "block": "shopping.dlg25"
  },
  {
   "speaker": "user",
   "text": "But there's no interest.",
   "est_sec": 1.34,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "shopping.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Often not, if you pay on time. Late fees are where it hurts, and some providers report missed payments too.",
   "est_sec": 6.3,
   "gap_before": 1.04,
   "role": "reply",
   "block": "shopping.dlg25"
  },
  {
   "speaker": "user",
   "text": "Wait, I've got three of them going right now.",
   "est_sec": 2.89,
   "gap_before": 0.4,
   "event": "distractor",
   "kind": "pause",
   "block": "shopping.dlg25"
  },
  {
   "speaker": "user",
   "text": "Maybe four.",
   "est_sec": 0.72,
   "gap_before": 2.27,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_13",
   "block": "shopping.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Then I'd pause and write them all down with the dates. Knowing the total each month makes a big difference.",
   "est_sec": 6.3,
   "gap_before": 1.78,
   "role": "reply",
   "block": "shopping.dlg25"
  },
  {
   "speaker": "user",
   "text": "That's a bit scary to look at.",
   "est_sec": 2.27,
   "gap_before": 0.77,
   "event": "ordinary_request",
   "block": "shopping.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "It usually feels better once it's on paper. A simple rule is to only use it for something you could afford to pay in full today.",
   "est_sec": 8.16,
   "gap_before": 1.2,
   "role": "reply",
   "block": "shopping.dlg25"
  }
 ]
}
