 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.37,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "Do I need travel insurance for a short trip inside Europe?",
   "est_sec": 3.51,
   "gap_before": 0.27,
   "event": "ordinary_request",
   "block": "travel_planning.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "It's not required, but it's cheap and covers things like cancellations and lost luggage. Worth it for peace of mind.",
   "est_sec": 6.3,
   "gap_before": 0.79,
   "role": "reply",
   "block": "travel_planning.dlg3"
  },
  {
   "speaker": "user",
   "text": "My credit card might already include some. How do I check?",
   "est_sec": 3.51,
   "gap_before": 1.2,
   "event": "ordinary_request",
   "block": "travel_planning.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Look in your card's benefits page or call them. Often you have to pay for the trip with that card for it to count.",
   "est_sec": 7.54,
   "gap_before": 0.99,
   "role": "reply",
   "block": "travel_planning.dlg3"
  },
  {
   "speaker": "user",
   "text": "I paid for the hotel with it but the flights",
   "est_sec": 3.2,
   "gap_before": 1.34,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg3"
  },
  {
   "speaker": "user",
   "text": "hmm, I think with my debit card.",
   "est_sec": 2.27,
   "gap_before": 2.96,
   "event": "ordinary_request",
   "block": "travel_planning.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Then the flights might not be covered. A basic policy just for the trip could fill that gap.",
   "est_sec": 5.68,
   "gap_before": 0.8,
   "role": "reply",
   "block": "travel_planning.dlg3"
  },
  {
   "speaker": "user",
   "text": "Got it. Thanks, that's really helpful.",
   "est_sec": 1.96,
   "gap_before": 1.0,
   "event": "ordinary_request",
   "block": "travel_planning.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "You're welcome. Have a great trip!",
   "est_sec": 1.96,
   "gap_before": 1.06,
   "role": "reply",
   "block": "travel_planning.dlg3"
  }
 ]
}
