 "est_total_sec": 58.15,
 "est_speech_sec": 44.81,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.31,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "I'm picking up a game I stopped playing six months ago and I have no idea what I was doing.",
   "est_sec": 6.3,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "video_games.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Classic. Does the game have a quest log or a journal? That's usually the quickest way to remember your goals.",
   "est_sec": 6.3,
   "gap_before": 0.41,
   "role": "reply",
   "block": "video_games.dlg13"
  },
  {
   "speaker": "user",
   "text": "There's a journal, but I've forgotten all the controls too.",
   "est_sec": 3.2,
   "gap_before": 1.26,
   "event": "ordinary_request",
   "block": "video_games.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Check the settings menu, there's often a controls page. Or find a quiet area and just press every button to see what happens.",
   "est_sec": 7.23,
   "gap_before": 1.95,
   "role": "reply",
   "block": "video_games.dlg13"
  },
  {
   "speaker": "user",
   "text": "My inventory is also",
   "est_sec": 1.34,
   "gap_before": 1.46,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg13"
  },
  {
   "speaker": "user",
   "text": "a total mess.",
   "est_sec": 1.03,
   "gap_before": 1.6,
   "event": "ordinary_request",
   "block": "video_games.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Then give yourself half an hour of tidying. Sell junk, check your gear, and read the item descriptions again. It helps everything come back.",
   "est_sec": 7.54,
   "gap_before": 1.58,
   "role": "reply",
   "block": "video_games.dlg13"
  },
  {
   "speaker": "user",
   "text": "Should I just restart?",
   "est_sec": 1.34,
   "gap_before": 0.75,
   "event": "ordinary_request",
   "block": "video_games.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Only if you weren't far in, or didn't enjoy your choices. Otherwise, muddle through for an hour and it usually clicks.",
   "est_sec": 6.61,
   "gap_before": 1.64,
   "role": "reply",
   "block": "video_games.dlg13"
  }
 ]
}
