 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.81,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "I want to do something nice for my wife this weekend but I'm on a tight budget.",
   "est_sec": 5.37,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Lots of options. A picnic in a nice spot, cooking her favourite meal, or a sunset walk somewhere scenic are all lovely and cheap.",
   "est_sec": 7.54,
   "gap_before": 0.49,
   "role": "reply",
   "block": "weekend_plans.dlg2"
  },
  {
   "speaker": "user",
   "text": "Hold on, that's not right.",
   "est_sec": 1.65,
   "gap_before": 1.2,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_07",
   "block": "weekend_plans.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Hmm, I believe it is. Which part doesn't sound right?",
   "est_sec": 3.2,
   "gap_before": 0.88,
   "role": "reply",
   "block": "weekend_plans.dlg2"
  },
  {
   "speaker": "user",
   "text": "She loves Italian food. Maybe I could",
   "est_sec": 2.27,
   "gap_before": 2.7,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg2"
  },
  {
   "speaker": "user",
   "text": "make her lasagna.",
   "est_sec": 1.03,
   "gap_before": 2.49,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "That's a great idea. Make it in the afternoon, then it's ready when she gets home.",
   "est_sec": 5.06,
   "gap_before": 1.05,
   "role": "reply",
   "block": "weekend_plans.dlg2"
  },
  {
   "speaker": "user",
   "text": "I've never made lasagna before though.",
   "est_sec": 1.96,
   "gap_before": 0.81,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "It's more forgiving than it looks. Use a simple meat sauce, layer it with pasta sheets and a white sauce, and bake for about forty minutes.",
   "est_sec": 8.16,
   "gap_before": 0.73,
   "role": "reply",
   "block": "weekend_plans.dlg2"
  },
  {
   "speaker": "user",
   "text": "Okay. And maybe some candles.",
