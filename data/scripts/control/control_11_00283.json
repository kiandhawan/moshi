 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.43,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.81,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "I want to make iced coffee at home this summer. Where do I start?",
   "est_sec": 4.44,
   "gap_before": 0.27,
   "event": "ordinary_request",
   "block": "coffee.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "The easiest way is to brew your coffee a bit stronger than usual and pour it over lots of ice, so it doesn't get watery.",
   "est_sec": 7.85,
   "gap_before": 0.7,
   "role": "reply",
   "block": "coffee.dlg4"
  },
  {
   "speaker": "user",
   "text": "What about cold brew? Is that hard?",
   "est_sec": 2.27,
   "gap_before": 1.48,
   "event": "ordinary_request",
   "block": "coffee.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "It's really easy, just slow. Mix coarse coffee with cold water, leave it in the fridge overnight, and strain it in the morning.",
   "est_sec": 7.23,
   "gap_before": 0.37,
   "role": "reply",
   "block": "coffee.dlg4"
  },
  {
   "speaker": "user",
   "text": "How long does it keep?",
   "est_sec": 1.65,
   "gap_before": 1.36,
   "event": "ordinary_request",
   "block": "coffee.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "About a week in the fridge. Make a big jar on Sunday and you're set for the week.",
   "est_sec": 5.68,
   "gap_before": 0.74,
   "role": "reply",
   "block": "coffee.dlg4"
  },
  {
   "speaker": "user",
   "text": "Actually, maybe I'll",
   "est_sec": 1.03,
   "gap_before": 2.21,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg4"
  },
  {
   "speaker": "user",
   "text": "try both and see which I like.",
   "est_sec": 2.27,
   "gap_before": 2.72,
   "event": "ordinary_request",
   "block": "coffee.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Good idea. Freeze some coffee in an ice cube tray too, so your drink never gets diluted.",
   "est_sec": 5.37,
