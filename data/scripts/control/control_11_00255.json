 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.43,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.9,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "Give me some ideas for a rainy Saturday with two kids.",
   "est_sec": 3.51,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "You could build a blanket fort and have a movie afternoon, or bake cookies together. Indoor swimming pools are great too, kids burn off energy.",
   "est_sec": 7.85,
   "gap_before": 0.65,
   "role": "reply",
   "block": "weekend_plans.dlg1"
  },
  {
   "speaker": "user",
   "text": "Swimming is good. What else could we do out of the house?",
   "est_sec": 3.82,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "A science museum or an indoor climbing wall are both fun. Many libraries also run free story sessions on Saturday mornings.",
   "est_sec": 6.61,
   "gap_before": 0.92,
   "role": "reply",
   "block": "weekend_plans.dlg1"
  },
  {
   "speaker": "user",
   "text": "The climbing wall sounds fun. Are kids",
   "est_sec": 2.27,
   "gap_before": 0.97,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg1"
  },
  {
   "speaker": "user",
   "text": "allowed at those?",
   "est_sec": 1.03,
   "gap_before": 1.73,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Most have kids sessions, usually from about age five. It's best to book ahead, they fill up on rainy days.",
   "est_sec": 6.3,
   "gap_before": 0.5,
   "role": "reply",
   "block": "weekend_plans.dlg1"
  },
  {
   "speaker": "user",
   "text": "Hold on a sec, mine are six and eight, so perfect.",
   "est_sec": 3.51,
   "gap_before": 1.19,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_17",
   "block": "weekend_plans.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Great ages for it. Pack some snacks, they'll be starving afterwards.",
   "est_sec": 3.51,
   "gap_before": 0.42,
   "role": "reply",
   "block": "weekend_plans.dlg1"
  }
 ]
