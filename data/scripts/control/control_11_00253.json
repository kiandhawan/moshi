 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.37,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "Quick question. Is it okay to leave my phone charging overnight?",
   "est_sec": 3.51,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "smartphones.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Modern phones stop charging when they're full, so it's generally safe. Many also have an optimized charging setting that waits to finish until just before you wake up.",
   "est_sec": 8.78,
   "gap_before": 1.05,
   "role": "reply",
   "block": "smartphones.dlg3"
  },
  {
   "speaker": "user",
   "text": "Where do I find that?",
   "est_sec": 1.65,
   "gap_before": 1.45,
   "event": "ordinary_request",
   "block": "smartphones.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "It's usually under battery in your settings. Look for something like optimized or adaptive charging.",
   "est_sec": 4.75,
   "gap_before": 0.33,
   "role": "reply",
   "block": "smartphones.dlg3"
  },
  {
   "speaker": "user",
   "text": "Found it, it was already on. Huh.",
   "est_sec": 2.27,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "smartphones.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Nice, then you're already set. Just keep the phone out from under your pillow so it can cool down.",
   "est_sec": 5.99,
   "gap_before": 0.53,
   "role": "reply",
   "block": "smartphones.dlg3"
  },
  {
   "speaker": "user",
   "text": "Ha, I definitely",
   "est_sec": 1.03,
   "gap_before": 1.13,
   "event": "distractor",
   "kind": "pause",
   "block": "smartphones.dlg3"
  },
  {
   "speaker": "user",
   "text": "do that sometimes. I'll stop.",
   "est_sec": 1.65,
   "gap_before": 2.14,
   "event": "ordinary_request",
   "block": "smartphones.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Good plan. A nightstand is much better for both of you.",
   "est_sec": 3.51,
   "gap_before": 0.41,
   "role": "reply",
   "block": "smartphones.dlg3"
  }
