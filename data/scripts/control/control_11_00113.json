 "est_total_sec": 48.33,
 "est_speech_sec": 37.89,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.42,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "My hands are really small and most controllers feel huge.",
   "est_sec": 3.2,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "video_games.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "That's more common than you'd think. Some brands make smaller controllers, and there are compact ones designed for younger players that adults use too.",
   "est_sec": 7.54,
   "gap_before": 0.4,
   "role": "reply",
   "block": "video_games.dlg11"
  },
  {
   "speaker": "user",
   "text": "Won't those feel cheap?",
   "est_sec": 1.34,
   "gap_before": 1.48,
   "event": "ordinary_request",
   "block": "video_games.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Some do, but there are decent ones. Try to hold a few in a shop before buying if you can.",
   "est_sec": 6.3,
   "gap_before": 1.06,
   "role": "reply",
   "block": "video_games.dlg11"
  },
  {
   "speaker": "user",
   "text": "What about remapping buttons?",
   "est_sec": 1.34,
   "gap_before": 1.67,
   "event": "ordinary_request",
   "block": "video_games.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Great idea. Most consoles let you change which button does what in the accessibility settings, so you can move awkward ones somewhere comfier.",
   "est_sec": 7.23,
   "gap_before": 0.82,
   "role": "reply",
   "block": "video_games.dlg11"
  },
  {
   "speaker": "user",
   "text": "I didn't know that existed.",
   "est_sec": 1.65,
   "gap_before": 0.84,
   "event": "ordinary_request",
   "block": "video_games.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "It's often hidden. It's worth a look, you can even swap the sticks or flip the triggers on some systems.",
   "est_sec": 6.3,
   "gap_before": 1.15,
   "role": "reply",
   "block": "video_games.dlg11"
  }
 ]
}
