 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.55,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "I'm retired and I've applied to volunteer as a guide at the local history museum. Is there really an interview?",
   "est_sec": 6.3,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "job_interview.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Often there is, though it's usually relaxed. They want to know you're reliable and enjoy talking to visitors.",
   "est_sec": 5.68,
   "gap_before": 0.9,
   "role": "reply",
   "block": "job_interview.dlg30"
  },
  {
   "speaker": "user",
   "text": "I do love talking. My wife says too much.",
   "est_sec": 2.89,
   "gap_before": 0.71,
   "event": "ordinary_request",
   "block": "job_interview.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "That's actually useful for a guide. Just show you can also listen and adjust to who's in front of you.",
   "est_sec": 6.3,
   "gap_before": 0.78,
   "role": "reply",
   "block": "job_interview.dlg30"
  },
  {
   "speaker": "user",
   "text": "Like children, you mean?",
   "est_sec": 1.34,
   "gap_before": 1.0,
   "event": "ordinary_request",
   "block": "job_interview.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. A school group needs something different from a group of local historians.",
   "est_sec": 4.13,
   "gap_before": 1.09,
   "role": "reply",
   "block": "job_interview.dlg30"
  },
  {
   "speaker": "user",
   "text": "Hang on, I missed that.",
   "est_sec": 1.65,
   "gap_before": 1.33,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_04",
   "block": "job_interview.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "No problem. Exactly. A school group needs something different from a group of local historians.",
   "est_sec": 4.75,
   "gap_before": 0.79,
   "role": "reply",
   "block": "job_interview.dlg30"
  },
  {
   "speaker": "user",
   "text": "I suppose I could",
   "est_sec": 1.34,
   "gap_before": 0.35,
   "event": "distractor",
   "kind": "pause",
   "block": "job_interview.dlg30"
  },
  {
   "speaker": "user",
   "text": "tell them about the tours I used to give at the church.",
   "est_sec": 3.82,
   "gap_before": 1.52,
   "event": "ordinary_request",
   "block": "job_interview.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "That's perfect. It shows you've done something similar and enjoyed it.",
   "est_sec": 3.51,
   "gap_before": 0.6,
   "role": "reply",
   "block": "job_interview.dlg30"
  }
