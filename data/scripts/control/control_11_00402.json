 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.95,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "I'm turning forty and I kind of don't want a party at all.",
   "est_sec": 4.13,
   "gap_before": 0.24,
   "event": "ordinary_request",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "That's completely okay. Some people prefer something quiet. What would make the day feel good to you?",
   "est_sec": 5.37,
   "gap_before": 0.53,
   "role": "reply",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "user",
   "text": "Honestly, a good meal and a day off with no phone.",
   "est_sec": 3.51,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "That sounds wonderful. You could plan a day trip somewhere new and finish with dinner at your favorite place.",
   "est_sec": 5.99,
   "gap_before": 0.36,
   "role": "reply",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "user",
   "text": "Wait, are you sure about that?",
   "est_sec": 1.96,
   "gap_before": 0.96,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_08",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Good to question it. I still think it's right, though you know your situation best.",
   "est_sec": 4.75,
   "gap_before": 0.41,
   "role": "reply",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "user",
   "text": "My family will be upset if I don't celebrate",
   "est_sec": 2.89,
   "gap_before": 0.94,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "user",
   "text": "at least a little.",
   "est_sec": 1.34,
   "gap_before": 1.85,
   "event": "ordinary_request",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Maybe a small family dinner the weekend after. That way they get to celebrate you, and you still get your quiet day.",
   "est_sec": 6.92,
   "gap_before": 0.82,
   "role": "reply",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "user",
   "text": "Yeah, that could work.",
   "est_sec": 1.34,
   "gap_before": 2.63,
   "event": "ordinary_request",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "It's your birthday, so do it your way. Forty is a good year to start that habit.",
   "est_sec": 5.37,
   "gap_before": 0.99,
   "role": "reply",
   "block": "birthday_party.dlg4"
  }
 ]
}
