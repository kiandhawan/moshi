 "est_total_sec": 65.06,
 "est_speech_sec": 49.35,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.62,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.53,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "The steam wand on our espresso machine smells funky. Like old milk.",
   "est_sec": 3.82,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "coffee.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "That's milk getting sucked up inside the wand and going off. Luckily it's easy to fix.",
   "est_sec": 5.06,
   "gap_before": 0.59,
   "role": "reply",
   "block": "coffee.dlg21"
  },
  {
   "speaker": "user",
   "text": "Wait a second, that doesn't sound right.",
   "est_sec": 2.27,
   "gap_before": 0.65,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_10",
   "block": "coffee.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Let me double-check. I'd still stand by it, but tell me what you heard.",
   "est_sec": 4.44,
   "gap_before": 0.98,
   "role": "reply",
   "block": "coffee.dlg21"
  },
  {
   "speaker": "user",
   "text": "How do I clean inside it?",
   "est_sec": 1.96,
   "gap_before": 0.86,
   "event": "ordinary_request",
   "block": "coffee.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Soak the tip in a cup of hot water with a little milk system cleaner, then purge steam through it a few times. Wipe the outside too.",
   "est_sec": 8.47,
   "gap_before": 1.19,
   "role": "reply",
   "block": "coffee.dlg21"
  },
  {
   "speaker": "user",
   "text": "There's a little",
   "est_sec": 1.03,
   "gap_before": 2.68,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg21"
  },
  {
   "speaker": "user",
   "text": "hole that seems blocked.",
   "est_sec": 1.34,
   "gap_before": 2.46,
   "event": "ordinary_request",
   "block": "coffee.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Use a pin or the small tool that came with the machine to gently clear it. Some tips unscrew so you can soak them properly.",
   "est_sec": 7.85,
   "gap_before": 0.74,
   "role": "reply",
   "block": "coffee.dlg21"
  },
  {
   "speaker": "user",
   "text": "How do I stop it happening again?",
   "est_sec": 2.27,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "coffee.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "After every use, wipe the wand with a damp cloth and blast a short burst of steam. Two seconds of habit saves a lot of smell.",
   "est_sec": 8.16,
   "gap_before": 1.99,
   "role": "reply",
   "block": "coffee.dlg21"
  }
 ]
}
