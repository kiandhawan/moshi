 "est_total_sec": 52.41,
 "est_speech_sec": 41.71,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.4,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.92,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "Why are my cucumbers bitter? I was so proud of them.",
   "est_sec": 3.51,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "gardening.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Bitterness usually comes from stress, mostly uneven watering or big swings in temperature.",
   "est_sec": 4.13,
   "gap_before": 0.35,
   "role": "reply",
   "block": "gardening.dlg13"
  },
  {
   "speaker": "user",
   "text": "I did go away for a long weekend. They were bone dry when I got back.",
   "est_sec": 5.06,
   "gap_before": 1.06,
   "event": "ordinary_request",
   "block": "gardening.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "That'll do it. Cucumbers want steady moisture. A deep drink every day or two in hot weather keeps them sweet.",
   "est_sec": 6.3,
   "gap_before": 0.55,
   "role": "reply",
   "block": "gardening.dlg13"
  },
  {
   "speaker": "user",
   "text": "Can I fix the ones that are already growing?",
   "est_sec": 2.89,
   "gap_before": 0.72,
   "event": "ordinary_request",
   "block": "gardening.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Some bitterness is near the stalk end and in the skin. Peel them and cut off the top bit, and they're often fine.",
   "est_sec": 7.23,
   "gap_before": 0.98,
   "role": "reply",
   "block": "gardening.dlg13"
  },
  {
   "speaker": "user",
   "text": "Okay, phew. Any variety that's",
   "est_sec": 1.65,
   "gap_before": 0.77,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg13"
  },
  {
   "speaker": "user",
   "text": "less fussy for next year?",
   "est_sec": 1.65,
   "gap_before": 2.26,
   "event": "ordinary_request",
   "block": "gardening.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Look for ones described as burpless or bitter free. They've been bred to be much less likely to turn bitter.",
   "est_sec": 6.3,
   "gap_before": 0.69,
   "role": "reply",
   "block": "gardening.dlg13"
  }
 ]
}
