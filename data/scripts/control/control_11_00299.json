 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.53,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.47,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "Let me guess, you're going to tell me my oven's the problem. Everything burns on the bottom.",
   "est_sec": 5.37,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "baking.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Ha, possibly. But first, what kind of baking trays are you using?",
   "est_sec": 3.82,
   "gap_before": 1.51,
   "role": "reply",
   "block": "baking.dlg28"
  },
  {
   "speaker": "user",
   "text": "Dark ones. Non stick.",
   "est_sec": 1.34,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "baking.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Dark trays absorb more heat, so bottoms brown faster. Lowering the temperature a little, or using a lighter tray, often fixes it.",
   "est_sec": 6.92,
   "gap_before": 1.08,
   "role": "reply",
   "block": "baking.dlg28"
  },
  {
   "speaker": "user",
   "text": "Fine. And if it's still burning?",
   "est_sec": 1.96,
   "gap_before": 1.28,
   "event": "ordinary_request",
   "block": "baking.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Then yes, your oven might run hot. A cheap oven thermometer will tell you the real temperature.",
   "est_sec": 5.37,
   "gap_before": 0.5,
   "role": "reply",
   "block": "baking.dlg28"
  },
  {
   "speaker": "user",
   "text": "Of course it's the oven.",
   "est_sec": 1.65,
   "gap_before": 0.89,
   "event": "ordinary_request",
   "block": "baking.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Could be both! Also move the shelf up one level, away from the bottom heating element.",
   "est_sec": 5.06,
   "gap_before": 0.31,
   "role": "reply",
   "block": "baking.dlg28"
  }
 ]
}
