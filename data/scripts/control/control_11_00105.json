 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.47,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.38,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "The forecast says frost tonight and my dahlias are still out. Help.",
   "est_sec": 3.82,
   "gap_before": 0.3,
   "event": "ordinary_request",
   "block": "gardening.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Don't panic. One light frost will blacken the leaves, but the tubers underground are usually fine.",
   "est_sec": 5.06,
   "gap_before": 1.2,
   "role": "reply",
   "block": "gardening.dlg18"
  },
  {
   "speaker": "user",
   "text": "So should I dig them up now?",
   "est_sec": 2.27,
   "gap_before": 1.33,
   "event": "ordinary_request",
   "block": "gardening.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Wait until after the frost blackens the foliage, then cut the stems down and lift the tubers within a few days.",
   "est_sec": 6.61,
   "gap_before": 0.58,
   "role": "reply",
   "block": "gardening.dlg18"
  },
  {
   "speaker": "user",
   "text": "Then what? Do I just",
   "est_sec": 1.65,
   "gap_before": 1.27,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg18"
  },
  {
   "speaker": "user",
   "text": "shove them in the garage?",
   "est_sec": 1.65,
   "gap_before": 3.0,
   "event": "ordinary_request",
   "block": "gardening.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Let them dry upside down for a day or two, then store them in a box of dry compost or newspaper somewhere cool but frost free.",
   "est_sec": 8.16,
   "gap_before": 0.38,
   "role": "reply",
   "block": "gardening.dlg18"
  },
  {
   "speaker": "user",
   "text": "And my lemon tree in the pot?",
   "est_sec": 2.27,
   "gap_before": 1.35,
   "event": "ordinary_request",
   "block": "gardening.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "That one needs to come in tonight. Lemons hate frost. A cool bright room or porch is perfect.",
   "est_sec": 5.68,
   "gap_before": 0.54,
   "role": "reply",
   "block": "gardening.dlg18"
  }
 ]
}
