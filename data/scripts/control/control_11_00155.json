   "role": "reply",
   "block": "birthday_party.dlg2"
  },
  {
   "speaker": "user",
   "text": "She loves brunch, and anything near the water.",
   "est_sec": 2.58,
   "gap_before": 0.84,
   "event": "ordinary_request",
   "block": "birthday_party.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Then book a brunch spot with a view, and plan a walk along the water afterwards. Simple but thoughtful.",
   "est_sec": 5.99,
   "gap_before": 0.56,
   "role": "reply",
   "block": "birthday_party.dlg2"
  },
  {
   "speaker": "user",
   "text": "Should I invite her friends or",
