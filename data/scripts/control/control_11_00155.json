 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.32,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.74,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "My girlfriend and I are moving in together. How do we talk about money without it getting awkward?",
   "est_sec": 5.68,
   "gap_before": 0.24,
   "event": "ordinary_request",
   "block": "personal_finance.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Pick a calm moment, not right after a big purchase. Start with what you each want, like saving for travel or a house.",
   "est_sec": 7.23,
   "gap_before": 0.92,
   "role": "reply",
   "block": "personal_finance.dlg12"
  },
  {
   "speaker": "user",
   "text": "She's way better with money than me.",
   "est_sec": 2.27,
   "gap_before": 0.6,
   "event": "ordinary_request",
   "block": "personal_finance.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "That's fine, and honestly helpful. Be upfront about any debts or habits, it builds trust.",
   "est_sec": 4.75,
   "gap_before": 0.73,
   "role": "reply",
   "block": "personal_finance.dlg12"
  },
  {
   "speaker": "user",
   "text": "Wait a second, I have a bit of credit card debt she",
   "est_sec": 3.82,
   "gap_before": 0.51,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg12"
  },
  {
   "speaker": "user",
   "text": "doesn't know about.",
   "est_sec": 1.03,
   "gap_before": 2.26,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_16",
   "block": "personal_finance.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Then tell her early. It's much easier now than if she finds out later. Bring a plan for paying it off.",
   "est_sec": 6.61,
   "gap_before": 1.65,
   "role": "reply",
   "block": "personal_finance.dlg12"
  },
  {
   "speaker": "user",
   "text": "What if she gets upset?",
   "est_sec": 1.65,
   "gap_before": 2.39,
   "event": "ordinary_request",
   "block": "personal_finance.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "She might be surprised, but most people respect honesty. Showing you're working on it makes a big difference.",
   "est_sec": 5.68,
   "gap_before": 0.34,
   "role": "reply",
   "block": "personal_finance.dlg12"
  }
 ]
}
