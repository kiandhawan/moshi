   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.84,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "My wife's birthday is Sunday and I've got nothing planned. I'm panicking a little.",
   "est_sec": 4.44,
   "gap_before": 0.24,
   "event": "ordinary_request",
   "block": "birthday_party.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Don't worry, there's still time. What does she love doing on a free day?",
   "est_sec": 4.44,
   "gap_before": 1.02,
   "role": "reply",
   "block": "birthday_party.dlg2"
  },
  {
   "speaker": "user",
   "text": "Hang on, I missed that.",
