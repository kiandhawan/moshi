 "est_speech_sec": 43.05,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.48,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.51,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "I'm getting a leopard gecko. What temperature does the tank need to be?",
   "est_sec": 4.13,
   "gap_before": 0.51,
   "event": "ordinary_request",
   "block": "pets.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "They need a warm side and a cool side, so they can move between them. The warm spot should be around thirty degrees.",
   "est_sec": 7.23,
   "gap_before": 0.75,
   "role": "reply",
   "block": "pets.dlg26"
  },
  {
   "speaker": "user",
   "text": "Hold on, really?",
   "est_sec": 1.03,
   "gap_before": 1.07,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_11",
   "block": "pets.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "I'm fairly sure about it, but I could be wrong. What sounds off to you?",
   "est_sec": 4.75,
   "gap_before": 1.15,
   "role": "reply",
   "block": "pets.dlg26"
  },
  {
   "speaker": "user",
   "text": "Celsius?",
   "est_sec": 0.41,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "pets.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Yes, Celsius. The cool end can be a lot lower, more like room temperature.",
   "est_sec": 4.44,
   "gap_before": 0.57,
   "role": "reply",
   "block": "pets.dlg26"
  },
  {
   "speaker": "user",
   "text": "How do I heat it?",
   "est_sec": 1.65,
   "gap_before": 0.7,
   "event": "ordinary_request",
   "block": "pets.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Most people use a heat mat under one end controlled by a thermostat, or an overhead heat lamp. The thermostat is the important bit, so it doesn't overheat.",
   "est_sec": 8.78,
   "gap_before": 0.82,
   "role": "reply",
   "block": "pets.dlg26"
  },
  {
   "speaker": "user",
   "text": "And a light at night?",
   "est_sec": 1.65,
   "gap_before": 0.41,
   "event": "ordinary_request",
   "block": "pets.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "No, they need darkness at night to keep a healthy rhythm. Just keep the room from getting too cold.",
   "est_sec": 5.99,
   "gap_before": 0.68,
   "role": "reply",
   "block": "pets.dlg26"
  }
 ]
}
