 "est_total_sec": 48.42,
 "est_speech_sec": 38.61,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.66,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.52,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "My fourteen year old is bored out of his mind every weekend. He just wants to game.",
   "est_sec": 5.37,
   "gap_before": 0.23,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "That's very normal at fourteen. Is there anything he's into besides games?",
   "est_sec": 3.82,
   "gap_before": 0.6,
   "role": "reply",
   "block": "weekend_plans.dlg6"
  },
  {
   "speaker": "user",
   "text": "He used to like skateboarding, I think.",
   "est_sec": 2.27,
   "gap_before": 0.67,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "A skate park session with a friend could be a good start. Or let him try something that feels grown up, like an indoor climbing session.",
   "est_sec": 8.16,
   "gap_before": 0.83,
   "role": "reply",
   "block": "weekend_plans.dlg6"
  },
  {
   "speaker": "user",
   "text": "He'd probably say climbing is",
   "est_sec": 1.65,
   "gap_before": 0.41,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg6"
  },
  {
   "speaker": "user",
   "text": "for nerds.",
   "est_sec": 0.72,
   "gap_before": 2.68,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Then let him pick something himself from a short list. Teenagers say yes more when it's their choice.",
   "est_sec": 5.68,
   "gap_before": 0.85,
   "role": "reply",
   "block": "weekend_plans.dlg6"
  },
  {
   "speaker": "user",
   "text": "Smart. And if he still says no?",
   "est_sec": 2.27,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Try a deal. Gaming time in the evening, something out of the house in the afternoon.",
   "est_sec": 5.06,
   "gap_before": 0.48,
   "role": "reply",
   "block": "weekend_plans.dlg6"
  }
 ]
}
