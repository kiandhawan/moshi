 "est_total_sec": 53.56,
 "est_speech_sec": 41.4,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.51,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "I'm turning forty and I kind of don't want a party at all.",
   "est_sec": 4.13,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "That's completely okay. Some people prefer something quiet. What would make the day feel good to you?",
   "est_sec": 5.37,
   "gap_before": 1.27,
   "role": "reply",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "user",
   "text": "Honestly, a good meal and a day off with no phone.",
   "est_sec": 3.51,
   "gap_before": 1.47,
   "event": "ordinary_request",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "That sounds wonderful. You could plan a day trip somewhere new and finish with dinner at your favorite place.",
   "est_sec": 5.99,
   "gap_before": 0.79,
   "role": "reply",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "user",
   "text": "My family will be upset if I don't celebrate",
   "est_sec": 2.89,
   "gap_before": 0.78,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "user",
   "text": "at least a little.",
   "est_sec": 1.34,
   "gap_before": 1.86,
   "event": "ordinary_request",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Maybe a small family dinner the weekend after. That way they get to celebrate you, and you still get your quiet day.",
   "est_sec": 6.92,
   "gap_before": 1.13,
   "role": "reply",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "user",
   "text": "Yeah, that could work.",
   "est_sec": 1.34,
   "gap_before": 0.9,
   "event": "ordinary_request",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "It's your birthday, so do it your way. Forty is a good year to start that habit.",
   "est_sec": 5.37,
   "gap_before": 0.86,
   "role": "reply",
   "block": "birthday_party.dlg4"
  }
 ]
}
