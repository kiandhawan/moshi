 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.4,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "My dad uses a walking frame now. What can we do together at the weekend?",
   "est_sec": 4.75,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "There's plenty. Garden centres are flat and usually have a cafe, so they're a great relaxed outing.",
   "est_sec": 5.37,
   "gap_before": 0.88,
   "role": "reply",
   "block": "weekend_plans.dlg22"
  },
  {
   "speaker": "user",
   "text": "He used to love fishing.",
   "est_sec": 1.65,
   "gap_before": 3.43,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Some lakes have accessible fishing platforms. He might enjoy sitting by the water even if he doesn't fish for long.",
   "est_sec": 6.3,
   "gap_before": 1.19,
   "role": "reply",
   "block": "weekend_plans.dlg22"
  },
  {
   "speaker": "user",
   "text": "Oh, he'd love that. I'd",
   "est_sec": 1.65,
   "gap_before": 1.41,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg22"
  },
  {
   "speaker": "user",
   "text": "have to check the paths though.",
   "est_sec": 1.96,
   "gap_before": 1.88,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Call ahead and ask about parking, toilets and the surface of the paths.",
   "est_sec": 4.13,
   "gap_before": 1.08,
   "role": "reply",
   "block": "weekend_plans.dlg22"
  },
  {
   "speaker": "user",
   "text": "Good idea. And if it rains?",
   "est_sec": 1.96,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "A film matinee is often quiet and comfortable, or bring old photos and look through them together over tea.",
   "est_sec": 5.99,
   "gap_before": 0.35,
   "role": "reply",
   "block": "weekend_plans.dlg22"
  }
 ]
}
