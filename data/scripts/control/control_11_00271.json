 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.44,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.8,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "Physics word problems. I read them and freeze.",
   "est_sec": 2.58,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "studying.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Common one. Try a routine. First, write down every number they give you, with its unit.",
   "est_sec": 5.06,
   "gap_before": 1.06,
   "role": "reply",
   "block": "studying.dlg20"
  },
  {
   "speaker": "user",
   "text": "Okay, then what?",
   "est_sec": 1.03,
   "gap_before": 0.61,
   "event": "ordinary_request",
   "block": "studying.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Write down what they're actually asking for. Then look for the formula that connects what you know to what you want.",
   "est_sec": 6.61,
   "gap_before": 0.89,
   "role": "reply",
   "block": "studying.dlg20"
  },
  {
   "speaker": "user",
   "text": "Sometimes there are like",
   "est_sec": 1.34,
   "gap_before": 1.05,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg20"
  },
  {
   "speaker": "user",
   "text": "two formulas you need, though.",
   "est_sec": 1.65,
   "gap_before": 2.33,
   "event": "ordinary_request",
   "block": "studying.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Then work out the missing piece with the first formula, and use it in the second. Draw a quick sketch too, it helps a lot.",
   "est_sec": 7.85,
   "gap_before": 0.55,
   "role": "reply",
   "block": "studying.dlg20"
  },
  {
   "speaker": "user",
   "text": "A sketch for physics?",
   "est_sec": 1.34,
   "gap_before": 3.22,
   "event": "ordinary_request",
   "block": "studying.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Yes. Even a box with arrows for forces makes the problem much less scary.",
   "est_sec": 4.44,
   "gap_before": 0.79,
   "role": "reply",
   "block": "studying.dlg20"
  }
 ]
}
