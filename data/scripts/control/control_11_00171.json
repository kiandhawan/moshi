 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.33,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "I've been waking up with a stiff neck. Is it my pillow?",
   "est_sec": 3.82,
   "gap_before": 0.4,
   "event": "ordinary_request",
   "block": "shopping.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "It could be. A pillow that's too high or too flat for how you sleep can definitely do that.",
   "est_sec": 5.99,
   "gap_before": 1.1,
   "role": "reply",
   "block": "shopping.dlg20"
  },
  {
   "speaker": "user",
   "text": "I sleep on my side.",
   "est_sec": 1.65,
   "gap_before": 2.5,
   "event": "ordinary_request",
   "block": "shopping.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Side sleepers usually need a thicker, firmer pillow to fill the gap between your ear and your shoulder.",
   "est_sec": 5.68,
   "gap_before": 1.17,
   "role": "reply",
   "block": "shopping.dlg20"
  },
  {
   "speaker": "user",
   "text": "Mine is completely flat. I've had it for years.",
   "est_sec": 2.89,
   "gap_before": 1.14,
   "event": "ordinary_request",
   "block": "shopping.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "That's probably part of it. Pillows tend to lose their support after a couple of years.",
   "est_sec": 5.06,
   "gap_before": 0.49,
   "role": "reply",
   "block": "shopping.dlg20"
  },
  {
   "speaker": "user",
   "text": "There's memory foam, feather,",
   "est_sec": 1.34,
   "gap_before": 0.78,
   "event": "distractor",
   "kind": "pause",
   "block": "shopping.dlg20"
  },
  {
   "speaker": "user",
   "text": "wait, what's that buckwheat one?",
   "est_sec": 1.65,
   "gap_before": 2.02,
   "event": "ordinary_request",
   "block": "shopping.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Buckwheat pillows are filled with husks that shape around your neck. They're supportive but a bit crunchy and noisy.",
   "est_sec": 5.99,
   "gap_before": 1.0,
   "role": "reply",
   "block": "shopping.dlg20"
  },
  {
   "speaker": "user",
   "text": "Crunchy pillow sounds weird.",
   "est_sec": 1.34,
   "gap_before": 0.92,
   "event": "ordinary_request",
   "block": "shopping.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Some people love it. If not, a medium firm memory foam pillow is a safe choice for side sleepers.",
   "est_sec": 5.99,
   "gap_before": 1.08,
   "role": "reply",
   "block": "shopping.dlg20"
  }
 ]
}
