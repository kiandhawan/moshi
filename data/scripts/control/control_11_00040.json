 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.32,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.95,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "My kids want to camp in the garden on Saturday night.",
   "est_sec": 3.51,
   "gap_before": 0.3,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "That's a lovely adventure without the long drive. Do you have a tent?",
   "est_sec": 4.13,
   "gap_before": 0.89,
   "role": "reply",
   "block": "weekend_plans.dlg26"
  },
  {
   "speaker": "user",
   "text": "An old one somewhere in the shed.",
   "est_sec": 2.27,
   "gap_before": 1.23,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Set it up on Friday to check all the pegs and poles are there. Much better than finding out at bedtime.",
   "est_sec": 6.61,
   "gap_before": 0.68,
   "role": "reply",
   "block": "weekend_plans.dlg26"
  },
  {
   "speaker": "user",
   "text": "What do we do in the evening?",
   "est_sec": 2.27,
   "gap_before": 0.83,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Torch shadow puppets, toasting marshmallows if you have a fire pit, and spotting stars or bats.",
   "est_sec": 5.06,
   "gap_before": 0.48,
   "role": "reply",
   "block": "weekend_plans.dlg26"
  },
  {
   "speaker": "user",
   "text": "And if they",
   "est_sec": 1.03,
   "gap_before": 1.4,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg26"
  },
  {
   "speaker": "user",
   "text": "get scared at midnight?",
   "est_sec": 1.34,
   "gap_before": 1.66,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "The house is right there. That's the beauty of it, they can always come in, and they'll still feel brave for trying.",
   "est_sec": 6.92,
   "gap_before": 0.7,
   "role": "reply",
   "block": "weekend_plans.dlg26"
  }
 ]
}
