 "est_total_sec": 46.64,
 "est_speech_sec": 35.51,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.7,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.38,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "My best friend uses a wheelchair and I want to plan a day out on a trail together.",
   "est_sec": 5.68,
   "gap_before": 0.39,
   "event": "ordinary_request",
   "block": "hiking.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Lovely idea. Many parks now have accessible trails with smooth, firm surfaces and gentle slopes.",
   "est_sec": 4.75,
   "gap_before": 1.5,
   "role": "reply",
   "block": "hiking.dlg30"
  },
  {
   "speaker": "user",
   "text": "How do I find them?",
   "est_sec": 1.65,
   "gap_before": 0.61,
   "event": "ordinary_request",
   "block": "hiking.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Look on the park or council website, they often list accessible routes with details on gradients, gates and toilets.",
   "est_sec": 5.99,
   "gap_before": 0.93,
   "role": "reply",
   "block": "hiking.dlg30"
  },
  {
   "speaker": "user",
   "text": "She'd hate anything too short and boring.",
   "est_sec": 2.27,
   "gap_before": 0.66,
   "event": "ordinary_request",
   "block": "hiking.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Then look for old railway lines and reservoir paths. They're flat, often long, and have great views.",
   "est_sec": 5.37,
   "gap_before": 0.34,
   "role": "reply",
   "block": "hiking.dlg30"
  },
  {
   "speaker": "user",
   "text": "Should I",
   "est_sec": 0.72,
   "gap_before": 1.01,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg30"
  },
  {
   "speaker": "user",
   "text": "ask her to choose?",
   "est_sec": 1.34,
   "gap_before": 2.49,
   "event": "ordinary_request",
   "block": "hiking.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Definitely. She'll know what works for her chair, and you can plan the picnic.",
   "est_sec": 4.44,
   "gap_before": 0.62,
   "role": "reply",
   "block": "hiking.dlg30"
  }
 ]
}
