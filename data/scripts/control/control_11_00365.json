 "est_total_sec": 55.64,
 "est_speech_sec": 45.12,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.36,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "My lawn is more moss than grass at this point. Is it even worth fighting?",
   "est_sec": 4.75,
   "gap_before": 0.42,
   "event": "ordinary_request",
   "block": "gardening.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "It depends. Moss loves shade, damp and compacted soil. If your lawn has all three, it'll keep coming back.",
   "est_sec": 5.99,
   "gap_before": 0.68,
   "role": "reply",
   "block": "gardening.dlg14"
  },
  {
   "speaker": "user",
   "text": "Shady, yes. Damp, yes. Compacted, probably, the kids play football on it constantly.",
   "est_sec": 4.13,
   "gap_before": 0.94,
   "event": "ordinary_request",
   "block": "gardening.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Then you could rake the moss out in autumn, spike the soil with a fork for drainage, and overseed with a shade tolerant grass mix.",
   "est_sec": 7.85,
   "gap_before": 0.68,
   "role": "reply",
   "block": "gardening.dlg14"
  },
  {
   "speaker": "user",
   "text": "That sounds like a lot.",
   "est_sec": 1.65,
   "gap_before": 1.04,
   "event": "ordinary_request",
   "block": "gardening.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "It is a solid afternoon. The other option is accepting the moss. It's soft, green and stays that way without mowing much.",
   "est_sec": 6.92,
   "gap_before": 0.87,
   "role": "reply",
   "block": "gardening.dlg14"
  },
  {
   "speaker": "user",
   "text": "Honestly, a moss lawn",
   "est_sec": 1.34,
   "gap_before": 0.44,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg14"
  },
  {
   "speaker": "user",
   "text": "sounds kind of nice.",
   "est_sec": 1.34,
   "gap_before": 2.57,
   "event": "ordinary_request",
   "block": "gardening.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Plenty of people go that way. It won't love the football though, so maybe keep one patch of tough grass for the goal.",
   "est_sec": 7.23,
   "gap_before": 0.39,
   "role": "reply",
   "block": "gardening.dlg14"
  }
 ]
}
