 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.31,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "We're moving house with a three month old baby. Are we mad?",
   "est_sec": 3.82,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "moving_house.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Not mad, but it'll take some planning. Can someone look after the baby on moving day?",
   "est_sec": 5.06,
   "gap_before": 0.89,
   "role": "reply",
   "block": "moving_house.dlg25"
  },
  {
   "speaker": "user",
   "text": "My mum can, yes.",
   "est_sec": 1.34,
   "gap_before": 1.04,
   "event": "ordinary_request",
   "block": "moving_house.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "That's a huge help. Pack a separate bag with everything for the baby for a couple of days, so you're not searching through boxes.",
   "est_sec": 7.54,
   "gap_before": 0.82,
   "role": "reply",
   "block": "moving_house.dlg25"
  },
  {
   "speaker": "user",
   "text": "Good idea. What about the cot?",
   "est_sec": 1.96,
   "gap_before": 0.78,
   "event": "ordinary_request",
   "block": "moving_house.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Set up the cot first in the new place, before anything else. Use their usual sheets and sleeping bag so it smells familiar.",
   "est_sec": 7.23,
   "gap_before": 0.98,
   "role": "reply",
   "block": "moving_house.dlg25"
  },
  {
   "speaker": "user",
   "text": "Hold on, that's not right.",
   "est_sec": 1.65,
   "gap_before": 1.39,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_07",
   "block": "moving_house.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "I'm fairly sure about it, but I could be wrong. What sounds off to you?",
   "est_sec": 4.75,
   "gap_before": 0.97,
   "role": "reply",
   "block": "moving_house.dlg25"
  },
  {
   "speaker": "user",
   "text": "And what if",
   "est_sec": 1.03,
   "gap_before": 1.42,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg25"
  },
  {
   "speaker": "user",
   "text": "the baby doesn't sleep in the new room?",
   "est_sec": 2.58,
   "gap_before": 2.03,
   "event": "ordinary_request",
   "block": "moving_house.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "It may take a few nights. Keep the bedtime routine the same, and be patient with yourselves too.",
   "est_sec": 5.68,
   "gap_before": 1.27,
   "role": "reply",
   "block": "moving_house.dlg25"
  }
 ]
}
