 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.87,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "I'm doing an online degree while working and raising two kids. I'm exhausted.",
   "est_sec": 4.13,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "studying.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "That's a huge amount to carry. When do you usually manage to study?",
   "est_sec": 4.13,
   "gap_before": 1.16,
   "role": "reply",
   "block": "studying.dlg11"
  },
  {
   "speaker": "user",
   "text": "Late at night, after they're asleep. I fall asleep on my laptop half the time.",
   "est_sec": 4.75,
   "gap_before": 0.75,
   "event": "ordinary_request",
   "block": "studying.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Late nights after a full day are tough. Could you swap a few evenings for early mornings, before everyone's up?",
   "est_sec": 6.3,
   "gap_before": 0.65,
   "role": "reply",
   "block": "studying.dlg11"
  },
  {
   "speaker": "user",
   "text": "Mornings are pretty chaotic too.",
   "est_sec": 1.65,
   "gap_before": 0.98,
   "event": "ordinary_request",
   "block": "studying.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Even thirty minutes before the house wakes up can be your quietest time. And ask your partner or family to take the kids for one long block on the weekend.",
   "est_sec": 9.4,
   "gap_before": 0.91,
   "role": "reply",
   "block": "studying.dlg11"
  },
  {
   "speaker": "user",
   "text": "I feel guilty",
   "est_sec": 1.03,
   "gap_before": 1.21,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg11"
  },
  {
   "speaker": "user",
   "text": "asking for help.",
   "est_sec": 1.03,
   "gap_before": 2.03,
   "event": "ordinary_request",
   "block": "studying.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "You're doing this for your family's future too. Accepting help is part of making it work.",
   "est_sec": 5.06,
   "gap_before": 0.55,
   "role": "reply",
   "block": "studying.dlg11"
  }
 ]
}
