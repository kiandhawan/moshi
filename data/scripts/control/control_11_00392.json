   "gap_before": 1.01,
   "event": "ordinary_request",
   "block": "sleep.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Then watch something light afterwards, even twenty minutes of a comedy, to reset your mood before bed.",
