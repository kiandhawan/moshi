 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.64,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.53,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "Is ten thousand steps a day actually a thing, or just a number someone made up?",
   "est_sec": 5.06,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "fitness.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "It's a bit of both. It started partly as a marketing number, but research does show more steps help your health.",
   "est_sec": 6.61,
   "gap_before": 0.44,
   "role": "reply",
   "block": "fitness.dlg10"
  },
  {
   "speaker": "user",
   "text": "So do I need ten thousand?",
   "est_sec": 1.96,
   "gap_before": 1.09,
   "event": "ordinary_request",
   "block": "fitness.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Not exactly. Benefits seem to rise up to around seven or eight thousand for many people, and more is still good.",
   "est_sec": 6.61,
   "gap_before": 0.4,
   "role": "reply",
   "block": "fitness.dlg10"
  },
  {
   "speaker": "user",
   "text": "I'm at like three thousand on a desk day.",
   "est_sec": 2.89,
   "gap_before": 1.43,
   "event": "ordinary_request",
   "block": "fitness.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Then any increase is a win. Try a ten minute walk after each meal.",
   "est_sec": 4.44,
   "gap_before": 1.12,
   "role": "reply",
   "block": "fitness.dlg10"
  },
  {
   "speaker": "user",
   "text": "After every meal?",
   "est_sec": 1.03,
   "gap_before": 0.72,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg10"
  },
  {
   "speaker": "user",
   "text": "That's a lot.",
   "est_sec": 1.03,
   "gap_before": 2.57,
   "event": "ordinary_request",
   "block": "fitness.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Even after lunch alone gets you over a thousand extra steps. Start there and add more if you like it.",
   "est_sec": 6.3,
   "gap_before": 0.98,
   "role": "reply",
   "block": "fitness.dlg10"
  }
 ]
}
