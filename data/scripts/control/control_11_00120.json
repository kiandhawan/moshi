 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.48,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.49,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "My kids' room is chaos. Toys everywhere, every single day.",
   "est_sec": 3.2,
   "gap_before": 0.59,
   "event": "ordinary_request",
   "block": "cleaning.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Open bins with picture labels really help younger kids. They can see where everything goes without reading.",
   "est_sec": 5.37,
   "gap_before": 0.76,
   "role": "reply",
   "block": "cleaning.dlg2"
  },
  {
   "speaker": "user",
   "text": "They're five and eight.",
   "est_sec": 1.34,
   "gap_before": 0.89,
   "event": "ordinary_request",
   "block": "cleaning.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Perfect ages for that. You could also try a quick ten minute tidy before bedtime, with a song playing as a timer.",
   "est_sec": 6.92,
   "gap_before": 1.07,
   "role": "reply",
   "block": "cleaning.dlg2"
  },
  {
   "speaker": "user",
   "text": "Ha, they'd like that. But they",
   "est_sec": 1.96,
   "gap_before": 2.98,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg2"
  },
  {
   "speaker": "user",
   "text": "have way too many toys, honestly.",
   "est_sec": 1.96,
   "gap_before": 2.0,
   "event": "ordinary_request",
   "block": "cleaning.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Try rotating them. Put half in a box in the closet and swap them every month, so the old ones feel new again.",
   "est_sec": 7.23,
   "gap_before": 0.5,
   "role": "reply",
   "block": "cleaning.dlg2"
  },
  {
   "speaker": "user",
   "text": "Oh, that's clever. Less mess and less begging for new stuff.",
   "est_sec": 3.51,
   "gap_before": 0.95,
   "event": "ordinary_request",
   "block": "cleaning.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. And fewer toys out means the tidy really does take ten minutes.",
   "est_sec": 4.13,
   "gap_before": 1.62,
   "role": "reply",
   "block": "cleaning.dlg2"
  }
 ]
}
