 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.45,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.47,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "Every time I blind bake a tart case, the sides slump down. What am I doing wrong?",
   "est_sec": 5.37,
   "gap_before": 0.25,
   "event": "ordinary_request",
   "block": "baking.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Usually the pastry is too warm going into the oven. Chill the lined tin for at least thirty minutes first.",
   "est_sec": 6.3,
   "gap_before": 0.82,
   "role": "reply",
   "block": "baking.dlg5"
  },
  {
   "speaker": "user",
   "text": "I do use baking beans, though.",
   "est_sec": 1.96,
   "gap_before": 0.39,
   "event": "ordinary_request",
   "block": "baking.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Good, but fill them right up to the rim, not just the bottom. The beans hold the sides in place.",
   "est_sec": 6.3,
   "gap_before": 1.12,
   "role": "reply",
   "block": "baking.dlg5"
  },
  {
   "speaker": "user",
   "text": "Oh. I only put",
   "est_sec": 1.34,
   "gap_before": 0.68,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg5"
  },
  {
   "speaker": "user",
   "text": "like a single layer in.",
   "est_sec": 1.65,
   "gap_before": 2.79,
   "event": "ordinary_request",
   "block": "baking.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "That'll be it. Also leave a bit of pastry hanging over the edge and trim it after baking, so any shrinking doesn't matter.",
   "est_sec": 7.23,
   "gap_before": 1.14,
   "role": "reply",
   "block": "baking.dlg5"
  },
  {
   "speaker": "user",
   "text": "Trim after? That feels backwards.",
   "est_sec": 1.65,
   "gap_before": 1.46,
   "event": "ordinary_request",
   "block": "baking.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "It does, but a sharp knife on cooled pastry gives you a really clean edge.",
   "est_sec": 4.75,
   "gap_before": 0.67,
   "role": "reply",
   "block": "baking.dlg5"
  }
 ]
}
