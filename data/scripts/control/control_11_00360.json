 "est_speech_sec": 39.54,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.74,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.41,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "So I'm thirty one and moving back in with my parents to save for a house. Mixed feelings.",
   "est_sec": 5.68,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "moving_house.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "That's a really common and sensible move these days, even if it feels strange.",
   "est_sec": 4.44,
   "gap_before": 0.78,
   "role": "reply",
   "block": "moving_house.dlg15"
  },
  {
   "speaker": "user",
   "text": "I'm worried we'll drive each other mad.",
   "est_sec": 2.27,
   "gap_before": 1.45,
   "event": "ordinary_request",
   "block": "moving_house.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Talk about expectations early. Things like chores, guests, cooking and whether they'll wait up for you.",
   "est_sec": 5.06,
   "gap_before": 0.64,
   "role": "reply",
   "block": "moving_house.dlg15"
  },
  {
   "speaker": "user",
   "text": "Ha, my mum will absolutely wait up.",
   "est_sec": 2.27,
   "gap_before": 1.09,
   "event": "ordinary_request",
   "block": "moving_house.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Then agree on something like a text if you're late. It's much easier to set the rules at the start than mid argument.",
   "est_sec": 7.23,
   "gap_before": 1.07,
   "role": "reply",
   "block": "moving_house.dlg15"
  },
  {
   "speaker": "user",
   "text": "Should I pay",
   "est_sec": 1.03,
   "gap_before": 2.7,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg15"
  },
  {
   "speaker": "user",
   "text": "rent or something?",
   "est_sec": 1.03,
   "gap_before": 2.0,
   "event": "ordinary_request",
   "block": "moving_house.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Offering some money or covering the food shop shows respect, even if it's less than market rent. It also keeps you feeling like an adult.",
   "est_sec": 7.85,
   "gap_before": 0.71,
   "role": "reply",
   "block": "moving_house.dlg15"
  }
 ]
}
