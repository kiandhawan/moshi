 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.92,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "I'm thinking of doing a little day trip on Sunday. Somewhere I can get to by train.",
   "est_sec": 5.37,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Sounds fun. Do you prefer the seaside, a historic town, or countryside walks?",
   "est_sec": 4.13,
   "gap_before": 0.55,
   "role": "reply",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "user",
   "text": "Seaside, I think. I haven't seen the sea in ages.",
   "est_sec": 3.2,
   "gap_before": 1.44,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Then pick a coastal town within about two hours by train. Leave early so you get a full day there.",
   "est_sec": 6.3,
   "gap_before": 1.16,
   "role": "reply",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "user",
   "text": "What if the weather's bad?",
   "est_sec": 1.65,
   "gap_before": 1.3,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Seaside towns are still nice in grey weather. A cozy cafe, the pier, maybe an aquarium if there's one.",
   "est_sec": 5.99,
   "gap_before": 0.89,
   "role": "reply",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "user",
   "text": "Actually, I might",
   "est_sec": 1.03,
   "gap_before": 1.07,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "user",
   "text": "bring my sister along.",
   "est_sec": 1.34,
   "gap_before": 2.16,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Even better. Check if there's a two together railcard or group ticket, it can save you a lot.",
   "est_sec": 5.68,
   "gap_before": 0.4,
   "role": "reply",
   "block": "weekend_plans.dlg3"
  }
 ]
}
