 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.79,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.32,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "I keep forgetting due dates and paying late fees. Any tricks?",
   "est_sec": 3.51,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "personal_finance.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Set up autopay for the minimum on every bill, so you're never late. You can still pay extra by hand.",
   "est_sec": 6.3,
   "gap_before": 0.6,
   "role": "reply",
   "block": "personal_finance.dlg3"
  },
  {
   "speaker": "user",
   "text": "Autopay makes me nervous though. What if there's not enough in the account?",
   "est_sec": 4.13,
   "gap_before": 1.51,
   "event": "ordinary_request",
   "block": "personal_finance.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Then line up the due dates with your payday. Most companies let you change your billing date if you ask.",
   "est_sec": 6.3,
   "gap_before": 1.03,
   "role": "reply",
   "block": "personal_finance.dlg3"
  },
  {
   "speaker": "user",
   "text": "Oh, I didn't know that was possible.",
   "est_sec": 2.27,
   "gap_before": 1.08,
   "event": "ordinary_request",
   "block": "personal_finance.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "It usually is, just call or check the settings online. Having everything due right after payday makes life easier.",
   "est_sec": 5.99,
   "gap_before": 0.52,
   "role": "reply",
   "block": "personal_finance.dlg3"
  },
  {
   "speaker": "user",
   "text": "Okay, I'll try that with the phone bill first",
   "est_sec": 2.89,
   "gap_before": 3.11,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg3"
  },
  {
   "speaker": "user",
   "text": "and see how it goes.",
   "est_sec": 1.65,
   "gap_before": 2.41,
   "event": "ordinary_request",
   "block": "personal_finance.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Good plan. Once it works, move the others over one by one.",
   "est_sec": 3.82,
   "gap_before": 1.69,
   "role": "reply",
   "block": "personal_finance.dlg3"
  }
 ]
}
