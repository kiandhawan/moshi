 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.7,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.57,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "I played cello until I was eighteen. Now I'm forty and I want to join a community orchestra.",
   "est_sec": 5.68,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "music.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "That's wonderful. Community orchestras love returning players, especially cellists.",
   "est_sec": 2.89,
   "gap_before": 0.54,
   "role": "reply",
   "block": "music.dlg32"
  },
  {
   "speaker": "user",
   "text": "I'm so rusty though.",
   "est_sec": 1.34,
   "gap_before": 1.48,
   "event": "ordinary_request",
   "block": "music.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Most people are. Spend a few weeks on scales and easy pieces first, just to get your fingers back.",
   "est_sec": 5.99,
   "gap_before": 0.32,
   "role": "reply",
   "block": "music.dlg32"
  },
  {
   "speaker": "user",
   "text": "Should I get lessons again or",
   "est_sec": 1.96,
   "gap_before": 1.16,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg32"
  },
  {
   "speaker": "user",
   "text": "just dive in?",
   "est_sec": 1.03,
   "gap_before": 2.19,
   "event": "ordinary_request",
   "block": "music.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "A few lessons can help a lot after a long break. A teacher will spot old habits and get your bowing smooth again.",
   "est_sec": 7.23,
   "gap_before": 0.51,
   "role": "reply",
   "block": "music.dlg32"
  },
  {
   "speaker": "user",
   "text": "And the audition?",
   "est_sec": 1.03,
   "gap_before": 1.1,
   "event": "ordinary_request",
   "block": "music.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Many community orchestras don't even hold a proper audition. Email them, ask if you can sit in on a rehearsal, and see how it feels.",
   "est_sec": 7.85,
   "gap_before": 0.38,
   "role": "reply",
   "block": "music.dlg32"
  }
 ]
}
