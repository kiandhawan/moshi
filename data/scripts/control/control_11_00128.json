 "est_total_sec": 48.76,
 "est_speech_sec": 39.13,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.48,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.34,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "It's going to drop to minus ten tonight. Will my pipes freeze?",
   "est_sec": 3.82,
   "gap_before": 0.42,
   "event": "ordinary_request",
   "block": "weather_plans.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "They might, especially any in the loft, garage, or along outside walls. Let's make sure they don't.",
   "est_sec": 5.37,
   "gap_before": 0.6,
   "role": "reply",
   "block": "weather_plans.dlg26"
  },
  {
   "speaker": "user",
   "text": "What do I do?",
   "est_sec": 1.34,
   "gap_before": 0.98,
   "event": "ordinary_request",
   "block": "weather_plans.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Keep the heating on low through the night, even if you're out. Open the cupboard under the sink so warm air reaches the pipes.",
   "est_sec": 7.54,
   "gap_before": 1.02,
   "role": "reply",
   "block": "weather_plans.dlg26"
  },
  {
   "speaker": "user",
   "text": "And outside taps?",
   "est_sec": 1.03,
   "gap_before": 0.72,
   "event": "ordinary_request",
   "block": "weather_plans.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Turn them off from inside if you can, and drain them. Cover them with an insulating jacket or wrap them in old towels.",
   "est_sec": 7.23,
   "gap_before": 1.66,
   "role": "reply",
   "block": "weather_plans.dlg26"
  },
  {
   "speaker": "user",
   "text": "What if one freezes anyway?",
   "est_sec": 1.65,
   "gap_before": 1.41,
   "event": "ordinary_request",
   "block": "weather_plans.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Thaw it slowly with a hairdryer or a hot water bottle, never a flame. And know where your stopcock is in case it bursts.",
   "est_sec": 7.54,
   "gap_before": 0.5,
   "role": "reply",
   "block": "weather_plans.dlg26"
  }
 ]
}
