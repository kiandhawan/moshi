 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.89,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "I'm having people over for my birthday and I want some games for adults that aren't awkward.",
   "est_sec": 5.37,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "birthday_party.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Do your guests mostly know each other, or is it a mix of friend groups?",
   "est_sec": 4.75,
   "gap_before": 0.96,
   "role": "reply",
   "block": "birthday_party.dlg11"
  },
  {
   "speaker": "user",
   "text": "Total mix. Work people, uni friends, my climbing lot.",
   "est_sec": 2.89,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "birthday_party.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Then start with something that pairs strangers up. Two truths and a lie works, or a team quiz where you mix the teams on purpose.",
   "est_sec": 7.85,
   "gap_before": 0.44,
   "role": "reply",
   "block": "birthday_party.dlg11"
  },
  {
   "speaker": "user",
   "text": "A quiz about me, maybe?",
   "est_sec": 1.65,
   "gap_before": 2.87,
   "event": "ordinary_request",
   "block": "birthday_party.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "That's fun, as long as it's not all inside jokes. Mix questions about you with general ones so everyone has a chance.",
   "est_sec": 6.92,
   "gap_before": 1.18,
   "role": "reply",
   "block": "birthday_party.dlg11"
  },
  {
   "speaker": "user",
   "text": "Okay, and then later in the night",
   "est_sec": 2.27,
   "gap_before": 0.87,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg11"
  },
  {
   "speaker": "user",
   "text": "something sillier?",
   "est_sec": 0.72,
   "gap_before": 2.45,
   "event": "ordinary_request",
   "block": "birthday_party.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Charades or a drawing game where you guess the picture. They loosen people up quickly once a few drinks are in.",
   "est_sec": 6.61,
   "gap_before": 0.34,
   "role": "reply",
   "block": "birthday_party.dlg11"
  }
 ]
}
