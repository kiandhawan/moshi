 "est_speech_sec": 40.47,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.76,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.47,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "Hi, my hot water tank is making a weird rumbling sound.",
   "est_sec": 3.51,
   "gap_before": 0.25,
   "event": "ordinary_request",
   "block": "home_repair.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "That's often a build up of sediment at the bottom of the tank. As the water heats, it bubbles through and rumbles.",
   "est_sec": 6.92,
   "gap_before": 0.47,
   "role": "reply",
   "block": "home_repair.dlg32"
  },
  {
   "speaker": "user",
   "text": "Is it dangerous?",
   "est_sec": 1.03,
   "gap_before": 1.31,
   "event": "ordinary_request",
   "block": "home_repair.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Not usually right away, but it makes the heater work harder and wear out sooner. Flushing the tank helps.",
   "est_sec": 5.99,
   "gap_before": 1.19,
   "role": "reply",
   "block": "home_repair.dlg32"
  },
  {
   "speaker": "user",
   "text": "How do I flush it?",
   "est_sec": 1.65,
   "gap_before": 0.92,
   "event": "ordinary_request",
   "block": "home_repair.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Turn off the power or gas, attach a hose to the drain valve at the bottom, and let some water run out until it's clear.",
   "est_sec": 7.85,
   "gap_before": 0.75,
   "role": "reply",
   "block": "home_repair.dlg32"
  },
  {
   "speaker": "user",
   "text": "I live",
   "est_sec": 0.72,
   "gap_before": 0.41,
   "event": "distractor",
   "kind": "pause",
   "block": "home_repair.dlg32"
  },
  {
   "speaker": "user",
   "text": "in an apartment with a shared boiler. Is that the same thing?",
   "est_sec": 3.82,
   "gap_before": 2.83,
   "event": "ordinary_request",
   "block": "home_repair.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Ah, then it's not your job. Report the noise to the building manager and let them handle it.",
   "est_sec": 5.68,
   "gap_before": 0.36,
   "role": "reply",
   "block": "home_repair.dlg32"
  }
 ]
}
