 "est_total_sec": 65.03,
 "est_speech_sec": 52.45,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.44,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.66,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "I'm selling my car this week. How do I make the photos look good enough?",
   "est_sec": 4.75,
   "gap_before": 0.32,
   "event": "ordinary_request",
   "block": "photography.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Wash it first, inside and out, it matters more than any camera trick. Then pick an empty spot with a plain background, like a car park on a Sunday.",
   "est_sec": 9.09,
   "gap_before": 0.67,
   "role": "reply",
   "block": "photography.dlg31"
  },
  {
   "speaker": "user",
   "text": "Which angles do buyers want?",
   "est_sec": 1.65,
   "gap_before": 1.53,
   "event": "ordinary_request",
   "block": "photography.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Front corner, back corner, both sides, the dashboard, the seats, the boot, and the tyres. And one clear shot of the mileage.",
   "est_sec": 6.92,
   "gap_before": 0.94,
   "role": "reply",
   "block": "photography.dlg31"
  },
  {
   "speaker": "user",
   "text": "That's a lot of photos.",
   "est_sec": 1.65,
   "gap_before": 1.27,
   "event": "ordinary_request",
   "block": "photography.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "It builds trust. Buyers skip ads with three blurry pictures. Shoot in the morning or on a cloudy day so the paint doesn't reflect everything.",
   "est_sec": 7.85,
   "gap_before": 0.82,
   "role": "reply",
   "block": "photography.dlg31"
  },
  {
   "speaker": "user",
   "text": "There's a scratch on the back door.",
   "est_sec": 2.27,
   "gap_before": 1.17,
   "event": "ordinary_request",
   "block": "photography.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Photograph it honestly. People feel better about a seller who shows the flaws, and it saves an argument when they come to look.",
   "est_sec": 7.23,
   "gap_before": 0.31,
   "role": "reply",
   "block": "photography.dlg31"
  },
  {
   "speaker": "user",
   "text": "Hold on, that's not right.",
   "est_sec": 1.65,
   "gap_before": 0.7,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_07",
   "block": "photography.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "I'm fairly sure about it, but I could be wrong. What sounds off to you?",
   "est_sec": 4.75,
   "gap_before": 1.61,
   "role": "reply",
   "block": "photography.dlg31"
  },
  {
   "speaker": "user",
   "text": "Fair enough.",
   "est_sec": 0.72,
   "gap_before": 0.64,
   "block": "photography.dlg31"
  }
 ]
}
