 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.45,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.96,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "My teacher keeps telling me to practise with a metronome. I find it so boring.",
   "est_sec": 4.75,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "music.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Fair, it's not thrilling. But it's one of the fastest ways to clean up your playing.",
   "est_sec": 5.06,
   "gap_before": 0.82,
   "role": "reply",
   "block": "music.dlg8"
  },
  {
   "speaker": "user",
   "text": "Why does it matter so much?",
   "est_sec": 1.96,
   "gap_before": 0.41,
   "event": "ordinary_request",
   "block": "music.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Most people rush the easy bits and slow down on the hard bits. A metronome shows you exactly where.",
   "est_sec": 5.99,
   "gap_before": 1.13,
   "role": "reply",
   "block": "music.dlg8"
  },
  {
   "speaker": "user",
   "text": "I just feel",
   "est_sec": 1.03,
   "gap_before": 1.22,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg8"
  },
  {
   "speaker": "user",
   "text": "kind of robotic with it on.",
   "est_sec": 1.96,
   "gap_before": 2.6,
   "event": "ordinary_request",
   "block": "music.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "That's normal at first. Try setting it slow and only practising the tricky bars with it, not the whole piece.",
   "est_sec": 6.3,
   "gap_before": 0.56,
   "role": "reply",
   "block": "music.dlg8"
  },
  {
   "speaker": "user",
   "text": "Okay, that sounds less painful.",
   "est_sec": 1.65,
   "gap_before": 0.88,
   "event": "ordinary_request",
   "block": "music.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "And make it a game. Every time you play the bit perfectly three times in a row, nudge the speed up a little.",
   "est_sec": 7.23,
   "gap_before": 0.74,
   "role": "reply",
   "block": "music.dlg8"
  }
 ]
}
