 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.33,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.95,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "Paper or app for keeping score? My husband loves apps, I love paper.",
   "est_sec": 4.13,
   "gap_before": 0.21,
   "event": "ordinary_request",
   "block": "board_games.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Both work. Apps are handy for games with complicated scoring, they add everything up and keep a history.",
   "est_sec": 5.68,
   "gap_before": 1.03,
   "role": "reply",
   "block": "board_games.dlg29"
  },
  {
   "speaker": "user",
   "text": "But paper's nicer. It's part of the fun.",
   "est_sec": 2.58,
   "gap_before": 0.99,
   "event": "ordinary_request",
   "block": "board_games.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "It really can be. A little notebook just for game scores becomes a lovely record over the years, with dates and funny notes.",
   "est_sec": 7.23,
   "gap_before": 1.08,
   "role": "reply",
   "block": "board_games.dlg29"
  },
  {
   "speaker": "user",
   "text": "Hold on a sec, he says paper",
   "est_sec": 2.27,
   "gap_before": 1.11,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg29"
  },
  {
   "speaker": "user",
   "text": "leads to mistakes.",
   "est_sec": 1.03,
   "gap_before": 1.71,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_17",
   "block": "board_games.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "He has a point for big scores. You could do both, paper for the record, and he checks with the app at the end.",
   "est_sec": 7.54,
   "gap_before": 0.7,
   "role": "reply",
   "block": "board_games.dlg29"
  },
  {
   "speaker": "user",
   "text": "So we both win.",
   "est_sec": 1.34,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "board_games.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "In scorekeeping at least. The game itself is between you two.",
   "est_sec": 3.51,
   "gap_before": 1.51,
   "role": "reply",
   "block": "board_games.dlg29"
  }
 ]
