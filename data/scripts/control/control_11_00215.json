 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.41,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.94,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "What should I ask when I go to see a flat?",
   "est_sec": 3.51,
   "gap_before": 0.27,
   "event": "ordinary_request",
   "block": "moving_house.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Ask what's included in the rent, how much bills usually are, and how long the lease is. Also ask why the last tenant left.",
   "est_sec": 7.54,
   "gap_before": 0.31,
   "role": "reply",
   "block": "moving_house.dlg1"
  },
  {
   "speaker": "user",
   "text": "Hold on, that's not right.",
   "est_sec": 1.65,
   "gap_before": 2.51,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_07",
   "block": "moving_house.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Hmm, I believe it is. Which part doesn't sound right?",
   "est_sec": 3.2,
   "gap_before": 0.46,
   "role": "reply",
   "block": "moving_house.dlg1"
  },
  {
   "speaker": "user",
   "text": "Anything I should check myself?",
   "est_sec": 1.65,
   "gap_before": 0.62,
   "event": "ordinary_request",
   "block": "moving_house.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Run the taps and the shower to test the water pressure, look for damp or mould in corners, and check your phone signal in each room.",
   "est_sec": 8.16,
   "gap_before": 0.32,
   "role": "reply",
   "block": "moving_house.dlg1"
  },
  {
   "speaker": "user",
   "text": "Phone signal, I never would have thought of that.",
   "est_sec": 2.89,
   "gap_before": 0.59,
   "event": "ordinary_request",
   "block": "moving_house.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "It's easy to miss. Same with noise, try to visit in the evening if you can.",
   "est_sec": 5.06,
   "gap_before": 0.95,
   "role": "reply",
   "block": "moving_house.dlg1"
  },
  {
   "speaker": "user",
   "text": "And if I like it, should I",
   "est_sec": 2.27,
   "gap_before": 0.56,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg1"
  },
  {
   "speaker": "user",
   "text": "just say yes on the spot?",
   "est_sec": 1.96,
   "gap_before": 1.99,
   "event": "ordinary_request",
   "block": "moving_house.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "In a busy market you might have to move fast. Have your documents ready so you can apply the same day.",
   "est_sec": 6.61,
   "gap_before": 0.64,
   "role": "reply",
   "block": "moving_house.dlg1"
  }
