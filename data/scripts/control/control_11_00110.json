 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.38,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.91,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "Everyone at my gym takes creatine. Is it just hype?",
   "est_sec": 3.2,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "fitness.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "It's actually one of the most studied supplements. It helps with short, intense efforts like lifting and sprints.",
   "est_sec": 5.68,
   "gap_before": 0.58,
   "role": "reply",
   "block": "fitness.dlg18"
  },
  {
   "speaker": "user",
   "text": "Is it safe? My mum thinks it's like steroids.",
   "est_sec": 2.89,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "fitness.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "It's not a steroid. For healthy adults, research suggests it's safe at normal doses. Check with a doctor if you have kidney problems.",
   "est_sec": 7.23,
   "gap_before": 0.83,
   "role": "reply",
   "block": "fitness.dlg18"
  },
  {
   "speaker": "user",
   "text": "What's a normal dose?",
   "est_sec": 1.34,
   "gap_before": 0.81,
   "event": "ordinary_request",
   "block": "fitness.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Around three to five grams a day, every day. You don't need a loading phase.",
   "est_sec": 4.75,
   "gap_before": 1.11,
   "role": "reply",
   "block": "fitness.dlg18"
  },
  {
   "speaker": "user",
   "text": "Does it make you",
   "est_sec": 1.34,
   "gap_before": 0.76,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg18"
  },
  {
   "speaker": "user",
   "text": "like, puffy?",
   "est_sec": 0.72,
   "gap_before": 2.58,
   "event": "ordinary_request",
   "block": "fitness.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "You may gain a little water weight in your muscles at first. That's normal and not fat.",
   "est_sec": 5.37,
   "gap_before": 1.97,
   "role": "reply",
   "block": "fitness.dlg18"
  },
  {
   "speaker": "user",
   "text": "Okay, I'll tell my mum.",
   "est_sec": 1.65,
   "gap_before": 0.36,
   "event": "ordinary_request",
   "block": "fitness.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Maybe show her the research too. That usually helps.",
   "est_sec": 2.89,
   "gap_before": 0.71,
   "role": "reply",
   "block": "fitness.dlg18"
  }
 ]
}
