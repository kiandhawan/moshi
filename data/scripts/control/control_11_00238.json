 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.52,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.41,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "We've moved in, but the place still feels like someone else's house.",
   "est_sec": 3.82,
   "gap_before": 0.24,
   "event": "ordinary_request",
   "block": "moving_house.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "That's normal for a while. Small touches make a big difference, like hanging a few of your own pictures.",
   "est_sec": 5.99,
   "gap_before": 0.9,
   "role": "reply",
   "block": "moving_house.dlg24"
  },
  {
   "speaker": "user",
   "text": "We haven't put a single thing on the walls.",
   "est_sec": 2.89,
   "gap_before": 0.85,
   "event": "ordinary_request",
   "block": "moving_house.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "Start there. Then add soft lighting, lamps instead of the big ceiling light make a room feel warmer instantly.",
   "est_sec": 5.99,
   "gap_before": 0.43,
   "role": "reply",
   "block": "moving_house.dlg24"
  },
  {
   "speaker": "user",
   "text": "Oh, we only have the ceiling lights.",
   "est_sec": 2.27,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "moving_house.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "A couple of cheap lamps would help a lot. Plants and a rug do the same.",
   "est_sec": 5.06,
   "gap_before": 0.52,
   "role": "reply",
   "block": "moving_house.dlg24"
  },
  {
   "speaker": "user",
   "text": "And maybe",
   "est_sec": 0.72,
   "gap_before": 0.79,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg24"
  },
  {
   "speaker": "user",
   "text": "cook something that smells nice?",
   "est_sec": 1.65,
   "gap_before": 2.93,
   "event": "ordinary_request",
   "block": "moving_house.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. A big Sunday dinner in the new kitchen is one of the best ways to make it feel like yours.",
   "est_sec": 6.61,
   "gap_before": 1.03,
   "role": "reply",
   "block": "moving_house.dlg24"
  }
 ]
}
