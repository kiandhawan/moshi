 "est_speech_sec": 35.3,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.38,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.85,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "Caramelizing onions takes forever. Can I just turn the heat up?",
   "est_sec": 3.51,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "cooking.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "You can go a bit higher, but too much heat burns them before they go sweet.",
   "est_sec": 5.06,
   "gap_before": 0.36,
   "role": "reply",
   "block": "cooking.dlg24"
  },
  {
   "speaker": "user",
   "text": "The recipe said ten minutes. It's been twenty-five.",
   "est_sec": 2.58,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "cooking.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "That's really common. Properly caramelized onions usually take forty minutes or more.",
   "est_sec": 3.82,
   "gap_before": 0.75,
   "role": "reply",
   "block": "cooking.dlg24"
  },
  {
   "speaker": "user",
   "text": "Seriously? Recipes lie?",
   "est_sec": 1.03,
   "gap_before": 0.41,
   "event": "ordinary_request",
   "block": "cooking.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "Quite often about onions, yes. A pinch of salt helps them release water and soften faster.",
   "est_sec": 5.06,
   "gap_before": 0.86,
   "role": "reply",
   "block": "cooking.dlg24"
  },
  {
   "speaker": "user",
   "text": "What about sugar?",
   "est_sec": 1.03,
   "gap_before": 1.05,
   "event": "ordinary_request",
   "block": "cooking.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "A little sugar speeds the browning, but it's not true caramelizing. Fine if you're in a hurry, though.",
   "est_sec": 5.68,
   "gap_before": 1.81,
   "role": "reply",
   "block": "cooking.dlg24"
  },
  {
   "speaker": "user",
   "text": "I'll keep going",
   "est_sec": 1.03,
   "gap_before": 1.27,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg24"
  },
  {
   "speaker": "user",
   "text": "I guess. My burger can wait.",
   "est_sec": 1.96,
   "gap_before": 1.77,
   "block": "cooking.dlg24"
  }
 ]
}
