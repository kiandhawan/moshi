  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.33,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "Is it worth getting a cashback credit card?",
   "est_sec": 2.58,
   "gap_before": 0.34,
   "event": "ordinary_request",
   "block": "personal_finance.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "It can be, but only if you pay it off in full every month. Otherwise the interest wipes out the cashback.",
   "est_sec": 6.61,
   "gap_before": 0.99,
   "role": "reply",
   "block": "personal_finance.dlg18"
  },
  {
   "speaker": "user",
   "text": "I always pay in full.",
   "est_sec": 1.65,
   "gap_before": 0.89,
   "event": "ordinary_request",
   "block": "personal_finance.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Then it's free money. Look for one with no annual fee and cashback on the things you buy most.",
   "est_sec": 5.99,
   "gap_before": 0.75,
   "role": "reply",
   "block": "personal_finance.dlg18"
  },
  {
   "speaker": "user",
   "text": "Like groceries and petrol?",
   "est_sec": 1.34,
   "gap_before": 1.41,
   "event": "ordinary_request",
   "block": "personal_finance.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Some cards give extra on those categories.",
   "est_sec": 2.58,
   "gap_before": 1.94,
   "role": "reply",
   "block": "personal_finance.dlg18"
  },
  {
   "speaker": "user",
   "text": "Does applying hurt my credit score?",
   "est_sec": 1.96,
   "gap_before": 0.66,
   "event": "ordinary_request",
   "block": "personal_finance.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "A little, briefly, because of the check. If you're not planning a mortgage soon, it's not a big deal.",
   "est_sec": 5.99,
   "gap_before": 0.94,
   "role": "reply",
   "block": "personal_finance.dlg18"
  }
 ]
