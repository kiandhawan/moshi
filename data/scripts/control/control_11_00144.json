   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "Can you suggest a book for a twelve year old who says reading is boring?",
   "est_sec": 4.75,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "books.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Try a fast, funny adventure with short chapters, or a graphic novel. They feel quick and rewarding.",
   "est_sec": 5.37,
   "gap_before": 0.77,
   "role": "reply",
   "block": "books.dlg1"
  },
  {
   "speaker": "user",
   "text": "Graphic novels count as reading?",
   "est_sec": 1.65,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "books.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Absolutely. They build vocabulary and following a story, and they're often a gateway to longer books.",
   "est_sec": 5.06,
   "gap_before": 0.79,
   "role": "reply",
   "block": "books.dlg1"
  },
