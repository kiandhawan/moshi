 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.38,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "I'm retired and I wake up at five every morning, wide awake. Drives my wife mad.",
   "est_sec": 5.06,
   "gap_before": 0.34,
   "event": "ordinary_request",
   "block": "sleep.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "That's very common as we get older, our body clocks tend to shift earlier.",
   "est_sec": 4.44,
   "gap_before": 0.74,
   "role": "reply",
   "block": "sleep.dlg18"
  },
  {
   "speaker": "user",
   "text": "Can I change it?",
   "est_sec": 1.34,
   "gap_before": 1.39,
   "event": "ordinary_request",
   "block": "sleep.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Somewhat. Getting bright light in the late afternoon and evening, like a walk at five, can nudge your clock later.",
   "est_sec": 6.3,
   "gap_before": 1.5,
   "role": "reply",
   "block": "sleep.dlg18"
  },
  {
   "speaker": "user",
   "text": "And in the morning? I tend to",
   "est_sec": 2.27,
   "gap_before": 0.37,
   "event": "distractor",
   "kind": "pause",
   "block": "sleep.dlg18"
  },
  {
   "speaker": "user",
   "text": "make tea and wander around.",
   "est_sec": 1.65,
   "gap_before": 1.63,
   "event": "ordinary_request",
   "block": "sleep.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Keep the lights low and stay quiet so you don't wake her. Some early risers enjoy that hour for reading.",
   "est_sec": 6.3,
   "gap_before": 0.96,
   "role": "reply",
   "block": "sleep.dlg18"
  },
  {
   "speaker": "user",
   "text": "I do love the quiet, honestly.",
   "est_sec": 1.96,
   "gap_before": 1.88,
   "event": "ordinary_request",
   "block": "sleep.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Then maybe it's not a problem, just a different rhythm.",
   "est_sec": 3.2,
   "gap_before": 1.08,
   "role": "reply",
   "block": "sleep.dlg18"
  }
 ]
