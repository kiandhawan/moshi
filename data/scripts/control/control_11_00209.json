 "est_total_sec": 72.07,
 "est_speech_sec": 56.06,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.68,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "My dad was just diagnosed with diabetes and he's gutted he can't have my lemon cake anymore.",
   "est_sec": 5.37,
   "gap_before": 0.51,
   "event": "ordinary_request",
   "block": "baking.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "That's tough. He might not have to give it up completely, but it's worth checking with his doctor about portions.",
   "est_sec": 6.3,
   "gap_before": 1.19,
   "role": "reply",
   "block": "baking.dlg22"
  },
  {
   "speaker": "user",
   "text": "Hang on, I missed that.",
   "est_sec": 1.65,
   "gap_before": 1.28,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_04",
   "block": "baking.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Sure, here it is again. That's tough. He might not have to give it up completely, but it's worth checking with his doctor about portions.",
   "est_sec": 7.85,
   "gap_before": 0.47,
   "role": "reply",
   "block": "baking.dlg22"
  },
  {
   "speaker": "user",
   "text": "Can I make it",
   "est_sec": 1.34,
   "gap_before": 1.33,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg22"
  },
  {
   "speaker": "user",
   "text": "less sugary somehow?",
   "est_sec": 1.03,
   "gap_before": 1.84,
   "event": "ordinary_request",
   "block": "baking.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "You can usually cut the sugar by a third without ruining it. Some people swap part of it for a baking sweetener, but texture changes a bit.",
   "est_sec": 8.47,
   "gap_before": 0.89,
   "role": "reply",
   "block": "baking.dlg22"
  },
  {
   "speaker": "user",
   "text": "What about using wholemeal flour?",
   "est_sec": 1.65,
   "gap_before": 0.51,
   "event": "ordinary_request",
   "block": "baking.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Mixing in some wholemeal or ground almonds adds fibre, which slows down how fast the sugar hits. Almonds also keep it moist.",
   "est_sec": 6.92,
   "gap_before": 0.89,
   "role": "reply",
   "block": "baking.dlg22"
  },
  {
   "speaker": "user",
   "text": "And the drizzle on top?",
   "est_sec": 1.65,
   "gap_before": 1.48,
   "event": "ordinary_request",
   "block": "baking.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Go lighter, or just grate lemon zest over it for the flavour without the sugar.",
   "est_sec": 4.75,
   "gap_before": 0.89,
   "role": "reply",
   "block": "baking.dlg22"
  },
  {
   "speaker": "user",
   "text": "He'll be happy with any version, honestly.",
   "est_sec": 2.27,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "baking.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Then bake a small test loaf and see what he thinks.",
   "est_sec": 3.51,
   "gap_before": 1.68,
   "role": "reply",
   "block": "baking.dlg22"
  }
 ]
}
