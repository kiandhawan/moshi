 "est_total_sec": 63.42,
 "est_speech_sec": 46.98,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.41,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "Why do first person games make me feel sick? My friends play them for hours.",
   "est_sec": 4.75,
   "gap_before": 0.22,
   "event": "ordinary_request",
   "block": "video_games.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "It's called motion sickness, and it's really common. Your eyes see movement but your body is sitting still, and your brain gets confused.",
   "est_sec": 7.23,
   "gap_before": 0.56,
   "role": "reply",
   "block": "video_games.dlg9"
  },
  {
   "speaker": "user",
   "text": "Is there anything I can do or",
   "est_sec": 2.27,
   "gap_before": 1.27,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg9"
  },
  {
   "speaker": "user",
   "text": "am I just doomed?",
   "est_sec": 1.34,
   "gap_before": 2.84,
   "event": "ordinary_request",
   "block": "video_games.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Not doomed. Try increasing the field of view in the settings, so you see more of the world around you. That helps a lot of people.",
   "est_sec": 8.16,
   "gap_before": 1.05,
   "role": "reply",
   "block": "video_games.dlg9"
  },
  {
   "speaker": "user",
   "text": "There's a setting for that?",
   "est_sec": 1.65,
   "gap_before": 3.33,
   "event": "ordinary_request",
   "block": "video_games.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Usually, yes. Turning off motion blur and camera shake helps too. Some games also let you add a little dot in the centre of the screen.",
   "est_sec": 8.16,
   "gap_before": 1.48,
   "role": "reply",
   "block": "video_games.dlg9"
  },
  {
   "speaker": "user",
   "text": "A dot? That sounds silly.",
   "est_sec": 1.65,
   "gap_before": 2.92,
   "event": "ordinary_request",
   "block": "video_games.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "It sounds silly, but it gives your eyes a fixed point. Also play in a bright room, sit a bit further from the screen, and take breaks before you feel bad.",
   "est_sec": 9.71,
   "gap_before": 0.47,
   "role": "reply",
   "block": "video_games.dlg9"
  }
 ]
}
