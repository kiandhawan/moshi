 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.61,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "The wind is crazy this morning. Do I even bother with an umbrella for the school run?",
   "est_sec": 5.37,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "weather_plans.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Probably not. In strong wind umbrellas just flip inside out or try to take off.",
   "est_sec": 4.75,
   "gap_before": 1.19,
   "role": "reply",
   "block": "weather_plans.dlg22"
  },
  {
   "speaker": "user",
   "text": "My son loves his dinosaur umbrella though.",
   "est_sec": 2.27,
   "gap_before": 1.51,
   "event": "ordinary_request",
   "block": "weather_plans.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Maybe save it for a calm rainy day. Today, a hooded coat for everyone works better.",
   "est_sec": 5.06,
   "gap_before": 0.97,
   "role": "reply",
   "block": "weather_plans.dlg22"
  },
  {
   "speaker": "user",
   "text": "He'll be devastated.",
   "est_sec": 1.03,
   "gap_before": 1.34,
   "event": "distractor",
   "kind": "pause",
   "block": "weather_plans.dlg22"
  },
  {
   "speaker": "user",
   "text": "He takes his umbrella very seriously.",
   "est_sec": 1.96,
   "gap_before": 2.47,
   "event": "ordinary_request",
   "block": "weather_plans.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Let him bring it closed, he can hold it like a sword. He still gets to have it.",
   "est_sec": 5.68,
   "gap_before": 0.7,
   "role": "reply",
   "block": "weather_plans.dlg22"
  },
  {
   "speaker": "user",
   "text": "That might actually work.",
   "est_sec": 1.34,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "weather_plans.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Kids love a compromise that sounds like an adventure. Stay away from trees and building sites on the way too.",
   "est_sec": 6.3,
   "gap_before": 0.55,
   "role": "reply",
   "block": "weather_plans.dlg22"
  }
 ]
}
