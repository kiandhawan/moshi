 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.92,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "My microwave is crusty inside. Like, years of soup explosions.",
   "est_sec": 3.2,
   "gap_before": 0.39,
   "event": "ordinary_request",
   "block": "cleaning.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Easy fix. Put a bowl of water with a sliced lemon in it, and run it for a few minutes until it steams up.",
   "est_sec": 7.54,
   "gap_before": 1.04,
   "role": "reply",
   "block": "cleaning.dlg6"
  },
  {
   "speaker": "user",
   "text": "And then?",
   "est_sec": 0.72,
   "gap_before": 1.19,
   "event": "ordinary_request",
   "block": "cleaning.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Leave the door closed for five more minutes, then wipe. The steam loosens everything.",
   "est_sec": 4.44,
   "gap_before": 0.46,
   "role": "reply",
   "block": "cleaning.dlg6"
  },
  {
   "speaker": "user",
   "text": "Wow, it just wiped off. Even the ceiling bit.",
   "est_sec": 2.89,
   "gap_before": 0.32,
   "event": "ordinary_request",
   "block": "cleaning.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Steam does the work. Take the turntable out and wash it in the sink while you're at it.",
   "est_sec": 5.68,
   "gap_before": 0.69,
   "role": "reply",
   "block": "cleaning.dlg6"
  },
  {
   "speaker": "user",
   "text": "My flatmate's going to think I hired someone",
   "est_sec": 2.58,
   "gap_before": 1.62,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg6"
  },
  {
   "speaker": "user",
   "text": "honestly.",
   "est_sec": 0.41,
   "gap_before": 1.83,
   "event": "ordinary_request",
   "block": "cleaning.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Let them think that. Maybe suggest covering bowls next time.",
   "est_sec": 3.2,
   "gap_before": 0.44,
   "role": "reply",
   "block": "cleaning.dlg6"
  }
 ]
}
