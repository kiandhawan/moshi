 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.41,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "Should I pay off my student loan early?",
   "est_sec": 2.58,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "personal_finance.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "It depends on the interest rate and the type of loan. What's the rate like?",
   "est_sec": 4.75,
   "gap_before": 1.71,
   "role": "reply",
   "block": "personal_finance.dlg8"
  },
  {
   "speaker": "user",
   "text": "Pretty low, I think. Like three percent.",
   "est_sec": 2.27,
   "gap_before": 0.94,
   "event": "ordinary_request",
   "block": "personal_finance.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "At three percent, many people put extra money elsewhere first, like a high interest savings account or retirement saving.",
   "est_sec": 5.99,
   "gap_before": 0.37,
   "role": "reply",
   "block": "personal_finance.dlg8"
  },
  {
   "speaker": "user",
   "text": "But I hate having debt.",
   "est_sec": 1.65,
   "gap_before": 0.85,
   "event": "ordinary_request",
   "block": "personal_finance.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "That's a valid feeling. Peace of mind matters too. You could split it, a bit extra on the loan and the rest into savings.",
   "est_sec": 7.54,
   "gap_before": 0.36,
   "role": "reply",
   "block": "personal_finance.dlg8"
  },
  {
   "speaker": "user",
   "text": "Is there a catch with paying early?",
   "est_sec": 2.27,
   "gap_before": 1.06,
   "event": "ordinary_request",
   "block": "personal_finance.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Usually not for student loans, but check for early repayment fees. And in some countries, they get written off after a while, which changes the maths.",
   "est_sec": 8.16,
   "gap_before": 0.41,
   "role": "reply",
   "block": "personal_finance.dlg8"
  }
 ]
}
