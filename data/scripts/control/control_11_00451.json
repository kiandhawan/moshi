 "est_total_sec": 52.85,
 "est_speech_sec": 40.78,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.55,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.91,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "I'm decorating biscuits with royal icing for a baby shower and my lines keep running into each other.",
   "est_sec": 5.68,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "baking.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Sounds like the icing is too thin for outlining. You want two consistencies, a thick one for borders and a runnier one for filling.",
   "est_sec": 7.54,
   "gap_before": 1.19,
   "role": "reply",
   "block": "baking.dlg20"
  },
  {
   "speaker": "user",
   "text": "How thick is thick?",
   "est_sec": 1.34,
   "gap_before": 0.88,
   "event": "ordinary_request",
   "block": "baking.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Like toothpaste. It should hold a sharp line. For flooding, add water a few drops at a time until a ribbon of it disappears in about ten seconds.",
   "est_sec": 8.78,
   "gap_before": 0.55,
   "role": "reply",
   "block": "baking.dlg20"
  },
  {
   "speaker": "user",
   "text": "Ten seconds. Okay. And between",
   "est_sec": 1.65,
   "gap_before": 1.28,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg20"
  },
  {
   "speaker": "user",
   "text": "outline and flooding, do I wait?",
   "est_sec": 1.96,
   "gap_before": 2.44,
   "event": "ordinary_request",
   "block": "baking.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Give the outline ten minutes or so to firm up. Then flood inside it.",
   "est_sec": 4.44,
   "gap_before": 0.85,
   "role": "reply",
   "block": "baking.dlg20"
  },
  {
   "speaker": "user",
   "text": "This is very soothing actually.",
   "est_sec": 1.65,
   "gap_before": 0.62,
   "event": "ordinary_request",
   "block": "baking.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "It is, once it clicks. Let them dry overnight before stacking, or the colours smudge.",
   "est_sec": 4.75,
   "gap_before": 0.73,
   "role": "reply",
   "block": "baking.dlg20"
  }
 ]
}
