 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.72,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.84,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "Can you recommend a good board game for just two players?",
   "est_sec": 3.51,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Jaipur is a great one. It's a quick trading game, about twenty minutes, and easy to learn.",
   "est_sec": 5.37,
   "gap_before": 0.58,
   "role": "reply",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "user",
   "text": "We like something",
   "est_sec": 1.03,
   "gap_before": 2.71,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "user",
   "text": "a bit more strategic, actually.",
   "est_sec": 1.65,
   "gap_before": 1.59,
   "event": "ordinary_request",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Then try Seven Wonders Duel. It's still under an hour, but there's lots to plan.",
   "est_sec": 4.75,
   "gap_before": 0.66,
   "role": "reply",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "user",
   "text": "Is that one hard to learn?",
   "est_sec": 1.96,
   "gap_before": 1.3,
   "event": "ordinary_request",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "The first game takes a bit of rule checking, but after that it flows nicely. Most couples play it again right away.",
   "est_sec": 6.92,
   "gap_before": 0.63,
   "role": "reply",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "user",
   "text": "Sounds perfect. We'll get that one.",
   "est_sec": 1.96,
   "gap_before": 1.29,
   "event": "ordinary_request",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Enjoy! Fair warning, it gets pretty competitive.",
   "est_sec": 2.27,
   "gap_before": 0.52,
   "role": "reply",
   "block": "board_games.dlg1"
  }
 ]
