 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.67,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.89,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "How do I write a good introduction to an essay? Mine always sound so boring.",
   "est_sec": 4.75,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "studying.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "A good intro usually does three things. Hooks the reader, gives a bit of context, and states your main argument.",
   "est_sec": 6.3,
   "gap_before": 1.21,
   "role": "reply",
   "block": "studying.dlg17"
  },
  {
   "speaker": "user",
   "text": "What counts as a hook?",
   "est_sec": 1.65,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "studying.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "A surprising fact, a short story, or a strong question. Something that makes the reader want to keep going.",
   "est_sec": 5.99,
   "gap_before": 0.63,
   "role": "reply",
   "block": "studying.dlg17"
  },
  {
   "speaker": "user",
   "text": "My teacher says no rhetorical questions.",
   "est_sec": 1.96,
   "gap_before": 1.31,
   "event": "ordinary_request",
   "block": "studying.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Then try a fact or a short scene. For example, for an essay on cities, start with a busy street at rush hour.",
   "est_sec": 7.23,
   "gap_before": 0.57,
   "role": "reply",
   "block": "studying.dlg17"
  },
  {
   "speaker": "user",
   "text": "And the argument bit,",
   "est_sec": 1.34,
   "gap_before": 0.46,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg17"
  },
  {
   "speaker": "user",
   "text": "how long should that be?",
   "est_sec": 1.65,
   "gap_before": 2.15,
   "event": "ordinary_request",
   "block": "studying.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "One or two clear sentences. The reader should know exactly what you're going to argue.",
   "est_sec": 4.75,
   "gap_before": 0.46,
   "role": "reply",
   "block": "studying.dlg17"
  }
 ]
}
