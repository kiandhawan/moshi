 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.92,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "I travel for work every week. How do I keep fit in hotel rooms?",
   "est_sec": 4.44,
   "gap_before": 0.21,
   "event": "ordinary_request",
   "block": "fitness.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Bodyweight circuits are perfect. Squats, push-ups, lunges, planks and burpees need no equipment at all.",
   "est_sec": 4.75,
   "gap_before": 1.82,
   "role": "reply",
   "block": "fitness.dlg16"
  },
  {
   "speaker": "user",
   "text": "Burpees. I hate burpees.",
   "est_sec": 1.34,
   "gap_before": 0.99,
   "event": "ordinary_request",
   "block": "fitness.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Everybody does. You can swap them for fast mountain climbers.",
   "est_sec": 3.2,
   "gap_before": 1.16,
   "role": "reply",
   "block": "fitness.dlg16"
  },
  {
   "speaker": "user",
   "text": "How long should a circuit take?",
   "est_sec": 1.96,
   "gap_before": 0.95,
   "event": "ordinary_request",
   "block": "fitness.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Twenty minutes is plenty. Do each exercise for forty seconds with twenty seconds rest, and repeat the round four times.",
   "est_sec": 6.3,
   "gap_before": 0.7,
   "role": "reply",
   "block": "fitness.dlg16"
  },
  {
   "speaker": "user",
   "text": "That's quiet enough",
   "est_sec": 1.03,
   "gap_before": 0.31,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg16"
  },
  {
   "speaker": "user",
   "text": "for a thin wall hotel?",
   "est_sec": 1.65,
   "gap_before": 2.83,
   "event": "ordinary_request",
   "block": "fitness.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Mostly, yes. Skip jumping moves late at night if you're worried about the neighbors.",
   "est_sec": 4.44,
   "gap_before": 0.84,
   "role": "reply",
   "block": "fitness.dlg16"
  },
  {
   "speaker": "user",
   "text": "Smart. Resistance bands too?",
   "est_sec": 1.34,
   "gap_before": 1.07,
   "event": "ordinary_request",
   "block": "fitness.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Yes, they weigh nothing and add a lot. Throw a pair in your suitcase.",
   "est_sec": 4.44,
   "gap_before": 0.72,
   "role": "reply",
   "block": "fitness.dlg16"
  }
 ]
}
