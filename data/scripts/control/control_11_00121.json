 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.31,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I'm sixteen and my friends think hiking is boring. How do I get them to come?",
   "est_sec": 5.06,
   "gap_before": 0.34,
   "event": "ordinary_request",
   "block": "hiking.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Pick a route with a payoff they'll care about, like a swimming spot, a rope swing, or a crazy view for photos.",
   "est_sec": 6.92,
   "gap_before": 0.96,
   "role": "reply",
   "block": "hiking.dlg7"
  },
  {
   "speaker": "user",
   "text": "There's a lake with a jetty you can jump off.",
   "est_sec": 3.2,
   "gap_before": 3.36,
   "event": "ordinary_request",
   "block": "hiking.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Perfect. Sell it as a lake day that happens to need a walk to get there.",
   "est_sec": 5.06,
   "gap_before": 0.47,
   "role": "reply",
   "block": "hiking.dlg7"
  },
  {
   "speaker": "user",
   "text": "Ha, sneaky. How long should it be?",
   "est_sec": 2.27,
   "gap_before": 1.35,
   "event": "ordinary_request",
   "block": "hiking.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Keep it short the first time, maybe an hour each way. If they enjoy it, they'll be up for longer ones.",
   "est_sec": 6.61,
   "gap_before": 1.73,
   "role": "reply",
   "block": "hiking.dlg7"
  },
  {
   "speaker": "user",
   "text": "And food?",
   "est_sec": 0.72,
   "gap_before": 1.6,
   "event": "ordinary_request",
   "block": "hiking.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Bring something good to share at the lake. Nobody complains about a hike that ends with crisps and a jump into cold water.",
   "est_sec": 7.23,
   "gap_before": 0.52,
   "role": "reply",
   "block": "hiking.dlg7"
  }
 ]
}
