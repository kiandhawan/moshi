 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.91,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "My daughter is fourteen and starting pre-season for football. How can she get fitter without overdoing it?",
   "est_sec": 5.37,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "fitness.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Good that you're thinking about it. A mix of running, some short sprints and basic strength work is ideal.",
   "est_sec": 5.99,
   "gap_before": 0.82,
   "role": "reply",
   "block": "fitness.dlg29"
  },
  {
   "speaker": "user",
   "text": "Strength work at fourteen?",
   "est_sec": 1.34,
   "gap_before": 0.92,
   "event": "ordinary_request",
   "block": "fitness.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Bodyweight exercises like squats, lunges and planks are safe and help prevent injuries.",
   "est_sec": 4.13,
   "gap_before": 0.45,
   "role": "reply",
   "block": "fitness.dlg29"
  },
  {
   "speaker": "user",
   "text": "Hang on, I missed that.",
   "est_sec": 1.65,
   "gap_before": 1.47,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_04",
   "block": "fitness.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "No problem. Bodyweight exercises like squats, lunges and planks are safe and help prevent injuries.",
   "est_sec": 4.75,
   "gap_before": 1.03,
   "role": "reply",
   "block": "fitness.dlg29"
  },
  {
   "speaker": "user",
   "text": "How many days a week?",
   "est_sec": 1.65,
   "gap_before": 1.48,
   "event": "ordinary_request",
   "block": "fitness.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Three or four sessions, with rest days in between. Keep the sprints short and the jogging easy.",
   "est_sec": 5.37,
   "gap_before": 0.93,
   "role": "reply",
   "block": "fitness.dlg29"
  },
  {
   "speaker": "user",
   "text": "She tends to",
   "est_sec": 1.03,
   "gap_before": 1.27,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg29"
  },
  {
   "speaker": "user",
   "text": "go all out every time.",
   "est_sec": 1.65,
   "gap_before": 1.72,
   "event": "ordinary_request",
   "block": "fitness.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Then remind her that rest is part of training. Sleep and good food matter just as much at her age.",
   "est_sec": 6.3,
   "gap_before": 0.88,
   "role": "reply",
   "block": "fitness.dlg29"
  },
  {
   "speaker": "user",
   "text": "She'll roll her eyes at me.",
   "est_sec": 1.96,
   "gap_before": 3.48,
   "event": "ordinary_request",
   "block": "fitness.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Maybe let her coach say it then. It often lands better.",
   "est_sec": 3.51,
   "gap_before": 0.7,
   "role": "reply",
   "block": "fitness.dlg29"
  }
 ]
