 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.79,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "I'm ordering a coat from a European shop and the sizes are all different numbers. I'm a medium normally.",
   "est_sec": 5.99,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "shopping.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Sizes vary a lot between countries and brands, so the safest thing is the measurement chart, not the label.",
   "est_sec": 5.99,
   "gap_before": 0.55,
   "role": "reply",
   "block": "shopping.dlg19"
  },
  {
   "speaker": "user",
   "text": "What do I measure?",
   "est_sec": 1.34,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "shopping.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "For a coat, your chest around the widest part, and maybe your arm from shoulder to wrist. Do it over a thin jumper.",
   "est_sec": 7.23,
   "gap_before": 1.16,
   "role": "reply",
   "block": "shopping.dlg19"
  },
  {
   "speaker": "user",
   "text": "And if I'm between two sizes?",
   "est_sec": 1.96,
   "gap_before": 0.68,
   "event": "ordinary_request",
   "block": "shopping.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "For a coat, go up. You'll want room for layers underneath.",
   "est_sec": 3.51,
   "gap_before": 1.06,
   "role": "reply",
   "block": "shopping.dlg19"
  },
  {
   "speaker": "user",
   "text": "Okay. They also have free returns, which is nice.",
   "est_sec": 2.89,
   "gap_before": 1.98,
   "event": "ordinary_request",
   "block": "shopping.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Great, then order and try it on at home with your thickest jumper. Keep the tags on until you're sure.",
   "est_sec": 6.3,
   "gap_before": 0.98,
   "role": "reply",
   "block": "shopping.dlg19"
  }
 ]
}
