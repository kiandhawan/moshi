 "est_total_sec": 43.43,
 "est_speech_sec": 33.55,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.8,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.55,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "My scones are always flat and tough. Like hockey pucks.",
   "est_sec": 3.2,
   "gap_before": 0.34,
   "event": "ordinary_request",
   "block": "baking.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "Two likely reasons. Butter that's too warm, and handling the dough too much.",
   "est_sec": 4.13,
   "gap_before": 0.6,
   "role": "reply",
   "block": "baking.dlg24"
  },
  {
   "speaker": "user",
   "text": "I knead it until it's smooth.",
   "est_sec": 1.96,
   "gap_before": 1.21,
   "event": "ordinary_request",
   "block": "baking.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "Skip that. Scone dough should look a bit shaggy and messy. Pat it together gently, don't knead it.",
   "est_sec": 5.68,
   "gap_before": 0.39,
   "role": "reply",
   "block": "baking.dlg24"
  },
  {
   "speaker": "user",
   "text": "What about the butter, though?",
   "est_sec": 1.65,
   "gap_before": 2.22,
   "event": "ordinary_request",
   "block": "baking.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "Straight from the fridge, or even grated from frozen. Those cold lumps melt in the oven and puff the scones up.",
   "est_sec": 6.61,
   "gap_before": 1.18,
   "role": "reply",
   "block": "baking.dlg24"
  },
  {
   "speaker": "user",
   "text": "Grated frozen butter. That's clever.",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "event": "ordinary_request",
   "block": "baking.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "Also cut them straight down without twisting the cutter. Twisting seals the edges and stops them rising.",
   "est_sec": 5.37,
   "gap_before": 0.41,
   "role": "reply",
   "block": "baking.dlg24"
  }
 ]
}
