 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.35,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.81,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "There's a severe wind warning tonight. What should I do with the garden stuff?",
   "est_sec": 4.44,
   "gap_before": 0.2,
   "event": "ordinary_request",
   "block": "weather_plans.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Bring in anything light, like cushions, plant pots, toys and the bins if you can.",
   "est_sec": 4.75,
   "gap_before": 0.37,
   "role": "reply",
   "block": "weather_plans.dlg15"
  },
  {
   "speaker": "user",
   "text": "We have a massive trampoline.",
   "est_sec": 1.65,
   "gap_before": 2.05,
   "event": "ordinary_request",
   "block": "weather_plans.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Trampolines are notorious for flying. Either weigh it down with anchor kits or flip it upside down.",
   "est_sec": 5.37,
   "gap_before": 0.4,
   "role": "reply",
   "block": "weather_plans.dlg15"
  },
  {
   "speaker": "user",
   "text": "Upside down? Seriously?",
   "est_sec": 1.03,
   "gap_before": 0.75,
   "event": "ordinary_request",
   "block": "weather_plans.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Yes, it catches much less wind that way. Some people also take the net off.",
   "est_sec": 4.75,
   "gap_before": 0.61,
   "role": "reply",
   "block": "weather_plans.dlg15"
  },
  {
   "speaker": "user",
   "text": "And the shed door keeps blowing open.",
   "est_sec": 2.27,
   "gap_before": 2.04,
   "event": "ordinary_request",
   "block": "weather_plans.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Tie it or wedge it shut. Park the car away from trees if possible, and check on any elderly neighbours too.",
   "est_sec": 6.61,
   "gap_before": 0.35,
   "role": "reply",
   "block": "weather_plans.dlg15"
  }
 ]
}
