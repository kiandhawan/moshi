 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.71,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.36,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "Do you know any good books set in space that aren't too technical?",
   "est_sec": 4.13,
   "gap_before": 0.6,
   "event": "ordinary_request",
   "block": "books.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Plenty. Do you want adventure, or something quieter and more about the people on the ship?",
   "est_sec": 5.06,
   "gap_before": 0.84,
   "role": "reply",
   "block": "books.dlg27"
  },
  {
   "speaker": "user",
   "text": "The people. I don't care how the engines work.",
   "est_sec": 2.89,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "books.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Then look for character driven science fiction, like stories about a small crew on a long journey. They feel like found family dramas.",
   "est_sec": 7.23,
   "gap_before": 0.99,
   "role": "reply",
   "block": "books.dlg27"
  },
  {
   "speaker": "user",
   "text": "Wait, found family, I love that.",
   "est_sec": 1.96,
   "gap_before": 1.21,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_13",
   "block": "books.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Then you'll be happy. There's a whole wave of cozy space novels where the biggest problem is getting along with your crewmates.",
   "est_sec": 6.92,
   "gap_before": 0.47,
   "role": "reply",
   "block": "books.dlg27"
  },
  {
   "speaker": "user",
   "text": "Is there romance in them?",
   "est_sec": 1.65,
   "gap_before": 1.32,
   "event": "ordinary_request",
   "block": "books.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Often a little, but it's usually gentle and part of the bigger story. Nothing that takes over.",
   "est_sec": 5.37,
   "gap_before": 1.59,
   "role": "reply",
   "block": "books.dlg27"
  }
 ]
}
