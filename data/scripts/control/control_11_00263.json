 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "What's the best way to get coffee stains out of a white mug?",
   "est_sec": 4.13,
   "gap_before": 0.24,
   "event": "ordinary_request",
   "block": "cleaning.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Make a paste with baking soda and a little water and scrub it in with a sponge. Most stains lift in a minute or two.",
   "est_sec": 7.85,
   "gap_before": 1.01,
   "role": "reply",
   "block": "cleaning.dlg1"
  },
  {
   "speaker": "user",
   "text": "And if that doesn't work?",
   "est_sec": 1.65,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "cleaning.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Soak the mug overnight in hot water with a spoonful of dishwasher powder. That usually gets even old stains.",
   "est_sec": 5.99,
   "gap_before": 0.6,
   "role": "reply",
   "block": "cleaning.dlg1"
  },
  {
   "speaker": "user",
   "text": "Nice. Does the same",
   "est_sec": 1.34,
   "gap_before": 1.32,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg1"
  },
  {
   "speaker": "user",
   "text": "trick work for the teapot?",
   "est_sec": 1.65,
   "gap_before": 2.9,
   "event": "ordinary_request",
   "block": "cleaning.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Yes, the soak works well for teapots too. Just rinse it really well afterwards so the next pot doesn't taste soapy.",
   "est_sec": 6.61,
   "gap_before": 0.78,
   "role": "reply",
   "block": "cleaning.dlg1"
  },
  {
   "speaker": "user",
   "text": "Good point. Thanks!",
   "est_sec": 1.03,
   "gap_before": 0.65,
   "block": "cleaning.dlg1"
  }
