 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.58,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 1.0,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "Dog ate one of the dice. Game's tonight.",
   "est_sec": 2.58,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "board_games.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Oh dear, hope the dog's alright. For tonight, a phone dice app works fine, or borrow a die from another game.",
   "est_sec": 6.61,
   "gap_before": 0.88,
   "role": "reply",
   "block": "board_games.dlg26"
  },
  {
   "speaker": "user",
   "text": "Every other game in the house uses weird dice.",
   "est_sec": 2.89,
   "gap_before": 0.68,
   "event": "ordinary_request",
   "block": "board_games.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Most phones can roll dice if you just ask the assistant or search roll a die. Or number six bits of paper and draw one from a cup.",
   "est_sec": 8.78,
   "gap_before": 0.64,
   "role": "reply",
   "block": "board_games.dlg26"
  },
  {
   "speaker": "user",
   "text": "Paper in a cup. Very classy.",
   "est_sec": 1.96,
   "gap_before": 0.92,
   "event": "ordinary_request",
   "block": "board_games.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "It works though. Tomorrow you can buy a cheap pack of dice from a toy shop, they're handy to keep as spares anyway.",
   "est_sec": 7.23,
   "gap_before": 0.97,
   "role": "reply",
   "block": "board_games.dlg26"
  },
  {
   "speaker": "user",
   "text": "And keep them",
   "est_sec": 1.03,
   "gap_before": 1.24,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg26"
  },
  {
