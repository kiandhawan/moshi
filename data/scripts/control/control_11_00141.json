 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.79,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.68,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "My elderly mum got a call saying she'd won a lottery but needed to pay a fee first.",
   "est_sec": 5.68,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "personal_finance.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "That's a classic scam. Real prizes never ask you to pay to receive them.",
   "est_sec": 4.44,
   "gap_before": 0.88,
   "role": "reply",
   "block": "personal_finance.dlg25"
  },
  {
   "speaker": "user",
   "text": "She already gave them her card number.",
   "est_sec": 2.27,
   "gap_before": 0.8,
   "event": "ordinary_request",
   "block": "personal_finance.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Then call her bank right away and ask them to block the card. Explain that it was a scam.",
   "est_sec": 5.99,
   "gap_before": 1.16,
   "role": "reply",
   "block": "personal_finance.dlg25"
  },
  {
   "speaker": "user",
   "text": "Will she get the money back?",
   "est_sec": 1.96,
   "gap_before": 1.33,
   "event": "ordinary_request",
   "block": "personal_finance.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Banks can often refund fraud, especially if you report it quickly. Ask about it on the call.",
   "est_sec": 5.37,
   "gap_before": 0.67,
   "role": "reply",
   "block": "personal_finance.dlg25"
  },
  {
   "speaker": "user",
   "text": "She's so embarrassed. She",
   "est_sec": 1.34,
   "gap_before": 0.8,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg25"
  },
  {
   "speaker": "user",
   "text": "didn't want to tell me.",
   "est_sec": 1.65,
   "gap_before": 1.51,
   "event": "ordinary_request",
   "block": "personal_finance.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Reassure her. These scams are very convincing, and they target lovely, trusting people. She did the right thing by telling you.",
   "est_sec": 6.61,
   "gap_before": 0.76,
   "role": "reply",
   "block": "personal_finance.dlg25"
  }
 ]
}
