 "est_total_sec": 59.75,
 "est_speech_sec": 46.56,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.85,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "Winter is coming and my commute always falls apart when it snows.",
   "est_sec": 3.82,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "public_transport.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "It's a common story. Checking live updates before you leave is the easiest habit to start.",
   "est_sec": 5.06,
   "gap_before": 0.56,
   "role": "reply",
   "block": "public_transport.dlg19"
  },
  {
   "speaker": "user",
   "text": "I usually just go to the stop and hope.",
   "est_sec": 2.89,
   "gap_before": 1.08,
   "event": "ordinary_request",
   "block": "public_transport.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Try setting up alerts in your transit app for your route. You'll know about cancellations before you're standing in the cold.",
   "est_sec": 6.61,
   "gap_before": 0.83,
   "role": "reply",
   "block": "public_transport.dlg19"
  },
  {
   "speaker": "user",
   "text": "And when it's",
   "est_sec": 1.03,
   "gap_before": 0.91,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg19"
  },
  {
   "speaker": "user",
   "text": "properly snowing, what then?",
   "est_sec": 1.34,
   "gap_before": 2.5,
   "event": "ordinary_request",
   "block": "public_transport.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Have a backup plan ready, maybe a different line or working from home. Decide it the night before so the morning isn't chaos.",
   "est_sec": 7.23,
   "gap_before": 0.53,
   "role": "reply",
   "block": "public_transport.dlg19"
  },
  {
   "speaker": "user",
   "text": "Wait a second, that doesn't sound right.",
   "est_sec": 2.27,
   "gap_before": 1.01,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_10",
   "block": "public_transport.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "I'm fairly sure about it, but I could be wrong. What sounds off to you?",
   "est_sec": 4.75,
   "gap_before": 0.89,
   "role": "reply",
   "block": "public_transport.dlg19"
  },
  {
   "speaker": "user",
   "text": "Good point. Anything for the actual waiting?",
   "est_sec": 2.27,
   "gap_before": 1.08,
   "event": "ordinary_request",
   "block": "public_transport.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Layers, warm socks, and gloves you can use your phone in. A flask of tea doesn't hurt either.",
   "est_sec": 5.68,
   "gap_before": 0.54,
   "role": "reply",
   "block": "public_transport.dlg19"
  }
 ]
}
