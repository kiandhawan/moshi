 "est_total_sec": 51.67,
 "est_speech_sec": 40.16,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.7,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.71,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "I want to start composting but I live in a flat. Is that even possible?",
   "est_sec": 4.75,
   "gap_before": 0.22,
   "event": "ordinary_request",
   "block": "gardening.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "It is. A small worm bin or a bokashi bucket can live under your sink and won't smell if you look after it.",
   "est_sec": 7.23,
   "gap_before": 0.44,
   "role": "reply",
   "block": "gardening.dlg3"
  },
  {
   "speaker": "user",
   "text": "Worms in my kitchen? My partner would",
   "est_sec": 2.27,
   "gap_before": 2.78,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg3"
  },
  {
   "speaker": "user",
   "text": "probably move out.",
   "est_sec": 1.03,
   "gap_before": 2.03,
   "event": "ordinary_request",
   "block": "gardening.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Then bokashi might be easier. It's a sealed bucket where you add scraps and a sprinkle of bran, no worms involved.",
   "est_sec": 6.61,
   "gap_before": 1.02,
   "role": "reply",
   "block": "gardening.dlg3"
  },
  {
   "speaker": "user",
   "text": "What do I do with it when it's full?",
   "est_sec": 2.89,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "gardening.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Bury it in soil, a large planter or a community garden bed. After a few weeks it turns into rich compost.",
   "est_sec": 6.61,
   "gap_before": 1.06,
   "role": "reply",
   "block": "gardening.dlg3"
  },
  {
   "speaker": "user",
   "text": "There's a community garden two streets over actually.",
   "est_sec": 2.58,
   "gap_before": 0.3,
   "event": "ordinary_request",
   "block": "gardening.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Perfect, ask them. Most community gardens are happy to take it.",
   "est_sec": 3.51,
   "gap_before": 0.42,
   "role": "reply",
   "block": "gardening.dlg3"
  }
 ]
}
