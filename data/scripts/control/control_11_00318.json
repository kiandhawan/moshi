 "est_total_sec": 55.28,
 "est_speech_sec": 42.53,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.58,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.63,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "Morning or evening, when's the best time to water the garden?",
   "est_sec": 3.51,
   "gap_before": 0.3,
   "event": "ordinary_request",
   "block": "gardening.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Early morning is usually best. The plants get a drink before the heat and the leaves dry off quickly.",
   "est_sec": 5.99,
   "gap_before": 0.4,
   "role": "reply",
   "block": "gardening.dlg21"
  },
  {
   "speaker": "user",
   "text": "I'm not a morning person.",
   "est_sec": 1.65,
   "gap_before": 0.91,
   "event": "ordinary_request",
   "block": "gardening.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Evening is fine too, just water the soil rather than the leaves. Wet leaves overnight can invite mildew and slugs.",
   "est_sec": 6.3,
   "gap_before": 1.16,
   "role": "reply",
   "block": "gardening.dlg21"
  },
  {
   "speaker": "user",
   "text": "Slugs! Those things have eaten",
   "est_sec": 1.65,
   "gap_before": 1.33,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg21"
  },
  {
   "speaker": "user",
   "text": "half my lettuces this year.",
   "est_sec": 1.65,
   "gap_before": 2.49,
   "event": "ordinary_request",
   "block": "gardening.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Then morning watering really would help. Slugs love a damp evening.",
   "est_sec": 3.51,
   "gap_before": 0.37,
   "role": "reply",
   "block": "gardening.dlg21"
  },
  {
   "speaker": "user",
   "text": "Ugh, fine. How long should I water for?",
   "est_sec": 2.58,
   "gap_before": 1.42,
   "event": "ordinary_request",
   "block": "gardening.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Less often but deeper is better. A good soak twice a week beats a light sprinkle every day.",
   "est_sec": 5.68,
   "gap_before": 0.37,
   "role": "reply",
   "block": "gardening.dlg21"
  },
  {
   "speaker": "user",
   "text": "Okay. Setting an alarm, apparently.",
   "est_sec": 1.65,
   "gap_before": 0.89,
   "event": "ordinary_request",
   "block": "gardening.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Even ten minutes with a hose before work is enough for most beds.",
   "est_sec": 4.13,
   "gap_before": 0.4,
   "role": "reply",
   "block": "gardening.dlg21"
  }
 ]
}
