 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.76,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.95,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "I want to put up wallpaper for the first time. Any advice before I ruin a wall?",
   "est_sec": 5.37,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "home_repair.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "A few big ones. Start next to a window or door, and draw a straight line with a level, because walls are rarely straight.",
   "est_sec": 7.54,
   "gap_before": 0.91,
   "role": "reply",
   "block": "home_repair.dlg10"
  },
  {
   "speaker": "user",
   "text": "Paste the paper or paste the wall?",
   "est_sec": 2.27,
   "gap_before": 1.83,
   "event": "ordinary_request",
   "block": "home_repair.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "It depends on the wallpaper. Check the label. Many modern ones are paste the wall, which is easier.",
   "est_sec": 5.68,
   "gap_before": 0.92,
   "role": "reply",
   "block": "home_repair.dlg10"
  },
  {
   "speaker": "user",
   "text": "And bubbles? I'm terrified of bubbles.",
   "est_sec": 1.96,
   "gap_before": 0.61,
   "event": "ordinary_request",
   "block": "home_repair.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Smooth from the middle out with a brush or a plastic smoother. Small bubbles often disappear as it dries.",
   "est_sec": 5.99,
   "gap_before": 0.96,
   "role": "reply",
   "block": "home_repair.dlg10"
  },
  {
   "speaker": "user",
   "text": "I picked a pattern with",
   "est_sec": 1.65,
   "gap_before": 0.33,
   "event": "distractor",
   "kind": "pause",
   "block": "home_repair.dlg10"
  },
  {
   "speaker": "user",
   "text": "big leaves, is that harder?",
   "est_sec": 1.65,
   "gap_before": 2.56,
   "event": "ordinary_request",
   "block": "home_repair.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Patterns need matching at the joins, so you'll waste a bit more paper. Buy an extra roll to be safe.",
   "est_sec": 6.3,
   "gap_before": 1.03,
   "role": "reply",
   "block": "home_repair.dlg10"
  }
 ]
}
