 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.75,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.84,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "Okay, confession. I said on my CV that I'm advanced in spreadsheets and I'm really not.",
   "est_sec": 5.06,
   "gap_before": 0.39,
   "event": "ordinary_request",
   "block": "job_interview.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Okay, honest question. How long until the interview?",
   "est_sec": 2.58,
   "gap_before": 0.5,
   "role": "reply",
   "block": "job_interview.dlg23"
  },
  {
   "speaker": "user",
   "text": "Two weeks.",
   "est_sec": 0.72,
   "gap_before": 1.28,
   "event": "ordinary_request",
   "block": "job_interview.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Then you have two options. Learn enough to be genuinely solid in that time, or be honest in the interview and say intermediate.",
   "est_sec": 7.23,
   "gap_before": 1.13,
   "role": "reply",
   "block": "job_interview.dlg23"
  },
  {
   "speaker": "user",
   "text": "Hold on, can I actually learn that much in two weeks?",
   "est_sec": 3.51,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_14",
   "block": "job_interview.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "You can get far. Focus on formulas, sorting and filtering, and basic charts. There are free tutorials for all of that.",
   "est_sec": 6.61,
   "gap_before": 0.7,
   "role": "reply",
   "block": "job_interview.dlg23"
  },
  {
   "speaker": "user",
   "text": "And if they test me",
   "est_sec": 1.65,
   "gap_before": 1.86,
   "event": "distractor",
   "kind": "pause",
   "block": "job_interview.dlg23"
  },
  {
   "speaker": "user",
   "text": "on something I don't know?",
   "est_sec": 1.65,
   "gap_before": 2.86,
   "event": "ordinary_request",
   "block": "job_interview.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Then admit it and explain how you'd find out. Pretending usually falls apart, but honesty plus curiosity tends to land well.",
   "est_sec": 6.61,
   "gap_before": 0.83,
   "role": "reply",
   "block": "job_interview.dlg23"
  }
 ]
