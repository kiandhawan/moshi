 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.82,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "I'm doing a hike in October and it'll be chilly in the morning but warm by lunch. What do I wear?",
   "est_sec": 6.61,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "hiking.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Layers are your friend. A thin base layer that wicks sweat, a fleece or light jumper on top, and a windproof or waterproof jacket in your bag.",
   "est_sec": 8.47,
   "gap_before": 1.61,
   "role": "reply",
   "block": "hiking.dlg10"
  },
  {
   "speaker": "user",
   "text": "No cotton t-shirt?",
   "est_sec": 1.03,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "block": "hiking.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Best avoided. Cotton holds sweat and gets cold when you stop for a break.",
   "est_sec": 4.44,
   "gap_before": 1.07,
   "role": "reply",
   "block": "hiking.dlg10"
  },
  {
   "speaker": "user",
   "text": "I hate stopping to change, though. It's so",
   "est_sec": 2.58,
   "gap_before": 1.23,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg10"
  },
  {
   "speaker": "user",
   "text": "faffy.",
   "est_sec": 0.41,
   "gap_before": 2.01,
   "event": "ordinary_request",
   "block": "hiking.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Try to take a layer off just before you start getting hot, rather than after you're sweating. It saves you being cold at the top.",
   "est_sec": 7.85,
   "gap_before": 0.45,
   "role": "reply",
   "block": "hiking.dlg10"
  },
  {
   "speaker": "user",
   "text": "And a hat?",
   "est_sec": 1.03,
   "gap_before": 2.95,
   "event": "ordinary_request",
   "block": "hiking.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "A light beanie and thin gloves are worth the space. Cold hands at the summit ruin a good sandwich.",
   "est_sec": 5.99,
   "gap_before": 1.14,
   "role": "reply",
   "block": "hiking.dlg10"
  }
 ]
}
