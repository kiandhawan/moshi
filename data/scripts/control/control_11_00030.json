 "est_total_sec": 51.85,
 "est_speech_sec": 39.85,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.79,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "I'm forty-five and I've never stayed in a hostel. Am I too old?",
   "est_sec": 4.13,
   "gap_before": 0.6,
   "event": "ordinary_request",
   "block": "travel_planning.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Not at all. Plenty of hostels have guests of every age, and many have private rooms too.",
   "est_sec": 5.37,
   "gap_before": 0.55,
   "role": "reply",
   "block": "travel_planning.dlg19"
  },
  {
   "speaker": "user",
   "text": "A private room in a hostel? Then what's the point?",
   "est_sec": 3.2,
   "gap_before": 0.86,
   "event": "ordinary_request",
   "block": "travel_planning.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "It's usually cheaper than a hotel, and you still get the social side, like the kitchen, the bar and organized walks.",
   "est_sec": 6.61,
   "gap_before": 0.33,
   "role": "reply",
   "block": "travel_planning.dlg19"
  },
  {
   "speaker": "user",
   "text": "Hmm. I do like meeting people.",
   "est_sec": 1.96,
   "gap_before": 2.78,
   "event": "ordinary_request",
   "block": "travel_planning.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Then look for hostels described as relaxed or social, not party hostels. Reviews tell you a lot.",
   "est_sec": 5.37,
   "gap_before": 0.43,
   "role": "reply",
   "block": "travel_planning.dlg19"
  },
  {
   "speaker": "user",
   "text": "Do I need to bring",
   "est_sec": 1.65,
   "gap_before": 0.82,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg19"
  },
  {
   "speaker": "user",
   "text": "my own towel and stuff?",
   "est_sec": 1.65,
   "gap_before": 1.72,
   "event": "ordinary_request",
   "block": "travel_planning.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Sometimes. Many charge a small fee for towels, so a light travel towel is handy. A padlock for the lockers is useful too.",
   "est_sec": 7.23,
   "gap_before": 0.93,
   "role": "reply",
   "block": "travel_planning.dlg19"
  }
 ]
}
