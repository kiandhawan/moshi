 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.41,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.69,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "I'm taking my two kids on their first flight next month. Any tips?",
   "est_sec": 4.13,
   "gap_before": 0.41,
   "event": "ordinary_request",
   "block": "travel_planning.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Bring snacks, headphones and something new for each of them to unwrap on the plane. Novelty buys you a lot of quiet time.",
   "est_sec": 7.23,
   "gap_before": 0.62,
   "role": "reply",
   "block": "travel_planning.dlg2"
  },
  {
   "speaker": "user",
   "text": "Ha, good one. They're four and seven. Will their ears hurt?",
   "est_sec": 3.51,
   "gap_before": 0.59,
   "event": "ordinary_request",
   "block": "travel_planning.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Sometimes during takeoff and landing. Chewing or drinking through a straw really helps.",
   "est_sec": 4.13,
   "gap_before": 0.39,
   "role": "reply",
   "block": "travel_planning.dlg2"
  },
  {
   "speaker": "user",
   "text": "Should I get seats near the front or",
   "est_sec": 2.58,
   "gap_before": 0.62,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg2"
  },
  {
   "speaker": "user",
   "text": "actually, does it matter?",
   "est_sec": 1.34,
   "gap_before": 2.54,
   "event": "ordinary_request",
   "block": "travel_planning.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Near the front means getting off faster, which is nice with tired kids. Window seats keep them entertained too.",
   "est_sec": 5.99,
   "gap_before": 0.58,
   "role": "reply",
   "block": "travel_planning.dlg2"
  },
  {
   "speaker": "user",
   "text": "And can I bring their car seat?",
   "est_sec": 2.27,
   "gap_before": 0.59,
   "event": "ordinary_request",
   "block": "travel_planning.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Most airlines let you check it for free. Some approved seats can even be used on board, so ask your airline.",
   "est_sec": 6.61,
   "gap_before": 0.55,
   "role": "reply",
   "block": "travel_planning.dlg2"
  }
 ]
}
