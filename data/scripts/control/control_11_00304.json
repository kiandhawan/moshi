 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.56,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 1.0,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "Our glass shower screen is covered in white spots. We live in a hard water area.",
   "est_sec": 5.06,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "cleaning.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Limescale. Spray it with equal parts white vinegar and water, leave it for fifteen minutes, then wipe with a microfibre cloth.",
   "est_sec": 6.61,
   "gap_before": 0.32,
   "role": "reply",
   "block": "cleaning.dlg9"
  },
  {
   "speaker": "user",
   "text": "Does it smell?",
   "est_sec": 1.03,
   "gap_before": 1.28,
   "event": "ordinary_request",
   "block": "cleaning.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "A bit, but it fades fast. Open the window.",
   "est_sec": 2.89,
   "gap_before": 0.79,
   "role": "reply",
   "block": "cleaning.dlg9"
  },
  {
   "speaker": "user",
   "text": "And to stop it",
   "est_sec": 1.34,
   "gap_before": 1.49,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg9"
  },
  {
   "speaker": "user",
   "text": "coming back every week?",
   "est_sec": 1.34,
   "gap_before": 2.7,
   "event": "ordinary_request",
   "block": "cleaning.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Keep a squeegee in the shower and give the glass a quick swipe after each use. Takes ten seconds.",
   "est_sec": 5.99,
   "gap_before": 0.92,
   "role": "reply",
   "block": "cleaning.dlg9"
  },
  {
   "speaker": "user",
   "text": "My husband will never do that.",
   "est_sec": 1.96,
   "gap_before": 2.05,
   "event": "ordinary_request",
   "block": "cleaning.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Hang the squeegee right at eye level. Sometimes that's all it takes.",
   "est_sec": 3.82,
   "gap_before": 0.8,
   "role": "reply",
   "block": "cleaning.dlg9"
  }
 ]
}
