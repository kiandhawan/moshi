 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.76,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.8,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "I keep spending money when I'm stressed. Like, retail therapy.",
   "est_sec": 3.2,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "personal_finance.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "That's very human. Shopping gives a quick little reward, which feels nice when everything else is hard.",
   "est_sec": 5.37,
   "gap_before": 1.16,
   "role": "reply",
   "block": "personal_finance.dlg21"
  },
  {
   "speaker": "user",
   "text": "But then I feel worse when I see my bank account.",
   "est_sec": 3.51,
   "gap_before": 0.91,
   "event": "ordinary_request",
   "block": "personal_finance.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Right, the comfort doesn't last. One trick is a waiting rule. Leave things in your basket for two days before buying.",
   "est_sec": 6.61,
   "gap_before": 0.65,
   "role": "reply",
   "block": "personal_finance.dlg21"
  },
  {
   "speaker": "user",
   "text": "Most of the time I'd",
   "est_sec": 1.65,
   "gap_before": 1.31,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg21"
  },
  {
   "speaker": "user",
   "text": "probably forget about it, honestly.",
   "est_sec": 1.65,
   "gap_before": 2.62,
   "event": "ordinary_request",
   "block": "personal_finance.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "That's the point. If you still want it after two days, you can buy it guilt free.",
   "est_sec": 5.37,
   "gap_before": 0.99,
   "role": "reply",
   "block": "personal_finance.dlg21"
  },
  {
   "speaker": "user",
   "text": "What else can I do when I'm stressed?",
   "est_sec": 2.58,
   "gap_before": 3.39,
   "event": "ordinary_request",
   "block": "personal_finance.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Find a cheaper comfort that works for you, like a walk, a call with a friend, or a bath. It helps to have one ready.",
   "est_sec": 7.85,
   "gap_before": 0.72,
   "role": "reply",
   "block": "personal_finance.dlg21"
  }
 ]
}
