 "est_total_sec": 47.57,
 "est_speech_sec": 35.1,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.72,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "My leather boots are ten years old and starting to let water in.",
   "est_sec": 4.13,
   "gap_before": 0.36,
   "event": "ordinary_request",
   "block": "hiking.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Good leather boots can often be revived. Have you waxed or treated them recently?",
   "est_sec": 4.44,
   "gap_before": 1.37,
   "role": "reply",
   "block": "hiking.dlg15"
  },
  {
   "speaker": "user",
   "text": "Never. Not once.",
   "est_sec": 1.03,
   "gap_before": 0.73,
   "event": "ordinary_request",
   "block": "hiking.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Then that's probably it. Clean them with a brush and water, let them dry naturally, then rub in a proper boot wax.",
   "est_sec": 6.92,
   "gap_before": 0.96,
   "role": "reply",
   "block": "hiking.dlg15"
  },
  {
   "speaker": "user",
   "text": "On the radiator to dry?",
   "est_sec": 1.65,
   "gap_before": 0.92,
   "event": "ordinary_request",
   "block": "hiking.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Please don't. Heat cracks the leather. Stuff them with newspaper and leave them somewhere airy.",
   "est_sec": 4.75,
   "gap_before": 1.12,
   "role": "reply",
   "block": "hiking.dlg15"
  },
  {
   "speaker": "user",
   "text": "And if they still leak?",
   "est_sec": 1.65,
   "gap_before": 3.48,
   "event": "ordinary_request",
   "block": "hiking.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Check the seams and the sole. If the sole is coming away, a cobbler can often resole them for less than new boots.",
   "est_sec": 7.23,
   "gap_before": 0.96,
   "role": "reply",
   "block": "hiking.dlg15"
  }
 ]
}
