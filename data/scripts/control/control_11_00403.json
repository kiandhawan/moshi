 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.84,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "I'm interviewing people for the spare room in my flat. What should I ask them?",
   "est_sec": 4.75,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "moving_house.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Ask about their routine, like when they work and when they go to bed. Clashing schedules cause a lot of friction.",
   "est_sec": 6.61,
   "gap_before": 0.87,
   "role": "reply",
   "block": "moving_house.dlg9"
  },
  {
   "speaker": "user",
   "text": "Good one.",
   "est_sec": 0.72,
   "gap_before": 2.82,
   "event": "ordinary_request",
   "block": "moving_house.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Ask how they feel about guests, cleaning and shared food. And how they handled problems with past flatmates.",
   "est_sec": 5.68,
   "gap_before": 1.4,
   "role": "reply",
   "block": "moving_house.dlg9"
  },
  {
   "speaker": "user",
   "text": "Should I ask about money?",
   "est_sec": 1.65,
   "gap_before": 1.15,
   "event": "ordinary_request",
   "block": "moving_house.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Yes, gently. Ask if they're comfortable with the rent and bills, and whether they'd do a reference check.",
   "est_sec": 5.68,
   "gap_before": 0.44,
   "role": "reply",
   "block": "moving_house.dlg9"
  },
  {
   "speaker": "user",
   "text": "And how",
   "est_sec": 0.72,
   "gap_before": 1.29,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg9"
  },
  {
   "speaker": "user",
   "text": "do I know if I actually like them?",
   "est_sec": 2.58,
   "gap_before": 2.29,
   "event": "ordinary_request",
   "block": "moving_house.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Trust your gut. Could you happily share a kitchen with them on a Sunday morning? That's usually the real test.",
   "est_sec": 6.3,
   "gap_before": 1.04,
   "role": "reply",
   "block": "moving_house.dlg9"
  }
 ]
}
