 "est_total_sec": 48.06,
 "est_speech_sec": 37.58,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.31,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.71,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "My hay fever is awful and I've got an outdoor work event on Thursday. Any tips?",
   "est_sec": 5.06,
   "gap_before": 0.2,
   "event": "ordinary_request",
   "block": "weather_plans.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Check the pollen forecast. Levels are usually highest on warm, dry, windy days, and lower after rain.",
   "est_sec": 5.37,
   "gap_before": 0.41,
   "role": "reply",
   "block": "weather_plans.dlg6"
  },
  {
   "speaker": "user",
   "text": "It says high all week. Of course.",
   "est_sec": 2.27,
   "gap_before": 1.07,
   "event": "ordinary_request",
   "block": "weather_plans.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Then take your antihistamine a few hours before, not when symptoms start. It works better ahead of time.",
   "est_sec": 5.68,
   "gap_before": 1.81,
   "role": "reply",
   "block": "weather_plans.dlg6"
  },
  {
   "speaker": "user",
   "text": "What else?",
   "est_sec": 0.72,
   "gap_before": 0.81,
   "event": "ordinary_request",
   "block": "weather_plans.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Wraparound sunglasses help keep pollen out of your eyes, and a bit of balm around your nostrils can trap some of it.",
   "est_sec": 6.92,
   "gap_before": 1.81,
   "role": "reply",
   "block": "weather_plans.dlg6"
  },
  {
   "speaker": "user",
   "text": "That sounds weird.",
   "est_sec": 1.03,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "weather_plans.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "It looks normal, nobody will notice. Change clothes and shower when you get home so you don't bring the pollen to bed with you.",
   "est_sec": 7.54,
   "gap_before": 1.35,
   "role": "reply",
   "block": "weather_plans.dlg6"
  }
 ]
}
