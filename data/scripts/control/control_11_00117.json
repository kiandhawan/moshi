 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.6,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.78,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "I'm going back to work after staying home with my kids for five years. How do I explain the gap?",
   "est_sec": 6.3,
   "gap_before": 0.22,
   "event": "ordinary_request",
   "block": "job_interview.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Be direct and positive. Say you took time to raise your children and you're excited to get back to work.",
   "est_sec": 6.3,
   "gap_before": 0.45,
   "role": "reply",
   "block": "job_interview.dlg2"
  },
  {
   "speaker": "user",
   "text": "Won't they think my skills are out of date?",
   "est_sec": 2.89,
   "gap_before": 0.89,
   "event": "ordinary_request",
   "block": "job_interview.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Show them otherwise. Mention any courses, volunteering or projects you did, even small ones.",
   "est_sec": 4.44,
   "gap_before": 0.59,
   "role": "reply",
   "block": "job_interview.dlg2"
  },
  {
   "speaker": "user",
   "text": "I did run the fundraising for the school",
   "est_sec": 2.58,
   "gap_before": 0.99,
   "event": "distractor",
   "kind": "pause",
   "block": "job_interview.dlg2"
  },
  {
   "speaker": "user",
   "text": "for about two years.",
   "est_sec": 1.34,
   "gap_before": 1.95,
   "event": "ordinary_request",
   "block": "job_interview.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "That's great experience. Talk about how much you raised and how you organized the volunteers.",
   "est_sec": 4.75,
   "gap_before": 0.86,
   "role": "reply",
   "block": "job_interview.dlg2"
  },
  {
   "speaker": "user",
   "text": "I never thought of that as real work.",
   "est_sec": 2.58,
   "gap_before": 0.83,
   "event": "ordinary_request",
   "block": "job_interview.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "It absolutely is. Planning, budgeting and leading people are exactly what employers look for.",
   "est_sec": 4.44,
   "gap_before": 1.16,
   "role": "reply",
   "block": "job_interview.dlg2"
  }
 ]
}
