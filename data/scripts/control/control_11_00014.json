 "est_total_sec": 55.6,
 "est_speech_sec": 44.6,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.62,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.95,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "My headlights have gone all yellow and cloudy. It looks really dodgy at night.",
   "est_sec": 4.44,
   "gap_before": 0.41,
   "event": "ordinary_request",
   "block": "cars.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "That's the plastic lens oxidising from the sun. It also makes the lights dimmer, so it's worth fixing.",
   "est_sec": 5.68,
   "gap_before": 0.99,
   "role": "reply",
   "block": "cars.dlg23"
  },
  {
   "speaker": "user",
   "text": "Do I need new headlights?",
   "est_sec": 1.65,
   "gap_before": 0.42,
   "event": "ordinary_request",
   "block": "cars.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Usually not. A headlight restoration kit sands the cloudy layer off and polishes it clear, then adds a protective coating.",
   "est_sec": 6.3,
   "gap_before": 1.15,
   "role": "reply",
   "block": "cars.dlg23"
  },
  {
   "speaker": "user",
   "text": "I saw someone online use toothpaste.",
   "est_sec": 1.96,
   "gap_before": 0.87,
   "event": "ordinary_request",
   "block": "cars.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Toothpaste can help a little for light haze, but it doesn't last. A proper kit with a UV sealant stays clear for a year or more.",
   "est_sec": 8.16,
   "gap_before": 0.38,
   "role": "reply",
   "block": "cars.dlg23"
  },
  {
   "speaker": "user",
   "text": "Is it hard?",
   "est_sec": 1.03,
   "gap_before": 1.04,
   "event": "ordinary_request",
   "block": "cars.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Not really. Mask off the paint around the light with tape, take your time with each sanding step, and do it on a dry day.",
   "est_sec": 7.85,
   "gap_before": 0.89,
   "role": "reply",
   "block": "cars.dlg23"
  },
  {
   "speaker": "user",
   "text": "Okay, weekend job then.",
   "est_sec": 1.34,
   "gap_before": 1.38,
   "event": "ordinary_request",
   "block": "cars.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Nice. You'll be surprised how much brighter the road looks afterwards.",
   "est_sec": 3.51,
   "gap_before": 0.4,
   "role": "reply",
   "block": "cars.dlg23"
  }
 ]
}
