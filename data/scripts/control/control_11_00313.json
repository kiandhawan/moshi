 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.58,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.95,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "How do I get rid of belly fat? I do a hundred sit-ups every night.",
   "est_sec": 4.75,
   "gap_before": 0.23,
   "event": "ordinary_request",
   "block": "fitness.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Unfortunately sit-ups won't burn fat from your belly specifically. You can't really target fat loss in one spot.",
   "est_sec": 5.68,
   "gap_before": 0.75,
   "role": "reply",
   "block": "fitness.dlg14"
  },
  {
   "speaker": "user",
   "text": "Then what's the point of them?",
   "est_sec": 1.96,
   "gap_before": 1.42,
   "event": "ordinary_request",
   "block": "fitness.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "They strengthen your core, which is good. But losing belly fat comes from overall fat loss, through diet, activity and sleep.",
   "est_sec": 6.61,
   "gap_before": 0.41,
   "role": "reply",
   "block": "fitness.dlg14"
  },
  {
   "speaker": "user",
   "text": "So I should stop?",
   "est_sec": 1.34,
   "gap_before": 0.78,
   "event": "ordinary_request",
   "block": "fitness.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "No need to stop, but your time might be better spent on full body strength training and more walking.",
   "est_sec": 5.99,
   "gap_before": 0.49,
   "role": "reply",
   "block": "fitness.dlg14"
  },
  {
   "speaker": "user",
   "text": "And food-wise? I eat pretty healthy",
   "est_sec": 1.96,
   "gap_before": 1.35,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg14"
  },
  {
   "speaker": "user",
   "text": "mostly.",
   "est_sec": 0.41,
   "gap_before": 2.83,
   "event": "ordinary_request",
   "block": "fitness.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Small steady changes work best, like more protein and vegetables, fewer sugary drinks. Aim for slow progress, not a crash diet.",
   "est_sec": 6.61,
   "gap_before": 1.11,
   "role": "reply",
   "block": "fitness.dlg14"
  }
 ]
}
