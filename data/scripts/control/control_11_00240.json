 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.7,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "Everyone at school is playing this horror game, but I get scared really easily.",
   "est_sec": 4.44,
   "gap_before": 0.51,
   "event": "ordinary_request",
   "block": "video_games.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "That's okay, plenty of people do. You could watch someone else play first, so you know what's coming.",
   "est_sec": 5.68,
   "gap_before": 0.33,
   "role": "reply",
   "block": "video_games.dlg17"
  },
  {
   "speaker": "user",
   "text": "Wouldn't that spoil it?",
   "est_sec": 1.34,
   "gap_before": 1.32,
   "event": "ordinary_request",
   "block": "video_games.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "A little, but it makes it far less scary. Or play it in the daytime with the lights on and someone else in the room.",
   "est_sec": 7.85,
   "gap_before": 0.79,
   "role": "reply",
   "block": "video_games.dlg17"
  },
  {
   "speaker": "user",
   "text": "Ha, my little sister",
   "est_sec": 1.34,
   "gap_before": 1.11,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg17"
  },
  {
   "speaker": "user",
   "text": "could be my bodyguard.",
   "est_sec": 1.34,
   "gap_before": 1.97,
   "event": "ordinary_request",
   "block": "video_games.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Perfect bodyguard. Lowering the volume also helps a lot, a big part of horror games is the sound.",
   "est_sec": 5.68,
   "gap_before": 0.48,
   "role": "reply",
   "block": "video_games.dlg17"
  },
  {
   "speaker": "user",
   "text": "I didn't think of that.",
   "est_sec": 1.65,
   "gap_before": 1.58,
   "event": "ordinary_request",
   "block": "video_games.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "And it's fine to just say it's not for you. There are plenty of other games to talk about with your friends.",
   "est_sec": 6.92,
   "gap_before": 0.84,
   "role": "reply",
   "block": "video_games.dlg17"
  }
 ]
}
