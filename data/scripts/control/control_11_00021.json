 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.75,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.94,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "There are tons of blackberries along my usual trail. Is it safe to eat them?",
   "est_sec": 4.75,
   "gap_before": 0.59,
   "event": "ordinary_request",
   "block": "hiking.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Blackberries are one of the safest wild fruits, since there's nothing toxic that looks similar.",
   "est_sec": 4.75,
   "gap_before": 0.75,
   "role": "reply",
   "block": "hiking.dlg31"
  },
  {
   "speaker": "user",
   "text": "Even ones right by the path?",
   "est_sec": 1.96,
   "gap_before": 3.4,
   "event": "ordinary_request",
   "block": "hiking.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Pick the ones higher up, away from where dogs might wander. Avoid bushes next to busy roads.",
   "est_sec": 5.37,
   "gap_before": 0.42,
   "role": "reply",
   "block": "hiking.dlg31"
  },
  {
   "speaker": "user",
   "text": "What about the red berries",
   "est_sec": 1.65,
   "gap_before": 0.52,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg31"
  },
  {
   "speaker": "user",
   "text": "right next to them?",
   "est_sec": 1.34,
   "gap_before": 2.88,
   "event": "ordinary_request",
   "block": "hiking.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Leave those unless you're absolutely sure what they are. Some red berries are poisonous.",
   "est_sec": 4.44,
   "gap_before": 1.04,
   "role": "reply",
   "block": "hiking.dlg31"
  },
  {
   "speaker": "user",
   "text": "Got it, black and bumpy only.",
   "est_sec": 1.96,
   "gap_before": 2.47,
   "event": "ordinary_request",
   "block": "hiking.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Bring a tub and you'll have a crumble by the evening.",
   "est_sec": 3.82,
   "gap_before": 0.85,
   "role": "reply",
   "block": "hiking.dlg31"
  }
 ]
}
