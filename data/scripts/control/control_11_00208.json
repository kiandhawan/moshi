 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.55,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "Quick one. What's an eSIM? The shop mentioned it and I nodded like I knew.",
   "est_sec": 4.75,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "smartphones.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "It's a SIM card that's built into the phone instead of a little plastic card. You download your plan instead of slotting something in.",
   "est_sec": 7.54,
   "gap_before": 0.39,
   "role": "reply",
   "block": "smartphones.dlg32"
  },
  {
   "speaker": "user",
   "text": "Is it better?",
   "est_sec": 1.03,
   "gap_before": 0.42,
   "event": "ordinary_request",
   "block": "smartphones.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Mostly convenient. You can switch carriers without a trip to a shop, and some phones hold a couple of plans at once.",
   "est_sec": 6.92,
   "gap_before": 0.55,
   "role": "reply",
   "block": "smartphones.dlg32"
  },
  {
   "speaker": "user",
   "text": "Any",
   "est_sec": 0.41,
   "gap_before": 0.9,
   "event": "distractor",
   "kind": "pause",
   "block": "smartphones.dlg32"
  },
  {
   "speaker": "user",
   "text": "downside?",
   "est_sec": 0.41,
   "gap_before": 2.93,
   "event": "ordinary_request",
   "block": "smartphones.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Moving it to a new phone takes a few extra steps, and some small carriers don't support it yet.",
   "est_sec": 5.99,
   "gap_before": 1.05,
   "role": "reply",
   "block": "smartphones.dlg32"
  },
  {
   "speaker": "user",
   "text": "Alright. I'll nod with confidence next time.",
   "est_sec": 2.27,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "smartphones.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Now you've earned it.",
   "est_sec": 1.34,
   "gap_before": 0.64,
   "role": "reply",
   "block": "smartphones.dlg32"
  }
 ]
