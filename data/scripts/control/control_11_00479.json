 "est_speech_sec": 37.06,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.61,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "All my photos look hazy lately. Like there's fog on everything.",
   "est_sec": 3.51,
   "gap_before": 0.32,
   "event": "ordinary_request",
   "block": "smartphones.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "First thing to try sounds silly, but wipe the camera lens. Pocket grease is the most common cause.",
   "est_sec": 5.68,
   "gap_before": 0.35,
   "role": "reply",
   "block": "smartphones.dlg12"
  },
  {
   "speaker": "user",
   "text": "Oh. Wow. That's way better.",
   "est_sec": 1.65,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "smartphones.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "It happens to everyone. A soft cloth, your shirt in a pinch, but not paper towels, they can scratch.",
   "est_sec": 5.99,
   "gap_before": 0.41,
   "role": "reply",
   "block": "smartphones.dlg12"
  },
  {
   "speaker": "user",
   "text": "Is there anything else I should do",
   "est_sec": 2.27,
   "gap_before": 1.93,
   "event": "distractor",
   "kind": "pause",
   "block": "smartphones.dlg12"
  },
  {
   "speaker": "user",
   "text": "for sharper shots?",
   "est_sec": 1.03,
   "gap_before": 1.62,
   "event": "ordinary_request",
   "block": "smartphones.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Tap on your subject before taking the photo so it focuses there, and hold still for a second after you press the button.",
   "est_sec": 7.23,
   "gap_before": 0.45,
   "role": "reply",
   "block": "smartphones.dlg12"
  },
  {
   "speaker": "user",
   "text": "Okay. I've been snapping and moving immediately.",
   "est_sec": 2.27,
   "gap_before": 0.4,
   "event": "ordinary_request",
   "block": "smartphones.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Most phones keep processing the image for a moment, so that little pause really helps.",
   "est_sec": 4.75,
   "gap_before": 0.4,
   "role": "reply",
   "block": "smartphones.dlg12"
  }
 ]
}
