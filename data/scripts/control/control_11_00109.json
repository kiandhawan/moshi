 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.32,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.87,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "I did my first leg day yesterday and now I can't walk down the stairs. Did I injure myself?",
   "est_sec": 5.99,
   "gap_before": 0.4,
   "event": "ordinary_request",
   "block": "fitness.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Probably not. It sounds like normal muscle soreness, which usually peaks one or two days after a new workout.",
   "est_sec": 5.99,
   "gap_before": 1.06,
   "role": "reply",
   "block": "fitness.dlg6"
  },
  {
   "speaker": "user",
   "text": "Wait, what did you say?",
   "est_sec": 1.65,
   "gap_before": 1.15,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_01",
   "block": "fitness.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "No problem. Probably not. It sounds like normal muscle soreness, which usually peaks one or two days after a new workout.",
   "est_sec": 6.61,
   "gap_before": 0.92,
   "role": "reply",
   "block": "fitness.dlg6"
  },
  {
   "speaker": "user",
   "text": "It hurts so much. Sitting on the toilet is an event.",
   "est_sec": 3.51,
   "gap_before": 1.42,
   "event": "ordinary_request",
   "block": "fitness.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "That's very common after squats and lunges. It should ease in a few days.",
   "est_sec": 4.44,
   "gap_before": 1.16,
   "role": "reply",
   "block": "fitness.dlg6"
  },
  {
   "speaker": "user",
   "text": "Should I rest or move?",
   "est_sec": 1.65,
   "gap_before": 1.38,
   "event": "ordinary_request",
   "block": "fitness.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Gentle movement helps, like walking or easy cycling. Avoid another hard leg session until it fades.",
   "est_sec": 5.06,
   "gap_before": 1.53,
   "role": "reply",
   "block": "fitness.dlg6"
  },
  {
   "speaker": "user",
   "text": "Will it be this bad",
   "est_sec": 1.65,
   "gap_before": 0.53,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg6"
  },
  {
   "speaker": "user",
   "text": "every single time?",
   "est_sec": 1.03,
   "gap_before": 2.88,
   "event": "ordinary_request",
   "block": "fitness.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "No, your body adapts quickly. The next few leg days will feel much better, as long as you stay consistent.",
   "est_sec": 6.3,
   "gap_before": 0.39,
   "role": "reply",
   "block": "fitness.dlg6"
  },
  {
   "speaker": "user",
   "text": "Good, because right now I hate squats.",
   "est_sec": 2.27,
   "gap_before": 1.17,
   "event": "ordinary_request",
   "block": "fitness.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Totally understandable. You'll make up with them.",
   "est_sec": 2.27,
   "gap_before": 1.11,
   "role": "reply",
