 "est_total_sec": 54.42,
 "est_speech_sec": 41.09,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.6,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "My mum's in a care home and her memory isn't great. Are there games we could still play together when I visit?",
   "est_sec": 6.92,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "board_games.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Yes, definitely. Simple, familiar games tend to work best, things she might have played years ago, like dominoes or snakes and ladders.",
   "est_sec": 6.92,
   "gap_before": 1.08,
   "role": "reply",
   "block": "board_games.dlg19"
  },
  {
   "speaker": "user",
   "text": "She used to love dominoes.",
   "est_sec": 1.65,
   "gap_before": 1.28,
   "event": "ordinary_request",
   "block": "board_games.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Then dominoes is perfect. Big tiles with clear dots are easier to see and handle.",
   "est_sec": 4.75,
   "gap_before": 0.82,
   "role": "reply",
   "block": "board_games.dlg19"
  },
  {
   "speaker": "user",
   "text": "What if she",
   "est_sec": 1.03,
   "gap_before": 1.34,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg19"
  },
  {
   "speaker": "user",
   "text": "forgets the rules halfway?",
   "est_sec": 1.34,
   "gap_before": 1.95,
   "event": "ordinary_request",
   "block": "board_games.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Just play gently alongside her and don't correct much. The point is the time together, not playing it perfectly.",
   "est_sec": 5.99,
   "gap_before": 1.09,
   "role": "reply",
   "block": "board_games.dlg19"
  },
  {
   "speaker": "user",
   "text": "That's a nice way to think about it.",
   "est_sec": 2.58,
   "gap_before": 0.89,
   "event": "ordinary_request",
   "block": "board_games.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Picture matching games and simple card games like snap are good too. Some care homes have a games box you could borrow.",
   "est_sec": 6.92,
   "gap_before": 1.93,
   "role": "reply",
   "block": "board_games.dlg19"
  }
 ]
}
