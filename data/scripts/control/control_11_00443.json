 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.44,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.39,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "Three kids starting school in September and the uniform list is long. How do I not go bankrupt?",
   "est_sec": 5.68,
   "gap_before": 0.26,
   "event": "ordinary_request",
   "block": "shopping.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Only buy the logo items from the official shop. Plain trousers, skirts, polo shirts and jumpers can usually come from any supermarket.",
   "est_sec": 6.92,
   "gap_before": 0.56,
   "role": "reply",
   "block": "shopping.dlg21"
  },
  {
   "speaker": "user",
   "text": "The school doesn't mind?",
   "est_sec": 1.34,
   "gap_before": 2.48,
   "event": "ordinary_request",
   "block": "shopping.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Most don't, as long as the colour matches. Check the school's uniform policy to be sure.",
   "est_sec": 5.06,
   "gap_before": 0.52,
   "role": "reply",
   "block": "shopping.dlg21"
  },
  {
   "speaker": "user",
   "text": "My youngest will just get the hand me downs, poor thing.",
   "est_sec": 3.51,
   "gap_before": 0.73,
   "event": "ordinary_request",
   "block": "shopping.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "That's totally normal. Lots of schools also run a secondhand uniform sale, often for almost nothing.",
   "est_sec": 5.06,
   "gap_before": 1.57,
   "role": "reply",
   "block": "shopping.dlg21"
  },
  {
   "speaker": "user",
   "text": "Oh, I didn't know that.",
   "est_sec": 1.65,
   "gap_before": 1.32,
   "event": "distractor",
   "kind": "pause",
   "block": "shopping.dlg21"
  },
  {
   "speaker": "user",
   "text": "I'll email the office.",
   "est_sec": 1.34,
   "gap_before": 1.67,
   "event": "ordinary_request",
   "block": "shopping.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Good idea. And put name labels on everything, lost jumpers are the hidden cost of the school year.",
   "est_sec": 5.68,
   "gap_before": 0.96,
   "role": "reply",
   "block": "shopping.dlg21"
  }
 ]
}
