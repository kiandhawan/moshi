 "est_total_sec": 54.24,
 "est_speech_sec": 42.33,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.75,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "Heatwave this week, and my mum is eighty four and lives alone. I'm worried.",
   "est_sec": 4.44,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "weather_plans.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "That's a good thing to worry about. Older people often don't feel thirsty and can overheat without noticing.",
   "est_sec": 5.68,
   "gap_before": 1.95,
   "role": "reply",
   "block": "weather_plans.dlg16"
  },
  {
   "speaker": "user",
   "text": "She refuses to turn the fan on, she says it's wasteful.",
   "est_sec": 3.51,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "weather_plans.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Explain it's just for this week. Curtains closed in the day and windows open at night really help too.",
   "est_sec": 5.99,
   "gap_before": 0.66,
   "role": "reply",
   "block": "weather_plans.dlg16"
  },
  {
   "speaker": "user",
   "text": "How often should I check on her?",
   "est_sec": 2.27,
   "gap_before": 0.68,
   "event": "ordinary_request",
   "block": "weather_plans.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "At least once a day, by phone or a visit. Ask if she's drinking, and listen for confusion or dizziness.",
   "est_sec": 6.3,
   "gap_before": 0.55,
   "role": "reply",
   "block": "weather_plans.dlg16"
  },
  {
   "speaker": "user",
   "text": "I'll drop off some",
   "est_sec": 1.34,
   "gap_before": 1.11,
   "event": "distractor",
   "kind": "pause",
   "block": "weather_plans.dlg16"
  },
  {
   "speaker": "user",
   "text": "jelly and fruit, she always eats those.",
   "est_sec": 2.27,
   "gap_before": 2.63,
   "event": "ordinary_request",
   "block": "weather_plans.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Lovely idea, both have lots of water. A spray bottle of cool water and a damp flannel on her neck can also help her cool down.",
   "est_sec": 8.16,
   "gap_before": 0.62,
   "role": "reply",
   "block": "weather_plans.dlg16"
  }
 ]
}
