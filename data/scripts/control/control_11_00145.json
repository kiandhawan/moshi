 "est_speech_sec": 44.29,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.42,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.78,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "I'm setting up a phone for my mom. She's not great with tech. Any tips?",
   "est_sec": 4.75,
   "gap_before": 0.27,
   "event": "ordinary_request",
   "block": "smartphones.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Make the text and icons bigger in the display settings first. That alone helps a lot.",
   "est_sec": 5.06,
   "gap_before": 0.97,
   "role": "reply",
   "block": "smartphones.dlg2"
  },
  {
   "speaker": "user",
   "text": "Good one. What else?",
   "est_sec": 1.34,
   "gap_before": 2.77,
   "event": "ordinary_request",
   "block": "smartphones.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Put just the apps she uses on the home screen, like calls, messages and photos. Hide the rest in a folder.",
   "est_sec": 6.61,
   "gap_before": 0.52,
   "role": "reply",
   "block": "smartphones.dlg2"
  },
  {
   "speaker": "user",
   "text": "She always",
   "est_sec": 0.72,
   "gap_before": 1.03,
   "event": "distractor",
   "kind": "pause",
   "block": "smartphones.dlg2"
  },
  {
   "speaker": "user",
   "text": "ends up calling people by accident from her pocket.",
   "est_sec": 2.89,
   "gap_before": 1.98,
   "event": "ordinary_request",
   "block": "smartphones.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "A simple case with a flip cover can stop that. You could also shorten the screen timeout so it locks sooner.",
   "est_sec": 6.61,
   "gap_before": 0.59,
   "role": "reply",
   "block": "smartphones.dlg2"
  },
  {
   "speaker": "user",
   "text": "Oh, and can I help her from my own phone if she's stuck?",
   "est_sec": 4.13,
   "gap_before": 1.3,
   "event": "ordinary_request",
   "block": "smartphones.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Yes, a screen sharing app lets you see her screen and guide her. Set it up together before you hand the phone over.",
   "est_sec": 7.23,
   "gap_before": 0.46,
   "role": "reply",
   "block": "smartphones.dlg2"
  },
  {
   "speaker": "user",
   "text": "Perfect, I'll do that this weekend.",
   "est_sec": 1.96,
   "gap_before": 1.59,
   "block": "smartphones.dlg2"
  }
 ]
}
