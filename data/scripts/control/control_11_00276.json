 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.76,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.49,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "My running club meets outside at six in the morning. It's going to be below freezing all week.",
   "est_sec": 5.68,
   "gap_before": 0.29,
   "event": "ordinary_request",
   "block": "weather_plans.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Running in the cold is fine with the right gear. Wear a base layer that wicks sweat, plus gloves and a hat.",
   "est_sec": 6.92,
   "gap_before": 0.59,
   "role": "reply",
   "block": "weather_plans.dlg3"
  },
  {
   "speaker": "user",
   "text": "I always feel freezing for the first ten minutes.",
   "est_sec": 2.89,
   "gap_before": 2.41,
   "event": "ordinary_request",
   "block": "weather_plans.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "That's normal. Dress as if it's about ten degrees warmer than it is, because you'll heat up quickly.",
   "est_sec": 5.68,
   "gap_before": 0.72,
   "role": "reply",
   "block": "weather_plans.dlg3"
  },
  {
   "speaker": "user",
   "text": "What about ice on the paths?",
   "est_sec": 1.96,
   "gap_before": 1.93,
   "event": "ordinary_request",
   "block": "weather_plans.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "That's the real risk. Shorten your stride, slow down on corners, and consider slip-on traction cleats.",
   "est_sec": 5.06,
   "gap_before": 1.07,
   "role": "reply",
   "block": "weather_plans.dlg3"
  },
  {
   "speaker": "user",
   "text": "Maybe I'll just",
   "est_sec": 1.03,
   "gap_before": 0.45,
   "event": "distractor",
   "kind": "pause",
   "block": "weather_plans.dlg3"
  },
  {
   "speaker": "user",
   "text": "no, I'll still go, I don't want to lose my streak.",
   "est_sec": 3.51,
   "gap_before": 2.02,
   "event": "ordinary_request",
   "block": "weather_plans.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Good for you. Just warm up indoors for a few minutes first so your muscles aren't cold.",
   "est_sec": 5.37,
   "gap_before": 1.2,
   "role": "reply",
   "block": "weather_plans.dlg3"
  }
 ]
}
