  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.64,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.88,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "I'm doing a horror marathon on Halloween. How many films is reasonable?",
   "est_sec": 3.82,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "movies.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Three is a good number. Four if you start early and have plenty of snacks.",
   "est_sec": 4.75,
   "gap_before": 0.47,
   "role": "reply",
   "block": "movies.dlg3"
  },
  {
   "speaker": "user",
   "text": "Should I start with the scariest one or end with it?",
   "est_sec": 3.51,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "movies.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Build up. Start with a fun, campy one, then something creepy, and finish with the most intense.",
   "est_sec": 5.37,
   "gap_before": 0.54,
   "role": "reply",
   "block": "movies.dlg3"
  },
  {
   "speaker": "user",
   "text": "My friend wants to include a really old black and white one",
   "est_sec": 3.82,
   "gap_before": 0.32,
   "event": "distractor",
   "kind": "pause",
   "block": "movies.dlg3"
  },
  {
   "speaker": "user",
   "text": "is that a mood killer?",
   "est_sec": 1.65,
   "gap_before": 2.98,
   "event": "ordinary_request",
   "block": "movies.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Not at all. Old horror can be surprisingly eerie. Put it first or second, while everyone's still fresh.",
   "est_sec": 5.68,
   "gap_before": 0.75,
   "role": "reply",
   "block": "movies.dlg3"
  },
  {
   "speaker": "user",
   "text": "Nice. And what snacks go with horror?",
   "est_sec": 2.27,
   "gap_before": 1.44,
   "event": "ordinary_request",
   "block": "movies.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Popcorn, obviously. And something like red gummy sweets for the theme.",
   "est_sec": 3.51,
   "gap_before": 0.38,
   "role": "reply",
   "block": "movies.dlg3"
  }
 ]
