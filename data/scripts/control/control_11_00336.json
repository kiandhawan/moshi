 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.71,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.55,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "Can I use bleach on my wooden cutting board?",
   "est_sec": 2.89,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "cleaning.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Bleach can dry out and crack wood, so I'd avoid it. Hot soapy water and drying it standing up is usually enough.",
   "est_sec": 6.92,
   "gap_before": 0.67,
   "role": "reply",
   "block": "cleaning.dlg3"
  },
  {
   "speaker": "user",
   "text": "What if I cut raw chicken on it?",
   "est_sec": 2.58,
   "gap_before": 1.45,
   "event": "ordinary_request",
   "block": "cleaning.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Then scrub it well and wipe it with plain white vinegar. Even better, keep a plastic board just for raw meat.",
   "est_sec": 6.61,
   "gap_before": 0.84,
   "role": "reply",
   "block": "cleaning.dlg3"
  },
  {
   "speaker": "user",
   "text": "Okay. It also smells",
   "est_sec": 1.34,
   "gap_before": 1.0,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg3"
  },
  {
   "speaker": "user",
   "text": "kind of like onions all the time.",
   "est_sec": 2.27,
   "gap_before": 2.45,
   "event": "ordinary_request",
   "block": "cleaning.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Rub it with half a lemon and some coarse salt, then rinse. That takes out most smells.",
   "est_sec": 5.37,
   "gap_before": 0.95,
   "role": "reply",
   "block": "cleaning.dlg3"
  },
  {
   "speaker": "user",
   "text": "And should I oil it?",
   "est_sec": 1.65,
   "gap_before": 1.16,
   "event": "ordinary_request",
   "block": "cleaning.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Yes, once a month with food safe mineral oil. It keeps the wood from drying out and cracking.",
   "est_sec": 5.68,
   "gap_before": 1.03,
   "role": "reply",
   "block": "cleaning.dlg3"
  }
 ]
}
