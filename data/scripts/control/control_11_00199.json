 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.32,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.56,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "I want a little overnight getaway this weekend, but I've got hardly any money.",
   "est_sec": 4.44,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Very doable. Look at youth hostels, a lot of them have private rooms now and they're much cheaper than hotels.",
   "est_sec": 6.3,
   "gap_before": 1.77,
   "role": "reply",
   "block": "weekend_plans.dlg8"
  },
  {
   "speaker": "user",
   "text": "I'm forty, is that weird?",
   "est_sec": 1.65,
   "gap_before": 1.51,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Not at all. Hostels have all ages these days, especially in nice countryside spots.",
   "est_sec": 4.44,
   "gap_before": 1.83,
   "role": "reply",
   "block": "weekend_plans.dlg8"
  },
  {
   "speaker": "user",
   "text": "And getting there?",
   "est_sec": 1.03,
   "gap_before": 0.74,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Book train tickets in advance, or check for coach routes, they're usually cheaper. Taking your own food saves a lot too.",
   "est_sec": 6.61,
   "gap_before": 0.61,
   "role": "reply",
   "block": "weekend_plans.dlg8"
  },
  {
   "speaker": "user",
   "text": "I could",
   "est_sec": 0.72,
   "gap_before": 1.07,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg8"
  },
  {
   "speaker": "user",
   "text": "bring sandwiches and a flask.",
   "est_sec": 1.65,
   "gap_before": 2.93,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Perfect. Then spend your money on one nice meal or one activity you'd really enjoy.",
   "est_sec": 4.75,
   "gap_before": 1.13,
   "role": "reply",
   "block": "weekend_plans.dlg8"
  }
 ]
}
