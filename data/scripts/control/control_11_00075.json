 "est_total_sec": 63.77,
 "est_speech_sec": 47.49,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.95,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "Is it actually worth washing the car in winter? It'll just get filthy again in a day.",
   "est_sec": 5.37,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "cars.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "It is, mainly because of the road salt. Salt sticks to the underside and speeds up rust, especially around the wheel arches.",
   "est_sec": 6.92,
   "gap_before": 1.07,
   "role": "reply",
   "block": "cars.dlg29"
  },
  {
   "speaker": "user",
   "text": "Huh. I thought it was just about looks.",
   "est_sec": 2.58,
   "gap_before": 1.48,
   "event": "ordinary_request",
   "block": "cars.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Looks too, but the underneath matters more. A rinse every couple of weeks during salty months makes a real difference.",
   "est_sec": 6.3,
   "gap_before": 0.38,
   "role": "reply",
   "block": "cars.dlg29"
  },
  {
   "speaker": "user",
   "text": "Hold on, really?",
   "est_sec": 1.03,
   "gap_before": 0.93,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_11",
   "block": "cars.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Hmm, I believe it is. Which part doesn't sound right?",
   "est_sec": 3.2,
   "gap_before": 0.94,
   "role": "reply",
   "block": "cars.dlg29"
  },
  {
   "speaker": "user",
   "text": "It's freezing though. Won't the water",
   "est_sec": 1.96,
   "gap_before": 2.8,
   "event": "distractor",
   "kind": "pause",
   "block": "cars.dlg29"
  },
  {
   "speaker": "user",
   "text": "freeze on the car?",
   "est_sec": 1.34,
   "gap_before": 2.62,
   "event": "ordinary_request",
   "block": "cars.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "It can. Wash it on a milder day if possible, and dry the door seals and locks so they don't freeze shut overnight.",
   "est_sec": 7.23,
   "gap_before": 1.04,
   "role": "reply",
   "block": "cars.dlg29"
  },
  {
   "speaker": "user",
   "text": "Car wash or by hand?",
   "est_sec": 1.65,
   "gap_before": 0.79,
   "event": "ordinary_request",
   "block": "cars.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "A car wash with an underbody spray is perfect in winter. It gets the bits you'd never reach with a bucket.",
   "est_sec": 6.61,
   "gap_before": 0.94,
   "role": "reply",
   "block": "cars.dlg29"
  }
 ]
}
