 "est_total_sec": 49.75,
 "est_speech_sec": 41.61,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.58,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.35,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "I'm seeing a band on Friday, standing room. Can I get decent photos from the crowd?",
   "est_sec": 5.06,
   "gap_before": 0.42,
   "event": "ordinary_request",
   "block": "photography.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "You can, with a few tricks. First check if the venue allows cameras, a lot only allow phones.",
   "est_sec": 5.68,
   "gap_before": 0.85,
   "role": "reply",
   "block": "photography.dlg28"
  },
  {
   "speaker": "user",
   "text": "Just my phone then.",
   "est_sec": 1.34,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "photography.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Turn off the flash, it's useless that far and annoys everyone. Tap on the singer to set focus and drag the exposure down so the stage lights don't blow out.",
   "est_sec": 9.4,
   "gap_before": 0.67,
   "role": "reply",
   "block": "photography.dlg28"
  },
  {
   "speaker": "user",
   "text": "Should I film or take photos?",
   "est_sec": 1.96,
   "gap_before": 0.73,
   "event": "ordinary_request",
   "block": "photography.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Take a few photos in the first couple of songs, when the lights are usually most dramatic, then put the phone away and enjoy it.",
   "est_sec": 7.85,
   "gap_before": 0.59,
   "role": "reply",
   "block": "photography.dlg28"
  },
  {
   "speaker": "user",
   "text": "That's the real advice, isn't it.",
   "est_sec": 1.96,
   "gap_before": 1.08,
   "event": "ordinary_request",
   "block": "photography.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "It is. A handful of good shots beats an hour of shaky video you'll never watch.",
   "est_sec": 5.06,
   "gap_before": 1.04,
   "role": "reply",
   "block": "photography.dlg28"
  }
 ]
}
