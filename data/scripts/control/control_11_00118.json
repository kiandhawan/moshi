 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.55,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.77,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "I just got a raise! Like a real one.",
   "est_sec": 2.89,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "personal_finance.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Congratulations! That's exciting. Any plans for it?",
   "est_sec": 2.27,
   "gap_before": 0.44,
   "role": "reply",
   "block": "personal_finance.dlg27"
  },
  {
   "speaker": "user",
   "text": "Not yet. I want to enjoy it but also not be stupid.",
   "est_sec": 3.82,
   "gap_before": 3.48,
   "event": "ordinary_request",
   "block": "personal_finance.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "A nice approach is to split it. Maybe half for savings or goals, half for enjoying life a little more.",
   "est_sec": 6.3,
   "gap_before": 1.15,
   "role": "reply",
   "block": "personal_finance.dlg27"
  },
  {
   "speaker": "user",
   "text": "Half sounds like a lot to save.",
   "est_sec": 2.27,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "personal_finance.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "It's only the new money, though. Your current lifestyle stays the same, you just don't let it all creep up.",
   "est_sec": 6.3,
   "gap_before": 0.66,
   "role": "reply",
   "block": "personal_finance.dlg27"
  },
  {
   "speaker": "user",
   "text": "Oh, that's",
   "est_sec": 0.72,
   "gap_before": 1.47,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg27"
  },
  {
   "speaker": "user",
   "text": "actually pretty painless when you put it that way.",
   "est_sec": 2.89,
   "gap_before": 2.92,
   "event": "ordinary_request",
   "block": "personal_finance.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. And treat yourself to something small to celebrate. You earned it.",
   "est_sec": 3.82,
   "gap_before": 1.81,
   "role": "reply",
   "block": "personal_finance.dlg27"
  }
 ]
