 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.95,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "My battery goes from eighty to forty overnight, and I'm not even using it.",
   "est_sec": 4.44,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "smartphones.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "That's a lot. Something's probably running in the background. Check the battery section in settings, it lists which apps used the most.",
   "est_sec": 6.92,
   "gap_before": 1.11,
   "role": "reply",
   "block": "smartphones.dlg8"
  },
  {
   "speaker": "user",
   "text": "Let me look. Oh. A weather app used thirty percent.",
   "est_sec": 3.2,
   "gap_before": 0.74,
   "event": "ordinary_request",
   "block": "smartphones.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "There's your culprit. It's likely refreshing your location constantly.",
   "est_sec": 2.89,
   "gap_before": 0.86,
   "role": "reply",
   "block": "smartphones.dlg8"
  },
  {
   "speaker": "user",
   "text": "Can I keep it but stop it doing",
   "est_sec": 2.58,
   "gap_before": 1.13,
   "event": "distractor",
   "kind": "pause",
   "block": "smartphones.dlg8"
  },
  {
   "speaker": "user",
   "text": "that?",
   "est_sec": 0.41,
   "gap_before": 2.35,
   "event": "ordinary_request",
   "block": "smartphones.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Yes. Set its location access to only while using the app, and turn off background refresh for it.",
   "est_sec": 5.68,
   "gap_before": 0.47,
   "role": "reply",
   "block": "smartphones.dlg8"
  },
  {
   "speaker": "user",
   "text": "Done. That's so sneaky.",
   "est_sec": 1.34,
   "gap_before": 0.63,
   "event": "ordinary_request",
   "block": "smartphones.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Pretty common, sadly. Check again tomorrow morning and see if it holds its charge.",
   "est_sec": 4.44,
