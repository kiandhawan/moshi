 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.66,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.81,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I want a game I can play with my grandkids. They're four and six.",
   "est_sec": 4.44,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "board_games.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Wonderful. Outfoxed is a sweet cooperative game for that age, everyone works together to catch a sneaky fox.",
   "est_sec": 5.68,
   "gap_before": 0.5,
   "role": "reply",
   "block": "board_games.dlg4"
  },
  {
   "speaker": "user",
   "text": "The four year old can't read yet.",
   "est_sec": 2.27,
   "gap_before": 2.77,
   "event": "ordinary_request",
   "block": "board_games.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "That's fine, it uses pictures only. Another favorite is Hoot Owl Hoot, which is all colors.",
   "est_sec": 5.06,
   "gap_before": 0.87,
   "role": "reply",
   "block": "board_games.dlg4"
  },
  {
   "speaker": "user",
   "text": "I used to play",
   "est_sec": 1.34,
   "gap_before": 0.67,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg4"
  },
  {
   "speaker": "user",
   "text": "snakes and ladders with my kids. Is that still good?",
   "est_sec": 3.2,
   "gap_before": 2.0,
   "event": "ordinary_request",
   "block": "board_games.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "It's still great for counting practice. It's pure luck though, so mix it with one where they make choices.",
   "est_sec": 5.99,
   "gap_before": 0.88,
   "role": "reply",
   "block": "board_games.dlg4"
  },
  {
   "speaker": "user",
   "text": "I'll get the owl one then.",
   "est_sec": 1.96,
   "gap_before": 1.15,
   "event": "ordinary_request",
   "block": "board_games.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Lovely. Games for that age usually last about fifteen minutes, just right for little attention spans.",
   "est_sec": 5.06,
   "gap_before": 0.8,
   "role": "reply",
   "block": "board_games.dlg4"
  }
 ]
