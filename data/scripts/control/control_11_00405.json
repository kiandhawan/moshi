 "est_total_sec": 46.41,
 "est_speech_sec": 37.58,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.55,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.55,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "I've booked a hot air balloon ride for my partner's anniversary. What weather do they need?",
   "est_sec": 5.06,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "weather_plans.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Calm and stable. Light winds, no rain, and good visibility. They usually fly just after sunrise or before sunset.",
   "est_sec": 5.99,
   "gap_before": 0.87,
   "role": "reply",
   "block": "weather_plans.dlg23"
  },
  {
   "speaker": "user",
   "text": "Why those times?",
   "est_sec": 1.03,
   "gap_before": 1.37,
   "event": "ordinary_request",
   "block": "weather_plans.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "The air is calmer then. In the middle of the day, the sun heats the ground and makes the air bumpy.",
   "est_sec": 6.61,
   "gap_before": 0.69,
   "role": "reply",
   "block": "weather_plans.dlg23"
  },
  {
   "speaker": "user",
   "text": "What if the weather's bad?",
   "est_sec": 1.65,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "weather_plans.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "They'll cancel and rebook you, often at short notice. It's very common, sometimes several times.",
   "est_sec": 4.75,
   "gap_before": 0.49,
   "role": "reply",
   "block": "weather_plans.dlg23"
  },
  {
   "speaker": "user",
   "text": "I wanted it to be a surprise.",
   "est_sec": 2.27,
   "gap_before": 1.0,
   "event": "ordinary_request",
   "block": "weather_plans.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Then maybe keep the exact day a surprise but tell your partner to keep a few mornings free. Pick a flexible ticket if you can.",
   "est_sec": 7.85,
   "gap_before": 0.95,
   "role": "reply",
   "block": "weather_plans.dlg23"
  }
 ]
}
