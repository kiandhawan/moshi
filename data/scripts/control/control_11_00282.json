 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.48,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.65,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "Just moved into my first flat. Which spices should I buy first? The shelf at the shop is overwhelming.",
   "est_sec": 5.99,
   "gap_before": 0.23,
   "event": "ordinary_request",
   "block": "cooking.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Start small. Black pepper, cumin, smoked paprika, chili flakes, dried oregano and cinnamon cover a lot of dishes.",
   "est_sec": 5.68,
   "gap_before": 0.64,
   "role": "reply",
   "block": "cooking.dlg28"
  },
  {
   "speaker": "user",
   "text": "Hang on, I missed that.",
   "est_sec": 1.65,
   "gap_before": 2.77,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_04",
   "block": "cooking.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Of course. Start small. Black pepper, cumin, smoked paprika, chili flakes, dried oregano and cinnamon cover a lot of dishes.",
   "est_sec": 6.3,
   "gap_before": 0.86,
   "role": "reply",
   "block": "cooking.dlg28"
  },
  {
   "speaker": "user",
   "text": "Cinnamon for savory stuff?",
   "est_sec": 1.34,
   "gap_before": 0.73,
   "event": "ordinary_request",
   "block": "cooking.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Yes, a pinch in chili or a tagine is great. And of course for porridge.",
   "est_sec": 4.75,
   "gap_before": 0.98,
   "role": "reply",
   "block": "cooking.dlg28"
  },
  {
   "speaker": "user",
   "text": "What about those big mixed jars, like curry powder?",
   "est_sec": 2.89,
   "gap_before": 2.43,
   "event": "ordinary_request",
   "block": "cooking.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Curry powder and garam masala are handy shortcuts. Buy small jars, though, spices lose their flavor after a year or so.",
   "est_sec": 6.61,
   "gap_before": 0.45,
   "role": "reply",
   "block": "cooking.dlg28"
  },
  {
   "speaker": "user",
   "text": "I'll get the basics then. Is it worth buying",
   "est_sec": 2.89,
   "gap_before": 1.28,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg28"
  },
  {
   "speaker": "user",
   "text": "whole ones and grinding them?",
   "est_sec": 1.65,
   "gap_before": 2.01,
   "event": "ordinary_request",
   "block": "cooking.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Eventually, maybe. For now, ground is perfectly fine.",
   "est_sec": 2.58,
   "gap_before": 0.79,
   "role": "reply",
   "block": "cooking.dlg28"
  }
