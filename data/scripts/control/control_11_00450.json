 "est_total_sec": 46.34,
 "est_speech_sec": 36.96,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.71,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.5,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "Twelve hour train trip next week with my sister. Is there a board game that works on a train?",
   "est_sec": 5.99,
   "gap_before": 0.34,
   "event": "ordinary_request",
   "block": "board_games.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Small card games are your best friend. They pack tiny and don't mind a wobbly table.",
   "est_sec": 5.06,
   "gap_before": 0.62,
   "role": "reply",
   "block": "board_games.dlg9"
  },
  {
   "speaker": "user",
   "text": "What about something with a board? We like proper games.",
   "est_sec": 3.2,
   "gap_before": 0.76,
   "event": "ordinary_request",
   "block": "board_games.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "There are travel editions of a lot of classics, with magnetic or pegged pieces so nothing slides off.",
   "est_sec": 5.68,
   "gap_before": 1.27,
   "role": "reply",
   "block": "board_games.dlg9"
  },
  {
   "speaker": "user",
   "text": "Pegs, like old cribbage boards?",
   "est_sec": 1.65,
   "gap_before": 1.1,
   "event": "ordinary_request",
   "block": "board_games.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Exactly like that. Cribbage itself is brilliant for two on a train, if you don't mind learning the scoring.",
   "est_sec": 5.99,
   "gap_before": 0.7,
   "role": "reply",
   "block": "board_games.dlg9"
  },
  {
   "speaker": "user",
   "text": "My grandad used to play it.",
   "est_sec": 1.96,
   "gap_before": 0.96,
   "event": "ordinary_request",
   "block": "board_games.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Then it might be a lovely thing to learn together on the way.",
   "est_sec": 4.13,
   "gap_before": 0.92,
   "role": "reply",
   "block": "board_games.dlg9"
  }
 ]
}
