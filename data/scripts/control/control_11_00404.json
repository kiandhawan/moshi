 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.65,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.87,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "How do I stop impulse buying at the supermarket?",
   "est_sec": 2.89,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "block": "personal_finance.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Make a list before you go and stick to it. Eating before you shop helps a surprising amount too.",
   "est_sec": 5.99,
   "gap_before": 0.93,
   "role": "reply",
   "block": "personal_finance.dlg13"
  },
  {
   "speaker": "user",
   "text": "I always end up with snacks I didn't plan.",
   "est_sec": 2.89,
   "gap_before": 0.3,
   "event": "ordinary_request",
   "block": "personal_finance.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Try shopping online for groceries. You see the total as you go, and there are no tempting displays at the checkout.",
   "est_sec": 6.61,
   "gap_before": 0.31,
   "role": "reply",
   "block": "personal_finance.dlg13"
  },
  {
   "speaker": "user",
   "text": "Online has delivery fees though.",
   "est_sec": 1.65,
   "gap_before": 1.2,
   "event": "ordinary_request",
   "block": "personal_finance.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Many shops offer free click and collect. Or compare the fee to what you spend on unplanned snacks, it might be cheaper.",
   "est_sec": 6.92,
   "gap_before": 1.65,
   "role": "reply",
   "block": "personal_finance.dlg13"
  },
  {
   "speaker": "user",
   "text": "Ha. Probably",
   "est_sec": 0.72,
   "gap_before": 1.04,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg13"
  },
  {
   "speaker": "user",
   "text": "way cheaper, honestly.",
   "est_sec": 1.03,
   "gap_before": 1.59,
   "event": "ordinary_request",
   "block": "personal_finance.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Then it might be worth a try for a month. Keep the receipts and compare.",
   "est_sec": 4.75,
   "gap_before": 0.5,
   "role": "reply",
   "block": "personal_finance.dlg13"
  }
 ]
}
