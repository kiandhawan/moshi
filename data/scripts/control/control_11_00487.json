 "est_speech_sec": 34.37,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.48,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "Yo, I'm sixteen. Is there some kind of student discount for the bus?",
   "est_sec": 4.13,
   "gap_before": 0.36,
   "event": "ordinary_request",
   "block": "public_transport.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Usually, yes. Many cities have a youth or student card that gives cheaper fares, sometimes even half price.",
   "est_sec": 5.68,
   "gap_before": 1.87,
   "role": "reply",
   "block": "public_transport.dlg22"
  },
  {
   "speaker": "user",
   "text": "How do I get one?",
   "est_sec": 1.65,
   "gap_before": 1.0,
   "event": "ordinary_request",
   "block": "public_transport.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Normally you apply online or at a ticket office with a photo and proof of age, like a passport or school ID.",
   "est_sec": 6.92,
   "gap_before": 0.36,
   "role": "reply",
   "block": "public_transport.dlg22"
  },
  {
   "speaker": "user",
   "text": "Do my parents",
   "est_sec": 1.03,
   "gap_before": 0.46,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg22"
  },
  {
   "speaker": "user",
   "text": "have to sign anything?",
   "est_sec": 1.34,
   "gap_before": 1.91,
   "event": "ordinary_request",
   "block": "public_transport.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Sometimes, if you're under a certain age. Check the form, it'll say.",
   "est_sec": 3.82,
   "gap_before": 1.15,
   "role": "reply",
   "block": "public_transport.dlg22"
  },
  {
   "speaker": "user",
   "text": "Does it work on weekends?",
   "est_sec": 1.65,
   "gap_before": 2.62,
   "event": "ordinary_request",
   "block": "public_transport.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Most do, so you can use it for going out with mates too, not just school.",
   "est_sec": 5.06,
   "gap_before": 1.67,
   "role": "reply",
   "block": "public_transport.dlg22"
  },
  {
   "speaker": "user",
   "text": "Sick, thanks.",
   "est_sec": 0.72,
   "gap_before": 1.49,
   "block": "public_transport.dlg22"
  }
 ]
}
