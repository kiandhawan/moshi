 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.53,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.92,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "So I've been asked to read a poem at my friend's wedding.",
   "est_sec": 3.82,
   "gap_before": 0.21,
   "event": "ordinary_request",
   "block": "books.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "What an honor. Do you get to choose it, or did they pick one?",
   "est_sec": 4.44,
   "gap_before": 1.28,
   "role": "reply",
   "block": "books.dlg24"
  },
  {
   "speaker": "user",
   "text": "I choose. And I'm terrified of public speaking.",
   "est_sec": 2.58,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "books.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "Then pick something short, maybe a minute long. Short love poems are often the most powerful anyway.",
   "est_sec": 5.37,
   "gap_before": 0.72,
   "role": "reply",
   "block": "books.dlg24"
  },
  {
   "speaker": "user",
   "text": "Should I memorize it?",
   "est_sec": 1.34,
   "gap_before": 1.38,
   "event": "ordinary_request",
   "block": "books.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "No need. Print it in large font on a card. Looking up now and then is plenty.",
   "est_sec": 5.37,
   "gap_before": 1.17,
   "role": "reply",
   "block": "books.dlg24"
  },
  {
   "speaker": "user",
   "text": "What if my voice shakes?",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "books.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "Read slower than feels natural and breathe at the line breaks. People are rooting for you, nobody minds a shaky voice at a wedding.",
   "est_sec": 7.54,
   "gap_before": 0.89,
   "role": "reply",
   "block": "books.dlg24"
  }
 ]
