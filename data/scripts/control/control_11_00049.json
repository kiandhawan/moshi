 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.35,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.64,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "I quit coffee three days ago and my head is killing me. Is this normal?",
   "est_sec": 4.75,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "coffee.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Very normal, sadly. Caffeine withdrawal headaches usually peak in the first couple of days and fade within about a week.",
   "est_sec": 6.3,
   "gap_before": 0.97,
   "role": "reply",
   "block": "coffee.dlg18"
  },
  {
   "speaker": "user",
   "text": "A week? I can't function like this.",
   "est_sec": 2.27,
   "gap_before": 1.09,
   "event": "ordinary_request",
   "block": "coffee.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Going cold turkey is the hardest way. Many people find it easier to cut down slowly, like half a cup less every few days.",
   "est_sec": 7.54,
   "gap_before": 0.71,
   "role": "reply",
   "block": "coffee.dlg18"
  },
  {
   "speaker": "user",
   "text": "So I could",
   "est_sec": 1.03,
   "gap_before": 0.99,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg18"
  },
  {
   "speaker": "user",
   "text": "have a small one now?",
   "est_sec": 1.65,
   "gap_before": 1.98,
   "event": "ordinary_request",
   "block": "coffee.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "You could, and it would probably ease the headache. Then taper down more gently from there.",
   "est_sec": 5.06,
   "gap_before": 1.05,
   "role": "reply",
   "block": "coffee.dlg18"
  },
  {
   "speaker": "user",
   "text": "Wait, what was the last part?",
   "est_sec": 1.96,
   "gap_before": 0.7,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_05",
   "block": "coffee.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Sure. You could, and it would probably ease the headache. Then taper down more gently from there.",
   "est_sec": 5.37,
   "gap_before": 1.04,
   "role": "reply",
   "block": "coffee.dlg18"
  },
  {
   "speaker": "user",
   "text": "Anything else that helps?",
   "est_sec": 1.34,
   "gap_before": 0.67,
   "event": "ordinary_request",
   "block": "coffee.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Drink plenty of water, get some fresh air, and try to sleep a bit more. Your energy usually comes back within a couple of weeks.",
   "est_sec": 7.85,
   "gap_before": 1.07,
   "role": "reply",
   "block": "coffee.dlg18"
  }
 ]
