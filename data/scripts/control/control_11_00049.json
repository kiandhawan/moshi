 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.36,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "Why do my photos of the moon always come out as a blurry white dot?",
   "est_sec": 4.75,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "photography.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "The moon is much brighter than the night sky, so the camera overexposes it. Lowering the exposure a lot usually brings back the detail.",
   "est_sec": 7.54,
   "gap_before": 0.83,
   "role": "reply",
   "block": "photography.dlg1"
  },
  {
   "speaker": "user",
   "text": "I'm just using my phone.",
   "est_sec": 1.65,
   "gap_before": 1.14,
   "event": "ordinary_request",
   "block": "photography.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Tap on the moon, then slide the brightness down until you see the craters. Zoom only as far as the phone's optical zoom goes.",
   "est_sec": 7.54,
   "gap_before": 0.99,
   "role": "reply",
   "block": "photography.dlg1"
  },
  {
   "speaker": "user",
   "text": "Hang on, I missed that.",
   "est_sec": 1.65,
   "gap_before": 3.08,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_04",
   "block": "photography.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Of course. Tap on the moon, then slide the brightness down until you see the craters. Zoom only as far as the phone's optical zoom goes.",
   "est_sec": 8.16,
   "gap_before": 0.38,
   "role": "reply",
   "block": "photography.dlg1"
  },
  {
   "speaker": "user",
   "text": "And it's always",
   "est_sec": 1.03,
   "gap_before": 1.23,
   "event": "distractor",
   "kind": "pause",
   "block": "photography.dlg1"
  },
  {
   "speaker": "user",
   "text": "a bit shaky too.",
   "est_sec": 1.34,
   "gap_before": 2.79,
   "event": "ordinary_request",
   "block": "photography.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Rest the phone on something solid, or use a small tripod. A two second timer stops your finger from shaking it.",
   "est_sec": 6.61,
   "gap_before": 0.84,
   "role": "reply",
   "block": "photography.dlg1"
  },
  {
   "speaker": "user",
   "text": "Cool, I'll try tonight. It's almost full.",
   "est_sec": 2.27,
   "gap_before": 1.05,
   "event": "ordinary_request",
   "block": "photography.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Perfect timing. Try shooting it right after it rises, when it looks bigger near the horizon.",
   "est_sec": 5.06,
   "gap_before": 1.06,
   "role": "reply",
   "block": "photography.dlg1"
  }
 ]
