 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.61,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.7,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "I work from bed most days. My laptop basically lives there. Is that bad for sleep?",
   "est_sec": 5.06,
   "gap_before": 0.26,
   "event": "ordinary_request",
   "block": "sleep.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "It can. Your brain starts linking the bed with work and alertness, which makes switching off harder.",
   "est_sec": 5.37,
   "gap_before": 0.7,
   "role": "reply",
   "block": "sleep.dlg29"
  },
  {
   "speaker": "user",
   "text": "My flat's tiny though. There's",
   "est_sec": 1.65,
   "gap_before": 3.04,
   "event": "distractor",
   "kind": "pause",
   "block": "sleep.dlg29"
  },
  {
   "speaker": "user",
   "text": "no desk.",
   "est_sec": 0.72,
   "gap_before": 2.59,
   "event": "ordinary_request",
   "block": "sleep.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Even a small corner works. A chair and a fold-down table at the kitchen counter is enough.",
   "est_sec": 5.37,
   "gap_before": 1.96,
   "role": "reply",
   "block": "sleep.dlg29"
  },
  {
   "speaker": "user",
   "text": "Really? Just that?",
   "est_sec": 1.03,
   "gap_before": 0.98,
   "event": "ordinary_request",
   "block": "sleep.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "It's about having a different spot. At night, the bed becomes just for sleep again.",
   "est_sec": 4.75,
   "gap_before": 1.86,
   "role": "reply",
   "block": "sleep.dlg29"
  },
  {
   "speaker": "user",
   "text": "Okay, I'll try the kitchen counter tomorrow.",
   "est_sec": 2.27,
   "gap_before": 1.45,
   "event": "ordinary_request",
   "block": "sleep.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Pack the laptop away when you finish, too. Out of sight helps.",
   "est_sec": 3.82,
   "gap_before": 0.72,
   "role": "reply",
   "block": "sleep.dlg29"
  }
 ]
}
