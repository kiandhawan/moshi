 "est_total_sec": 56.01,
 "est_speech_sec": 41.71,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.47,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.99,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "I got sunburnt yesterday and it was cloudy the whole time. How?",
   "est_sec": 3.82,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "weather_plans.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Clouds block less of the sun's rays than people think, especially thin cloud. You can still burn on a grey day.",
   "est_sec": 6.61,
   "gap_before": 0.31,
   "role": "reply",
   "block": "weather_plans.dlg7"
  },
  {
   "speaker": "user",
   "text": "Ugh. So I should check something besides the temperature?",
   "est_sec": 2.89,
   "gap_before": 3.25,
   "event": "ordinary_request",
   "block": "weather_plans.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Yes, the UV index. It's on most weather apps. Once it's at three or higher, sun protection is a good idea.",
   "est_sec": 6.61,
   "gap_before": 1.06,
   "role": "reply",
   "block": "weather_plans.dlg7"
  },
  {
   "speaker": "user",
   "text": "And how high does it go?",
   "est_sec": 1.96,
   "gap_before": 1.39,
   "event": "ordinary_request",
   "block": "weather_plans.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Around here in summer it can hit seven or eight. Near the equator or up mountains it gets much higher.",
   "est_sec": 6.3,
   "gap_before": 1.5,
   "role": "reply",
   "block": "weather_plans.dlg7"
  },
  {
   "speaker": "user",
   "text": "So I need sun cream",
   "est_sec": 1.65,
   "gap_before": 1.22,
   "event": "distractor",
   "kind": "pause",
   "block": "weather_plans.dlg7"
  },
  {
   "speaker": "user",
   "text": "even on a cloudy afternoon in the park.",
   "est_sec": 2.58,
   "gap_before": 1.76,
   "event": "ordinary_request",
   "block": "weather_plans.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "If the UV is high, yes. A hat, sunglasses and sitting in the shade at midday make a big difference too.",
   "est_sec": 6.61,
   "gap_before": 0.39,
   "role": "reply",
   "block": "weather_plans.dlg7"
  }
 ]
}
