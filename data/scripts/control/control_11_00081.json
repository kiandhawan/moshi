 "est_speech_sec": 40.99,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.44,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.34,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "I run a small farm and I need about four dry days in a row to make hay. How do I plan that?",
   "est_sec": 7.23,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "weather_plans.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Look at the longer range forecasts, and check the national weather service rather than just one app.",
   "est_sec": 5.37,
   "gap_before": 0.63,
   "role": "reply",
   "block": "weather_plans.dlg30"
  },
  {
   "speaker": "user",
   "text": "They keep changing.",
   "est_sec": 1.03,
   "gap_before": 1.27,
   "event": "ordinary_request",
   "block": "weather_plans.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Yes, forecasts over three or four days have some uncertainty. Look for a settled high pressure system building in.",
   "est_sec": 5.99,
   "gap_before": 0.94,
   "role": "reply",
   "block": "weather_plans.dlg30"
  },
  {
   "speaker": "user",
   "text": "What signs should I look for?",
   "est_sec": 1.96,
   "gap_before": 2.31,
   "event": "ordinary_request",
   "block": "weather_plans.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Rising pressure, light winds, and a few days in a row with low rain chance. Morning dew drying early is a good local sign.",
   "est_sec": 7.54,
   "gap_before": 0.3,
   "role": "reply",
   "block": "weather_plans.dlg30"
  },
  {
   "speaker": "user",
   "text": "My dad used to just sniff the air.",
   "est_sec": 2.58,
   "gap_before": 0.39,
   "event": "ordinary_request",
   "block": "weather_plans.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Plenty of old farmers had a good feel for it. Combining his instinct with the modern forecast is probably your best bet.",
   "est_sec": 6.92,
   "gap_before": 0.62,
   "role": "reply",
   "block": "weather_plans.dlg30"
  }
 ]
}
