 "est_total_sec": 52.87,
 "est_speech_sec": 41.09,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.45,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.48,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "I've been asked to DJ my cousin's house party. I've never done it.",
   "est_sec": 4.13,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "music.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Fun. You don't need fancy gear. A laptop with DJ software and a cheap controller is plenty for a house party.",
   "est_sec": 6.61,
   "gap_before": 0.49,
   "role": "reply",
   "block": "music.dlg28"
  },
  {
   "speaker": "user",
   "text": "What about the mixing part?",
   "est_sec": 1.65,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "music.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Keep it simple. Let songs play most of the way through, and fade from one to the next where it feels natural.",
   "est_sec": 6.92,
   "gap_before": 0.46,
   "role": "reply",
   "block": "music.dlg28"
  },
  {
   "speaker": "user",
   "text": "How do I",
   "est_sec": 1.03,
   "gap_before": 0.94,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg28"
  },
  {
   "speaker": "user",
   "text": "keep people dancing?",
   "est_sec": 1.03,
   "gap_before": 2.61,
   "event": "ordinary_request",
   "block": "music.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Watch the room. Start chill as people arrive, build up once the room fills, and drop the big crowd favourites when the energy peaks.",
   "est_sec": 7.54,
   "gap_before": 1.15,
   "role": "reply",
   "block": "music.dlg28"
  },
  {
   "speaker": "user",
   "text": "And requests?",
   "est_sec": 0.72,
   "gap_before": 1.38,
   "event": "ordinary_request",
   "block": "music.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Take them, but play them when they fit the mood. A slow ballad in the middle of a dance bit can empty the floor.",
   "est_sec": 7.54,
   "gap_before": 1.44,
   "role": "reply",
   "block": "music.dlg28"
  }
 ]
}
