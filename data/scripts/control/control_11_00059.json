 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.76,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.58,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "I want to start going to the farmers market on Saturday mornings. Any tips?",
   "est_sec": 4.44,
   "gap_before": 0.51,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Go early for the best choice, or late for the bargains when stalls are packing up.",
   "est_sec": 5.06,
   "gap_before": 0.39,
   "role": "reply",
   "block": "weekend_plans.dlg29"
  },
  {
   "speaker": "user",
   "text": "Oh, bargains. Late, then.",
   "est_sec": 1.34,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Fair, but some things sell out. Bring your own bags and some cash, a few stalls don't take cards.",
   "est_sec": 5.99,
   "gap_before": 0.43,
   "role": "reply",
   "block": "weekend_plans.dlg29"
  },
  {
   "speaker": "user",
   "text": "What's worth buying there?",
   "est_sec": 1.34,
   "gap_before": 0.51,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Seasonal fruit and vegetables, fresh bread and local cheese are usually the highlights.",
   "est_sec": 4.13,
   "gap_before": 1.12,
   "role": "reply",
   "block": "weekend_plans.dlg29"
  },
  {
   "speaker": "user",
   "text": "I might ask the",
   "est_sec": 1.34,
   "gap_before": 2.73,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg29"
  },
  {
   "speaker": "user",
   "text": "sellers for recipe ideas.",
   "est_sec": 1.34,
   "gap_before": 2.48,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "They love that. Most will happily tell you how they cook their own produce.",
   "est_sec": 4.44,
   "gap_before": 0.76,
   "role": "reply",
   "block": "weekend_plans.dlg29"
  }
 ]
}
