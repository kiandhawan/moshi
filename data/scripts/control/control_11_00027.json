 "est_speech_sec": 38.92,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.31,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.6,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "My save file got corrupted. Eighty hours. Gone.",
   "est_sec": 2.58,
   "gap_before": 0.36,
   "event": "ordinary_request",
   "block": "video_games.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Oh no, I'm really sorry, that's awful. Before you give up, does the game or console have cloud saves?",
   "est_sec": 5.99,
   "gap_before": 0.76,
   "role": "reply",
   "block": "video_games.dlg15"
  },
  {
   "speaker": "user",
   "text": "I don't know. I never set anything up.",
   "est_sec": 2.58,
   "gap_before": 1.38,
   "event": "ordinary_request",
   "block": "video_games.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Check the console's save data settings. Some systems back up automatically if you have an online subscription. Also check if the game keeps auto saves in separate slots.",
   "est_sec": 8.78,
   "gap_before": 0.97,
   "role": "reply",
   "block": "video_games.dlg15"
  },
  {
   "speaker": "user",
   "text": "There's an auto save from",
   "est_sec": 1.65,
   "gap_before": 1.04,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg15"
  },
  {
   "speaker": "user",
   "text": "two days ago!",
   "est_sec": 1.03,
   "gap_before": 1.56,
   "event": "ordinary_request",
   "block": "video_games.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "That's a huge relief. You'll lose a little, but not eighty hours.",
   "est_sec": 3.82,
   "gap_before": 0.38,
   "role": "reply",
   "block": "video_games.dlg15"
  },
  {
   "speaker": "user",
   "text": "How do I stop this happening again?",
   "est_sec": 2.27,
   "gap_before": 1.2,
   "event": "ordinary_request",
   "block": "video_games.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Turn on cloud backup if you can, keep a few manual saves in different slots, and avoid switching the console off while it's saving.",
   "est_sec": 7.54,
   "gap_before": 0.62,
   "role": "reply",
   "block": "video_games.dlg15"
  }
 ]
}
