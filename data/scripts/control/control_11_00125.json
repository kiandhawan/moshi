 "est_total_sec": 52.24,
 "est_speech_sec": 40.16,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.75,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.66,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "I've moved house. Do I need to update my dog's microchip?",
   "est_sec": 3.51,
   "gap_before": 0.23,
   "event": "ordinary_request",
   "block": "pets.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Yes, you do. The chip only stores a number, and the database links it to your address and phone, so those need to be current.",
   "est_sec": 7.85,
   "gap_before": 1.62,
   "role": "reply",
   "block": "pets.dlg25"
  },
  {
   "speaker": "user",
   "text": "How do I do it?",
   "est_sec": 1.65,
   "gap_before": 1.18,
   "event": "ordinary_request",
   "block": "pets.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Find which database the chip is registered with, usually on the paperwork from the breeder or rescue. Then log in or call to update.",
   "est_sec": 7.54,
   "gap_before": 0.75,
   "role": "reply",
   "block": "pets.dlg25"
  },
  {
   "speaker": "user",
   "text": "I've lost all the paperwork.",
   "est_sec": 1.65,
   "gap_before": 0.35,
   "event": "distractor",
   "kind": "pause",
   "block": "pets.dlg25"
  },
  {
   "speaker": "user",
   "text": "Of course.",
   "est_sec": 0.72,
   "gap_before": 2.06,
   "event": "ordinary_request",
   "block": "pets.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "No problem. Ask your vet to scan him. They'll get the chip number, and you can look up which database it's on.",
   "est_sec": 6.92,
   "gap_before": 1.01,
   "role": "reply",
   "block": "pets.dlg25"
  },
  {
   "speaker": "user",
   "text": "Is there a fee?",
   "est_sec": 1.34,
   "gap_before": 1.46,
   "event": "ordinary_request",
   "block": "pets.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Some databases charge a small fee for changes, some are free. Either way, it's much cheaper than losing him.",
   "est_sec": 5.99,
   "gap_before": 0.51,
   "role": "reply",
   "block": "pets.dlg25"
  }
 ]
}
