 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.54,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.82,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "How do I answer what's your biggest weakness without sounding fake?",
   "est_sec": 3.51,
   "gap_before": 0.51,
   "event": "ordinary_request",
   "block": "job_interview.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Pick something real but not central to the job. Then show what you've done to get better at it.",
   "est_sec": 5.99,
   "gap_before": 0.51,
   "role": "reply",
   "block": "job_interview.dlg1"
  },
  {
   "speaker": "user",
   "text": "Like what? Give me an example.",
   "est_sec": 1.96,
   "gap_before": 0.7,
   "event": "ordinary_request",
   "block": "job_interview.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "You could say you used to take on too much alone, so now you check in with your team earlier on big projects.",
   "est_sec": 7.23,
   "gap_before": 0.88,
   "role": "reply",
   "block": "job_interview.dlg1"
  },
  {
   "speaker": "user",
   "text": "Is saying I'm a perfectionist",
   "est_sec": 1.65,
   "gap_before": 3.3,
   "event": "distractor",
   "kind": "pause",
   "block": "job_interview.dlg1"
  },
  {
   "speaker": "user",
   "text": "a bad idea?",
   "est_sec": 1.03,
   "gap_before": 2.97,
   "event": "ordinary_request",
   "block": "job_interview.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "It usually is. Interviewers hear it constantly and it can sound like you're dodging the question.",
   "est_sec": 5.06,
   "gap_before": 0.9,
   "role": "reply",
   "block": "job_interview.dlg1"
  },
  {
   "speaker": "user",
   "text": "Okay. Mine is probably public speaking.",
   "est_sec": 1.96,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "job_interview.dlg1"
  },
  {
