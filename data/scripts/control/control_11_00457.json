 "est_total_sec": 46.02,
 "est_speech_sec": 34.17,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.45,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.93,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "Taking a ferry tomorrow and the sea's meant to be rough. I get so seasick.",
   "est_sec": 4.75,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "weather_plans.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Sorry, that's no fun. Take seasickness tablets an hour or so before boarding, they work better before symptoms start.",
   "est_sec": 5.99,
   "gap_before": 0.36,
   "role": "reply",
   "block": "weather_plans.dlg28"
  },
  {
   "speaker": "user",
   "text": "Where should I sit?",
   "est_sec": 1.34,
   "gap_before": 1.46,
   "event": "ordinary_request",
   "block": "weather_plans.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "In the middle of the boat and as low down as possible. That's where the movement is smallest.",
   "est_sec": 5.68,
   "gap_before": 0.97,
   "role": "reply",
   "block": "weather_plans.dlg28"
  },
  {
   "speaker": "user",
   "text": "Should I eat?",
   "est_sec": 1.03,
   "gap_before": 0.99,
   "event": "ordinary_request",
   "block": "weather_plans.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "A light, plain meal beforehand helps. An empty stomach can make it worse, and so can greasy food.",
   "est_sec": 5.68,
   "gap_before": 0.47,
   "role": "reply",
   "block": "weather_plans.dlg28"
  },
  {
   "speaker": "user",
   "text": "Anything else?",
   "est_sec": 0.72,
   "gap_before": 3.3,
   "event": "ordinary_request",
   "block": "weather_plans.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Look at the horizon if you can, and get some fresh air on deck. Avoid reading or staring at your phone.",
   "est_sec": 6.61,
   "gap_before": 0.84,
   "role": "reply",
   "block": "weather_plans.dlg28"
  }
 ]
}
