 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.73,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.87,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "Help, I'm melting chocolate for a ganache and it's gone thick and grainy.",
   "est_sec": 4.13,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "baking.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "It's seized. That happens when even a drop of water gets into melting chocolate.",
   "est_sec": 4.44,
   "gap_before": 1.22,
   "role": "reply",
   "block": "baking.dlg25"
  },
  {
   "speaker": "user",
   "text": "Can I save it?",
   "est_sec": 1.34,
   "gap_before": 0.73,
   "event": "ordinary_request",
   "block": "baking.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "For ganache, yes. Stir in a spoonful of hot cream at a time, it often smooths out again.",
   "est_sec": 5.68,
   "gap_before": 1.78,
   "role": "reply",
   "block": "baking.dlg25"
  },
  {
   "speaker": "user",
   "text": "Oh, it's",
   "est_sec": 0.72,
   "gap_before": 0.51,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg25"
  },
  {
   "speaker": "user",
   "text": "coming back. Kind of.",
   "est_sec": 1.34,
   "gap_before": 1.76,
   "event": "ordinary_request",
   "block": "baking.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Keep going slowly. Since you're making ganache anyway, the extra cream won't hurt.",
   "est_sec": 4.13,
   "gap_before": 0.45,
   "role": "reply",
   "block": "baking.dlg25"
  },
  {
   "speaker": "user",
   "text": "Phew. How do I stop this next time?",
   "est_sec": 2.58,
   "gap_before": 0.76,
   "event": "ordinary_request",
   "block": "baking.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Use a dry bowl and spoon, and if you melt it over a pan, keep the steam away from the bowl.",
   "est_sec": 6.61,
   "gap_before": 0.55,
   "role": "reply",
   "block": "baking.dlg25"
  }
 ]
}
