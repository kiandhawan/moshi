 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.54,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "Our stainless steel fridge is covered in fingerprints. Three kids, you can imagine.",
   "est_sec": 4.13,
   "gap_before": 0.24,
   "event": "ordinary_request",
   "block": "cleaning.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "I can. A microfibre cloth with a little warm water wipes most of it. Go with the grain of the steel, not in circles.",
   "est_sec": 7.54,
   "gap_before": 0.51,
   "role": "reply",
   "block": "cleaning.dlg21"
  },
  {
   "speaker": "user",
   "text": "There's a grain?",
   "est_sec": 1.03,
   "gap_before": 1.04,
   "event": "ordinary_request",
   "block": "cleaning.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Look closely, there are faint lines running one direction. Wipe along them and it won't streak.",
   "est_sec": 5.06,
   "gap_before": 0.68,
   "role": "reply",
   "block": "cleaning.dlg21"
  },
  {
   "speaker": "user",
   "text": "Oh yeah. Vertical. I've been doing circles",
   "est_sec": 2.27,
   "gap_before": 1.49,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg21"
  },
  {
   "speaker": "user",
   "text": "for years.",
   "est_sec": 0.72,
   "gap_before": 1.82,
   "event": "ordinary_request",
   "block": "cleaning.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Then a drop of olive oil on a dry cloth afterwards gives it a shine and makes the next prints easier to wipe.",
   "est_sec": 7.23,
   "gap_before": 0.88,
   "role": "reply",
   "block": "cleaning.dlg21"
  },
  {
   "speaker": "user",
   "text": "Olive oil on my fridge. Okay.",
   "est_sec": 1.96,
   "gap_before": 1.07,
   "event": "ordinary_request",
   "block": "cleaning.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Just a tiny bit. Too much and it'll attract more fingers.",
   "est_sec": 3.51,
   "gap_before": 0.81,
   "role": "reply",
   "block": "cleaning.dlg21"
  }
 ]
}
