 "est_total_sec": 58.02,
 "est_speech_sec": 40.88,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.71,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.72,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "Okay, projector's out of the box. Now what?",
   "est_sec": 2.58,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "movies.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Exciting. First, find a blank light wall or a screen, and set the projector straight in front of it at the right distance.",
   "est_sec": 7.23,
   "gap_before": 1.07,
   "role": "reply",
   "block": "movies.dlg19"
  },
  {
   "speaker": "user",
   "text": "How far back?",
   "est_sec": 1.03,
   "gap_before": 1.06,
   "event": "ordinary_request",
   "block": "movies.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Check the manual for its throw ratio, but for a big living room picture, usually two to three metres works.",
   "est_sec": 6.3,
   "gap_before": 0.59,
   "role": "reply",
   "block": "movies.dlg19"
  },
  {
   "speaker": "user",
   "text": "The picture's kind of",
   "est_sec": 1.34,
   "gap_before": 1.97,
   "event": "distractor",
   "kind": "pause",
   "block": "movies.dlg19"
  },
  {
   "speaker": "user",
   "text": "slanted at the top.",
   "est_sec": 1.34,
   "gap_before": 2.49,
   "event": "ordinary_request",
   "block": "movies.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "That's the keystone. Ideally raise the projector to the middle of the screen height instead of tilting it. Use keystone correction only if you have to.",
   "est_sec": 8.16,
   "gap_before": 1.12,
   "role": "reply",
   "block": "movies.dlg19"
  },
  {
   "speaker": "user",
   "text": "And it looks washed out.",
   "est_sec": 1.65,
   "gap_before": 2.34,
   "event": "ordinary_request",
   "block": "movies.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Darken the room as much as you can. Projectors hate daylight. Even closing the curtains makes a huge difference.",
   "est_sec": 5.99,
   "gap_before": 0.76,
   "role": "reply",
   "block": "movies.dlg19"
  },
  {
   "speaker": "user",
   "text": "Perfect, it's looking way better already.",
   "est_sec": 1.96,
   "gap_before": 2.36,
   "block": "movies.dlg19"
  }
 ]
}
