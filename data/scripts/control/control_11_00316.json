 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.56,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.56,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "My team plays at home on Saturday afternoon and my girlfriend's coming for the first time. She's not into football.",
   "est_sec": 6.3,
   "gap_before": 0.2,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Then make the day about more than the match. A nice lunch near the ground first, and explain a few basics on the way.",
   "est_sec": 7.54,
   "gap_before": 0.46,
   "role": "reply",
   "block": "weekend_plans.dlg27"
  },
  {
   "speaker": "user",
   "text": "Like what?",
   "est_sec": 0.72,
   "gap_before": 0.67,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Who the big players are, what the rivalry is, and why this game matters. A story makes it fun to watch.",
   "est_sec": 6.61,
   "gap_before": 1.26,
   "role": "reply",
   "block": "weekend_plans.dlg27"
  },
  {
   "speaker": "user",
   "text": "She'll probably",
   "est_sec": 0.72,
   "gap_before": 1.23,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg27"
  },
  {
   "speaker": "user",
   "text": "be cold.",
   "est_sec": 0.72,
   "gap_before": 1.55,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Take blankets or spare layers, and grab hot drinks at half time.",
   "est_sec": 3.82,
   "gap_before": 0.56,
   "role": "reply",
   "block": "weekend_plans.dlg27"
  },
  {
   "speaker": "user",
   "text": "And after?",
   "est_sec": 0.72,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Somewhere cosy for dinner, whatever the score. That way she'll remember the day fondly, even if you lose.",
   "est_sec": 5.68,
   "gap_before": 0.66,
   "role": "reply",
   "block": "weekend_plans.dlg27"
  }
 ]
}
