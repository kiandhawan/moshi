 "est_total_sec": 52.79,
 "est_speech_sec": 37.68,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.44,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.86,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "My baby's high chair is crusted with porridge. It sets like cement.",
   "est_sec": 3.82,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "cleaning.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Porridge is the worst. Soak the tray in hot soapy water for ten minutes, it softens right up.",
   "est_sec": 5.68,
   "gap_before": 1.97,
   "role": "reply",
   "block": "cleaning.dlg30"
  },
  {
   "speaker": "user",
   "text": "The straps are gross too.",
   "est_sec": 1.65,
   "gap_before": 3.25,
   "event": "ordinary_request",
   "block": "cleaning.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Most straps unclip. Wash them in a mesh bag on a gentle cycle, or by hand in the sink.",
   "est_sec": 5.99,
   "gap_before": 0.66,
   "role": "reply",
   "block": "cleaning.dlg30"
  },
  {
   "speaker": "user",
   "text": "And the little gaps where food",
   "est_sec": 1.96,
   "gap_before": 1.17,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg30"
  },
  {
   "speaker": "user",
   "text": "gets stuck?",
   "est_sec": 0.72,
   "gap_before": 1.68,
   "event": "ordinary_request",
   "block": "cleaning.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "An old toothbrush or a cotton bud gets into those. Then wipe everything with a damp cloth and let it dry fully.",
   "est_sec": 6.92,
   "gap_before": 1.09,
   "role": "reply",
   "block": "cleaning.dlg30"
  },
  {
   "speaker": "user",
   "text": "Thank you. She throws half her breakfast, so this'll happen daily.",
   "est_sec": 3.51,
   "gap_before": 1.08,
   "event": "ordinary_request",
   "block": "cleaning.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Then a quick wipe right after each meal saves you this whole job later.",
   "est_sec": 4.44,
   "gap_before": 0.92,
   "role": "reply",
   "block": "cleaning.dlg30"
  }
 ]
}
