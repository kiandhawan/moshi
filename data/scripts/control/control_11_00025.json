 "est_total_sec": 50.02,
 "est_speech_sec": 40.47,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.3,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "I'm running a half marathon on Sunday and it'll probably be wet and cold.",
   "est_sec": 4.44,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "weather_plans.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Okay, layers again. A light, thin rain jacket you can tie around your waist, plus a cap to keep rain out of your eyes.",
   "est_sec": 7.54,
   "gap_before": 0.55,
   "role": "reply",
   "block": "weather_plans.dlg29"
  },
  {
   "speaker": "user",
   "text": "A cap? I never run in one.",
   "est_sec": 2.27,
   "gap_before": 0.9,
   "event": "ordinary_request",
   "block": "weather_plans.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "In the rain it's a game changer. Try it on a short run first.",
   "est_sec": 4.44,
   "gap_before": 1.62,
   "role": "reply",
   "block": "weather_plans.dlg29"
  },
  {
   "speaker": "user",
   "text": "What about chafing? It's worse when wet.",
   "est_sec": 2.27,
   "gap_before": 0.87,
   "event": "ordinary_request",
   "block": "weather_plans.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Use plenty of anti chafe balm in all the usual spots before you set off. Taping nipples helps a lot too.",
   "est_sec": 6.61,
   "gap_before": 0.41,
   "role": "reply",
   "block": "weather_plans.dlg29"
  },
  {
   "speaker": "user",
   "text": "And at the start,",
   "est_sec": 1.34,
   "gap_before": 0.61,
   "event": "distractor",
   "kind": "pause",
   "block": "weather_plans.dlg29"
  },
  {
   "speaker": "user",
   "text": "while we're waiting?",
   "est_sec": 1.03,
   "gap_before": 1.65,
   "event": "ordinary_request",
   "block": "weather_plans.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Wear a bin bag with holes for your head and arms, then throw it away when you start. Very glamorous, very effective.",
   "est_sec": 6.92,
   "gap_before": 0.4,
   "role": "reply",
   "block": "weather_plans.dlg29"
  }
 ]
}
