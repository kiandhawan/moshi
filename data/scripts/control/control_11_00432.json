 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.72,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.44,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "Can you do a quick mock interview with me? Just one question.",
   "est_sec": 3.82,
   "gap_before": 0.26,
   "event": "ordinary_request",
   "block": "job_interview.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Sure. Tell me about a time you made a mistake at work, and what you did about it.",
   "est_sec": 5.68,
   "gap_before": 1.18,
   "role": "reply",
   "block": "job_interview.dlg27"
  },
  {
   "speaker": "user",
   "text": "Um, okay. Once I sent an invoice to the wrong client, and",
   "est_sec": 3.82,
   "gap_before": 0.69,
   "event": "distractor",
   "kind": "pause",
   "block": "job_interview.dlg27"
  },
  {
   "speaker": "user",
   "text": "I didn't notice until they emailed me.",
   "est_sec": 2.27,
   "gap_before": 2.32,
   "event": "ordinary_request",
   "block": "job_interview.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Go on, what happened next?",
   "est_sec": 1.65,
   "gap_before": 0.75,
   "role": "reply",
   "block": "job_interview.dlg27"
  },
  {
   "speaker": "user",
   "text": "I apologised, sent the right one, and set up a checklist so it wouldn't happen again.",
   "est_sec": 5.06,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "job_interview.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "That's a solid answer. The checklist is the best part, so say it with a bit more confidence.",
   "est_sec": 5.68,
   "gap_before": 0.38,
   "role": "reply",
   "block": "job_interview.dlg27"
  },
  {
   "speaker": "user",
   "text": "Should I say how the client reacted?",
   "est_sec": 2.27,
   "gap_before": 0.9,
   "event": "ordinary_request",
   "block": "job_interview.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Yes, if it ended well. Something like, they appreciated the quick fix, rounds it off nicely.",
   "est_sec": 5.06,
   "gap_before": 0.68,
   "role": "reply",
   "block": "job_interview.dlg27"
  }
 ]
}
