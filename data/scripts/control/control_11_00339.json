 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.62,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "My garden is drowning in cucumbers. Can I pickle them without canning equipment?",
   "est_sec": 4.13,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "cooking.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Yes, fridge pickles are easy. You just need jars, vinegar, water, salt, a little sugar and some dill.",
   "est_sec": 5.68,
   "gap_before": 1.07,
   "role": "reply",
   "block": "cooking.dlg25"
  },
  {
   "speaker": "user",
   "text": "What ratio?",
   "est_sec": 0.72,
   "gap_before": 1.18,
   "event": "ordinary_request",
   "block": "cooking.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Equal parts vinegar and water, with about a tablespoon of salt and a teaspoon of sugar per cup of liquid.",
   "est_sec": 6.3,
   "gap_before": 0.93,
   "role": "reply",
   "block": "cooking.dlg25"
  },
  {
   "speaker": "user",
   "text": "Hot or cold?",
   "est_sec": 1.03,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "cooking.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Heat the liquid just until the salt dissolves, then pour it over the sliced cucumbers in the jars.",
   "est_sec": 5.68,
   "gap_before": 0.6,
   "role": "reply",
   "block": "cooking.dlg25"
  },
  {
   "speaker": "user",
   "text": "And how long until they're ready?",
   "est_sec": 1.96,
   "gap_before": 1.28,
   "event": "ordinary_request",
   "block": "cooking.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "They're tasty after a day, and best after three or four. Keep them in the fridge and eat them within a month.",
   "est_sec": 6.92,
   "gap_before": 1.03,
   "role": "reply",
   "block": "cooking.dlg25"
  },
  {
   "speaker": "user",
   "text": "A month, that's fine. We go through",
   "est_sec": 2.27,
   "gap_before": 1.83,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg25"
  },
  {
   "speaker": "user",
   "text": "a ridiculous amount of pickles.",
   "est_sec": 1.65,
   "gap_before": 2.17,
   "event": "ordinary_request",
   "block": "cooking.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Then make a few jars with garlic or chili flakes too, for some variety.",
   "est_sec": 4.44,
   "gap_before": 0.56,
   "role": "reply",
   "block": "cooking.dlg25"
  }
 ]
}
