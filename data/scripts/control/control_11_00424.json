 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.41,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.84,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "Why does bread get big and puffy? My dad says there are tiny animals in it.",
   "est_sec": 5.06,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "baking.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Your dad's kind of right! Yeast is a tiny living thing, too small to see. It eats the sugar in the dough.",
   "est_sec": 6.92,
   "gap_before": 0.48,
   "role": "reply",
   "block": "baking.dlg17"
  },
  {
   "speaker": "user",
   "text": "Ew. Then what?",
   "est_sec": 1.03,
   "gap_before": 1.44,
   "event": "ordinary_request",
   "block": "baking.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "When it eats, it burps out little bubbles of gas. The dough is stretchy, so it traps the bubbles and puffs up like a balloon.",
   "est_sec": 7.85,
   "gap_before": 1.83,
   "role": "reply",
   "block": "baking.dlg17"
  },
  {
   "speaker": "user",
   "text": "Bread burps! Does it",
   "est_sec": 1.34,
   "gap_before": 1.45,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg17"
  },
  {
   "speaker": "user",
   "text": "hurt the yeast when it goes in the oven?",
   "est_sec": 2.89,
   "gap_before": 1.55,
   "event": "ordinary_request",
   "block": "baking.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "The oven heat makes the yeast stop working. That's what sets the bubbles in place, so the bread stays fluffy.",
   "est_sec": 6.3,
   "gap_before": 0.87,
   "role": "reply",
   "block": "baking.dlg17"
  },
  {
   "speaker": "user",
   "text": "Can we make bread today?",
   "est_sec": 1.65,
   "gap_before": 0.85,
   "event": "ordinary_request",
   "block": "baking.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Ask your dad! You could be in charge of the kneading, it's like squishing playdough.",
   "est_sec": 4.75,
   "gap_before": 0.62,
   "role": "reply",
   "block": "baking.dlg17"
  }
 ]
}
