 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.79,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.37,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "My lawn has yellow patches all over. What's going on?",
   "est_sec": 3.2,
   "gap_before": 0.36,
   "event": "ordinary_request",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Common causes are dry weather, dog pee or grubs in the soil. Do you have a dog?",
   "est_sec": 5.37,
   "gap_before": 0.75,
   "role": "reply",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "user",
   "text": "Yeah, a big one.",
   "est_sec": 1.34,
   "gap_before": 2.95,
   "event": "ordinary_request",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "That's likely it then. Watering the spot right after the dog goes can dilute it and stop the burn.",
   "est_sec": 5.99,
   "gap_before": 1.08,
   "role": "reply",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "user",
   "text": "Hold on a sec, I can't follow him around with a watering can all day.",
   "est_sec": 4.75,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_17",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Fair. You could train him to use one corner of the garden, or reseed the patches in spring.",
   "est_sec": 5.68,
   "gap_before": 1.19,
   "role": "reply",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "user",
   "text": "Reseeding sounds easier. Do I just",
   "est_sec": 1.96,
   "gap_before": 0.58,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "user",
   "text": "throw seeds on top?",
   "est_sec": 1.34,
   "gap_before": 2.98,
   "event": "ordinary_request",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Rake the patch first to loosen the soil, then sprinkle the seed and keep it moist for two weeks.",
   "est_sec": 5.99,
   "gap_before": 0.65,
   "role": "reply",
   "block": "gardening.dlg4"
  }
 ]
}
