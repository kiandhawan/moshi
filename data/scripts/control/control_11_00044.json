 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.43,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.64,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "We have a baby due in two months and a very spoiled dog. How do we prepare him?",
   "est_sec": 5.68,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "pets.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Good thinking to start now. Begin making small changes, like where he sleeps or which rooms he's allowed in, before the baby arrives.",
   "est_sec": 7.23,
   "gap_before": 1.97,
   "role": "reply",
   "block": "pets.dlg17"
  },
  {
   "speaker": "user",
   "text": "He sleeps on our bed.",
   "est_sec": 1.65,
   "gap_before": 0.63,
   "event": "ordinary_request",
   "block": "pets.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "If that'll change, change it now, so he doesn't connect losing his spot with the baby.",
   "est_sec": 5.06,
   "gap_before": 0.94,
   "role": "reply",
   "block": "pets.dlg17"
  },
  {
   "speaker": "user",
   "text": "That's a good point.",
   "est_sec": 1.34,
   "gap_before": 1.07,
   "event": "ordinary_request",
   "block": "pets.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "You can also play recordings of baby crying at a low volume while giving him treats, so the sound becomes normal.",
   "est_sec": 6.61,
   "gap_before": 0.39,
   "role": "reply",
   "block": "pets.dlg17"
  },
  {
   "speaker": "user",
   "text": "And when we bring her home?",
   "est_sec": 1.96,
   "gap_before": 2.59,
   "event": "ordinary_request",
   "block": "pets.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Let him sniff a blanket she's used first. Then let him meet her calmly with you holding her, and never leave them alone together.",
   "est_sec": 7.54,
   "gap_before": 0.6,
   "role": "reply",
   "block": "pets.dlg17"
  }
 ]
