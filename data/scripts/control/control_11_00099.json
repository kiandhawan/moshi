 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "Is the Japan rail pass still worth it? I heard the price went up.",
   "est_sec": 4.44,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "travel_planning.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "It did go up quite a lot. It's worth it now mainly if you're doing several long bullet train trips in a short time.",
   "est_sec": 7.54,
   "gap_before": 0.82,
   "role": "reply",
   "block": "travel_planning.dlg11"
  },
  {
   "speaker": "user",
   "text": "We're doing Tokyo, Kyoto, Hiroshima and back to Tokyo in ten days.",
   "est_sec": 3.82,
   "gap_before": 0.81,
   "event": "ordinary_request",
   "block": "travel_planning.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "That's a fair amount of long distance travel. Add up the single fares for those trips and compare it with the pass price.",
   "est_sec": 7.23,
   "gap_before": 1.5,
   "role": "reply",
   "block": "travel_planning.dlg11"
  },
  {
   "speaker": "user",
   "text": "Ugh, that's work.",
   "est_sec": 1.03,
   "gap_before": 2.7,
   "event": "ordinary_request",
   "block": "travel_planning.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "A bit, but there are online fare calculators that do it quickly. Sometimes a regional pass is cheaper too.",
   "est_sec": 5.99,
   "gap_before": 0.49,
   "role": "reply",
   "block": "travel_planning.dlg11"
  },
  {
   "speaker": "user",
   "text": "Fine. If it's close, I'll",
   "est_sec": 1.65,
   "gap_before": 0.6,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg11"
  },
  {
   "speaker": "user",
   "text": "just get the pass for the convenience.",
   "est_sec": 2.27,
   "gap_before": 2.86,
   "event": "ordinary_request",
   "block": "travel_planning.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "That's a reasonable call. It also saves you buying tickets every time.",
   "est_sec": 3.82,
   "gap_before": 0.79,
   "role": "reply",
   "block": "travel_planning.dlg11"
  }
 ]
}
