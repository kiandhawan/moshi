   "gap_before": 0.61,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg10"
  },
  {
   "speaker": "user",
   "text": "really don't want to.",
   "est_sec": 1.34,
   "gap_before": 2.35,
   "event": "ordinary_request",
   "block": "music.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "See how it is on Thursday. If talking still hurts, a doctor's opinion is worth it. Pushing through a sore throat can cause real damage.",
   "est_sec": 7.85,
   "gap_before": 1.02,
   "role": "reply",
   "block": "music.dlg10"
  },
  {
   "speaker": "user",
   "text": "And if it's better?",
   "est_sec": 1.34,
   "gap_before": 0.76,
   "event": "ordinary_request",
   "block": "music.dlg10"
  },
  {
   "speaker": "moshi",
