 "est_total_sec": 50.86,
 "est_speech_sec": 38.92,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.58,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "My niece is vegan and I'd love to make her brownies. Is that even possible without eggs?",
   "est_sec": 5.37,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "baking.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Absolutely. A flax egg works well in brownies. Mix one tablespoon of ground flaxseed with three of water and let it go gloopy for ten minutes.",
   "est_sec": 8.16,
   "gap_before": 1.52,
   "role": "reply",
   "block": "baking.dlg10"
  },
  {
   "speaker": "user",
   "text": "Gloopy. Lovely. And the butter?",
   "est_sec": 1.65,
   "gap_before": 0.74,
   "event": "ordinary_request",
   "block": "baking.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Use a good vegan block butter or a neutral oil. Oil actually makes brownies extra fudgy.",
   "est_sec": 5.06,
   "gap_before": 0.82,
   "role": "reply",
   "block": "baking.dlg10"
  },
  {
   "speaker": "user",
   "text": "What about the chocolate? I'm not sure",
   "est_sec": 2.27,
   "gap_before": 0.54,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg10"
  },
  {
   "speaker": "user",
   "text": "which kinds are vegan.",
   "est_sec": 1.34,
   "gap_before": 2.14,
   "event": "ordinary_request",
   "block": "baking.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Most plain dark chocolate is, but check the label for milk powder. Cocoa powder is always fine.",
   "est_sec": 5.37,
   "gap_before": 1.32,
   "role": "reply",
   "block": "baking.dlg10"
  },
  {
   "speaker": "user",
   "text": "She'll be so surprised.",
   "est_sec": 1.34,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "baking.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "That's a lovely thing to do for her. Underbake them slightly, they firm up as they cool.",
   "est_sec": 5.37,
   "gap_before": 0.99,
   "role": "reply",
   "block": "baking.dlg10"
  }
 ]
}
