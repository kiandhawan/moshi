 "est_total_sec": 51.96,
 "est_speech_sec": 40.16,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.41,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.83,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "I'm retired now and finally have time to fix up the deck. Where do I even begin?",
   "est_sec": 5.37,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "home_repair.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Start with a good look for loose boards, popped nails and soft spots. Soft wood means rot and should be replaced first.",
   "est_sec": 6.92,
   "gap_before": 1.92,
   "role": "reply",
   "block": "home_repair.dlg2"
  },
  {
   "speaker": "user",
   "text": "There are a few soft boards near the steps, yes.",
   "est_sec": 3.2,
   "gap_before": 1.03,
   "event": "ordinary_request",
   "block": "home_repair.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Replace those, then give the whole deck a scrub with a deck cleaner and let it dry for a couple of days.",
   "est_sec": 6.92,
   "gap_before": 0.52,
   "role": "reply",
   "block": "home_repair.dlg2"
  },
  {
   "speaker": "user",
   "text": "Then stain it?",
   "est_sec": 1.03,
   "gap_before": 0.87,
   "event": "ordinary_request",
   "block": "home_repair.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Pick a dry stretch of weather and apply a thin, even coat. Two thin coats beat one thick one.",
   "est_sec": 6.3,
   "gap_before": 1.15,
   "role": "reply",
   "block": "home_repair.dlg2"
  },
  {
   "speaker": "user",
   "text": "I was going to do it all",
   "est_sec": 2.27,
   "gap_before": 0.65,
   "event": "distractor",
   "kind": "pause",
   "block": "home_repair.dlg2"
  },
  {
   "speaker": "user",
   "text": "well, maybe over two weekends instead.",
   "est_sec": 1.96,
   "gap_before": 1.64,
   "event": "ordinary_request",
   "block": "home_repair.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "That's a sensible pace. Repairs and cleaning one weekend, staining the next.",
   "est_sec": 3.82,
   "gap_before": 0.91,
   "role": "reply",
   "block": "home_repair.dlg2"
  }
 ]
}
