 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.33,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.77,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "Dinner party tomorrow, ten people. I need background music that isn't awkward.",
   "est_sec": 3.82,
   "gap_before": 0.22,
   "event": "ordinary_request",
   "block": "music.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Aim for something warm and mostly instrumental, so it doesn't compete with conversation. Soul, bossa nova or mellow jazz usually works.",
   "est_sec": 6.61,
   "gap_before": 0.35,
   "role": "reply",
   "block": "music.dlg17"
  },
  {
   "speaker": "user",
   "text": "No lyrics at all?",
   "est_sec": 1.34,
   "gap_before": 0.69,
   "event": "ordinary_request",
   "block": "music.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Some lyrics are fine, just avoid anything everyone knows the words to, or people start singing instead of talking.",
   "est_sec": 5.99,
   "gap_before": 0.66,
   "role": "reply",
   "block": "music.dlg17"
  },
  {
   "speaker": "user",
   "text": "Ha, that has happened before. How",
   "est_sec": 1.96,
   "gap_before": 0.43,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg17"
  },
  {
   "speaker": "user",
   "text": "long should the playlist be?",
   "est_sec": 1.65,
   "gap_before": 2.19,
   "event": "ordinary_request",
   "block": "music.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Around three or four hours, so it never loops. Repeating songs at a dinner party is surprisingly noticeable.",
   "est_sec": 5.68,
   "gap_before": 0.82,
   "role": "reply",
   "block": "music.dlg17"
  },
  {
   "speaker": "user",
   "text": "And volume?",
   "est_sec": 0.72,
   "gap_before": 0.73,
   "event": "ordinary_request",
   "block": "music.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Low enough that nobody needs to raise their voice. You can turn it up a bit once dessert is over.",
   "est_sec": 6.3,
   "gap_before": 1.93,
   "role": "reply",
   "block": "music.dlg17"
  }
 ]
}
