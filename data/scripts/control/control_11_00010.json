 "est_total_sec": 52.65,
 "est_speech_sec": 38.61,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.8,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.6,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "I get really anxious on Sunday afternoons. Like a heavy feeling.",
   "est_sec": 3.51,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "You're far from alone in that. Many people call it the Sunday scaries. Is it about work or something else?",
   "est_sec": 6.3,
   "gap_before": 0.37,
   "role": "reply",
   "block": "weekend_plans.dlg28"
  },
  {
   "speaker": "user",
   "text": "Work mostly. Monday mornings are chaos.",
   "est_sec": 1.96,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "It might help to spend fifteen minutes on Friday writing down what's coming next week. Then you're not carrying it all weekend.",
   "est_sec": 6.92,
   "gap_before": 0.86,
   "role": "reply",
   "block": "weekend_plans.dlg28"
  },
  {
   "speaker": "user",
   "text": "On Friday, not Sunday?",
   "est_sec": 1.34,
   "gap_before": 3.2,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Yes, so Sunday stays yours. Then plan something nice on Sunday afternoon, like a walk or seeing a friend.",
   "est_sec": 5.99,
   "gap_before": 1.05,
   "role": "reply",
   "block": "weekend_plans.dlg28"
  },
  {
   "speaker": "user",
   "text": "I usually just",
   "est_sec": 1.03,
   "gap_before": 1.23,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg28"
  },
  {
   "speaker": "user",
   "text": "sit at home and dread it.",
   "est_sec": 1.96,
   "gap_before": 2.96,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Getting out, even for an hour, can break that feeling. And go easy on yourself, it's a very normal reaction.",
   "est_sec": 6.3,
   "gap_before": 0.42,
   "role": "reply",
   "block": "weekend_plans.dlg28"
  }
 ]
}
