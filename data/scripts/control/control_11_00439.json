 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.8,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.31,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "Is it safe to hike alone?",
   "est_sec": 1.96,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "hiking.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "It can be, with some precautions. Pick a well used trail, and always tell someone where you're going and when you'll be back.",
   "est_sec": 7.23,
   "gap_before": 0.48,
   "role": "reply",
   "block": "hiking.dlg3"
  },
  {
   "speaker": "user",
   "text": "What if I get lost?",
   "est_sec": 1.65,
   "gap_before": 1.99,
   "event": "ordinary_request",
   "block": "hiking.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Download an offline map before you go and carry a small battery pack for your phone. If you're unsure, stay where you are and call for help.",
   "est_sec": 8.47,
   "gap_before": 0.64,
   "role": "reply",
   "block": "hiking.dlg3"
  },
  {
   "speaker": "user",
   "text": "I'm retired, so I can go on weekdays when it's",
   "est_sec": 3.2,
   "gap_before": 0.7,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg3"
  },
  {
   "speaker": "user",
   "text": "really quiet.",
   "est_sec": 0.72,
   "gap_before": 2.71,
   "event": "ordinary_request",
   "block": "hiking.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "That's lovely, but quieter trails mean fewer people to help. Stick to routes you know until you're confident.",
   "est_sec": 5.68,
   "gap_before": 0.54,
   "role": "reply",
   "block": "hiking.dlg3"
  },
  {
   "speaker": "user",
   "text": "Good point. Maybe I'll join a walking group too.",
   "est_sec": 2.89,
   "gap_before": 0.91,
   "event": "ordinary_request",
   "block": "hiking.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "That's a great idea. Many groups do weekday hikes, and you'll learn new trails from them.",
   "est_sec": 5.06,
   "gap_before": 1.03,
   "role": "reply",
   "block": "hiking.dlg3"
  }
 ]
}
