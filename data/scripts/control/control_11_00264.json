 "est_total_sec": 57.23,
 "est_speech_sec": 44.7,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.35,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.46,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "My flight got overbooked and they want volunteers to take a later one. Should I do it?",
   "est_sec": 5.37,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "travel_planning.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "It depends on your plans. If you're flexible, you can often get a voucher or cash for it.",
   "est_sec": 5.68,
   "gap_before": 1.07,
   "role": "reply",
   "block": "travel_planning.dlg27"
  },
  {
   "speaker": "user",
   "text": "What should I ask for?",
   "est_sec": 1.65,
   "gap_before": 0.81,
   "event": "ordinary_request",
   "block": "travel_planning.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Ask what the compensation is, when the new flight leaves, and whether they'll cover meals or a hotel if it's the next day.",
   "est_sec": 7.23,
   "gap_before": 0.59,
   "role": "reply",
   "block": "travel_planning.dlg27"
  },
  {
   "speaker": "user",
   "text": "Can I negotiate?",
   "est_sec": 1.03,
   "gap_before": 1.18,
   "event": "ordinary_request",
   "block": "travel_planning.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Sometimes. If nobody volunteers, the offer often goes up, so you don't have to accept the first one.",
   "est_sec": 5.68,
   "gap_before": 1.07,
   "role": "reply",
   "block": "travel_planning.dlg27"
  },
  {
   "speaker": "user",
   "text": "It's only a four hour wait",
   "est_sec": 1.96,
   "gap_before": 1.21,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg27"
  },
  {
   "speaker": "user",
   "text": "so I'm tempted.",
   "est_sec": 1.03,
   "gap_before": 1.76,
   "event": "ordinary_request",
   "block": "travel_planning.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Then it could be a good deal. Make sure your new seat is confirmed before you give up your current one.",
   "est_sec": 6.61,
   "gap_before": 0.92,
   "role": "reply",
   "block": "travel_planning.dlg27"
  },
  {
   "speaker": "user",
   "text": "Smart. Going to the desk now.",
   "est_sec": 1.96,
   "gap_before": 0.36,
   "event": "ordinary_request",
   "block": "travel_planning.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Good luck. Ask for a lounge pass too while you're there.",
   "est_sec": 3.51,
   "gap_before": 0.88,
   "role": "reply",
   "block": "travel_planning.dlg27"
  }
 ]
}
