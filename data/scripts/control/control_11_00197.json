 "est_total_sec": 56.39,
 "est_speech_sec": 41.4,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.31,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.4,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "Candle wax dripped all over my linen tablecloth during dinner. Is it ruined?",
   "est_sec": 4.13,
   "gap_before": 0.27,
   "event": "ordinary_request",
   "block": "cleaning.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Not at all. Let it harden first, then scrape off as much as you can with a blunt knife.",
   "est_sec": 5.99,
   "gap_before": 0.75,
   "role": "reply",
   "block": "cleaning.dlg5"
  },
  {
   "speaker": "user",
   "text": "Okay, done. There's still a waxy patch.",
   "est_sec": 2.27,
   "gap_before": 3.41,
   "event": "ordinary_request",
   "block": "cleaning.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Put a paper bag over it and press with a warm iron. The paper soaks up the melted wax.",
   "est_sec": 5.99,
   "gap_before": 0.83,
   "role": "reply",
   "block": "cleaning.dlg5"
  },
  {
   "speaker": "user",
   "text": "Oh, it's working! The bag's getting",
   "est_sec": 1.96,
   "gap_before": 1.36,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg5"
  },
  {
   "speaker": "user",
   "text": "all greasy.",
   "est_sec": 0.72,
   "gap_before": 2.71,
   "event": "ordinary_request",
   "block": "cleaning.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Move to a clean part of the bag and repeat until nothing more comes up. If there's colour from the candle left, a stain remover before washing usually gets it.",
   "est_sec": 9.4,
   "gap_before": 0.76,
   "role": "reply",
   "block": "cleaning.dlg5"
  },
  {
   "speaker": "user",
   "text": "It was a red candle, of course.",
   "est_sec": 2.27,
   "gap_before": 2.36,
   "event": "ordinary_request",
   "block": "cleaning.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Of course it was. Treat it before it goes in the wash, and skip the dryer until it's gone.",
   "est_sec": 5.99,
   "gap_before": 0.33,
   "role": "reply",
   "block": "cleaning.dlg5"
  }
 ]
}
