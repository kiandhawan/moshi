 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.71,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.54,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "My lower back aches when I wake up. Could it be how I'm sleeping?",
   "est_sec": 4.44,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "sleep.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Quite possibly. Do you sleep on your back, side, or stomach?",
   "est_sec": 3.51,
   "gap_before": 0.54,
   "role": "reply",
   "block": "sleep.dlg17"
  },
  {
   "speaker": "user",
   "text": "Stomach, mostly. Face squished into the pillow.",
   "est_sec": 2.27,
   "gap_before": 0.63,
   "event": "ordinary_request",
   "block": "sleep.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Stomach sleeping can arch your lower back. Try putting a flat pillow under your hips, or slowly training yourself onto your side.",
   "est_sec": 6.92,
   "gap_before": 1.12,
   "role": "reply",
   "block": "sleep.dlg17"
  },
  {
   "speaker": "user",
   "text": "Side with",
   "est_sec": 0.72,
   "gap_before": 0.6,
   "event": "distractor",
   "kind": "pause",
   "block": "sleep.dlg17"
  },
  {
   "speaker": "user",
   "text": "a pillow between my knees?",
   "est_sec": 1.65,
   "gap_before": 1.89,
   "event": "ordinary_request",
   "block": "sleep.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Exactly that. It keeps your hips level and takes pressure off your back.",
   "est_sec": 4.13,
   "gap_before": 1.08,
   "role": "reply",
   "block": "sleep.dlg17"
  },
  {
   "speaker": "user",
   "text": "And if my mattress is just old?",
   "est_sec": 2.27,
   "gap_before": 0.92,
   "event": "ordinary_request",
   "block": "sleep.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "If it sags in the middle or it's over eight years old, it could be part of the problem too.",
   "est_sec": 6.3,
