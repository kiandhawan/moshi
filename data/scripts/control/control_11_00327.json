   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "Someone told me to pack a first night box. What goes in it?",
   "est_sec": 4.13,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "moving_house.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Everything you'll need before you've unpacked anything else. Think toothbrushes, phone chargers, toilet paper and a change of clothes.",
   "est_sec": 5.99,
   "gap_before": 0.76,
   "role": "reply",
   "block": "moving_house.dlg10"
  },
  {
