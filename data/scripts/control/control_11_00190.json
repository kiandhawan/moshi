 "est_total_sec": 50.17,
 "est_speech_sec": 38.92,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.38,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.94,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "We just moved up to the mountains and my cakes keep overflowing the tin.",
   "est_sec": 4.44,
   "gap_before": 0.51,
   "event": "ordinary_request",
   "block": "baking.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "That's the altitude. Air pressure is lower, so the bubbles grow faster and the batter rises too much before it sets.",
   "est_sec": 6.61,
   "gap_before": 1.38,
   "role": "reply",
   "block": "baking.dlg6"
  },
  {
   "speaker": "user",
   "text": "So what do I change?",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "baking.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Use a little less baking powder, maybe a quarter less, and bump the oven up by about fifteen degrees so it sets sooner.",
   "est_sec": 7.23,
   "gap_before": 0.57,
   "role": "reply",
   "block": "baking.dlg6"
  },
  {
   "speaker": "user",
   "text": "Anything about",
   "est_sec": 0.72,
   "gap_before": 0.45,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg6"
  },
  {
   "speaker": "user",
   "text": "the sugar or the liquid?",
   "est_sec": 1.65,
   "gap_before": 2.55,
   "event": "ordinary_request",
   "block": "baking.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Yes, a spoonful less sugar and a spoonful more liquid usually helps. Things dry out faster up there.",
   "est_sec": 5.68,
   "gap_before": 0.33,
   "role": "reply",
   "block": "baking.dlg6"
  },
  {
   "speaker": "user",
   "text": "This is a lot of fiddling.",
   "est_sec": 1.96,
   "gap_before": 1.34,
   "event": "ordinary_request",
   "block": "baking.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "It is at first. Change one recipe, note what works, and you'll have a system in a couple of bakes.",
   "est_sec": 6.3,
   "gap_before": 0.93,
   "role": "reply",
   "block": "baking.dlg6"
  }
 ]
}
