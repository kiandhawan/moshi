 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.75,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.51,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "How warm or cold should my bedroom be for sleeping?",
   "est_sec": 3.2,
   "gap_before": 0.29,
   "event": "ordinary_request",
   "block": "sleep.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Most people sleep best in a cool room, around sixty five degrees Fahrenheit or about eighteen Celsius.",
   "est_sec": 5.37,
   "gap_before": 0.35,
   "role": "reply",
   "block": "sleep.dlg4"
  },
  {
   "speaker": "user",
   "text": "That sounds cold. I'm always freezing.",
   "est_sec": 1.96,
   "gap_before": 1.92,
   "event": "ordinary_request",
   "block": "sleep.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "You can keep the room cool and still be cozy with warm socks or a heavier blanket. Cold feet actually make it harder to fall asleep.",
   "est_sec": 8.16,
   "gap_before": 1.82,
   "role": "reply",
   "block": "sleep.dlg4"
  },
  {
   "speaker": "user",
   "text": "Oh, I didn't know that. What about",
   "est_sec": 2.27,
   "gap_before": 1.03,
   "event": "distractor",
   "kind": "pause",
   "block": "sleep.dlg4"
  },
  {
   "speaker": "user",
   "text": "blackout curtains, are those worth it?",
   "est_sec": 1.96,
   "gap_before": 2.9,
   "event": "ordinary_request",
   "block": "sleep.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Yes, especially if there are streetlights outside or you sleep past sunrise. A sleep mask is a cheaper way to test it first.",
   "est_sec": 7.23,
   "gap_before": 1.13,
   "role": "reply",
   "block": "sleep.dlg4"
  },
  {
   "speaker": "user",
   "text": "I'll try the mask then.",
