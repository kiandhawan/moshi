 "est_total_sec": 56.64,
 "est_speech_sec": 44.08,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.47,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.47,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "I can swim, but I can't breathe properly doing front crawl. I end up gasping after one length.",
   "est_sec": 5.68,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "fitness.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "That's usually because people hold their breath underwater. Breathe out slowly through your nose or mouth while your face is in the water.",
   "est_sec": 7.23,
   "gap_before": 0.81,
   "role": "reply",
   "block": "fitness.dlg25"
  },
  {
   "speaker": "user",
   "text": "Breathe out underwater?",
   "est_sec": 1.03,
   "gap_before": 1.48,
   "event": "ordinary_request",
   "block": "fitness.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Yes, then when you turn your head, your lungs are ready to take a quick breath in.",
   "est_sec": 5.37,
   "gap_before": 0.96,
   "role": "reply",
   "block": "fitness.dlg25"
  },
  {
   "speaker": "user",
   "text": "When do I turn my head?",
   "est_sec": 1.96,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "fitness.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Every two or three strokes. Rotate your body and keep one eye in the water, don't lift your whole head.",
   "est_sec": 6.3,
   "gap_before": 0.77,
   "role": "reply",
   "block": "fitness.dlg25"
  },
  {
   "speaker": "user",
   "text": "This is a lot to think about",
   "est_sec": 2.27,
   "gap_before": 0.6,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg25"
  },
  {
   "speaker": "user",
   "text": "all at once.",
   "est_sec": 1.03,
   "gap_before": 2.06,
   "event": "ordinary_request",
   "block": "fitness.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Practice the breathing standing in the shallow end first. Bubbles out, turn, breathe in, repeat.",
   "est_sec": 4.75,
   "gap_before": 0.37,
   "role": "reply",
   "block": "fitness.dlg25"
  },
  {
   "speaker": "user",
   "text": "Bubbles, turn, breathe. Got it.",
   "est_sec": 1.65,
   "gap_before": 1.44,
   "event": "ordinary_request",
   "block": "fitness.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "You'll get it. Most people need a few sessions.",
   "est_sec": 2.89,
   "gap_before": 0.53,
   "role": "reply",
   "block": "fitness.dlg25"
  }
 ]
}
