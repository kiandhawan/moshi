 "est_speech_sec": 36.44,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.54,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.46,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "I teach year eleven and they're just not revising. Any ideas to help them?",
   "est_sec": 4.44,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "studying.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Teenagers often don't know how to revise, they just reread. Teaching them a few methods directly can help a lot.",
   "est_sec": 6.3,
   "gap_before": 1.07,
   "role": "reply",
   "block": "studying.dlg28"
  },
  {
   "speaker": "user",
   "text": "Like what, flashcards?",
   "est_sec": 1.03,
   "gap_before": 2.59,
   "event": "ordinary_request",
   "block": "studying.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Flashcards, self quizzing, and explaining things to a partner. Try short in class quizzes so they see the benefit.",
   "est_sec": 5.99,
   "gap_before": 0.36,
   "role": "reply",
   "block": "studying.dlg28"
  },
  {
   "speaker": "user",
   "text": "They groan at quizzes.",
   "est_sec": 1.34,
   "gap_before": 0.8,
   "event": "ordinary_request",
   "block": "studying.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Make them low stakes, maybe a quick team quiz at the start of lessons. No marks recorded, just practice.",
   "est_sec": 5.99,
   "gap_before": 0.6,
   "role": "reply",
   "block": "studying.dlg28"
  },
  {
   "speaker": "user",
   "text": "And getting them to",
   "est_sec": 1.34,
   "gap_before": 1.09,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg28"
  },
  {
   "speaker": "user",
   "text": "actually do it at home?",
   "est_sec": 1.65,
   "gap_before": 2.04,
   "event": "ordinary_request",
   "block": "studying.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Give them a simple weekly plan and check in on it briefly. Small, regular habits beat big revision lectures.",
   "est_sec": 5.99,
   "gap_before": 0.35,
   "role": "reply",
   "block": "studying.dlg28"
  }
 ]
}
