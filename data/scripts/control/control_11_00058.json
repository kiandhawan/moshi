 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.79,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.78,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "Is it bad to have lots of credit cards?",
   "est_sec": 2.89,
   "gap_before": 0.26,
   "event": "ordinary_request",
   "block": "personal_finance.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Not necessarily. What matters more is how much you owe on them and whether you pay on time.",
   "est_sec": 5.68,
   "gap_before": 0.59,
   "role": "reply",
   "block": "personal_finance.dlg11"
  },
  {
   "speaker": "user",
   "text": "I've got five. I only use two.",
   "est_sec": 2.27,
   "gap_before": 0.99,
   "event": "ordinary_request",
   "block": "personal_finance.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Having unused cards can actually help your score, because it shows available credit. But only if they don't charge annual fees.",
   "est_sec": 6.61,
   "gap_before": 1.17,
   "role": "reply",
   "block": "personal_finance.dlg11"
  },
  {
   "speaker": "user",
   "text": "Two of them have fees.",
   "est_sec": 1.65,
   "gap_before": 0.83,
   "event": "ordinary_request",
   "block": "personal_finance.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Then consider closing those. Just close one at a time, and keep your oldest card open.",
   "est_sec": 5.06,
   "gap_before": 1.4,
   "role": "reply",
   "block": "personal_finance.dlg11"
  },
  {
   "speaker": "user",
   "text": "Why the oldest one?",
   "est_sec": 1.34,
   "gap_before": 1.03,
   "event": "ordinary_request",
   "block": "personal_finance.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "The length of your credit history counts. Closing your oldest card can shorten it.",
   "est_sec": 4.44,
   "gap_before": 0.82,
   "role": "reply",
   "block": "personal_finance.dlg11"
  }
 ]
}
