 "est_total_sec": 54.23,
 "est_speech_sec": 39.54,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.75,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.57,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "Can I save seeds from my tomatoes for next year?",
   "est_sec": 3.2,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "gardening.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "You can, as long as they're not hybrids. If the packet said hybrid, the new plants might not match the parent.",
   "est_sec": 6.61,
   "gap_before": 0.49,
   "role": "reply",
   "block": "gardening.dlg30"
  },
  {
   "speaker": "user",
   "text": "These are old heirloom ones from my uncle.",
   "est_sec": 2.58,
   "gap_before": 1.1,
   "event": "ordinary_request",
   "block": "gardening.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Perfect, those come true from seed. Pick a really ripe tomato and scoop the seeds into a jar with a little water.",
   "est_sec": 6.92,
   "gap_before": 1.1,
   "role": "reply",
   "block": "gardening.dlg30"
  },
  {
   "speaker": "user",
   "text": "And then?",
   "est_sec": 0.72,
   "gap_before": 3.36,
   "event": "ordinary_request",
   "block": "gardening.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Leave it a few days until it gets a bit mouldy on top. That ferments away the jelly coating. Then rinse and dry the seeds on a plate.",
   "est_sec": 8.78,
   "gap_before": 0.83,
   "role": "reply",
   "block": "gardening.dlg30"
  },
  {
   "speaker": "user",
   "text": "Mouldy on purpose. That's",
   "est_sec": 1.34,
   "gap_before": 0.76,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg30"
  },
  {
   "speaker": "user",
   "text": "disgusting and brilliant.",
   "est_sec": 1.03,
   "gap_before": 2.79,
   "event": "ordinary_request",
   "block": "gardening.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "It's the traditional way. Store them dry in a paper envelope, labelled, somewhere cool. They'll keep for years.",
   "est_sec": 5.68,
   "gap_before": 0.99,
   "role": "reply",
   "block": "gardening.dlg30"
  }
 ]
}
