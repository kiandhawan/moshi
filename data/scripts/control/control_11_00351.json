 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.35,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.8,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "My friend keeps talking about spaced repetition. What is it and is it worth it?",
   "est_sec": 4.75,
   "gap_before": 0.41,
   "event": "ordinary_request",
   "block": "studying.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "It means reviewing things at growing intervals, like after one day, then three days, then a week. It's one of the best ways to remember long term.",
   "est_sec": 8.47,
   "gap_before": 0.82,
   "role": "reply",
   "block": "studying.dlg8"
  },
  {
   "speaker": "user",
   "text": "Why does it work better than just studying a lot once?",
   "est_sec": 3.51,
   "gap_before": 1.19,
   "event": "ordinary_request",
   "block": "studying.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Because each time you nearly forget and then recall it, the memory gets stronger. Cramming fades fast.",
   "est_sec": 5.37,
   "gap_before": 0.81,
   "role": "reply",
   "block": "studying.dlg8"
  },
  {
   "speaker": "user",
   "text": "Do I need an app for it?",
   "est_sec": 2.27,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "studying.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Apps make it easy because they schedule reviews for you. But a box of paper cards sorted into piles works too.",
   "est_sec": 6.61,
   "gap_before": 0.43,
   "role": "reply",
   "block": "studying.dlg8"
  },
  {
   "speaker": "user",
   "text": "Paper cards sound",
   "est_sec": 1.03,
   "gap_before": 1.86,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg8"
  },
  {
   "speaker": "user",
   "text": "kind of nice, actually.",
   "est_sec": 1.34,
   "gap_before": 2.97,
   "event": "ordinary_request",
   "block": "studying.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "They are. Writing the cards by hand is a bit of extra learning on its own.",
   "est_sec": 5.06,
   "gap_before": 0.38,
   "role": "reply",
   "block": "studying.dlg8"
  }
 ]
