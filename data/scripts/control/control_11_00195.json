 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.84,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "Can I bring my bike on the train?",
   "est_sec": 2.58,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "public_transport.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "On most regional trains, yes, but often not during rush hour. Look for the carriages with a bike symbol on the door.",
   "est_sec": 6.92,
   "gap_before": 0.64,
   "role": "reply",
   "block": "public_transport.dlg3"
  },
  {
   "speaker": "user",
   "text": "Do I need a ticket for it?",
   "est_sec": 2.27,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "public_transport.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Many operators charge a small bike fee or need a reservation on long distance trains. Check your operator's website before you go.",
   "est_sec": 6.92,
   "gap_before": 0.78,
   "role": "reply",
   "block": "public_transport.dlg3"
  },
  {
   "speaker": "user",
   "text": "Hold on, really?",
   "est_sec": 1.03,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_11",
   "block": "public_transport.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Good to question it. I still think it's right, though you know your situation best.",
   "est_sec": 4.75,
   "gap_before": 1.66,
   "role": "reply",
   "block": "public_transport.dlg3"
  },
  {
   "speaker": "user",
   "text": "Actually, I'm also thinking",
   "est_sec": 1.34,
   "gap_before": 1.21,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg3"
  },
  {
   "speaker": "user",
   "text": "about getting a folding bike instead.",
   "est_sec": 1.96,
   "gap_before": 1.98,
   "event": "ordinary_request",
   "block": "public_transport.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "That's a great option for commuting. Folded bikes usually count as luggage, so you can bring them anytime for free.",
   "est_sec": 6.3,
   "gap_before": 0.96,
   "role": "reply",
   "block": "public_transport.dlg3"
  },
  {
   "speaker": "user",
   "text": "Aren't they slow, though?",
   "est_sec": 1.34,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "public_transport.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "A bit slower than a regular bike, but for short rides to and from the station you'll hardly notice.",
   "est_sec": 5.99,
   "gap_before": 0.33,
   "role": "reply",
   "block": "public_transport.dlg3"
  }
 ]
}
