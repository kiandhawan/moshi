 "est_total_sec": 54.96,
 "est_speech_sec": 43.78,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 1.0,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "Family reunion Sunday. Thirty people. Last time someone was blinking in every single group photo.",
   "est_sec": 4.75,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "photography.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Thirty people means a blink in almost every frame, so the trick is taking lots. Use burst mode, or take at least ten in a row.",
   "est_sec": 8.16,
   "gap_before": 0.91,
   "role": "reply",
   "block": "photography.dlg21"
  },
  {
   "speaker": "user",
   "text": "Ten! They'll riot.",
   "est_sec": 1.03,
   "gap_before": 1.47,
   "event": "ordinary_request",
   "block": "photography.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Tell them it's quick and keep talking while you shoot. Counting down to three and shooting on two catches people before they blink.",
   "est_sec": 7.23,
   "gap_before": 0.75,
   "role": "reply",
   "block": "photography.dlg21"
  },
  {
   "speaker": "user",
   "text": "Sneaky. I like it.",
   "est_sec": 1.34,
   "gap_before": 0.87,
   "event": "ordinary_request",
   "block": "photography.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Also arrange them in rows on steps if there are any. Tall people at the back, kids at the front, and make sure you can see every face.",
   "est_sec": 8.78,
   "gap_before": 0.47,
   "role": "reply",
   "block": "photography.dlg21"
  },
  {
   "speaker": "user",
   "text": "What about me? I'm always missing.",
   "est_sec": 1.96,
   "gap_before": 2.83,
   "event": "ordinary_request",
   "block": "photography.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Use a timer and a tripod, or hand the camera to a neighbour for the last few. You belong in the family photo too.",
   "est_sec": 7.54,
   "gap_before": 0.46,
   "role": "reply",
   "block": "photography.dlg21"
  }
 ]
}
