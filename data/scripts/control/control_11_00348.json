 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.42,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.48,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "People in my online matches are so rude. Someone just spent the whole game insulting me.",
   "est_sec": 5.06,
   "gap_before": 0.36,
   "event": "ordinary_request",
   "block": "video_games.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "That's really unpleasant, and it's not your fault. The quickest fix is muting them, you don't owe anyone your attention.",
   "est_sec": 6.3,
   "gap_before": 0.57,
   "role": "reply",
   "block": "video_games.dlg23"
  },
  {
   "speaker": "user",
   "text": "Should I report them too?",
   "est_sec": 1.65,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "video_games.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Yes, if the game has a report option. It takes a few seconds, and repeated reports do lead to bans in many games.",
   "est_sec": 7.23,
   "gap_before": 0.7,
   "role": "reply",
   "block": "video_games.dlg23"
  },
  {
   "speaker": "user",
   "text": "It's making me not",
   "est_sec": 1.34,
   "gap_before": 0.81,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg23"
  },
  {
   "speaker": "user",
   "text": "want to play anymore.",
   "est_sec": 1.34,
   "gap_before": 1.8,
   "event": "ordinary_request",
   "block": "video_games.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "That's understandable. You could turn off voice chat with strangers and only talk to friends. Text chat can usually be switched off too.",
   "est_sec": 7.23,
   "gap_before": 0.51,
   "role": "reply",
   "block": "video_games.dlg23"
  },
  {
   "speaker": "user",
   "text": "Then how do I play with a team?",
   "est_sec": 2.58,
   "gap_before": 0.69,
   "event": "ordinary_request",
   "block": "video_games.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Most games have a ping system, where you mark things on the map without talking. Lots of players prefer it.",
   "est_sec": 6.3,
   "gap_before": 0.64,
   "role": "reply",
   "block": "video_games.dlg23"
  }
 ]
}
