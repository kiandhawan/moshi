 "est_total_sec": 58.36,
 "est_speech_sec": 41.91,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.44,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "Why did my cake sink in the middle?",
   "est_sec": 2.58,
   "gap_before": 0.59,
   "event": "ordinary_request",
   "block": "baking.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "The most common reason is opening the oven door too early. The cake hasn't set yet, and the cool air makes it collapse.",
   "est_sec": 7.23,
   "gap_before": 1.13,
   "role": "reply",
   "block": "baking.dlg1"
  },
  {
   "speaker": "user",
   "text": "Wait, are you sure about that?",
   "est_sec": 1.96,
   "gap_before": 0.75,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_08",
   "block": "baking.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Let me double-check. I'd still stand by it, but tell me what you heard.",
   "est_sec": 4.44,
   "gap_before": 1.81,
   "role": "reply",
   "block": "baking.dlg1"
  },
  {
   "speaker": "user",
   "text": "I did peek",
   "est_sec": 1.03,
   "gap_before": 1.44,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg1"
  },
  {
   "speaker": "user",
   "text": "at about fifteen minutes.",
   "est_sec": 1.34,
   "gap_before": 2.99,
   "event": "ordinary_request",
   "block": "baking.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "That might be it. Wait until at least three quarters of the baking time before you open the door.",
   "est_sec": 5.99,
   "gap_before": 0.91,
   "role": "reply",
   "block": "baking.dlg1"
  },
  {
   "speaker": "user",
   "text": "Could it be anything else?",
   "est_sec": 1.65,
   "gap_before": 0.92,
   "event": "ordinary_request",
   "block": "baking.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Too much baking powder or underbaking can also do it. Check the center with a toothpick, it should come out clean.",
   "est_sec": 6.61,
   "gap_before": 1.02,
   "role": "reply",
   "block": "baking.dlg1"
  },
  {
   "speaker": "user",
   "text": "Okay. I'll try again next weekend.",
   "est_sec": 1.96,
   "gap_before": 1.41,
   "event": "ordinary_request",
   "block": "baking.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Good luck. A sunken cake still tastes great, so enjoy this one anyway.",
   "est_sec": 4.13,
   "gap_before": 0.95,
   "role": "reply",
   "block": "baking.dlg1"
  }
 ]
}
