 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.68,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "Under my bathroom sink is a jungle of half-empty bottles. How do I tidy it?",
   "est_sec": 4.75,
   "gap_before": 0.21,
   "event": "ordinary_request",
   "block": "cleaning.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Empty it completely and group what's left. Cleaning sprays, spare toiletries, and random stuff.",
   "est_sec": 4.44,
   "gap_before": 0.49,
   "role": "reply",
   "block": "cleaning.dlg32"
  },
  {
   "speaker": "user",
   "text": "I found four bottles of the same bathroom spray.",
   "est_sec": 2.89,
   "gap_before": 1.32,
   "event": "ordinary_request",
   "block": "cleaning.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Combine them if they're the same, and recycle the empties.",
   "est_sec": 3.2,
   "gap_before": 1.31,
   "role": "reply",
   "block": "cleaning.dlg32"
  },
  {
   "speaker": "user",
   "text": "Okay. And then?",
   "est_sec": 1.03,
   "gap_before": 1.28,
   "event": "ordinary_request",
   "block": "cleaning.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Two small baskets or a little pull-out drawer make it easy to grab things. A tension rod across the top lets you hang spray bottles by their triggers.",
   "est_sec": 8.78,
   "gap_before": 0.84,
   "role": "reply",
   "block": "cleaning.dlg32"
  },
  {
   "speaker": "user",
   "text": "Oh, that's smart. More space",
   "est_sec": 1.65,
   "gap_before": 1.53,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg32"
  },
  {
   "speaker": "user",
   "text": "for the baskets underneath.",
   "est_sec": 1.34,
   "gap_before": 2.77,
   "event": "ordinary_request",
   "block": "cleaning.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Keep anything harsh high up if you have kids around.",
   "est_sec": 3.51,
