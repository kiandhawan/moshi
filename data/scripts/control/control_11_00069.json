 "est_total_sec": 56.65,
 "est_speech_sec": 44.19,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.42,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.52,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "I need a new profile photo for a job site. I hate how I look in pictures.",
   "est_sec": 5.37,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "photography.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Lots of people do. The good news is a calm, friendly headshot is simple to get right. Do you have someone who can take it?",
   "est_sec": 7.85,
   "gap_before": 0.51,
   "role": "reply",
   "block": "photography.dlg27"
  },
  {
   "speaker": "user",
   "text": "My flatmate, if I bribe her.",
   "est_sec": 1.96,
   "gap_before": 3.06,
   "event": "ordinary_request",
   "block": "photography.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Great. Stand facing a window, about a metre from it, with a plain wall or some soft greenery behind you.",
   "est_sec": 6.3,
   "gap_before": 1.11,
   "role": "reply",
   "block": "photography.dlg27"
  },
  {
   "speaker": "user",
   "text": "Wait, what do I",
   "est_sec": 1.34,
   "gap_before": 0.46,
   "event": "distractor",
   "kind": "pause",
   "block": "photography.dlg27"
  },
  {
   "speaker": "user",
   "text": "do with my face, though? I always look terrified.",
   "est_sec": 2.89,
   "gap_before": 2.17,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_13",
   "block": "photography.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Think of someone you like and say their name just before the photo. It gives a real half smile instead of a frozen one.",
   "est_sec": 7.54,
   "gap_before": 0.67,
   "role": "reply",
   "block": "photography.dlg27"
  },
  {
   "speaker": "user",
   "text": "Ha. Okay.",
   "est_sec": 0.72,
   "gap_before": 0.7,
   "event": "ordinary_request",
   "block": "photography.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Have her hold the phone just above your eye level, and take loads. Pick the one where you look like yourself on a good day.",
   "est_sec": 7.85,
   "gap_before": 1.06,
   "role": "reply",
   "block": "photography.dlg27"
  }
 ]
}
