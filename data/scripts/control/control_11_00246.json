 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.6,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.68,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "Quick question. My bundt cake always sticks in the tin and comes out in pieces.",
   "est_sec": 4.75,
   "gap_before": 0.22,
   "event": "ordinary_request",
   "block": "baking.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Bundt tins are tricky with all those ridges. Are you greasing it with butter or spray?",
   "est_sec": 5.06,
   "gap_before": 0.34,
   "role": "reply",
   "block": "baking.dlg9"
  },
  {
   "speaker": "user",
   "text": "Spray, mostly.",
   "est_sec": 0.72,
   "gap_before": 1.16,
   "event": "ordinary_request",
   "block": "baking.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Try brushing melted butter into every groove with a pastry brush, then dust it with flour and tap out the extra.",
   "est_sec": 6.61,
   "gap_before": 1.81,
   "role": "reply",
   "block": "baking.dlg9"
  },
  {
   "speaker": "user",
   "text": "And when should I",
   "est_sec": 1.34,
   "gap_before": 1.21,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg9"
  },
  {
   "speaker": "user",
   "text": "turn it out? Straight away?",
   "est_sec": 1.65,
   "gap_before": 2.71,
   "event": "ordinary_request",
   "block": "baking.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "About ten minutes after it comes out. Too soon and it's fragile, too late and the sugars start gluing it to the tin.",
   "est_sec": 7.23,
   "gap_before": 0.87,
   "role": "reply",
   "block": "baking.dlg9"
  },
  {
   "speaker": "user",
   "text": "Ten minutes. Got it.",
   "est_sec": 1.34,
   "gap_before": 1.38,
   "event": "ordinary_request",
   "block": "baking.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Set a timer, it's easy to forget. Then flip it onto a rack with confidence, no hesitating.",
   "est_sec": 5.37,
   "gap_before": 0.93,
   "role": "reply",
   "block": "baking.dlg9"
  }
 ]
}
