 "est_total_sec": 51.47,
 "est_speech_sec": 40.47,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.71,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.86,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "My strawberry plants are sending out long stringy runners everywhere.",
   "est_sec": 3.2,
   "gap_before": 0.23,
   "event": "ordinary_request",
   "block": "gardening.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Those runners are baby plants on a leash. You can either snip them off or use them to make new plants for free.",
   "est_sec": 7.23,
   "gap_before": 0.89,
   "role": "reply",
   "block": "gardening.dlg19"
  },
  {
   "speaker": "user",
   "text": "Free plants, go on.",
   "est_sec": 1.34,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "gardening.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Pin the little plantlet onto a pot of compost with a bent wire or a stone. Once it's rooted in a few weeks, cut the runner.",
   "est_sec": 8.16,
   "gap_before": 0.99,
   "role": "reply",
   "block": "gardening.dlg19"
  },
  {
   "speaker": "user",
   "text": "Is there a catch?",
   "est_sec": 1.34,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "gardening.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "If you leave too many on, the mother plant puts energy into them instead of fruit. Keep two or three per plant, cut the rest.",
   "est_sec": 7.85,
   "gap_before": 0.8,
   "role": "reply",
   "block": "gardening.dlg19"
  },
  {
   "speaker": "user",
   "text": "And how long do",
   "est_sec": 1.34,
   "gap_before": 0.72,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg19"
  },
  {
   "speaker": "user",
   "text": "the old plants last?",
   "est_sec": 1.34,
   "gap_before": 2.66,
   "event": "ordinary_request",
   "block": "gardening.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "About three or four years before they tire out. That's why rooting runners every summer keeps the bed going.",
   "est_sec": 5.99,
   "gap_before": 0.61,
   "role": "reply",
   "block": "gardening.dlg19"
  }
 ]
}
