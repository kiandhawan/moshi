 "est_speech_sec": 37.68,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.47,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "Beach day tomorrow. Is there anything about the weather I should check besides sunshine?",
   "est_sec": 4.44,
   "gap_before": 0.22,
   "event": "ordinary_request",
   "block": "weather_plans.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "The wind and the tide times. A windy beach can feel cold and sandblasting even if it's sunny.",
   "est_sec": 5.68,
   "gap_before": 0.36,
   "role": "reply",
   "block": "weather_plans.dlg19"
  },
  {
   "speaker": "user",
   "text": "What wind speed is too much?",
   "est_sec": 1.96,
   "gap_before": 1.03,
   "event": "ordinary_request",
   "block": "weather_plans.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Above about fifteen or twenty miles an hour gets unpleasant. A windbreak helps a lot.",
   "est_sec": 4.75,
   "gap_before": 0.31,
   "role": "reply",
   "block": "weather_plans.dlg19"
  },
  {
   "speaker": "user",
   "text": "And why the tides?",
   "est_sec": 1.34,
   "gap_before": 1.43,
   "event": "ordinary_request",
   "block": "weather_plans.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "At high tide some beaches almost disappear. Low tide is better for rock pools and space to play.",
   "est_sec": 5.68,
   "gap_before": 1.92,
   "role": "reply",
   "block": "weather_plans.dlg19"
  },
  {
   "speaker": "user",
   "text": "My kids want to swim",
   "est_sec": 1.65,
   "gap_before": 2.97,
   "event": "distractor",
   "kind": "pause",
   "block": "weather_plans.dlg19"
  },
  {
   "speaker": "user",
   "text": "but the sea is freezing this time of year.",
   "est_sec": 2.89,
   "gap_before": 2.94,
   "event": "ordinary_request",
   "block": "weather_plans.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Pick a lifeguarded beach, and get them out before their lips go blue. Bring a hot drink for after.",
   "est_sec": 5.99,
   "gap_before": 0.71,
   "role": "reply",
   "block": "weather_plans.dlg19"
  }
 ]
}
