 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.56,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.59,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "Are wireless charging pads worth it, or just a gimmick?",
   "est_sec": 3.2,
   "gap_before": 0.25,
   "event": "ordinary_request",
   "block": "smartphones.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Depends on your habits. They're slower than a cable, but really handy on a desk or nightstand where you just drop the phone down.",
   "est_sec": 7.54,
   "gap_before": 1.18,
   "role": "reply",
   "block": "smartphones.dlg22"
  },
  {
   "speaker": "user",
   "text": "I'm always unplugging my phone to text in bed and then it doesn't charge.",
   "est_sec": 4.44,
   "gap_before": 1.02,
   "event": "ordinary_request",
   "block": "smartphones.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Then a cable is actually better for you, since you can use the phone while it's plugged in. A pad only charges when the phone's lying on it.",
   "est_sec": 8.78,
   "gap_before": 0.57,
   "role": "reply",
   "block": "smartphones.dlg22"
  },
  {
   "speaker": "user",
   "text": "Hmm. Fair point. What about",
   "est_sec": 1.65,
   "gap_before": 1.07,
   "event": "distractor",
   "kind": "pause",
   "block": "smartphones.dlg22"
  },
  {
   "speaker": "user",
   "text": "at work?",
   "est_sec": 0.72,
   "gap_before": 2.04,
   "event": "ordinary_request",
   "block": "smartphones.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "That's where a pad shines. You set it down between meetings and it tops up without any fiddling.",
   "est_sec": 5.68,
   "gap_before": 0.72,
   "role": "reply",
   "block": "smartphones.dlg22"
  },
  {
   "speaker": "user",
   "text": "Okay, one for the office then. Not the bedroom.",
   "est_sec": 2.89,
   "gap_before": 0.37,
   "block": "smartphones.dlg22"
  }
 ]
}
