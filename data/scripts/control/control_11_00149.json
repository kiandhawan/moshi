 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.46,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "My game box is a disaster. All the cards and tokens are mixed together.",
   "est_sec": 4.44,
   "gap_before": 0.29,
   "event": "ordinary_request",
   "block": "board_games.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Small zip bags are the cheapest fix. One bag per type of piece, and setup gets much quicker.",
   "est_sec": 5.68,
   "gap_before": 0.86,
   "role": "reply",
   "block": "board_games.dlg3"
  },
  {
   "speaker": "user",
   "text": "Hold on, really?",
   "est_sec": 1.03,
   "gap_before": 2.14,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_11",
   "block": "board_games.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "I'm fairly sure about it, but I could be wrong. What sounds off to you?",
   "est_sec": 4.75,
   "gap_before": 0.61,
   "role": "reply",
   "block": "board_games.dlg3"
  },
  {
   "speaker": "user",
   "text": "Some people buy",
   "est_sec": 1.03,
   "gap_before": 0.79,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg3"
  },
  {
   "speaker": "user",
   "text": "those fancy wooden inserts, right?",
   "est_sec": 1.65,
   "gap_before": 1.75,
   "event": "ordinary_request",
   "block": "board_games.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Yes, they're nice for games you play a lot. For everything else, bags or little plastic boxes do the job.",
   "est_sec": 6.3,
   "gap_before": 0.55,
   "role": "reply",
   "block": "board_games.dlg3"
  },
  {
   "speaker": "user",
   "text": "What about cards getting worn out?",
   "est_sec": 1.96,
   "gap_before": 1.44,
   "event": "ordinary_request",
   "block": "board_games.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Card sleeves protect them. They're worth it for games where you shuffle a lot.",
   "est_sec": 4.44,
   "gap_before": 0.66,
   "role": "reply",
   "block": "board_games.dlg3"
  },
  {
   "speaker": "user",
   "text": "Okay, I'll start with the bags this weekend.",
   "est_sec": 2.58,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "board_games.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Good plan. Label each bag and your future self will thank you.",
   "est_sec": 3.82,
   "gap_before": 1.93,
   "role": "reply",
   "block": "board_games.dlg3"
  }
 ]
}
