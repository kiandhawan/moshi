 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.36,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.66,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "What are the actual rules in a quiet carriage? My neighbour keeps taking calls.",
   "est_sec": 4.44,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "public_transport.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Generally, no phone calls, no music without headphones, and keep conversations to a whisper.",
   "est_sec": 4.44,
   "gap_before": 0.43,
   "role": "reply",
   "block": "public_transport.dlg5"
  },
  {
   "speaker": "user",
   "text": "Should I say something to him?",
   "est_sec": 1.96,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "public_transport.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "A polite word is fine. Something like, this is the quiet carriage, would you mind taking that in the corridor.",
   "est_sec": 6.3,
   "gap_before": 0.52,
   "role": "reply",
   "block": "public_transport.dlg5"
  },
  {
   "speaker": "user",
   "text": "Hold on, and if he",
   "est_sec": 1.65,
   "gap_before": 1.07,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg5"
  },
  {
   "speaker": "user",
   "text": "just ignores me?",
   "est_sec": 1.03,
   "gap_before": 1.88,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_14",
   "block": "public_transport.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Then let the train staff know. It's their job to enforce it, and you don't have to get into an argument.",
   "est_sec": 6.61,
   "gap_before": 0.85,
   "role": "reply",
   "block": "public_transport.dlg5"
  },
  {
   "speaker": "user",
   "text": "I hate confrontation.",
   "est_sec": 1.03,
   "gap_before": 2.39,
   "event": "ordinary_request",
   "block": "public_transport.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Most people are just distracted and apologise straight away. You might be surprised.",
   "est_sec": 4.13,
   "gap_before": 1.11,
   "role": "reply",
   "block": "public_transport.dlg5"
  }
 ]
}
