 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.7,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.53,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "Why does my floor creak right by the bed? It wakes my wife when I get up.",
   "est_sec": 5.37,
   "gap_before": 0.26,
   "event": "ordinary_request",
   "block": "home_repair.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Creaks usually come from floorboards rubbing against each other or against a loose nail.",
   "est_sec": 4.44,
   "gap_before": 1.05,
   "role": "reply",
   "block": "home_repair.dlg25"
  },
  {
   "speaker": "user",
   "text": "Is it a big job to fix?",
   "est_sec": 2.27,
   "gap_before": 0.69,
   "event": "ordinary_request",
   "block": "home_repair.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Not necessarily. If you can get under the floor, a screw through the board into the joist often stops it.",
   "est_sec": 6.3,
   "gap_before": 0.32,
   "role": "reply",
   "block": "home_repair.dlg25"
  },
  {
   "speaker": "user",
   "text": "There's carpet over it, so I can't see.",
   "est_sec": 2.58,
   "gap_before": 1.2,
   "event": "ordinary_request",
   "block": "home_repair.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "There are kits for that, special screws that go through carpet and snap off below the surface.",
   "est_sec": 5.37,
   "gap_before": 0.48,
   "role": "reply",
   "block": "home_repair.dlg25"
  },
  {
   "speaker": "user",
   "text": "Really? That",
   "est_sec": 0.72,
   "gap_before": 1.37,
   "event": "distractor",
   "kind": "pause",
   "block": "home_repair.dlg25"
  },
  {
   "speaker": "user",
   "text": "sounds like magic.",
   "est_sec": 1.03,
   "gap_before": 2.76,
   "event": "ordinary_request",
   "block": "home_repair.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Almost. Find the joist by pressing around until the creak stops, then screw into that spot.",
   "est_sec": 5.06,
   "gap_before": 1.42,
   "role": "reply",
   "block": "home_repair.dlg25"
  }
 ]
}
