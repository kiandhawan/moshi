 "est_total_sec": 58.64,
 "est_speech_sec": 45.43,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.41,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "Thinking of buying a VR headset. My living room is pretty small, is that a problem?",
   "est_sec": 5.06,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "video_games.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "It depends on what you want to play. Many VR games can be played seated or standing in one spot, which needs very little space.",
   "est_sec": 7.85,
   "gap_before": 0.5,
   "role": "reply",
   "block": "video_games.dlg26"
  },
  {
   "speaker": "user",
   "text": "How much space for the moving around ones?",
   "est_sec": 2.58,
   "gap_before": 3.2,
   "event": "ordinary_request",
   "block": "video_games.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Roughly two metres by two metres of clear floor is comfortable. Less than that, and you'll keep bumping the guardian boundary.",
   "est_sec": 6.61,
   "gap_before": 0.68,
   "role": "reply",
   "block": "video_games.dlg26"
  },
  {
   "speaker": "user",
   "text": "I have a coffee table",
   "est_sec": 1.65,
   "gap_before": 0.45,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg26"
  },
  {
   "speaker": "user",
   "text": "right in the middle.",
   "est_sec": 1.34,
   "gap_before": 1.75,
   "event": "ordinary_request",
   "block": "video_games.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Then you'd want to push it aside when you play, or stick to seated games. Swinging your arms into a table hurts.",
   "est_sec": 6.92,
   "gap_before": 1.19,
   "role": "reply",
   "block": "video_games.dlg26"
  },
  {
   "speaker": "user",
   "text": "Is VR sickness a thing?",
   "est_sec": 1.65,
   "gap_before": 1.1,
   "event": "ordinary_request",
   "block": "video_games.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "For some people, yes. Start with short sessions and games where you don't move with a stick, like rhythm games. Most people adjust over a few weeks.",
   "est_sec": 8.47,
   "gap_before": 1.1,
   "role": "reply",
   "block": "video_games.dlg26"
  }
 ]
}
