 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.62,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "I run alone early in the mornings. Is there a way for someone to know who I am if I collapse?",
   "est_sec": 6.61,
   "gap_before": 0.51,
   "event": "ordinary_request",
   "block": "smartphones.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Yes, set up your medical ID and emergency contacts. Paramedics can see them from the lock screen without your code.",
   "est_sec": 6.3,
   "gap_before": 0.56,
   "role": "reply",
   "block": "smartphones.dlg25"
  },
  {
   "speaker": "user",
   "text": "What do I put in it?",
   "est_sec": 1.96,
   "gap_before": 0.62,
   "event": "ordinary_request",
   "block": "smartphones.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Your name, any allergies or conditions, medications, blood type if you know it, and one or two emergency contacts.",
   "est_sec": 5.99,
   "gap_before": 0.95,
   "role": "reply",
   "block": "smartphones.dlg25"
  },
  {
   "speaker": "user",
   "text": "I'm allergic to penicillin, so that's useful.",
   "est_sec": 2.27,
   "gap_before": 0.95,
   "event": "ordinary_request",
   "block": "smartphones.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Definitely put that in. Many phones also have an emergency SOS shortcut, pressing the side button a few times calls for help and texts your contacts.",
   "est_sec": 8.16,
   "gap_before": 0.98,
   "role": "reply",
   "block": "smartphones.dlg25"
  },
  {
   "speaker": "user",
   "text": "I'll test where the button",
   "est_sec": 1.65,
   "gap_before": 0.93,
   "event": "distractor",
   "kind": "pause",
   "block": "smartphones.dlg25"
  },
  {
   "speaker": "user",
   "text": "is without actually calling anyone.",
   "est_sec": 1.65,
   "gap_before": 1.79,
   "event": "ordinary_request",
   "block": "smartphones.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Good idea. Most phones have a countdown first, so you can cancel.",
   "est_sec": 3.82,
   "gap_before": 1.7,
   "role": "reply",
   "block": "smartphones.dlg25"
  }
 ]
