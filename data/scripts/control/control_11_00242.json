 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.84,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "Is reading on an e-reader as bad as scrolling my phone?",
   "est_sec": 3.51,
   "gap_before": 0.59,
   "event": "ordinary_request",
   "block": "sleep.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Usually much better. E-readers with e-ink screens don't glow like phones, and there are no notifications pulling you in.",
   "est_sec": 5.99,
   "gap_before": 0.92,
   "role": "reply",
   "block": "sleep.dlg25"
  },
  {
   "speaker": "user",
   "text": "Mine has a backlight though.",
   "est_sec": 1.65,
   "gap_before": 0.97,
   "event": "ordinary_request",
   "block": "sleep.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Most have a warm light setting, turn that on and keep the brightness low.",
   "est_sec": 4.44,
   "gap_before": 0.7,
   "role": "reply",
   "block": "sleep.dlg25"
  },
  {
   "speaker": "user",
   "text": "Wait, what did you say?",
   "est_sec": 1.65,
   "gap_before": 1.17,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_01",
   "block": "sleep.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Sure. Most have a warm light setting, turn that on and keep the brightness low.",
   "est_sec": 4.75,
   "gap_before": 0.76,
   "role": "reply",
   "block": "sleep.dlg25"
  },
  {
   "speaker": "user",
   "text": "So",
   "est_sec": 0.41,
   "gap_before": 0.5,
   "event": "distractor",
   "kind": "pause",
   "block": "sleep.dlg25"
  },
  {
   "speaker": "user",
   "text": "it's fine then?",
   "est_sec": 1.03,
   "gap_before": 2.0,
   "event": "ordinary_request",
   "block": "sleep.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Pretty much. The main thing is that a book doesn't keep you hooked the way social media does, unless it's a thriller.",
   "est_sec": 6.92,
   "gap_before": 0.94,
   "role": "reply",
   "block": "sleep.dlg25"
  },
  {
   "speaker": "user",
   "text": "It is a thriller.",
   "est_sec": 1.34,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "sleep.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Then maybe stop at the end of a chapter, not the middle of a cliffhanger.",
   "est_sec": 4.75,
   "gap_before": 1.16,
   "role": "reply",
   "block": "sleep.dlg25"
  }
 ]
