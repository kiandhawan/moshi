 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.43,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "I've always wanted to try pottery. Can you learn it in a weekend?",
   "est_sec": 4.13,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "You can definitely get a taste. Lots of studios run weekend taster workshops, usually a few hours on the wheel.",
   "est_sec": 6.3,
   "gap_before": 0.71,
   "role": "reply",
   "block": "weekend_plans.dlg11"
  },
  {
   "speaker": "user",
   "text": "Will I make anything decent?",
   "est_sec": 1.65,
   "gap_before": 1.04,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Probably something wonky, but that's part of the fun. Most people make a little bowl or a cup.",
   "est_sec": 5.68,
   "gap_before": 0.63,
   "role": "reply",
   "block": "weekend_plans.dlg11"
  },
  {
   "speaker": "user",
   "text": "Do I get to",
   "est_sec": 1.34,
   "gap_before": 0.54,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg11"
  },
  {
   "speaker": "user",
   "text": "take it home?",
   "est_sec": 1.03,
   "gap_before": 2.86,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Usually yes, but not straight away. It needs to dry, be fired, and glazed, so it often takes a few weeks.",
   "est_sec": 6.61,
   "gap_before": 0.82,
   "role": "reply",
   "block": "weekend_plans.dlg11"
  },
  {
   "speaker": "user",
   "text": "Okay, a wonky bowl in a month. I'm in.",
   "est_sec": 2.89,
   "gap_before": 1.16,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Great. Wear clothes you don't mind getting messy, clay goes everywhere.",
   "est_sec": 3.51,
   "gap_before": 0.34,
   "role": "reply",
   "block": "weekend_plans.dlg11"
  }
 ]
}
