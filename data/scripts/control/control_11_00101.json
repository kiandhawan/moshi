 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.31,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "Do singers really need to warm up? I just sing in the car.",
   "est_sec": 4.13,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "music.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "For casual car singing, not much. But before a rehearsal or a gig, warming up protects your voice and makes high notes easier.",
   "est_sec": 7.23,
   "gap_before": 0.59,
   "role": "reply",
   "block": "music.dlg9"
  },
  {
   "speaker": "user",
   "text": "What do people actually do?",
   "est_sec": 1.65,
   "gap_before": 0.7,
   "event": "ordinary_request",
   "block": "music.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Gentle humming, lip trills, which are like blowing a raspberry while you sing, and slides from low to high.",
   "est_sec": 5.99,
   "gap_before": 0.57,
   "role": "reply",
   "block": "music.dlg9"
  },
  {
   "speaker": "user",
   "text": "Lip trills sound",
   "est_sec": 1.03,
   "gap_before": 1.19,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg9"
  },
  {
   "speaker": "user",
   "text": "incredibly silly.",
   "est_sec": 0.72,
   "gap_before": 1.7,
   "event": "ordinary_request",
   "block": "music.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "They really do. Everyone looks ridiculous doing them, but they relax your voice without straining it.",
   "est_sec": 5.06,
   "gap_before": 0.46,
   "role": "reply",
   "block": "music.dlg9"
  },
  {
   "speaker": "user",
   "text": "How long for?",
   "est_sec": 1.03,
   "gap_before": 1.46,
   "event": "ordinary_request",
   "block": "music.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Ten minutes is plenty. Start low and gentle, then go a bit higher as you go.",
   "est_sec": 5.06,
   "gap_before": 0.33,
   "role": "reply",
   "block": "music.dlg9"
  }
 ]
