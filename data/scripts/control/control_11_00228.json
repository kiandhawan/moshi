 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.51,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "My teenager sat on chewing gum and now it's stuck to his favourite hoodie. He's devastated.",
   "est_sec": 5.06,
   "gap_before": 0.23,
   "event": "ordinary_request",
   "block": "cleaning.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Freeze it. Put the hoodie in a bag in the freezer for an hour, then the gum goes hard and you can pick it off.",
   "est_sec": 7.85,
   "gap_before": 1.04,
   "role": "reply",
   "block": "cleaning.dlg10"
  },
  {
   "speaker": "user",
   "text": "Seriously? The freezer?",
   "est_sec": 1.03,
   "gap_before": 0.73,
   "event": "ordinary_request",
   "block": "cleaning.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Really. Hard gum cracks off instead of stretching.",
   "est_sec": 2.58,
   "gap_before": 1.68,
   "role": "reply",
   "block": "cleaning.dlg10"
  },
  {
   "speaker": "user",
   "text": "And if there's a little",
   "est_sec": 1.65,
   "gap_before": 1.37,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg10"
  },
  {
   "speaker": "user",
   "text": "leftover bit?",
   "est_sec": 0.72,
   "gap_before": 2.51,
   "event": "ordinary_request",
   "block": "cleaning.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Rub a tiny bit of dish soap into it and wash as usual. Check it before it goes in the dryer.",
   "est_sec": 6.61,
   "gap_before": 0.83,
   "role": "reply",
   "block": "cleaning.dlg10"
  },
  {
   "speaker": "user",
   "text": "I'll put it in now. He's acting like his life is over.",
   "est_sec": 3.82,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "cleaning.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Hoodie emergencies are serious at that age.",
   "est_sec": 2.27,
   "gap_before": 0.62,
   "role": "reply",
   "block": "cleaning.dlg10"
  }
 ]
