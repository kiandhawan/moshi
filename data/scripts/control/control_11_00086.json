 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.75,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "Can you recommend a good board game for just two players?",
   "est_sec": 3.51,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Jaipur is a great one. It's a quick trading game, about twenty minutes, and easy to learn.",
   "est_sec": 5.37,
   "gap_before": 0.49,
   "role": "reply",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "user",
   "text": "We like something",
   "est_sec": 1.03,
   "gap_before": 1.1,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "user",
   "text": "a bit more strategic, actually.",
   "est_sec": 1.65,
   "gap_before": 1.53,
   "event": "ordinary_request",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Then try Seven Wonders Duel. It's still under an hour, but there's lots to plan.",
   "est_sec": 4.75,
   "gap_before": 1.16,
   "role": "reply",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "user",
   "text": "Is that one hard to learn?",
   "est_sec": 1.96,
   "gap_before": 2.89,
   "event": "ordinary_request",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "The first game takes a bit of rule checking, but after that it flows nicely. Most couples play it again right away.",
   "est_sec": 6.92,
   "gap_before": 0.32,
   "role": "reply",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "user",
   "text": "Sounds perfect. We'll get that one.",
   "est_sec": 1.96,
   "gap_before": 1.33,
   "event": "ordinary_request",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Enjoy! Fair warning, it gets pretty competitive.",
   "est_sec": 2.27,
   "gap_before": 0.99,
   "role": "reply",
   "block": "board_games.dlg1"
  }
 ]
