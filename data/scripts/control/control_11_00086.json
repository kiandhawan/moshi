 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.38,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.62,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "Why do my two weather apps give totally different forecasts?",
   "est_sec": 3.2,
   "gap_before": 0.36,
   "event": "ordinary_request",
   "block": "weather_plans.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "They often use different weather models and update at different times. They may also pick a different nearby location for you.",
   "est_sec": 6.61,
   "gap_before": 0.81,
   "role": "reply",
   "block": "weather_plans.dlg10"
  },
  {
   "speaker": "user",
   "text": "One says sunny Sunday, one says thunderstorms.",
   "est_sec": 2.27,
   "gap_before": 1.36,
   "event": "ordinary_request",
   "block": "weather_plans.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "That usually means the forecast is uncertain. A few days out, models can disagree a lot about storms.",
   "est_sec": 5.68,
   "gap_before": 0.37,
   "role": "reply",
   "block": "weather_plans.dlg10"
  },
  {
   "speaker": "user",
   "text": "Which one do I trust?",
   "est_sec": 1.65,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "weather_plans.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Check your national weather service. They have meteorologists looking at several models, not just one.",
   "est_sec": 4.75,
   "gap_before": 0.95,
   "role": "reply",
   "block": "weather_plans.dlg10"
  },
  {
   "speaker": "user",
   "text": "I've got a barbecue planned.",
   "est_sec": 1.65,
   "gap_before": 0.51,
   "event": "distractor",
   "kind": "pause",
   "block": "weather_plans.dlg10"
  },
  {
   "speaker": "user",
   "text": "Well, my brother's barbecue, but I'm cooking.",
   "est_sec": 2.27,
   "gap_before": 1.53,
   "event": "ordinary_request",
   "block": "weather_plans.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Then keep both possibilities in mind. Look again on Saturday morning, forecasts the day before are much more reliable.",
   "est_sec": 5.99,
   "gap_before": 1.83,
   "role": "reply",
   "block": "weather_plans.dlg10"
  }
 ]
}
