 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.51,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.55,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "Can I bring my bike on the train?",
   "est_sec": 2.58,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "public_transport.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "On most regional trains, yes, but often not during rush hour. Look for the carriages with a bike symbol on the door.",
   "est_sec": 6.92,
   "gap_before": 0.93,
   "role": "reply",
   "block": "public_transport.dlg3"
  },
  {
   "speaker": "user",
   "text": "Do I need a ticket for it?",
   "est_sec": 2.27,
   "gap_before": 0.32,
   "event": "ordinary_request",
   "block": "public_transport.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Many operators charge a small bike fee or need a reservation on long distance trains. Check your operator's website before you go.",
   "est_sec": 6.92,
   "gap_before": 1.26,
   "role": "reply",
   "block": "public_transport.dlg3"
  },
  {
   "speaker": "user",
   "text": "Actually, I'm also thinking",
   "est_sec": 1.34,
   "gap_before": 1.05,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg3"
  },
  {
   "speaker": "user",
   "text": "about getting a folding bike instead.",
   "est_sec": 1.96,
   "gap_before": 2.68,
   "event": "ordinary_request",
   "block": "public_transport.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "That's a great option for commuting. Folded bikes usually count as luggage, so you can bring them anytime for free.",
   "est_sec": 6.3,
   "gap_before": 0.36,
   "role": "reply",
   "block": "public_transport.dlg3"
  },
  {
   "speaker": "user",
   "text": "Hold on, can you say that again?",
   "est_sec": 2.27,
   "gap_before": 1.3,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_02",
   "block": "public_transport.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Sure. That's a great option for commuting. Folded bikes usually count as luggage, so you can bring them anytime for free.",
   "est_sec": 6.61,
   "gap_before": 1.13,
   "role": "reply",
   "block": "public_transport.dlg3"
  },
  {
   "speaker": "user",
   "text": "Aren't they slow, though?",
   "est_sec": 1.34,
   "gap_before": 0.96,
   "event": "ordinary_request",
   "block": "public_transport.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "A bit slower than a regular bike, but for short rides to and from the station you'll hardly notice.",
   "est_sec": 5.99,
   "gap_before": 0.71,
   "role": "reply",
   "block": "public_transport.dlg3"
  }
 ]
}
