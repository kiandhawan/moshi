 "est_total_sec": 57.62,
 "est_speech_sec": 45.94,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.57,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "My teenager says our family games are boring and cringe. Help.",
   "est_sec": 3.51,
   "gap_before": 0.4,
   "event": "ordinary_request",
   "block": "board_games.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Teenagers often like games with a bit of edge, like bluffing, betrayal or secret roles, rather than ones that feel like school.",
   "est_sec": 6.92,
   "gap_before": 1.14,
   "role": "reply",
   "block": "board_games.dlg10"
  },
  {
   "speaker": "user",
   "text": "Hold on, really?",
   "est_sec": 1.03,
   "gap_before": 0.98,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_11",
   "block": "board_games.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Let me double-check. I'd still stand by it, but tell me what you heard.",
   "est_sec": 4.44,
   "gap_before": 0.48,
   "role": "reply",
   "block": "board_games.dlg10"
  },
  {
   "speaker": "user",
   "text": "Betrayal. Great. Just what we need at dinner.",
   "est_sec": 2.58,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "board_games.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "It's surprisingly good for families. Everyone gets to be sneaky, and the parents usually look silly, which teens enjoy.",
   "est_sec": 5.99,
   "gap_before": 1.48,
   "role": "reply",
   "block": "board_games.dlg10"
  },
  {
   "speaker": "user",
   "text": "Oh, they'd love watching me fail at lying.",
   "est_sec": 2.58,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "board_games.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Or let them pick the game for one night, even if it's a video game turned board game. Ownership helps a lot.",
   "est_sec": 7.23,
   "gap_before": 0.42,
   "role": "reply",
   "block": "board_games.dlg10"
  },
  {
   "speaker": "user",
   "text": "And if they still",
   "est_sec": 1.34,
   "gap_before": 0.36,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg10"
  },
  {
   "speaker": "user",
   "text": "roll their eyes?",
   "est_sec": 1.03,
   "gap_before": 2.26,
   "event": "ordinary_request",
   "block": "board_games.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Keep it short and don't push. Invite their friends too, teens are much keener when it's not just family.",
   "est_sec": 5.99,
   "gap_before": 0.59,
   "role": "reply",
   "block": "board_games.dlg10"
  }
 ]
}
