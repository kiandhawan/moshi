 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.35,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.94,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "yo, how do I get a clean shot of my mate doing a kickflip? every pic is just a smear",
   "est_sec": 6.3,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "photography.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Use burst mode. Hold the shutter down and your phone fires off lots of frames, then you pick the one where the board is mid flip.",
   "est_sec": 8.16,
   "gap_before": 1.62,
   "role": "reply",
   "block": "photography.dlg5"
  },
  {
   "speaker": "user",
   "text": "oh sick. where do I stand though",
   "est_sec": 2.27,
   "gap_before": 1.66,
   "event": "ordinary_request",
   "block": "photography.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Get low, almost on the ground, a few metres to the side. It makes the jump look way higher than it is.",
   "est_sec": 6.92,
   "gap_before": 0.97,
   "role": "reply",
   "block": "photography.dlg5"
  },
  {
   "speaker": "user",
   "text": "won't I get run over",
   "est_sec": 1.65,
   "gap_before": 0.6,
   "event": "ordinary_request",
   "block": "photography.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Only if you're in his landing spot. Ask him where he's coming down and stay well clear of that line.",
   "est_sec": 6.3,
   "gap_before": 0.38,
   "role": "reply",
   "block": "photography.dlg5"
  },
  {
   "speaker": "user",
   "text": "fair. and it's kinda",
   "est_sec": 1.34,
   "gap_before": 1.17,
   "event": "distractor",
   "kind": "pause",
   "block": "photography.dlg5"
  },
  {
   "speaker": "user",
   "text": "dark under the bridge where we skate",
   "est_sec": 2.27,
   "gap_before": 2.68,
   "event": "ordinary_request",
   "block": "photography.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Then go earlier while there's daylight, or tap the screen on him so the phone exposes for him and not the bright sky behind.",
   "est_sec": 7.54,
