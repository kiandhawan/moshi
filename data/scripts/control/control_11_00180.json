 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.6,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.3,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "My yoga mat smells like feet. Can I put it in the washing machine?",
   "est_sec": 4.44,
   "gap_before": 0.51,
   "event": "ordinary_request",
   "block": "cleaning.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "Better not, it can tear or lose its grip. Mix water with a little gentle soap in a spray bottle.",
   "est_sec": 6.3,
   "gap_before": 1.17,
   "role": "reply",
   "block": "cleaning.dlg24"
  },
  {
   "speaker": "user",
   "text": "Then just spray and wipe?",
   "est_sec": 1.65,
   "gap_before": 0.59,
   "event": "ordinary_request",
   "block": "cleaning.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "Spray both sides, wipe with a soft cloth, and let it air dry hanging over a chair. Out of direct sun, which can crack it.",
   "est_sec": 7.85,
   "gap_before": 1.28,
   "role": "reply",
   "block": "cleaning.dlg24"
  },
  {
   "speaker": "user",
   "text": "Can I add, like,",
   "est_sec": 1.34,
   "gap_before": 1.18,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg24"
  },
  {
   "speaker": "user",
   "text": "a nice smell?",
   "est_sec": 1.03,
   "gap_before": 1.59,
   "event": "ordinary_request",
   "block": "cleaning.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "A couple of drops of tea tree or lavender oil in the spray works, and tea tree is mildly antibacterial too.",
   "est_sec": 6.61,
   "gap_before": 0.46,
   "role": "reply",
   "block": "cleaning.dlg24"
  },
  {
   "speaker": "user",
   "text": "Lavender. Very zen.",
   "est_sec": 1.03,
   "gap_before": 0.49,
   "block": "cleaning.dlg24"
  }
 ]
