 "est_speech_sec": 48.73,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.65,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "Gran's old upright piano hasn't been tuned in about twenty years. Is it a lost cause?",
   "est_sec": 5.06,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "music.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Not necessarily. Many old pianos come back nicely, though it might need a few tunings to settle.",
   "est_sec": 5.37,
   "gap_before": 1.19,
   "role": "reply",
   "block": "music.dlg26"
  },
  {
   "speaker": "user",
   "text": "Why a few?",
   "est_sec": 1.03,
   "gap_before": 0.87,
   "event": "ordinary_request",
   "block": "music.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "After so long, the strings have dropped way below pitch. Pulling them up all at once is risky, so tuners often do it in stages.",
   "est_sec": 7.85,
   "gap_before": 0.81,
   "role": "reply",
   "block": "music.dlg26"
  },
  {
   "speaker": "user",
   "text": "Hold on, that's not right.",
   "est_sec": 1.65,
   "gap_before": 0.96,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_07",
   "block": "music.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "I'm fairly sure about it, but I could be wrong. What sounds off to you?",
   "est_sec": 4.75,
   "gap_before": 0.52,
   "role": "reply",
   "block": "music.dlg26"
  },
  {
   "speaker": "user",
   "text": "Is it expensive?",
   "est_sec": 1.03,
   "gap_before": 0.72,
   "event": "ordinary_request",
   "block": "music.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "A single tuning isn't too bad, but if it needs repairs as well, it adds up. A tuner can tell you on the first visit if it's worth it.",
   "est_sec": 9.09,
   "gap_before": 0.41,
   "role": "reply",
   "block": "music.dlg26"
  },
  {
   "speaker": "user",
   "text": "I'd love to keep it. It",
   "est_sec": 1.96,
   "gap_before": 0.31,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg26"
  },
  {
   "speaker": "user",
   "text": "was the centre of every Christmas.",
   "est_sec": 1.96,
   "gap_before": 2.61,
   "event": "ordinary_request",
   "block": "music.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Then it's worth a look. Even if it's not perfect, it carries a lot of memories, and that matters too.",
   "est_sec": 6.3,
   "gap_before": 0.94,
   "role": "reply",
   "block": "music.dlg26"
  }
 ]
}
