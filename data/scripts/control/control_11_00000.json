 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.47,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.42,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "Can I bring my baby's pram onto the bus folded or does it have to be folded?",
   "est_sec": 5.37,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "public_transport.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Ha, I think you mean unfolded? On many buses, yes, there's a space for prams and wheelchairs.",
   "est_sec": 5.37,
   "gap_before": 0.51,
   "role": "reply",
   "block": "public_transport.dlg29"
  },
  {
   "speaker": "user",
   "text": "Yes, sorry, unfolded. Long day.",
   "est_sec": 1.65,
   "gap_before": 1.31,
   "event": "ordinary_request",
   "block": "public_transport.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "No worries. Wheelchair users usually get priority for that space, so you might be asked to move or fold it if someone needs it.",
   "est_sec": 7.54,
   "gap_before": 1.0,
   "role": "reply",
   "block": "public_transport.dlg29"
  },
  {
   "speaker": "user",
   "text": "Fair enough. What if",
   "est_sec": 1.34,
   "gap_before": 0.91,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg29"
  },
  {
   "speaker": "user",
   "text": "it's already taken by another pram?",
   "est_sec": 1.96,
   "gap_before": 2.99,
   "event": "ordinary_request",
   "block": "public_transport.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Then you might have to wait for the next bus or fold it. Some drivers allow two if there's room.",
   "est_sec": 6.3,
   "gap_before": 0.33,
   "role": "reply",
   "block": "public_transport.dlg29"
  },
  {
   "speaker": "user",
   "text": "Got it, thanks.",
   "est_sec": 1.03,
   "gap_before": 1.45,
   "event": "ordinary_request",
   "block": "public_transport.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Hope the rest of your day is gentler.",
   "est_sec": 2.58,
   "gap_before": 0.79,
   "role": "reply",
   "block": "public_transport.dlg29"
  }
 ]
