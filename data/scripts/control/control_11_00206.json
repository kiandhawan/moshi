 "est_total_sec": 51.56,
 "est_speech_sec": 40.47,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.56,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.4,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "I get really panicky on packed trains. Like, heart racing, need to get off.",
   "est_sec": 4.44,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "public_transport.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "That sounds really hard. A few things can help. Standing near the doors gives a sense of space and an easy way out.",
   "est_sec": 7.23,
   "gap_before": 0.61,
   "role": "reply",
   "block": "public_transport.dlg15"
  },
  {
   "speaker": "user",
   "text": "I do try to stand there.",
   "est_sec": 1.96,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "public_transport.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Good. Slow breathing helps too, in for four counts and out for six. A longer out breath calms the body.",
   "est_sec": 6.3,
   "gap_before": 0.74,
   "role": "reply",
   "block": "public_transport.dlg15"
  },
  {
   "speaker": "user",
   "text": "Could I",
   "est_sec": 0.72,
   "gap_before": 2.09,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg15"
  },
  {
   "speaker": "user",
   "text": "just travel at a different time?",
   "est_sec": 1.96,
   "gap_before": 1.67,
   "event": "ordinary_request",
   "block": "public_transport.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "If your work allows it, even half an hour earlier or later can make a huge difference to the crowds.",
   "est_sec": 6.3,
   "gap_before": 0.36,
   "role": "reply",
   "block": "public_transport.dlg15"
  },
  {
   "speaker": "user",
   "text": "My boss is pretty flexible.",
   "est_sec": 1.65,
   "gap_before": 0.92,
   "event": "ordinary_request",
   "block": "public_transport.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Then that's worth asking about. And if the panic keeps getting in the way, talking to a doctor is a good idea too.",
   "est_sec": 7.23,
   "gap_before": 1.09,
   "role": "reply",
   "block": "public_transport.dlg15"
  }
 ]
}
