 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.41,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.77,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "Can I tune my guitar without a tuner? Mine's broken.",
   "est_sec": 3.2,
   "gap_before": 0.34,
   "event": "ordinary_request",
   "block": "music.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Yes, with the fifth fret method. If one string is roughly right, you can tune the others to it.",
   "est_sec": 5.99,
   "gap_before": 1.16,
   "role": "reply",
   "block": "music.dlg5"
  },
  {
   "speaker": "user",
   "text": "How does that work?",
   "est_sec": 1.34,
   "gap_before": 3.42,
   "event": "ordinary_request",
   "block": "music.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Press the low string at the fifth fret, and the note should match the next string played open. Adjust that next string until they sound the same.",
   "est_sec": 8.47,
   "gap_before": 0.4,
   "role": "reply",
   "block": "music.dlg5"
  },
  {
   "speaker": "user",
   "text": "And then keep",
   "est_sec": 1.03,
   "gap_before": 0.6,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg5"
  },
  {
   "speaker": "user",
   "text": "going across the strings?",
   "est_sec": 1.34,
   "gap_before": 2.45,
   "event": "ordinary_request",
   "block": "music.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Exactly, all the way across. Except the second thinnest string, for that one you use the fourth fret instead of the fifth.",
   "est_sec": 6.92,
   "gap_before": 1.96,
   "role": "reply",
   "block": "music.dlg5"
  },
  {
   "speaker": "user",
   "text": "Why's that one different?",
   "est_sec": 1.34,
   "gap_before": 0.62,
   "event": "ordinary_request",
   "block": "music.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "It's just how guitars are tuned, that gap is a bit smaller. Also, a free tuner app on your phone does the job in a pinch.",
   "est_sec": 8.16,
   "gap_before": 1.13,
   "role": "reply",
   "block": "music.dlg5"
  }
 ]
}
