 "est_speech_sec": 37.37,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.4,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.97,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "I'm in Vienna for work and have Saturday to myself. I've never travelled alone.",
   "est_sec": 4.44,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "That's a great chance. Start with a walking tour in the morning, it's a nice way to get your bearings.",
   "est_sec": 6.3,
   "gap_before": 0.32,
   "role": "reply",
   "block": "weekend_plans.dlg16"
  },
  {
   "speaker": "user",
   "text": "Eating alone in restaurants feels awkward.",
   "est_sec": 1.96,
   "gap_before": 0.7,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Lunch alone is often easier than dinner. Sit at a counter or by a window, and take a book.",
   "est_sec": 5.99,
   "gap_before": 0.97,
   "role": "reply",
   "block": "weekend_plans.dlg16"
  },
  {
   "speaker": "user",
   "text": "Oh, I like the book idea.",
   "est_sec": 1.96,
   "gap_before": 0.74,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Cafes in Vienna are perfect for that. People sit for hours with a coffee and a cake.",
   "est_sec": 5.37,
   "gap_before": 0.98,
   "role": "reply",
   "block": "weekend_plans.dlg16"
  },
  {
   "speaker": "user",
   "text": "Any museum",
   "est_sec": 0.72,
   "gap_before": 1.39,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg16"
  },
  {
   "speaker": "user",
   "text": "I absolutely shouldn't miss?",
   "est_sec": 1.34,
   "gap_before": 1.98,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Pick one big one and give it a couple of hours, rather than rushing through three. Leave time to just wander.",
   "est_sec": 6.61,
   "gap_before": 0.74,
   "role": "reply",
   "block": "weekend_plans.dlg16"
  }
 ]
}
