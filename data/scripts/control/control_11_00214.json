 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.79,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.31,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "I've got a recipe for a big round cake but I only own a small loaf tin.",
   "est_sec": 5.37,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "baking.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "You can usually make it work. Fill the tin about two thirds full and bake any extra batter as a few cupcakes.",
   "est_sec": 6.92,
   "gap_before": 1.03,
   "role": "reply",
   "block": "baking.dlg12"
  },
  {
   "speaker": "user",
   "text": "Will the time change?",
   "est_sec": 1.34,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "baking.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Yes. A loaf is deeper, so lower the oven a little and expect it to take longer, maybe fifteen minutes or so extra.",
   "est_sec": 7.23,
   "gap_before": 0.88,
   "role": "reply",
   "block": "baking.dlg12"
  },
  {
   "speaker": "user",
   "text": "How will I know",
   "est_sec": 1.34,
   "gap_before": 1.07,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg12"
  },
  {
   "speaker": "user",
   "text": "it's done in the middle?",
   "est_sec": 1.65,
   "gap_before": 2.72,
   "event": "ordinary_request",
   "block": "baking.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "A skewer in the centre should come out clean, and the top should spring back when you press it gently. If the top browns too fast, lay foil over it.",
   "est_sec": 9.4,
   "gap_before": 1.16,
   "role": "reply",
   "block": "baking.dlg12"
  }
 ]
