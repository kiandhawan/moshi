 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.58,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.69,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "How do you clean a mattress? I've never done it in my life.",
   "est_sec": 4.13,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "cleaning.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Most people haven't. Strip the bed, vacuum the mattress with the upholstery tool, especially the seams.",
   "est_sec": 5.06,
   "gap_before": 0.44,
   "role": "reply",
   "block": "cleaning.dlg12"
  },
  {
   "speaker": "user",
   "text": "Then what?",
   "est_sec": 0.72,
   "gap_before": 0.86,
   "event": "ordinary_request",
   "block": "cleaning.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Sprinkle baking soda over the top, leave it for a few hours, then vacuum it up. It freshens it nicely.",
   "est_sec": 6.3,
   "gap_before": 1.2,
   "role": "reply",
   "block": "cleaning.dlg12"
  },
  {
   "speaker": "user",
   "text": "There's a yellow stain on one side. Can't remember",
   "est_sec": 2.89,
   "gap_before": 0.9,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg12"
  },
  {
   "speaker": "user",
   "text": "from what.",
   "est_sec": 0.72,
   "gap_before": 2.24,
   "event": "ordinary_request",
   "block": "cleaning.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Dab it with a mild mix of washing-up liquid and cool water, don't soak it. Then let it dry fully before the sheets go back on.",
   "est_sec": 8.16,
   "gap_before": 0.58,
   "role": "reply",
   "block": "cleaning.dlg12"
  },
  {
   "speaker": "user",
   "text": "I'll do it while I'm at work. Leave the window open.",
   "est_sec": 3.51,
   "gap_before": 2.01,
   "event": "ordinary_request",
   "block": "cleaning.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Ideal. Fresh air helps it dry too.",
   "est_sec": 2.27,
   "gap_before": 1.12,
   "role": "reply",
   "block": "cleaning.dlg12"
  }
 ]
}
