 "est_total_sec": 53.27,
 "est_speech_sec": 42.23,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.66,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.56,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "We're having friends over in the garden on Sunday. Gusts are forecast. Can I still put the gazebo up?",
   "est_sec": 5.99,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "weather_plans.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "It depends how strong. Pop up gazebos can turn into kites in quite modest winds.",
   "est_sec": 4.75,
   "gap_before": 1.86,
   "role": "reply",
   "block": "weather_plans.dlg12"
  },
  {
   "speaker": "user",
   "text": "The app says gusts up to thirty miles an hour.",
   "est_sec": 3.2,
   "gap_before": 1.22,
   "event": "ordinary_request",
   "block": "weather_plans.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "That's too much for a typical garden gazebo. I'd leave it packed away.",
   "est_sec": 4.13,
   "gap_before": 0.99,
   "role": "reply",
   "block": "weather_plans.dlg12"
  },
  {
   "speaker": "user",
   "text": "But what if it rains?",
   "est_sec": 1.65,
   "gap_before": 0.41,
   "event": "ordinary_request",
   "block": "weather_plans.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Keep the gazebo as a plan B and only put it up if the wind drops. Have the back door open so people can step inside.",
   "est_sec": 8.16,
   "gap_before": 0.39,
   "role": "reply",
   "block": "weather_plans.dlg12"
  },
  {
   "speaker": "user",
   "text": "Should I tie it down?",
   "est_sec": 1.65,
   "gap_before": 1.36,
   "event": "ordinary_request",
   "block": "weather_plans.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "If you do put it up, weigh every leg with sandbags or water weights and use guy ropes. And take it down if the gusts pick up.",
   "est_sec": 8.47,
   "gap_before": 1.52,
   "role": "reply",
   "block": "weather_plans.dlg12"
  }
 ]
}
