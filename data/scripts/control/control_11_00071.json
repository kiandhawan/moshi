 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.35,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.57,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "I'm thinking about getting an electric car. Is it a bad idea if I live in a flat?",
   "est_sec": 5.68,
   "gap_before": 0.22,
   "event": "ordinary_request",
   "block": "cars.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Not necessarily. The main question is where you'd charge it. Is there a charger near your building or at work?",
   "est_sec": 6.3,
   "gap_before": 0.91,
   "role": "reply",
   "block": "cars.dlg2"
  },
  {
   "speaker": "user",
   "text": "There's one at the supermarket down the road.",
   "est_sec": 2.58,
   "gap_before": 1.64,
   "event": "ordinary_request",
   "block": "cars.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "That can work if you don't drive much. A quick charge while you shop a couple of times a week covers a lot of city driving.",
   "est_sec": 8.16,
   "gap_before": 1.14,
   "role": "reply",
   "block": "cars.dlg2"
  },
  {
   "speaker": "user",
   "text": "I mostly just commute, maybe",
   "est_sec": 1.65,
   "gap_before": 0.88,
   "event": "distractor",
   "kind": "pause",
   "block": "cars.dlg2"
  },
  {
   "speaker": "user",
   "text": "thirty miles a day.",
   "est_sec": 1.34,
   "gap_before": 1.66,
   "event": "ordinary_request",
   "block": "cars.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "That's very doable. Most electric cars would only need charging once or twice a week for that.",
   "est_sec": 5.37,
   "gap_before": 0.82,
   "role": "reply",
   "block": "cars.dlg2"
  },
  {
   "speaker": "user",
   "text": "Actually, what about a hybrid instead? Less hassle?",
   "est_sec": 2.58,
   "gap_before": 2.64,
   "event": "ordinary_request",
   "block": "cars.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "A hybrid is a nice middle ground. You'd never worry about charging, though you'd save a bit less on fuel.",
   "est_sec": 6.3,
   "gap_before": 0.52,
   "role": "reply",
   "block": "cars.dlg2"
  }
 ]
}
