 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.56,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.68,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "What's an emergency fund supposed to cover exactly?",
   "est_sec": 2.58,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "personal_finance.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Unexpected costs you can't put off. Things like a broken boiler, car repairs, or losing your job.",
   "est_sec": 5.37,
   "gap_before": 0.63,
   "role": "reply",
   "block": "personal_finance.dlg17"
  },
  {
   "speaker": "user",
   "text": "Does a new phone count?",
   "est_sec": 1.65,
   "gap_before": 1.18,
   "event": "ordinary_request",
   "block": "personal_finance.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "If your phone breaks and you need it for work, maybe. A shiny upgrade, probably not.",
   "est_sec": 5.06,
   "gap_before": 1.02,
   "role": "reply",
   "block": "personal_finance.dlg17"
  },
  {
   "speaker": "user",
   "text": "Hang on, I missed that.",
   "est_sec": 1.65,
   "gap_before": 2.73,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_04",
   "block": "personal_finance.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Sure, here it is again. If your phone breaks and you need it for work, maybe. A shiny upgrade, probably not.",
   "est_sec": 6.61,
   "gap_before": 1.11,
   "role": "reply",
   "block": "personal_finance.dlg17"
  },
  {
   "speaker": "user",
   "text": "How much should be in it?",
   "est_sec": 1.96,
   "gap_before": 1.34,
   "event": "ordinary_request",
   "block": "personal_finance.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "A common goal is three to six months of essential costs. But even one month is a huge help.",
   "est_sec": 5.99,
   "gap_before": 0.31,
   "role": "reply",
   "block": "personal_finance.dlg17"
  },
  {
   "speaker": "user",
   "text": "Six months sounds",
   "est_sec": 1.03,
   "gap_before": 2.83,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg17"
  },
  {
   "speaker": "user",
   "text": "impossible right now.",
   "est_sec": 1.03,
   "gap_before": 2.57,
   "event": "ordinary_request",
   "block": "personal_finance.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Start with a smaller target, like five hundred. Once you hit it, aim for one month, then build up.",
   "est_sec": 5.99,
   "gap_before": 0.56,
   "role": "reply",
   "block": "personal_finance.dlg17"
  }
 ]
}
