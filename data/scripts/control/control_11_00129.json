 "est_total_sec": 57.13,
 "est_speech_sec": 42.84,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.8,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.91,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "Why does my washing machine smell like a swamp? It's supposed to clean things.",
   "est_sec": 4.44,
   "gap_before": 0.32,
   "event": "ordinary_request",
   "block": "cleaning.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Ironic, right? Usually it's damp left in the rubber seal and the detergent drawer. Mould loves it.",
   "est_sec": 5.37,
   "gap_before": 0.8,
   "role": "reply",
   "block": "cleaning.dlg7"
  },
  {
   "speaker": "user",
   "text": "Ugh. I just looked in the seal. There's black gunk.",
   "est_sec": 3.2,
   "gap_before": 1.42,
   "event": "ordinary_request",
   "block": "cleaning.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Wipe it out with a cloth and some diluted white vinegar. Then pull out the detergent drawer and rinse it under hot water.",
   "est_sec": 7.23,
   "gap_before": 0.74,
   "role": "reply",
   "block": "cleaning.dlg7"
  },
  {
   "speaker": "user",
   "text": "Wait, are you sure about that?",
   "est_sec": 1.96,
   "gap_before": 0.97,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_08",
   "block": "cleaning.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Let me double-check. I'd still stand by it, but tell me what you heard.",
   "est_sec": 4.44,
   "gap_before": 0.56,
   "role": "reply",
   "block": "cleaning.dlg7"
  },
  {
   "speaker": "user",
   "text": "Anything else?",
   "est_sec": 0.72,
   "gap_before": 0.97,
   "event": "ordinary_request",
   "block": "cleaning.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Run an empty hot wash, the hottest setting. And afterwards, leave the door and drawer open a crack so it can dry.",
   "est_sec": 6.92,
   "gap_before": 0.7,
   "role": "reply",
   "block": "cleaning.dlg7"
  },
  {
   "speaker": "user",
   "text": "I always shut it. I thought that",
   "est_sec": 2.27,
   "gap_before": 1.07,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg7"
  },
  {
   "speaker": "user",
   "text": "was tidier.",
   "est_sec": 0.72,
   "gap_before": 2.82,
   "event": "ordinary_request",
   "block": "cleaning.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Very common. A little open door is the secret.",
   "est_sec": 2.89,
   "gap_before": 0.71,
   "role": "reply",
   "block": "cleaning.dlg7"
  }
 ]
}
