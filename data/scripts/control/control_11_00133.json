 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.91,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "Can you freeze bread dough? I'd love fresh bread on weekdays without the effort.",
   "est_sec": 4.44,
   "gap_before": 0.4,
   "event": "ordinary_request",
   "block": "baking.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "You can. Freeze it after the first rise and shaping, wrapped tightly. It keeps for about a month.",
   "est_sec": 5.68,
   "gap_before": 1.87,
   "role": "reply",
   "block": "baking.dlg15"
  },
  {
   "speaker": "user",
   "text": "Then what, just bake it frozen?",
   "est_sec": 1.96,
   "gap_before": 1.42,
   "event": "ordinary_request",
   "block": "baking.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Better to thaw it in the fridge overnight, then let it rise on the counter for an hour or two before baking.",
   "est_sec": 6.92,
   "gap_before": 0.83,
   "role": "reply",
   "block": "baking.dlg15"
  },
  {
   "speaker": "user",
   "text": "Does the yeast",
   "est_sec": 1.03,
   "gap_before": 0.94,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg15"
  },
  {
   "speaker": "user",
   "text": "survive the freezer?",
   "est_sec": 1.03,
   "gap_before": 1.81,
   "event": "ordinary_request",
   "block": "baking.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Most of it does, though some dies off. Adding a little extra yeast to dough you plan to freeze helps.",
   "est_sec": 6.3,
   "gap_before": 1.11,
   "role": "reply",
   "block": "baking.dlg15"
  },
  {
   "speaker": "user",
   "text": "Or I could freeze baked loaves?",
   "est_sec": 1.96,
   "gap_before": 0.89,
   "event": "ordinary_request",
   "block": "baking.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "That's even easier. Slice them first, then you can toast slices straight from frozen.",
   "est_sec": 4.44,
   "gap_before": 0.61,
   "role": "reply",
   "block": "baking.dlg15"
  }
 ]
}
