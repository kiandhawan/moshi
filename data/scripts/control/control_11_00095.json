 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.33,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.32,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "Why do people keep telling me to take meter readings on moving day?",
   "est_sec": 4.13,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "moving_house.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "So you only pay for the energy you used. Without readings, you might be charged for the last tenant's use, or the next one's.",
   "est_sec": 7.54,
   "gap_before": 1.07,
   "role": "reply",
   "block": "moving_house.dlg22"
  },
  {
   "speaker": "user",
   "text": "Where's the meter, though?",
   "est_sec": 1.34,
   "gap_before": 0.68,
   "event": "ordinary_request",
   "block": "moving_house.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Often in a cupboard under the stairs, in the hall, or in a box outside. Ask the landlord or agent if you can't find it.",
   "est_sec": 7.85,
   "gap_before": 1.93,
   "role": "reply",
   "block": "moving_house.dlg22"
  },
  {
   "speaker": "user",
   "text": "Do I just write it down?",
   "est_sec": 1.96,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "moving_house.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Take a clear photo with the date on it, then send the readings to your energy supplier.",
   "est_sec": 5.37,
   "gap_before": 0.4,
   "role": "reply",
   "block": "moving_house.dlg22"
  },
  {
   "speaker": "user",
   "text": "Both places? Old",
   "est_sec": 1.03,
   "gap_before": 0.33,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg22"
  },
  {
   "speaker": "user",
   "text": "and new?",
   "est_sec": 0.72,
   "gap_before": 2.24,
   "event": "ordinary_request",
   "block": "moving_house.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Yes, both. A final reading at the old place and a first reading at the new one.",
   "est_sec": 5.37,
   "gap_before": 0.59,
   "role": "reply",
   "block": "moving_house.dlg22"
  }
 ]
}
