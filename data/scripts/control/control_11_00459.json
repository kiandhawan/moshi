 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.45,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.78,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I want to do something spontaneous this weekend. Like hop on a train somewhere.",
   "est_sec": 4.44,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Love that. Pick a direction, look at towns within two hours, and choose one you've never been to.",
   "est_sec": 5.68,
   "gap_before": 1.09,
   "role": "reply",
   "block": "weekend_plans.dlg30"
  },
  {
   "speaker": "user",
   "text": "Is it expensive on the day?",
   "est_sec": 1.96,
   "gap_before": 1.16,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "It can be. Off peak tickets are cheaper, so travel after the morning rush.",
   "est_sec": 4.44,
   "gap_before": 0.6,
   "role": "reply",
   "block": "weekend_plans.dlg30"
  },
  {
   "speaker": "user",
   "text": "Should I",
   "est_sec": 0.72,
   "gap_before": 0.81,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg30"
  },
  {
   "speaker": "user",
   "text": "book a place to stay?",
   "est_sec": 1.65,
   "gap_before": 2.37,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "If you want to stay overnight, look in the morning. You'll often find last minute deals.",
   "est_sec": 5.06,
   "gap_before": 0.73,
   "role": "reply",
   "block": "weekend_plans.dlg30"
  },
  {
   "speaker": "user",
   "text": "And if the town's boring?",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Then walk, find a cafe, and get the next train somewhere else. That's half the adventure.",
   "est_sec": 5.06,
   "gap_before": 0.4,
   "role": "reply",
   "block": "weekend_plans.dlg30"
  }
 ]
}
