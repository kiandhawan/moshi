 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.41,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.96,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "What's the deal with liquids in hand luggage? I keep getting stuff taken off me.",
   "est_sec": 4.75,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "travel_planning.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Most airports allow containers up to a hundred millilitres each, all in one small clear bag.",
   "est_sec": 5.06,
   "gap_before": 1.74,
   "role": "reply",
   "block": "travel_planning.dlg7"
  },
  {
   "speaker": "user",
   "text": "Even toothpaste?",
   "est_sec": 0.72,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "travel_planning.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Yes, toothpaste counts as a liquid. So do creams, gels and peanut butter, oddly.",
   "est_sec": 4.44,
   "gap_before": 0.71,
   "role": "reply",
   "block": "travel_planning.dlg7"
  },
  {
   "speaker": "user",
   "text": "Peanut butter. So that's what happened.",
   "est_sec": 1.96,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "travel_planning.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Ha, that catches lots of people. Some airports with new scanners have looser rules, but it's safest to assume the old ones.",
   "est_sec": 6.92,
   "gap_before": 0.41,
   "role": "reply",
   "block": "travel_planning.dlg7"
  },
  {
   "speaker": "user",
   "text": "What about my",
   "est_sec": 1.03,
   "gap_before": 0.38,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg7"
  },
  {
   "speaker": "user",
   "text": "um, contact lens solution?",
   "est_sec": 1.34,
   "gap_before": 2.53,
   "event": "ordinary_request",
   "block": "travel_planning.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Get a travel size bottle under a hundred millilitres, or buy a big one when you land.",
   "est_sec": 5.37,
   "gap_before": 0.78,
   "role": "reply",
   "block": "travel_planning.dlg7"
  }
 ]
}
