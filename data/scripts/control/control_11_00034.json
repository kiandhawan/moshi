 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.37,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "I'm turning forty and I kind of don't want a party at all.",
   "est_sec": 4.13,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "That's completely okay. Some people prefer something quiet. What would make the day feel good to you?",
   "est_sec": 5.37,
   "gap_before": 0.47,
   "role": "reply",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "user",
   "text": "Honestly, a good meal and a day off with no phone.",
   "est_sec": 3.51,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "That sounds wonderful. You could plan a day trip somewhere new and finish with dinner at your favorite place.",
   "est_sec": 5.99,
   "gap_before": 0.89,
   "role": "reply",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "user",
   "text": "My family will be upset if I don't celebrate",
   "est_sec": 2.89,
   "gap_before": 0.77,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "user",
   "text": "at least a little.",
   "est_sec": 1.34,
   "gap_before": 2.6,
   "event": "ordinary_request",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Maybe a small family dinner the weekend after. That way they get to celebrate you, and you still get your quiet day.",
   "est_sec": 6.92,
   "gap_before": 0.36,
   "role": "reply",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "user",
   "text": "Yeah, that could work.",
   "est_sec": 1.34,
   "gap_before": 0.99,
   "event": "ordinary_request",
   "block": "birthday_party.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "It's your birthday, so do it your way. Forty is a good year to start that habit.",
   "est_sec": 5.37,
   "gap_before": 0.72,
   "role": "reply",
   "block": "birthday_party.dlg4"
  }
 ]
}
