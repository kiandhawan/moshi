   "event": "greeting_answer",
   "phrasing": "greet_ans_18"
  },
  {
   "speaker": "user",
   "text": "My old tent finally ripped. I need a new one before the trip.",
   "est_sec": 4.13,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "camping.ctx2"
  },
  {
   "speaker": "moshi",
   "text": "Sorry to hear it. How many people should it sleep, and will you be carrying it far or just parking next to it?",
   "est_sec": 7.23,
   "gap_before": 0.93,
   "role": "reply",
   "block": "camping.ctx2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Oh, I have to get this. Please wait quietly until I'm off the phone.",
   "est_sec": 4.44,
   "gap_before": 0.57,
   "event": "instruction",
   "kind": "phone_call",
   "phrasing": "phone_instr_04"
  },
  {
   "speaker": "user",
   "text": "Hey!",
   "est_sec": 0.41,
   "gap_before": 1.26,
   "phrasing": "call_03"
  },
  {
   "speaker": "user",
   "text": "Sorry, you cut out there. Okay, you're back.",
   "est_sec": 2.58,
   "gap_before": 2.89,
   "phrasing": "call_03",
   "event": "distractor",
   "kind": "near_miss"
  },
  {
   "speaker": "user",
   "text": "I said I'll be there at seven.",
   "est_sec": 2.27,
   "gap_before": 2.72,
   "phrasing": "call_03"
  },
  {
   "speaker": "user",
   "text": "Can you pick up some bread on the way?",
   "est_sec": 2.89,
   "gap_before": 2.45,
   "phrasing": "call_03",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "user",
   "text": "Perfect, see you.",
   "est_sec": 1.03,
   "gap_before": 2.47,
   "phrasing": "call_03"
  },
  {
   "speaker": "user",
   "text": "Okay, sorry, where were we again?",
   "est_sec": 1.96,
   "gap_before": 1.73,
   "event": "return_cue",
   "kind": "implicit",
   "phrasing": "implicit_05"
  },
  {
