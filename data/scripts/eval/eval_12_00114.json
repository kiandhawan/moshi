 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how have things been?",
   "est_sec": 1.96,
   "gap_before": 0.58,
   "role": "greeting",
   "phrasing": "greet_27",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Doing okay, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.61,
   "event": "greeting_answer",
   "phrasing": "greet_ans_03"
  },
  {
   "speaker": "user",
   "text": "My old tent finally ripped. I need a new one before the trip.",
   "est_sec": 4.13,
   "gap_before": 0.4,
   "event": "ordinary_request",
   "block": "camping.ctx2"
  },
  {
   "speaker": "moshi",
   "text": "Sorry to hear it. How many people should it sleep, and will you be carrying it far or just parking next to it?",
   "est_sec": 7.23,
   "gap_before": 1.14,
   "role": "reply",
   "block": "camping.ctx2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I need to think. Give me fifteen seconds and then ask me again.",
   "est_sec": 4.13,
   "gap_before": 1.39,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 15,
   "phrasing": "think_instr_12"
  },
  {
   "speaker": "moshi",
   "text": "Alright, go ahead.",
   "est_sec": 1.03,
   "gap_before": 0.67,
   "role": "ack",
   "phrasing": "ack_15",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Sorry, ten more seconds.",
   "est_sec": 1.34,
   "event": "extension",
   "extra_sec": 10,
   "phrasing": "extension_07",
   "anchor": {
    "turn": 4,
    "offset": 13.36
   }
  },
  {
   "speaker": "moshi",
   "text": "So, any thoughts on the tent? Size, and backpacking or car camping?",
   "est_sec": 3.82,
   "role": "resume",
   "block": "camping.ctx2",
   "anchor": {
    "turn": 6,
    "offset": 10.03
   },
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Two people, and we'll hike in about five miles.",
   "est_sec": 2.89,
   "gap_before": 0.81,
   "event": "ordinary_request",
   "block": "camping.ctx2"
  },
  {
   "speaker": "moshi",
   "text": "Then look for a light two-person backpacking tent, ideally under four pounds.",
   "est_sec": 3.82,
   "gap_before": 1.02,
