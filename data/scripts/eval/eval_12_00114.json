 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, what's up? How are you doing?",
   "est_sec": 2.27,
   "gap_before": 0.33,
   "role": "greeting",
   "phrasing": "greet_24",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Fine, thanks.",
   "est_sec": 0.72,
   "gap_before": 0.46,
   "event": "greeting_answer",
   "phrasing": "greet_ans_09"
  },
  {
   "speaker": "user",
   "text": "I'm going to be late to a wedding ceremony. Like, fifteen minutes. What do I do?",
   "est_sec": 5.06,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "wedding_planning.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Don't panic. If the ceremony has started, wait at the back until there's a natural pause, like between readings, then slip into a seat at the back.",
   "est_sec": 8.47,
   "gap_before": 0.44,
   "role": "reply",
   "block": "wedding_planning.dlg5",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Not walk in during the vows?",
   "est_sec": 1.96,
   "gap_before": 0.64,
   "event": "ordinary_request",
   "block": "wedding_planning.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Definitely not during the vows or the processional. Ushers can usually help you time it.",
   "est_sec": 4.75,
   "gap_before": 0.41,
   "role": "reply",
   "block": "wedding_planning.dlg5",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Should I text the couple?",
   "est_sec": 1.65,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "wedding_planning.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "No, they're busy getting married. Text a friend who's there if you want someone to save you a seat.",
   "est_sec": 5.99,
   "gap_before": 1.03,
   "role": "reply",
   "block": "wedding_planning.dlg5",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Okay, the traffic is horrible.",
   "est_sec": 1.65,
   "gap_before": 0.65,
   "event": "ordinary_request",
   "block": "wedding_planning.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "It happens. Just apologise to the couple at the reception, briefly, and then enjoy the party.",
   "est_sec": 5.06,
   "gap_before": 0.84,
   "role": "reply",
   "block": "wedding_planning.dlg5",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Thanks. Feeling slightly less doomed.",
   "est_sec": 1.65,
   "gap_before": 2.66,
   "event": "ordinary_request",
   "block": "wedding_planning.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Nobody will mind. Drive safely, the cake isn't going anywhere.",
   "est_sec": 3.2,
   "gap_before": 1.77,
   "role": "reply",
   "block": "wedding_planning.dlg5",
   "reference_only": true
  }
 ],
