 "turns": [
  {
   "speaker": "moshi",
   "text": "Good to hear from you. How are you?",
   "est_sec": 2.58,
   "gap_before": 0.6,
   "role": "greeting",
   "phrasing": "greet_06",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm okay, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.89,
   "event": "greeting_answer",
   "phrasing": "greet_ans_21"
  },
  {
   "speaker": "user",
   "text": "My mother in law arrives Thursday and she hates clutter.",
   "est_sec": 3.2,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "family_visit.ctx4"
  },
  {
   "speaker": "moshi",
   "text": "Then the living room and the guest bath matter most. Do you want to tackle those tonight, or spread it over the next three evenings?",
   "est_sec": 7.85,
   "gap_before": 1.0,
   "role": "reply",
   "block": "family_visit.ctx4",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Wait, my friend just got here. Can you hold on and stay quiet until I'm back?",
   "est_sec": 5.06,
   "gap_before": 1.01,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_21"
  },
  {
   "speaker": "moshi",
   "text": "Take your time.",
   "est_sec": 1.03,
   "gap_before": 0.53,
   "role": "ack",
   "phrasing": "ack_09",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Where did you hide the presents this year?",
   "est_sec": 2.58,
   "gap_before": 1.48,
   "event": "distractor",
   "kind": "friend_question",
   "block": "holiday_gifts.side4"
  },
  {
   "speaker": "friend",
   "text": "Not telling you. You'd peek.",
   "est_sec": 1.65,
   "gap_before": 0.63,
   "block": "holiday_gifts.side4"
  },
  {
   "speaker": "user",
   "text": "I would not.",
   "est_sec": 1.03,
   "gap_before": 1.43,
   "block": "holiday_gifts.side4"
  },
  {
   "speaker": "friend",
   "text": "You unwrapped your own birthday present last year and taped it back up.",
   "est_sec": 4.13,
   "gap_before": 1.49,
   "block": "holiday_gifts.side4"
  },
  {
   "speaker": "user",
   "text": "Okay, fair. Can you at least tell me if they're in the house?",
   "est_sec": 4.13,
   "gap_before": 1.54,
   "event": "distractor",
   "kind": "friend_question",
   "block": "holiday_gifts.side4"
  },
  {
   "speaker": "friend",
   "text": "They're somewhere warm and dry. That's all you get.",
   "est_sec": 2.89,
   "gap_before": 1.1,
   "block": "holiday_gifts.side4"
  },
  {
   "speaker": "user",
   "text": "Are you ready? On three we lift the sofa.",
   "est_sec": 2.89,
   "gap_before": 1.33,
   "event": "distractor",
   "kind": "near_miss",
   "phrasing": "dn_81"
  },
  {
   "speaker": "friend",
   "text": "Wait, my side's slipping.",
   "est_sec": 1.34,
   "gap_before": 0.4,
   "phrasing": "dn_81"
  },
  {
   "speaker": "user",
   "text": "Okay, I'm all yours.",
   "est_sec": 1.34,
   "gap_before": 1.48,
   "event": "return_cue",
   "kind": "implicit",
   "phrasing": "implicit_03"
  },
  {
   "speaker": "moshi",
   "text": "Sure. Still need your call on the cleaning plan, one evening or three?",
   "est_sec": 4.13,
   "gap_before": 0.76,
   "role": "resume",
   "block": "family_visit.ctx4",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Tonight. If I wait I'll just panic on Wednesday.",
   "est_sec": 2.89,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "family_visit.ctx4"
  },
  {
   "speaker": "moshi",
   "text": "Fair enough. Start with the bathroom while you've still got energy.",
   "est_sec": 3.51,
   "gap_before": 1.2,
   "role": "followup",
   "block": "family_visit.ctx4",
   "reference_only": true
  }
 ],
