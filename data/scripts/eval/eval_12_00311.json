 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your week going?",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_15",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Not bad at all, thanks.",
   "est_sec": 1.65,
   "gap_before": 0.35,
   "event": "greeting_answer",
   "phrasing": "greet_ans_30"
  },
  {
   "speaker": "user",
   "text": "My chain makes this squeaking noise every time I pedal.",
   "est_sec": 3.2,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "cycling.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "That usually means it's dry. A bit of chain lube should fix it.",
   "est_sec": 4.13,
   "gap_before": 0.58,
   "role": "reply",
   "block": "cycling.dlg2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Can I just use cooking oil?",
   "est_sec": 1.96,
   "gap_before": 1.28,
   "event": "ordinary_request",
   "block": "cycling.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "I wouldn't. It gets sticky and collects dirt. Proper bike lube is cheap and lasts a long time.",
   "est_sec": 5.68,
   "gap_before": 0.61,
   "role": "reply",
   "block": "cycling.dlg2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Okay. How do I put it on?",
   "est_sec": 2.27,
   "gap_before": 1.0,
   "event": "ordinary_request",
   "block": "cycling.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Put one drop on each link while you slowly turn the pedals backward. Then wipe off the extra with a rag.",
   "est_sec": 6.61,
   "gap_before": 0.43,
   "role": "reply",
   "block": "cycling.dlg2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Should I clean it first, or",
   "est_sec": 1.96,
   "gap_before": 0.54,
   "event": "distractor",
   "kind": "pause",
   "block": "cycling.dlg2"
  },
  {
   "speaker": "user",
   "text": "is that overkill?",
   "est_sec": 1.03,
   "gap_before": 2.73,
   "event": "ordinary_request",
   "block": "cycling.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "If it looks black and gritty, wipe it down first. Otherwise you're just mixing new oil with old dirt.",
   "est_sec": 5.99,
   "gap_before": 1.37,
   "role": "reply",
   "block": "cycling.dlg2",
   "reference_only": true
  }
 ],
