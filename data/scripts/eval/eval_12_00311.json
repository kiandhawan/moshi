   "phrasing": "greet_ans_21"
  },
  {
   "speaker": "user",
   "text": "How much water should I take on a long ride?",
   "est_sec": 3.2,
   "gap_before": 0.4,
   "event": "ordinary_request",
   "block": "cycling.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Roughly one bottle per hour, more if it's hot. On a three hour ride, two bottles plus a refill stop is a good plan.",
   "est_sec": 7.54,
   "gap_before": 0.32,
   "role": "reply",
   "block": "cycling.dlg7",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I always forget to drink.",
   "est_sec": 1.65,
   "gap_before": 1.28,
   "event": "ordinary_request",
   "block": "cycling.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Set a reminder, or take a sip every time you reach a hilltop or a junction.",
   "est_sec": 5.06,
   "gap_before": 1.18,
   "role": "reply",
   "block": "cycling.dlg7",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Should I bring food too?",
