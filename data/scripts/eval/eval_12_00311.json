   "gap_before": 2.5,
   "event": "ordinary_request",
   "block": "cycling.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Yes, for anything over ninety minutes. Bananas, cereal bars, or even a small sandwich.",
   "est_sec": 4.44,
   "gap_before": 0.91,
   "role": "reply",
   "block": "cycling.dlg7",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Wait, wait, honestly I thought I could just",
