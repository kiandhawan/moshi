 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, what's up? How are you doing?",
   "est_sec": 2.27,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_24",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm doing great.",
   "est_sec": 1.03,
   "gap_before": 0.37,
   "event": "greeting_answer",
   "phrasing": "greet_ans_18"
  },
  {
   "speaker": "user",
   "text": "A colleague is leaving and I got stuck organizing her farewell lunch.",
   "est_sec": 3.82,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "restaurant_choice.ctx11"
  },
  {
   "speaker": "moshi",
   "text": "Ah, the honor. How many people, roughly?",
   "est_sec": 2.27,
   "gap_before": 1.24,
   "role": "reply",
   "block": "restaurant_choice.ctx11",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Probably about twelve.",
   "est_sec": 1.03,
   "gap_before": 0.99,
   "event": "ordinary_request",
   "block": "restaurant_choice.ctx11"
  },
  {
   "speaker": "moshi",
   "text": "Okay, twelve. Is the company paying, or is everyone covering their own?",
   "est_sec": 3.82,
   "gap_before": 0.4,
   "role": "reply",
   "block": "restaurant_choice.ctx11",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Give me thirty seconds. I'll know by then, so ask me again.",
   "est_sec": 3.82,
   "gap_before": 1.28,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 30,
   "phrasing": "think_instr_27"
  },
  {
   "speaker": "user",
   "text": "Okay, that was quick. I've got it.",
   "est_sec": 2.27,
   "anchor": {
    "turn": 6,
    "offset": 27.02
   },
   "event": "return_cue",
   "kind": "early_end",
   "phrasing": "early_end_15"
  },
  {
