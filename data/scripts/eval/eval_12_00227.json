 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How have you been lately?",
   "est_sec": 1.96,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_18",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm fine, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.73,
   "event": "greeting_answer",
   "phrasing": "greet_ans_15"
  },
  {
   "speaker": "user",
   "text": "Is Dutch or Norwegian easier for an English speaker?",
   "est_sec": 2.89,
   "gap_before": 0.23,
   "event": "ordinary_request",
   "block": "learning_language.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Both are considered fairly easy, they're close cousins of English. Norwegian grammar is often seen as a little simpler.",
   "est_sec": 5.99,
   "gap_before": 0.89,
   "role": "reply",
   "block": "learning_language.dlg12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Really? Why?",
   "est_sec": 0.72,
   "gap_before": 0.74,
   "event": "ordinary_request",
   "block": "learning_language.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Verbs don't change by person. I am, you are, he is, all use the same form. Dutch has more endings to learn.",
   "est_sec": 6.92,
   "gap_before": 0.61,
   "role": "reply",
   "block": "learning_language.dlg12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Oh, that sounds nice.",
   "est_sec": 1.34,
   "gap_before": 1.28,
   "event": "distractor",
   "kind": "pause",
   "block": "learning_language.dlg12"
  },
  {
   "speaker": "user",
   "text": "What about pronunciation?",
   "est_sec": 1.03,
   "gap_before": 2.74,
   "event": "ordinary_request",
   "block": "learning_language.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Norwegian has a sing-song pitch that takes getting used to. Dutch has some tricky throat sounds.",
   "est_sec": 5.06,
   "gap_before": 0.38,
   "role": "reply",
   "block": "learning_language.dlg12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Which one has more stuff to watch or read?",
   "est_sec": 2.89,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "learning_language.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Dutch has more speakers, so a bit more content. But both have great shows and music.",
   "est_sec": 5.06,
   "gap_before": 0.36,
   "role": "reply",
   "block": "learning_language.dlg12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Hmm. I'm leaning Norwegian.",
   "est_sec": 1.34,
   "gap_before": 1.11,
   "event": "ordinary_request",
   "block": "learning_language.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Good choice if you like it. Picking the one you enjoy matters most.",
   "est_sec": 4.13,
   "gap_before": 1.02,
   "role": "reply",
   "block": "learning_language.dlg12",
   "reference_only": true
  }
 ],
