 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how's your day going?",
   "est_sec": 1.65,
   "gap_before": 0.8,
   "role": "greeting",
   "phrasing": "greet_03",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Okay, I guess.",
   "est_sec": 1.03,
   "gap_before": 0.57,
   "event": "greeting_answer",
   "phrasing": "greet_ans_12"
  },
  {
   "speaker": "user",
   "text": "How long should I let an oil painting dry before varnishing?",
   "est_sec": 3.51,
   "gap_before": 0.22,
   "event": "ordinary_request",
   "block": "painting_art.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Usually six months to a year, depending on how thick the paint is. Oil paint dries slowly through the whole layer.",
   "est_sec": 6.61,
   "gap_before": 1.15,
   "role": "reply",
   "block": "painting_art.dlg12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Six months? I wanted to give it as a present next week.",
   "est_sec": 3.82,
   "gap_before": 2.77,
   "event": "ordinary_request",
   "block": "painting_art.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "You can still give it. Just explain it's not varnished yet, and it can be done later.",
   "est_sec": 5.37,
   "gap_before": 0.53,
   "role": "reply",
   "block": "painting_art.dlg12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Is there a temporary option?",
   "est_sec": 1.65,
   "gap_before": 1.26,
   "event": "ordinary_request",
   "block": "painting_art.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "There's retouching varnish, a thin layer you can put on once it's touch dry. It evens out the shine and protects a bit.",
   "est_sec": 7.23,
   "gap_before": 1.18,
   "role": "reply",
   "block": "painting_art.dlg12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Okay, and how will I know",
   "est_sec": 1.96,
   "gap_before": 0.79,
   "event": "distractor",
   "kind": "pause",
   "block": "painting_art.dlg12"
  },
  {
   "speaker": "user",
   "text": "it's touch dry?",
   "est_sec": 1.03,
   "gap_before": 2.09,
   "event": "ordinary_request",
   "block": "painting_art.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Press gently on a thick area with a fingertip. If no paint lifts and it doesn't feel soft, you're good.",
   "est_sec": 6.3,
   "gap_before": 1.53,
   "role": "reply",
   "block": "painting_art.dlg12",
   "reference_only": true
  }
 ],
