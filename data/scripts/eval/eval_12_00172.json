 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, what's up? How are you doing?",
   "est_sec": 2.27,
   "gap_before": 0.4,
   "role": "greeting",
   "phrasing": "greet_24",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm okay, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.46,
   "event": "greeting_answer",
   "phrasing": "greet_ans_21"
  },
  {
   "speaker": "user",
   "text": "My gran turns ninety next month and she uses a wheelchair now.",
   "est_sec": 3.82,
   "gap_before": 0.42,
   "event": "ordinary_request",
   "block": "restaurant_choice.ctx9"
  },
  {
   "speaker": "moshi",
   "text": "Then step-free access and a ground floor are must-haves. Does she prefer a long lunch or an evening dinner these days?",
   "est_sec": 6.61,
   "gap_before": 1.11,
   "role": "reply",
   "block": "restaurant_choice.ctx9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Hang on, the doorbell just rang. Don't say anything until I come back.",
   "est_sec": 4.13,
   "gap_before": 1.18,
   "event": "instruction",
   "kind": "door",
   "phrasing": "door_instr_02"
  },
  {
   "speaker": "user",
   "text": "Oh, hey, Uncle Tom.",
   "est_sec": 1.34,
   "gap_before": 2.58,
   "phrasing": "door_31"
  },
  {
   "speaker": "visitor",
   "text": "Your dad said you needed a hand with the shelves.",
   "est_sec": 3.2,
   "gap_before": 0.65,
   "phrasing": "door_31"
  },
  {
   "speaker": "user",
   "text": "He sent you? Did you bring a spirit level?",
   "est_sec": 2.89,
   "gap_before": 0.4,
   "phrasing": "door_31",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "visitor",
   "text": "Brought the whole toolbox.",
   "est_sec": 1.34,
   "gap_before": 0.32,
   "phrasing": "door_31"
  },
  {
   "speaker": "user",
   "text": "You're a lifesaver.",
   "est_sec": 1.03,
   "gap_before": 0.48,
   "phrasing": "door_31"
  },
  {
   "speaker": "user",
   "text": "Sorry, you were saying?",
   "est_sec": 1.34,
   "gap_before": 3.72,
   "event": "return_cue",
   "kind": "implicit",
   "phrasing": "implicit_13"
  },
  {
   "speaker": "moshi",
   "text": "Of course. For the ninetieth, are we picturing lunch or dinner?",
   "est_sec": 3.51,
   "gap_before": 0.31,
   "role": "resume",
   "block": "restaurant_choice.ctx9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Dinner, she still loves a night out.",
