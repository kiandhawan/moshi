 "turns": [
  {
   "speaker": "moshi",
   "text": "Good to hear from you. How are you?",
   "est_sec": 2.58,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_06",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Not bad at all, thanks.",
   "est_sec": 1.65,
   "gap_before": 0.8,
   "event": "greeting_answer",
   "phrasing": "greet_ans_30"
  },
  {
   "speaker": "user",
   "text": "How do I stop my back aching from sitting all day?",
   "est_sec": 3.51,
   "gap_before": 0.21,
   "event": "ordinary_request",
   "block": "home_office.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Start with your chair height. Your feet should be flat and your knees roughly level with your hips.",
   "est_sec": 5.68,
   "gap_before": 1.86,
   "role": "reply",
   "block": "home_office.dlg4",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "My feet don't reach the floor properly.",
   "est_sec": 2.27,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "home_office.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Then a footrest helps a lot. Even a sturdy box under the desk works.",
   "est_sec": 4.44,
   "gap_before": 1.64,
   "role": "reply",
   "block": "home_office.dlg4",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And should I sit up super straight?",
   "est_sec": 2.27,
   "gap_before": 0.9,
   "event": "ordinary_request",
   "block": "home_office.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Not rigidly. Lean back slightly against the backrest so it carries some of your weight.",
   "est_sec": 4.75,
   "gap_before": 1.14,
   "role": "reply",
   "block": "home_office.dlg4",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I also kind of",
   "est_sec": 1.34,
   "gap_before": 0.89,
   "event": "distractor",
   "kind": "pause",
   "block": "home_office.dlg4"
  },
  {
   "speaker": "user",
   "text": "slump forward when I'm concentrating.",
   "est_sec": 1.65,
   "gap_before": 2.87,
   "event": "ordinary_request",
   "block": "home_office.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Most people do. Set a timer to stand up and stretch every forty five minutes, it breaks the slump.",
   "est_sec": 5.99,
   "gap_before": 1.15,
   "role": "reply",
   "block": "home_office.dlg4",
   "reference_only": true
  }
 ],
