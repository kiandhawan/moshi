   "text": "My phone's ringing, give me a minute. Don't say anything until I'm done.",
   "est_sec": 4.13,
   "gap_before": 0.82,
   "event": "instruction",
   "kind": "phone_call",
   "phrasing": "phone_instr_02"
  },
