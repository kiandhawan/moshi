 "turns": [
  {
   "speaker": "moshi",
   "text": "Good to hear from you. How are you?",
   "est_sec": 2.58,
   "gap_before": 0.33,
   "role": "greeting",
   "phrasing": "greet_06",
   "reference_only": true
  },
  {
