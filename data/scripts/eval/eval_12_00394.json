   "role": "ack",
   "phrasing": "ack_05",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Hello, yes.",
   "est_sec": 0.72,
   "gap_before": 1.24,
   "phrasing": "call_10"
  },
  {
   "speaker": "user",
   "text": "I'm calling back about the apartment.",
