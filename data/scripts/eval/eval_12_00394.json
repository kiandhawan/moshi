 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how's your day going?",
   "est_sec": 1.65,
   "gap_before": 0.42,
   "role": "greeting",
   "phrasing": "greet_03",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "All good here.",
   "est_sec": 1.03,
   "gap_before": 0.74,
   "event": "greeting_answer",
   "phrasing": "greet_ans_27"
  },
  {
   "speaker": "user",
   "text": "Is it rude to ask for the check right after we finish eating?",
   "est_sec": 4.13,
   "gap_before": 0.22,
   "event": "ordinary_request",
   "block": "restaurant_choice.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Not at all, especially if the restaurant is busy. A simple, could we get the check when you have a moment, is perfectly polite.",
   "est_sec": 7.54,
   "gap_before": 0.42,
   "role": "reply",
   "block": "restaurant_choice.dlg3",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What about splitting the bill between five people?",
   "est_sec": 2.58,
   "gap_before": 1.5,
   "event": "ordinary_request",
   "block": "restaurant_choice.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Tell the server at the start of the meal if you can. It makes things much easier for them at the end.",
   "est_sec": 6.92,
   "gap_before": 0.43,
   "role": "reply",
   "block": "restaurant_choice.dlg3",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And how much should we",
   "est_sec": 1.65,
   "gap_before": 0.52,
   "event": "distractor",
   "kind": "pause",
   "block": "restaurant_choice.dlg3"
  },
  {
   "speaker": "user",
   "text": "tip for a big group?",
   "est_sec": 1.65,
   "gap_before": 1.61,
   "event": "ordinary_request",
   "block": "restaurant_choice.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "In the United States, eighteen to twenty percent is standard. Some places add it automatically for groups of six or more, so check the bill first.",
   "est_sec": 8.16,
   "gap_before": 1.09,
   "role": "reply",
   "block": "restaurant_choice.dlg3",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Oh, I didn't know that. Good thing I asked.",
   "est_sec": 2.89,
   "gap_before": 1.03,
   "event": "ordinary_request",
   "block": "restaurant_choice.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "It catches a lot of people out. Otherwise you might accidentally tip twice.",
   "est_sec": 4.13,
   "gap_before": 0.81,
   "role": "reply",
   "block": "restaurant_choice.dlg3",
   "reference_only": true
  }
 ],
