   "event": "greeting_answer",
   "phrasing": "greet_ans_18"
  },
  {
   "speaker": "user",
   "text": "I'm flying home to see my grandma for the holidays.",
   "est_sec": 3.2,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "family_visit.ctx2"
  },
  {
   "speaker": "moshi",
   "text": "How nice. Do you want to stay the whole week, or just a long weekend so you don't miss too much work?",
