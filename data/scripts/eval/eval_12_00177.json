 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How have you been lately?",
   "est_sec": 1.96,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_18",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm doing great.",
   "est_sec": 1.03,
