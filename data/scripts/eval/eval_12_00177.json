   "role": "reply",
   "block": "family_visit.ctx2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Good question, I hadn't really thought about that.",
   "est_sec": 2.58,
   "gap_before": 1.03,
   "event": "ordinary_request",
   "block": "family_visit.ctx2"
  },
  {
   "speaker": "moshi",
   "text": "No rush. So, a full week or a long weekend?",
   "est_sec": 3.2,
   "gap_before": 0.87,
   "role": "reply",
   "block": "family_visit.ctx2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Hmm, I need fifteen seconds to think. Ask me again after that.",
   "est_sec": 3.82,
   "gap_before": 1.05,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 15,
   "phrasing": "think_instr_03"
  },
  {
   "speaker": "user",
   "text": "Sorry, five more seconds.",
   "est_sec": 1.34,
   "event": "extension",
   "extra_sec": 5,
   "phrasing": "extension_07",
   "anchor": {
    "turn": 6,
    "offset": 13.9
   }
  },
  {
   "speaker": "moshi",
   "text": "So what do you think, the whole week at home or just a few days?",
