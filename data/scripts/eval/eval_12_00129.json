  {
   "speaker": "user",
   "text": "Okay, I guess.",
   "est_sec": 1.03,
   "gap_before": 0.46,
   "event": "greeting_answer",
   "phrasing": "greet_ans_12"
  },
  {
   "speaker": "user",
   "text": "I live in a studio. My desk has to go in the bedroom, there's no other spot.",
   "est_sec": 5.37,
   "gap_before": 0.22,
   "event": "ordinary_request",
   "block": "home_office.ctx8"
  },
  {
   "speaker": "moshi",
   "text": "Common problem. Would you prefer a folding desk you can put away each evening, or a wall mounted one that stays but takes up very little room?",
   "est_sec": 8.47,
   "gap_before": 1.82,
   "role": "reply",
   "block": "home_office.ctx8",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Wait, my friend just got here. Can you hold on and stay quiet until I'm back?",
   "est_sec": 5.06,
   "gap_before": 2.62,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_21"
  },
  {
   "speaker": "moshi",
   "text": "Sure, take your time.",
   "est_sec": 1.34,
   "gap_before": 0.21,
   "role": "ack",
   "phrasing": "ack_03",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Are you taking the bike or walking?",
   "est_sec": 2.27,
   "gap_before": 0.84,
   "event": "distractor",
   "kind": "friend_question",
   "phrasing": "dq_72"
  },
  {
   "speaker": "friend",
   "text": "Walking, the tyre's flat.",
   "est_sec": 1.34,
   "gap_before": 0.57,
   "phrasing": "dq_72"
  },
  {
   "speaker": "user",
   "text": "Who was that tutor you had for Polish? The one you liked.",
   "est_sec": 3.82,
   "gap_before": 0.9,
   "block": "learning_language.side5"
  },
  {
   "speaker": "friend",
   "text": "Agnieszka. She does lessons on video, mostly evenings.",
   "est_sec": 2.58,
   "gap_before": 3.45,
   "block": "learning_language.side5"
  },
  {
   "speaker": "user",
   "text": "Is she expensive?",
   "est_sec": 1.03,
   "gap_before": 1.29,
   "event": "distractor",
   "kind": "friend_question",
   "block": "learning_language.side5"
  },
  {
   "speaker": "friend",
   "text": "Not really, cheaper than the language school. And she's really patient.",
   "est_sec": 3.51,
   "gap_before": 1.26,
   "block": "learning_language.side5"
  },
  {
   "speaker": "user",
   "text": "Does she teach total beginners?",
   "est_sec": 1.65,
   "gap_before": 0.4,
   "event": "distractor",
   "kind": "friend_question",
   "block": "learning_language.side5"
  },
  {
   "speaker": "friend",
   "text": "She taught me, and I could barely say hello. I'll send you her number.",
   "est_sec": 4.44,
   "gap_before": 0.31,
   "block": "learning_language.side5"
  },
  {
   "speaker": "user",
   "text": "Thanks. I need someone who won't laugh at me.",
   "est_sec": 2.89,
   "gap_before": 2.87,
   "block": "learning_language.side5"
  },
