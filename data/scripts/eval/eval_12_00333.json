 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there! How's it going today?",
   "est_sec": 1.96,
   "gap_before": 0.3,
   "role": "greeting",
   "phrasing": "greet_21",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm fine, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.49,
   "event": "greeting_answer",
   "phrasing": "greet_ans_15"
  },
  {
   "speaker": "user",
   "text": "We're driving my grandpa to the coast for his ninetieth.",
   "est_sec": 3.2,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "family_visit.ctx6"
  },
  {
   "speaker": "moshi",
   "text": "What a lovely thing to do. Should we pick a route with lots of rest stops, or the faster highway with fewer breaks?",
   "est_sec": 7.23,
   "gap_before": 1.13,
   "role": "reply",
   "block": "family_visit.ctx6",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Someone's at the door, give me a second. Stay quiet until I'm back.",
   "est_sec": 4.13,
   "gap_before": 1.3,
   "event": "instruction",
   "kind": "door",
   "phrasing": "door_instr_01"
  },
  {
   "speaker": "user",
   "text": "Oh, hi, are you lost?",
   "est_sec": 1.65,
   "gap_before": 4.9,
   "phrasing": "door_42",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "visitor",
   "text": "I'm looking for my grandma's house, it has a yellow door.",
   "est_sec": 3.51,
   "gap_before": 1.48,
   "phrasing": "door_42"
  },
  {
   "speaker": "user",
   "text": "Do you know her name?",
   "est_sec": 1.65,
   "gap_before": 2.2,
   "phrasing": "door_42",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "visitor",
   "text": "Grandma Rose.",
   "est_sec": 0.72,
   "gap_before": 1.61,
   "phrasing": "door_42"
  },
  {
   "speaker": "user",
   "text": "She's at the end, I'll walk you.",
   "est_sec": 2.27,
   "gap_before": 2.63,
   "phrasing": "door_42"
  },
  {
   "speaker": "user",
   "text": "Alright, sorted. I'm back.",
   "est_sec": 1.34,
   "gap_before": 3.03,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "door_cue_07"
  },
  {
   "speaker": "moshi",
   "text": "Everything okay at the door? Your grandpa's trip to the coast, still deciding on the route?",
   "est_sec": 5.06,
   "gap_before": 1.15,
   "role": "resume",
   "block": "family_visit.ctx6",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "The slow one. He gets stiff sitting too long.",
   "est_sec": 2.89,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "family_visit.ctx6"
  },
  {
   "speaker": "moshi",
   "text": "Then plan a stop every hour or so. Maybe somewhere with a bench and a coffee.",
   "est_sec": 5.06,
   "gap_before": 0.9,
   "role": "followup",
   "block": "family_visit.ctx6",
   "reference_only": true
  }
