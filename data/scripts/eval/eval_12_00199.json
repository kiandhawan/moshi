 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How have you been lately?",
   "est_sec": 1.96,
   "gap_before": 0.45,
   "role": "greeting",
   "phrasing": "greet_18",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm doing great.",
   "est_sec": 1.03,
   "gap_before": 0.77,
   "event": "greeting_answer",
   "phrasing": "greet_ans_18"
  },
  {
   "speaker": "user",
   "text": "My old tent finally ripped. I need a new one before the trip.",
   "est_sec": 4.13,
   "gap_before": 0.4,
   "event": "ordinary_request",
   "block": "camping.ctx2"
  },
  {
   "speaker": "moshi",
   "text": "Sorry to hear it. How many people should it sleep, and will you be carrying it far or just parking next to it?",
   "est_sec": 7.23,
   "gap_before": 1.13,
   "role": "reply",
   "block": "camping.ctx2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Hold on, let me finish reading this article. I'll tell you when I'm done.",
   "est_sec": 4.44,
   "gap_before": 0.33,
   "event": "instruction",
   "kind": "reading",
   "phrasing": "read_instr_10"
  },
  {
   "speaker": "moshi",
   "text": "Sure, go ahead.",
   "est_sec": 1.03,
   "gap_before": 0.22,
   "role": "ack",
   "phrasing": "ack_08",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Huh, didn't see that coming.",
   "est_sec": 1.65,
   "anchor": {
    "turn": 4,
    "offset": 10.57
   },
   "event": "distractor",
   "kind": "self_talk",
   "phrasing": "murmur_12"
  },
  {
   "speaker": "user",
   "text": "Okay, done with the article.",
