 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's it going?",
   "est_sec": 1.34,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_09",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Okay, I guess.",
   "est_sec": 1.03,
   "gap_before": 0.79,
   "event": "greeting_answer",
   "phrasing": "greet_ans_12"
  },
  {
   "speaker": "user",
   "text": "How do I make sure my bike seat is the right height?",
   "est_sec": 3.82,
   "gap_before": 0.21,
   "event": "ordinary_request",
   "block": "cycling.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Sit on the bike with your heel on the pedal at the bottom of the stroke. Your leg should be almost straight.",
   "est_sec": 6.92,
   "gap_before": 1.05,
   "role": "reply",
   "block": "cycling.dlg4",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And when I pedal normally?",
   "est_sec": 1.65,
   "gap_before": 1.09,
   "event": "ordinary_request",
   "block": "cycling.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Then, with the ball of your foot on the pedal, you'll have a slight bend in the knee. That's the sweet spot.",
   "est_sec": 6.92,
   "gap_before": 1.1,
   "role": "reply",
   "block": "cycling.dlg4",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Wait, sorry, what was that?",
   "est_sec": 1.65,
   "gap_before": 0.41,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_03",
   "block": "cycling.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Sure, here it is again. Then, with the ball of your foot on the pedal, you'll have a slight bend in the knee. That's the sweet spot.",
   "est_sec": 8.47,
   "gap_before": 0.63,
   "role": "reply",
   "block": "cycling.dlg4",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Mine feels kind of low,",
   "est_sec": 1.65,
   "gap_before": 1.45,
   "event": "distractor",
   "kind": "pause",
   "block": "cycling.dlg4"
  },
  {
   "speaker": "user",
   "text": "my knees come up high.",
   "est_sec": 1.65,
   "gap_before": 1.99,
   "event": "ordinary_request",
   "block": "cycling.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "That's very common, and it's tiring for your legs. Raise it a couple of centimeters at a time and test ride each change.",
   "est_sec": 7.23,
   "gap_before": 0.48,
   "role": "reply",
   "block": "cycling.dlg4",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Will I still reach the ground?",
   "est_sec": 1.96,
   "gap_before": 1.26,
   "event": "ordinary_request",
   "block": "cycling.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Probably only on tiptoes, and that's normal. When you stop, slide forward off the saddle.",
   "est_sec": 4.75,
   "gap_before": 0.59,
   "role": "reply",
   "block": "cycling.dlg4",
   "reference_only": true
  }
 ],
