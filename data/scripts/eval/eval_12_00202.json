 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's it going?",
   "est_sec": 1.34,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_09",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "All good here.",
   "est_sec": 1.03,
   "gap_before": 0.68,
   "event": "greeting_answer",
   "phrasing": "greet_ans_27"
  },
  {
   "speaker": "user",
   "text": "How do I keep bears away from our food at camp?",
   "est_sec": 3.51,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "camping.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Use the bear lockers if the campground has them. Otherwise, store everything with a smell, including toothpaste, in a bear canister away from your tent.",
   "est_sec": 7.85,
   "gap_before": 0.36,
   "role": "reply",
   "block": "camping.dlg3",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "How far from the tent?",
   "est_sec": 1.65,
   "gap_before": 1.48,
   "event": "ordinary_request",
   "block": "camping.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Around two hundred feet is the usual advice, and cook downwind of where you sleep too.",
   "est_sec": 5.06,
   "gap_before": 0.83,
   "role": "reply",
   "block": "camping.dlg3",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And if we actually see one",
   "est_sec": 1.96,
   "gap_before": 0.93,
   "event": "distractor",
   "kind": "pause",
   "block": "camping.dlg3"
  },
  {
   "speaker": "user",
   "text": "what do we do?",
   "est_sec": 1.34,
   "gap_before": 1.92,
   "event": "ordinary_request",
   "block": "camping.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Stay calm, don't run, and talk in a firm voice while backing away slowly. Most black bears will leave on their own.",
   "est_sec": 6.92,
   "gap_before": 0.58,
   "role": "reply",
   "block": "camping.dlg3",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Okay, that's less scary than I thought.",
   "est_sec": 2.27,
   "gap_before": 0.95,
   "event": "ordinary_request",
   "block": "camping.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Encounters are rare when food is stored well. Just follow the campground rules and you'll be fine.",
   "est_sec": 5.37,
   "gap_before": 0.78,
   "role": "reply",
   "block": "camping.dlg3",
   "reference_only": true
  }
 ],
