   "gap_before": 0.67,
   "role": "reply",
   "block": "picnic.ctx1",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Sorry, quick call. Wait until I'm off the phone, okay?",
   "est_sec": 3.2,
   "gap_before": 0.98,
   "event": "instruction",
   "kind": "phone_call",
   "phrasing": "phone_instr_06"
  },
  {
   "speaker": "user",
   "text": "Hello, yes.",
   "est_sec": 0.72,
   "gap_before": 1.22,
   "phrasing": "call_10"
  },
  {
   "speaker": "user",
   "text": "I'm calling back about the apartment.",
