   "text": "Is it still available?",
   "est_sec": 1.34,
   "gap_before": 3.83,
   "phrasing": "call_10",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "user",
   "text": "Could I see it this weekend?",
   "est_sec": 1.96,
   "gap_before": 2.58,
   "phrasing": "call_10",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
