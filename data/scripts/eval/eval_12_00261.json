 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's it going?",
   "est_sec": 1.34,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_09",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Okay, I guess.",
   "est_sec": 1.03,
   "gap_before": 0.76,
   "event": "greeting_answer",
   "phrasing": "greet_ans_12"
  },
  {
   "speaker": "user",
   "text": "My cousin's wedding is next month. Their registry is mostly kitchen stuff, but they hinted they'd prefer money.",
   "est_sec": 5.68,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "wedding_planning.ctx11"
  },
  {
   "speaker": "moshi",
   "text": "Then a gift card or cash in a card will probably make them happiest. Or would giving money feel too impersonal to you?",
   "est_sec": 7.23,
   "gap_before": 1.1,
   "role": "reply",
   "block": "wedding_planning.ctx11",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Hang on, let me read this recipe first. Don't talk until I'm finished.",
   "est_sec": 4.13,
   "gap_before": 1.46,
   "event": "instruction",
   "kind": "reading",
   "phrasing": "read_instr_04"
  },
  {
   "speaker": "moshi",
   "text": "No problem.",
   "est_sec": 0.72,
   "gap_before": 0.43,
   "role": "ack",
   "phrasing": "ack_04",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Bake for twenty minutes, okay.",
   "est_sec": 1.65,
   "anchor": {
    "turn": 4,
    "offset": 6.97
   },
   "event": "distractor",
   "kind": "self_talk",
   "phrasing": "murmur_05"
  },
  {
   "speaker": "user",
   "text": "Done, I read through it.",
   "est_sec": 1.65,
   "anchor": {
    "turn": 4,
    "offset": 10.1
   },
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "read_cue_04"
  },
  {
   "speaker": "moshi",
   "text": "Finished reading? So, which way did you go on the gift?",
   "est_sec": 3.51,
   "gap_before": 0.83,
   "role": "resume",
   "block": "wedding_planning.ctx11",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'll get the stand mixer. I want them to have something from me.",
