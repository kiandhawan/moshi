 "turns": [
  {
   "speaker": "moshi",
   "text": "Good to hear from you. How are you?",
   "est_sec": 2.58,
   "gap_before": 0.8,
   "role": "greeting",
   "phrasing": "greet_06",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm doing great.",
   "est_sec": 1.03,
   "gap_before": 0.6,
   "event": "greeting_answer",
   "phrasing": "greet_ans_18"
  },
  {
   "speaker": "user",
   "text": "I just moved to a new city and there are bike share docks everywhere.",
   "est_sec": 4.44,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "cycling.ctx21"
  },
  {
   "speaker": "moshi",
   "text": "Handy! Do you think you'll ride most days, or just now and then? That decides whether bike share or your own bike makes sense.",
   "est_sec": 7.54,
   "gap_before": 0.69,
   "role": "reply",
   "block": "cycling.ctx21",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I need to take this, it's important. Please hold on until I'm done.",
   "est_sec": 4.13,
   "gap_before": 0.52,
   "event": "instruction",
   "kind": "phone_call",
   "phrasing": "phone_instr_08"
  },
  {
   "speaker": "moshi",
   "text": "Sure, take your time.",
   "est_sec": 1.34,
   "gap_before": 0.39,
   "role": "ack",
   "phrasing": "ack_03",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Hey, did I leave my wallet at your place?",
   "est_sec": 2.89,
   "gap_before": 1.71,
   "phrasing": "call_25",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "user",
   "text": "Can you check under the cushions?",
   "est_sec": 1.96,
   "gap_before": 2.51,
   "phrasing": "call_25",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "user",
   "text": "Oh thank goodness.",
   "est_sec": 1.03,
   "gap_before": 2.89,
   "phrasing": "call_25"
  },
  {
   "speaker": "user",
   "text": "Sorry, the signal dropped. Okay, I can hear you again.",
   "est_sec": 3.2,
   "gap_before": 2.14,
   "phrasing": "call_25"
  },
  {
   "speaker": "user",
   "text": "I'll grab it tomorrow morning.",
   "est_sec": 1.65,
   "gap_before": 3.11,
   "phrasing": "call_25"
  },
  {
   "speaker": "user",
   "text": "Okay, sorry, I'm off the phone now.",
   "est_sec": 2.27,
   "gap_before": 1.26,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "phone_cue_01"
  },
  {
   "speaker": "moshi",
   "text": "Hope the call went okay. So, how much will you ride?",
   "est_sec": 3.51,
   "gap_before": 0.57,
   "role": "resume",
   "block": "cycling.ctx21",
   "reference_only": true
  },
  {
