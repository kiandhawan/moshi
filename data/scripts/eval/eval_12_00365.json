 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there, how are you doing today?",
   "est_sec": 2.27,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Not bad at all, thanks.",
   "est_sec": 1.65,
   "gap_before": 0.44,
   "event": "greeting_answer",
   "phrasing": "greet_ans_30"
  },
  {
   "speaker": "user",
   "text": "A few friends invited me on a long weekend ride.",
   "est_sec": 3.2,
   "gap_before": 0.59,
   "event": "ordinary_request",
   "block": "cycling.ctx3"
  },
  {
   "speaker": "moshi",
   "text": "Fun! They're doing either the flat forty mile loop or the hilly twenty five mile one. Which do you think your legs can handle?",
   "est_sec": 7.54,
   "gap_before": 0.38,
   "role": "reply",
   "block": "cycling.ctx3",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Hold that thought, someone's here. Don't say anything until I'm back.",
   "est_sec": 3.51,
   "gap_before": 0.94,
   "event": "instruction",
   "kind": "door",
   "phrasing": "door_instr_09"
  },
  {
   "speaker": "user",
   "text": "Oh, hey!",
   "est_sec": 0.72,
   "gap_before": 4.09,
   "phrasing": "door_02"
  },
  {
   "speaker": "visitor",
   "text": "Sorry to bother you, did a package for me end up here?",
   "est_sec": 3.82,
   "gap_before": 2.07,
   "phrasing": "door_02"
  },
  {
   "speaker": "user",
   "text": "Let me check. Is this it?",
   "est_sec": 1.96,
   "gap_before": 1.24,
   "phrasing": "door_02",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "visitor",
   "text": "Yes, that's it, thanks!",
   "est_sec": 1.34,
   "gap_before": 1.02,
   "phrasing": "door_02"
  },
  {
   "speaker": "user",
   "text": "Okay, go ahead.",
   "est_sec": 1.03,
   "gap_before": 2.01,
   "event": "return_cue",
   "kind": "implicit",
   "phrasing": "implicit_14"
  },
  {
   "speaker": "moshi",
   "text": "Right. You were picking the weekend ride, flat and long or short and hilly.",
   "est_sec": 4.44,
   "gap_before": 1.09,
   "role": "resume",
   "block": "cycling.ctx3",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "The flat one. Hills and I are not friends.",
   "est_sec": 2.89,
   "gap_before": 1.49,
   "event": "ordinary_request",
   "block": "cycling.ctx3"
  },
  {
   "speaker": "moshi",
   "text": "Fair. Bring two water bottles and a snack for the halfway point.",
   "est_sec": 3.82,
   "gap_before": 1.01,
