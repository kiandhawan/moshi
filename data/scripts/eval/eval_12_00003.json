 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, what's up? How are you doing?",
   "est_sec": 2.27,
   "gap_before": 0.68,
   "role": "greeting",
   "phrasing": "greet_24",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Okay, I guess.",
   "est_sec": 1.03,
   "gap_before": 0.37,
   "event": "greeting_answer",
   "phrasing": "greet_ans_12"
  },
  {
   "speaker": "user",
   "text": "One of our group just went vegan.",
   "est_sec": 2.27,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "camping.ctx13"
  },
  {
   "speaker": "moshi",
   "text": "Easy enough to handle. Is it dinner you're worried about?",
   "est_sec": 3.2,
   "gap_before": 0.86,
   "role": "reply",
   "block": "camping.ctx13",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Mostly the s'mores, honestly.",
   "est_sec": 1.34,
   "gap_before": 1.31,
   "event": "ordinary_request",
   "block": "camping.ctx13"
  },
  {
   "speaker": "moshi",
   "text": "Fair, marshmallows usually have gelatin. Hunt down vegan ones, or swap in grilled bananas with chocolate for everybody?",
   "est_sec": 5.68,
   "gap_before": 0.7,
   "role": "reply",
   "block": "camping.ctx13",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Someone's at the door, give me a second. Stay quiet until I'm back.",
   "est_sec": 4.13,
   "gap_before": 0.45,
   "event": "instruction",
   "kind": "door",
   "phrasing": "door_instr_01"
  },
  {
   "speaker": "moshi",
   "text": "Okay, no rush.",
   "est_sec": 1.03,
   "gap_before": 0.69,
   "role": "ack",
   "phrasing": "ack_10",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Oh, hello, can I help you?",
   "est_sec": 1.96,
   "gap_before": 2.5,
   "phrasing": "door_34",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "visitor",
   "text": "Hi, I lived in this house as a kid. Sorry, I just wanted to see it again.",
   "est_sec": 5.37,
   "gap_before": 1.39,
   "phrasing": "door_34"
  },
  {
   "speaker": "user",
   "text": "No way! When was that?",
   "est_sec": 1.65,
   "gap_before": 3.26,
   "phrasing": "door_34",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "visitor",
   "text": "Forty years ago, the tree out front was a sapling.",
   "est_sec": 3.2,
   "gap_before": 1.13,
   "phrasing": "door_34"
  },
  {
   "speaker": "user",
   "text": "That's lovely. Do you want to see the garden?",
   "est_sec": 2.89,
   "gap_before": 1.9,
   "phrasing": "door_34",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "visitor",
   "text": "Would you mind? Thank you.",
   "est_sec": 1.65,
   "gap_before": 0.73,
   "phrasing": "door_34"
  },
  {
   "speaker": "user",
   "text": "Okay, I'm back. Sorry about that.",
   "est_sec": 1.96,
   "gap_before": 3.23,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "door_cue_01"
  },
  {
   "speaker": "moshi",
   "text": "Hope that was nothing urgent. Dessert for the group. Vegan marshmallows, or the banana trick?",
   "est_sec": 4.75,
   "gap_before": 0.94,
   "role": "resume",
   "block": "camping.ctx13",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Bananas. Everyone can share the same thing.",
   "est_sec": 2.27,
   "gap_before": 0.3,
   "event": "ordinary_request",
   "block": "camping.ctx13"
  },
  {
   "speaker": "moshi",
   "text": "Nice. Slit them, stuff in the chocolate, wrap in foil and set them in the embers.",
   "est_sec": 5.06,
   "gap_before": 0.99,
   "role": "followup",
   "block": "camping.ctx13",
   "reference_only": true
  }
