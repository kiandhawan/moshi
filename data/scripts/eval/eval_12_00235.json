 "turns": [
  {
   "speaker": "moshi",
   "text": "Good to hear from you. How are you?",
   "est_sec": 2.58,
   "gap_before": 0.36,
   "role": "greeting",
   "phrasing": "greet_06",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Fine, thanks.",
   "est_sec": 0.72,
   "gap_before": 0.99,
   "event": "greeting_answer",
   "phrasing": "greet_ans_09"
  },
  {
   "speaker": "user",
   "text": "Hi, I'm hosting my first picnic and I'm worried I'll forget something. Can you help me make a list?",
   "est_sec": 5.99,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "block": "picnic.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Of course. Start with a blanket, plates, cups, napkins, a knife and a bin bag for rubbish.",
   "est_sec": 5.37,
   "gap_before": 1.73,
   "role": "reply",
   "block": "picnic.dlg11",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And food wise?",
   "est_sec": 1.03,
   "gap_before": 0.6,
   "event": "ordinary_request",
   "block": "picnic.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "One main thing like sandwiches or a salad, something sweet, fruit and plenty of water.",
   "est_sec": 4.75,
   "gap_before": 0.4,
   "role": "reply",
   "block": "picnic.dlg11",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What about sun stuff?",
   "est_sec": 1.34,
   "gap_before": 0.66,
   "event": "distractor",
   "kind": "pause",
   "block": "picnic.dlg11"
  },
  {
   "speaker": "user",
   "text": "We're going at noon.",
   "est_sec": 1.34,
   "gap_before": 2.3,
   "event": "ordinary_request",
   "block": "picnic.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Sunscreen, hats, and something for shade. Noon is the hottest part of the day.",
   "est_sec": 4.44,
   "gap_before": 1.66,
   "role": "reply",
   "block": "picnic.dlg11",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Anything people usually forget?",
   "est_sec": 1.34,
   "gap_before": 1.14,
   "event": "ordinary_request",
   "block": "picnic.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "A bottle opener, wet wipes and a little bag for leftovers. And a spare jumper in case it gets breezy.",
   "est_sec": 6.3,
   "gap_before": 1.24,
   "role": "reply",
   "block": "picnic.dlg11",
   "reference_only": true
  }
 ],
