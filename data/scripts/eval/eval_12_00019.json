 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there, how are you doing today?",
   "est_sec": 2.27,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "All good here.",
   "est_sec": 1.03,
   "gap_before": 0.62,
   "event": "greeting_answer",
   "phrasing": "greet_ans_27"
  },
  {
   "speaker": "user",
   "text": "I want to start riding but I'm honestly terrified of traffic.",
   "est_sec": 3.51,
   "gap_before": 0.26,
   "event": "ordinary_request",
   "block": "cycling.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "That's a really common fear. Many people start on quiet routes, like parks and cycle paths, and build confidence from there.",
   "est_sec": 6.61,
   "gap_before": 1.05,
   "role": "reply",
   "block": "cycling.dlg10",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What about my commute?",
   "est_sec": 1.34,
   "gap_before": 0.7,
   "event": "ordinary_request",
   "block": "cycling.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Try riding it on a Sunday morning first, when it's quiet, so you learn the route without stress.",
   "est_sec": 5.68,
   "gap_before": 0.36,
   "role": "reply",
   "block": "cycling.dlg10",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "That's actually a great idea.",
   "est_sec": 1.65,
   "gap_before": 3.22,
   "event": "ordinary_request",
   "block": "cycling.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Some cities also offer free cycling lessons for adults. They teach you how to position yourself in traffic.",
   "est_sec": 5.68,
   "gap_before": 0.67,
   "role": "reply",
   "block": "cycling.dlg10",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Oh really? I'd do that.",
   "est_sec": 1.65,
   "gap_before": 1.29,
   "event": "ordinary_request",
   "block": "cycling.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Look up your local council's website. And remember, you can always get off and walk a tricky junction.",
   "est_sec": 5.68,
   "gap_before": 1.15,
   "role": "reply",
   "block": "cycling.dlg10",
   "reference_only": true
  }
 ],
