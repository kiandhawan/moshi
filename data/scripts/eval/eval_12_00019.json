 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your week going?",
   "est_sec": 1.65,
   "gap_before": 0.73,
   "role": "greeting",
   "phrasing": "greet_15",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Ah, it's been a long day.",
   "est_sec": 1.96,
   "gap_before": 0.34,
   "event": "greeting_answer",
   "phrasing": "greet_ans_24"
  },
  {
   "speaker": "user",
   "text": "How often should I pump up my bike tires?",
   "est_sec": 2.89,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "cycling.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "For a road bike, about once a week. Thinner tires lose air faster than you'd think.",
   "est_sec": 5.06,
   "gap_before": 0.4,
   "role": "reply",
   "block": "cycling.dlg1",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And how do I know the right pressure?",
   "est_sec": 2.58,
   "gap_before": 0.74,
   "event": "ordinary_request",
   "block": "cycling.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "It's printed on the side of the tire as a range. Aim somewhere in the middle for everyday riding.",
   "est_sec": 5.99,
   "gap_before": 0.32,
   "role": "reply",
   "block": "cycling.dlg1",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I've just been squeezing them",
   "est_sec": 1.65,
   "gap_before": 0.98,
   "event": "distractor",
   "kind": "pause",
   "block": "cycling.dlg1"
  },
  {
   "speaker": "user",
   "text": "and guessing, honestly.",
   "est_sec": 1.03,
   "gap_before": 1.72,
   "event": "ordinary_request",
   "block": "cycling.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "A lot of people do. A floor pump with a gauge takes the guessing out and isn't expensive.",
   "est_sec": 5.68,
   "gap_before": 0.97,
   "role": "reply",
   "block": "cycling.dlg1",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Should I go lower if it's raining?",
   "est_sec": 2.27,
   "gap_before": 0.74,
   "event": "ordinary_request",
   "block": "cycling.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "A little lower, yes. It gives you more grip on wet roads.",
   "est_sec": 3.82,
   "gap_before": 0.8,
   "role": "reply",
   "block": "cycling.dlg1",
   "reference_only": true
  }
 ],
