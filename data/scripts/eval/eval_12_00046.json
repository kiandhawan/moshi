 "turns": [
  {
   "speaker": "moshi",
   "text": "Good to hear from you. How are you?",
   "est_sec": 2.58,
   "gap_before": 0.44,
   "role": "greeting",
   "phrasing": "greet_06",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Not bad at all, thanks.",
   "est_sec": 1.65,
   "gap_before": 0.48,
   "event": "greeting_answer",
   "phrasing": "greet_ans_30"
  },
  {
   "speaker": "user",
   "text": "My sixteen-year-old wants to go camping with three friends. No adults.",
   "est_sec": 3.51,
   "gap_before": 0.32,
   "event": "ordinary_request",
   "block": "camping.ctx9"
  },
  {
   "speaker": "moshi",
   "text": "That's a big step. Are you okay with it?",
   "est_sec": 2.89,
   "gap_before": 0.87,
   "role": "reply",
   "block": "camping.ctx9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Nervous, honestly, but she's responsible.",
   "est_sec": 1.65,
   "gap_before": 1.12,
   "event": "ordinary_request",
   "block": "camping.ctx9"
  },
  {
   "speaker": "moshi",
   "text": "Then maybe set some terms. A campground close to home, or let them choose the spot as long as they check in each evening?",
   "est_sec": 7.54,
   "gap_before": 0.42,
   "role": "reply",
   "block": "camping.ctx9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Hmm, I need thirty seconds to think. Ask me again after that.",
   "est_sec": 3.82,
   "gap_before": 1.6,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 30,
   "phrasing": "think_instr_03"
  },
  {
   "speaker": "user",
   "text": "Not yet, give me five more seconds.",
   "est_sec": 2.27,
   "event": "extension",
   "extra_sec": 5,
   "phrasing": "extension_08",
   "anchor": {
    "turn": 6,
    "offset": 28.89
   }
  },
  {
   "speaker": "moshi",
   "text": "Have you decided how much rope to give them?",
   "est_sec": 2.89,
   "role": "resume",
   "block": "camping.ctx9",
   "anchor": {
    "turn": 7,
    "offset": 5.23
   },
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Close to home. I can drive out if anything happens.",
   "est_sec": 3.2,
   "gap_before": 1.07,
   "event": "ordinary_request",
   "block": "camping.ctx9"
  },
  {
   "speaker": "moshi",
   "text": "Reasonable. She still gets the independence, and you get to sleep.",
   "est_sec": 3.51,
   "gap_before": 0.55,
   "role": "followup",
   "block": "camping.ctx9",
   "reference_only": true
  }
