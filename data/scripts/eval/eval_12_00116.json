   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "learning_language.ctx14"
  },
  {
   "speaker": "moshi",
   "text": "They're tough. Learn them one at a time with drills, or pick up common phrases and let the patterns sink in?",
