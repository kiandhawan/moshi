   "role": "greeting",
   "phrasing": "greet_06",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm fine, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.73,
   "event": "greeting_answer",
   "phrasing": "greet_ans_15"
  },
  {
   "speaker": "user",
   "text": "Russian cases are breaking my brain. Six of them!",
