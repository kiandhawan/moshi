   "gap_before": 1.36,
   "block": "home_office.side4"
  },
  {
   "speaker": "friend",
   "text": "Presenting what, love?",
   "est_sec": 1.03,
   "gap_before": 0.94,
   "block": "home_office.side4"
  },
  {
   "speaker": "user",
   "text": "The quarterly numbers. To about forty people.",
