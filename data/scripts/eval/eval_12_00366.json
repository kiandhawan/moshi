   "gap_before": 0.47,
   "event": "greeting_answer",
   "phrasing": "greet_ans_27"
  },
  {
   "speaker": "user",
   "text": "The guest list is getting out of hand. We're at almost two hundred people.",
   "est_sec": 4.44,
   "gap_before": 0.4,
   "event": "ordinary_request",
   "block": "wedding_planning.ctx2"
  },
  {
   "speaker": "moshi",
   "text": "That's a lot. Would you rather cut it down to close friends and family, or keep everyone and adjust the budget?",
   "est_sec": 6.61,
   "gap_before": 1.11,
   "role": "reply",
   "block": "wedding_planning.ctx2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Give me fifteen seconds. I'll know by then, so ask me again.",
   "est_sec": 3.82,
   "gap_before": 0.97,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 15,
   "phrasing": "think_instr_27"
  },
  {
   "speaker": "moshi",
   "text": "Okay, no rush.",
   "est_sec": 1.03,
   "gap_before": 0.36,
   "role": "ack",
   "phrasing": "ack_10",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Actually, I'm ready now.",
   "est_sec": 1.34,
   "anchor": {
    "turn": 4,
    "offset": 13.09
   },
   "event": "return_cue",
   "kind": "early_end",
   "phrasing": "early_end_06"
  },
  {
