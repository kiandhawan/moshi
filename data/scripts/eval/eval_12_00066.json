   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "restaurant_choice.ctx14"
  },
  {
   "speaker": "moshi",
   "text": "Nice. Brunch places get packed. Do you want an early slot around nine, or a lazy late one closer to noon?",
   "est_sec": 6.61,
   "gap_before": 1.15,
   "role": "reply",
   "block": "restaurant_choice.ctx14",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Hold that thought, I have a call coming in. I'll come back to you.",
   "est_sec": 4.44,
   "gap_before": 0.79,
   "event": "instruction",
   "kind": "phone_call",
   "phrasing": "phone_instr_10"
  },
  {
   "speaker": "moshi",
   "text": "No worries.",
   "est_sec": 0.72,
