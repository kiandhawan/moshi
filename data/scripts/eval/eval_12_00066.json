   "text": "Dude, did you see the game?",
   "est_sec": 1.96,
   "gap_before": 1.86,
   "phrasing": "call_36",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "user",
   "text": "I can't believe that last goal.",
   "est_sec": 1.96,
   "gap_before": 2.08,
   "phrasing": "call_36"
  },
  {
   "speaker": "user",
   "text": "Hang on, I'm going outside. Okay, I'm ready, go ahead.",
   "est_sec": 3.2,
   "gap_before": 1.65,
   "phrasing": "call_36"
  },
  {
   "speaker": "user",
   "text": "Are you watching the rematch?",
   "est_sec": 1.65,
   "gap_before": 2.54,
   "phrasing": "call_36",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
