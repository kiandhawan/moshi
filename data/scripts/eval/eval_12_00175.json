 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there, how are you doing today?",
   "est_sec": 2.27,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm fine, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.62,
   "event": "greeting_answer",
   "phrasing": "greet_ans_15"
  },
  {
   "speaker": "user",
   "text": "My friends want to do a picnic but the forecast says maybe rain.",
   "est_sec": 4.13,
   "gap_before": 0.41,
   "event": "ordinary_request",
   "block": "picnic.ctx3"
  },
  {
   "speaker": "moshi",
   "text": "Hmm, there's a forty percent chance in the afternoon. Do you want to move it to the morning, or keep the plan and bring a tarp just in case?",
   "est_sec": 9.09,
   "gap_before": 1.14,
   "role": "reply",
   "block": "picnic.ctx3",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Wait, Marcus needs me for a sec. Please stay quiet until I come back to you.",
   "est_sec": 5.06,
   "gap_before": 0.93,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_03"
  },
  {
   "speaker": "user",
   "text": "Can you quiz me on these flashcards for a minute?",
   "est_sec": 3.2,
   "gap_before": 0.78,
   "event": "distractor",
   "kind": "friend_question",
   "block": "learning_language.side3"
  },
  {
   "speaker": "friend",
   "text": "Sure. What's the word for window?",
   "est_sec": 1.96,
   "gap_before": 1.27,
   "block": "learning_language.side3"
  },
  {
   "speaker": "user",
   "text": "Ventana.",
   "est_sec": 0.41,
   "gap_before": 0.78,
   "block": "learning_language.side3"
  },
  {
   "speaker": "friend",
   "text": "Correct. And spoon?",
   "est_sec": 1.03,
   "gap_before": 1.54,
   "block": "learning_language.side3"
  },
  {
   "speaker": "user",
   "text": "Uh, cuchillo?",
   "est_sec": 0.72,
   "gap_before": 0.31,
   "event": "distractor",
   "kind": "friend_question",
   "block": "learning_language.side3"
  },
  {
   "speaker": "friend",
   "text": "No, that's knife. Spoon is cuchara.",
   "est_sec": 1.96,
   "gap_before": 1.52,
   "block": "learning_language.side3"
  },
  {
   "speaker": "user",
   "text": "I always mix those two up. Can you do the kitchen ones again?",
   "est_sec": 4.13,
   "gap_before": 0.57,
   "event": "distractor",
   "kind": "friend_question",
   "block": "learning_language.side3"
  },
  {
   "speaker": "user",
   "text": "Alright, I'm back. Let's keep going.",
   "est_sec": 1.96,
   "gap_before": 1.78,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_09"
  },
  {
   "speaker": "moshi",
   "text": "Alright. We were working around the rain forecast for your picnic.",
   "est_sec": 3.51,
   "gap_before": 0.57,
   "role": "resume",
   "block": "picnic.ctx3",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Morning. Nobody wants a soggy picnic.",
   "est_sec": 1.96,
   "gap_before": 1.48,
   "event": "ordinary_request",
   "block": "picnic.ctx3"
  },
  {
   "speaker": "moshi",
   "text": "Smart. A brunch picnic with fruit and pastries could be really nice.",
   "est_sec": 3.82,
   "gap_before": 1.17,
   "role": "followup",
   "block": "picnic.ctx3",
   "reference_only": true
  }
 ],
