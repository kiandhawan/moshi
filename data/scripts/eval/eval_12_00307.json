 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's it going? You doing okay?",
   "est_sec": 2.27,
   "gap_before": 0.41,
   "role": "greeting",
   "phrasing": "greet_30",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Not bad at all, thanks.",
   "est_sec": 1.65,
   "gap_before": 0.36,
   "event": "greeting_answer",
   "phrasing": "greet_ans_30"
  },
  {
   "speaker": "user",
   "text": "Ugh, I hate wasps. How do I keep them away from my picnic?",
   "est_sec": 4.13,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "picnic.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Keep sugary drinks covered and use cups with lids or straws. Wasps love sweet things.",
   "est_sec": 4.75,
   "gap_before": 1.14,
   "role": "reply",
   "block": "picnic.dlg10",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "They always",
   "est_sec": 0.72,
   "gap_before": 1.37,
   "event": "distractor",
   "kind": "pause",
   "block": "picnic.dlg10"
  },
  {
   "speaker": "user",
   "text": "find the jam somehow.",
   "est_sec": 1.34,
   "gap_before": 1.68,
   "event": "ordinary_request",
   "block": "picnic.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Then bring the jam out only when you're using it, and put it back in the bag right after.",
   "est_sec": 5.99,
   "gap_before": 1.38,
   "role": "reply",
   "block": "picnic.dlg10",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Does that thing with the fake wasp nest work?",
   "est_sec": 2.89,
   "gap_before": 0.98,
   "event": "ordinary_request",
   "block": "picnic.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Some people swear by it. Wasps are territorial, so a decoy nest might keep a few away.",
   "est_sec": 5.37,
   "gap_before": 0.42,
   "role": "reply",
   "block": "picnic.dlg10",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And if one lands on me?",
   "est_sec": 1.96,
   "gap_before": 1.1,
   "event": "ordinary_request",
   "block": "picnic.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Stay calm and still. Swatting at them makes them more likely to sting.",
   "est_sec": 4.13,
   "gap_before": 1.69,
   "role": "reply",
   "block": "picnic.dlg10",
   "reference_only": true
  }
 ],
