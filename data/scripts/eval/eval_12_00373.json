 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your week going?",
   "est_sec": 1.65,
   "gap_before": 0.43,
   "role": "greeting",
   "phrasing": "greet_15",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Doing okay, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.51,
   "event": "greeting_answer",
   "phrasing": "greet_ans_03"
  },
  {
   "speaker": "user",
   "text": "We have three kids and my husband wants to cap it at two presents each.",
   "est_sec": 4.75,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "holiday_gifts.ctx5"
  },
  {
   "speaker": "moshi",
   "text": "And you?",
   "est_sec": 0.72,
   "gap_before": 0.8,
   "role": "reply",
   "block": "holiday_gifts.ctx5",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I think that's stingy. But the playroom is overflowing.",
   "est_sec": 2.89,
   "gap_before": 1.37,
   "event": "ordinary_request",
   "block": "holiday_gifts.ctx5"
  },
  {
   "speaker": "moshi",
   "text": "Both fair points. Would you go with his limit plus stocking stuffers, or maybe four gifts with a want, need, wear, read rule?",
   "est_sec": 7.23,
   "gap_before": 0.98,
   "role": "reply",
   "block": "holiday_gifts.ctx5",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "One moment, my sister is asking me something. Please don't interrupt until I'm back.",
   "est_sec": 4.44,
   "gap_before": 0.65,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_06"
  },
  {
   "speaker": "user",
   "text": "Did you see the sign at the gate?",
   "est_sec": 2.58,
   "gap_before": 0.94,
   "event": "distractor",
   "kind": "friend_question",
   "block": "camping.side5"
  },
  {
   "speaker": "friend",
   "text": "The fire one? Yeah, burn ban until it rains.",
   "est_sec": 2.89,
   "gap_before": 1.3,
   "block": "camping.side5"
  },
  {
   "speaker": "user",
   "text": "So no campfire at all? What about the little gas stove?",
   "est_sec": 3.51,
   "gap_before": 2.83,
   "event": "distractor",
   "kind": "friend_question",
   "block": "camping.side5"
  },
  {
   "speaker": "friend",
   "text": "Stoves with a shut-off valve are fine, the ranger told me. Just no open flames.",
   "est_sec": 4.75,
   "gap_before": 1.11,
   "block": "camping.side5"
  },
  {
   "speaker": "user",
   "text": "Then the marshmallows are going to be a sad affair.",
   "est_sec": 3.2,
   "gap_before": 1.48,
   "block": "camping.side5"
  },
  {
   "speaker": "friend",
   "text": "We can toast them over the stove. Not the same, but it works.",
   "est_sec": 4.13,
   "gap_before": 0.63,
   "block": "camping.side5"
  },
  {
   "speaker": "user",
   "text": "You're very calm about this.",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "block": "camping.side5"
  },
  {
   "speaker": "friend",
   "text": "I packed cards. We'll survive.",
   "est_sec": 1.65,
   "gap_before": 0.31,
   "block": "camping.side5"
  },
  {
   "speaker": "user",
   "text": "Maya, did you finish the crossword?",
   "est_sec": 1.96,
   "gap_before": 0.47,
   "event": "distractor",
   "kind": "friend_question",
   "phrasing": "dq_71"
  },
  {
   "speaker": "friend",
   "text": "All but one clue.",
   "est_sec": 1.34,
   "gap_before": 1.11,
   "phrasing": "dq_71"
  },
  {
   "speaker": "user",
   "text": "Anyway, sorry, go on.",
   "est_sec": 1.34,
   "gap_before": 1.75,
   "event": "return_cue",
   "kind": "implicit",
   "phrasing": "implicit_08"
  },
  {
   "speaker": "moshi",
   "text": "Of course. The kids' presents. Two each, or want, need, wear, read?",
   "est_sec": 3.82,
   "gap_before": 0.83,
   "role": "resume",
   "block": "holiday_gifts.ctx5",
