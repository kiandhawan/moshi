   "phrasing": "dn_77"
  },
  {
   "speaker": "friend",
   "text": "Okay, chapter twelve.",
   "est_sec": 1.03,
   "gap_before": 0.93,
   "phrasing": "dn_77"
  },
  {
   "speaker": "user",
   "text": "Sofia, are you on a call right now?",
