   "phrasing": "greet_09",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm fine, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.33,
   "event": "greeting_answer",
   "phrasing": "greet_ans_15"
  },
  {
   "speaker": "user",
   "text": "I'm taking a Spanish certification exam for work. I could do it in June or December.",
   "est_sec": 5.06,
   "gap_before": 0.27,
   "event": "ordinary_request",
   "block": "learning_language.ctx18"
  },
  {
