   "gap_before": 0.79,
   "block": "home_office.side1"
  },
  {
   "speaker": "user",
   "text": "I have a big meeting at ten too. Can you take yours in the bedroom?",
   "est_sec": 4.75,
   "gap_before": 1.2,
   "event": "distractor",
   "kind": "friend_question",
   "block": "home_office.side1"
  },
