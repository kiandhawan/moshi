   "role": "reply",
   "block": "learning_language.ctx18",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "The upper intermediate one. I'm sort of near it.",
   "est_sec": 2.89,
   "gap_before": 0.69,
   "event": "ordinary_request",
   "block": "learning_language.ctx18"
  },
  {
