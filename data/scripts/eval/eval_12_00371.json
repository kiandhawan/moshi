 "turns": [
  {
   "speaker": "moshi",
   "text": "Good to hear from you. How are you?",
   "est_sec": 2.58,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_06",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Not bad at all, thanks.",
   "est_sec": 1.65,
   "gap_before": 0.4,
   "event": "greeting_answer",
   "phrasing": "greet_ans_30"
  },
  {
   "speaker": "user",
   "text": "My phone storage is full and it says podcasts are taking up twelve gigabytes.",
   "est_sec": 4.44,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "podcasts.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Ah, that's probably automatic downloads. Your app may be saving every new episode of every show.",
   "est_sec": 5.06,
   "gap_before": 1.14,
   "role": "reply",
   "block": "podcasts.dlg8",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I follow like forty shows.",
   "est_sec": 1.65,
   "gap_before": 1.34,
   "event": "ordinary_request",
   "block": "podcasts.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "That'll do it. In the app settings, look for automatic downloads and turn them off, or limit them to the latest episode.",
   "est_sec": 6.92,
   "gap_before": 0.42,
   "role": "reply",
   "block": "podcasts.dlg8",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Can I delete the old ones?",
   "est_sec": 1.96,
   "gap_before": 1.07,
   "event": "ordinary_request",
   "block": "podcasts.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Yes, there's usually an option to remove played episodes. You can also set it to do that automatically.",
   "est_sec": 5.68,
   "gap_before": 0.43,
   "role": "reply",
   "block": "podcasts.dlg8",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Okay, found it.",
   "est_sec": 1.03,
   "gap_before": 0.72,
   "event": "distractor",
   "kind": "pause",
   "block": "podcasts.dlg8"
  },
  {
   "speaker": "user",
   "text": "Wait, does it delete my unplayed ones too?",
   "est_sec": 2.58,
   "gap_before": 2.79,
   "event": "ordinary_request",
   "block": "podcasts.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Only if you choose that. Pick remove played episodes only.",
   "est_sec": 3.2,
   "gap_before": 0.41,
   "role": "reply",
   "block": "podcasts.dlg8",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Done. That's much better.",
   "est_sec": 1.34,
   "gap_before": 1.64,
   "event": "ordinary_request",
   "block": "podcasts.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Nice. Your phone will thank you.",
   "est_sec": 1.96,
