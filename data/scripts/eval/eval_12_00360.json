   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "camping.ctx22"
  },
  {
   "speaker": "moshi",
   "text": "They can ruin a trip. Are you okay with chemical repellent, or would you rather stick to nets and long sleeves?",
