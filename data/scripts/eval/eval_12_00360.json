   "gap_before": 1.51,
   "role": "reply",
   "block": "camping.ctx22",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Sorry, I have to take this call. Hang on and stay quiet until I'm back.",
   "est_sec": 4.75,
