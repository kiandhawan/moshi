 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your week going?",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_15",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm doing great.",
   "est_sec": 1.03,
   "gap_before": 0.52,
   "event": "greeting_answer",
   "phrasing": "greet_ans_18"
  },
  {
   "speaker": "user",
   "text": "What's the deal with Chromebooks?",
   "est_sec": 1.65,
   "gap_before": 0.55,
   "event": "distractor",
   "kind": "pause",
   "block": "laptop_buying.dlg8"
  },
  {
   "speaker": "user",
   "text": "Are they any good?",
   "est_sec": 1.34,
   "gap_before": 2.52,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "They're great for simple things, browsing, email, documents, video. They're cheap and they start up really fast.",
   "est_sec": 5.37,
   "gap_before": 1.15,
   "role": "reply",
   "block": "laptop_buying.dlg8",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Can they run regular programs?",
   "est_sec": 1.65,
   "gap_before": 1.26,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Mostly they run web apps and Android apps. Big programs like professional photo editors usually won't work.",
   "est_sec": 5.37,
   "gap_before": 0.93,
   "role": "reply",
   "block": "laptop_buying.dlg8",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "My mum just does email and watches cooking videos.",
   "est_sec": 2.89,
   "gap_before": 2.47,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Then a Chromebook is perfect for her. Simple, secure, and hard to break with a wrong click.",
   "est_sec": 5.37,
   "gap_before": 0.32,
   "role": "reply",
   "block": "laptop_buying.dlg8",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Does it get viruses?",
   "est_sec": 1.34,
   "gap_before": 1.47,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Very rarely. That's one of their big advantages, especially for less techy users.",
   "est_sec": 4.13,
   "gap_before": 0.55,
   "role": "reply",
   "block": "laptop_buying.dlg8",
   "reference_only": true
  }
 ],
