 "turns": [
  {
   "speaker": "moshi",
   "text": "Good to hear from you. How are you?",
   "est_sec": 2.58,
   "gap_before": 0.73,
   "role": "greeting",
   "phrasing": "greet_06",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm doing great.",
   "est_sec": 1.03,
   "gap_before": 0.76,
   "event": "greeting_answer",
   "phrasing": "greet_ans_18"
  },
  {
   "speaker": "user",
   "text": "My neighbour just moved in, and I thought we could do a little street picnic to welcome her.",
   "est_sec": 5.68,
   "gap_before": 0.39,
   "event": "ordinary_request",
   "block": "picnic.ctx22"
  },
  {
   "speaker": "moshi",
   "text": "What a kind idea. Would you invite the whole street, or just a few neighbours to keep it relaxed?",
   "est_sec": 5.99,
   "gap_before": 1.15,
   "role": "reply",
   "block": "picnic.ctx22",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "One second, someone's calling me. Don't talk until I say I'm back.",
   "est_sec": 3.82,
   "gap_before": 3.32,
   "event": "instruction",
   "kind": "phone_call",
   "phrasing": "phone_instr_07"
  },
  {
