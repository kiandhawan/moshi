   "text": "Hello, yes?",
   "est_sec": 0.72,
   "gap_before": 1.62,
   "phrasing": "call_04",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "user",
   "text": "Oh, about the order.",
   "est_sec": 1.34,
   "gap_before": 3.02,
   "phrasing": "call_04"
  },
  {
   "speaker": "user",
   "text": "No, it still hasn't arrived.",
   "est_sec": 1.65,
   "gap_before": 1.69,
   "phrasing": "call_04"
  },
  {
   "speaker": "user",
   "text": "Could you check the tracking number for me?",
   "est_sec": 2.58,
   "gap_before": 2.26,
   "phrasing": "call_04",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "user",
   "text": "Okay, I'll wait for the email. Thanks.",
   "est_sec": 2.27,
   "gap_before": 2.28,
   "phrasing": "call_04"
  },
  {
   "speaker": "user",
   "text": "Okay, call's done. I'm back.",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "phone_cue_03"
  },
