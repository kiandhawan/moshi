 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there, how are you doing today?",
   "est_sec": 2.27,
   "gap_before": 0.53,
   "role": "greeting",
   "phrasing": "greet_12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm doing great.",
   "est_sec": 1.03,
   "gap_before": 0.91,
   "event": "greeting_answer",
   "phrasing": "greet_ans_18"
  },
  {
   "speaker": "user",
   "text": "The guest list is getting out of hand. We're at almost two hundred people.",
   "est_sec": 4.44,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "wedding_planning.ctx2"
  },
  {
   "speaker": "moshi",
   "text": "That's a lot. Would you rather cut it down to close friends and family, or keep everyone and adjust the budget?",
   "est_sec": 6.61,
   "gap_before": 1.9,
   "role": "reply",
   "block": "wedding_planning.ctx2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Hold that thought, someone's here. Don't say anything until I'm back.",
   "est_sec": 3.51,
   "gap_before": 1.24,
   "event": "instruction",
   "kind": "door",
   "phrasing": "door_instr_09"
  },
  {
   "speaker": "user",
   "text": "Hi.",
   "est_sec": 0.41,
   "gap_before": 4.09,
   "phrasing": "door_05"
  },
  {
   "speaker": "visitor",
   "text": "Pizza for apartment four?",
   "est_sec": 1.34,
   "gap_before": 0.57,
   "phrasing": "door_05"
  },
  {
   "speaker": "user",
   "text": "That's us. Is it already paid?",
   "est_sec": 1.96,
   "gap_before": 1.29,
   "phrasing": "door_05",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "visitor",
   "text": "Yep, all paid. Enjoy!",
   "est_sec": 1.34,
   "gap_before": 0.38,
   "phrasing": "door_05"
  },
  {
   "speaker": "user",
   "text": "Okay, I'm back. Sorry about that.",
