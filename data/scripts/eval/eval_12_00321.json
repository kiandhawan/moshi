 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's it going? You doing okay?",
   "est_sec": 2.27,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_30",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm okay, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.45,
   "event": "greeting_answer",
   "phrasing": "greet_ans_21"
  },
  {
   "speaker": "user",
   "text": "What are some picnic foods that won't get squashed in a backpack?",
   "est_sec": 3.82,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "picnic.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Wraps travel much better than sandwiches. Also hard fruits like apples, nuts, crackers in a box, and cheese.",
   "est_sec": 5.68,
   "gap_before": 0.93,
   "role": "reply",
   "block": "picnic.dlg6",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm hiking about an hour",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "event": "distractor",
   "kind": "pause",
   "block": "picnic.dlg6"
  },
  {
   "speaker": "user",
   "text": "to get to the spot.",
   "est_sec": 1.65,
   "gap_before": 2.93,
   "event": "ordinary_request",
   "block": "picnic.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Then go light. Skip anything heavy like big bottles of juice and pack a reusable water bottle each.",
   "est_sec": 5.68,
   "gap_before": 0.8,
   "role": "reply",
   "block": "picnic.dlg6",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What about dessert?",
   "est_sec": 1.03,
   "gap_before": 0.76,
   "event": "ordinary_request",
   "block": "picnic.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Cookies or flapjacks in a tin hold up well. Chocolate might melt, so keep it near your back, not on top.",
   "est_sec": 6.61,
   "gap_before": 1.04,
   "role": "reply",
   "block": "picnic.dlg6",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Should I bring plates?",
   "est_sec": 1.34,
   "gap_before": 1.57,
   "event": "ordinary_request",
   "block": "picnic.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Probably not. A small cloth and some napkins are enough for a hiking picnic.",
   "est_sec": 4.44,
   "gap_before": 0.65,
   "role": "reply",
   "block": "picnic.dlg6",
   "reference_only": true
  }
 ],
