 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How have you been lately?",
   "est_sec": 1.96,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_18",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Fine, thanks.",
   "est_sec": 0.72,
   "gap_before": 0.85,
   "event": "greeting_answer",
   "phrasing": "greet_ans_09"
  },
  {
   "speaker": "user",
   "text": "My video calls look terrible. How do I make them better?",
   "est_sec": 3.51,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "home_office.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Lighting makes the biggest difference. Sit facing a window or a lamp, never with the light behind you.",
   "est_sec": 5.68,
   "gap_before": 0.76,
   "role": "reply",
   "block": "home_office.dlg3",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "My desk faces a wall, and the window is behind me.",
   "est_sec": 3.51,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "home_office.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Then put a small lamp behind your screen, pointing at your face. A cheap ring light works well too.",
   "est_sec": 5.99,
   "gap_before": 0.8,
   "role": "reply",
   "block": "home_office.dlg3",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Okay. And the sound is kind of",
   "est_sec": 2.27,
   "gap_before": 1.45,
   "event": "distractor",
   "kind": "pause",
   "block": "home_office.dlg3"
  },
  {
   "speaker": "user",
   "text": "echoey in my room.",
   "est_sec": 1.34,
   "gap_before": 2.05,
   "event": "ordinary_request",
   "block": "home_office.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Soft things absorb echo, like a rug, curtains, or even a bookshelf. A headset microphone also helps a lot.",
   "est_sec": 5.99,
   "gap_before": 0.36,
   "role": "reply",
   "block": "home_office.dlg3",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What about the camera angle?",
   "est_sec": 1.65,
   "gap_before": 0.64,
   "event": "ordinary_request",
   "block": "home_office.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Raise it to eye level. Looking up from below is never flattering.",
   "est_sec": 3.82,
   "gap_before": 0.7,
   "role": "reply",
   "block": "home_office.dlg3",
   "reference_only": true
  }
 ],
