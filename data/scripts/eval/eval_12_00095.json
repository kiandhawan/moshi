 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's it going?",
   "est_sec": 1.34,
   "gap_before": 0.66,
   "role": "greeting",
   "phrasing": "greet_09",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Busy day.",
   "est_sec": 1.34,
   "gap_before": 0.46,
   "event": "greeting_answer",
   "phrasing": "greet_ans_06"
  },
  {
   "speaker": "user",
   "text": "We're doing a tiny wedding, twenty people. How do I tell my coworkers they're not invited without it being weird?",
   "est_sec": 6.3,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "wedding_planning.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Keep it simple and don't apologise too much. Something like, we're keeping it really small, just immediate family and a few close friends.",
   "est_sec": 7.23,
   "gap_before": 0.47,
   "role": "reply",
   "block": "wedding_planning.dlg4",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "One of them keeps asking about my dress like she's coming.",
   "est_sec": 3.51,
   "gap_before": 0.87,
   "event": "ordinary_request",
   "block": "wedding_planning.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Then gently say it directly before it gets awkward. People usually understand once they hear the number.",
   "est_sec": 5.37,
   "gap_before": 0.84,
   "role": "reply",
   "block": "wedding_planning.dlg4",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What if she's hurt?",
   "est_sec": 1.34,
   "gap_before": 0.84,
   "event": "ordinary_request",
   "block": "wedding_planning.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "She might be a little, and that's okay. You could offer to bring photos in, or have drinks with the team after.",
   "est_sec": 6.92,
   "gap_before": 0.96,
   "role": "reply",
   "block": "wedding_planning.dlg4",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Ooh, drinks after the honeymoon.",
   "est_sec": 1.65,
   "gap_before": 0.93,
   "event": "distractor",
   "kind": "pause",
   "block": "wedding_planning.dlg4"
  },
  {
   "speaker": "user",
   "text": "That could actually be nice.",
   "est_sec": 1.65,
   "gap_before": 2.01,
   "event": "ordinary_request",
   "block": "wedding_planning.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "It's a lovely way to include them without the guest list growing. Most people just want to celebrate with you a bit.",
   "est_sec": 6.92,
   "gap_before": 0.46,
   "role": "reply",
   "block": "wedding_planning.dlg4",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Okay. I'll tell her tomorrow.",
   "est_sec": 1.65,
   "gap_before": 0.64,
   "event": "ordinary_request",
   "block": "wedding_planning.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Good luck. Short and warm is the way.",
   "est_sec": 2.58,
   "gap_before": 0.83,
   "role": "reply",
   "block": "wedding_planning.dlg4",
   "reference_only": true
  }
 ],
