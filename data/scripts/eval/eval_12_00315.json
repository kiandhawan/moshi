 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's it going?",
   "est_sec": 1.34,
   "gap_before": 0.44,
   "role": "greeting",
   "phrasing": "greet_09",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Doing okay, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.31,
   "event": "greeting_answer",
   "phrasing": "greet_ans_03"
  },
  {
   "speaker": "user",
   "text": "I'm a guest at a wedding on a lawn and I bought these gorgeous heels.",
   "est_sec": 4.75,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "wedding_planning.ctx22"
  },
  {
   "speaker": "moshi",
   "text": "Lawns and heels don't get along. Get little heel protectors, or bring flats to switch into?",
   "est_sec": 5.06,
   "gap_before": 1.14,
   "role": "reply",
   "block": "wedding_planning.ctx22",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Can you give me a moment? Sofia wants to show me something. I'll let you know when I'm back.",
   "est_sec": 5.99,
   "gap_before": 1.16,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_24"
  },
  {
   "speaker": "user",
   "text": "Sofia, did anyone call while I was in the shower?",
   "est_sec": 3.2,
   "gap_before": 0.85,
   "event": "distractor",
   "kind": "friend_question",
   "phrasing": "dq_76"
  },
  {
   "speaker": "friend",
   "text": "Just your aunt, nothing urgent.",
   "est_sec": 1.65,
   "gap_before": 0.73,
   "phrasing": "dq_76"
  },
  {
   "speaker": "user",
   "text": "Be honest, does this tree look weird to you?",
   "est_sec": 2.89,
   "gap_before": 2.83,
   "event": "distractor",
   "kind": "friend_question",
   "block": "painting_art.side2"
  },
  {
   "speaker": "friend",
   "text": "A little. The trunk is kind of thick at the top.",
   "est_sec": 3.51,
   "gap_before": 1.1,
   "block": "painting_art.side2"
  },
  {
   "speaker": "user",
   "text": "Ugh, you're right. Should I just paint over it?",
   "est_sec": 2.89,
   "gap_before": 1.23,
   "event": "distractor",
   "kind": "friend_question",
   "block": "painting_art.side2"
  },
  {
   "speaker": "friend",
   "text": "No, just thin it out a bit. The leaves look really nice though.",
   "est_sec": 4.13,
   "gap_before": 1.49,
   "block": "painting_art.side2"
  },
  {
   "speaker": "user",
   "text": "Thanks. I spent forever on those leaves.",
   "est_sec": 2.27,
   "gap_before": 0.38,
   "block": "painting_art.side2"
  },
  {
   "speaker": "friend",
   "text": "It shows. Hang it in the hallway when it's done.",
   "est_sec": 3.2,
   "gap_before": 1.43,
   "block": "painting_art.side2"
  },
  {
   "speaker": "user",
   "text": "Right, where was I?",
   "est_sec": 1.34,
   "gap_before": 0.53,
   "event": "return_cue",
   "kind": "implicit",
   "phrasing": "implicit_11"
  },
  {
   "speaker": "moshi",
   "text": "Sure. The lawn and the heels. Protectors, or flats in your bag?",
   "est_sec": 3.82,
   "gap_before": 0.54,
   "role": "resume",
   "block": "wedding_planning.ctx22",
   "reference_only": true
  },
