 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your week going?",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "role": "greeting",
   "phrasing": "greet_15",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Okay, I guess.",
   "est_sec": 1.03,
   "gap_before": 0.32,
   "event": "greeting_answer",
   "phrasing": "greet_ans_12"
  },
  {
   "speaker": "user",
   "text": "My partner and I want to do a cycling holiday in France.",
   "est_sec": 3.82,
   "gap_before": 0.24,
   "event": "ordinary_request",
   "block": "cycling.ctx9"
  },
  {
   "speaker": "moshi",
   "text": "Lovely idea! Would you rather go with a tour company that moves your bags between hotels, or carry everything yourselves on panniers?",
   "est_sec": 6.92,
   "gap_before": 0.65,
   "role": "reply",
   "block": "cycling.ctx9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Someone's at the door, give me a second. Stay quiet until I'm back.",
   "est_sec": 4.13,
   "gap_before": 0.53,
   "event": "instruction",
   "kind": "door",
   "phrasing": "door_instr_01"
  },
  {
   "speaker": "user",
   "text": "Yeah?",
   "est_sec": 0.41,
   "gap_before": 3.72,
   "phrasing": "door_17",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "visitor",
   "text": "Hi, I'm with the window cleaners, we're doing the row today. Want yours done?",
   "est_sec": 4.44,
   "gap_before": 1.23,
   "phrasing": "door_17"
  },
  {
   "speaker": "user",
   "text": "How much is it for the front and back?",
   "est_sec": 2.89,
   "gap_before": 1.21,
   "phrasing": "door_17",
   "event": "distractor",
   "kind": "near_miss"
  },
  {
   "speaker": "visitor",
   "text": "Twenty for both.",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "phrasing": "door_17"
  },
  {
   "speaker": "user",
   "text": "Go on then, the back gate's unlocked.",
   "est_sec": 2.27,
   "gap_before": 1.33,
   "phrasing": "door_17",
   "event": "distractor",
   "kind": "near_miss"
  },
  {
   "speaker": "user",
   "text": "Sorry, that took a minute. I'm back.",
   "est_sec": 2.27,
   "gap_before": 2.15,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "door_cue_02"
  },
  {
   "speaker": "moshi",
   "text": "Everything okay at the door? Now then, for France, who's carrying the bags?",
   "est_sec": 4.13,
   "gap_before": 0.39,
   "role": "resume",
   "block": "cycling.ctx9",
   "reference_only": true
  },
  {
