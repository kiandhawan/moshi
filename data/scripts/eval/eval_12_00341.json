 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How have you been lately?",
   "est_sec": 1.96,
   "gap_before": 0.7,
   "role": "greeting",
   "phrasing": "greet_18",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm okay, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.57,
   "event": "greeting_answer",
   "phrasing": "greet_ans_21"
  },
  {
   "speaker": "user",
   "text": "I'm going to Rome next week. How do I ask for the bill in Italian?",
   "est_sec": 4.75,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "learning_language.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Il conto, per favore. That means the bill, please.",
   "est_sec": 2.89,
   "gap_before": 1.07,
   "role": "reply",
   "block": "learning_language.dlg8",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Il conto. Easy enough. What about asking for a table for two?",
   "est_sec": 3.82,
   "gap_before": 0.67,
   "event": "ordinary_request",
   "block": "learning_language.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Un tavolo per due, per favore.",
   "est_sec": 1.96,
   "gap_before": 0.7,
   "role": "reply",
   "block": "learning_language.dlg8",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And if I want to say the food was amazing?",
   "est_sec": 3.2,
   "gap_before": 0.73,
   "event": "ordinary_request",
   "block": "learning_language.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Era buonissimo. It was delicious. Waiters love hearing that.",
   "est_sec": 2.89,
   "gap_before": 0.51,
   "role": "reply",
   "block": "learning_language.dlg8",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Era buonissimo. Okay, I'll practise that one.",
   "est_sec": 2.27,
   "gap_before": 0.93,
   "event": "distractor",
   "kind": "pause",
   "block": "learning_language.dlg8"
  },
  {
   "speaker": "user",
   "text": "What if they reply really fast and I'm lost?",
   "est_sec": 2.89,
   "gap_before": 2.25,
   "event": "ordinary_request",
   "block": "learning_language.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "You can say, piano, per favore, which means slowly please. Or just smile and say grazie.",
   "est_sec": 5.06,
   "gap_before": 0.8,
   "role": "reply",
   "block": "learning_language.dlg8",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Grazie I already know.",
   "est_sec": 1.34,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "learning_language.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Perfect, you've got the essentials. Enjoy Rome.",
   "est_sec": 2.27,
   "gap_before": 0.9,
   "role": "reply",
   "block": "learning_language.dlg8",
   "reference_only": true
  }
 ],
