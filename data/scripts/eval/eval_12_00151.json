 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how have things been?",
   "est_sec": 1.96,
   "gap_before": 0.53,
   "role": "greeting",
   "phrasing": "greet_27",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "All good here.",
   "est_sec": 1.03,
   "gap_before": 0.68,
   "event": "greeting_answer",
   "phrasing": "greet_ans_27"
  },
  {
   "speaker": "user",
   "text": "I want to get my best friend something special this year.",
   "est_sec": 3.51,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "holiday_gifts.ctx3"
  },
  {
   "speaker": "moshi",
   "text": "Sweet. Would you rather make something by hand, like a photo book of your trips, or buy something she's been wanting?",
   "est_sec": 6.61,
   "gap_before": 0.87,
   "role": "reply",
   "block": "holiday_gifts.ctx3",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Oh, both sound good.",
   "est_sec": 1.34,
   "gap_before": 1.28,
   "event": "ordinary_request",
   "block": "holiday_gifts.ctx3"
  },
  {
   "speaker": "moshi",
   "text": "Take a moment. Homemade or store bought?",
   "est_sec": 2.27,
   "gap_before": 1.0,
   "role": "reply",
   "block": "holiday_gifts.ctx3",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Just a minute, I have to answer my roommate. Please stay quiet until I return.",
   "est_sec": 4.75,
   "gap_before": 1.33,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_27"
  },
  {
   "speaker": "moshi",
   "text": "Got it.",
   "est_sec": 0.72,
   "gap_before": 0.47,
   "role": "ack",
   "phrasing": "ack_07",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "So how was the ride along the river this morning?",
   "est_sec": 3.2,
   "gap_before": 1.47,
   "event": "distractor",
   "kind": "friend_question",
   "block": "cycling.side3"
  },
  {
   "speaker": "friend",
   "text": "Beautiful, but so windy on the way back.",
   "est_sec": 2.58,
   "gap_before": 0.7,
   "block": "cycling.side3"
  },
  {
   "speaker": "user",
   "text": "How far did you go?",
   "est_sec": 1.65,
   "gap_before": 0.54,
   "event": "distractor",
   "kind": "friend_question",
   "block": "cycling.side3"
  },
  {
   "speaker": "friend",
   "text": "All the way to the old bridge and back. My legs are dead.",
   "est_sec": 4.13,
   "gap_before": 1.35,
   "block": "cycling.side3"
  },
  {
   "speaker": "user",
   "text": "Next time wake me up, I want to come.",
   "est_sec": 2.89,
   "gap_before": 0.74,
   "block": "cycling.side3"
  },
  {
   "speaker": "friend",
   "text": "I tried! You told me to go away.",
   "est_sec": 2.58,
   "gap_before": 0.63,
   "block": "cycling.side3"
  },
  {
   "speaker": "user",
   "text": "Okay, fair. Set an alarm for both of us then.",
   "est_sec": 3.2,
   "gap_before": 1.31,
   "block": "cycling.side3"
  },
  {
   "speaker": "user",
   "text": "When are you back from work tomorrow?",
   "est_sec": 2.27,
