 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, what's up? How are you doing?",
   "est_sec": 2.27,
   "gap_before": 0.52,
   "role": "greeting",
   "phrasing": "greet_24",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Not bad at all, thanks.",
   "est_sec": 1.65,
   "gap_before": 0.83,
   "event": "greeting_answer",
   "phrasing": "greet_ans_30"
  },
  {
   "speaker": "user",
   "text": "I want to learn to draw but I have no talent at all.",
   "est_sec": 4.13,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "painting_art.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Drawing is much more a skill than a talent. It's mostly learning to look carefully, and that improves with practice.",
   "est_sec": 6.3,
   "gap_before": 1.09,
   "role": "reply",
   "block": "painting_art.dlg10",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Where do I even start?",
   "est_sec": 1.65,
   "gap_before": 1.19,
   "event": "ordinary_request",
   "block": "painting_art.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Simple objects. A mug, an apple, your own hand. Draw what you see, not what you think it looks like.",
   "est_sec": 6.3,
   "gap_before": 0.3,
   "role": "reply",
   "block": "painting_art.dlg10",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What's the difference?",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "painting_art.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Your brain has symbols for things, like an eye shape. Real eyes look different, so you have to really observe.",
   "est_sec": 6.3,
   "gap_before": 0.89,
   "role": "reply",
   "block": "painting_art.dlg10",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I've been drawing",
   "est_sec": 1.03,
   "gap_before": 1.27,
   "event": "distractor",
   "kind": "pause",
   "block": "painting_art.dlg10"
  },
  {
   "speaker": "user",
   "text": "the same stick figures since I was ten.",
   "est_sec": 2.58,
   "gap_before": 1.85,
   "event": "ordinary_request",
   "block": "painting_art.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Then you have the most room to grow. Try ten minutes a day for a month and compare your first and last drawing.",
   "est_sec": 7.23,
   "gap_before": 1.16,
   "role": "reply",
   "block": "painting_art.dlg10",
   "reference_only": true
  }
