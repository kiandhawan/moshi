   "gap_before": 2.72,
   "event": "ordinary_request",
   "block": "family_visit.ctx22"
  },
  {
   "speaker": "moshi",
   "text": "Wise. A cafe, a short walk and an early dinner is plenty.",
   "est_sec": 3.82,
   "gap_before": 0.46,
