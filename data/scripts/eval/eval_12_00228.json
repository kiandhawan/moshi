 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, what's up? How are you doing?",
   "est_sec": 2.27,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_24",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Okay, I guess.",
   "est_sec": 1.03,
   "gap_before": 0.93,
   "event": "greeting_answer",
   "phrasing": "greet_ans_12"
  },
  {
   "speaker": "user",
   "text": "My godmother's visiting from Ireland and she's never been to the city.",
   "est_sec": 3.82,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "family_visit.ctx22"
  },
  {
   "speaker": "moshi",
   "text": "How fun. Should her first day be the big famous sights, or a slow day around your neighbourhood so she can get over the jet lag?",
   "est_sec": 8.16,
   "gap_before": 0.39,
   "role": "reply",
   "block": "family_visit.ctx22",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Oh, I have to get this. Please wait quietly until I'm off the phone.",
   "est_sec": 4.44,
   "gap_before": 0.64,
   "event": "instruction",
   "kind": "phone_call",
   "phrasing": "phone_instr_04"
  },
  {
   "speaker": "user",
   "text": "Hello, is that the pharmacy?",
   "est_sec": 1.65,
   "gap_before": 1.62,
   "phrasing": "call_38",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "user",
   "text": "Is my prescription ready to pick up?",
   "est_sec": 2.27,
   "gap_before": 3.71,
   "phrasing": "call_38",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "user",
   "text": "Under the name Rivers.",
   "est_sec": 1.34,
   "gap_before": 3.13,
   "phrasing": "call_38"
  },
  {
   "speaker": "user",
   "text": "Great, I'll come by after work.",
   "est_sec": 1.96,
   "gap_before": 2.41,
   "phrasing": "call_38"
  },
  {
   "speaker": "user",
   "text": "Anyway, what do you think?",
   "est_sec": 1.65,
   "gap_before": 0.6,
   "event": "return_cue",
   "kind": "implicit",
   "phrasing": "implicit_10"
  },
  {
   "speaker": "moshi",
   "text": "Of course. Your godmother's first day. Sights, or take it slow?",
   "est_sec": 3.51,
   "gap_before": 0.88,
   "role": "resume",
   "block": "family_visit.ctx22",
   "reference_only": true
  },
  {
