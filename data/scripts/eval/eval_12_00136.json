 "turns": [
  {
   "speaker": "moshi",
   "text": "Good to hear from you. How are you?",
   "est_sec": 2.58,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_06",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "All good here.",
   "est_sec": 1.03,
   "gap_before": 0.63,
   "event": "greeting_answer",
   "phrasing": "greet_ans_27"
  },
  {
   "speaker": "user",
   "text": "The guest list is getting out of hand. We're at almost two hundred people.",
   "est_sec": 4.44,
   "gap_before": 0.21,
   "event": "ordinary_request",
   "block": "wedding_planning.ctx2"
  },
  {
   "speaker": "moshi",
   "text": "That's a lot. Would you rather cut it down to close friends and family, or keep everyone and adjust the budget?",
   "est_sec": 6.61,
   "gap_before": 1.06,
   "role": "reply",
   "block": "wedding_planning.ctx2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Excuse me, I have to answer the door. I'll come back to you.",
   "est_sec": 4.13,
   "gap_before": 1.37,
   "event": "instruction",
   "kind": "door",
   "phrasing": "door_instr_10"
  },
  {
   "speaker": "moshi",
   "text": "Alright.",
   "est_sec": 0.41,
   "gap_before": 0.66,
   "role": "ack",
   "phrasing": "ack_11",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Hey, come in for a second.",
   "est_sec": 1.96,
   "gap_before": 2.15,
   "phrasing": "door_04"
  },
  {
   "speaker": "visitor",
   "text": "I just wanted to return your ladder.",
   "est_sec": 2.27,
   "gap_before": 0.39,
   "phrasing": "door_04"
  },
  {
   "speaker": "user",
   "text": "Oh great, did it work out?",
   "est_sec": 1.96,
   "gap_before": 0.41,
   "phrasing": "door_04",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "visitor",
   "text": "Perfectly, thanks again.",
   "est_sec": 1.03,
   "gap_before": 1.23,
   "phrasing": "door_04"
  },
  {
   "speaker": "user",
   "text": "Alright, door's closed. I'm back.",
   "est_sec": 1.65,
   "gap_before": 3.88,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "door_cue_03"
  },
  {
   "speaker": "moshi",
   "text": "Hope that was nothing urgent. Still stuck on the guest list? Smaller, or a bigger budget?",
   "est_sec": 5.06,
   "gap_before": 0.55,
   "role": "resume",
   "block": "wedding_planning.ctx2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Let's cut it. Close family and friends only.",
   "est_sec": 2.58,
   "gap_before": 0.86,
   "event": "ordinary_request",
   "block": "wedding_planning.ctx2"
  },
  {
   "speaker": "moshi",
   "text": "A good rule is to only invite people you've seen in the last year or so.",
   "est_sec": 5.06,
   "gap_before": 1.99,
   "role": "followup",
   "block": "wedding_planning.ctx2",
   "reference_only": true
  }
