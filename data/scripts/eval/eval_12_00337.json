 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how's your day going?",
   "est_sec": 1.65,
   "gap_before": 0.56,
   "role": "greeting",
   "phrasing": "greet_03",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Ah, it's been a long day.",
   "est_sec": 1.96,
   "gap_before": 0.92,
   "event": "greeting_answer",
   "phrasing": "greet_ans_24"
  },
  {
   "speaker": "user",
   "text": "What's gouache? I keep seeing it online.",
   "est_sec": 2.27,
   "gap_before": 0.26,
   "event": "ordinary_request",
   "block": "painting_art.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "It's an opaque watercolor. It's water based like watercolor, but you can cover darker colors with lighter ones.",
   "est_sec": 5.68,
   "gap_before": 0.39,
   "role": "reply",
   "block": "painting_art.dlg11",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "So like a mix of watercolor and acrylic?",
   "est_sec": 2.58,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "painting_art.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Kind of. It dries matte and velvety, and you can rewet it later, unlike acrylic.",
   "est_sec": 4.75,
   "gap_before": 1.05,
   "role": "reply",
   "block": "painting_art.dlg11",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Is it good for beginners?",
   "est_sec": 1.65,
   "gap_before": 3.14,
   "event": "ordinary_request",
   "block": "painting_art.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "It's quite friendly. You can fix mistakes by painting over them, which is harder in watercolor.",
   "est_sec": 5.06,
   "gap_before": 0.61,
   "role": "reply",
   "block": "painting_art.dlg11",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What should I paint first?",
   "est_sec": 1.65,
   "gap_before": 1.82,
   "event": "ordinary_request",
   "block": "painting_art.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Try flat shapes, like a poster style landscape with layers of hills. Gouache is great for clean graphic colors.",
   "est_sec": 5.99,
   "gap_before": 0.88,
   "role": "reply",
   "block": "painting_art.dlg11",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Ooh, that sounds",
   "est_sec": 1.03,
   "gap_before": 1.16,
   "event": "distractor",
   "kind": "pause",
   "block": "painting_art.dlg11"
  },
  {
   "speaker": "user",
   "text": "like those vintage travel posters.",
   "est_sec": 1.65,
   "gap_before": 2.55,
   "event": "ordinary_request",
   "block": "painting_art.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Exactly that look. Mix enough of each color before you start, matching it later is tricky.",
   "est_sec": 5.06,
   "gap_before": 1.64,
   "role": "reply",
   "block": "painting_art.dlg11",
   "reference_only": true
  }
 ],
