  {
   "speaker": "moshi",
   "text": "Hey, how's your week going?",
   "est_sec": 1.65,
   "gap_before": 0.7,
   "role": "greeting",
   "phrasing": "greet_15",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Doing okay, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.53,
   "event": "greeting_answer",
   "phrasing": "greet_ans_03"
  },
  {
   "speaker": "user",
   "text": "Do picnics have to be outside? It's raining all week.",
   "est_sec": 3.2,
   "gap_before": 0.4,
   "event": "ordinary_request",
   "block": "picnic.ctx9"
  },
  {
   "speaker": "moshi",
   "text": "Not at all. Would you do an indoor picnic on the living room floor, or find a covered spot like a park pavilion?",
   "est_sec": 7.23,
   "gap_before": 1.16,
   "role": "reply",
   "block": "picnic.ctx9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Can you give me a moment? Kenji wants to show me something. I'll let you know when I'm back.",
   "est_sec": 5.99,
   "gap_before": 0.71,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_24"
  },
  {
   "speaker": "moshi",
   "text": "Okay, I'll hold on.",
   "est_sec": 1.34,
   "gap_before": 0.2,
   "role": "ack",
   "phrasing": "ack_13",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Kenji, new rule. Tonight at dinner we only speak Italian.",
   "est_sec": 3.2,
   "gap_before": 0.91,
   "block": "learning_language.side4"
  },
  {
   "speaker": "friend",
   "text": "Absolutely not. I know how to say pizza and thank you.",
   "est_sec": 3.51,
   "gap_before": 1.2,
   "block": "learning_language.side4"
  },
  {
   "speaker": "user",
   "text": "That's two more words than yesterday. Come on, please?",
   "est_sec": 2.89,
   "gap_before": 0.9,
   "event": "distractor",
   "kind": "friend_question",
   "block": "learning_language.side4"
  },
  {
   "speaker": "friend",
   "text": "Fine, but if I need the salt, I'm pointing.",
   "est_sec": 2.89,
   "gap_before": 1.44,
   "block": "learning_language.side4"
  },
  {
   "speaker": "user",
   "text": "Pointing is allowed. Can you at least say pass the bread?",
   "est_sec": 3.51,
   "gap_before": 1.34,
   "event": "distractor",
   "kind": "friend_question",
   "block": "learning_language.side4"
  },
  {
   "speaker": "friend",
   "text": "Bread is pane, right? Pane, please.",
   "est_sec": 1.96,
   "gap_before": 2.25,
   "block": "learning_language.side4"
  },
  {
   "speaker": "user",
   "text": "Per favore. You're doing great.",
   "est_sec": 1.65,
   "gap_before": 1.26,
   "block": "learning_language.side4"
  },
  {
   "speaker": "friend",
   "text": "I'm doing terribly, and you're enjoying it way too much.",
   "est_sec": 3.2,
   "gap_before": 2.08,
   "block": "learning_language.side4"
  },
  {
   "speaker": "user",
   "text": "I'm back. Where did we leave off?",
   "est_sec": 2.27,
   "gap_before": 1.07,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_12"
  },
