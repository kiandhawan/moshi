 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's it going?",
   "est_sec": 1.34,
   "gap_before": 0.65,
   "role": "greeting",
   "phrasing": "greet_09",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "All good here.",
   "est_sec": 1.03,
   "gap_before": 0.54,
   "event": "greeting_answer",
   "phrasing": "greet_ans_27"
  },
  {
   "speaker": "user",
   "text": "Help, I'm in the store and they have like forty laptops. I'm completely lost.",
   "est_sec": 4.44,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Breathe. Start with your budget and screen size, that cuts it down fast. What's your budget?",
   "est_sec": 5.06,
   "gap_before": 0.57,
   "role": "reply",
   "block": "laptop_buying.dlg6",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "About eight hundred.",
   "est_sec": 1.03,
   "gap_before": 2.16,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Good. And do you carry it around a lot, or is it mostly at home?",
   "est_sec": 4.75,
   "gap_before": 1.08,
   "role": "reply",
   "block": "laptop_buying.dlg6",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Mostly at home.",
   "est_sec": 1.03,
   "gap_before": 0.94,
   "event": "distractor",
   "kind": "pause",
   "block": "laptop_buying.dlg6"
  },
  {
   "speaker": "user",
   "text": "Sometimes on the train.",
   "est_sec": 1.34,
   "gap_before": 1.97,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Then a fourteen inch is a good middle ground. Now check for sixteen gigs of memory and an SSD.",
   "est_sec": 5.99,
   "gap_before": 0.67,
   "role": "reply",
   "block": "laptop_buying.dlg6",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "That leaves maybe five.",
   "est_sec": 1.34,
   "gap_before": 1.23,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Great. Now type on each one for a minute. Pick the keyboard and screen you like most.",
   "est_sec": 5.37,
   "gap_before": 1.15,
   "role": "reply",
