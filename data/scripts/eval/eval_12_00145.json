   "text": "Like what? He's into skateboarding,",
   "est_sec": 1.65,
   "gap_before": 0.97,
   "event": "distractor",
   "kind": "pause",
   "block": "holiday_gifts.dlg3"
  },
  {
   "speaker": "user",
   "text": "I think.",
   "est_sec": 0.72,
   "gap_before": 2.49,
   "event": "ordinary_request",
   "block": "holiday_gifts.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Then a card for a skate shop plus a set of cool stickers for his board would be great.",
   "est_sec": 5.99,
   "gap_before": 1.03,
   "role": "reply",
   "block": "holiday_gifts.dlg3",
   "reference_only": true
  },
