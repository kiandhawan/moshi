 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's it going?",
   "est_sec": 1.34,
   "gap_before": 0.66,
   "role": "greeting",
   "phrasing": "greet_09",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Not bad at all, thanks.",
   "est_sec": 1.65,
   "gap_before": 0.53,
   "event": "greeting_answer",
   "phrasing": "greet_ans_30"
  },
  {
   "speaker": "user",
   "text": "I keep getting distracted at home. Any tips for focusing?",
   "est_sec": 3.2,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "home_office.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Try working in focused blocks, like twenty five minutes on and five off. And keep your phone in another room during those blocks.",
   "est_sec": 7.23,
   "gap_before": 1.15,
   "role": "reply",
   "block": "home_office.dlg2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "My phone in another room? That sounds hard.",
   "est_sec": 2.58,
   "gap_before": 1.04,
   "event": "ordinary_request",
   "block": "home_office.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "It is at first, but it's one of the most effective tricks. Even putting it in a drawer helps.",
   "est_sec": 5.99,
   "gap_before": 0.96,
   "role": "reply",
   "block": "home_office.dlg2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What about noise? My neighbors",
   "est_sec": 1.65,
   "gap_before": 0.79,
   "event": "distractor",
   "kind": "pause",
   "block": "home_office.dlg2"
  },
  {
   "speaker": "user",
   "text": "are doing construction all week.",
   "est_sec": 1.65,
   "gap_before": 2.18,
   "event": "ordinary_request",
   "block": "home_office.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Noise cancelling headphones with some brown noise or instrumental music can block out a lot. Earplugs work too if you're not on calls.",
   "est_sec": 7.23,
   "gap_before": 1.13,
   "role": "reply",
   "block": "home_office.dlg2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Maybe I'll just work from the library on those days.",
   "est_sec": 3.2,
   "gap_before": 0.75,
   "event": "ordinary_request",
   "block": "home_office.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Great idea. A change of scenery often boosts focus all by itself.",
   "est_sec": 3.82,
   "gap_before": 0.76,
   "role": "reply",
   "block": "home_office.dlg2",
   "reference_only": true
  }
 ],
