   "block": "laptop_buying.ctx3"
  },
  {
   "speaker": "moshi",
   "text": "Prices usually drop in about three weeks. Can you get by with your current one until then, or do you need it right away?",
   "est_sec": 7.54,
   "gap_before": 0.75,
   "role": "reply",
   "block": "laptop_buying.ctx3",
   "reference_only": true
  },
  {
