 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how have things been?",
   "est_sec": 1.96,
   "gap_before": 0.58,
   "role": "greeting",
   "phrasing": "greet_27",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Doing okay, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.46,
   "event": "greeting_answer",
   "phrasing": "greet_ans_03"
  },
  {
   "speaker": "user",
   "text": "My podcast recordings sound so echoey. What can I do?",
   "est_sec": 3.2,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "podcasts.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Echo usually comes from hard surfaces. Record in a room with soft things, like a bedroom with carpet and curtains.",
   "est_sec": 6.3,
   "gap_before": 0.48,
   "role": "reply",
   "block": "podcasts.dlg6",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm in my kitchen right now.",
   "est_sec": 1.96,
   "gap_before": 1.22,
   "event": "ordinary_request",
   "block": "podcasts.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Kitchens are the worst for echo, lots of hard surfaces. Even moving to the living room would help.",
   "est_sec": 5.68,
   "gap_before": 1.07,
   "role": "reply",
   "block": "podcasts.dlg6",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What if I can't move?",
   "est_sec": 1.65,
   "gap_before": 1.33,
   "event": "ordinary_request",
   "block": "podcasts.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Hang blankets around you, or put pillows on the table. Also get closer to the mic, so it picks up more of you and less of the room.",
   "est_sec": 8.78,
   "gap_before": 0.68,
   "role": "reply",
   "block": "podcasts.dlg6",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "How close?",
   "est_sec": 0.72,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "podcasts.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "About a hand's width away. Speak slightly to the side so you don't pop the Ps.",
   "est_sec": 5.06,
   "gap_before": 0.77,
   "role": "reply",
   "block": "podcasts.dlg6",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Okay.",
   "est_sec": 0.41,
   "gap_before": 1.06,
   "event": "distractor",
   "kind": "pause",
   "block": "podcasts.dlg6"
  },
  {
   "speaker": "user",
   "text": "I'll try the bedroom tonight.",
   "est_sec": 1.65,
   "gap_before": 1.52,
   "event": "ordinary_request",
   "block": "podcasts.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Great. Record a short test and compare.",
