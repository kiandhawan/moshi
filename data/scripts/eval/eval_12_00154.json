 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's it going? You doing okay?",
   "est_sec": 2.27,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_30",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm doing great.",
   "est_sec": 1.03,
   "gap_before": 0.93,
   "event": "greeting_answer",
   "phrasing": "greet_ans_18"
  },
  {
   "speaker": "user",
   "text": "I'm making a list of stocking stuffers for my teenage daughter. Help?",
   "est_sec": 3.82,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "holiday_gifts.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Sure. Lip balm, fun socks, phone accessories, little notebooks, and her favourite snacks are usually a hit.",
   "est_sec": 5.37,
   "gap_before": 0.46,
   "role": "reply",
   "block": "holiday_gifts.dlg12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "She's really into drawing right now.",
   "est_sec": 1.96,
   "gap_before": 0.79,
   "event": "ordinary_request",
   "block": "holiday_gifts.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Then a few good pens, a small sketchbook, and some washi tape would be great.",
   "est_sec": 4.75,
   "gap_before": 0.5,
   "role": "reply",
   "block": "holiday_gifts.dlg12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What's washi tape?",
   "est_sec": 1.03,
   "gap_before": 3.09,
   "event": "ordinary_request",
   "block": "holiday_gifts.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "It's a decorative paper tape, artists and journal fans use it to decorate pages. It comes in tons of patterns.",
   "est_sec": 6.3,
   "gap_before": 0.9,
   "role": "reply",
   "block": "holiday_gifts.dlg12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Oh, I've seen that in her room.",
   "est_sec": 2.27,
   "gap_before": 0.9,
   "event": "distractor",
   "kind": "pause",
   "block": "holiday_gifts.dlg12"
  },
  {
   "speaker": "user",
   "text": "She'd love more.",
   "est_sec": 1.03,
   "gap_before": 2.99,
   "event": "ordinary_request",
   "block": "holiday_gifts.dlg12"
  },
  {
