 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how's your day going?",
   "est_sec": 1.65,
   "gap_before": 0.43,
   "role": "greeting",
   "phrasing": "greet_03",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Ah, it's been a long day.",
   "est_sec": 1.96,
   "gap_before": 0.73,
   "event": "greeting_answer",
   "phrasing": "greet_ans_24"
  },
  {
   "speaker": "user",
   "text": "Hey, I want to make a gift instead of buying one, but I'm not crafty at all.",
   "est_sec": 5.37,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "holiday_gifts.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "That's fine, there are easy things. Infused oils, homemade hot chocolate mix, or a playlist with a printed cover.",
   "est_sec": 5.99,
   "gap_before": 0.41,
   "role": "reply",
   "block": "holiday_gifts.dlg9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Hot chocolate mix sounds doable.",
   "est_sec": 1.65,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "holiday_gifts.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "It really is. Cocoa, sugar, a pinch of salt, and some little marshmallows, layered in a jar.",
   "est_sec": 5.37,
   "gap_before": 0.61,
   "role": "reply",
   "block": "holiday_gifts.dlg9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "How much of each?",
   "est_sec": 1.34,
   "gap_before": 1.44,
   "event": "ordinary_request",
   "block": "holiday_gifts.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Roughly half a cup of cocoa to a cup of sugar works for a big jar. Add the marshmallows on top so it looks nice.",
   "est_sec": 7.85,
   "gap_before": 0.64,
   "role": "reply",
   "block": "holiday_gifts.dlg9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And how do people use it?",
   "est_sec": 1.96,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "holiday_gifts.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Write it on a tag, three spoons in a mug of hot milk, stir well. Simple and sweet.",
   "est_sec": 5.68,
   "gap_before": 0.3,
   "role": "reply",
   "block": "holiday_gifts.dlg9",
   "reference_only": true
  }
 ],
