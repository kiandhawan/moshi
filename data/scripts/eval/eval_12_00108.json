 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How have you been lately?",
   "est_sec": 1.96,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_18",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Busy day.",
   "est_sec": 1.34,
   "gap_before": 0.58,
   "event": "greeting_answer",
   "phrasing": "greet_ans_06"
  },
  {
   "speaker": "user",
   "text": "I'm going to a really fancy restaurant for the first time and I'm scared of looking stupid.",
   "est_sec": 5.37,
   "gap_before": 0.24,
   "event": "ordinary_request",
   "block": "restaurant_choice.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "That's completely understandable, but the staff at good places want you to feel comfortable. You can ask them anything.",
   "est_sec": 5.99,
   "gap_before": 1.04,
   "role": "reply",
   "block": "restaurant_choice.dlg12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What about all the forks?",
   "est_sec": 1.65,
   "gap_before": 0.98,
   "event": "ordinary_request",
   "block": "restaurant_choice.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Start from the outside and work your way in with each course. If you get it wrong, honestly nobody cares.",
   "est_sec": 6.3,
   "gap_before": 1.08,
   "role": "reply",
   "block": "restaurant_choice.dlg12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And the dress code?",
   "est_sec": 1.34,
   "gap_before": 0.97,
   "event": "ordinary_request",
   "block": "restaurant_choice.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Check their website. If it says smart casual, a nice shirt and clean shoes are enough.",
   "est_sec": 5.06,
   "gap_before": 0.43,
   "role": "reply",
   "block": "restaurant_choice.dlg12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What if I don't understand",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "event": "distractor",
   "kind": "pause",
   "block": "restaurant_choice.dlg12"
  },
  {
   "speaker": "user",
   "text": "half the menu?",
   "est_sec": 1.03,
   "gap_before": 2.31,
   "event": "ordinary_request",
   "block": "restaurant_choice.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Just ask the waiter to explain a dish. They describe things all night, it's part of the fun.",
   "est_sec": 5.68,
   "gap_before": 1.19,
   "role": "reply",
   "block": "restaurant_choice.dlg12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Should I order the tasting menu?",
   "est_sec": 1.96,
   "gap_before": 0.67,
   "event": "ordinary_request",
   "block": "restaurant_choice.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "If it fits your budget, yes. It takes the decisions away and you get to try the best of the kitchen.",
   "est_sec": 6.61,
   "gap_before": 0.69,
   "role": "reply",
   "block": "restaurant_choice.dlg12",
   "reference_only": true
  }
 ],
