   "role": "greeting",
   "phrasing": "greet_03",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Busy day.",
   "est_sec": 1.34,
   "gap_before": 0.89,
   "event": "greeting_answer",
   "phrasing": "greet_ans_06"
  },
  {
   "speaker": "user",
   "text": "I haven't painted in four months. Every time I sit down, nothing comes out.",
   "est_sec": 4.44,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "painting_art.ctx9"
  },
  {
   "speaker": "moshi",
   "text": "That's a rough stretch. Would a tiny daily habit help, like one small sketch every morning, or do you need something outside yourself, like a class or a group?",
   "est_sec": 9.09,
   "gap_before": 0.39,
   "role": "reply",
   "block": "painting_art.ctx9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Give me a moment, I'm going to talk to my friend. Stay quiet until you hear I'm back.",
   "est_sec": 5.68,
   "gap_before": 0.59,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_30"
  },
  {
   "speaker": "user",
   "text": "Can you quiz me on these flashcards for a minute?",
   "est_sec": 3.2,
   "gap_before": 0.78,
   "event": "distractor",
   "kind": "friend_question",
   "block": "learning_language.side3"
  },
  {
   "speaker": "friend",
   "text": "Sure. What's the word for window?",
   "est_sec": 1.96,
   "gap_before": 0.79,
   "block": "learning_language.side3"
  },
  {
   "speaker": "user",
   "text": "Ventana.",
   "est_sec": 0.41,
   "gap_before": 0.6,
   "block": "learning_language.side3"
  },
  {
   "speaker": "friend",
   "text": "Correct. And spoon?",
   "est_sec": 1.03,
   "gap_before": 0.76,
   "block": "learning_language.side3"
  },
  {
   "speaker": "user",
   "text": "Uh, cuchillo?",
   "est_sec": 0.72,
   "gap_before": 0.86,
   "event": "distractor",
   "kind": "friend_question",
   "block": "learning_language.side3"
  },
  {
   "speaker": "friend",
   "text": "No, that's knife. Spoon is cuchara.",
   "est_sec": 1.96,
   "gap_before": 2.11,
   "block": "learning_language.side3"
  },
  {
   "speaker": "user",
   "text": "I always mix those two up. Can you do the kitchen ones again?",
   "est_sec": 4.13,
   "gap_before": 1.3,
   "event": "distractor",
   "kind": "friend_question",
   "block": "learning_language.side3"
  },
