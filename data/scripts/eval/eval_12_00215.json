 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how's your day going?",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_03",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm fine, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "event": "greeting_answer",
   "phrasing": "greet_ans_15"
  },
  {
   "speaker": "user",
   "text": "Is it okay to work from my bed sometimes?",
   "est_sec": 2.89,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "home_office.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Once in a while is fine, but doing it often can hurt your sleep. Your brain starts linking the bed with work.",
   "est_sec": 6.92,
   "gap_before": 0.34,
   "role": "reply",
   "block": "home_office.dlg8",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Oh no, I do it pretty much daily.",
   "est_sec": 2.58,
   "gap_before": 2.99,
   "event": "ordinary_request",
   "block": "home_office.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Then try a small change, like working from the sofa or a kitchen chair, even with the same laptop.",
   "est_sec": 5.99,
   "gap_before": 1.68,
   "role": "reply",
   "block": "home_office.dlg8",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "But my bed is so comfy.",
   "est_sec": 1.96,
   "gap_before": 1.1,
   "event": "ordinary_request",
   "block": "home_office.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "I get it. A lap desk at least keeps your neck in a better position, if you do stay there.",
   "est_sec": 6.3,
   "gap_before": 0.6,
   "role": "reply",
   "block": "home_office.dlg8",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What about my back?",
   "est_sec": 1.34,
   "gap_before": 2.81,
   "event": "ordinary_request",
   "block": "home_office.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Pillows behind you so you're not hunched over. But honestly, a proper chair will feel better by the end of the day.",
   "est_sec": 6.92,
   "gap_before": 1.94,
   "role": "reply",
   "block": "home_office.dlg8",
   "reference_only": true
  }
 ],
