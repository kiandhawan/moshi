   "gap_before": 1.71,
   "event": "distractor",
   "kind": "near_miss",
   "phrasing": "dn_72"
  },
  {
   "speaker": "friend",
   "text": "I knew it was you.",
   "est_sec": 1.65,
   "gap_before": 1.47,
   "phrasing": "dn_72"
  },
  {
