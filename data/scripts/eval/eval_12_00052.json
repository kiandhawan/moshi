   "gap_before": 0.41,
   "event": "ordinary_request",
   "block": "painting_art.ctx3"
  },
  {
   "speaker": "moshi",
   "text": "Hmm, that often comes from contrast. Would you rather darken the shadows on the boats or add a bright color somewhere as a focal point?",
   "est_sec": 7.85,
   "gap_before": 0.91,
   "role": "reply",
   "block": "painting_art.ctx3",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Wait, my friend just got here. Can you hold on and stay quiet until I'm back?",
   "est_sec": 5.06,
   "gap_before": 0.96,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_21"
  },
  {
   "speaker": "user",
   "text": "Are you coming to the party on Friday?",
