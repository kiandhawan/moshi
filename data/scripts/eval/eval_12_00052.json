   "gap_before": 1.4,
   "event": "distractor",
   "kind": "friend_question",
   "phrasing": "dq_12"
  },
  {
   "speaker": "friend",
   "text": "Probably, if I finish work on time.",
   "est_sec": 2.27,
   "gap_before": 2.31,
   "phrasing": "dq_12"
  },
  {
   "speaker": "user",
   "text": "Maya, sorry, I ate your chips.",
