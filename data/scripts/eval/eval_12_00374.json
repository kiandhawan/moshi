 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how's your day going?",
   "est_sec": 1.65,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_03",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "All good here.",
   "est_sec": 1.03,
   "gap_before": 0.8,
   "event": "greeting_answer",
   "phrasing": "greet_ans_27"
  },
  {
   "speaker": "user",
   "text": "I've been stuck at intermediate in French for two years. Nothing changes.",
   "est_sec": 3.82,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "learning_language.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "The intermediate plateau is really common. Often it's because you're comfortable with what you know and avoid harder material.",
   "est_sec": 5.99,
   "gap_before": 0.35,
   "role": "reply",
   "block": "learning_language.dlg9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "That sounds annoyingly accurate.",
   "est_sec": 1.34,
   "gap_before": 1.2,
   "event": "ordinary_request",
   "block": "learning_language.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Try content that's a bit too hard. Podcasts for native speakers, news, books without a dictionary.",
   "est_sec": 5.06,
   "gap_before": 1.53,
   "role": "reply",
   "block": "learning_language.dlg9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "That's exhausting though.",
   "est_sec": 1.03,
   "gap_before": 0.61,
   "event": "ordinary_request",
   "block": "learning_language.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "It is at first. Start with fifteen minutes a day. Also, try writing, short journal entries, and get them corrected.",
   "est_sec": 6.3,
   "gap_before": 0.44,
   "role": "reply",
   "block": "learning_language.dlg9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Who would correct them?",
   "est_sec": 1.34,
   "gap_before": 0.32,
   "event": "ordinary_request",
   "block": "learning_language.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "A tutor, or a language exchange partner, or I can help. Seeing your mistakes in writing makes them stick.",
   "est_sec": 5.99,
   "gap_before": 0.34,
   "role": "reply",
   "block": "learning_language.dlg9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Okay, fine. I'll start a journal.",
   "est_sec": 1.96,
   "gap_before": 1.04,
   "event": "ordinary_request",
   "block": "learning_language.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Great. A few sentences a day is plenty.",
   "est_sec": 2.58,
   "gap_before": 0.64,
   "role": "reply",
   "block": "learning_language.dlg9",
   "reference_only": true
  }
 ],
