 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how have things been?",
   "est_sec": 1.96,
   "gap_before": 0.7,
   "role": "greeting",
   "phrasing": "greet_27",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm fine, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "event": "greeting_answer",
   "phrasing": "greet_ans_15"
  },
  {
   "speaker": "user",
   "text": "My bike's back tire has gone flat again.",
   "est_sec": 2.58,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "cycling.ctx2"
  },
  {
   "speaker": "moshi",
   "text": "Annoying. You could patch the inner tube yourself tonight, or take it to the shop tomorrow and get a sturdier tire. What would you like to do?",
   "est_sec": 8.47,
   "gap_before": 0.73,
   "role": "reply",
   "block": "cycling.ctx2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Good question. Let me think for fifteen seconds, then ask again.",
   "est_sec": 3.51,
   "gap_before": 1.26,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 15,
   "phrasing": "think_instr_09"
  },
  {
   "speaker": "user",
   "text": "No, that won't work.",
   "est_sec": 1.34,
   "anchor": {
    "turn": 4,
    "offset": 8.97
   },
   "event": "distractor",
   "kind": "self_talk",
   "phrasing": "self_03"
  },
  {
   "speaker": "user",
   "text": "Can I have five more seconds?",
   "est_sec": 1.96,
   "event": "extension",
   "extra_sec": 5,
   "phrasing": "extension_06",
   "anchor": {
    "turn": 4,
    "offset": 13.42
   }
  },
  {
   "speaker": "moshi",
   "text": "So what's the plan for that flat tire? Patch it yourself or go to the shop?",
   "est_sec": 5.06,
   "role": "resume",
   "block": "cycling.ctx2",
   "anchor": {
    "turn": 6,
    "offset": 5.01
   },
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'll patch it, I've got a kit somewhere in the garage.",
   "est_sec": 3.51,
   "gap_before": 0.85,
   "event": "ordinary_request",
   "block": "cycling.ctx2"
  },
  {
   "speaker": "moshi",
   "text": "Great. Check the inside of the tire for a thorn first, or it'll go flat again.",
   "est_sec": 5.06,
