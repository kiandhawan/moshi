 "turns": [
  {
   "speaker": "moshi",
   "text": "Good to hear from you. How are you?",
   "est_sec": 2.58,
   "gap_before": 0.73,
   "role": "greeting",
   "phrasing": "greet_06",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Doing okay, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.64,
   "event": "greeting_answer",
   "phrasing": "greet_ans_03"
  },
  {
   "speaker": "user",
   "text": "Is it okay to have a picnic in a cemetery?",
   "est_sec": 3.2,
   "gap_before": 0.35,
   "event": "distractor",
   "kind": "pause",
   "block": "picnic.dlg7"
  },
  {
   "speaker": "user",
   "text": "There's a really pretty one near me.",
   "est_sec": 2.27,
   "gap_before": 2.56,
   "event": "ordinary_request",
   "block": "picnic.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "In some places it's actually a tradition. It's usually fine, as long as you're quiet and respectful.",
   "est_sec": 5.37,
   "gap_before": 1.13,
   "role": "reply",
   "block": "picnic.dlg7",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Are there rules?",
   "est_sec": 1.03,
   "gap_before": 0.89,
   "event": "ordinary_request",
   "block": "picnic.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Check the cemetery's website or signs. Some ask you to stay on certain lawns and avoid sitting near graves.",
   "est_sec": 5.99,
   "gap_before": 1.19,
   "role": "reply",
   "block": "picnic.dlg7",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What about music?",
   "est_sec": 1.03,
   "gap_before": 0.6,
   "event": "ordinary_request",
   "block": "picnic.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "I'd skip it, or keep it very low. Other visitors might be grieving.",
   "est_sec": 4.13,
   "gap_before": 0.87,
   "role": "reply",
   "block": "picnic.dlg7",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "That makes sense.",
   "est_sec": 1.03,
   "gap_before": 0.68,
   "event": "ordinary_request",
   "block": "picnic.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "And take everything with you when you leave, of course, even crumbs that might attract birds.",
   "est_sec": 5.06,
   "gap_before": 0.98,
   "role": "reply",
   "block": "picnic.dlg7",
   "reference_only": true
  }
 ],
