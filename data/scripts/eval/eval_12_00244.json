 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how's your day going?",
   "est_sec": 1.65,
   "gap_before": 0.66,
   "role": "greeting",
   "phrasing": "greet_03",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm okay, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.75,
   "event": "greeting_answer",
   "phrasing": "greet_ans_21"
  },
  {
   "speaker": "user",
   "text": "I'm left handed and I hate trackpads. Any laptop tips?",
   "est_sec": 3.2,
   "gap_before": 0.27,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Plenty of left handed people use a mouse, honestly. A small wireless mouse fixes most trackpad frustration.",
   "est_sec": 5.37,
   "gap_before": 1.18,
   "role": "reply",
   "block": "laptop_buying.dlg9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Even on the go?",
   "est_sec": 1.34,
   "gap_before": 0.61,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Yes, there are tiny travel mice that fit in a pocket. Some fold flat.",
   "est_sec": 4.44,
   "gap_before": 1.05,
   "role": "reply",
   "block": "laptop_buying.dlg9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Are there laptops with better trackpads at least?",
   "est_sec": 2.58,
   "gap_before": 0.62,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Some have bigger, smoother glass trackpads that feel much nicer. Try a few in a store if you can.",
   "est_sec": 5.99,
   "gap_before": 1.18,
   "role": "reply",
   "block": "laptop_buying.dlg9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And keyboards?",
   "est_sec": 0.72,
   "gap_before": 1.16,
   "event": "distractor",
   "kind": "pause",
   "block": "laptop_buying.dlg9"
  },
  {
   "speaker": "user",
   "text": "Anything specific for left handers?",
   "est_sec": 1.65,
   "gap_before": 2.01,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Not really, but a laptop with a number pad shifts the keyboard to the left, which some lefties actually like.",
   "est_sec": 6.3,
   "gap_before": 0.59,
   "role": "reply",
   "block": "laptop_buying.dlg9",
   "reference_only": true
  }
