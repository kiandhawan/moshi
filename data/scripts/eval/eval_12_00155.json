 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how's your day going?",
   "est_sec": 1.65,
   "gap_before": 0.52,
   "role": "greeting",
   "phrasing": "greet_03",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Busy day.",
   "est_sec": 1.34,
   "gap_before": 0.63,
   "event": "greeting_answer",
   "phrasing": "greet_ans_06"
  },
  {
   "speaker": "user",
   "text": "The wedding's tomorrow and I can't stop shaking.",
   "est_sec": 2.58,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "wedding_planning.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "That's completely normal. Have you eaten today?",
   "est_sec": 2.27,
   "gap_before": 0.79,
   "role": "reply",
   "block": "wedding_planning.dlg11",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Barely. Some crackers.",
   "est_sec": 1.03,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "wedding_planning.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Eat something real tonight, and drink water. Nerves get worse on an empty stomach.",
   "est_sec": 4.44,
   "gap_before": 0.81,
   "role": "reply",
   "block": "wedding_planning.dlg11",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "My head is full of everything that could go wrong.",
   "est_sec": 3.2,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "wedding_planning.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Things might go a little wrong, and nobody will notice. Guests remember how happy you looked, not whether the napkins matched.",
   "est_sec": 6.61,
   "gap_before": 0.95,
   "role": "reply",
   "block": "wedding_planning.dlg11",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "That actually helps.",
   "est_sec": 1.03,
   "gap_before": 0.83,
   "event": "ordinary_request",
   "block": "wedding_planning.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Also, pick one person to handle problems tomorrow. Anything goes wrong, they deal with it, not you.",
   "est_sec": 5.37,
   "gap_before": 0.76,
   "role": "reply",
   "block": "wedding_planning.dlg11",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "My sister would love that power.",
   "est_sec": 1.96,
   "gap_before": 0.65,
   "event": "ordinary_request",
   "block": "wedding_planning.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Perfect. Give her the job, then go to bed early. You've done the work.",
   "est_sec": 4.44,
   "gap_before": 1.49,
   "role": "reply",
   "block": "wedding_planning.dlg11",
   "reference_only": true
  }
 ],
