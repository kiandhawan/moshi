 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there, how are you doing today?",
   "est_sec": 2.27,
   "gap_before": 0.7,
   "role": "greeting",
   "phrasing": "greet_12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm doing great.",
   "est_sec": 1.03,
   "gap_before": 0.36,
   "event": "greeting_answer",
   "phrasing": "greet_ans_18"
  },
  {
   "speaker": "user",
   "text": "My drawings always look stiff. How do I make them more alive?",
   "est_sec": 3.82,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "painting_art.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Try gesture drawing. Draw people or animals in thirty seconds each, catching the movement rather than the details.",
   "est_sec": 5.68,
   "gap_before": 0.4,
   "role": "reply",
   "block": "painting_art.dlg7",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Thirty seconds? I can't draw anything in thirty seconds.",
   "est_sec": 2.89,
   "gap_before": 3.15,
   "event": "ordinary_request",
   "block": "painting_art.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "That's the point. You don't have time to be careful, so you start seeing the big flowing lines.",
   "est_sec": 5.68,
   "gap_before": 0.93,
   "role": "reply",
   "block": "painting_art.dlg7",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Where would I even practice?",
   "est_sec": 1.65,
   "gap_before": 0.91,
   "event": "ordinary_request",
   "block": "painting_art.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Cafes, parks, train stations. Or there are free websites with timed pose photos.",
   "est_sec": 4.13,
   "gap_before": 1.77,
   "role": "reply",
   "block": "painting_art.dlg7",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Feels a bit",
   "est_sec": 1.03,
   "gap_before": 1.42,
   "event": "distractor",
   "kind": "pause",
   "block": "painting_art.dlg7"
  },
  {
   "speaker": "user",
   "text": "awkward drawing strangers.",
   "est_sec": 1.03,
   "gap_before": 2.34,
   "event": "ordinary_request",
   "block": "painting_art.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Most people never notice. And if someone does, they're usually curious and flattered.",
   "est_sec": 4.13,
   "gap_before": 0.62,
   "role": "reply",
   "block": "painting_art.dlg7",
   "reference_only": true
  }
