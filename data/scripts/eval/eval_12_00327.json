   "role": "greeting",
   "phrasing": "greet_24",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Busy day.",
   "est_sec": 1.34,
   "gap_before": 0.88,
   "event": "greeting_answer",
   "phrasing": "greet_ans_06"
  },
  {
   "speaker": "user",
   "text": "My parents are staying with us next week and our apartment is tiny.",
   "est_sec": 4.13,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "family_visit.ctx1"
  },
  {
   "speaker": "moshi",
   "text": "That can be tricky. Would you give them your bedroom and take the couch, or book them a hotel nearby?",
   "est_sec": 6.3,
   "gap_before": 1.06,
   "role": "reply",
   "block": "family_visit.ctx1",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Oh, the doorbell. Hang tight and wait for me.",
   "est_sec": 2.89,
   "gap_before": 1.18,
   "event": "instruction",
   "kind": "door",
   "phrasing": "door_instr_08"
  },
  {
   "speaker": "moshi",
   "text": "No problem.",
   "est_sec": 0.72,
   "gap_before": 0.39,
   "role": "ack",
   "phrasing": "ack_04",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Hi, sorry, I was upstairs.",
   "est_sec": 1.65,
   "gap_before": 2.8,
   "phrasing": "door_15"
  },
  {
   "speaker": "visitor",
   "text": "Hi, we're from the energy company, we're offering free home checks today.",
   "est_sec": 3.82,
   "gap_before": 0.41,
   "phrasing": "door_15"
  },
  {
   "speaker": "user",
   "text": "Do I have to sign anything?",
   "est_sec": 1.96,
   "gap_before": 1.09,
   "phrasing": "door_15",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "visitor",
   "text": "Just a short form, it takes ten minutes.",
   "est_sec": 2.58,
   "gap_before": 3.18,
   "phrasing": "door_15"
  },
  {
   "speaker": "user",
   "text": "Thanks, but not today.",
   "est_sec": 1.34,
   "gap_before": 1.07,
   "phrasing": "door_15"
  },
  {
   "speaker": "user",
   "text": "Sorry, you were saying?",
