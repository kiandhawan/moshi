 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how have things been?",
   "est_sec": 1.96,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_27",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Fine, thanks.",
   "est_sec": 0.72,
   "gap_before": 0.37,
   "event": "greeting_answer",
   "phrasing": "greet_ans_09"
  },
  {
   "speaker": "user",
   "text": "Can you help me plan a picnic for my toddler's playgroup?",
   "est_sec": 3.51,
   "gap_before": 0.44,
   "event": "distractor",
   "kind": "pause",
   "block": "picnic.dlg5"
  },
  {
   "speaker": "user",
   "text": "There'll be about eight kids.",
   "est_sec": 1.65,
   "gap_before": 1.72,
   "event": "ordinary_request",
   "block": "picnic.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Sure. Keep the food simple and finger sized. Cut grapes in half, little sandwiches, cheese cubes and crackers.",
   "est_sec": 5.68,
   "gap_before": 0.66,
   "role": "reply",
   "block": "picnic.dlg5",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Why cut the grapes?",
   "est_sec": 1.34,
   "gap_before": 0.69,
   "event": "ordinary_request",
   "block": "picnic.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Whole grapes are a choking risk for little ones, so halving or quartering them is safer.",
   "est_sec": 5.06,
   "gap_before": 0.69,
   "role": "reply",
   "block": "picnic.dlg5",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Good to know. What about activities?",
   "est_sec": 1.96,
   "gap_before": 0.76,
   "event": "ordinary_request",
   "block": "picnic.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Bubbles, a ball and a few toy trucks are plenty. Toddlers mostly want to run, dig and chase each other.",
   "est_sec": 6.3,
   "gap_before": 0.38,
   "role": "reply",
   "block": "picnic.dlg5",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And shade?",
   "est_sec": 0.72,
   "gap_before": 0.84,
   "event": "ordinary_request",
   "block": "picnic.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Very important. A pop up tent or a big umbrella gives them somewhere to nap or cool off.",
   "est_sec": 5.68,
   "gap_before": 1.1,
   "role": "reply",
   "block": "picnic.dlg5",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Should I bring wipes?",
   "est_sec": 1.34,
   "gap_before": 0.96,
   "event": "ordinary_request",
   "block": "picnic.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Lots of them. More than you think you need.",
   "est_sec": 2.89,
   "gap_before": 0.76,
   "role": "reply",
   "block": "picnic.dlg5",
   "reference_only": true
  }
 ],
