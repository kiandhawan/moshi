 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your week going?",
   "est_sec": 1.65,
   "gap_before": 0.54,
   "role": "greeting",
   "phrasing": "greet_15",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Doing okay, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.34,
   "event": "greeting_answer",
   "phrasing": "greet_ans_03"
  },
  {
   "speaker": "user",
   "text": "I hate it when I order the wrong thing. How do you pick from a big menu?",
   "est_sec": 5.37,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "restaurant_choice.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Ask the server what the kitchen is proudest of. That question gets a more honest answer than what's popular.",
   "est_sec": 5.99,
   "gap_before": 0.73,
   "role": "reply",
   "block": "restaurant_choice.dlg5",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And if they just say everything is good?",
   "est_sec": 2.58,
   "gap_before": 0.98,
   "event": "ordinary_request",
   "block": "restaurant_choice.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Then try, what would you order tonight? People answer that one much more personally.",
   "est_sec": 4.44,
   "gap_before": 1.08,
   "role": "reply",
   "block": "restaurant_choice.dlg5",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Hang on, is that true?",
   "est_sec": 1.65,
   "gap_before": 0.42,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_09",
   "block": "restaurant_choice.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Hmm, I believe it is. Which part doesn't sound right?",
   "est_sec": 3.2,
   "gap_before": 1.15,
   "role": "reply",
   "block": "restaurant_choice.dlg5",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Ha, okay. What about specials, are they a trick to get rid of old stock?",
   "est_sec": 4.75,
   "gap_before": 0.71,
   "event": "ordinary_request",
   "block": "restaurant_choice.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Sometimes, but usually they're seasonal ingredients the chef is excited about. If the special is fish on a Monday, I'd be a bit more cautious.",
   "est_sec": 7.85,
   "gap_before": 0.44,
   "role": "reply",
   "block": "restaurant_choice.dlg5",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Why Monday?",
   "est_sec": 0.72,
   "gap_before": 0.34,
   "event": "ordinary_request",
   "block": "restaurant_choice.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Many fish markets are closed on Sundays, so Monday fish might be a few days old. It's not a rule, just a hint.",
   "est_sec": 7.23,
   "gap_before": 0.94,
   "role": "reply",
   "block": "restaurant_choice.dlg5",
   "reference_only": true
  }
 ],
