   "event": "ordinary_request",
   "block": "holiday_gifts.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Anything handmade or personalised, and anything that was obviously chosen just for you.",
   "est_sec": 4.13,
   "gap_before": 0.86,
