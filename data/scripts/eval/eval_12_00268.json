 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how have things been?",
   "est_sec": 1.96,
   "gap_before": 0.67,
   "role": "greeting",
   "phrasing": "greet_27",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "All good here.",
   "est_sec": 1.03,
   "gap_before": 0.41,
   "event": "greeting_answer",
   "phrasing": "greet_ans_27"
  },
  {
   "speaker": "user",
   "text": "What's the difference between an SSD and a hard drive, in plain words?",
   "est_sec": 4.13,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "A hard drive has spinning disks inside. An SSD has no moving parts, so it's much faster and quieter.",
   "est_sec": 5.99,
   "gap_before": 0.46,
   "role": "reply",
   "block": "laptop_buying.dlg4",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Is it really that noticeable?",
   "est_sec": 1.65,
   "gap_before": 1.82,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Very. Your laptop will start up in seconds and apps open almost instantly.",
   "est_sec": 4.13,
   "gap_before": 0.88,
   "role": "reply",
   "block": "laptop_buying.dlg4",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And size wise, how much",
   "est_sec": 1.65,
   "gap_before": 0.36,
   "event": "distractor",
   "kind": "pause",
   "block": "laptop_buying.dlg4"
  },
  {
   "speaker": "user",
   "text": "do I need?",
   "est_sec": 1.03,
   "gap_before": 1.9,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "For most people, five hundred gigs is plenty. If you keep lots of photos or games, go for a terabyte.",
   "est_sec": 6.3,
   "gap_before": 0.56,
   "role": "reply",
   "block": "laptop_buying.dlg4",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What about cloud storage?",
   "est_sec": 1.34,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "It's a nice backup, and it helps if your drive is small. Just don't rely on it if your internet is slow.",
   "est_sec": 6.92,
   "gap_before": 0.5,
   "role": "reply",
   "block": "laptop_buying.dlg4",
   "reference_only": true
  }
