 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there, how are you doing today?",
   "est_sec": 2.27,
   "gap_before": 0.6,
   "role": "greeting",
   "phrasing": "greet_12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm doing great.",
   "est_sec": 1.03,
   "gap_before": 0.6,
   "event": "greeting_answer",
   "phrasing": "greet_ans_18"
  },
  {
   "speaker": "user",
   "text": "Working from home is great, but I never really stop working.",
   "est_sec": 3.51,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "home_office.ctx3"
  },
  {
   "speaker": "moshi",
   "text": "That's a common trap. What could be your end of the day ritual, something that tells your brain work is over?",
   "est_sec": 6.61,
   "gap_before": 0.66,
   "role": "reply",
   "block": "home_office.ctx3",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Excuse me, I have to answer the door. I'll come back to you.",
   "est_sec": 4.13,
   "gap_before": 1.23,
   "event": "instruction",
   "kind": "door",
   "phrasing": "door_instr_10"
  },
  {
   "speaker": "user",
   "text": "Hey, come in for a second.",
   "est_sec": 1.96,
   "gap_before": 2.97,
   "phrasing": "door_04"
  },
  {
   "speaker": "visitor",
   "text": "I just wanted to return your ladder.",
   "est_sec": 2.27,
   "gap_before": 1.27,
   "phrasing": "door_04"
  },
  {
   "speaker": "user",
   "text": "Oh great, did it work out?",
   "est_sec": 1.96,
   "gap_before": 0.48,
   "phrasing": "door_04",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "visitor",
   "text": "Perfectly, thanks again.",
   "est_sec": 1.03,
   "gap_before": 0.8,
   "phrasing": "door_04"
  },
  {
   "speaker": "user",
   "text": "Sorry, you were saying?",
   "est_sec": 1.34,
