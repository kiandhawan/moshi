   "gap_before": 1.03,
   "event": "ordinary_request",
   "block": "podcasts.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Loyal fans do. Some shows also sell merch or do live tours.",
   "est_sec": 3.82,
   "gap_before": 0.83,
   "role": "reply",
   "block": "podcasts.dlg4",
   "reference_only": true
