   "role": "reply",
   "block": "podcasts.dlg4",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "So tiny shows make nothing?",
   "est_sec": 1.65,
   "gap_before": 0.9,
   "event": "ordinary_request",
   "block": "podcasts.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Often very little from ads. Smaller shows lean on listener support, like monthly memberships with bonus episodes.",
