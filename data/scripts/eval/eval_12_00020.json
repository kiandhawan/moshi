 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there, how are you doing today?",
   "est_sec": 2.27,
   "gap_before": 0.64,
   "role": "greeting",
   "phrasing": "greet_12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "All good here.",
   "est_sec": 1.03,
   "gap_before": 0.64,
   "event": "greeting_answer",
   "phrasing": "greet_ans_27"
  },
  {
   "speaker": "user",
   "text": "My kids are visiting their grandparents on the farm for the summer.",
   "est_sec": 3.82,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "family_visit.ctx17"
  },
  {
   "speaker": "moshi",
   "text": "Without you?",
   "est_sec": 0.72,
   "gap_before": 0.76,
   "role": "reply",
   "block": "family_visit.ctx17",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Yeah, first time. They're seven and nine.",
   "est_sec": 2.27,
   "gap_before": 0.75,
   "event": "ordinary_request",
   "block": "family_visit.ctx17"
  },
  {
   "speaker": "moshi",
   "text": "Exciting for them. Would you rather they call every evening, or only a couple of times a week so they settle in?",
   "est_sec": 6.92,
   "gap_before": 0.57,
   "role": "reply",
   "block": "family_visit.ctx17",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Excuse me, I have to answer the door. I'll come back to you.",
   "est_sec": 4.13,
   "gap_before": 0.36,
   "event": "instruction",
   "kind": "door",
   "phrasing": "door_instr_10"
  },
  {
   "speaker": "moshi",
   "text": "Sure thing.",
   "est_sec": 0.72,
   "gap_before": 0.32,
   "role": "ack",
   "phrasing": "ack_12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Yes, morning.",
   "est_sec": 0.72,
   "gap_before": 2.31,
   "phrasing": "door_20"
  },
  {
   "speaker": "visitor",
   "text": "Police, ma'am, nothing to worry about. We're asking about a car break-in last night.",
   "est_sec": 4.44,
   "gap_before": 0.84,
   "phrasing": "door_20"
  },
  {
   "speaker": "user",
   "text": "Which car? On this street?",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "phrasing": "door_20",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "visitor",
   "text": "The blue van by the lamppost. Did you hear anything?",
   "est_sec": 3.2,
   "gap_before": 1.16,
   "phrasing": "door_20"
  },
  {
   "speaker": "user",
   "text": "Sorry, I sleep like a log.",
   "est_sec": 1.96,
   "gap_before": 0.39,
   "phrasing": "door_20"
  },
  {
   "speaker": "user",
   "text": "Anyway, where were we?",
   "est_sec": 1.34,
   "gap_before": 3.0,
   "event": "return_cue",
   "kind": "implicit",
   "phrasing": "implicit_01"
  },
  {
   "speaker": "moshi",
   "text": "Sure. Still undecided on the call schedule?",
   "est_sec": 2.27,
   "gap_before": 0.38,
   "role": "resume",
   "block": "family_visit.ctx17",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Couple times a week. They need to have their own adventure.",
   "est_sec": 3.51,
   "gap_before": 1.1,
   "event": "ordinary_request",
   "block": "family_visit.ctx17"
  },
