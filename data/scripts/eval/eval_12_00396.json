 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your week going?",
   "est_sec": 1.65,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_15",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Busy day.",
   "est_sec": 1.34,
   "gap_before": 0.86,
   "event": "greeting_answer",
   "phrasing": "greet_ans_06"
  },
  {
   "speaker": "user",
   "text": "My boss gave everyone gifts last year and I didn't get her anything. Should I this year?",
   "est_sec": 5.37,
   "gap_before": 0.4,
   "event": "ordinary_request",
   "block": "holiday_gifts.ctx10"
  },
  {
   "speaker": "moshi",
   "text": "It's thoughtful but not expected. Would you rather give her something small yourself, or chip in on a group gift from the team?",
   "est_sec": 7.23,
   "gap_before": 0.41,
   "role": "reply",
   "block": "holiday_gifts.ctx10",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I need to take this, it's important. Please hold on until I'm done.",
   "est_sec": 4.13,
   "gap_before": 1.02,
   "event": "instruction",
   "kind": "phone_call",
   "phrasing": "phone_instr_08"
  },
  {
   "speaker": "user",
   "text": "Hey, I'm outside your building.",
   "est_sec": 1.65,
   "gap_before": 1.19,
   "phrasing": "call_16"
  },
  {
   "speaker": "user",
   "text": "Which buzzer is it again?",
   "est_sec": 1.65,
   "gap_before": 2.41,
   "phrasing": "call_16",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "user",
   "text": "Sorry, you broke up, say it once more. Okay, I've got you back now.",
   "est_sec": 4.44,
   "gap_before": 2.4,
   "phrasing": "call_16",
   "event": "distractor",
   "kind": "near_miss"
  },
  {
