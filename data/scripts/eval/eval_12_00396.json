   "text": "Flat nine, got it, coming up.",
   "est_sec": 1.96,
   "gap_before": 3.9,
   "phrasing": "call_16"
  },
  {
   "speaker": "user",
   "text": "Done with the call. I'm back.",
   "est_sec": 1.96,
   "gap_before": 0.7,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "phone_cue_06"
  },
  {
