 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there, how are you doing today?",
   "est_sec": 2.27,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm okay, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.93,
   "event": "greeting_answer",
   "phrasing": "greet_ans_21"
  },
  {
   "speaker": "user",
   "text": "What's the best way to keep drinks cold at a picnic?",
   "est_sec": 3.51,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "picnic.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Freeze some water bottles the night before. They act like ice packs and you can drink them as they melt.",
   "est_sec": 6.3,
   "gap_before": 0.33,
   "role": "reply",
   "block": "picnic.dlg4",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Oh, clever. What about",
   "est_sec": 1.34,
   "gap_before": 1.26,
   "event": "distractor",
   "kind": "pause",
   "block": "picnic.dlg4"
  },
  {
   "speaker": "user",
   "text": "a bottle of wine?",
   "est_sec": 1.34,
   "gap_before": 1.75,
   "event": "ordinary_request",
   "block": "picnic.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Wrap the bottle in a wet towel and keep it in the shade. As the water evaporates, it cools the bottle.",
   "est_sec": 6.61,
   "gap_before": 0.69,
   "role": "reply",
   "block": "picnic.dlg4",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Does that actually work?",
   "est_sec": 1.34,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "picnic.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "It does, a little. A cheap insulated wine bag works even better.",
   "est_sec": 3.82,
   "gap_before": 1.46,
   "role": "reply",
   "block": "picnic.dlg4",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And for the kids' juice boxes?",
   "est_sec": 1.96,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "picnic.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Freeze half of them. By lunch they'll be slushy and cold, and kids usually love that.",
   "est_sec": 5.06,
   "gap_before": 1.62,
   "role": "reply",
   "block": "picnic.dlg4",
   "reference_only": true
  }
 ],
