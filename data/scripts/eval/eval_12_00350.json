 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your week going?",
   "est_sec": 1.65,
   "gap_before": 0.3,
   "role": "greeting",
   "phrasing": "greet_15",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Busy day.",
   "est_sec": 1.34,
   "gap_before": 0.43,
   "event": "greeting_answer",
   "phrasing": "greet_ans_06"
  },
  {
   "speaker": "user",
   "text": "How high should my monitor be?",
   "est_sec": 1.96,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "home_office.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "The top of the screen should be at about eye level or slightly below. You should be looking a bit down, not up.",
   "est_sec": 7.23,
   "gap_before": 0.62,
   "role": "reply",
   "block": "home_office.dlg1",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And how far away?",
   "est_sec": 1.34,
   "gap_before": 1.09,
   "event": "ordinary_request",
   "block": "home_office.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Roughly an arm's length. If you have to lean forward to read, make the text bigger rather than moving closer.",
   "est_sec": 6.3,
   "gap_before": 1.63,
   "role": "reply",
   "block": "home_office.dlg1",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I only have a laptop, so",
   "est_sec": 1.96,
   "gap_before": 1.23,
   "event": "distractor",
   "kind": "pause",
   "block": "home_office.dlg1"
  },
  {
   "speaker": "user",
   "text": "it's always too low.",
   "est_sec": 1.34,
   "gap_before": 2.19,
   "event": "ordinary_request",
   "block": "home_office.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "A laptop stand with a separate keyboard and mouse fixes that. Even a stack of books works in a pinch.",
   "est_sec": 6.3,
   "gap_before": 1.86,
   "role": "reply",
   "block": "home_office.dlg1",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Ha, I'll use my old textbooks then.",
   "est_sec": 2.27,
   "gap_before": 0.98,
   "event": "ordinary_request",
   "block": "home_office.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Finally a good use for them. Just make sure the stack is stable.",
   "est_sec": 4.13,
   "gap_before": 0.95,
   "role": "reply",
