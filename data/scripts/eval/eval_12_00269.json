 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there! How's it going today?",
   "est_sec": 1.96,
   "gap_before": 0.45,
   "role": "greeting",
   "phrasing": "greet_21",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Busy day.",
   "est_sec": 1.34,
   "gap_before": 0.81,
   "event": "greeting_answer",
   "phrasing": "greet_ans_06"
  },
  {
   "speaker": "user",
   "text": "I'm thinking of buying a laptop online but I'm scared of getting a dud.",
   "est_sec": 4.44,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "That's fair. Buying from a big retailer or the brand directly makes returns a lot easier.",
   "est_sec": 5.06,
   "gap_before": 0.32,
   "role": "reply",
   "block": "laptop_buying.dlg12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "How long do I usually have to return it?",
   "est_sec": 2.89,
   "gap_before": 1.36,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Often fourteen to thirty days. Check before you buy, and keep the box and all the bits.",
   "est_sec": 5.37,
   "gap_before": 0.94,
   "role": "reply",
   "block": "laptop_buying.dlg12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What should I check when it arrives?",
   "est_sec": 2.27,
   "gap_before": 1.28,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Look for dead pixels, test the keyboard and ports, and run it for a few hours to see how it handles heat.",
   "est_sec": 6.92,
   "gap_before": 0.8,
   "role": "reply",
   "block": "laptop_buying.dlg12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Okay, that sounds",
   "est_sec": 1.03,
   "gap_before": 1.18,
   "event": "distractor",
   "kind": "pause",
   "block": "laptop_buying.dlg12"
  },
  {
   "speaker": "user",
   "text": "doable, actually.",
   "est_sec": 0.72,
   "gap_before": 2.44,
   "event": "ordinary_request",
   "block": "laptop_buying.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "It is. And if anything feels off, start the return quickly. Don't wait until the last day.",
   "est_sec": 5.37,
   "gap_before": 0.58,
   "role": "reply",
   "block": "laptop_buying.dlg12",
   "reference_only": true
  }
 ],
