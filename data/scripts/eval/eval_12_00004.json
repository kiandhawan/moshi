 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's it going?",
   "est_sec": 1.34,
   "gap_before": 0.65,
   "role": "greeting",
   "phrasing": "greet_09",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Fine, thanks.",
   "est_sec": 0.72,
   "gap_before": 0.37,
   "event": "greeting_answer",
   "phrasing": "greet_ans_09"
  },
  {
   "speaker": "user",
   "text": "What's the safest way to ride past parked cars?",
   "est_sec": 2.89,
   "gap_before": 0.59,
   "event": "ordinary_request",
   "block": "cycling.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Stay about a car door's width away from them. That way, if someone opens a door suddenly, you won't hit it.",
   "est_sec": 6.61,
   "gap_before": 0.91,
   "role": "reply",
   "block": "cycling.dlg5",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "But then cars behind me get annoyed.",
   "est_sec": 2.27,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "cycling.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "They might, but your safety matters more. Riding confidently in the lane makes you more visible too.",
   "est_sec": 5.37,
   "gap_before": 0.45,
   "role": "reply",
   "block": "cycling.dlg5",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What about at junctions?",
   "est_sec": 1.34,
   "gap_before": 1.02,
   "event": "ordinary_request",
   "block": "cycling.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Try to make eye contact with drivers and avoid riding up the inside of big vehicles, especially lorries turning left.",
   "est_sec": 6.3,
   "gap_before": 0.85,
   "role": "reply",
   "block": "cycling.dlg5",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "That's terrifying.",
   "est_sec": 0.72,
   "gap_before": 1.06,
   "event": "ordinary_request",
   "block": "cycling.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "It's good to know though. Most rides are completely uneventful, these habits just keep it that way.",
   "est_sec": 5.37,
   "gap_before": 0.32,
   "role": "reply",
   "block": "cycling.dlg5",
   "reference_only": true
  }
 ],
