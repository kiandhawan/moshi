 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there, how are you doing today?",
   "est_sec": 2.27,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Not bad at all, thanks.",
   "est_sec": 1.65,
   "gap_before": 0.99,
   "event": "greeting_answer",
   "phrasing": "greet_ans_30"
  },
  {
   "speaker": "user",
   "text": "It's supposed to rain all weekend where we're camping.",
   "est_sec": 2.89,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "camping.ctx6"
  },
  {
   "speaker": "moshi",
   "text": "Ugh, that's annoying. Is the trip still on?",
