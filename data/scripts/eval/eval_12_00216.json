   "gap_before": 1.01,
   "role": "reply",
   "block": "camping.ctx6",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Let me think for fifteen seconds, then check back with me.",
   "est_sec": 3.51,
   "gap_before": 2.44,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 15,
   "phrasing": "think_instr_06"
  },
  {
   "speaker": "moshi",
   "text": "Sure, go ahead.",
   "est_sec": 1.03,
   "gap_before": 0.28,
   "role": "ack",
   "phrasing": "ack_08",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Hmm, maybe.",
   "est_sec": 0.72,
   "anchor": {
    "turn": 6,
    "offset": 11.43
   },
   "event": "distractor",
   "kind": "self_talk",
   "phrasing": "self_12"
  },
  {
   "speaker": "user",
   "text": "Sorry, ten more seconds.",
