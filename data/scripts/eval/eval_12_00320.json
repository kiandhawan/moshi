 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's it going?",
   "est_sec": 1.34,
   "gap_before": 0.32,
   "role": "greeting",
   "phrasing": "greet_09",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm fine, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.92,
   "event": "greeting_answer",
   "phrasing": "greet_ans_15"
  },
  {
   "speaker": "user",
   "text": "Every time I ask my husband where he wants to eat, he says I don't mind.",
   "est_sec": 5.06,
   "gap_before": 0.36,
   "event": "ordinary_request",
   "block": "restaurant_choice.ctx12"
  },
  {
   "speaker": "moshi",
   "text": "Classic. Try this, you name three places and he vetoes one. Which three would you put on the list?",
   "est_sec": 5.99,
   "gap_before": 0.79,
   "role": "reply",
   "block": "restaurant_choice.ctx12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Hold on, I need to answer this call. I'll tell you when I'm back.",
   "est_sec": 4.44,
   "gap_before": 0.51,
   "event": "instruction",
   "kind": "phone_call",
   "phrasing": "phone_instr_03"
  },
  {
   "speaker": "user",
   "text": "Hi, Mr Patel? It's about the boiler service.",
   "est_sec": 2.58,
   "gap_before": 1.03,
   "phrasing": "call_28"
  },
  {
   "speaker": "user",
   "text": "Would Wednesday suit you?",
   "est_sec": 1.34,
   "gap_before": 2.39,
   "phrasing": "call_28",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "user",
   "text": "And roughly how long does it take?",
   "est_sec": 2.27,
   "gap_before": 2.08,
   "phrasing": "call_28",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "user",
   "text": "Lovely, see you then.",
   "est_sec": 1.34,
   "gap_before": 3.72,
   "phrasing": "call_28"
  },
  {
   "speaker": "user",
   "text": "Sorry about that call. I'm back now.",
   "est_sec": 2.27,
   "gap_before": 1.84,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "phone_cue_04"
  },
  {
   "speaker": "moshi",
   "text": "Welcome back. The veto game still needs three places. Which ones?",
   "est_sec": 3.51,
   "gap_before": 0.33,
   "role": "resume",
   "block": "restaurant_choice.ctx12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Sushi, pizza and the Thai place down the road.",
   "est_sec": 2.89,
   "gap_before": 1.35,
   "event": "ordinary_request",
   "block": "restaurant_choice.ctx12"
  },
  {
   "speaker": "moshi",
   "text": "Nice mix. Whatever survives, at least you won't be the one who decided alone.",
   "est_sec": 4.44,
   "gap_before": 1.09,
   "role": "followup",
