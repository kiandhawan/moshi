 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how have things been?",
   "est_sec": 1.96,
   "gap_before": 0.55,
   "role": "greeting",
   "phrasing": "greet_27",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Okay, I guess.",
   "est_sec": 1.03,
   "gap_before": 0.43,
   "event": "greeting_answer",
   "phrasing": "greet_ans_12"
  },
  {
   "speaker": "user",
   "text": "How long does it take to become conversational in a language?",
   "est_sec": 3.51,
   "gap_before": 0.6,
   "event": "ordinary_request",
   "block": "learning_language.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "It depends on the language and how much time you put in. For Spanish or French, an English speaker might get there in six months to a year of regular practice.",
   "est_sec": 9.71,
   "gap_before": 0.32,
   "role": "reply",
   "block": "learning_language.dlg7",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And something like Mandarin?",
   "est_sec": 1.34,
   "gap_before": 1.02,
   "event": "ordinary_request",
   "block": "learning_language.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Longer, often twice as long or more, because of the tones and writing system.",
   "est_sec": 4.44,
   "gap_before": 0.88,
   "role": "reply",
   "block": "learning_language.dlg7",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What counts as conversational though?",
   "est_sec": 1.65,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "learning_language.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Roughly, being able to chat about everyday topics without freezing, even if you make mistakes. Not perfect, just functional.",
   "est_sec": 5.99,
   "gap_before": 1.13,
   "role": "reply",
   "block": "learning_language.dlg7",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "So mistakes are fine.",
   "est_sec": 1.34,
   "gap_before": 0.75,
   "event": "ordinary_request",
   "block": "learning_language.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Mistakes are the whole process. People who are okay with making them usually get there fastest.",
   "est_sec": 5.06,
   "gap_before": 0.44,
   "role": "reply",
   "block": "learning_language.dlg7",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Okay, that makes me feel better.",
   "est_sec": 1.96,
   "gap_before": 0.34,
   "event": "ordinary_request",
   "block": "learning_language.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Good. Speak early, and speak often.",
   "est_sec": 1.96,
   "gap_before": 0.45,
   "role": "reply",
   "block": "learning_language.dlg7",
   "reference_only": true
  }
 ],
