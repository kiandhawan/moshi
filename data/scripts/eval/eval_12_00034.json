 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's it going?",
   "est_sec": 1.34,
   "gap_before": 0.45,
   "role": "greeting",
   "phrasing": "greet_09",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Fine, thanks.",
   "est_sec": 0.72,
   "gap_before": 0.96,
   "event": "greeting_answer",
   "phrasing": "greet_ans_09"
  },
  {
   "speaker": "user",
   "text": "A few friends invited me on a long weekend ride.",
   "est_sec": 3.2,
   "gap_before": 0.59,
   "event": "ordinary_request",
   "block": "cycling.ctx3"
  },
  {
   "speaker": "moshi",
   "text": "Fun! They're doing either the flat forty mile loop or the hilly twenty five mile one. Which do you think your legs can handle?",
   "est_sec": 7.54,
   "gap_before": 1.13,
   "role": "reply",
   "block": "cycling.ctx3",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Wait, my friend just got here. Can you hold on and stay quiet until I'm back?",
   "est_sec": 5.06,
   "gap_before": 2.2,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_21"
  },
  {
   "speaker": "moshi",
   "text": "Okay, I'll hold on.",
   "est_sec": 1.34,
   "gap_before": 0.56,
   "role": "ack",
   "phrasing": "ack_13",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Zoe, which microphone did you buy for your show?",
   "est_sec": 2.89,
   "gap_before": 1.34,
   "event": "distractor",
   "kind": "friend_question",
   "block": "podcasts.side3"
  },
  {
   "speaker": "friend",
   "text": "A cheap USB one. It's honestly fine for talking.",
   "est_sec": 2.89,
   "gap_before": 0.82,
   "block": "podcasts.side3"
  },
  {
   "speaker": "user",
   "text": "Does it pick up a lot of background noise?",
   "est_sec": 2.89,
   "gap_before": 0.91,
   "event": "distractor",
   "kind": "friend_question",
   "block": "podcasts.side3"
  },
  {
   "speaker": "friend",
   "text": "A bit. I record in the closet now, the clothes soak up the echo.",
   "est_sec": 4.44,
   "gap_before": 0.75,
   "block": "podcasts.side3"
  },
  {
   "speaker": "user",
   "text": "The closet? That's genius.",
   "est_sec": 1.34,
   "gap_before": 0.66,
   "block": "podcasts.side3"
  },
  {
   "speaker": "friend",
   "text": "It's cramped though. You learn to sit very still.",
   "est_sec": 2.89,
   "gap_before": 0.36,
   "block": "podcasts.side3"
  },
  {
   "speaker": "user",
   "text": "I'll be right back, I need my glasses.",
   "est_sec": 2.58,
   "gap_before": 0.59,
   "event": "distractor",
   "kind": "near_miss",
   "phrasing": "dn_09"
  },
  {
   "speaker": "friend",
   "text": "Sure.",
   "est_sec": 0.41,
   "gap_before": 1.23,
   "phrasing": "dn_09"
  },
  {
