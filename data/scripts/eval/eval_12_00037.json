 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how have things been?",
   "est_sec": 1.96,
   "gap_before": 0.35,
   "role": "greeting",
   "phrasing": "greet_27",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Not bad at all, thanks.",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "event": "greeting_answer",
   "phrasing": "greet_ans_30"
  },
  {
   "speaker": "user",
   "text": "How do I carry groceries on my bike?",
   "est_sec": 2.58,
   "gap_before": 0.2,
   "event": "ordinary_request",
   "block": "cycling.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "A rear rack with panniers is the classic setup. They clip on and hold a surprising amount.",
   "est_sec": 5.37,
   "gap_before": 0.98,
   "role": "reply",
   "block": "cycling.dlg12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What about a basket?",
   "est_sec": 1.34,
   "gap_before": 2.72,
   "event": "ordinary_request",
   "block": "cycling.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "A front basket is handy for small things, but heavy loads up front can make steering wobbly.",
   "est_sec": 5.37,
   "gap_before": 0.35,
   "role": "reply",
   "block": "cycling.dlg12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I usually do",
   "est_sec": 1.03,
   "gap_before": 1.15,
   "event": "distractor",
   "kind": "pause",
   "block": "cycling.dlg12"
  },
  {
   "speaker": "user",
   "text": "one big weekly shop.",
   "est_sec": 1.34,
   "gap_before": 2.37,
   "event": "ordinary_request",
   "block": "cycling.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Then two panniers or a bike trailer would be best. Trailers can carry a lot, even a crate of drinks.",
   "est_sec": 6.3,
   "gap_before": 0.61,
   "role": "reply",
   "block": "cycling.dlg12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Is a backpack bad?",
   "est_sec": 1.34,
   "gap_before": 1.38,
   "event": "ordinary_request",
   "block": "cycling.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Fine for light stuff, but heavy bags make your back sweaty and sore. Let the bike carry the weight.",
   "est_sec": 5.99,
   "gap_before": 0.4,
   "role": "reply",
   "block": "cycling.dlg12",
   "reference_only": true
  }
 ],
