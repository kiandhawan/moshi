 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there! How's it going today?",
   "est_sec": 1.96,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_21",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Okay, I guess.",
   "est_sec": 1.03,
   "gap_before": 0.6,
   "event": "greeting_answer",
   "phrasing": "greet_ans_12"
  },
  {
   "speaker": "user",
   "text": "How do I mix a good skin tone? Mine always look orange.",
   "est_sec": 3.82,
   "gap_before": 0.42,
   "event": "ordinary_request",
   "block": "painting_art.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Start with a mix of red, yellow and white, then add a tiny touch of blue or green to calm it down.",
   "est_sec": 6.92,
   "gap_before": 0.72,
   "role": "reply",
   "block": "painting_art.dlg9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Green? In skin?",
   "est_sec": 1.03,
   "gap_before": 1.24,
   "event": "ordinary_request",
   "block": "painting_art.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Just a little. It neutralizes the orange so it looks more natural.",
   "est_sec": 3.82,
   "gap_before": 1.46,
   "role": "reply",
   "block": "painting_art.dlg9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And for different skin tones?",
   "est_sec": 1.65,
   "gap_before": 1.46,
   "event": "ordinary_request",
   "block": "painting_art.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "For deeper tones, add burnt umber and maybe a touch of ultramarine. For lighter ones, more white and a hint of pink.",
   "est_sec": 6.92,
   "gap_before": 1.2,
   "role": "reply",
   "block": "painting_art.dlg9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Should I mix",
   "est_sec": 1.03,
   "gap_before": 0.97,
   "event": "distractor",
   "kind": "pause",
   "block": "painting_art.dlg9"
  },
  {
   "speaker": "user",
   "text": "one big batch?",
   "est_sec": 1.03,
   "gap_before": 2.42,
   "event": "ordinary_request",
   "block": "painting_art.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Mix a few variations, a light, a mid and a shadow tone. Skin is never just one color.",
   "est_sec": 5.68,
   "gap_before": 0.4,
   "role": "reply",
   "block": "painting_art.dlg9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Oh, I see. My portraits look flat.",
   "est_sec": 2.27,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "painting_art.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Those three tones will help a lot. Look for the cooler colors in the shadows too.",
   "est_sec": 5.06,
   "gap_before": 0.83,
   "role": "reply",
   "block": "painting_art.dlg9",
   "reference_only": true
  }
 ],
