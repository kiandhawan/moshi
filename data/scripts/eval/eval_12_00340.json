   "gap_before": 2.91,
   "block": "picnic.side4"
  },
  {
   "speaker": "user",
   "text": "I did the food. You did the drinks.",
   "est_sec": 2.58,
   "gap_before": 0.32,
   "block": "picnic.side4"
  },
  {
   "speaker": "friend",
   "text": "Ugh. Fine, I'll run back to the car.",
   "est_sec": 2.58,
   "gap_before": 1.05,
   "block": "picnic.side4"
  },
  {
   "speaker": "user",
   "text": "Wait, there's a corkscrew on my keyring. Never mind.",
