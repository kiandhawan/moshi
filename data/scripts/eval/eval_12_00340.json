   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "restaurant_choice.ctx16"
  },
  {
   "speaker": "moshi",
   "text": "Congratulations! That deserves a celebration. Are we splurging on a proper nice dinner, or keeping it cheap and cheerful with friends?",
   "est_sec": 6.61,
   "gap_before": 0.94,
   "role": "reply",
   "block": "restaurant_choice.ctx16",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "One moment, my sister is asking me something. Please don't interrupt until I'm back.",
   "est_sec": 4.44,
   "gap_before": 0.91,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_06"
  },
  {
   "speaker": "moshi",
   "text": "No worries.",
   "est_sec": 0.72,
   "gap_before": 0.65,
   "role": "ack",
   "phrasing": "ack_14",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Did you pack the bottle opener?",
