 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, what's up? How are you doing?",
   "est_sec": 2.27,
   "gap_before": 0.75,
   "role": "greeting",
   "phrasing": "greet_24",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Fine, thanks.",
   "est_sec": 0.72,
   "gap_before": 0.83,
   "event": "greeting_answer",
   "phrasing": "greet_ans_09"
  },
  {
   "speaker": "user",
   "text": "I keep getting distracted at home. Any tips for focusing?",
   "est_sec": 3.2,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "home_office.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Try working in focused blocks, like twenty five minutes on and five off. And keep your phone in another room during those blocks.",
   "est_sec": 7.23,
   "gap_before": 1.14,
   "role": "reply",
   "block": "home_office.dlg2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "My phone in another room? That sounds hard.",
   "est_sec": 2.58,
   "gap_before": 0.86,
   "event": "ordinary_request",
   "block": "home_office.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "It is at first, but it's one of the most effective tricks. Even putting it in a drawer helps.",
   "est_sec": 5.99,
   "gap_before": 1.0,
   "role": "reply",
   "block": "home_office.dlg2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What about noise? My neighbors",
   "est_sec": 1.65,
   "gap_before": 1.41,
   "event": "distractor",
   "kind": "pause",
   "block": "home_office.dlg2"
  },
  {
   "speaker": "user",
   "text": "are doing construction all week.",
   "est_sec": 1.65,
   "gap_before": 2.49,
   "event": "ordinary_request",
   "block": "home_office.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Noise cancelling headphones with some brown noise or instrumental music can block out a lot. Earplugs work too if you're not on calls.",
   "est_sec": 7.23,
   "gap_before": 0.63,
   "role": "reply",
   "block": "home_office.dlg2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Wait, that can't be right.",
   "est_sec": 1.65,
   "gap_before": 0.36,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_12",
   "block": "home_office.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Hmm, I believe it is. Which part doesn't sound right?",
   "est_sec": 3.2,
   "gap_before": 0.32,
   "role": "reply",
   "block": "home_office.dlg2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Maybe I'll just work from the library on those days.",
   "est_sec": 3.2,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "home_office.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Great idea. A change of scenery often boosts focus all by itself.",
   "est_sec": 3.82,
   "gap_before": 0.31,
   "role": "reply",
   "block": "home_office.dlg2",
   "reference_only": true
  }
