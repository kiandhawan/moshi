 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, what's up? How are you doing?",
   "est_sec": 2.27,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_24",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'm fine, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "event": "greeting_answer",
   "phrasing": "greet_ans_15"
  },
  {
   "speaker": "user",
   "text": "Hi. My father is coming to visit, and he has dementia, early stage. Any advice?",
   "est_sec": 4.75,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "family_visit.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "I'm sorry, that's a lot to hold. Familiar routines help the most, so try to keep his meals and bedtime close to what he's used to.",
   "est_sec": 8.16,
   "gap_before": 1.2,
   "role": "reply",
   "block": "family_visit.dlg9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "He gets confused",
   "est_sec": 1.03,
   "gap_before": 0.3,
   "event": "distractor",
   "kind": "pause",
   "block": "family_visit.dlg9"
  },
  {
   "speaker": "user",
   "text": "in new places especially.",
   "est_sec": 1.34,
   "gap_before": 2.83,
   "event": "ordinary_request",
   "block": "family_visit.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Labels on doors can help, like bathroom and bedroom, and a light left on at night.",
   "est_sec": 5.06,
   "gap_before": 1.14,
   "role": "reply",
   "block": "family_visit.dlg9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Should I plan outings?",
   "est_sec": 1.34,
   "gap_before": 0.9,
   "event": "ordinary_request",
   "block": "family_visit.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Short ones, and quiet ones. A garden, a familiar kind of cafe, or a drive with music he likes. Avoid crowds.",
   "est_sec": 6.61,
   "gap_before": 1.02,
   "role": "reply",
   "block": "family_visit.dlg9",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And for me? I'm worried I'll get frustrated.",
   "est_sec": 2.58,
   "gap_before": 0.97,
   "event": "ordinary_request",
   "block": "family_visit.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "That's normal. Build in time for yourself each day, even twenty minutes, and ask a friend to take over for an afternoon if you can.",
   "est_sec": 7.85,
   "gap_before": 0.49,
   "role": "reply",
   "block": "family_visit.dlg9",
   "reference_only": true
  }
 ],
