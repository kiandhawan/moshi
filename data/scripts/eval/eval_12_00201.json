 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your week going?",
   "est_sec": 1.65,
   "gap_before": 0.31,
   "role": "greeting",
   "phrasing": "greet_15",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Fine, thanks.",
   "est_sec": 0.72,
   "gap_before": 0.75,
   "event": "greeting_answer",
   "phrasing": "greet_ans_09"
  },
  {
   "speaker": "user",
   "text": "My dad's seventy four and suddenly wants an e-bike.",
   "est_sec": 2.89,
   "gap_before": 0.42,
   "event": "ordinary_request",
   "block": "cycling.ctx17"
  },
  {
   "speaker": "moshi",
   "text": "Good for him! Is he an experienced rider?",
   "est_sec": 2.58,
   "gap_before": 0.61,
   "role": "reply",
   "block": "cycling.ctx17",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "He used to ride everywhere, but his hips are stiff now.",
   "est_sec": 3.51,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "cycling.ctx17"
  },
  {
   "speaker": "moshi",
   "text": "Then the frame matters. Can he still swing his leg over the back, or is that a struggle?",
   "est_sec": 5.68,
   "gap_before": 1.39,
   "role": "reply",
   "block": "cycling.ctx17",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I need to think. Give me fifteen seconds and then ask me again.",
   "est_sec": 4.13,
   "gap_before": 0.76,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 15,
   "phrasing": "think_instr_12"
  },
  {
   "speaker": "user",
   "text": "No, I really don't know.",
   "est_sec": 1.65,
   "anchor": {
    "turn": 6,
    "offset": 5.37
   },
   "event": "distractor",
   "kind": "self_talk",
   "phrasing": "self_24"
  },
  {
   "speaker": "moshi",
   "text": "Right, can your dad still swing his leg over?",
   "est_sec": 2.89,
   "role": "resume",
   "block": "cycling.ctx17",
   "anchor": {
    "turn": 6,
    "offset": 15.15
   },
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "He's fine with that, just tired on hills.",
