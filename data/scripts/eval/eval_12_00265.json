 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your week going?",
   "est_sec": 1.65,
   "gap_before": 0.7,
   "role": "greeting",
   "phrasing": "greet_15",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Fine, thanks.",
   "est_sec": 0.72,
   "gap_before": 0.57,
   "event": "greeting_answer",
   "phrasing": "greet_ans_09"
  },
  {
   "speaker": "user",
   "text": "My girlfriend wants to backpack in. I want to park next to the tent and bring a real pillow.",
   "est_sec": 5.99,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "camping.ctx10"
  },
  {
   "speaker": "moshi",
   "text": "Both are valid. Would a walk-in site, maybe ten minutes from the car, be a compromise either of you could live with?",
   "est_sec": 6.92,
   "gap_before": 1.13,
   "role": "reply",
   "block": "camping.ctx10",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Wait, that's the door. Hold on and don't talk until I'm back.",
   "est_sec": 3.82,
   "gap_before": 0.64,
   "event": "instruction",
   "kind": "door",
   "phrasing": "door_instr_06"
  },
  {
   "speaker": "moshi",
   "text": "Okay, sure.",
   "est_sec": 0.72,
   "gap_before": 0.55,
   "role": "ack",
   "phrasing": "ack_16",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Yes, can I help you?",
   "est_sec": 1.65,
   "gap_before": 2.74,
   "phrasing": "door_11",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "visitor",
   "text": "Good afternoon, I'm from the council, we're surveying the street trees.",
   "est_sec": 3.51,
   "gap_before": 0.51,
   "phrasing": "door_11"
  },
  {
   "speaker": "user",
   "text": "Do you need access to the garden?",
   "est_sec": 2.27,
   "gap_before": 1.15,
   "phrasing": "door_11",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "visitor",
   "text": "Just a quick look at the oak, if that's alright.",
   "est_sec": 3.2,
   "gap_before": 0.44,
   "phrasing": "door_11"
  },
  {
   "speaker": "user",
   "text": "Go round the side, the gate's open.",
   "est_sec": 2.27,
   "gap_before": 0.31,
   "phrasing": "door_11"
  },
  {
   "speaker": "user",
   "text": "Okay, sorry, where were we again?",
