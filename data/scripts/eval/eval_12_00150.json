 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, what's up? How are you doing?",
   "est_sec": 2.27,
   "gap_before": 0.74,
   "role": "greeting",
   "phrasing": "greet_24",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Okay, I guess.",
   "est_sec": 1.03,
   "gap_before": 0.86,
   "event": "greeting_answer",
   "phrasing": "greet_ans_12"
  },
  {
   "speaker": "user",
   "text": "My parents keep giving me cash and I feel bad giving them nothing.",
   "est_sec": 4.13,
   "gap_before": 0.42,
   "event": "ordinary_request",
   "block": "holiday_gifts.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "That's sweet of you. What do they enjoy doing together?",
   "est_sec": 3.2,
   "gap_before": 0.78,
   "role": "reply",
   "block": "holiday_gifts.dlg10",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "They garden. And they love going to the coast.",
   "est_sec": 2.89,
   "gap_before": 1.37,
   "event": "ordinary_request",
   "block": "holiday_gifts.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "A day trip to the coast with you could be wonderful, you drive, you pay for lunch.",
   "est_sec": 5.37,
   "gap_before": 0.56,
   "role": "reply",
   "block": "holiday_gifts.dlg10",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "That's actually affordable. Anything for the garden?",
   "est_sec": 2.27,
   "gap_before": 3.08,
   "event": "ordinary_request",
   "block": "holiday_gifts.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "A nice pair of gloves each, or a bird feeder. Small, but they'll see it every day.",
   "est_sec": 5.37,
   "gap_before": 0.66,
   "role": "reply",
   "block": "holiday_gifts.dlg10",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "I'd like to do both",
   "est_sec": 1.65,
   "gap_before": 0.39,
   "event": "distractor",
   "kind": "pause",
   "block": "holiday_gifts.dlg10"
  },
  {
