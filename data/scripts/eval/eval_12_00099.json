 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there, how are you doing today?",
   "est_sec": 2.27,
   "gap_before": 0.51,
   "role": "greeting",
   "phrasing": "greet_12",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Fine, thanks.",
   "est_sec": 0.72,
   "gap_before": 0.56,
   "event": "greeting_answer",
   "phrasing": "greet_ans_09"
  },
  {
   "speaker": "user",
   "text": "Clocks went back and now I'm riding home in the dark. Kind of spooky, honestly.",
   "est_sec": 4.75,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "cycling.ctx8"
  },
  {
   "speaker": "moshi",
   "text": "It takes some getting used to. What lights have you got?",
   "est_sec": 3.51,
   "gap_before": 1.59,
   "role": "reply",
   "block": "cycling.ctx8",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Just a little blinky one my sister gave me.",
   "est_sec": 2.89,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "cycling.ctx8"
  },
  {
   "speaker": "moshi",
   "text": "Okay. Is your way home mostly lit streets, or dark country lanes?",
   "est_sec": 3.82,
   "gap_before": 0.5,
   "role": "reply",
   "block": "cycling.ctx8",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Hold on, I think someone's here. Wait until I'm back.",
   "est_sec": 3.2,
   "gap_before": 1.78,
   "event": "instruction",
   "kind": "door",
   "phrasing": "door_instr_03"
  },
  {
   "speaker": "moshi",
   "text": "Of course.",
   "est_sec": 0.72,
   "gap_before": 0.56,
   "role": "ack",
   "phrasing": "ack_06",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Oh, a parcel for me?",
   "est_sec": 1.65,
   "gap_before": 4.83,
   "phrasing": "door_30",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "visitor",
   "text": "Hi, courier. This one needs ID, it's age restricted.",
   "est_sec": 2.89,
   "gap_before": 1.05,
   "phrasing": "door_30"
  },
  {
   "speaker": "user",
   "text": "Will a driving licence do?",
   "est_sec": 1.65,
   "gap_before": 1.05,
   "phrasing": "door_30",
   "event": "distractor",
   "kind": "question_to_other"
  },
  {
   "speaker": "visitor",
   "text": "Perfect, thanks.",
   "est_sec": 0.72,
   "gap_before": 1.02,
   "phrasing": "door_30"
  },
  {
   "speaker": "user",
   "text": "Great, cheers.",
   "est_sec": 0.72,
   "gap_before": 0.97,
   "phrasing": "door_30"
  },
  {
   "speaker": "user",
   "text": "Sorry, that took a minute. I'm back.",
   "est_sec": 2.27,
   "gap_before": 2.33,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "door_cue_02"
  },
  {
   "speaker": "moshi",
   "text": "Everything okay at the door? For the night rides, is it streetlights or pitch black?",
   "est_sec": 4.75,
   "gap_before": 0.54,
   "role": "resume",
   "block": "cycling.ctx8",
   "reference_only": true
  },
  {
