   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "cycling.ctx8"
  },
  {
   "speaker": "moshi",
   "text": "Then you need a powerful front light to see the road, at least eight hundred lumens.",
   "est_sec": 5.06,
