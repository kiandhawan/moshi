   "phrasing": "greet_ans_09"
  },
  {
   "speaker": "user",
   "text": "My stepdad's visiting and he's a really picky eater.",
   "est_sec": 2.89,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "family_visit.ctx14"
  },
  {
   "speaker": "moshi",
