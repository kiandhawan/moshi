 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your week going?",
   "est_sec": 1.65,
   "gap_before": 0.72,
   "role": "greeting",
   "phrasing": "greet_15",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "All good here.",
   "est_sec": 1.03,
   "gap_before": 0.98,
   "event": "greeting_answer",
   "phrasing": "greet_ans_27"
  },
  {
   "speaker": "user",
   "text": "I keep drawing faces and the eyes always end up too high.",
   "est_sec": 3.82,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "painting_art.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "That's really common. The eyes actually sit about halfway down the head, lower than most people expect.",
   "est_sec": 5.37,
   "gap_before": 1.18,
   "role": "reply",
   "block": "painting_art.dlg2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Halfway? That sounds too low.",
   "est_sec": 1.65,
   "gap_before": 1.15,
   "event": "ordinary_request",
   "block": "painting_art.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "It feels that way because hair covers the top of the skull. Try drawing a light line across the middle first and put the eyes on it.",
   "est_sec": 8.47,
   "gap_before": 0.41,
   "role": "reply",
   "block": "painting_art.dlg2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "What about the nose, is there a trick for",
   "est_sec": 2.89,
   "gap_before": 0.77,
   "event": "distractor",
   "kind": "pause",
   "block": "painting_art.dlg2"
  },
  {
   "speaker": "user",
   "text": "where that goes?",
   "est_sec": 1.03,
   "gap_before": 2.16,
   "event": "ordinary_request",
   "block": "painting_art.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "The bottom of the nose is roughly halfway between the eyes and the chin. The mouth sits a bit above the halfway point below that.",
   "est_sec": 7.85,
   "gap_before": 0.95,
   "role": "reply",
   "block": "painting_art.dlg2",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "This is helpful. I'll try a few quick sketches tonight.",
   "est_sec": 3.2,
   "gap_before": 1.18,
   "event": "ordinary_request",
   "block": "painting_art.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Good plan. Keep them small and fast, maybe five minutes each, so you don't get stuck on details.",
   "est_sec": 5.68,
   "gap_before": 0.92,
   "role": "reply",
   "block": "painting_art.dlg2",
