 "turns": [
  {
   "speaker": "moshi",
   "text": "Good to hear from you. How are you?",
   "est_sec": 2.58,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_06",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "All good here.",
   "est_sec": 1.03,
   "gap_before": 0.87,
   "event": "greeting_answer",
   "phrasing": "greet_ans_27"
  },
  {
   "speaker": "user",
   "text": "My friend is vegan and I want to get her something nice. Ideas?",
   "est_sec": 4.13,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "holiday_gifts.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "A vegan cookbook from a chef she likes is a safe bet, or a nice set of spices.",
   "est_sec": 5.68,
   "gap_before": 0.74,
   "role": "reply",
   "block": "holiday_gifts.dlg6",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "She cooks a lot already. Maybe something",
   "est_sec": 2.27,
   "gap_before": 0.51,
   "event": "distractor",
   "kind": "pause",
   "block": "holiday_gifts.dlg6"
  },
  {
   "speaker": "user",
   "text": "not food related?",
   "est_sec": 1.03,
   "gap_before": 2.84,
   "event": "ordinary_request",
   "block": "holiday_gifts.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Then a plant, a good tote bag, or a voucher for a class, pottery or yoga, anything she's curious about.",
   "est_sec": 6.3,
   "gap_before": 0.95,
   "role": "reply",
   "block": "holiday_gifts.dlg6",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "She does yoga. Would a mat be weird?",
   "est_sec": 2.58,
   "gap_before": 0.87,
   "event": "ordinary_request",
   "block": "holiday_gifts.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Not if hers is old. A really good mat is something people rarely buy for themselves.",
   "est_sec": 5.06,
   "gap_before": 0.72,
   "role": "reply",
   "block": "holiday_gifts.dlg6",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Is cork a vegan material?",
   "est_sec": 1.65,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "holiday_gifts.dlg6"
  },
  {
