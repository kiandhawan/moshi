 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's it going? You doing okay?",
   "est_sec": 2.27,
   "gap_before": 0.75,
   "role": "greeting",
   "phrasing": "greet_30",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Fine, thanks.",
   "est_sec": 0.72,
   "gap_before": 0.79,
   "event": "greeting_answer",
   "phrasing": "greet_ans_09"
  },
  {
   "speaker": "user",
   "text": "When should save the dates go out?",
   "est_sec": 2.27,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "block": "wedding_planning.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Usually about six to eight months before. For a destination wedding, closer to a year so people can save and book.",
   "est_sec": 6.61,
   "gap_before": 1.16,
   "role": "reply",
   "block": "wedding_planning.dlg7",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Ours is local, in August.",
   "est_sec": 1.65,
   "gap_before": 1.45,
   "event": "ordinary_request",
   "block": "wedding_planning.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Then sending them in January or February is perfect.",
   "est_sec": 2.89,
   "gap_before": 1.02,
   "role": "reply",
   "block": "wedding_planning.dlg7",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Do people still mail them, or is email fine?",
   "est_sec": 2.89,
   "gap_before": 1.37,
   "event": "ordinary_request",
   "block": "wedding_planning.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Email is totally fine now, especially if you're watching costs. Older relatives might appreciate a paper one though.",
   "est_sec": 5.68,
   "gap_before": 0.53,
   "role": "reply",
   "block": "wedding_planning.dlg7",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "My grandma would frame a paper one.",
   "est_sec": 2.27,
   "gap_before": 1.0,
   "event": "ordinary_request",
   "block": "wedding_planning.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Then print a handful for the grandparents and email the rest. Everyone's happy.",
   "est_sec": 4.13,
   "gap_before": 1.3,
   "role": "reply",
   "block": "wedding_planning.dlg7",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And the actual invites?",
   "est_sec": 1.34,
   "gap_before": 1.48,
   "event": "ordinary_request",
   "block": "wedding_planning.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Around two months before, with an RSVP date about a month before the wedding.",
   "est_sec": 4.44,
   "gap_before": 0.41,
   "role": "reply",
   "block": "wedding_planning.dlg7",
   "reference_only": true
  }
 ],
