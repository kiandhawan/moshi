 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how have things been?",
   "est_sec": 1.96,
   "gap_before": 0.51,
   "role": "greeting",
   "phrasing": "greet_27",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "Doing okay, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.81,
   "event": "greeting_answer",
   "phrasing": "greet_ans_03"
  },
  {
   "speaker": "user",
   "text": "Is it rude to ask family to pay for their own meals when they visit?",
   "est_sec": 4.75,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "family_visit.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Not necessarily. It depends a lot on your family's habits and on who invited whom.",
   "est_sec": 4.75,
   "gap_before": 0.93,
   "role": "reply",
   "block": "family_visit.dlg8",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "They invited themselves",
   "est_sec": 1.03,
   "gap_before": 0.44,
   "event": "distractor",
   "kind": "pause",
   "block": "family_visit.dlg8"
  },
  {
   "speaker": "user",
   "text": "for ten days.",
   "est_sec": 1.03,
   "gap_before": 2.71,
   "event": "ordinary_request",
   "block": "family_visit.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Then it's very reasonable to share costs. You could cover breakfasts at home and split dinners out.",
   "est_sec": 5.37,
   "gap_before": 0.81,
   "role": "reply",
   "block": "family_visit.dlg8",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "How do I bring that up without it being awkward?",
   "est_sec": 3.2,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "family_visit.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Say it early and lightly, before they arrive. Something like, we'll do breakfast here, and for dinners out let's just split as we go.",
   "est_sec": 7.54,
   "gap_before": 1.05,
   "role": "reply",
   "block": "family_visit.dlg8",
   "reference_only": true
  },
  {
   "speaker": "user",
   "text": "And if they act offended?",
   "est_sec": 1.65,
   "gap_before": 1.37,
   "event": "ordinary_request",
   "block": "family_visit.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Stay friendly and don't over explain. Most people adjust quickly once it's clear it's normal for you.",
   "est_sec": 5.37,
   "gap_before": 1.09,
   "role": "reply",
   "block": "family_visit.dlg8",
   "reference_only": true
  }
 ],
