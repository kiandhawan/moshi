 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.65,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.3,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I want my garden to be good for bees. Where do I even start?",
   "est_sec": 4.44,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "gardening.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Start with flowers that are easy for them to get into. Open, simple flowers are better than big fluffy double ones.",
   "est_sec": 6.61,
   "gap_before": 0.34,
   "role": "reply",
   "block": "gardening.dlg15"
  },
  {
   "speaker": "user",
   "text": "Like what?",
   "est_sec": 0.72,
   "gap_before": 1.01,
   "event": "ordinary_request",
   "block": "gardening.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Lavender, foxgloves, catmint, comfrey, and herbs left to flower, like thyme and oregano.",
   "est_sec": 4.13,
   "gap_before": 0.3,
   "role": "reply",
   "block": "gardening.dlg15"
  },
  {
   "speaker": "user",
   "text": "I didn't know herbs count.",
   "est_sec": 1.65,
   "gap_before": 1.19,
   "event": "ordinary_request",
   "block": "gardening.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "They're some of the best. Also aim for something in flower from early spring to late autumn, so there's always food around.",
   "est_sec": 6.92,
   "gap_before": 1.05,
   "role": "reply",
   "block": "gardening.dlg15"
  },
  {
   "speaker": "user",
   "text": "What's good early? Spring is",
   "est_sec": 1.65,
   "gap_before": 1.83,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg15"
  },
  {
   "speaker": "user",
   "text": "kind of bare in my garden.",
   "est_sec": 1.96,
   "gap_before": 2.75,
   "event": "ordinary_request",
   "block": "gardening.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Crocuses and pussy willow are lifesavers for early bees. Plant some crocus bulbs in the lawn this autumn.",
   "est_sec": 5.68,
   "gap_before": 0.53,
   "role": "reply",
   "block": "gardening.dlg15"
  },
  {
   "speaker": "user",
   "text": "Wait, what did you say?",
   "est_sec": 1.65,
   "gap_before": 2.87,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_01",
   "block": "gardening.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Sure, here it is again. Crocuses and pussy willow are lifesavers for early bees. Plant some crocus bulbs in the lawn this autumn.",
   "est_sec": 7.23,
   "gap_before": 0.97,
   "role": "reply",
   "block": "gardening.dlg15"
  },
  {
   "speaker": "user",
   "text": "And I should stop spraying the dandelions, I guess.",
   "est_sec": 2.89,
   "gap_before": 0.69,
   "event": "ordinary_request",
   "block": "gardening.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Yes please. Dandelions are a proper bee buffet in April.",
   "est_sec": 3.2,
   "gap_before": 0.8,
   "role": "reply",
   "block": "gardening.dlg15"
  }
 ]
}
