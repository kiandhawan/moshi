 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.91,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "I'm useless at chess. Should I be memorising openings?",
   "est_sec": 2.89,
   "gap_before": 0.2,
   "event": "ordinary_request",
   "block": "board_games.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Not yet. At the start, a few simple ideas matter much more than memorised moves.",
   "est_sec": 4.75,
   "gap_before": 0.76,
   "role": "reply",
   "block": "board_games.dlg7"
  },
  {
   "speaker": "user",
   "text": "Hold on, like what?",
   "est_sec": 1.34,
   "gap_before": 1.16,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_14",
   "block": "board_games.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Control the middle of the board, bring out your knights and bishops early, and castle to keep your king safe.",
   "est_sec": 6.3,
   "gap_before": 1.32,
   "role": "reply",
   "block": "board_games.dlg7"
  },
  {
   "speaker": "user",
   "text": "I always lose my queen though.",
   "est_sec": 1.96,
   "gap_before": 1.26,
   "event": "ordinary_request",
   "block": "board_games.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "That's the most common beginner problem. Before every move, ask what your opponent is threatening. It feels slow, but it saves pieces.",
   "est_sec": 6.92,
   "gap_before": 0.3,
   "role": "reply",
   "block": "board_games.dlg7"
  },
  {
   "speaker": "user",
   "text": "Every move? That's",
   "est_sec": 1.03,
   "gap_before": 1.03,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg7"
  },
  {
   "speaker": "user",
   "text": "going to make games so long.",
   "est_sec": 1.96,
   "gap_before": 1.98,
   "event": "ordinary_request",
   "block": "board_games.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "At first, yes. It turns into a habit quickly. Playing slower games online helps too, quick games teach bad habits.",
   "est_sec": 6.3,
   "gap_before": 0.36,
   "role": "reply",
   "block": "board_games.dlg7"
  },
  {
   "speaker": "user",
   "text": "Okay. Slower and more paranoid.",
   "est_sec": 1.65,
   "gap_before": 1.22,
   "event": "ordinary_request",
   "block": "board_games.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Paranoid is a compliment in chess.",
   "est_sec": 2.27,
   "gap_before": 1.04,
   "role": "reply",
   "block": "board_games.dlg7"
  }
 ]
}
