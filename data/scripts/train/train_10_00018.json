 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.92,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "I need to take apart my flat pack bed. Any tips so I can put it back together?",
   "est_sec": 5.68,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "moving_house.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Take photos at each step as you go. They're like a reverse instruction manual.",
   "est_sec": 4.44,
   "gap_before": 0.32,
   "role": "reply",
   "block": "moving_house.dlg18"
  },
  {
   "speaker": "user",
   "text": "Oh, smart.",
   "est_sec": 0.72,
   "gap_before": 0.61,
   "event": "ordinary_request",
   "block": "moving_house.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Put all the screws and bolts in a zip bag, and tape the bag firmly to one of the bed's main pieces.",
   "est_sec": 6.92,
   "gap_before": 1.04,
   "role": "reply",
   "block": "moving_house.dlg18"
  },
  {
   "speaker": "user",
   "text": "I always lose the little",
   "est_sec": 1.65,
   "gap_before": 1.85,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg18"
  },
  {
   "speaker": "user",
   "text": "Allen key.",
   "est_sec": 0.72,
   "gap_before": 1.95,
   "event": "ordinary_request",
   "block": "moving_house.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Put that in the same bag. If you still have the original instructions, you can often find them online by searching the model name.",
   "est_sec": 7.54,
   "gap_before": 1.04,
   "role": "reply",
   "block": "moving_house.dlg18"
  },
  {
   "speaker": "user",
   "text": "And the slats?",
   "est_sec": 1.03,
   "gap_before": 0.84,
   "event": "ordinary_request",
   "block": "moving_house.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Tie them together with string or tape, so they travel as one bundle and don't get lost in the van.",
   "est_sec": 6.3,
   "gap_before": 1.26,
   "role": "reply",
   "block": "moving_house.dlg18"
  }
 ]
