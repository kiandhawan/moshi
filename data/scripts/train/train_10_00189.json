   "est_sec": 2.58,
   "gap_before": 0.45,
   "event": "distractor",
   "kind": "pause",
   "block": "job_interview.dlg2"
  },
  {
   "speaker": "user",
   "text": "for about two years.",
   "est_sec": 1.34,
   "gap_before": 1.81,
   "event": "ordinary_request",
   "block": "job_interview.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "That's great experience. Talk about how much you raised and how you organized the volunteers.",
   "est_sec": 4.75,
   "gap_before": 1.05,
   "role": "reply",
   "block": "job_interview.dlg2"
  },
  {
