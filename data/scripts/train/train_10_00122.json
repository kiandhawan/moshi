 "est_speech_sec": 41.3,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.62,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.9,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "I've bought a game with all these grey plastic figures. People paint them, apparently. I've never painted anything.",
   "est_sec": 5.68,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "board_games.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Painting miniatures is a lovely relaxing hobby. You only need a few brushes, a handful of paints and a primer to start.",
   "est_sec": 6.92,
   "gap_before": 0.45,
   "role": "reply",
   "block": "board_games.dlg11"
  },
  {
   "speaker": "user",
   "text": "Primer?",
   "est_sec": 0.41,
   "gap_before": 1.2,
   "event": "ordinary_request",
   "block": "board_games.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "A spray undercoat that helps paint stick to the plastic. Do it outside on a dry day, in short bursts.",
   "est_sec": 6.3,
   "gap_before": 0.89,
   "role": "reply",
   "block": "board_games.dlg11"
  },
  {
   "speaker": "user",
   "text": "My hands shake a bit. Will that ruin it?",
   "est_sec": 2.89,
   "gap_before": 3.05,
   "event": "ordinary_request",
   "block": "board_games.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Rest your wrists on the table, and hold the figure on a cork or a bottle top. And don't worry, from arm's length nobody sees the wobbles.",
   "est_sec": 8.47,
   "gap_before": 0.44,
   "role": "reply",
   "block": "board_games.dlg11"
  },
  {
   "speaker": "user",
   "text": "That's very comforting.",
   "est_sec": 1.03,
   "gap_before": 1.35,
   "event": "ordinary_request",
   "block": "board_games.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Start with the biggest figure, three colours, and let a wash do the shadows for you. You'll be amazed at the result.",
   "est_sec": 6.92,
   "gap_before": 1.16,
   "role": "reply",
   "block": "board_games.dlg11"
  }
 ]
}
