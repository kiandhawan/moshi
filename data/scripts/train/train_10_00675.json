 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.8,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "I love the soundtrack of the game I'm playing. I'd like to listen to it while I work.",
   "est_sec": 5.68,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "video_games.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Game music is great for focus, it's literally designed to sit in the background while you concentrate. Many soundtracks are on music streaming services.",
   "est_sec": 7.54,
   "gap_before": 0.78,
   "role": "reply",
   "block": "video_games.dlg29"
  },
  {
   "speaker": "user",
   "text": "Hold on a sec, really? I assumed they weren't.",
   "est_sec": 2.89,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_17",
   "block": "video_games.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "A lot of them are now, especially from indie studios. Some also sell them directly with bonus tracks.",
   "est_sec": 5.68,
   "gap_before": 0.89,
   "role": "reply",
   "block": "video_games.dlg29"
  },
  {
   "speaker": "user",
   "text": "Any others you'd",
   "est_sec": 1.03,
   "gap_before": 0.8,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg29"
  },
  {
   "speaker": "user",
   "text": "recommend for working?",
   "est_sec": 1.03,
   "gap_before": 2.8,
   "event": "ordinary_request",
   "block": "video_games.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Look for soundtracks from exploration and puzzle games, they tend to be calm and without lyrics. City builders and farming games often have gentle ones too.",
   "est_sec": 8.16,
   "gap_before": 0.61,
   "role": "reply",
   "block": "video_games.dlg29"
  },
  {
   "speaker": "user",
   "text": "Is that a weird thing to do at the office?",
   "est_sec": 3.2,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "video_games.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Not at all. Plenty of people do it. Nobody will know it's from a game unless it suddenly turns into boss battle music.",
   "est_sec": 7.23,
   "gap_before": 0.36,
   "role": "reply",
   "block": "video_games.dlg29"
  }
 ]
}
