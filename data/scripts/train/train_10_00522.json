 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.74,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.41,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "I just started a new job across town. I could take the bus or the train.",
   "est_sec": 5.06,
   "gap_before": 0.2,
   "event": "ordinary_request",
   "block": "public_transport.ctx1"
  },
  {
   "speaker": "moshi",
   "text": "The bus stops closer to your place but takes about fifty minutes. The train is thirty, but it's a ten minute walk. Which matters more to you?",
   "est_sec": 8.47,
   "gap_before": 1.04,
   "role": "reply",
   "block": "public_transport.ctx1"
  },
  {
   "speaker": "user",
   "text": "Give me twenty seconds to figure it out, then ask me again.",
   "est_sec": 3.82,
   "gap_before": 0.72,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 20,
   "phrasing": "think_instr_19"
  },
  {
   "speaker": "moshi",
   "text": "Of course.",
   "est_sec": 0.72,
   "gap_before": 0.26,
   "role": "ack",
   "phrasing": "ack_06"
  },
  {
   "speaker": "user",
   "text": "Hmm, decisions, decisions.",
   "est_sec": 1.03,
   "anchor": {
    "turn": 4,
    "offset": 12.23
   },
   "event": "distractor",
   "kind": "self_talk",
   "phrasing": "self_26"
  },
  {
   "speaker": "user",
   "text": "Okay, I think I know.",
   "est_sec": 1.65,
   "anchor": {
    "turn": 4,
    "offset": 16.08
   },
   "event": "return_cue",
   "kind": "early_end",
   "phrasing": "early_end_13"
  },
  {
   "speaker": "moshi",
   "text": "Okay, have you decided? Bus or train?",
   "est_sec": 2.27,
   "gap_before": 0.73,
   "role": "resume",
   "block": "public_transport.ctx1"
  },
  {
   "speaker": "user",
   "text": "The train. I don't mind the walk.",
   "est_sec": 2.27,
   "gap_before": 1.48,
   "event": "ordinary_request",
   "block": "public_transport.ctx1"
  },
  {
   "speaker": "moshi",
   "text": "Good choice. The walk is a nice way to wake up, and you'll save almost an hour a day.",
   "est_sec": 5.99,
