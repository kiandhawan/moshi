 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.71,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.65,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "I just found a flea on my cat. Do I need to panic?",
   "est_sec": 4.13,
   "gap_before": 0.3,
   "event": "ordinary_request",
   "block": "pets.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "No panic needed, but it's worth acting now. Where there's one flea there are usually more.",
   "est_sec": 5.06,
   "gap_before": 1.11,
   "role": "reply",
   "block": "pets.dlg12"
  },
  {
   "speaker": "user",
   "text": "Gross. What do I do?",
   "est_sec": 1.65,
   "gap_before": 0.88,
   "event": "ordinary_request",
   "block": "pets.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Get a vet recommended spot on treatment for cats. Never use a dog one, some of them are really toxic to cats.",
   "est_sec": 6.92,
   "gap_before": 1.13,
   "role": "reply",
   "block": "pets.dlg12"
  },
  {
   "speaker": "user",
   "text": "Oh wow, I didn't know that.",
   "est_sec": 1.96,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "pets.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "It's an important one. Treat every pet in the house, not just her.",
   "est_sec": 4.13,
   "gap_before": 0.88,
   "role": "reply",
   "block": "pets.dlg12"
  },
  {
   "speaker": "user",
   "text": "And the house itself?",
   "est_sec": 1.34,
   "gap_before": 1.31,
   "event": "distractor",
   "kind": "pause",
   "block": "pets.dlg12"
  },
  {
   "speaker": "user",
   "text": "Do I have to burn the sofa?",
   "est_sec": 2.27,
   "gap_before": 2.69,
   "event": "ordinary_request",
   "block": "pets.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "No burning required. Vacuum everything thoroughly for a few weeks, wash her bedding hot, and empty the vacuum bag outside each time.",
   "est_sec": 6.92,
   "gap_before": 1.16,
   "role": "reply",
   "block": "pets.dlg12"
  }
 ]
}
