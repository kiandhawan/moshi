 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.4,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "I use a wheelchair, and I'm off to the stadium on Saturday.",
   "est_sec": 3.82,
   "gap_before": 0.25,
   "event": "ordinary_request",
   "block": "public_transport.ctx9"
  },
  {
   "speaker": "moshi",
   "text": "Got it. The direct bus is low floor all the way. The metro is faster, but the lift at the stadium station has been out a lot. Which are you leaning towards?",
   "est_sec": 10.02,
   "gap_before": 1.02,
   "role": "reply",
   "block": "public_transport.ctx9"
  },
  {
   "speaker": "user",
   "text": "Wait a moment, my coworker is here. Please be quiet until I tell you I'm back.",
   "est_sec": 5.06,
   "gap_before": 0.48,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_14"
  },
  {
   "speaker": "user",
   "text": "Did the package arrive today?",
   "est_sec": 1.65,
   "gap_before": 1.39,
   "event": "distractor",
   "kind": "friend_question",
   "phrasing": "dq_14"
  },
  {
   "speaker": "friend",
   "text": "Yeah, I put it by the door.",
   "est_sec": 2.27,
   "gap_before": 1.31,
   "phrasing": "dq_14"
  },
  {
   "speaker": "user",
   "text": "Do you know what kind of paint the landlord used in the kitchen?",
   "est_sec": 4.13,
   "gap_before": 0.78,
   "event": "distractor",
   "kind": "friend_question",
   "block": "home_repair.side2"
  },
  {
   "speaker": "friend",
   "text": "No idea. Why, are you touching up the scuffs?",
   "est_sec": 2.89,
   "gap_before": 0.94,
   "block": "home_repair.side2"
  },
  {
   "speaker": "user",
   "text": "I want to, but if it's glossy and I use matte, it'll look patchy.",
   "est_sec": 4.44,
   "gap_before": 0.96,
   "block": "home_repair.side2"
  },
  {
   "speaker": "friend",
   "text": "Just take a chip off behind the fridge and bring it to the store. They can match it.",
   "est_sec": 5.68,
   "gap_before": 0.47,
   "block": "home_repair.side2"
  },
  {
   "speaker": "user",
   "text": "Oh, that's clever. Can you help me pull the fridge out later?",
   "est_sec": 3.82,
   "gap_before": 1.09,
   "event": "distractor",
   "kind": "friend_question",
   "block": "home_repair.side2"
  },
  {
   "speaker": "friend",
   "text": "Sure, after dinner.",
   "est_sec": 1.03,
   "gap_before": 0.58,
   "block": "home_repair.side2"
  },
  {
   "speaker": "user",
   "text": "Sorry, I took your seat, do you want it back?",
   "est_sec": 3.2,
   "gap_before": 0.62,
   "event": "distractor",
   "kind": "near_miss",
   "phrasing": "dn_61"
  },
  {
   "speaker": "friend",
   "text": "No, stay, I'll sit on the floor.",
   "est_sec": 2.27,
   "gap_before": 0.69,
   "phrasing": "dn_61"
  },
  {
   "speaker": "user",
   "text": "Okay, we can continue now.",
   "est_sec": 1.65,
   "gap_before": 1.07,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_16"
  },
  {
   "speaker": "moshi",
   "text": "No problem. The stadium trip still needs a route. Bus, or metro?",
   "est_sec": 3.82,
   "gap_before": 0.57,
   "role": "resume",
   "block": "public_transport.ctx9"
  },
  {
   "speaker": "user",
   "text": "Metro, but I'll check the lift status first.",
   "est_sec": 2.58,
   "gap_before": 1.19,
   "event": "ordinary_request",
   "block": "public_transport.ctx9"
  },
  {
   "speaker": "moshi",
   "text": "Good idea. Most networks post lift outages online, so look on the morning of the match.",
   "est_sec": 5.06,
   "gap_before": 0.75,
   "role": "followup",
   "block": "public_transport.ctx9"
  }
 ]
}
