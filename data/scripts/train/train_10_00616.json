 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.31,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.85,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "I've been training for two months and the scale hasn't moved. I'm so frustrated.",
   "est_sec": 4.44,
   "gap_before": 0.21,
   "event": "ordinary_request",
   "block": "fitness.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "That's understandable. But the scale is only one measure, and if you're lifting, you might be building muscle as you lose fat.",
   "est_sec": 6.92,
   "gap_before": 0.66,
   "role": "reply",
   "block": "fitness.dlg31"
  },
  {
   "speaker": "user",
   "text": "How would I even know?",
   "est_sec": 1.65,
   "gap_before": 0.83,
   "event": "ordinary_request",
   "block": "fitness.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Measure your waist, take a photo every few weeks in the same light, and notice how your clothes fit.",
   "est_sec": 5.99,
   "gap_before": 0.63,
   "role": "reply",
   "block": "fitness.dlg31"
  },
  {
   "speaker": "user",
   "text": "My jeans are a bit looser, actually.",
   "est_sec": 2.27,
   "gap_before": 0.69,
   "event": "ordinary_request",
   "block": "fitness.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "That's a great sign. Strength counts too. Are you lifting more than you did in week one?",
   "est_sec": 5.37,
   "gap_before": 1.1,
   "role": "reply",
   "block": "fitness.dlg31"
  },
  {
   "speaker": "user",
   "text": "Way more. My squat",
   "est_sec": 1.34,
   "gap_before": 0.99,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg31"
  },
  {
   "speaker": "user",
   "text": "went up by twenty kilos.",
   "est_sec": 1.65,
   "gap_before": 2.05,
   "event": "ordinary_request",
   "block": "fitness.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "That's real progress. Keep going, and weigh yourself less often, maybe once a week at the same time.",
   "est_sec": 5.68,
   "gap_before": 1.09,
   "role": "reply",
   "block": "fitness.dlg31"
  },
  {
   "speaker": "user",
   "text": "Okay. That makes me feel better.",
   "est_sec": 1.96,
   "gap_before": 1.39,
   "event": "ordinary_request",
   "block": "fitness.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "It should. You're doing well.",
   "est_sec": 1.65,
