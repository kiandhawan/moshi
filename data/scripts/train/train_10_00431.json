 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.88,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "My best friend moved to Canada and her birthday is Friday. Can we do a party over video somehow?",
   "est_sec": 5.99,
   "gap_before": 0.22,
   "event": "ordinary_request",
   "block": "birthday_party.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Definitely. What time zone gap are we talking about?",
   "est_sec": 2.89,
   "gap_before": 1.01,
   "role": "reply",
   "block": "birthday_party.dlg13"
  },
  {
   "speaker": "user",
   "text": "She's six hours behind us.",
   "est_sec": 1.65,
   "gap_before": 1.2,
   "event": "ordinary_request",
   "block": "birthday_party.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Then an evening for her is very late for you. A Saturday afternoon call, morning for her, might suit everyone better.",
   "est_sec": 6.61,
   "gap_before": 0.98,
   "role": "reply",
   "block": "birthday_party.dlg13"
  },
  {
   "speaker": "user",
   "text": "And what do we actually do on the call? Just stare at each other?",
   "est_sec": 4.44,
   "gap_before": 0.75,
   "event": "ordinary_request",
   "block": "birthday_party.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Send her a small parcel beforehand that she opens live, and have everyone bring a little story or memory about her.",
   "est_sec": 6.61,
   "gap_before": 0.94,
   "role": "reply",
   "block": "birthday_party.dlg13"
  },
  {
   "speaker": "user",
   "text": "That might make her cry.",
   "est_sec": 1.65,
   "gap_before": 1.45,
   "event": "ordinary_request",
   "block": "birthday_party.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "In a good way. You could finish with a quick online quiz to lighten things up again.",
   "est_sec": 5.37,
   "gap_before": 1.0,
   "role": "reply",
   "block": "birthday_party.dlg13"
  }
 ]
}
