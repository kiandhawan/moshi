 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.51,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.95,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "I'm moving to a big city and I'm not taking my car. How do I plan my life around transit?",
   "est_sec": 6.3,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "public_transport.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Start with where you'll live. Pick somewhere within a short walk of a frequent line, ideally one that runs late.",
   "est_sec": 6.3,
   "gap_before": 0.59,
   "role": "reply",
   "block": "public_transport.dlg28"
  },
  {
   "speaker": "user",
   "text": "What counts as frequent?",
   "est_sec": 1.34,
   "gap_before": 1.2,
   "event": "ordinary_request",
   "block": "public_transport.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Every ten minutes or better. Then you never really need a timetable, you just turn up.",
   "est_sec": 5.06,
   "gap_before": 0.52,
   "role": "reply",
   "block": "public_transport.dlg28"
  },
  {
   "speaker": "user",
   "text": "And groceries? I'm worried",
   "est_sec": 1.34,
   "gap_before": 0.97,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg28"
  },
  {
   "speaker": "user",
   "text": "about carrying everything.",
   "est_sec": 1.03,
   "gap_before": 2.59,
   "event": "ordinary_request",
   "block": "public_transport.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "A small shop near home for daily things, and online delivery for the heavy stuff. A folding trolley also helps a lot.",
   "est_sec": 6.92,
   "gap_before": 0.9,
   "role": "reply",
   "block": "public_transport.dlg28"
  },
  {
   "speaker": "user",
   "text": "What about weekends away?",
   "est_sec": 1.34,
   "gap_before": 0.41,
   "event": "ordinary_request",
   "block": "public_transport.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Rent a car or use car share for the odd trip. It's usually still cheaper than owning one.",
   "est_sec": 5.68,
   "gap_before": 0.32,
   "role": "reply",
   "block": "public_transport.dlg28"
  }
 ]
}
