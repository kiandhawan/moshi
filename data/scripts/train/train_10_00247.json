 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.31,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.96,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "During exams my heart races and my mind goes blank, even when I know the stuff.",
   "est_sec": 5.06,
   "gap_before": 0.22,
   "event": "ordinary_request",
   "block": "studying.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "That sounds really stressful, and it's very common. Your body's alarm system is just going off at the wrong time.",
   "est_sec": 6.3,
   "gap_before": 0.89,
   "role": "reply",
   "block": "studying.dlg6"
  },
  {
   "speaker": "user",
   "text": "How do I switch it off?",
   "est_sec": 1.96,
   "gap_before": 0.69,
   "event": "ordinary_request",
   "block": "studying.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Slow breathing helps quickly. Breathe in for four counts, out for six, a few times before you start and whenever you freeze.",
   "est_sec": 6.92,
   "gap_before": 0.96,
   "role": "reply",
   "block": "studying.dlg6"
  },
  {
   "speaker": "user",
   "text": "And if I go blank on a question?",
   "est_sec": 2.58,
   "gap_before": 1.07,
   "event": "ordinary_request",
   "block": "studying.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Skip it, do one you're sure about, then come back. Getting a few answers down calms the panic.",
   "est_sec": 5.68,
   "gap_before": 0.59,
   "role": "reply",
   "block": "studying.dlg6"
  },
  {
   "speaker": "user",
   "text": "I just feel like",
   "est_sec": 1.34,
   "gap_before": 0.95,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg6"
  },
  {
   "speaker": "user",
   "text": "everyone else is so calm.",
   "est_sec": 1.65,
   "gap_before": 2.49,
   "event": "ordinary_request",
   "block": "studying.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Lots of them aren't, they're just hiding it. It might also help to talk to your school's support team, they can sometimes arrange a quieter room.",
   "est_sec": 8.16,
   "gap_before": 0.43,
   "role": "reply",
   "block": "studying.dlg6"
  }
 ]
}
