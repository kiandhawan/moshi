 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.74,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.71,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "I want a photo booth at my party but renting one is crazy expensive.",
   "est_sec": 4.44,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "birthday_party.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "You can make one easily. Do you have a blank wall and a phone tripod?",
   "est_sec": 4.75,
   "gap_before": 0.57,
   "role": "reply",
   "block": "birthday_party.dlg29"
  },
  {
   "speaker": "user",
   "text": "Wall yes, tripod no.",
   "est_sec": 1.34,
   "gap_before": 0.36,
   "event": "ordinary_request",
   "block": "birthday_party.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "A stack of books works as a tripod. Hang a sheet of shiny curtain or wrapping paper on the wall and add a lamp in front for good light.",
   "est_sec": 9.09,
   "gap_before": 0.55,
   "role": "reply",
   "block": "birthday_party.dlg29"
  },
  {
   "speaker": "user",
   "text": "And props?",
   "est_sec": 0.72,
   "gap_before": 0.78,
   "event": "ordinary_request",
   "block": "birthday_party.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Cardboard speech bubbles, silly hats, big sunglasses. Charity shops are brilliant for cheap props.",
   "est_sec": 4.44,
   "gap_before": 0.76,
   "role": "reply",
   "block": "birthday_party.dlg29"
  },
  {
   "speaker": "user",
   "text": "How do people take the photos",
   "est_sec": 1.96,
   "gap_before": 1.45,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg29"
  },
  {
   "speaker": "user",
   "text": "if nobody's standing behind the phone?",
   "est_sec": 1.96,
   "gap_before": 1.97,
   "event": "ordinary_request",
   "block": "birthday_party.dlg29"
  },
  {
   "speaker": "moshi",
   "text": "Use the phone's timer, or a cheap Bluetooth remote. Put a little sign on the wall explaining how.",
   "est_sec": 5.68,
   "gap_before": 0.46,
   "role": "reply",
   "block": "birthday_party.dlg29"
  }
 ]
}
