 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.69,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "Why does my new jumper already have little bobbles all over it?",
   "est_sec": 3.82,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "shopping.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "That's pilling. Short loose fibres rub together and twist into little balls, especially under the arms and on the sides.",
   "est_sec": 6.3,
   "gap_before": 0.83,
   "role": "reply",
   "block": "shopping.dlg27"
  },
  {
   "speaker": "user",
   "text": "It was not cheap.",
   "est_sec": 1.34,
   "gap_before": 1.1,
   "event": "ordinary_request",
   "block": "shopping.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Sadly price doesn't always mean quality. Blends with lots of acrylic and very soft loose knits pill fastest.",
   "est_sec": 5.68,
   "gap_before": 1.07,
   "role": "reply",
   "block": "shopping.dlg27"
  },
  {
   "speaker": "user",
   "text": "Can I fix it?",
   "est_sec": 1.34,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "shopping.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "A fabric shaver or a de pilling comb takes them off quickly. Wash it inside out on a gentle cycle to slow it down.",
   "est_sec": 7.54,
   "gap_before": 0.73,
   "role": "reply",
   "block": "shopping.dlg27"
  },
  {
   "speaker": "user",
   "text": "And next time?",
   "est_sec": 1.03,
   "gap_before": 0.85,
   "event": "ordinary_request",
   "block": "shopping.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Feel the knit. Tighter knits and longer fibres like merino or good cotton hold up better. Check the label before you fall in love.",
   "est_sec": 7.54,
   "gap_before": 0.83,
   "role": "reply",
   "block": "shopping.dlg27"
  }
 ]
}
