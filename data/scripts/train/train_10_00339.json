 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.31,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.96,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "Can you recommend a game I could play with my partner? She doesn't really play games.",
   "est_sec": 5.06,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "video_games.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Co-op puzzle games are great for that. There are lovely ones where you each control a character and have to work together.",
   "est_sec": 6.92,
   "gap_before": 0.6,
   "role": "reply",
   "block": "video_games.dlg1"
  },
  {
   "speaker": "user",
   "text": "She gets stressed with anything",
   "est_sec": 1.65,
   "gap_before": 1.82,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg1"
  },
  {
   "speaker": "user",
   "text": "too fast.",
   "est_sec": 0.72,
   "gap_before": 2.44,
   "event": "ordinary_request",
   "block": "video_games.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Then avoid anything with timers. A cozy building or cooking game where nobody can really lose might suit her better.",
   "est_sec": 6.3,
   "gap_before": 0.91,
   "role": "reply",
   "block": "video_games.dlg1"
  },
  {
   "speaker": "user",
   "text": "Hold on, cooking games are chaotic though, aren't they?",
   "est_sec": 2.89,
   "gap_before": 1.68,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_14",
   "block": "video_games.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Some are very chaotic, yes. Look for a relaxed one, or a point and click adventure where you solve things at your own pace.",
   "est_sec": 7.54,
   "gap_before": 0.88,
   "role": "reply",
   "block": "video_games.dlg1"
  },
  {
   "speaker": "user",
   "text": "Point and click sounds good. We could just chat while we play.",
   "est_sec": 3.82,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "video_games.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. It's more like reading a story together than playing a game.",
   "est_sec": 3.82,
   "gap_before": 0.76,
   "role": "reply",
   "block": "video_games.dlg1"
  }
 ]
