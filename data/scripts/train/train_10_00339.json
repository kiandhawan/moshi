 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.94,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "I'd like to volunteer on weekends, but I don't know where to start.",
   "est_sec": 4.13,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Think about what you enjoy. Animals, outdoors, people, or something practical like fixing things?",
   "est_sec": 4.44,
   "gap_before": 0.7,
   "role": "reply",
   "block": "weekend_plans.dlg12"
  },
  {
   "speaker": "user",
   "text": "Wait a second, that doesn't sound right.",
   "est_sec": 2.27,
   "gap_before": 1.1,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_10",
   "block": "weekend_plans.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Good to question it. I still think it's right, though you know your situation best.",
   "est_sec": 4.75,
   "gap_before": 0.65,
   "role": "reply",
   "block": "weekend_plans.dlg12"
  },
  {
   "speaker": "user",
   "text": "Outdoors, definitely.",
   "est_sec": 0.72,
   "gap_before": 1.33,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Then look for conservation groups. They often do weekend days planting trees, clearing paths or cleaning up rivers.",
   "est_sec": 5.68,
   "gap_before": 0.47,
   "role": "reply",
   "block": "weekend_plans.dlg12"
  },
  {
   "speaker": "user",
   "text": "Do I need experience?",
   "est_sec": 1.34,
   "gap_before": 1.26,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Usually not. They'll give you tools and show you what to do. It's a great way to meet people too.",
   "est_sec": 6.3,
   "gap_before": 1.2,
   "role": "reply",
   "block": "weekend_plans.dlg12"
  },
  {
   "speaker": "user",
   "text": "I'm a bit worried about",
   "est_sec": 1.65,
   "gap_before": 1.25,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg12"
  },
  {
   "speaker": "user",
   "text": "committing every weekend.",
   "est_sec": 1.03,
   "gap_before": 1.79,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Many groups let you drop in when you can. Try one day and see how it feels.",
   "est_sec": 5.37,
   "gap_before": 0.86,
   "role": "reply",
   "block": "weekend_plans.dlg12"
  }
 ]
}
