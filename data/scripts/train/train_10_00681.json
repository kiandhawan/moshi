 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.62,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.39,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "I found two flights to Tokyo. One is cheaper but has a nine hour layover.",
   "est_sec": 4.75,
   "gap_before": 0.22,
   "event": "ordinary_request",
   "block": "travel_planning.ctx2"
  },
  {
   "speaker": "moshi",
   "text": "That layover is long, but you could leave the airport for a few hours. Is saving the money worth the extra travel time to you?",
   "est_sec": 7.85,
   "gap_before": 0.67,
   "role": "reply",
   "block": "travel_planning.ctx2"
  },
  {
   "speaker": "user",
   "text": "Let me think about that for twenty seconds, then ask me once more.",
   "est_sec": 4.13,
   "gap_before": 0.39,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 20,
   "phrasing": "think_instr_29"
  },
  {
   "speaker": "user",
   "text": "Oh, but then again",
   "est_sec": 1.34,
   "anchor": {
    "turn": 4,
    "offset": 13.69
   },
   "event": "distractor",
   "kind": "self_talk",
   "phrasing": "self_19"
  },
  {
   "speaker": "moshi",
   "text": "So, have you decided? The cheaper flight with the layover, or the faster one?",
   "est_sec": 4.44,
   "role": "resume",
   "block": "travel_planning.ctx2",
   "anchor": {
    "turn": 4,
    "offset": 20.59
   }
  },
  {
   "speaker": "user",
   "text": "Yeah, I'll take the cheap one. I'm a student, every bit counts.",
   "est_sec": 3.82,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "travel_planning.ctx2"
  },
  {
   "speaker": "moshi",
   "text": "Makes sense. Bring a neck pillow and check whether you need a transit visa to leave the airport.",
