 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.76,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.74,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "I'm completely broke until payday. What can I do in the city this weekend for free?",
   "est_sec": 5.06,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Quite a lot. Most big museums and galleries are free, and many have late openings on Fridays or Saturdays.",
   "est_sec": 5.99,
   "gap_before": 0.84,
   "role": "reply",
   "block": "weekend_plans.dlg5"
  },
  {
   "speaker": "user",
   "text": "I've done the main museum loads of times.",
   "est_sec": 2.58,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Then try a free walking tour, or check the local listings for open rehearsals, talks and markets.",
   "est_sec": 5.37,
   "gap_before": 0.83,
   "role": "reply",
   "block": "weekend_plans.dlg5"
  },
  {
   "speaker": "user",
   "text": "Walking tours are",
   "est_sec": 1.03,
   "gap_before": 3.16,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg5"
  },
  {
   "speaker": "user",
   "text": "free? Like actually free?",
   "est_sec": 1.34,
   "gap_before": 1.51,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Usually pay what you like at the end, so you can just give a little. Parks often have free events at weekends too.",
   "est_sec": 7.23,
   "gap_before": 0.9,
   "role": "reply",
   "block": "weekend_plans.dlg5"
  },
  {
   "speaker": "user",
   "text": "Okay, that's a start.",
   "est_sec": 1.34,
   "gap_before": 0.9,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Pack a lunch and a flask, and you can easily spend a whole day out for nothing.",
   "est_sec": 5.37,
   "gap_before": 1.08,
   "role": "reply",
   "block": "weekend_plans.dlg5"
  }
 ]
}
