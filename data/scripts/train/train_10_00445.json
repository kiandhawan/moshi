 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.58,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "I'm planning a photo walk this weekend and can't pick where to go.",
   "est_sec": 4.13,
   "gap_before": 0.24,
   "block": "photography.opt2"
  },
  {
   "speaker": "user",
   "text": "Wait until I've listed everything before you jump in.",
   "est_sec": 2.89,
   "gap_before": 0.46,
   "event": "instruction",
   "kind": "describe_options",
   "phrasing": "describe_instr_13"
  },
  {
   "speaker": "moshi",
   "text": "Sure, go ahead.",
   "est_sec": 1.03,
   "gap_before": 0.58,
   "role": "ack",
   "phrasing": "ack_08"
  },
  {
   "speaker": "user",
   "text": "One option is the old downtown market early in the morning, when vendors are setting up.",
   "est_sec": 5.06,
   "gap_before": 0.84,
   "block": "photography.opt2",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "Another is the botanical garden, which has a big flower show going on right now.",
   "est_sec": 4.75,
   "gap_before": 2.94,
   "block": "photography.opt2",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "Or there's the harbor at sunset, with the boats and the bridge lit up.",
   "est_sec": 4.44,
   "gap_before": 2.55,
   "block": "photography.opt2"
  },
  {
   "speaker": "user",
   "text": "Okay, I'm done. What do you think?",
   "est_sec": 2.27,
   "gap_before": 0.71,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "describe_cue_04"
  },
  {
   "speaker": "moshi",
   "text": "The harbor at sunset will give you the most dramatic light, especially with the bridge. The market is great for candid shots and street photography. The flower show is perfect for practicing close ups and color.",
   "est_sec": 11.26,
   "gap_before": 0.47,
   "role": "resume",
   "block": "photography.opt2"
  }
 ]
