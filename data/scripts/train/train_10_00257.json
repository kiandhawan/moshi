 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.6,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.66,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "We're on holiday at the coast and it's meant to rain every day this week.",
   "est_sec": 4.75,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "weather_plans.ctx12"
  },
  {
   "speaker": "moshi",
   "text": "That's rotten luck. Would you ride it out here with indoor plans, or drive inland where it looks drier?",
   "est_sec": 5.99,
   "gap_before": 0.92,
   "role": "reply",
   "block": "weather_plans.ctx12"
  },
  {
   "speaker": "user",
   "text": "Let me think about that for sixty seconds, then ask me once more.",
   "est_sec": 4.13,
   "gap_before": 0.53,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 60,
   "phrasing": "think_instr_29"
  },
  {
   "speaker": "user",
   "text": "Oh, I know.",
   "est_sec": 1.03,
   "anchor": {
    "turn": 4,
