 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.38,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.41,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "Something in my fridge stinks. I can't figure out what.",
   "est_sec": 3.2,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "cleaning.ctx9"
  },
  {
   "speaker": "moshi",
   "text": "Mystery smell. Do you want to empty the whole thing and wipe it down today, or just pop in an open box of baking soda and investigate later?",
   "est_sec": 8.78,
   "gap_before": 0.43,
   "role": "reply",
   "block": "cleaning.ctx9"
  },
  {
   "speaker": "user",
   "text": "Hold on, my friend and I need to figure something out. Wait until I'm back, okay?",
   "est_sec": 5.06,
   "gap_before": 0.59,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_26"
  },
  {
   "speaker": "moshi",
   "text": "Okay, I'll wait.",
   "est_sec": 1.03,
   "gap_before": 0.45,
   "role": "ack",
   "phrasing": "ack_05"
  },
  {
   "speaker": "user",
   "text": "Daniel, did Mango throw up on my duvet?",
   "est_sec": 2.58,
   "gap_before": 0.91,
   "event": "distractor",
   "kind": "friend_question",
   "block": "pets.side4"
  },
  {
   "speaker": "friend",
   "text": "Possibly. I heard a very dramatic noise from your room at about six.",
   "est_sec": 4.13,
   "gap_before": 0.39,
   "block": "pets.side4"
  },
  {
   "speaker": "user",
   "text": "And you didn't check?",
   "est_sec": 1.34,
   "gap_before": 0.59,
   "event": "distractor",
   "kind": "friend_question",
   "block": "pets.side4"
  },
  {
   "speaker": "friend",
   "text": "I was asleep. Mostly.",
   "est_sec": 1.34,
   "gap_before": 3.01,
   "block": "pets.side4"
  },
  {
   "speaker": "user",
   "text": "It's a hairball, I think. Do we still have that paste the vet gave us?",
   "est_sec": 4.75,
   "gap_before": 1.2,
   "event": "distractor",
   "kind": "friend_question",
   "block": "pets.side4"
  },
  {
   "speaker": "friend",
   "text": "Top shelf, next to the vitamins. She hates it though.",
   "est_sec": 3.2,
   "gap_before": 0.62,
   "block": "pets.side4"
  },
  {
   "speaker": "user",
   "text": "She hates everything that's good for her. Hold her while I put some on her paw?",
   "est_sec": 5.06,
   "gap_before": 0.91,
   "event": "distractor",
   "kind": "friend_question",
   "block": "pets.side4"
  },
  {
   "speaker": "friend",
   "text": "Fine, but if she scratches me, you're buying dinner.",
   "est_sec": 2.89,
   "gap_before": 1.26,
   "block": "pets.side4"
  },
  {
   "speaker": "user",
   "text": "Alright, I'm back now.",
   "est_sec": 1.34,
   "gap_before": 0.78,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_02"
  },
  {
   "speaker": "moshi",
   "text": "Okay. Your fridge smell. Empty it all, or the baking soda for now?",
   "est_sec": 4.13,
   "gap_before": 0.64,
   "role": "resume",
   "block": "cleaning.ctx9"
  },
  {
   "speaker": "user",
   "text": "Baking soda for now. I'm about to go to work.",
   "est_sec": 3.2,
   "gap_before": 1.36,
   "event": "ordinary_request",
   "block": "cleaning.ctx9"
  },
  {
   "speaker": "moshi",
   "text": "Fine. Leave it open on a middle shelf, and maybe sniff around the back this weekend.",
   "est_sec": 5.06,
   "gap_before": 0.67,
