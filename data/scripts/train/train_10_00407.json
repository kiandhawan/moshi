 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.53,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.92,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "Help me plan lunch for my son's football team? Twelve kids.",
   "est_sec": 3.51,
   "gap_before": 0.26,
   "event": "ordinary_request",
   "block": "cooking.ctx7"
  },
  {
   "speaker": "moshi",
   "text": "Wraps are easy to hold, but pasta salad can be made the night before. Which suits you?",
   "est_sec": 5.37,
   "gap_before": 0.75,
   "role": "reply",
   "block": "cooking.ctx7"
  },
  {
   "speaker": "user",
   "text": "Hmm. Both have their points.",
   "est_sec": 1.65,
   "gap_before": 1.21,
   "event": "ordinary_request",
   "block": "cooking.ctx7"
  },
  {
   "speaker": "moshi",
   "text": "It comes down to working tonight or in the morning.",
   "est_sec": 3.2,
   "gap_before": 0.58,
   "role": "reply",
   "block": "cooking.ctx7"
  },
  {
   "speaker": "user",
   "text": "Hold on, my friend and I need to figure something out. Wait until I'm back, okay?",
   "est_sec": 5.06,
   "gap_before": 0.34,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_26"
  },
  {
   "speaker": "user",
   "text": "Right, how far had we got with the puzzle, the sky bit?",
   "est_sec": 3.82,
   "gap_before": 0.85,
   "event": "distractor",
   "kind": "near_miss",
   "phrasing": "dn_37"
  },
  {
   "speaker": "friend",
   "text": "Yeah, all those blue pieces.",
   "est_sec": 1.65,
   "gap_before": 0.55,
   "phrasing": "dn_37"
  },
  {
   "speaker": "user",
   "text": "Should we cancel the gym membership? Neither of us has been since spring.",
   "est_sec": 4.13,
   "gap_before": 1.07,
   "block": "personal_finance.side5"
  },
  {
   "speaker": "friend",
   "text": "I keep meaning to go.",
   "est_sec": 1.65,
   "gap_before": 0.56,
   "block": "personal_finance.side5"
  },
  {
   "speaker": "user",
   "text": "You said that in March.",
   "est_sec": 1.65,
   "gap_before": 1.18,
   "block": "personal_finance.side5"
  },
  {
   "speaker": "friend",
   "text": "Okay, okay. But if we cancel, there's a joining fee to start again.",
   "est_sec": 4.13,
   "gap_before": 0.5,
   "block": "personal_finance.side5"
  },
  {
   "speaker": "user",
   "text": "How much is it?",
   "est_sec": 1.34,
   "gap_before": 1.05,
   "event": "distractor",
   "kind": "friend_question",
   "block": "personal_finance.side5"
  },
  {
   "speaker": "friend",
   "text": "Like fifty. Versus paying every month to not go.",
   "est_sec": 2.89,
   "gap_before": 0.65,
   "block": "personal_finance.side5"
  },
  {
   "speaker": "user",
   "text": "So cancel?",
   "est_sec": 0.72,
   "gap_before": 0.77,
   "event": "distractor",
   "kind": "friend_question",
   "block": "personal_finance.side5"
  },
  {
   "speaker": "friend",
   "text": "Cancel. We'll go running instead.",
   "est_sec": 1.65,
   "gap_before": 1.06,
   "block": "personal_finance.side5"
  },
  {
   "speaker": "user",
   "text": "We won't, but fine.",
   "est_sec": 1.34,
   "gap_before": 0.42,
   "block": "personal_finance.side5"
  },
  {
   "speaker": "user",
   "text": "Okay, I'm here again.",
   "est_sec": 1.34,
   "gap_before": 1.24,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_26"
  },
  {
