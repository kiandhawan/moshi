 "est_total_sec": 53.84,
 "est_speech_sec": 42.64,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.38,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.5,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "I'm visiting a big city next week and I've never used a subway before. Any tips?",
   "est_sec": 5.06,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "public_transport.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Download the city's transit app before you go. It shows routes, live times and which exit to use.",
   "est_sec": 5.68,
   "gap_before": 0.62,
   "role": "reply",
   "block": "public_transport.dlg1"
  },
  {
   "speaker": "user",
   "text": "How do I know",
   "est_sec": 1.34,
   "gap_before": 2.49,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg1"
  },
  {
   "speaker": "user",
   "text": "which direction to go?",
   "est_sec": 1.34,
   "gap_before": 2.26,
   "event": "ordinary_request",
   "block": "public_transport.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Platforms are usually labeled by the last station on the line. Find your stop on the map, then follow signs for the end station in that direction.",
   "est_sec": 8.47,
   "gap_before": 0.38,
   "role": "reply",
   "block": "public_transport.dlg1"
  },
  {
   "speaker": "user",
   "text": "That makes sense. What about rush hour?",
   "est_sec": 2.27,
   "gap_before": 0.76,
   "event": "ordinary_request",
   "block": "public_transport.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Try to avoid roughly seven to nine in the morning and five to seven in the evening. If you can't, stand to the side and let people off first.",
   "est_sec": 9.09,
   "gap_before": 0.64,
   "role": "reply",
   "block": "public_transport.dlg1"
  },
  {
   "speaker": "user",
   "text": "Okay, thanks. I feel less nervous now.",
   "est_sec": 2.27,
   "gap_before": 0.68,
   "event": "ordinary_request",
   "block": "public_transport.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "You'll do great. Most people figure it out after one or two rides.",
   "est_sec": 4.13,
   "gap_before": 0.54,
   "role": "reply",
   "block": "public_transport.dlg1"
  }
 ]
}
