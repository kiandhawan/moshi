   "text": "What time is the flight?",
   "est_sec": 1.65,
   "gap_before": 0.8,
   "block": "travel_planning.side3"
  },
  {
   "speaker": "user",
   "text": "Seven forty, so we'd need to leave around five.",
   "est_sec": 2.89,
   "gap_before": 1.58,
   "block": "travel_planning.side3"
  },
  {
   "speaker": "friend",
   "text": "Five in the morning? You owe me big for that one.",
   "est_sec": 3.51,
   "gap_before": 0.99,
   "block": "travel_planning.side3"
  },
  {
   "speaker": "user",
   "text": "I'll bring you back something nice, I promise. What do you want?",
   "est_sec": 3.82,
   "gap_before": 0.84,
   "event": "distractor",
   "kind": "friend_question",
   "block": "travel_planning.side3"
  },
