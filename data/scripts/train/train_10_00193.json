   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.53,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "I got a letter saying I owe a bit more tax this year.",
   "est_sec": 4.13,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "personal_finance.ctx10"
  },
  {
   "speaker": "moshi",
   "text": "Not fun. Would you rather pay it all at once, or ask about a payment plan to spread it out?",
   "est_sec": 6.3,
   "gap_before": 1.07,
   "role": "reply",
   "block": "personal_finance.ctx10"
  },
  {
   "speaker": "user",
   "text": "Excuse me for a moment, my friend has a question. Don't talk until I'm back.",
   "est_sec": 4.75,
   "gap_before": 1.38,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_11"
  },
  {
   "speaker": "moshi",
   "text": "No problem.",
   "est_sec": 0.72,
   "gap_before": 0.48,
   "role": "ack",
   "phrasing": "ack_04"
  },
  {
   "speaker": "user",
   "text": "If we want Sunday free, we need to get the chores done tomorrow.",
   "est_sec": 4.13,
   "gap_before": 1.26,
   "block": "weekend_plans.side6"
  },
  {
   "speaker": "friend",
   "text": "All of them?",
   "est_sec": 1.03,
   "gap_before": 0.84,
   "block": "weekend_plans.side6"
  },
  {
   "speaker": "user",
   "text": "Washing, bathroom, food shop. Which one do you want?",
   "est_sec": 2.89,
   "gap_before": 0.5,
   "event": "distractor",
   "kind": "friend_question",
   "block": "weekend_plans.side6"
  },
  {
   "speaker": "friend",
   "text": "I'll do the food shop. You're terrible at it.",
   "est_sec": 2.89,
   "gap_before": 1.44,
   "block": "weekend_plans.side6"
  },
  {
   "speaker": "user",
   "text": "How am I terrible at it?",
   "est_sec": 1.96,
   "gap_before": 0.66,
   "event": "distractor",
   "kind": "friend_question",
   "block": "weekend_plans.side6"
  },
  {
   "speaker": "friend",
   "text": "You came back with four kinds of crisps and no milk.",
   "est_sec": 3.51,
   "gap_before": 0.3,
   "block": "weekend_plans.side6"
  },
  {
   "speaker": "user",
   "text": "That was one time. Fine, I'll do the bathroom.",
   "est_sec": 2.89,
   "gap_before": 2.63,
   "block": "weekend_plans.side6"
  },
  {
   "speaker": "user",
   "text": "Okay, finished. I'm back now.",
   "est_sec": 1.65,
