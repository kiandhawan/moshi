   "text": "Chocolate. Lots of chocolate.",
   "est_sec": 1.34,
   "gap_before": 2.28,
   "block": "travel_planning.side3"
  },
  {
   "speaker": "user",
   "text": "Done.",
   "est_sec": 0.41,
   "gap_before": 3.31,
   "block": "travel_planning.side3"
  },
