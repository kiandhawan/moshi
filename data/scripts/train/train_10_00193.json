   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_16"
  },
  {
   "speaker": "user",
   "text": "Hey Hannah, can you drive us to the airport on Friday morning?",
   "est_sec": 3.82,
   "gap_before": 0.97,
   "event": "distractor",
   "kind": "friend_question",
   "block": "travel_planning.side3"
  },
  {
