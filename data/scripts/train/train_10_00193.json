   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "video_games.ctx2"
  },
  {
   "speaker": "moshi",
   "text": "Lovely. Does she mostly want to play on the TV with the family, or carry it around and play on her own?",
   "est_sec": 6.92,
   "gap_before": 0.31,
   "role": "reply",
   "block": "video_games.ctx2"
  },
  {
   "speaker": "user",
   "text": "Hang on a minute, I want to ask Hannah something first. Don't jump in until I'm back.",
   "est_sec": 5.37,
