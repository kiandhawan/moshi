 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.52,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "I want a quick, fancy dessert tonight. I've got coffee and vanilla ice cream.",
   "est_sec": 4.44,
   "gap_before": 0.3,
   "event": "ordinary_request",
   "block": "coffee.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Then you're one step from an affogato. It's a scoop of ice cream with a hot shot of espresso poured over it.",
   "est_sec": 6.92,
   "gap_before": 1.12,
   "role": "reply",
   "block": "coffee.dlg15"
  },
  {
   "speaker": "user",
   "text": "That's it? That's the whole recipe?",
   "est_sec": 1.96,
   "gap_before": 1.51,
   "event": "ordinary_request",
   "block": "coffee.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "That's it. Pour it at the table so everyone sees it melt. It looks impressive and takes two minutes.",
   "est_sec": 5.99,
   "gap_before": 1.13,
   "role": "reply",
   "block": "coffee.dlg15"
  },
  {
   "speaker": "user",
   "text": "I don't have an espresso",
   "est_sec": 1.65,
   "gap_before": 0.8,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg15"
  },
  {
   "speaker": "user",
   "text": "machine, though.",
   "est_sec": 0.72,
   "gap_before": 2.8,
   "event": "ordinary_request",
   "block": "coffee.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Use very strong coffee from a moka pot or a French press. It won't be quite the same, but it'll still be delicious.",
   "est_sec": 7.23,
   "gap_before": 0.99,
   "role": "reply",
   "block": "coffee.dlg15"
  },
  {
   "speaker": "user",
   "text": "Could I add something?",
   "est_sec": 1.34,
   "gap_before": 1.02,
   "event": "ordinary_request",
   "block": "coffee.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "A little grated dark chocolate or a crushed biscuit on top is lovely. Some adults add a splash of nut liqueur.",
   "est_sec": 6.61,
   "gap_before": 1.1,
   "role": "reply",
   "block": "coffee.dlg15"
  }
 ]
