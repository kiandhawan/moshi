 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.31,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.95,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "My parents offered to lend me money for a deposit on a flat.",
   "est_sec": 4.13,
   "gap_before": 0.23,
   "event": "ordinary_request",
   "block": "personal_finance.ctx9"
  },
  {
   "speaker": "moshi",
   "text": "That's generous. A proper loan with a repayment plan, or keep saving alone?",
   "est_sec": 4.13,
   "gap_before": 0.74,
   "role": "reply",
   "block": "personal_finance.ctx9"
  },
  {
   "speaker": "user",
   "text": "Both feel weird.",
   "est_sec": 1.03,
   "gap_before": 0.72,
   "event": "ordinary_request",
   "block": "personal_finance.ctx9"
  },
  {
   "speaker": "moshi",
   "text": "Fair. Which is less weird, owing them, or waiting longer?",
   "est_sec": 3.2,
   "gap_before": 0.74,
   "role": "reply",
   "block": "personal_finance.ctx9"
  },
  {
   "speaker": "user",
   "text": "One sec, I'm going to talk with my neighbor. Please wait until I'm back.",
   "est_sec": 4.44,
   "gap_before": 1.24,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_22"
  },
  {
   "speaker": "moshi",
   "text": "Okay, sure.",
   "est_sec": 0.72,
   "gap_before": 0.64,
   "role": "ack",
   "phrasing": "ack_16"
  },
  {
   "speaker": "user",
   "text": "How was the trail you did last week?",
   "est_sec": 2.58,
   "gap_before": 1.36,
   "event": "distractor",
   "kind": "friend_question",
   "block": "hiking.side2"
  },
  {
   "speaker": "friend",
   "text": "Beautiful, but really muddy near the waterfall.",
   "est_sec": 2.27,
   "gap_before": 0.84,
   "block": "hiking.side2"
  },
  {
   "speaker": "user",
   "text": "Would it be okay for the kids?",
   "est_sec": 2.27,
   "gap_before": 2.91,
   "event": "distractor",
   "kind": "friend_question",
   "block": "hiking.side2"
  },
  {
   "speaker": "friend",
   "text": "The first part, yes. The last mile is steep with loose rocks, I wouldn't bring them up there.",
   "est_sec": 5.68,
   "gap_before": 0.95,
   "block": "hiking.side2"
  },
  {
   "speaker": "user",
   "text": "We could just go to the waterfall and turn back.",
   "est_sec": 3.2,
   "gap_before": 0.92,
   "block": "hiking.side2"
  },
  {
   "speaker": "friend",
   "text": "That's the best bit anyway. They'll love it.",
   "est_sec": 2.58,
   "gap_before": 0.86,
   "block": "hiking.side2"
  },
  {
   "speaker": "user",
   "text": "Okay, I'm done talking to them. I'm back.",
   "est_sec": 2.58,
   "gap_before": 0.93,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_11"
  },
  {
   "speaker": "moshi",
   "text": "No problem. Your parents' offer. Accepting the loan, or saving on your own?",
   "est_sec": 4.13,
   "gap_before": 1.07,
   "role": "resume",
