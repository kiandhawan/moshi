 "est_total_sec": 48.08,
 "est_speech_sec": 34.27,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.45,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 1.0,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "I burned rice to the bottom of my good steel pot. It's black.",
   "est_sec": 4.13,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "cleaning.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Don't panic, steel is tough. Cover the burnt bit with water, add a couple of spoons of baking soda, and bring it to a simmer.",
   "est_sec": 7.85,
   "gap_before": 0.59,
   "role": "reply",
   "block": "cleaning.dlg8"
  },
  {
   "speaker": "user",
   "text": "How long?",
   "est_sec": 0.72,
   "gap_before": 1.45,
   "event": "ordinary_request",
   "block": "cleaning.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "About ten minutes. Then let it cool and scrape with a wooden spoon. Most of it should lift.",
   "est_sec": 5.68,
   "gap_before": 1.14,
   "role": "reply",
   "block": "cleaning.dlg8"
  },
  {
   "speaker": "user",
   "text": "Some came off but there's still a dark ring.",
   "est_sec": 2.89,
   "gap_before": 1.48,
   "event": "ordinary_request",
   "block": "cleaning.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Make a paste with baking soda and a little water and scrub the ring with a non-scratch sponge.",
   "est_sec": 5.68,
   "gap_before": 0.91,
   "role": "reply",
   "block": "cleaning.dlg8"
  },
  {
   "speaker": "user",
   "text": "Okay. It's coming",
   "est_sec": 1.03,
   "gap_before": 1.15,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg8"
  },
  {
   "speaker": "user",
   "text": "slowly.",
   "est_sec": 0.41,
   "gap_before": 2.7,
   "event": "ordinary_request",
   "block": "cleaning.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Slow is fine. It'll look nearly new.",
   "est_sec": 2.27,
   "gap_before": 1.01,
   "role": "reply",
   "block": "cleaning.dlg8"
  }
 ]
}
