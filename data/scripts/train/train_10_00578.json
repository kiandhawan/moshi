 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.64,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "It's our tenth anniversary this weekend.",
   "est_sec": 1.96,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "weekend_plans.ctx10"
  },
  {
   "speaker": "moshi",
   "text": "Congratulations! Would you like to surprise your wife with a plan, or sit down and plan it together?",
   "est_sec": 5.68,
   "gap_before": 1.16,
   "role": "reply",
   "block": "weekend_plans.ctx10"
  },
  {
   "speaker": "user",
   "text": "She's tricky to surprise.",
   "est_sec": 1.34,
   "gap_before": 2.97,
   "event": "ordinary_request",
   "block": "weekend_plans.ctx10"
  },
  {
   "speaker": "moshi",
   "text": "Then is it worth the risk, or would planning it together make it more fun?",
   "est_sec": 4.75,
   "gap_before": 0.55,
   "role": "reply",
   "block": "weekend_plans.ctx10"
  },
  {
   "speaker": "user",
   "text": "Excuse me for a moment, my friend has a question. Don't talk until I'm back.",
   "est_sec": 4.75,
   "gap_before": 0.32,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_11"
  },
  {
   "speaker": "moshi",
   "text": "Alright.",
   "est_sec": 0.41,
   "gap_before": 0.24,
   "role": "ack",
   "phrasing": "ack_11"
  },
  {
   "speaker": "user",
   "text": "Did you top up your travel card? Mine's almost empty.",
   "est_sec": 3.2,
   "gap_before": 0.6,
   "block": "public_transport.side2"
  },
  {
   "speaker": "friend",
   "text": "I did it yesterday at the machine by the entrance.",
   "est_sec": 3.2,
   "gap_before": 1.44,
   "block": "public_transport.side2"
  },
  {
   "speaker": "user",
   "text": "Does it take cards or only cash?",
   "est_sec": 2.27,
   "gap_before": 1.92,
   "event": "distractor",
   "kind": "friend_question",
   "block": "public_transport.side2"
  },
  {
   "speaker": "friend",
   "text": "Both. But the one on the left is always broken.",
   "est_sec": 3.2,
   "gap_before": 0.96,
   "block": "public_transport.side2"
  },
  {
   "speaker": "user",
   "text": "Good to know. Wait for me here, I'll be quick.",
   "est_sec": 3.2,
   "gap_before": 0.42,
   "block": "public_transport.side2"
  },
  {
   "speaker": "friend",
   "text": "Hurry, the train is in four minutes.",
   "est_sec": 2.27,
   "gap_before": 1.46,
   "block": "public_transport.side2"
  },
  {
   "speaker": "user",
   "text": "Rosa, I'm here at the front, where are you parked?",
   "est_sec": 3.2,
   "gap_before": 2.6,
   "event": "distractor",
   "kind": "near_miss",
   "phrasing": "dn_45"
  },
  {
   "speaker": "friend",
   "text": "Round the back, by the bins.",
   "est_sec": 1.96,
   "gap_before": 0.76,
   "phrasing": "dn_45"
  },
  {
   "speaker": "user",
   "text": "Okay, we can continue now.",
   "est_sec": 1.65,
   "gap_before": 1.6,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_16"
  },
