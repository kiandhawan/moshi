 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.38,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "Do I really need to warm up before lifting? It feels like a waste of time.",
   "est_sec": 5.06,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "fitness.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "A short one is worth it. Five to ten minutes gets blood flowing and makes your first sets feel better.",
   "est_sec": 6.3,
   "gap_before": 0.38,
   "role": "reply",
   "block": "fitness.dlg15"
  },
  {
   "speaker": "user",
   "text": "What counts as a warm up?",
   "est_sec": 1.96,
   "gap_before": 0.73,
   "event": "ordinary_request",
   "block": "fitness.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "A few minutes of light cardio, then some lighter sets of the lift you're about to do.",
   "est_sec": 5.37,
   "gap_before": 1.07,
   "role": "reply",
   "block": "fitness.dlg15"
  },
  {
   "speaker": "user",
   "text": "Lighter sets. Like how light?",
   "est_sec": 1.65,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "block": "fitness.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "For example, if your working weight on squats is sixty kilos, do a set with the empty bar, then forty, then fifty.",
   "est_sec": 6.92,
   "gap_before": 1.21,
   "role": "reply",
   "block": "fitness.dlg15"
  },
  {
   "speaker": "user",
   "text": "That's actually not that long. I always just",
   "est_sec": 2.58,
   "gap_before": 2.59,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg15"
  },
  {
   "speaker": "user",
   "text": "jump straight to my working weight.",
   "est_sec": 1.96,
   "gap_before": 2.55,
   "event": "ordinary_request",
   "block": "fitness.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "That's when people tweak something. A few warm up sets is cheap insurance.",
   "est_sec": 4.13,
   "gap_before": 1.07,
   "role": "reply",
   "block": "fitness.dlg15"
  }
 ]
}
