 "est_total_sec": 43.98,
 "est_speech_sec": 35.41,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.66,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.82,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "Silly question. On a narrow path, who's supposed to step aside, the person going up or down?",
   "est_sec": 5.37,
   "gap_before": 0.25,
   "event": "ordinary_request",
   "block": "hiking.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Not silly. The usual etiquette is that people going downhill give way to those climbing up.",
   "est_sec": 5.06,
   "gap_before": 0.72,
   "role": "reply",
   "block": "hiking.dlg27"
  },
  {
   "speaker": "user",
   "text": "Why's that?",
   "est_sec": 0.72,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "hiking.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Climbing is harder to restart once you've stopped, and the person coming up has a narrower view of the path.",
   "est_sec": 6.3,
   "gap_before": 0.51,
   "role": "reply",
   "block": "hiking.dlg27"
  },
  {
   "speaker": "user",
   "text": "What about mountain bikers?",
   "est_sec": 1.34,
   "gap_before": 0.93,
   "event": "ordinary_request",
   "block": "hiking.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Officially, bikes give way to walkers. In practice, a friendly step aside is often easier for everyone.",
   "est_sec": 5.37,
   "gap_before": 0.82,
   "role": "reply",
   "block": "hiking.dlg27"
  },
  {
   "speaker": "user",
   "text": "And horses?",
   "est_sec": 0.72,
   "gap_before": 1.1,
   "event": "ordinary_request",
   "block": "hiking.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Everyone gives way to horses. Step to the downhill side if you can and say hello, it helps the horse know you're human.",
   "est_sec": 7.23,
   "gap_before": 0.69,
   "role": "reply",
   "block": "hiking.dlg27"
  }
 ]
}
