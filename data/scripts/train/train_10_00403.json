 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.56,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.71,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "How often should I be washing my bed sheets? Be honest.",
   "est_sec": 3.51,
   "gap_before": 0.27,
   "event": "ordinary_request",
   "block": "cleaning.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Honestly, about once a week. Every two weeks at most.",
   "est_sec": 3.2,
   "gap_before": 1.14,
   "role": "reply",
   "block": "cleaning.dlg14"
  },
  {
   "speaker": "user",
   "text": "Oh no. It's been",
   "est_sec": 1.34,
   "gap_before": 0.67,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg14"
  },
  {
   "speaker": "user",
   "text": "maybe a month.",
   "est_sec": 1.03,
   "gap_before": 2.42,
   "event": "ordinary_request",
   "block": "cleaning.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "You're not alone, plenty of people stretch it. But sweat and skin build up, and that's what dust mites love.",
   "est_sec": 6.3,
   "gap_before": 0.88,
   "role": "reply",
   "block": "cleaning.dlg14"
  },
  {
   "speaker": "user",
   "text": "Okay, that's gross. Pillowcases too?",
   "est_sec": 1.65,
   "gap_before": 1.38,
   "event": "ordinary_request",
   "block": "cleaning.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Pillowcases ideally more often, especially if you have spots. Your face is on them all night.",
   "est_sec": 5.06,
   "gap_before": 0.7,
   "role": "reply",
   "block": "cleaning.dlg14"
  },
  {
   "speaker": "user",
   "text": "Right. Stripping the bed now.",
   "est_sec": 1.65,
   "gap_before": 1.29,
   "event": "ordinary_request",
   "block": "cleaning.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Having a second set makes it easier, you swap them straight away.",
   "est_sec": 3.82,
   "gap_before": 1.02,
   "role": "reply",
   "block": "cleaning.dlg14"
  }
