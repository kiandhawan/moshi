 "est_total_sec": 58.1,
 "est_speech_sec": 45.74,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.64,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.97,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "Is it possible to roast coffee beans at home? I keep seeing green beans for sale.",
   "est_sec": 5.06,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "coffee.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "It is, and it's a fun hobby. You can start with a heavy pan on the stove or a cheap popcorn popper.",
   "est_sec": 6.92,
   "gap_before": 0.39,
   "role": "reply",
   "block": "coffee.dlg30"
  },
  {
   "speaker": "user",
   "text": "A popcorn popper? Really?",
   "est_sec": 1.34,
   "gap_before": 1.15,
   "event": "ordinary_request",
   "block": "coffee.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Really. The hot air keeps the beans moving so they roast evenly. Just do it outside or near an open window, there's a lot of smoke and chaff.",
   "est_sec": 8.78,
   "gap_before": 0.45,
   "role": "reply",
   "block": "coffee.dlg30"
  },
  {
   "speaker": "user",
   "text": "How do I know",
   "est_sec": 1.34,
   "gap_before": 1.93,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg30"
  },
  {
   "speaker": "user",
   "text": "when they're done?",
   "est_sec": 1.03,
   "gap_before": 2.61,
   "event": "ordinary_request",
   "block": "coffee.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Listen for the first crack, a popping sound like popcorn. Stopping shortly after gives a light roast, and keeping going towards a second crack gets darker.",
   "est_sec": 8.16,
   "gap_before": 0.49,
   "role": "reply",
   "block": "coffee.dlg30"
  },
  {
   "speaker": "user",
   "text": "Can I drink them straight away?",
   "est_sec": 1.96,
   "gap_before": 1.36,
   "event": "ordinary_request",
   "block": "coffee.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "It's best to let them rest for a day or two. Fresh roasted beans release a lot of gas, and the flavour settles after a short rest.",
   "est_sec": 8.47,
   "gap_before": 0.3,
   "role": "reply",
   "block": "coffee.dlg30"
  }
 ]
}
