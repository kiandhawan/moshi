 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.78,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.86,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "My friends keep saying my headset mic sounds terrible. Like I'm underwater.",
   "est_sec": 3.82,
   "gap_before": 0.25,
   "event": "ordinary_request",
   "block": "video_games.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "That's annoying for everyone. First, is it plugged in through a cable or connected wirelessly?",
   "est_sec": 4.75,
   "gap_before": 1.14,
   "role": "reply",
   "block": "video_games.dlg20"
  },
  {
   "speaker": "user",
   "text": "Wireless, through the controller.",
   "est_sec": 1.34,
   "gap_before": 0.72,
   "event": "ordinary_request",
   "block": "video_games.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Check the console's audio settings. Sometimes the mic is set to very low quality to save bandwidth, or a monitor setting adds an echo.",
   "est_sec": 7.54,
   "gap_before": 0.32,
   "role": "reply",
   "block": "video_games.dlg20"
  },
  {
   "speaker": "user",
   "text": "There is a",
   "est_sec": 1.03,
   "gap_before": 1.08,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg20"
  },
  {
   "speaker": "user",
   "text": "mic level slider.",
   "est_sec": 1.03,
   "gap_before": 2.74,
   "event": "ordinary_request",
   "block": "video_games.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Try lowering the input level a bit. If it's too high, it distorts, which can sound muffled. Also check the mic isn't touching your face or cheek.",
   "est_sec": 8.47,
   "gap_before": 0.53,
   "role": "reply",
   "block": "video_games.dlg20"
  },
  {
   "speaker": "user",
   "text": "It kind of is.",
   "est_sec": 1.34,
   "gap_before": 1.32,
   "event": "ordinary_request",
   "block": "video_games.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Move it about two fingers' width from your mouth, slightly to the side. That alone often fixes the underwater sound.",
   "est_sec": 6.3,
   "gap_before": 0.94,
   "role": "reply",
   "block": "video_games.dlg20"
  }
 ]
}
