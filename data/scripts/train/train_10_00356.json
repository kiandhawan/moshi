 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.44,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.64,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I want to catch a beautiful sunset on my evening walk. When's the best time to go?",
   "est_sec": 5.37,
   "gap_before": 0.4,
   "event": "ordinary_request",
   "block": "weather_plans.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Head out about half an hour before sunset. The light gets warm and golden, and the best colours often come just after the sun dips.",
   "est_sec": 7.85,
   "gap_before": 0.52,
   "role": "reply",
   "block": "weather_plans.dlg27"
  },
  {
   "speaker": "user",
   "text": "Does cloud ruin it?",
   "est_sec": 1.34,
   "gap_before": 0.85,
   "event": "ordinary_request",
   "block": "weather_plans.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Not always. Some high, broken cloud often makes sunsets more dramatic, it catches the colour.",
   "est_sec": 4.75,
   "gap_before": 0.42,
   "role": "reply",
   "block": "weather_plans.dlg27"
  },
  {
   "speaker": "user",
   "text": "And a completely clear sky?",
   "est_sec": 1.65,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "weather_plans.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Pretty, but simpler. A thick grey layer on the horizon is the one that usually spoils it.",
   "est_sec": 5.37,
   "gap_before": 0.37,
   "role": "reply",
   "block": "weather_plans.dlg27"
  },
  {
   "speaker": "user",
   "text": "There's a hill near me",
   "est_sec": 1.65,
   "gap_before": 1.47,
   "event": "distractor",
   "kind": "pause",
   "block": "weather_plans.dlg27"
  },
  {
   "speaker": "user",
   "text": "with a view to the west.",
   "est_sec": 1.96,
   "gap_before": 1.81,
   "event": "ordinary_request",
   "block": "weather_plans.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Perfect spot. Check the sunset time in your weather app and bring a torch for the walk back.",
   "est_sec": 5.68,
   "gap_before": 0.5,
   "role": "reply",
   "block": "weather_plans.dlg27"
  }
 ]
