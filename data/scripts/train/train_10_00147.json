 "est_total_sec": 58.8,
 "est_speech_sec": 42.53,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.56,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.48,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "Right, I've decided. This winter I'm making proper croissants from scratch.",
   "est_sec": 3.51,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "baking.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Love the ambition. It's a three day project if you do it properly, but most of that is the dough resting in the fridge.",
   "est_sec": 7.54,
   "gap_before": 0.38,
   "role": "reply",
   "block": "baking.dlg13"
  },
  {
   "speaker": "user",
   "text": "Three days? I was hoping for Saturday morning.",
   "est_sec": 2.58,
   "gap_before": 1.21,
   "event": "ordinary_request",
   "block": "baking.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "You can squeeze it into two. Make the dough Thursday night, laminate Friday, shape and bake Saturday.",
   "est_sec": 5.37,
   "gap_before": 0.75,
   "role": "reply",
   "block": "baking.dlg13"
  },
  {
   "speaker": "user",
   "text": "Laminate means",
   "est_sec": 0.72,
   "gap_before": 1.44,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg13"
  },
  {
   "speaker": "user",
   "text": "the butter folding thing, yeah?",
   "est_sec": 1.65,
   "gap_before": 2.65,
   "event": "ordinary_request",
   "block": "baking.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. You wrap a flat slab of cold butter in dough and roll and fold it a few times to build layers.",
   "est_sec": 6.92,
   "gap_before": 0.33,
   "role": "reply",
   "block": "baking.dlg13"
  },
  {
   "speaker": "user",
   "text": "What usually goes wrong?",
   "est_sec": 1.34,
   "gap_before": 1.04,
   "event": "ordinary_request",
   "block": "baking.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Butter that's too warm and leaks out, or too cold and shatters. It should bend like modelling clay.",
   "est_sec": 5.68,
   "gap_before": 0.94,
   "role": "reply",
   "block": "baking.dlg13"
  },
  {
   "speaker": "user",
   "text": "Modelling clay. Okay, noted.",
   "est_sec": 1.34,
   "gap_before": 3.45,
   "event": "ordinary_request",
   "block": "baking.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "And keep the kitchen cool. Croissants hate a hot room.",
   "est_sec": 3.2,
   "gap_before": 1.1,
   "role": "reply",
   "block": "baking.dlg13"
  }
 ]
}
