 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.33,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "My friends always argue about the rules in Monopoly. How do we stop that?",
   "est_sec": 4.44,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "board_games.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Agree on house rules before you start, like what happens on free parking. Writing them on a note helps.",
   "est_sec": 5.99,
   "gap_before": 0.47,
   "role": "reply",
   "block": "board_games.dlg2"
  },
  {
   "speaker": "user",
   "text": "The game also takes forever.",
   "est_sec": 1.65,
   "gap_before": 2.81,
   "event": "ordinary_request",
   "block": "board_games.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "The official rules include auctions when someone skips a property. Using them makes the game much faster.",
   "est_sec": 5.37,
   "gap_before": 0.72,
   "role": "reply",
   "block": "board_games.dlg2"
  },
  {
   "speaker": "user",
   "text": "I had no idea. What else?",
   "est_sec": 1.96,
   "gap_before": 1.49,
   "event": "ordinary_request",
   "block": "board_games.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "You can set a time limit, like ninety minutes, and whoever has the most money then wins.",
   "est_sec": 5.37,
   "gap_before": 0.35,
   "role": "reply",
   "block": "board_games.dlg2"
  },
  {
   "speaker": "user",
   "text": "Honestly, maybe",
   "est_sec": 0.72,
   "gap_before": 0.42,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg2"
  },
  {
   "speaker": "user",
   "text": "we should just play a different game.",
   "est_sec": 2.27,
   "gap_before": 2.12,
   "event": "ordinary_request",
   "block": "board_games.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "That's an option too. Catan has a similar trading feel and usually ends in about an hour.",
   "est_sec": 5.37,
   "gap_before": 0.48,
   "role": "reply",
   "block": "board_games.dlg2"
  }
