 "est_total_sec": 46.77,
 "est_speech_sec": 36.65,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.96,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "It's going to be super humid tomorrow and I'm meant to do a long run. Good idea?",
   "est_sec": 5.37,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "weather_plans.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "You can, but slow down. Sweat doesn't evaporate well in humidity, so your body struggles more to cool off.",
   "est_sec": 5.99,
   "gap_before": 1.0,
   "role": "reply",
   "block": "weather_plans.dlg11"
  },
  {
   "speaker": "user",
   "text": "So run slower than usual?",
   "est_sec": 1.65,
   "gap_before": 0.95,
   "event": "ordinary_request",
   "block": "weather_plans.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Yes, and don't chase your normal times. Running by feel or heart rate is better on days like that.",
   "est_sec": 5.99,
   "gap_before": 0.86,
   "role": "reply",
   "block": "weather_plans.dlg11"
  },
  {
   "speaker": "user",
   "text": "What time's best?",
   "est_sec": 1.03,
   "gap_before": 0.97,
   "event": "ordinary_request",
   "block": "weather_plans.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Early morning usually, it's cooler, even if the humidity's still high.",
   "est_sec": 3.51,
   "gap_before": 1.48,
   "role": "reply",
   "block": "weather_plans.dlg11"
  },
  {
   "speaker": "user",
   "text": "And water? I usually don't carry any.",
   "est_sec": 2.27,
   "gap_before": 1.09,
   "event": "ordinary_request",
   "block": "weather_plans.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Tomorrow, I'd carry some, or plan a loop past a tap. Stop if you feel dizzy, sick or stop sweating.",
   "est_sec": 6.3,
   "gap_before": 0.37,
   "role": "reply",
   "block": "weather_plans.dlg11"
  }
 ]
}
