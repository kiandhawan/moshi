   "text": "Sure, go ahead.",
   "est_sec": 1.03,
   "gap_before": 0.97,
   "block": "shopping.side3"
  },
  {
   "speaker": "user",
   "text": "Done. I'm back now.",
   "est_sec": 1.34,
