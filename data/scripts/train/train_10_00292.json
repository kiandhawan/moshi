   "gap_before": 1.07,
   "event": "distractor",
   "kind": "friend_question",
   "block": "shopping.side3"
  },
  {
   "speaker": "friend",
   "text": "The heavier one. Thin pans burn everything.",
   "est_sec": 2.27,
   "gap_before": 0.31,
   "block": "shopping.side3"
  },
  {
   "speaker": "user",
   "text": "It's almost twice the price though.",
   "est_sec": 1.96,
   "gap_before": 1.34,
   "block": "shopping.side3"
  },
  {
   "speaker": "friend",
   "text": "It'll last you ten years. The other one will be scratched by spring.",
   "est_sec": 4.13,
   "gap_before": 0.82,
   "block": "shopping.side3"
  },
  {
   "speaker": "user",
   "text": "Okay, you've convinced me. Can you hold it while I find a basket?",
