   "est_sec": 1.34,
   "gap_before": 0.85,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "My son turns six next month and he wants a big party.",
   "est_sec": 3.82,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "block": "birthday_party.ctx1"
  },
  {
   "speaker": "moshi",
   "text": "Fun! Would you rather host it at home, or book a place like a trampoline park?",
   "est_sec": 5.06,
   "gap_before": 0.73,
   "role": "reply",
   "block": "birthday_party.ctx1"
  },
  {
   "speaker": "user",
   "text": "Can you hang on? I have to talk to someone here. I'll tell you when I'm back.",
   "est_sec": 5.37,
   "gap_before": 0.58,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_04"
  },
  {
   "speaker": "moshi",
   "text": "Okay, no rush.",
   "est_sec": 1.03,
   "gap_before": 0.36,
   "role": "ack",
   "phrasing": "ack_10"
  },
  {
   "speaker": "user",
   "text": "Okay, I'm ready, let's go after this.",
   "est_sec": 2.27,
   "gap_before": 0.7,
   "event": "distractor",
   "kind": "near_miss",
   "phrasing": "dn_07"
  },
  {
   "speaker": "friend",
   "text": "Give me a minute to find my shoes.",
   "est_sec": 2.58,
   "gap_before": 1.08,
   "phrasing": "dn_07"
  },
  {
   "speaker": "user",
   "text": "Ben, which of these two pans do you think is better?",
