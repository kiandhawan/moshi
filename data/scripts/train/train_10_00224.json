 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.99,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "The forecast says minus two but feels like minus nine. What's the difference?",
   "est_sec": 4.13,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "weather_plans.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "That's wind chill. The wind pulls heat away from your skin faster, so it feels much colder than the thermometer says.",
   "est_sec": 6.61,
   "gap_before": 0.55,
   "role": "reply",
   "block": "weather_plans.dlg9"
  },
  {
   "speaker": "user",
   "text": "So I should dress for minus nine.",
   "est_sec": 2.27,
   "gap_before": 0.63,
   "event": "ordinary_request",
   "block": "weather_plans.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Especially your face, ears and hands, they're the bits that get bitten first.",
   "est_sec": 4.44,
   "gap_before": 0.38,
   "role": "reply",
   "block": "weather_plans.dlg9"
  },
  {
   "speaker": "user",
   "text": "I was going to wear my wool coat.",
   "est_sec": 2.58,
   "gap_before": 0.36,
   "event": "ordinary_request",
   "block": "weather_plans.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Wool is warm, but the wind goes straight through it. A windproof layer on top would help a lot.",
   "est_sec": 5.99,
   "gap_before": 0.7,
   "role": "reply",
   "block": "weather_plans.dlg9"
  },
  {
   "speaker": "user",
   "text": "Like a rain jacket?",
   "est_sec": 1.34,
   "gap_before": 0.95,
   "event": "ordinary_request",
   "block": "weather_plans.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Yes, a rain jacket over a warm jumper works brilliantly. Add a hat and gloves, and maybe a scarf over your nose.",
   "est_sec": 6.92,
   "gap_before": 1.33,
   "role": "reply",
   "block": "weather_plans.dlg9"
  }
 ]
}
