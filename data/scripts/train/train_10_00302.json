 "est_total_sec": 52.02,
 "est_speech_sec": 41.71,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.66,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.96,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "I just realized my passport expires in five weeks and my trip to Peru is in three.",
   "est_sec": 5.37,
   "gap_before": 0.27,
   "event": "ordinary_request",
   "block": "travel_planning.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Okay, that's worth acting on today. Many countries want your passport valid for six months after you arrive.",
   "est_sec": 5.68,
   "gap_before": 0.42,
   "role": "reply",
   "block": "travel_planning.dlg8"
  },
  {
   "speaker": "user",
   "text": "Six months? So it's useless?",
   "est_sec": 1.65,
   "gap_before": 0.73,
   "event": "ordinary_request",
   "block": "travel_planning.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Possibly for this trip. Check the official entry rules for Peru, and look at your passport office's fast track service.",
   "est_sec": 6.3,
   "gap_before": 0.67,
   "role": "reply",
   "block": "travel_planning.dlg8"
  },
  {
   "speaker": "user",
   "text": "How fast is fast track?",
   "est_sec": 1.65,
   "gap_before": 0.91,
   "event": "ordinary_request",
   "block": "travel_planning.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "In many countries it can be a week or even same day, but you usually need an appointment. Book as early as you can.",
   "est_sec": 7.54,
   "gap_before": 0.87,
   "role": "reply",
   "block": "travel_planning.dlg8"
  },
  {
   "speaker": "user",
   "text": "This is so stressful. I already",
   "est_sec": 1.96,
   "gap_before": 0.53,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg8"
  },
  {
   "speaker": "user",
   "text": "paid for everything.",
   "est_sec": 1.03,
   "gap_before": 2.18,
   "event": "ordinary_request",
   "block": "travel_planning.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "I know, but three weeks is often enough if you move now. Call the passport office first thing and check your airline's rules too.",
   "est_sec": 7.54,
   "gap_before": 0.61,
   "role": "reply",
   "block": "travel_planning.dlg8"
  }
 ]
}
