 "est_total_sec": 51.72,
 "est_speech_sec": 38.92,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.48,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "We booked bowling for my son's party. What do I need to sort beforehand?",
   "est_sec": 4.44,
   "gap_before": 0.3,
   "event": "ordinary_request",
   "block": "birthday_party.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Nice choice. Have you checked if they do bumpers and lighter balls for kids?",
   "est_sec": 4.44,
   "gap_before": 0.79,
   "role": "reply",
   "block": "birthday_party.dlg22"
  },
  {
   "speaker": "user",
   "text": "I didn't think of that. They're nine.",
   "est_sec": 2.27,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "birthday_party.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Ask for bumpers, they make it more fun and less frustrating at that age. Also check how many kids per lane.",
   "est_sec": 6.61,
   "gap_before": 1.25,
   "role": "reply",
   "block": "birthday_party.dlg22"
  },
  {
   "speaker": "user",
   "text": "Six per lane, I think. And food?",
   "est_sec": 2.27,
   "gap_before": 0.76,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg22"
  },
  {
   "speaker": "user",
   "text": "Do I bring my own or do they do it?",
   "est_sec": 3.2,
   "gap_before": 2.87,
   "event": "ordinary_request",
   "block": "birthday_party.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Most places offer a party package with food, and often don't allow outside food except the cake. Ask them directly.",
   "est_sec": 6.3,
   "gap_before": 1.6,
   "role": "reply",
   "block": "birthday_party.dlg22"
  },
  {
   "speaker": "user",
   "text": "Okay. Anything else?",
   "est_sec": 1.03,
   "gap_before": 0.89,
   "event": "ordinary_request",
   "block": "birthday_party.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Bring socks for any kid who forgets them, and a list of parent phone numbers, just in case.",
   "est_sec": 5.68,
   "gap_before": 1.15,
   "role": "reply",
   "block": "birthday_party.dlg22"
  }
 ]
}
