 "est_total_sec": 54.98,
 "est_speech_sec": 41.4,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.72,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.79,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "My cat has started weeing on the bath mat instead of in her tray.",
   "est_sec": 4.44,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "pets.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "That's frustrating. The first step is a vet visit, because urinary problems are a really common cause.",
   "est_sec": 5.37,
   "gap_before": 1.14,
   "role": "reply",
   "block": "pets.dlg16"
  },
  {
   "speaker": "user",
   "text": "She seems healthy otherwise.",
   "est_sec": 1.34,
   "gap_before": 0.84,
   "event": "ordinary_request",
   "block": "pets.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Cats hide pain well, so it's still worth ruling out. If she's fine, then it's usually something about the tray.",
   "est_sec": 6.3,
   "gap_before": 1.1,
   "role": "reply",
   "block": "pets.dlg16"
  },
  {
   "speaker": "user",
   "text": "I did change the litter brand last week.",
   "est_sec": 2.58,
   "gap_before": 1.86,
   "event": "distractor",
   "kind": "pause",
   "block": "pets.dlg16"
  },
  {
   "speaker": "user",
   "text": "Because it was on offer.",
   "est_sec": 1.65,
   "gap_before": 2.26,
   "event": "ordinary_request",
   "block": "pets.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "That could be it. Cats can be really fussy about texture and smell. Go back to the old one and see if she returns.",
   "est_sec": 7.54,
   "gap_before": 1.13,
   "role": "reply",
   "block": "pets.dlg16"
  },
  {
   "speaker": "user",
   "text": "And should I clean the bath mat with bleach?",
   "est_sec": 2.89,
   "gap_before": 0.98,
   "event": "ordinary_request",
   "block": "pets.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Use an enzyme cleaner instead. Bleach can smell like urine to cats and might draw her back to the same spot.",
   "est_sec": 6.61,
   "gap_before": 0.8,
   "role": "reply",
   "block": "pets.dlg16"
  }
 ]
}
