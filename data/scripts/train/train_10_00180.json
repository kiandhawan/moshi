   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.48,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "I've got the grandkids all day Saturday. Four and seven.",
   "est_sec": 3.2,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "weekend_plans.ctx6"
  },
  {
   "speaker": "moshi",
   "text": "Lovely. The zoo would be a big day out, or the farm park is smaller and they can feed the goats. How much energy do you have?",
   "est_sec": 8.47,
   "gap_before": 0.85,
   "role": "reply",
   "block": "weekend_plans.ctx6"
  },
  {
   "speaker": "user",
   "text": "Hang on, I'm going to chat with my friend for a bit. Just wait until I say I'm back.",
   "est_sec": 5.99,
   "gap_before": 0.68,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_05"
  },
  {
   "speaker": "user",
   "text": "Why are you holding my controller like that?",
   "est_sec": 2.58,
   "gap_before": 1.1,
   "event": "distractor",
   "kind": "friend_question",
   "block": "video_games.side6"
  },
  {
   "speaker": "friend",
   "text": "I need a favour. There's this level with the moving platforms, I've died about fifty times.",
   "est_sec": 5.06,
   "gap_before": 0.94,
   "block": "video_games.side6"
  },
  {
   "speaker": "user",
   "text": "You want me to beat it for you?",
   "est_sec": 2.58,
   "gap_before": 1.22,
   "event": "distractor",
   "kind": "friend_question",
   "block": "video_games.side6"
  },
  {
   "speaker": "friend",
   "text": "Just this one. I'll do the rest myself, promise.",
   "est_sec": 2.89,
   "gap_before": 2.78,
   "block": "video_games.side6"
  },
  {
   "speaker": "user",
   "text": "Is that cheating?",
   "est_sec": 1.03,
   "gap_before": 0.96,
   "event": "distractor",
   "kind": "friend_question",
   "block": "video_games.side6"
  },
  {
   "speaker": "friend",
   "text": "It's teamwork.",
   "est_sec": 0.72,
   "gap_before": 1.18,
   "block": "video_games.side6"
  },
  {
   "speaker": "user",
   "text": "Fine. But you're making tea.",
   "est_sec": 1.65,
   "gap_before": 0.3,
   "block": "video_games.side6"
  },
  {
   "speaker": "friend",
   "text": "Done. Milk, no sugar?",
   "est_sec": 1.34,
   "gap_before": 0.35,
   "block": "video_games.side6"
  },
  {
   "speaker": "user",
   "text": "Alright, I'm back now.",
   "est_sec": 1.34,
   "gap_before": 0.84,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_02"
  },
  {
