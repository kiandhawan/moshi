 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.71,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.36,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "My dad keeps saying renting is throwing money away. Is he right?",
   "est_sec": 3.82,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "block": "moving_house.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Not entirely. Renting gives you flexibility and no repair bills, while buying builds equity but ties you down.",
   "est_sec": 5.68,
   "gap_before": 0.45,
   "role": "reply",
   "block": "moving_house.dlg20"
  },
  {
   "speaker": "user",
   "text": "I might move cities in a couple of years.",
   "est_sec": 2.89,
   "gap_before": 0.98,
   "event": "ordinary_request",
   "block": "moving_house.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Then renting often makes more sense. Buying and selling within a few years can cost more than you'd save.",
   "est_sec": 5.99,
   "gap_before": 1.17,
   "role": "reply",
   "block": "moving_house.dlg20"
  },
  {
   "speaker": "user",
   "text": "He'll still",
   "est_sec": 0.72,
   "gap_before": 0.73,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg20"
  },
  {
   "speaker": "user",
   "text": "say I'm wasting money.",
   "est_sec": 1.34,
   "gap_before": 2.66,
   "event": "ordinary_request",
   "block": "moving_house.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "You could tell him you're paying for flexibility. That's worth something too.",
   "est_sec": 3.82,
   "gap_before": 0.62,
   "role": "reply",
   "block": "moving_house.dlg20"
  },
  {
   "speaker": "user",
   "text": "And if I want to buy eventually?",
   "est_sec": 2.27,
   "gap_before": 3.19,
   "event": "ordinary_request",
   "block": "moving_house.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Start saving for a deposit now while you rent. Then you'll have options when you decide to settle.",
   "est_sec": 5.68,
   "gap_before": 1.11,
   "role": "reply",
   "block": "moving_house.dlg20"
  }
 ]
