 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.42,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.98,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "The paint is peeling off my window frames outside. Do I need to strip all of it?",
   "est_sec": 5.37,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "home_repair.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Not necessarily all. Scrape off anything loose or flaky until you hit paint that's firmly stuck.",
   "est_sec": 5.06,
   "gap_before": 0.76,
   "role": "reply",
   "block": "home_repair.dlg30"
  },
  {
   "speaker": "user",
   "text": "Then sand?",
   "est_sec": 0.72,
   "gap_before": 0.75,
   "event": "ordinary_request",
   "block": "home_repair.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Yes, sand the edges so there's no ridge, then fill any cracks in the wood with exterior filler.",
   "est_sec": 5.68,
   "gap_before": 0.45,
   "role": "reply",
   "block": "home_repair.dlg30"
  },
  {
   "speaker": "user",
   "text": "Is there special paint for outside?",
   "est_sec": 1.96,
   "gap_before": 1.25,
   "event": "ordinary_request",
   "block": "home_repair.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Use an exterior wood paint, and a primer on any bare wood. It'll last much longer against the rain.",
   "est_sec": 5.99,
   "gap_before": 1.42,
   "role": "reply",
   "block": "home_repair.dlg30"
  },
  {
   "speaker": "user",
   "text": "My house is",
   "est_sec": 1.03,
   "gap_before": 1.34,
   "event": "distractor",
   "kind": "pause",
   "block": "home_repair.dlg30"
  },
  {
   "speaker": "user",
   "text": "pretty close to the sea. Does that matter?",
   "est_sec": 2.58,
   "gap_before": 1.99,
   "event": "ordinary_request",
   "block": "home_repair.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "It does. Salt air is tough on paint, so pick a high quality marine or coastal grade product if you can.",
   "est_sec": 6.61,
   "gap_before": 0.47,
   "role": "reply",
   "block": "home_repair.dlg30"
  }
 ]
}
