 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.64,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.36,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "I'm setting up a phone for my mom. She's not great with tech. Any tips?",
   "est_sec": 4.75,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "smartphones.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Make the text and icons bigger in the display settings first. That alone helps a lot.",
   "est_sec": 5.06,
   "gap_before": 0.33,
   "role": "reply",
   "block": "smartphones.dlg2"
  },
  {
   "speaker": "user",
   "text": "Good one. What else?",
   "est_sec": 1.34,
   "gap_before": 1.08,
   "event": "ordinary_request",
   "block": "smartphones.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Put just the apps she uses on the home screen, like calls, messages and photos. Hide the rest in a folder.",
   "est_sec": 6.61,
   "gap_before": 0.64,
   "role": "reply",
   "block": "smartphones.dlg2"
  },
  {
   "speaker": "user",
   "text": "She always",
   "est_sec": 0.72,
   "gap_before": 0.43,
   "event": "distractor",
   "kind": "pause",
   "block": "smartphones.dlg2"
  },
  {
   "speaker": "user",
   "text": "ends up calling people by accident from her pocket.",
   "est_sec": 2.89,
   "gap_before": 2.54,
   "event": "ordinary_request",
   "block": "smartphones.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "A simple case with a flip cover can stop that. You could also shorten the screen timeout so it locks sooner.",
   "est_sec": 6.61,
   "gap_before": 1.07,
   "role": "reply",
   "block": "smartphones.dlg2"
  },
  {
   "speaker": "user",
   "text": "Oh, and can I help her from my own phone if she's stuck?",
   "est_sec": 4.13,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "smartphones.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Yes, a screen sharing app lets you see her screen and guide her. Set it up together before you hand the phone over.",
   "est_sec": 7.23,
   "gap_before": 1.23,
   "role": "reply",
   "block": "smartphones.dlg2"
  },
  {
   "speaker": "user",
   "text": "Perfect, I'll do that this weekend.",
   "est_sec": 1.96,
   "gap_before": 1.15,
   "block": "smartphones.dlg2"
  }
 ]
