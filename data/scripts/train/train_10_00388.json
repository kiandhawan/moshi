   "text": "Sometime between ten and twelve.",
   "est_sec": 1.65,
   "gap_before": 0.96,
   "phrasing": "dq_57"
  },
  {
   "speaker": "user",
   "text": "Can you take the dog out tonight? I have to work late.",
