 "est_total_sec": 64.83,
 "est_speech_sec": 47.8,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.68,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.37,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "I'm visiting a big city next week and I've never used a subway before. Any tips?",
   "est_sec": 5.06,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "public_transport.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Download the city's transit app before you go. It shows routes, live times and which exit to use.",
   "est_sec": 5.68,
   "gap_before": 0.58,
   "role": "reply",
   "block": "public_transport.dlg1"
  },
  {
   "speaker": "user",
   "text": "How do I know",
   "est_sec": 1.34,
   "gap_before": 2.74,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg1"
  },
  {
   "speaker": "user",
   "text": "which direction to go?",
   "est_sec": 1.34,
   "gap_before": 2.97,
   "event": "ordinary_request",
   "block": "public_transport.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Platforms are usually labeled by the last station on the line. Find your stop on the map, then follow signs for the end station in that direction.",
   "est_sec": 8.47,
   "gap_before": 1.0,
   "role": "reply",
   "block": "public_transport.dlg1"
  },
  {
   "speaker": "user",
   "text": "That makes sense. What about rush hour?",
   "est_sec": 2.27,
   "gap_before": 1.26,
   "event": "ordinary_request",
   "block": "public_transport.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Try to avoid roughly seven to nine in the morning and five to seven in the evening. If you can't, stand to the side and let people off first.",
   "est_sec": 9.09,
   "gap_before": 0.59,
   "role": "reply",
   "block": "public_transport.dlg1"
  },
  {
   "speaker": "user",
   "text": "Hold on, really?",
   "est_sec": 1.03,
   "gap_before": 1.36,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_11",
   "block": "public_transport.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Good to question it. I still think it's right, though you know your situation best.",
   "est_sec": 4.75,
   "gap_before": 1.05,
   "role": "reply",
   "block": "public_transport.dlg1"
  },
  {
   "speaker": "user",
   "text": "Okay, thanks. I feel less nervous now.",
   "est_sec": 2.27,
   "gap_before": 1.42,
   "event": "ordinary_request",
   "block": "public_transport.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "You'll do great. Most people figure it out after one or two rides.",
   "est_sec": 4.13,
   "gap_before": 1.07,
   "role": "reply",
   "block": "public_transport.dlg1"
  }
 ]
}
