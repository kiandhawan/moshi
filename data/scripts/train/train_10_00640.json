 "est_speech_sec": 42.22,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.93,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "It's going to be thirty-four degrees this week. Is it stupid to run in that?",
   "est_sec": 4.75,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "fitness.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Not stupid, but you have to be careful. Run early in the morning or late in the evening when it's cooler.",
   "est_sec": 6.61,
   "gap_before": 1.15,
   "role": "reply",
   "block": "fitness.dlg9"
  },
  {
   "speaker": "user",
   "text": "I usually go at lunch.",
   "est_sec": 1.65,
   "gap_before": 1.78,
   "event": "ordinary_request",
   "block": "fitness.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "I'd skip lunch runs this week. Midday heat is when it's most risky.",
   "est_sec": 4.13,
   "gap_before": 0.92,
   "role": "reply",
   "block": "fitness.dlg9"
  },
  {
   "speaker": "user",
   "text": "What about water?",
   "est_sec": 1.03,
   "gap_before": 1.2,
   "event": "ordinary_request",
   "block": "fitness.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Drink before you go and take some with you if you're out longer than half an hour. Wear light, loose clothing.",
   "est_sec": 6.61,
   "gap_before": 0.32,
   "role": "reply",
   "block": "fitness.dlg9"
  },
  {
   "speaker": "user",
   "text": "How do I know if I'm",
   "est_sec": 1.96,
   "gap_before": 0.42,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg9"
  },
  {
   "speaker": "user",
   "text": "overdoing it?",
   "est_sec": 0.72,
   "gap_before": 1.7,
   "event": "ordinary_request",
   "block": "fitness.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Dizziness, a headache, feeling sick or stopping sweating are warning signs. Stop, find shade and cool down right away.",
   "est_sec": 5.99,
   "gap_before": 0.31,
   "role": "reply",
   "block": "fitness.dlg9"
  },
  {
   "speaker": "user",
   "text": "Got it. Early mornings then.",
   "est_sec": 1.65,
   "gap_before": 0.71,
   "event": "ordinary_request",
   "block": "fitness.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Slow down a little too. Heat makes every pace feel harder.",
   "est_sec": 3.51,
   "gap_before": 0.31,
   "role": "reply",
   "block": "fitness.dlg9"
  }
 ]
}
