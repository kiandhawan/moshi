   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "home_repair.ctx3"
  },
  {
   "speaker": "moshi",
   "text": "The wood is probably swelling. You could tighten the hinges first or plane down the edge. Where would you like to start?",
   "est_sec": 6.92,
   "gap_before": 0.37,
   "role": "reply",
   "block": "home_repair.ctx3"
  },
  {
   "speaker": "user",
   "text": "Not sure yet. Check back with me in twenty seconds.",
