 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.32,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.33,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "Should I get a library card or just keep buying books? I spend a fortune.",
   "est_sec": 4.75,
   "gap_before": 0.23,
   "event": "ordinary_request",
   "block": "books.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "A library card is free and most libraries now lend e-books and audiobooks too, right from your phone.",
   "est_sec": 5.68,
   "gap_before": 1.08,
   "role": "reply",
   "block": "books.dlg22"
  },
  {
   "speaker": "user",
   "text": "The waiting lists are huge though.",
   "est_sec": 1.96,
   "gap_before": 1.29,
   "event": "ordinary_request",
   "block": "books.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "True for new bestsellers. You can put holds on several at once, so something is always arriving.",
   "est_sec": 5.37,
   "gap_before": 0.73,
   "role": "reply",
   "block": "books.dlg22"
  },
  {
   "speaker": "user",
   "text": "I do like owning books.",
   "est_sec": 1.65,
   "gap_before": 2.9,
   "event": "ordinary_request",
   "block": "books.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Then try a mix. Borrow first, and only buy the ones you loved enough to want to keep.",
   "est_sec": 5.68,
   "gap_before": 0.86,
   "role": "reply",
   "block": "books.dlg22"
  },
  {
   "speaker": "user",
   "text": "That would cut my spending in half, probably.",
   "est_sec": 2.58,
   "gap_before": 1.79,
   "event": "ordinary_request",
   "block": "books.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Probably more. And the books you buy will feel more special.",
   "est_sec": 3.51,
   "gap_before": 0.82,
   "role": "reply",
   "block": "books.dlg22"
  }
 ]
}
