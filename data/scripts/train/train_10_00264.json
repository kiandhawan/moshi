   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.66,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "My old boots finally fell apart.",
   "est_sec": 1.96,
   "gap_before": 0.26,
   "event": "ordinary_request",
   "block": "hiking.ctx2"
  },
  {
   "speaker": "moshi",
   "text": "Time for new ones. Do you want proper leather boots with ankle support, or lighter trail shoes?",
   "est_sec": 5.37,
   "gap_before": 1.2,
   "role": "reply",
   "block": "hiking.ctx2"
  },
  {
   "speaker": "user",
   "text": "Sorry, can you wait? My friend is talking to me. Keep quiet until I come back.",
   "est_sec": 5.06,
   "gap_before": 1.45,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_17"
  },
  {
   "speaker": "user",
   "text": "Omar, did you pay the electric bill this month or was it my turn?",
   "est_sec": 4.44,
   "gap_before": 0.67,
   "event": "distractor",
   "kind": "friend_question",
   "block": "personal_finance.side1"
  },
  {
   "speaker": "friend",
   "text": "I paid it last month, so it's yours.",
   "est_sec": 2.58,
   "gap_before": 0.53,
   "block": "personal_finance.side1"
  },
  {
   "speaker": "user",
   "text": "Right. How much was it again?",
   "est_sec": 1.96,
   "gap_before": 1.72,
   "event": "distractor",
   "kind": "friend_question",
   "block": "personal_finance.side1"
  },
  {
   "speaker": "friend",
   "text": "Around ninety, I think. It went up because of the heater.",
   "est_sec": 3.51,
   "gap_before": 0.78,
   "block": "personal_finance.side1"
  },
  {
   "speaker": "user",
   "text": "Okay, I'll send you half of the internet too while I'm at it.",
   "est_sec": 4.13,
   "gap_before": 0.78,
   "block": "personal_finance.side1"
  },
  {
   "speaker": "friend",
   "text": "Thanks, no rush.",
   "est_sec": 1.03,
   "gap_before": 1.26,
   "block": "personal_finance.side1"
  },
  {
   "speaker": "user",
   "text": "I'm back on Tuesday, by the way.",
   "est_sec": 2.27,
   "gap_before": 1.02,
   "event": "distractor",
   "kind": "near_miss",
   "phrasing": "dn_04"
  },
  {
   "speaker": "friend",
   "text": "Okay, good to know.",
   "est_sec": 1.34,
   "gap_before": 0.69,
   "phrasing": "dn_04"
  },
  {
   "speaker": "user",
   "text": "Done. I'm back now.",
