 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.63,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "We just got a border collie. How much exercise does she actually need?",
   "est_sec": 4.13,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "pets.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "A lot. Most collies want a couple of hours of activity a day, and just as importantly, things for their brain to do.",
   "est_sec": 7.23,
   "gap_before": 1.06,
   "role": "reply",
   "block": "pets.dlg7"
  },
  {
   "speaker": "user",
   "text": "Two hours? We both work.",
   "est_sec": 1.65,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "pets.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "It doesn't all have to be walking. Training games, sniffing hunts and puzzle toys tire them out surprisingly well.",
   "est_sec": 5.99,
   "gap_before": 1.13,
   "role": "reply",
   "block": "pets.dlg7"
  },
  {
   "speaker": "user",
   "text": "What happens if she doesn't get enough?",
   "est_sec": 2.27,
   "gap_before": 0.73,
   "event": "ordinary_request",
   "block": "pets.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Bored collies tend to invent their own jobs, like herding the kids, chewing furniture, or barking at everything.",
   "est_sec": 5.68,
   "gap_before": 0.56,
   "role": "reply",
   "block": "pets.dlg7"
  },
  {
   "speaker": "user",
   "text": "She already herds my son.",
   "est_sec": 1.65,
   "gap_before": 1.35,
   "event": "distractor",
   "kind": "pause",
   "block": "pets.dlg7"
  },
  {
   "speaker": "user",
   "text": "He thinks it's hilarious.",
   "est_sec": 1.34,
   "gap_before": 2.49,
   "event": "ordinary_request",
   "block": "pets.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "It's sweet now, but nipping at heels can grow into a habit. Give her a proper outlet, like fetch or a beginner agility class.",
   "est_sec": 7.54,
   "gap_before": 1.17,
   "role": "reply",
   "block": "pets.dlg7"
  }
 ]
}
