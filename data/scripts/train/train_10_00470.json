 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.37,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "My shins hurt every time I run. A sharp ache along the front.",
   "est_sec": 4.13,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "fitness.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "That sounds like it could be shin splints, which is common when people increase their running too quickly.",
   "est_sec": 5.68,
   "gap_before": 1.61,
   "role": "reply",
   "block": "fitness.dlg17"
  },
  {
   "speaker": "user",
   "text": "I did go from twice a week to five times.",
   "est_sec": 3.2,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "fitness.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "That's probably it. Cut back for a while and let them settle.",
   "est_sec": 3.82,
   "gap_before": 1.11,
   "role": "reply",
   "block": "fitness.dlg17"
  },
  {
   "speaker": "user",
   "text": "Ice? Rest? I've heard both.",
   "est_sec": 1.65,
   "gap_before": 1.14,
   "event": "ordinary_request",
   "block": "fitness.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Both help. Ice for fifteen minutes after activity, and rest from running for a week or two. Swimming or cycling keep you fit meanwhile.",
   "est_sec": 7.54,
   "gap_before": 0.39,
   "role": "reply",
   "block": "fitness.dlg17"
  },
  {
   "speaker": "user",
   "text": "Do my shoes",
   "est_sec": 1.03,
   "gap_before": 1.28,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg17"
  },
  {
   "speaker": "user",
   "text": "have anything to do with it?",
   "est_sec": 1.96,
   "gap_before": 2.07,
   "event": "ordinary_request",
   "block": "fitness.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "They can. If they're worn out, replace them. And if the pain doesn't improve after a couple of weeks, see a doctor or physio.",
   "est_sec": 7.54,
   "gap_before": 0.58,
   "role": "reply",
   "block": "fitness.dlg17"
  }
 ]
}
