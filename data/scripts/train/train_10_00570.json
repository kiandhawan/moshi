  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.32,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.72,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "I'm forty-five and I've always wanted to learn an instrument. Is it too late?",
   "est_sec": 4.44,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "music.ctx1"
  },
  {
   "speaker": "moshi",
   "text": "Not at all, adults learn quickly because they practice with purpose. Are you drawn more to the guitar, the piano, or something else?",
   "est_sec": 7.23,
   "gap_before": 0.43,
   "role": "reply",
   "block": "music.ctx1"
  },
  {
   "speaker": "user",
   "text": "Wait a moment, my coworker is here. Please be quiet until I tell you I'm back.",
   "est_sec": 5.06,
   "gap_before": 0.53,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_14"
  },
  {
   "speaker": "moshi",
   "text": "Sure thing.",
   "est_sec": 0.72,
   "gap_before": 0.33,
   "role": "ack",
   "phrasing": "ack_12"
  },
  {
   "speaker": "user",
   "text": "Can I borrow your jacket tomorrow?",
   "est_sec": 1.96,
   "gap_before": 0.67,
   "event": "distractor",
   "kind": "friend_question",
   "phrasing": "dq_22"
  },
  {
   "speaker": "friend",
   "text": "Sure, just bring it back.",
   "est_sec": 1.65,
   "gap_before": 0.41,
   "phrasing": "dq_22"
  },
  {
   "speaker": "user",
   "text": "Wait, can you trade with someone who isn't next to you?",
   "est_sec": 3.51,
   "gap_before": 0.56,
   "event": "distractor",
   "kind": "friend_question",
   "block": "board_games.side2"
  },
  {
   "speaker": "friend",
   "text": "I think you can trade with anyone on your turn. Let me check the rule book.",
   "est_sec": 5.06,
   "gap_before": 0.52,
   "block": "board_games.side2"
  },
  {
   "speaker": "user",
   "text": "Because I really need wood.",
   "est_sec": 1.65,
   "gap_before": 1.08,
   "block": "board_games.side2"
  },
  {
   "speaker": "friend",
   "text": "Yeah, it says any player. But I'm not giving you wood.",
   "est_sec": 3.51,
   "gap_before": 0.88,
   "block": "board_games.side2"
  },
  {
   "speaker": "user",
   "text": "Come on, I'll give you two sheep for it.",
   "est_sec": 2.89,
   "gap_before": 0.61,
   "block": "board_games.side2"
  },
  {
   "speaker": "friend",
   "text": "Three sheep and you've got a deal.",
   "est_sec": 2.27,
   "gap_before": 1.27,
   "block": "board_games.side2"
  },
  {
   "speaker": "user",
   "text": "Fine, three.",
   "est_sec": 0.72,
   "gap_before": 1.1,
   "block": "board_games.side2"
  },
