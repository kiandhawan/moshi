 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.37,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "It might rain on Saturday and we need to pick a plan for the kids.",
   "est_sec": 4.75,
   "gap_before": 0.25,
   "block": "weather_plans.opt1"
  },
  {
   "speaker": "user",
   "text": "Let me get through all the options before you weigh in.",
   "est_sec": 3.51,
   "gap_before": 0.54,
   "event": "instruction",
   "kind": "describe_options",
   "phrasing": "describe_instr_10"
  },
  {
   "speaker": "moshi",
   "text": "No problem.",
   "est_sec": 0.72,
   "gap_before": 0.52,
   "role": "ack",
   "phrasing": "ack_04"
  },
  {
   "speaker": "user",
   "text": "The first idea is the zoo, which is fun but mostly outdoors.",
   "est_sec": 3.82,
   "gap_before": 0.96,
   "block": "weather_plans.opt1",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "Then there's the science museum, all indoors, but it gets really crowded on rainy days.",
   "est_sec": 4.75,
   "gap_before": 2.92,
   "block": "weather_plans.opt1",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "And the last one is staying in with a fort, board games and a movie marathon.",
   "est_sec": 5.06,
   "gap_before": 2.66,
   "block": "weather_plans.opt1"
  },
  {
   "speaker": "user",
   "text": "And that's the last one. What do you think?",
   "est_sec": 2.89,
   "gap_before": 0.99,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "describe_cue_11"
  },
  {
   "speaker": "moshi",
   "text": "The science museum is safe from the rain, but expect crowds since everyone else will have the same idea. The zoo could be great if the rain holds off, and it might even be quieter. Staying in is cozy and cheap, but kids can get restless.",
   "est_sec": 14.36,
   "gap_before": 1.24,
   "role": "resume",
   "block": "weather_plans.opt1"
  }
 ]
