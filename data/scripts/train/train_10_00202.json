 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.92,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "I spend two hours a day on the train and I can never get any work done.",
   "est_sec": 5.37,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "public_transport.ctx10"
  },
  {
   "speaker": "moshi",
   "text": "That's a lot of lost time. You could pay for the quiet carriage upgrade, or keep standard and try noise cancelling headphones. Which sounds better?",
   "est_sec": 7.85,
   "gap_before": 0.83,
   "role": "reply",
   "block": "public_transport.ctx10"
  },
  {
   "speaker": "user",
   "text": "Hold on, I need to talk to my roommate for a second. Stay quiet until I say I'm back.",
   "est_sec": 5.99,
   "gap_before": 1.38,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_01"
  },
  {
   "speaker": "moshi",
   "text": "No problem.",
   "est_sec": 0.72,
   "gap_before": 0.63,
   "role": "ack",
   "phrasing": "ack_04"
  },
  {
   "speaker": "user",
   "text": "Want me to make you a tea while I'm up?",
   "est_sec": 3.2,
   "gap_before": 1.16,
   "event": "distractor",
   "kind": "friend_question",
   "phrasing": "dq_49"
  },
  {
   "speaker": "friend",
   "text": "Oh, yes please, no sugar.",
   "est_sec": 1.65,
   "gap_before": 1.06,
   "phrasing": "dq_49"
  },
  {
   "speaker": "user",
   "text": "Wait, can you trade with someone who isn't next to you?",
   "est_sec": 3.51,
   "gap_before": 0.98,
   "event": "distractor",
   "kind": "friend_question",
   "block": "board_games.side2"
  },
  {
   "speaker": "friend",
   "text": "I think you can trade with anyone on your turn. Let me check the rule book.",
   "est_sec": 5.06,
   "gap_before": 1.33,
   "block": "board_games.side2"
  },
  {
   "speaker": "user",
   "text": "Because I really need wood.",
   "est_sec": 1.65,
   "gap_before": 0.39,
   "block": "board_games.side2"
  },
  {
   "speaker": "friend",
   "text": "Yeah, it says any player. But I'm not giving you wood.",
   "est_sec": 3.51,
   "gap_before": 0.87,
   "block": "board_games.side2"
  },
  {
   "speaker": "user",
   "text": "Come on, I'll give you two sheep for it.",
   "est_sec": 2.89,
   "gap_before": 1.21,
   "block": "board_games.side2"
  },
  {
   "speaker": "friend",
   "text": "Three sheep and you've got a deal.",
   "est_sec": 2.27,
   "gap_before": 0.52,
   "block": "board_games.side2"
  },
  {
   "speaker": "user",
   "text": "Fine, three.",
   "est_sec": 0.72,
   "gap_before": 0.41,
   "block": "board_games.side2"
  },
  {
   "speaker": "user",
   "text": "Sorry, I'm back now. Go ahead.",
