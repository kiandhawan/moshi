 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.49,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.41,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "I've got way too much stuff for the new place. It's half the size.",
   "est_sec": 4.44,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "moving_house.ctx3"
  },
  {
   "speaker": "moshi",
   "text": "That's common when downsizing. Would you rather sell the extra furniture, or donate it and get it out quickly?",
   "est_sec": 5.99,
   "gap_before": 0.31,
   "role": "reply",
   "block": "moving_house.ctx3"
  },
  {
   "speaker": "user",
   "text": "Hang on, I'm going to chat with my friend for a bit. Just wait until I say I'm back.",
   "est_sec": 5.99,
   "gap_before": 1.37,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_05"
  },
  {
   "speaker": "moshi",
   "text": "Got it.",
   "est_sec": 0.72,
   "gap_before": 0.23,
   "role": "ack",
   "phrasing": "ack_07"
  },
  {
   "speaker": "user",
   "text": "Grace, are you back already?",
   "est_sec": 1.65,
   "gap_before": 0.88,
   "event": "distractor",
   "kind": "near_miss",
   "phrasing": "dn_02"
  },
  {
   "speaker": "friend",
   "text": "Yeah, the store was quick.",
   "est_sec": 1.65,
   "gap_before": 0.63,
   "phrasing": "dn_02"
  },
  {
   "speaker": "user",
   "text": "Should we bring the patio chairs inside? It's getting really windy.",
   "est_sec": 3.51,
   "gap_before": 0.73,
   "block": "weather_plans.side2"
  },
  {
   "speaker": "friend",
   "text": "Probably. One of them blew into the fence last time.",
   "est_sec": 3.2,
   "gap_before": 1.92,
   "block": "weather_plans.side2"
  },
  {
   "speaker": "user",
   "text": "Right, I forgot about that. Can you grab the cushions?",
   "est_sec": 3.2,
   "gap_before": 1.0,
   "event": "distractor",
   "kind": "friend_question",
   "block": "weather_plans.side2"
  },
  {
   "speaker": "friend",
   "text": "Sure. Where do you want them, the garage?",
   "est_sec": 2.58,
   "gap_before": 2.84,
   "block": "weather_plans.side2"
  },
  {
   "speaker": "user",
   "text": "Yeah, on the shelf by the bikes.",
   "est_sec": 2.27,
   "gap_before": 3.04,
   "block": "weather_plans.side2"
  },
  {
   "speaker": "user",
   "text": "Back again. What were we talking about?",
   "est_sec": 2.27,
   "gap_before": 1.4,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_05"
  },
  {
   "speaker": "moshi",
   "text": "Sure thing. Have you thought about the furniture that won't fit?",
   "est_sec": 3.51,
   "gap_before": 0.81,
   "role": "resume",
   "block": "moving_house.ctx3"
  },
  {
   "speaker": "user",
   "text": "Donate it all. I don't want the hassle of strangers coming round.",
