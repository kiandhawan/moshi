 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.64,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.59,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "What does aperture actually mean? I keep reading it and nodding.",
   "est_sec": 3.51,
   "gap_before": 0.21,
   "event": "ordinary_request",
   "block": "photography.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "It's the size of the opening in the lens that lets light in. A wide opening means more light and a blurrier background.",
   "est_sec": 7.23,
   "gap_before": 0.44,
   "role": "reply",
   "block": "photography.dlg2"
  },
  {
   "speaker": "user",
   "text": "And the numbers, like f two?",
   "est_sec": 1.96,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "photography.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Confusingly, smaller numbers mean a wider opening. So f two gives a soft background, and f eleven keeps everything sharp.",
   "est_sec": 6.3,
   "gap_before": 1.03,
   "role": "reply",
   "block": "photography.dlg2"
  },
  {
   "speaker": "user",
   "text": "So for a portrait I'd want",
   "est_sec": 1.96,
   "gap_before": 1.23,
   "event": "distractor",
   "kind": "pause",
   "block": "photography.dlg2"
  },
  {
   "speaker": "user",
   "text": "the small number?",
   "est_sec": 1.03,
   "gap_before": 1.97,
   "event": "ordinary_request",
   "block": "photography.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. For a landscape where you want the whole scene sharp, go with a bigger number like f eight.",
   "est_sec": 5.99,
   "gap_before": 1.09,
   "role": "reply",
   "block": "photography.dlg2"
  },
  {
   "speaker": "user",
   "text": "Got it. That makes way more sense now.",
   "est_sec": 2.58,
   "gap_before": 1.37,
   "block": "photography.dlg2"
  }
 ]
}
