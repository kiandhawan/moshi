 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.38,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.74,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "My lawn has yellow patches all over. What's going on?",
   "est_sec": 3.2,
   "gap_before": 0.6,
   "event": "ordinary_request",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Common causes are dry weather, dog pee or grubs in the soil. Do you have a dog?",
   "est_sec": 5.37,
   "gap_before": 1.08,
   "role": "reply",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "user",
   "text": "Yeah, a big one.",
   "est_sec": 1.34,
   "gap_before": 0.61,
   "event": "ordinary_request",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "That's likely it then. Watering the spot right after the dog goes can dilute it and stop the burn.",
   "est_sec": 5.99,
   "gap_before": 1.18,
   "role": "reply",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "user",
   "text": "I can't follow him around with a watering can all day.",
   "est_sec": 3.51,
   "gap_before": 3.45,
   "event": "ordinary_request",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Fair. You could train him to use one corner of the garden, or reseed the patches in spring.",
   "est_sec": 5.68,
   "gap_before": 1.16,
   "role": "reply",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "user",
   "text": "Reseeding sounds easier. Do I just",
   "est_sec": 1.96,
   "gap_before": 0.73,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "user",
   "text": "throw seeds on top?",
   "est_sec": 1.34,
   "gap_before": 2.96,
   "event": "ordinary_request",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Rake the patch first to loosen the soil, then sprinkle the seed and keep it moist for two weeks.",
   "est_sec": 5.99,
   "gap_before": 0.83,
   "role": "reply",
   "block": "gardening.dlg4"
  }
 ]
}
