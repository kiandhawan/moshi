 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.54,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.93,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "I'm thinking of doing a little day trip on Sunday. Somewhere I can get to by train.",
   "est_sec": 5.37,
   "gap_before": 0.21,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Sounds fun. Do you prefer the seaside, a historic town, or countryside walks?",
   "est_sec": 4.13,
   "gap_before": 0.7,
   "role": "reply",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "user",
   "text": "Seaside, I think. I haven't seen the sea in ages.",
   "est_sec": 3.2,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Then pick a coastal town within about two hours by train. Leave early so you get a full day there.",
   "est_sec": 6.3,
   "gap_before": 0.48,
   "role": "reply",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "user",
   "text": "What if the weather's bad?",
   "est_sec": 1.65,
   "gap_before": 2.01,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Seaside towns are still nice in grey weather. A cozy cafe, the pier, maybe an aquarium if there's one.",
   "est_sec": 5.99,
   "gap_before": 1.28,
   "role": "reply",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "user",
   "text": "Actually, I might",
   "est_sec": 1.03,
   "gap_before": 1.2,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "user",
   "text": "bring my sister along.",
   "est_sec": 1.34,
   "gap_before": 2.1,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Even better. Check if there's a two together railcard or group ticket, it can save you a lot.",
   "est_sec": 5.68,
   "gap_before": 0.82,
   "role": "reply",
   "block": "weekend_plans.dlg3"
  }
 ]
}
