 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.42,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.89,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "How late in the day can I drink coffee and still sleep?",
   "est_sec": 3.82,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "coffee.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Caffeine stays in your system for quite a while, about half of it is still there five or six hours later. Many people stop around early afternoon.",
   "est_sec": 8.47,
   "gap_before": 0.43,
   "role": "reply",
   "block": "coffee.dlg3"
  },
  {
   "speaker": "user",
   "text": "So no coffee after lunch?",
   "est_sec": 1.65,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "coffee.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "If you go to bed around eleven, try to have your last cup by about two. Everyone's a bit different though.",
   "est_sec": 6.61,
   "gap_before": 1.48,
   "role": "reply",
   "block": "coffee.dlg3"
  },
  {
   "speaker": "user",
   "text": "What about decaf? Is that",
   "est_sec": 1.65,
   "gap_before": 0.47,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg3"
  },
  {
   "speaker": "user",
   "text": "totally caffeine free?",
   "est_sec": 1.03,
   "gap_before": 2.81,
   "event": "ordinary_request",
   "block": "coffee.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Not totally, but close. A cup of decaf has only a tiny amount, so it's usually fine in the evening.",
   "est_sec": 6.3,
   "gap_before": 0.4,
   "role": "reply",
   "block": "coffee.dlg3"
  },
  {
   "speaker": "user",
   "text": "Great, decaf after dinner it is.",
   "est_sec": 1.96,
   "gap_before": 1.29,
   "event": "ordinary_request",
   "block": "coffee.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Sounds like a good compromise. You keep the taste without the sleepless night.",
   "est_sec": 4.13,
   "gap_before": 0.39,
   "role": "reply",
   "block": "coffee.dlg3"
  }
 ]
