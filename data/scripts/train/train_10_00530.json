 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.61,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.66,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "Do I really need a will? I'm only thirty.",
   "est_sec": 2.89,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "personal_finance.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "If you have anything you care about, or anyone who depends on you, it's a good idea at any age.",
   "est_sec": 6.3,
   "gap_before": 0.37,
   "role": "reply",
   "block": "personal_finance.dlg20"
  },
  {
   "speaker": "user",
   "text": "I don't have kids. Just a cat and a bit of savings.",
   "est_sec": 3.82,
   "gap_before": 1.15,
   "event": "ordinary_request",
   "block": "personal_finance.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Even then, a will lets you decide where your money goes, and who looks after the cat.",
   "est_sec": 5.37,
   "gap_before": 0.84,
   "role": "reply",
   "block": "personal_finance.dlg20"
  },
  {
   "speaker": "user",
   "text": "Ha. Okay, the cat point is convincing.",
   "est_sec": 2.27,
   "gap_before": 0.71,
   "event": "ordinary_request",
   "block": "personal_finance.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Simple wills aren't usually expensive. Some places even offer online templates or free will weeks with charities.",
   "est_sec": 5.37,
   "gap_before": 0.55,
   "role": "reply",
   "block": "personal_finance.dlg20"
  },
  {
   "speaker": "user",
   "text": "Do I need a lawyer?",
   "est_sec": 1.65,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "block": "personal_finance.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "For simple situations, a template can be enough if it's signed and witnessed properly. For anything complicated, a lawyer is safer.",
   "est_sec": 6.61,
   "gap_before": 1.92,
   "role": "reply",
   "block": "personal_finance.dlg20"
  }
 ]
}
