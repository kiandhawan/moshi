 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.55,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "I got a small bonus at work and I don't want to just blow it.",
   "est_sec": 4.75,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "personal_finance.ctx1"
  },
  {
   "speaker": "moshi",
   "text": "Nice! You could put it toward your credit card balance or start an emergency fund. Which matters more to you right now?",
   "est_sec": 6.92,
   "gap_before": 0.96,
   "role": "reply",
   "block": "personal_finance.ctx1"
  },
  {
   "speaker": "user",
   "text": "Hey, can you stay quiet for a minute? I need to talk to my partner. I'll come back to you.",
   "est_sec": 6.3,
   "gap_before": 1.11,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_10"
  },
  {
   "speaker": "moshi",
   "text": "Sure, take your time.",
   "est_sec": 1.34,
   "gap_before": 0.29,
   "role": "ack",
   "phrasing": "ack_03"
  },
  {
   "speaker": "user",
   "text": "Can you turn the music down a bit?",
   "est_sec": 2.58,
   "gap_before": 0.66,
   "event": "distractor",
   "kind": "friend_question",
   "phrasing": "dq_08"
  },
  {
   "speaker": "friend",
   "text": "Sure, sorry.",
   "est_sec": 0.72,
   "gap_before": 2.39,
   "phrasing": "dq_08"
  },
  {
   "speaker": "user",
   "text": "Can I ask you something? Do you actually stick to a budget?",
   "est_sec": 3.82,
   "gap_before": 1.18,
   "event": "distractor",
   "kind": "friend_question",
   "block": "personal_finance.side2"
  },
  {
   "speaker": "friend",
   "text": "Kind of. I give myself a fixed amount for eating out and that's the only rule.",
   "est_sec": 5.06,
   "gap_before": 1.38,
   "block": "personal_finance.side2"
  },
  {
   "speaker": "user",
   "text": "That's it? Just one rule?",
   "est_sec": 1.65,
   "gap_before": 3.24,
   "event": "distractor",
   "kind": "friend_question",
   "block": "personal_finance.side2"
  },
  {
   "speaker": "friend",
   "text": "Yeah. Rent and bills come out automatically, savings too, so the only thing I can mess up is food.",
   "est_sec": 5.99,
   "gap_before": 0.87,
   "block": "personal_finance.side2"
  },
  {
   "speaker": "user",
   "text": "Huh. Maybe I'm overthinking mine.",
   "est_sec": 1.65,
   "gap_before": 2.81,
   "block": "personal_finance.side2"
  },
  {
   "speaker": "friend",
   "text": "You definitely are. You had like twenty categories.",
   "est_sec": 2.58,
   "gap_before": 0.77,
   "block": "personal_finance.side2"
  },
  {
   "speaker": "user",
   "text": "I'm here again, let's continue.",
   "est_sec": 1.65,
   "gap_before": 1.16,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_07"
  },
