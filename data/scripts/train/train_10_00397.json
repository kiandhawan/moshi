 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.4,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.95,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "Should I live alone or keep sharing? I'm twenty six and kind of over flatmates.",
   "est_sec": 4.75,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "moving_house.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Depends on your budget and personality. Living alone gives you peace and control, but costs more and can feel lonely.",
   "est_sec": 6.3,
   "gap_before": 1.01,
   "role": "reply",
   "block": "moving_house.dlg26"
  },
  {
   "speaker": "user",
   "text": "I'd probably have to move further out.",
   "est_sec": 2.27,
   "gap_before": 0.83,
   "event": "ordinary_request",
   "block": "moving_house.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "That's often the trade off. Would a longer commute bother you?",
   "est_sec": 3.51,
   "gap_before": 1.12,
   "role": "reply",
   "block": "moving_house.dlg26"
  },
  {
   "speaker": "user",
   "text": "A bit. But I'd",
   "est_sec": 1.34,
   "gap_before": 1.26,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg26"
  },
  {
   "speaker": "user",
   "text": "finally have my own kitchen.",
   "est_sec": 1.65,
   "gap_before": 2.11,
   "event": "ordinary_request",
   "block": "moving_house.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Then work out the full monthly cost, rent, bills and travel, and see if it still leaves you room to enjoy yourself.",
   "est_sec": 6.92,
   "gap_before": 0.49,
   "role": "reply",
   "block": "moving_house.dlg26"
  },
  {
   "speaker": "user",
   "text": "And if it doesn't?",
   "est_sec": 1.34,
   "gap_before": 1.49,
   "event": "ordinary_request",
   "block": "moving_house.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "A two person flat share could be the middle ground. Fewer people, less chaos, and cheaper than going solo.",
   "est_sec": 5.99,
   "gap_before": 0.36,
   "role": "reply",
   "block": "moving_house.dlg26"
  }
 ]
}
