 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.71,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.53,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "I'm trying to figure out which transit pass to buy for the month.",
   "est_sec": 4.13,
   "gap_before": 0.37,
   "block": "public_transport.opt2"
  },
  {
   "speaker": "user",
   "text": "Let me lay out all the options first. Don't interrupt.",
   "est_sec": 3.2,
   "gap_before": 0.41,
   "event": "instruction",
   "kind": "describe_options",
   "phrasing": "describe_instr_14"
  },
  {
   "speaker": "user",
   "text": "One option is a monthly unlimited pass, which pays off if I ride more than about twice a day.",
   "est_sec": 5.99,
   "gap_before": 1.34,
   "block": "public_transport.opt2",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "Another is a pay as you go card, which is cheaper if I only ride a few times a week.",
   "est_sec": 6.3,
   "gap_before": 1.86,
   "block": "public_transport.opt2",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "Or there's a weekly pass, which I could buy only for the weeks I'm busy.",
   "est_sec": 4.75,
   "gap_before": 2.62,
   "block": "public_transport.opt2"
  },
  {
   "speaker": "user",
   "text": "Done. What would you recommend?",
   "est_sec": 1.65,
   "gap_before": 0.85,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "describe_cue_10"
  },
  {
   "speaker": "moshi",
   "text": "How many days a week do you usually ride? If it's four or five, get the monthly pass. If it's only one or two, pay as you go is the way to go.",
   "est_sec": 10.33,
   "gap_before": 0.87,
   "role": "resume",
   "block": "public_transport.opt2"
  }
 ]
