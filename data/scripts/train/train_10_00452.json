 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.41,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.58,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "How do I stop impulse buying online? My cart is always full of random stuff.",
   "est_sec": 4.75,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "shopping.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Try a waiting rule. Leave things in the cart for two days before buying, and see if you still want them.",
   "est_sec": 6.61,
   "gap_before": 0.6,
   "role": "reply",
   "block": "shopping.dlg4"
  },
  {
   "speaker": "user",
   "text": "That's smart. Most of it I'd forget about.",
   "est_sec": 2.58,
   "gap_before": 1.25,
   "event": "ordinary_request",
   "block": "shopping.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "That's the idea. It also helps to remove your saved card so checkout takes a bit more effort.",
   "est_sec": 5.68,
   "gap_before": 0.94,
   "role": "reply",
   "block": "shopping.dlg4"
  },
  {
   "speaker": "user",
   "text": "Ugh, but that's so annoying.",
   "est_sec": 1.65,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "shopping.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "That's kind of the point. And unsubscribe from store emails, the sales announcements are designed to make you click.",
   "est_sec": 5.99,
   "gap_before": 0.56,
   "role": "reply",
   "block": "shopping.dlg4"
  },
  {
   "speaker": "user",
   "text": "Okay, I'm going to",
   "est_sec": 1.34,
   "gap_before": 0.69,
   "event": "distractor",
   "kind": "pause",
   "block": "shopping.dlg4"
  },
  {
   "speaker": "user",
   "text": "actually, I'll start by deleting the shopping apps on my phone.",
   "est_sec": 3.51,
   "gap_before": 2.4,
   "event": "ordinary_request",
   "block": "shopping.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "That's a strong first step. You can always use the website when you really need something.",
   "est_sec": 5.06,
   "gap_before": 0.58,
   "role": "reply",
   "block": "shopping.dlg4"
  }
 ]
