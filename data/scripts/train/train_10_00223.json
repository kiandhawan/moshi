 "est_total_sec": 67.11,
 "est_speech_sec": 50.79,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.3,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.32,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "My mother used to make a soda bread when I was a boy, and I've never managed to get it the same.",
   "est_sec": 6.92,
   "gap_before": 0.51,
   "event": "ordinary_request",
   "block": "baking.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "That's a lovely thing to recreate. Do you remember anything about it, the texture or the crust?",
   "est_sec": 5.37,
   "gap_before": 0.78,
   "role": "reply",
   "block": "baking.dlg16"
  },
  {
   "speaker": "user",
   "text": "It had a hard crust with a cross cut in the top, and it was slightly sour.",
   "est_sec": 5.37,
   "gap_before": 2.8,
   "event": "ordinary_request",
   "block": "baking.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "The sourness probably came from buttermilk. A traditional soda bread is just flour, baking soda, salt and buttermilk.",
   "est_sec": 5.68,
   "gap_before": 0.49,
   "role": "reply",
   "block": "baking.dlg16"
  },
  {
   "speaker": "user",
   "text": "That's all? No butter, nothing?",
   "est_sec": 1.65,
   "gap_before": 1.02,
   "event": "ordinary_request",
   "block": "baking.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Nothing else. Mix it quickly with a light hand, shape a round, cut a deep cross, and bake it hot.",
   "est_sec": 6.3,
   "gap_before": 0.98,
   "role": "reply",
   "block": "baking.dlg16"
  },
  {
   "speaker": "user",
   "text": "Wait, are you sure about that?",
   "est_sec": 1.96,
   "gap_before": 0.83,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_08",
   "block": "baking.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Let me double-check. I'd still stand by it, but tell me what you heard.",
   "est_sec": 4.44,
   "gap_before": 0.7,
   "role": "reply",
   "block": "baking.dlg16"
  },
  {
   "speaker": "user",
   "text": "She did always say",
   "est_sec": 1.34,
   "gap_before": 0.85,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg16"
  },
  {
   "speaker": "user",
   "text": "not to fuss with it.",
   "est_sec": 1.65,
   "gap_before": 2.76,
   "event": "ordinary_request",
   "block": "baking.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "She was right. The less you handle it, the softer the inside.",
   "est_sec": 3.82,
   "gap_before": 0.78,
   "role": "reply",
   "block": "baking.dlg16"
  },
  {
   "speaker": "user",
   "text": "I'll try it Sunday.",
   "est_sec": 1.34,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "baking.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "I hope it tastes just like hers.",
   "est_sec": 2.27,
   "gap_before": 1.14,
   "role": "reply",
   "block": "baking.dlg16"
  }
 ]
}
