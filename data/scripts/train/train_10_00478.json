 "est_speech_sec": 35.2,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.36,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.63,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "I'm taking the airport train with two massive suitcases. Any tips?",
   "est_sec": 3.51,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "public_transport.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Board at the first carriage or the last one. They're usually quieter and closer to the luggage space.",
   "est_sec": 5.68,
   "gap_before": 1.29,
   "role": "reply",
   "block": "public_transport.dlg16"
  },
  {
   "speaker": "user",
   "text": "What if the racks are full?",
   "est_sec": 1.96,
   "gap_before": 1.42,
   "event": "ordinary_request",
   "block": "public_transport.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Keep the cases beside you with the brakes on, out of the aisle. Most people understand on an airport line.",
   "est_sec": 6.3,
   "gap_before": 0.4,
   "role": "reply",
   "block": "public_transport.dlg16"
  },
  {
   "speaker": "user",
   "text": "Do I need",
   "est_sec": 1.03,
   "gap_before": 3.25,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg16"
  },
  {
   "speaker": "user",
   "text": "to worry about the gap?",
   "est_sec": 1.65,
   "gap_before": 1.83,
   "event": "ordinary_request",
   "block": "public_transport.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Lift the cases rather than rolling them over it. And let people off before you try to get on, it's much easier with space.",
   "est_sec": 7.54,
   "gap_before": 0.72,
   "role": "reply",
   "block": "public_transport.dlg16"
  },
  {
   "speaker": "user",
   "text": "Thanks, this is my first big trip alone.",
   "est_sec": 2.58,
   "gap_before": 0.7,
   "event": "ordinary_request",
   "block": "public_transport.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "You'll be fine. Have a wonderful time.",
   "est_sec": 2.27,
   "gap_before": 0.56,
   "role": "reply",
   "block": "public_transport.dlg16"
  }
 ]
}
