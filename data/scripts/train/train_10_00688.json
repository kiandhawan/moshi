 "est_total_sec": 49.48,
 "est_speech_sec": 37.99,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.74,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.4,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "My teenagers hate sightseeing. How do I plan a city trip they won't sulk through?",
   "est_sec": 4.75,
   "gap_before": 0.26,
   "event": "ordinary_request",
   "block": "travel_planning.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Let each of them choose one thing for the trip. Ownership makes a huge difference with teens.",
   "est_sec": 5.37,
   "gap_before": 0.59,
   "role": "reply",
   "block": "travel_planning.dlg25"
  },
  {
   "speaker": "user",
   "text": "One of them will choose a shopping mall.",
   "est_sec": 2.58,
   "gap_before": 1.32,
   "event": "ordinary_request",
   "block": "travel_planning.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "That's okay. Balance it with activities that don't feel like sightseeing, like bike tours, food markets or a climbing park.",
   "est_sec": 6.3,
   "gap_before": 0.85,
   "role": "reply",
   "block": "travel_planning.dlg25"
  },
  {
   "speaker": "user",
   "text": "Food markets might work. They're always hungry.",
   "est_sec": 2.27,
   "gap_before": 1.34,
   "event": "ordinary_request",
   "block": "travel_planning.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Perfect, use that. A street food tour can feel more like an adventure than a museum.",
   "est_sec": 5.06,
   "gap_before": 0.95,
   "role": "reply",
   "block": "travel_planning.dlg25"
  },
  {
   "speaker": "user",
   "text": "And mornings? They",
   "est_sec": 1.03,
   "gap_before": 0.41,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg25"
  },
  {
   "speaker": "user",
   "text": "sleep until noon on holiday.",
   "est_sec": 1.65,
   "gap_before": 2.83,
   "event": "ordinary_request",
   "block": "travel_planning.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Let them. Plan the big activity for the afternoon and keep mornings for things you and your partner want to do.",
   "est_sec": 6.61,
   "gap_before": 0.3,
   "role": "reply",
   "block": "travel_planning.dlg25"
  }
 ]
}
