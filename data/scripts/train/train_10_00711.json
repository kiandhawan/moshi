 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.59,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "The bus just drove straight past me. I was standing right at the stop!",
   "est_sec": 4.44,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "public_transport.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "So annoying. At some stops, the driver only stops if someone signals. Did you hold your arm out?",
   "est_sec": 5.68,
   "gap_before": 0.53,
   "role": "reply",
   "block": "public_transport.dlg26"
  },
  {
   "speaker": "user",
   "text": "No. I didn't know I had to.",
   "est_sec": 2.27,
   "gap_before": 0.7,
   "event": "ordinary_request",
   "block": "public_transport.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "It's worth doing every time, especially at quieter stops. A clear wave as the bus approaches is enough.",
   "est_sec": 5.68,
   "gap_before": 0.33,
   "role": "reply",
   "block": "public_transport.dlg26"
  },
  {
   "speaker": "user",
   "text": "And getting off? I sometimes",
   "est_sec": 1.65,
   "gap_before": 1.16,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg26"
  },
  {
   "speaker": "user",
   "text": "miss my stop because I'm not sure when to press.",
   "est_sec": 3.2,
   "gap_before": 2.18,
   "event": "ordinary_request",
   "block": "public_transport.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Press the stop button just after the bus leaves the stop before yours. You'll usually see a sign light up saying the bus is stopping.",
   "est_sec": 7.85,
   "gap_before": 1.02,
   "role": "reply",
   "block": "public_transport.dlg26"
  },
  {
   "speaker": "user",
   "text": "Okay. I feel like I've been doing buses wrong for years.",
   "est_sec": 3.51,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "public_transport.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "You've just been lucky with busy stops. Now you're a pro.",
   "est_sec": 3.51,
   "gap_before": 1.1,
   "role": "reply",
   "block": "public_transport.dlg26"
  }
 ]
}
