 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.52,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.88,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "Consulting firm. Case interview. I have no idea what that is.",
   "est_sec": 3.51,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "job_interview.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "They give you a business problem, like why a company's profits are falling, and you work through it out loud with them.",
   "est_sec": 6.92,
   "gap_before": 0.65,
   "role": "reply",
   "block": "job_interview.dlg31"
  },
  {
   "speaker": "user",
   "text": "With no data?",
   "est_sec": 1.03,
   "gap_before": 3.23,
   "event": "ordinary_request",
   "block": "job_interview.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "They'll give you some as you ask. The point is to structure the problem, ask good questions, and do some quick maths.",
   "est_sec": 6.92,
   "gap_before": 0.41,
   "role": "reply",
   "block": "job_interview.dlg31"
  },
  {
   "speaker": "user",
   "text": "Maths in my head. Brilliant.",
   "est_sec": 1.65,
   "gap_before": 1.53,
   "event": "ordinary_request",
   "block": "job_interview.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "It's usually simple percentages and multiplication. Practise doing it out loud and round numbers to keep it easy.",
   "est_sec": 5.68,
   "gap_before": 0.38,
   "role": "reply",
   "block": "job_interview.dlg31"
  },
  {
   "speaker": "user",
   "text": "Any books or anything?",
   "est_sec": 1.34,
   "gap_before": 0.79,
   "event": "ordinary_request",
   "block": "job_interview.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "There are popular case prep books and plenty of free practice cases online. Doing a few with a friend is the best preparation.",
   "est_sec": 7.23,
   "gap_before": 0.81,
   "role": "reply",
   "block": "job_interview.dlg31"
  }
 ]
}
