 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.64,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "Some mates are helping me move on Saturday. What should I do to say thanks?",
   "est_sec": 4.75,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "moving_house.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Keep them fed and watered on the day, lots of drinks and snacks, and a proper meal at the end.",
   "est_sec": 6.3,
   "gap_before": 0.81,
   "role": "reply",
   "block": "moving_house.dlg17"
  },
  {
   "speaker": "user",
   "text": "Pizza, basically.",
   "est_sec": 0.72,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "moving_house.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Pizza is the classic for a reason. Also have a plan ready so they're not standing around waiting for instructions.",
   "est_sec": 6.3,
   "gap_before": 0.92,
   "role": "reply",
   "block": "moving_house.dlg17"
  },
  {
   "speaker": "user",
   "text": "Should I offer money?",
   "est_sec": 1.34,
   "gap_before": 0.93,
   "event": "ordinary_request",
   "block": "moving_house.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Most friends won't want it. Offering to help them back when they move means a lot more.",
   "est_sec": 5.37,
   "gap_before": 1.09,
   "role": "reply",
   "block": "moving_house.dlg17"
  },
  {
   "speaker": "user",
   "text": "And maybe",
   "est_sec": 0.72,
   "gap_before": 1.22,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg17"
  },
  {
   "speaker": "user",
   "text": "a crate of beer for afterwards.",
   "est_sec": 1.96,
   "gap_before": 2.33,
   "event": "ordinary_request",
   "block": "moving_house.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "That works too. Just save it until the heavy lifting is done.",
   "est_sec": 3.82,
   "gap_before": 1.27,
   "role": "reply",
   "block": "moving_house.dlg17"
  }
 ]
