 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.66,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "Challenge for you. I've got twenty pounds for the entire weekend.",
   "est_sec": 3.51,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Accepted. Saturday could be a long walk or a bike ride somewhere pretty, with a packed lunch.",
   "est_sec": 5.37,
   "gap_before": 0.6,
   "role": "reply",
   "block": "weekend_plans.dlg19"
  },
  {
   "speaker": "user",
   "text": "Fine, that's free. What about Saturday night?",
   "est_sec": 2.27,
   "gap_before": 0.76,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Invite a friend over and cook together. Pasta, a sauce and some cheese for a few pounds, and maybe a cheap film rental.",
   "est_sec": 7.23,
   "gap_before": 0.94,
   "role": "reply",
   "block": "weekend_plans.dlg19"
  },
  {
   "speaker": "user",
   "text": "And Sunday?",
   "est_sec": 0.72,
   "gap_before": 3.39,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Check the library for free events, or go to a market and treat yourself to one thing you love.",
   "est_sec": 5.99,
   "gap_before": 0.4,
   "role": "reply",
   "block": "weekend_plans.dlg19"
  },
  {
   "speaker": "user",
   "text": "I'd probably",
   "est_sec": 0.72,
   "gap_before": 0.84,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg19"
  },
  {
   "speaker": "user",
   "text": "spend it all on cake.",
   "est_sec": 1.65,
   "gap_before": 1.57,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "That's a perfectly good use of a budget weekend.",
   "est_sec": 2.89,
   "gap_before": 0.73,
   "role": "reply",
   "block": "weekend_plans.dlg19"
  }
 ]
