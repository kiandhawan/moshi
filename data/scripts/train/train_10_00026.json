 "est_speech_sec": 42.22,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.43,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.92,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "I bought a kettlebell and I'm scared of the swing. It feels like it's going to fly through my window.",
   "est_sec": 6.3,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "fitness.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "That's a fair worry. The key is that the power comes from your hips, not your arms.",
   "est_sec": 5.37,
   "gap_before": 0.83,
   "role": "reply",
   "block": "fitness.dlg12"
  },
  {
   "speaker": "user",
   "text": "My hips?",
   "est_sec": 0.72,
   "gap_before": 0.9,
   "event": "ordinary_request",
   "block": "fitness.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Push your hips back like you're closing a car door with your bum, then snap them forward. Your arms just guide the bell.",
   "est_sec": 7.23,
   "gap_before": 0.85,
   "role": "reply",
   "block": "fitness.dlg12"
  },
  {
   "speaker": "user",
   "text": "That's a weird image but okay.",
   "est_sec": 1.96,
   "gap_before": 3.34,
   "event": "ordinary_request",
   "block": "fitness.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "It works. Keep your back flat and let the bell float up to chest height, no higher.",
   "est_sec": 5.37,
   "gap_before": 0.75,
   "role": "reply",
   "block": "fitness.dlg12"
  },
  {
   "speaker": "user",
   "text": "What weight",
   "est_sec": 0.72,
   "gap_before": 0.93,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg12"
  },
  {
   "speaker": "user",
   "text": "should a beginner use?",
   "est_sec": 1.34,
   "gap_before": 2.59,
   "event": "ordinary_request",
   "block": "fitness.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Something you can control for fifteen swings with good form. For many people, that's eight to twelve kilos.",
   "est_sec": 5.68,
   "gap_before": 0.84,
   "role": "reply",
   "block": "fitness.dlg12"
  },
  {
   "speaker": "user",
   "text": "Mine's eight. Phew.",
   "est_sec": 1.03,
   "gap_before": 1.36,
   "event": "ordinary_request",
   "block": "fitness.dlg12"
  },
  {
   "speaker": "moshi",
   "text": "Perfect starting point. Practice in a clear space, away from that window.",
   "est_sec": 3.82,
   "gap_before": 1.04,
   "role": "reply",
   "block": "fitness.dlg12"
  }
 ]
}
