 "est_total_sec": 60.18,
 "est_speech_sec": 43.77,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.54,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "We want to grow a giant pumpkin for Halloween. Like, really giant.",
   "est_sec": 3.82,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "gardening.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Love it. Pick a giant variety and start the seeds indoors in late April or early May.",
   "est_sec": 5.37,
   "gap_before": 0.65,
   "role": "reply",
   "block": "gardening.dlg25"
  },
  {
   "speaker": "user",
   "text": "And then?",
   "est_sec": 0.72,
   "gap_before": 3.35,
   "event": "ordinary_request",
   "block": "gardening.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Plant it out after the last frost in a really rich spot, loads of manure or compost. They're very hungry plants.",
   "est_sec": 6.61,
   "gap_before": 1.11,
   "role": "reply",
   "block": "gardening.dlg25"
  },
  {
   "speaker": "user",
   "text": "We've got space next to the compost heap.",
   "est_sec": 2.58,
   "gap_before": 1.04,
   "event": "ordinary_request",
   "block": "gardening.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "That's actually a perfect spot. Once a few pumpkins form, keep only the best one, so the plant feeds just that.",
   "est_sec": 6.61,
   "gap_before": 0.88,
   "role": "reply",
   "block": "gardening.dlg25"
  },
  {
   "speaker": "user",
   "text": "Only one? That",
   "est_sec": 1.03,
   "gap_before": 0.65,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg25"
  },
  {
   "speaker": "user",
   "text": "feels a bit harsh.",
   "est_sec": 1.34,
   "gap_before": 2.62,
   "event": "ordinary_request",
   "block": "gardening.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "It's harsh but that's the secret. Water it deeply and often, and slide a board under the pumpkin so it doesn't rot.",
   "est_sec": 6.92,
   "gap_before": 1.02,
   "role": "reply",
   "block": "gardening.dlg25"
  },
  {
   "speaker": "user",
   "text": "How big could it get?",
   "est_sec": 1.65,
   "gap_before": 1.07,
   "event": "ordinary_request",
   "block": "gardening.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "In a good summer, big enough that you'll need two people to lift it.",
   "est_sec": 4.44,
   "gap_before": 1.17,
   "role": "reply",
   "block": "gardening.dlg25"
  }
 ]
}
