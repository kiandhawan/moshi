   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.98,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "I want to take a photography class this autumn but I can't decide which.",
   "est_sec": 4.44,
   "gap_before": 0.27,
   "block": "photography.opt5"
  },
  {
   "speaker": "user",
   "text": "Let me lay out all the options first. Don't interrupt.",
   "est_sec": 3.2,
   "gap_before": 0.74,
   "event": "instruction",
   "kind": "describe_options",
   "phrasing": "describe_instr_14"
  },
  {
   "speaker": "moshi",
   "text": "No problem.",
   "est_sec": 0.72,
   "gap_before": 0.32,
   "role": "ack",
   "phrasing": "ack_04"
  },
  {
   "speaker": "user",
   "text": "A ten week evening course at the community college, with homework and critique every week.",
   "est_sec": 4.75,
   "gap_before": 0.68,
   "block": "photography.opt5",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "A weekend workshop in the mountains, two full days of shooting landscapes with a pro.",
   "est_sec": 4.75,
   "gap_before": 2.2,
   "block": "photography.opt5",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "An online course I can do whenever, with videos and a forum, really cheap.",
   "est_sec": 4.44,
   "gap_before": 1.68,
   "block": "photography.opt5",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "A street photography walk group that meets every Saturday morning, free, but no real teaching.",
   "est_sec": 4.75,
   "gap_before": 2.16,
   "block": "photography.opt5"
  },
  {
   "speaker": "user",
   "text": "Done. What would you recommend?",
   "est_sec": 1.65,
