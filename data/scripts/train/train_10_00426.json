 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.43,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "I keep getting blisters on my heels when I hike.",
   "est_sec": 3.2,
   "gap_before": 0.3,
   "event": "ordinary_request",
   "block": "hiking.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "That's usually friction from your heel sliding in the boot. Are your boots well broken in?",
   "est_sec": 5.06,
   "gap_before": 0.81,
   "role": "reply",
   "block": "hiking.dlg2"
  },
  {
   "speaker": "user",
   "text": "They're pretty new, yeah.",
   "est_sec": 1.34,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "hiking.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "That's likely the cause. Wear them around the house and on short walks first. Proper hiking socks help a lot too, not cotton ones.",
   "est_sec": 7.54,
   "gap_before": 0.59,
   "role": "reply",
   "block": "hiking.dlg2"
  },
  {
   "speaker": "user",
   "text": "And if I feel one starting on the trail?",
   "est_sec": 2.89,
   "gap_before": 0.7,
   "event": "ordinary_request",
   "block": "hiking.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Stop right away and put a blister plaster or some tape on the spot. Waiting until it hurts usually means it's already formed.",
   "est_sec": 7.23,
   "gap_before": 0.93,
   "role": "reply",
   "block": "hiking.dlg2"
  },
  {
   "speaker": "user",
   "text": "I always think I'll",
   "est_sec": 1.34,
   "gap_before": 2.73,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg2"
  },
  {
   "speaker": "user",
   "text": "just push through it.",
   "est_sec": 1.34,
   "gap_before": 1.82,
   "event": "ordinary_request",
   "block": "hiking.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Most people do. A two minute stop early saves you a miserable walk back.",
   "est_sec": 4.44,
   "gap_before": 1.04,
   "role": "reply",
   "block": "hiking.dlg2"
  }
 ]
}
