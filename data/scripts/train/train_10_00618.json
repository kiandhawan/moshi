 "est_total_sec": 53.05,
 "est_speech_sec": 39.23,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.41,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.69,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "We just adopted a dog and I don't drive. Can she come on the train with me?",
   "est_sec": 5.37,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "public_transport.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "In lots of places, yes. Small dogs often travel free, and bigger ones might need a ticket or have to stay on a lead.",
   "est_sec": 7.54,
   "gap_before": 1.01,
   "role": "reply",
   "block": "public_transport.dlg32"
  },
  {
   "speaker": "user",
   "text": "She's medium sized. A bit nervous.",
   "est_sec": 1.96,
   "gap_before": 3.27,
   "event": "ordinary_request",
   "block": "public_transport.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Then start with short, quiet trips outside rush hour. Bring treats and a blanket that smells like home.",
   "est_sec": 5.68,
   "gap_before": 1.1,
   "role": "reply",
   "block": "public_transport.dlg32"
  },
  {
   "speaker": "user",
   "text": "Does she need",
   "est_sec": 1.03,
   "gap_before": 0.49,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg32"
  },
  {
   "speaker": "user",
   "text": "a muzzle or anything?",
   "est_sec": 1.34,
   "gap_before": 2.15,
   "event": "ordinary_request",
   "block": "public_transport.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Some networks require one, others don't. Check your local rules, and practise with it at home first if needed.",
   "est_sec": 5.99,
   "gap_before": 1.59,
   "role": "reply",
   "block": "public_transport.dlg32"
  },
  {
   "speaker": "user",
   "text": "I didn't think about practising.",
   "est_sec": 1.65,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "public_transport.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "It really helps. A calm first trip makes the next ones much easier for both of you.",
   "est_sec": 5.37,
   "gap_before": 0.7,
   "role": "reply",
   "block": "public_transport.dlg32"
  }
 ]
}
