 "est_total_sec": 62.48,
 "est_speech_sec": 49.66,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.76,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.72,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "Hello. My grandson usually books things for me, but he's away. I'd like to book a train to visit my sister.",
   "est_sec": 6.61,
   "gap_before": 0.32,
   "event": "ordinary_request",
   "block": "travel_planning.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Of course, I can help. Do you know which station you're traveling from and to, and the day?",
   "est_sec": 5.68,
   "gap_before": 1.06,
   "role": "reply",
   "block": "travel_planning.dlg31"
  },
  {
   "speaker": "user",
   "text": "From the main station here to Bath, on Thursday.",
   "est_sec": 2.89,
   "gap_before": 0.83,
   "event": "ordinary_request",
   "block": "travel_planning.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Lovely. The simplest way is the train company's website, or you could buy a ticket at the station counter.",
   "est_sec": 5.99,
   "gap_before": 0.67,
   "role": "reply",
   "block": "travel_planning.dlg31"
  },
  {
   "speaker": "user",
   "text": "The website frightens me a little, to be honest.",
   "est_sec": 2.89,
   "gap_before": 0.67,
   "event": "ordinary_request",
   "block": "travel_planning.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "That's perfectly fine. Buying at the counter is easy, and the staff can find you the best price. Mention if you have a senior railcard.",
   "est_sec": 7.85,
   "gap_before": 0.57,
   "role": "reply",
   "block": "travel_planning.dlg31"
  },
  {
   "speaker": "user",
   "text": "I believe I do. It's",
   "est_sec": 1.65,
   "gap_before": 1.34,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg31"
  },
  {
   "speaker": "user",
   "text": "somewhere in my handbag.",
   "est_sec": 1.34,
   "gap_before": 2.44,
   "event": "ordinary_request",
   "block": "travel_planning.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Bring it along, it can save you about a third. And ask for a seat reservation so you have a guaranteed seat.",
   "est_sec": 6.92,
   "gap_before": 0.47,
   "role": "reply",
   "block": "travel_planning.dlg31"
  },
  {
   "speaker": "user",
   "text": "Wait a second, thank you, dear. That's very helpful.",
   "est_sec": 2.89,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_16",
   "block": "travel_planning.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "You're welcome. Enjoy your visit with your sister.",
   "est_sec": 2.58,
   "gap_before": 1.03,
   "role": "reply",
   "block": "travel_planning.dlg31"
  }
 ]
}
