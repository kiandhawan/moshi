 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.35,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.52,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "There's this tune I can't stop humming but I have no idea what it's called.",
   "est_sec": 4.75,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "music.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Annoying. Many music apps can find a song if you hum it. They're surprisingly good.",
   "est_sec": 4.75,
   "gap_before": 0.84,
   "role": "reply",
   "block": "music.dlg7"
  },
  {
   "speaker": "user",
   "text": "Really? Even with my terrible humming?",
   "est_sec": 1.96,
   "gap_before": 1.25,
   "event": "ordinary_request",
   "block": "music.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Usually, if you get the basic shape of the melody right. Hum for ten or fifteen seconds.",
   "est_sec": 5.37,
   "gap_before": 0.34,
   "role": "reply",
   "block": "music.dlg7"
  },
  {
   "speaker": "user",
   "text": "I think I heard it",
   "est_sec": 1.65,
   "gap_before": 0.6,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg7"
  },
  {
   "speaker": "user",
   "text": "in a cafe last week.",
   "est_sec": 1.65,
   "gap_before": 2.96,
   "event": "ordinary_request",
   "block": "music.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Then you could also ask the cafe. Staff often know their playlist, or you could check if the cafe shares it online.",
   "est_sec": 6.92,
   "gap_before": 0.65,
   "role": "reply",
   "block": "music.dlg7"
  },
  {
   "speaker": "user",
   "text": "Hold on, let me try humming it into my phone.",
   "est_sec": 3.2,
   "gap_before": 0.8,
   "event": "ordinary_request",
   "block": "music.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Go for it. If it doesn't work, try the chorus, that's usually the most recognisable part.",
   "est_sec": 5.06,
   "gap_before": 0.91,
   "role": "reply",
   "block": "music.dlg7"
  }
 ]
