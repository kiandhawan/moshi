 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.4,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.67,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "What should I eat on the morning of an exam? I usually just skip breakfast.",
   "est_sec": 4.75,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "studying.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Try not to skip it. Something with slow energy, like porridge, eggs on toast, or yogurt with fruit, keeps you going.",
   "est_sec": 6.61,
   "gap_before": 0.84,
   "role": "reply",
   "block": "studying.dlg22"
  },
  {
   "speaker": "user",
   "text": "I get too nervous to eat.",
   "est_sec": 1.96,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "studying.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Then something small. A banana and a glass of milk is better than nothing.",
   "est_sec": 4.44,
   "gap_before": 0.9,
   "role": "reply",
   "block": "studying.dlg22"
  },
  {
   "speaker": "user",
   "text": "And coffee?",
   "est_sec": 0.72,
   "gap_before": 0.98,
   "event": "ordinary_request",
   "block": "studying.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "If you normally drink it, have your usual amount. Don't suddenly drink three cups, that can make the nerves worse.",
   "est_sec": 6.3,
   "gap_before": 1.6,
   "role": "reply",
   "block": "studying.dlg22"
  },
  {
   "speaker": "user",
   "text": "And what should I",
   "est_sec": 1.34,
   "gap_before": 0.96,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg22"
  },
  {
   "speaker": "user",
   "text": "bring in with me?",
   "est_sec": 1.34,
   "gap_before": 1.98,
   "event": "ordinary_request",
   "block": "studying.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Spare pens, a clear water bottle, your ID, and a watch if you're allowed. Pack it all the night before.",
   "est_sec": 6.3,
   "gap_before": 1.36,
   "role": "reply",
   "block": "studying.dlg22"
  }
 ]
