 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.7,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.9,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "The interviewer was so rude. Checked his phone constantly and cut me off. And now they've offered me the job.",
   "est_sec": 6.3,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "job_interview.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Mixed signals. Would he be your direct manager?",
   "est_sec": 2.58,
   "gap_before": 0.43,
   "role": "reply",
   "block": "job_interview.dlg25"
  },
  {
   "speaker": "user",
   "text": "Yes, unfortunately.",
   "est_sec": 0.72,
   "gap_before": 0.79,
   "event": "ordinary_request",
   "block": "job_interview.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Then it's worth thinking about seriously. One bad day can happen, but how someone treats candidates often shows how they treat their team.",
   "est_sec": 7.23,
   "gap_before": 1.13,
   "role": "reply",
   "block": "job_interview.dlg25"
  },
  {
   "speaker": "user",
   "text": "How do I find out if he's always like that?",
   "est_sec": 3.2,
   "gap_before": 0.77,
   "event": "ordinary_request",
   "block": "job_interview.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Ask if you can talk to someone on the team before accepting. A quick chat with a future colleague tells you a lot.",
   "est_sec": 7.23,
   "gap_before": 0.96,
   "role": "reply",
   "block": "job_interview.dlg25"
  },
  {
   "speaker": "user",
   "text": "Is that a normal thing to ask?",
   "est_sec": 2.27,
   "gap_before": 1.32,
   "event": "ordinary_request",
   "block": "job_interview.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Totally normal, especially after an offer. If they say no, that's information too.",
   "est_sec": 4.13,
   "gap_before": 0.55,
   "role": "reply",
   "block": "job_interview.dlg25"
  }
 ]
}
