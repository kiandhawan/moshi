 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.53,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "My husky is shedding so much the house looks like it snowed.",
   "est_sec": 3.82,
   "gap_before": 0.23,
   "event": "ordinary_request",
   "block": "pets.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Huskies blow their coat twice a year, it's a lot. Brushing every day during these weeks really helps.",
   "est_sec": 5.68,
   "gap_before": 0.62,
   "role": "reply",
   "block": "pets.dlg30"
  },
  {
   "speaker": "user",
   "text": "Every day? I barely brush my own hair.",
   "est_sec": 2.58,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "pets.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Ha, I get it. A good undercoat rake gets most of it out in ten minutes or so.",
   "est_sec": 5.68,
   "gap_before": 0.95,
   "role": "reply",
   "block": "pets.dlg30"
  },
  {
   "speaker": "user",
   "text": "Should I shave him for summer?",
   "est_sec": 1.96,
   "gap_before": 1.04,
   "event": "ordinary_request",
   "block": "pets.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Please don't. That double coat actually helps keep him cool, and it might not grow back properly.",
   "est_sec": 5.37,
   "gap_before": 1.18,
   "role": "reply",
   "block": "pets.dlg30"
  },
  {
   "speaker": "user",
   "text": "Fine.",
   "est_sec": 0.41,
   "gap_before": 2.15,
   "event": "distractor",
   "kind": "pause",
   "block": "pets.dlg30"
  },
  {
   "speaker": "user",
   "text": "So just suffer?",
   "est_sec": 1.03,
   "gap_before": 2.5,
   "event": "ordinary_request",
   "block": "pets.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Brush outside, vacuum often, and put a washable throw on his favourite spot. It passes in a few weeks.",
   "est_sec": 5.99,
   "gap_before": 0.81,
   "role": "reply",
   "block": "pets.dlg30"
  }
 ]
}
