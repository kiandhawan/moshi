 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.71,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.5,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "I'm organising sports day at the primary school and it's going to be a scorcher.",
   "est_sec": 4.75,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "weather_plans.ctx7"
  },
  {
   "speaker": "moshi",
   "text": "Kids and heat need some planning. Would you shift the start earlier to beat the heat, or move some events into the hall?",
   "est_sec": 7.23,
   "gap_before": 0.82,
   "role": "reply",
   "block": "weather_plans.ctx7"
  },
  {
   "speaker": "user",
   "text": "Hold on, I need a minute with my roommate. Just stay silent until I come back to you.",
   "est_sec": 5.68,
   "gap_before": 2.74,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_23"
  },
  {
   "speaker": "user",
   "text": "Sorry, what were you saying?",
   "est_sec": 1.65,
   "gap_before": 0.92,
   "event": "distractor",
   "kind": "near_miss",
   "phrasing": "dn_13"
  },
  {
   "speaker": "friend",
   "text": "Just that the bus was late again.",
   "est_sec": 2.27,
   "gap_before": 0.66,
   "phrasing": "dn_13"
  },
  {
   "speaker": "user",
   "text": "Did you just wake up? It's six in the evening.",
   "est_sec": 3.2,
   "gap_before": 3.23,
   "block": "sleep.side5"
  },
  {
   "speaker": "friend",
   "text": "I lay down for ten minutes at three.",
   "est_sec": 2.58,
   "gap_before": 2.4,
   "block": "sleep.side5"
  },
  {
   "speaker": "user",
   "text": "That was three hours ago.",
   "est_sec": 1.65,
   "gap_before": 1.14,
   "block": "sleep.side5"
  },
  {
   "speaker": "friend",
   "text": "I know. I feel like a zombie and I have no idea what day it is.",
   "est_sec": 5.06,
   "gap_before": 2.98,
   "block": "sleep.side5"
  },
  {
   "speaker": "user",
   "text": "Have some water. You'll be up till four now, you know that, right?",
   "est_sec": 4.13,
   "gap_before": 0.9,
   "event": "distractor",
   "kind": "friend_question",
   "block": "sleep.side5"
  },
  {
   "speaker": "friend",
   "text": "Probably. Want to watch something with me later, then?",
   "est_sec": 2.89,
   "gap_before": 0.39,
   "block": "sleep.side5"
  },
  {
   "speaker": "user",
   "text": "Done. I'm back now.",
   "est_sec": 1.34,
   "gap_before": 1.84,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_19"
  },
  {
   "speaker": "moshi",
   "text": "Sure thing. The school sports day. Earlier start, or into the hall?",
   "est_sec": 3.82,
   "gap_before": 0.68,
   "role": "resume",
   "block": "weather_plans.ctx7"
  },
  {
   "speaker": "user",
   "text": "Some events in the hall. The running ones stay outside.",
   "est_sec": 3.2,
   "gap_before": 1.45,
   "event": "ordinary_request",
   "block": "weather_plans.ctx7"
  },
  {
   "speaker": "moshi",
   "text": "Good mix. Keep the outdoor races short, and remind parents to send hats and sun cream.",
   "est_sec": 5.06,
   "gap_before": 1.04,
   "role": "followup",
   "block": "weather_plans.ctx7"
  }
