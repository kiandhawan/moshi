 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.73,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.75,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "Hosting a dinner party for six on Saturday and I'm already stressing.",
   "est_sec": 3.82,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Keep the menu simple. One dish that cooks itself, like a slow roast or a big stew, while you're with guests.",
   "est_sec": 6.61,
   "gap_before": 1.04,
   "role": "reply",
   "block": "weekend_plans.dlg23"
  },
  {
   "speaker": "user",
   "text": "And a starter?",
   "est_sec": 1.03,
   "gap_before": 1.45,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Skip anything that needs cooking. A nice bread, some dips or a salad you can make in advance.",
   "est_sec": 5.68,
   "gap_before": 0.92,
   "role": "reply",
   "block": "weekend_plans.dlg23"
  },
  {
   "speaker": "user",
   "text": "Dessert I'm thinking of buying.",
   "est_sec": 1.65,
   "gap_before": 1.28,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Absolutely fine. A good shop bought tart with some cream is perfect.",
   "est_sec": 3.82,
   "gap_before": 0.4,
   "role": "reply",
   "block": "weekend_plans.dlg23"
  },
  {
   "speaker": "user",
   "text": "What about",
   "est_sec": 0.72,
   "gap_before": 0.97,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg23"
  },
  {
   "speaker": "user",
   "text": "dietary stuff? I never know.",
   "est_sec": 1.65,
   "gap_before": 1.51,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Message everyone now and ask. It saves surprises, and you can plan one dish that works for everyone.",
   "est_sec": 5.68,
   "gap_before": 0.67,
   "role": "reply",
   "block": "weekend_plans.dlg23"
  }
 ]
}
