 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.38,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "We need a stroller before the baby comes and the shop had about forty of them.",
   "est_sec": 5.06,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "shopping.ctx6"
  },
  {
   "speaker": "moshi",
   "text": "It's overwhelming, I know. Will you mostly be on city pavements and buses, or out on gravel paths and rough ground?",
   "est_sec": 6.61,
   "gap_before": 0.92,
   "role": "reply",
   "block": "shopping.ctx6"
  },
  {
   "speaker": "user",
   "text": "Hang tight, my dad is calling me over. Don't talk until I say I'm back.",
   "est_sec": 4.75,
   "gap_before": 1.13,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_25"
  },
  {
   "speaker": "user",
   "text": "Sorry, can you say that again? The blender was on.",
   "est_sec": 3.2,
   "gap_before": 1.37,
   "event": "distractor",
   "kind": "near_miss",
   "phrasing": "dn_55"
  },
  {
   "speaker": "friend",
   "text": "I said do you want a smoothie too.",
   "est_sec": 2.58,
   "gap_before": 0.72,
   "phrasing": "dn_55"
  },
  {
   "speaker": "user",
   "text": "Daniel, any chance you could feed the cat while we're away?",
   "est_sec": 3.51,
   "gap_before": 0.93,
   "event": "distractor",
   "kind": "friend_question",
   "block": "travel_planning.side5"
  },
  {
   "speaker": "friend",
   "text": "How long are you gone?",
   "est_sec": 1.65,
   "gap_before": 1.1,
   "block": "travel_planning.side5"
  },
  {
   "speaker": "user",
   "text": "Nine days. Just once a day, and maybe scoop the litter.",
   "est_sec": 3.51,
   "gap_before": 1.17,
   "block": "travel_planning.side5"
  },
  {
   "speaker": "friend",
   "text": "Nine days of litter. You owe me big.",
   "est_sec": 2.58,
   "gap_before": 0.75,
   "block": "travel_planning.side5"
  },
  {
   "speaker": "user",
   "text": "I'll bring you back something nice. Chocolate? A fridge magnet?",
   "est_sec": 3.2,
   "gap_before": 1.25,
   "event": "distractor",
   "kind": "friend_question",
   "block": "travel_planning.side5"
  },
  {
   "speaker": "friend",
   "text": "Not a magnet. Something edible, please.",
   "est_sec": 1.96,
   "gap_before": 1.29,
   "block": "travel_planning.side5"
  },
  {
   "speaker": "user",
   "text": "Edible it is. I'll leave the spare key under the plant.",
   "est_sec": 3.51,
   "gap_before": 3.21,
   "block": "travel_planning.side5"
  },
  {
   "speaker": "friend",
   "text": "Text me her food amounts, I'll forget otherwise.",
   "est_sec": 2.58,
   "gap_before": 0.91,
   "block": "travel_planning.side5"
  },
  {
   "speaker": "user",
   "text": "I'm here again, let's continue.",
