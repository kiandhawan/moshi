 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.3,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.73,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "Hi, my washing machine shakes like crazy on the spin cycle.",
   "est_sec": 3.51,
   "gap_before": 0.23,
   "event": "ordinary_request",
   "block": "home_repair.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "That's usually the machine not being level, or the load being unbalanced. Is it a big load?",
   "est_sec": 5.37,
   "gap_before": 0.38,
   "role": "reply",
   "block": "home_repair.dlg8"
  },
  {
   "speaker": "user",
   "text": "It does it even with just a few towels.",
   "est_sec": 2.89,
   "gap_before": 3.2,
   "event": "ordinary_request",
   "block": "home_repair.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Then check the feet. Put a level on top, and twist the feet up or down until it sits flat and doesn't rock.",
   "est_sec": 7.23,
   "gap_before": 0.71,
   "role": "reply",
   "block": "home_repair.dlg8"
  },
  {
   "speaker": "user",
   "text": "I don't have a level.",
   "est_sec": 1.65,
   "gap_before": 1.09,
   "event": "ordinary_request",
   "block": "home_repair.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "There's probably a level app on your phone. Or put a glass of water on top and see if it looks even.",
   "est_sec": 6.92,
   "gap_before": 0.59,
   "role": "reply",
   "block": "home_repair.dlg8"
  },
  {
   "speaker": "user",
   "text": "Also, I moved house last month. Could that matter?",
   "est_sec": 2.89,
   "gap_before": 0.7,
   "event": "ordinary_request",
   "block": "home_repair.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Yes, actually. Check the back for transit bolts. If they weren't removed after the move, it'll shake terribly.",
   "est_sec": 5.68,
   "gap_before": 0.47,
   "role": "reply",
   "block": "home_repair.dlg8"
  }
 ]
}
