 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.4,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.9,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "What's the best way to get from Paris to Amsterdam?",
   "est_sec": 3.2,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "travel_planning.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "The train is easiest. It takes a bit over three hours and drops you right in the city center.",
   "est_sec": 5.99,
   "gap_before": 1.18,
   "role": "reply",
   "block": "travel_planning.dlg1"
  },
  {
   "speaker": "user",
   "text": "Is it expensive?",
   "est_sec": 1.03,
   "gap_before": 0.93,
   "event": "ordinary_request",
   "block": "travel_planning.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "It can be if you book late. Book a few weeks ahead and you'll often find much cheaper fares.",
   "est_sec": 5.99,
   "gap_before": 0.65,
   "role": "reply",
   "block": "travel_planning.dlg1"
  },
  {
   "speaker": "user",
   "text": "What about flying? It's only",
   "est_sec": 1.65,
   "gap_before": 0.41,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg1"
  },
  {
   "speaker": "user",
   "text": "like an hour in the air, right?",
   "est_sec": 2.27,
   "gap_before": 1.64,
   "event": "ordinary_request",
   "block": "travel_planning.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "About an hour, yes, but with getting to the airport and security it usually ends up slower than the train.",
   "est_sec": 6.3,
   "gap_before": 0.68,
   "role": "reply",
   "block": "travel_planning.dlg1"
  },
  {
   "speaker": "user",
   "text": "Okay, train it is. Should I stop somewhere on the way?",
   "est_sec": 3.51,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "travel_planning.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Brussels or Antwerp make a nice stop. You could spend an afternoon there and catch a later train.",
   "est_sec": 5.68,
   "gap_before": 1.27,
   "role": "reply",
   "block": "travel_planning.dlg1"
  }
 ]
}
