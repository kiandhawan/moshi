   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "My mum says I should walk into cafes with my CV, but everyone does it online now.",
   "est_sec": 5.37,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "job_interview.ctx8"
  },
  {
   "speaker": "moshi",
   "text": "How old are you, and what kind of job is it?",
   "est_sec": 3.51,
   "gap_before": 0.32,
   "role": "reply",
   "block": "job_interview.ctx8"
  },
  {
   "speaker": "user",
   "text": "Sixteen. Just weekend shifts, anywhere.",
