   "gap_before": 1.91,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 10,
   "phrasing": "think_instr_05"
  },
  {
   "speaker": "moshi",
   "text": "Sure thing.",
   "est_sec": 0.72,
   "gap_before": 0.42,
   "role": "ack",
   "phrasing": "ack_12"
  },
  {
   "speaker": "user",
   "text": "Oh, I know.",
