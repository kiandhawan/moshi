   "gap_before": 1.26,
   "event": "ordinary_request",
   "block": "job_interview.ctx8"
  },
  {
   "speaker": "moshi",
   "text": "For weekend cafe work, both can work. Do you want to try dropping in with your CV, or apply online first?",
   "est_sec": 6.61,
   "gap_before": 1.05,
   "role": "reply",
   "block": "job_interview.ctx8"
  },
  {
   "speaker": "user",
   "text": "Can you give me ten seconds? Then ask me again.",
