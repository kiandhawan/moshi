   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "My mum is moving into a bungalow, and the big question is her old piano.",
   "est_sec": 4.75,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "moving_house.ctx6"
  },
  {
   "speaker": "moshi",
   "text": "That's a tough one. She could keep it and give up a bit of living room, or give it to a school and keep the space. Does she still play?",
