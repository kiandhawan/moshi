   "gap_before": 0.56,
   "block": "weather_plans.side1"
  },
  {
   "speaker": "user",
   "text": "Ugh. Do you still want to do the hike?",
   "est_sec": 2.89,
   "gap_before": 0.41,
   "event": "distractor",
   "kind": "friend_question",
   "block": "weather_plans.side1"
  },
  {
