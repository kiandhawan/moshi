   "est_sec": 2.58,
   "gap_before": 0.32,
   "role": "reply",
   "block": "baking.ctx3"
  },
  {
   "speaker": "user",
   "text": "Hold on, I need a minute with my roommate. Just stay silent until I come back to you.",
   "est_sec": 5.68,
   "gap_before": 0.55,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_23"
  },
  {
   "speaker": "user",
   "text": "Chloe, did you see the forecast for tomorrow?",
