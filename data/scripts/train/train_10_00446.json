   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.65,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "My daughter wants to bake with me on Sunday. She's seven.",
   "est_sec": 3.51,
   "gap_before": 0.26,
   "event": "ordinary_request",
   "block": "baking.ctx3"
  },
  {
   "speaker": "moshi",
   "text": "That's sweet. What sounds more fun for her, decorating sugar cookies, or making a simple banana bread she can mash and stir?",
