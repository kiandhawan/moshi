 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.57,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "What does aperture actually mean? I keep reading it and nodding.",
   "est_sec": 3.51,
   "gap_before": 0.23,
   "event": "ordinary_request",
   "block": "photography.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "It's the size of the opening in the lens that lets light in. A wide opening means more light and a blurrier background.",
   "est_sec": 7.23,
   "gap_before": 0.72,
   "role": "reply",
   "block": "photography.dlg2"
  },
  {
   "speaker": "user",
   "text": "And the numbers, like f two?",
   "est_sec": 1.96,
   "gap_before": 1.47,
   "event": "ordinary_request",
   "block": "photography.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Confusingly, smaller numbers mean a wider opening. So f two gives a soft background, and f eleven keeps everything sharp.",
   "est_sec": 6.3,
   "gap_before": 1.17,
   "role": "reply",
   "block": "photography.dlg2"
  },
  {
   "speaker": "user",
   "text": "So for a portrait I'd want",
   "est_sec": 1.96,
   "gap_before": 0.37,
   "event": "distractor",
   "kind": "pause",
   "block": "photography.dlg2"
  },
  {
   "speaker": "user",
   "text": "the small number?",
   "est_sec": 1.03,
   "gap_before": 1.61,
   "event": "ordinary_request",
   "block": "photography.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. For a landscape where you want the whole scene sharp, go with a bigger number like f eight.",
   "est_sec": 5.99,
   "gap_before": 0.53,
   "role": "reply",
   "block": "photography.dlg2"
  },
  {
   "speaker": "user",
   "text": "Got it. That makes way more sense now.",
   "est_sec": 2.58,
   "gap_before": 1.34,
   "block": "photography.dlg2"
  }
 ]
}
