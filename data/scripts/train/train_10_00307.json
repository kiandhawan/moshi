 "est_total_sec": 43.13,
 "est_speech_sec": 33.86,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.75,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.33,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "I'm tired of party bags full of plastic tat. Any better ideas?",
   "est_sec": 3.82,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "birthday_party.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Plenty. Would you rather give something useful, something edible, or something they grow?",
   "est_sec": 4.13,
   "gap_before": 0.6,
   "role": "reply",
   "block": "birthday_party.dlg30"
  },
  {
   "speaker": "user",
   "text": "Grow? Like seeds?",
   "est_sec": 1.03,
   "gap_before": 0.92,
   "event": "ordinary_request",
   "block": "birthday_party.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Yes. A small pot with sunflower seeds and a label with the child's name is cheap and kids love watching it sprout.",
   "est_sec": 6.92,
   "gap_before": 0.47,
   "role": "reply",
   "block": "birthday_party.dlg30"
  },
  {
   "speaker": "user",
   "text": "That's sweet. What about the useful option?",
   "est_sec": 2.27,
   "gap_before": 1.46,
   "event": "ordinary_request",
   "block": "birthday_party.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "A paperback book from a second hand shop, or a little set of coloured pencils. Parents will thank you.",
   "est_sec": 5.99,
   "gap_before": 1.12,
   "role": "reply",
   "block": "birthday_party.dlg30"
  },
  {
   "speaker": "user",
   "text": "Honestly, I'm sold on the sunflowers.",
   "est_sec": 1.96,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "birthday_party.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Good choice. Add a note saying who grows the tallest one by summer wins a prize.",
   "est_sec": 5.06,
   "gap_before": 0.99,
   "role": "reply",
   "block": "birthday_party.dlg30"
  }
 ]
}
