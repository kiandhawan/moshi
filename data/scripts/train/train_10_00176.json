 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.64,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.55,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "How do I research a company before an interview? I usually just skim the homepage.",
   "est_sec": 4.75,
   "gap_before": 0.36,
   "event": "ordinary_request",
   "block": "job_interview.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Go a bit deeper. Read their about page, a couple of recent news articles, and look at what they post on social media.",
   "est_sec": 7.23,
   "gap_before": 0.98,
   "role": "reply",
   "block": "job_interview.dlg20"
  },
  {
   "speaker": "user",
   "text": "That's a lot of reading.",
   "est_sec": 1.65,
   "gap_before": 3.31,
   "event": "ordinary_request",
   "block": "job_interview.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Half an hour is plenty. You're looking for two or three things you can mention naturally.",
   "est_sec": 5.06,
   "gap_before": 0.44,
   "role": "reply",
   "block": "job_interview.dlg20"
  },
  {
   "speaker": "user",
   "text": "Like what kind of things?",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "event": "ordinary_request",
   "block": "job_interview.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "A recent project, a value they talk about, or a new product. Then link it to yourself, like, I saw you launched this, and I'd love to work on something similar.",
   "est_sec": 9.71,
   "gap_before": 1.11,
   "role": "reply",
   "block": "job_interview.dlg20"
  },
  {
   "speaker": "user",
   "text": "And should I look up",
   "est_sec": 1.65,
   "gap_before": 1.39,
   "event": "distractor",
   "kind": "pause",
   "block": "job_interview.dlg20"
  },
  {
   "speaker": "user",
   "text": "the person interviewing me too?",
   "est_sec": 1.65,
   "gap_before": 2.89,
   "event": "ordinary_request",
   "block": "job_interview.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "A quick look at their professional profile is fine. Just don't bring up anything personal.",
   "est_sec": 4.75,
   "gap_before": 1.69,
   "role": "reply",
   "block": "job_interview.dlg20"
  }
 ]
