 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.43,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "My landlord wants a guarantor and I don't have anyone. What now?",
   "est_sec": 3.82,
   "gap_before": 0.32,
   "event": "ordinary_request",
   "block": "personal_finance.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "That's frustrating. Some landlords accept a larger deposit instead, or several months of rent upfront.",
   "est_sec": 4.75,
   "gap_before": 0.85,
   "role": "reply",
   "block": "personal_finance.dlg28"
  },
  {
   "speaker": "user",
   "text": "I can't afford months upfront.",
   "est_sec": 1.65,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "personal_finance.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "There are also guarantor services that act as your guarantor for a fee. They're worth looking into.",
   "est_sec": 5.37,
   "gap_before": 0.83,
   "role": "reply",
   "block": "personal_finance.dlg28"
  },
  {
   "speaker": "user",
   "text": "Are those legit?",
   "est_sec": 1.03,
   "gap_before": 1.27,
   "event": "ordinary_request",
   "block": "personal_finance.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Many are, but read reviews and check exactly what the fee covers before signing.",
   "est_sec": 4.44,
   "gap_before": 0.42,
   "role": "reply",
   "block": "personal_finance.dlg28"
  },
  {
   "speaker": "user",
   "text": "Anything else?",
   "est_sec": 0.72,
   "gap_before": 0.39,
   "event": "ordinary_request",
   "block": "personal_finance.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "You could ask the landlord if a reference from your employer and proof of steady income would be enough. Sometimes it is.",
   "est_sec": 6.92,
   "gap_before": 1.15,
   "role": "reply",
   "block": "personal_finance.dlg28"
  }
 ]
}
