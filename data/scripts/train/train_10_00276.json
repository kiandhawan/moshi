 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.9,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "Who do I need to tell when I move?",
   "est_sec": 2.89,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "moving_house.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Your bank, your employer, your doctor and dentist, and any utility companies. Don't forget the council and your insurance.",
   "est_sec": 5.99,
   "gap_before": 0.61,
   "role": "reply",
   "block": "moving_house.dlg4"
  },
  {
   "speaker": "user",
   "text": "That's a lot. Is there a way to do it all at once?",
   "est_sec": 4.13,
   "gap_before": 0.82,
   "event": "ordinary_request",
   "block": "moving_house.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Not really, but setting up mail forwarding for a few months catches anything you forget.",
   "est_sec": 4.75,
   "gap_before": 1.15,
   "role": "reply",
   "block": "moving_house.dlg4"
  },
  {
   "speaker": "user",
   "text": "Good. Oh, and the internet. Should I",
   "est_sec": 2.27,
   "gap_before": 2.06,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg4"
  },
  {
   "speaker": "user",
   "text": "set that up before I move in?",
   "est_sec": 2.27,
   "gap_before": 1.83,
   "event": "ordinary_request",
   "block": "moving_house.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Yes, as early as possible. Installation can take a couple of weeks, so book it as soon as you have the address.",
   "est_sec": 6.92,
   "gap_before": 0.67,
   "role": "reply",
   "block": "moving_house.dlg4"
  },
  {
   "speaker": "user",
   "text": "I'll do that today then.",
   "est_sec": 1.65,
   "gap_before": 1.3,
   "event": "ordinary_request",
   "block": "moving_house.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Great. Make a quick checklist too, so you can tick things off as you go.",
   "est_sec": 4.75,
   "gap_before": 0.78,
   "role": "reply",
   "block": "moving_house.dlg4"
  }
 ]
