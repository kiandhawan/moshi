 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.48,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "My lawn has yellow patches all over. What's going on?",
   "est_sec": 3.2,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Common causes are dry weather, dog pee or grubs in the soil. Do you have a dog?",
   "est_sec": 5.37,
   "gap_before": 0.31,
   "role": "reply",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "user",
   "text": "Wait, are you sure about that?",
   "est_sec": 1.96,
   "gap_before": 1.43,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_08",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Let me double-check. I'd still stand by it, but tell me what you heard.",
   "est_sec": 4.44,
   "gap_before": 1.07,
   "role": "reply",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "user",
   "text": "Yeah, a big one.",
   "est_sec": 1.34,
   "gap_before": 0.62,
   "event": "ordinary_request",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "That's likely it then. Watering the spot right after the dog goes can dilute it and stop the burn.",
   "est_sec": 5.99,
   "gap_before": 0.66,
   "role": "reply",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "user",
   "text": "I can't follow him around with a watering can all day.",
   "est_sec": 3.51,
   "gap_before": 0.96,
   "event": "ordinary_request",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Fair. You could train him to use one corner of the garden, or reseed the patches in spring.",
   "est_sec": 5.68,
   "gap_before": 0.61,
   "role": "reply",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "user",
   "text": "Reseeding sounds easier. Do I just",
   "est_sec": 1.96,
   "gap_before": 0.66,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "user",
   "text": "throw seeds on top?",
   "est_sec": 1.34,
   "gap_before": 1.79,
   "event": "ordinary_request",
   "block": "gardening.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Rake the patch first to loosen the soil, then sprinkle the seed and keep it moist for two weeks.",
   "est_sec": 5.99,
   "gap_before": 0.7,
   "role": "reply",
   "block": "gardening.dlg4"
  }
 ]
}
