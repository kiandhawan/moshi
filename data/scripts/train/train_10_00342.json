 "est_speech_sec": 37.37,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.43,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.36,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "Can I fix a chipped bathtub myself? There's a white chip on the edge.",
   "est_sec": 4.44,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "home_repair.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Small chips are very fixable. You can buy an enamel repair kit that matches standard white baths.",
   "est_sec": 5.37,
   "gap_before": 0.35,
   "role": "reply",
   "block": "home_repair.dlg17"
  },
  {
   "speaker": "user",
   "text": "Is it hard to do?",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "event": "ordinary_request",
   "block": "home_repair.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Not really. Clean and dry the chip, apply thin layers with the little brush, and let each layer dry fully.",
   "est_sec": 6.3,
   "gap_before": 0.39,
   "role": "reply",
   "block": "home_repair.dlg17"
  },
  {
   "speaker": "user",
   "text": "Will it look obvious?",
   "est_sec": 1.34,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "home_repair.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "If you go slowly and keep layers thin, it'll be hard to spot. Sanding it lightly at the end helps it blend.",
   "est_sec": 6.92,
   "gap_before": 1.02,
   "role": "reply",
   "block": "home_repair.dlg17"
  },
  {
   "speaker": "user",
   "text": "Okay. My landlord's coming",
   "est_sec": 1.34,
   "gap_before": 1.48,
   "event": "distractor",
   "kind": "pause",
   "block": "home_repair.dlg17"
  },
  {
   "speaker": "user",
   "text": "next week, so I'd better do it this weekend.",
   "est_sec": 2.89,
   "gap_before": 1.64,
   "event": "ordinary_request",
   "block": "home_repair.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Plenty of time. Just don't use the bath for a day or so after.",
   "est_sec": 4.44,
   "gap_before": 1.68,
   "role": "reply",
   "block": "home_repair.dlg17"
  }
 ]
}
