 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.98,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "Can I take my dog on a long hike?",
   "est_sec": 2.89,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "hiking.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Most healthy adult dogs love it. How old is your dog, and what breed?",
   "est_sec": 4.44,
   "gap_before": 1.68,
   "role": "reply",
   "block": "hiking.dlg4"
  },
  {
   "speaker": "user",
   "text": "She's a three year old border collie.",
   "est_sec": 2.27,
   "gap_before": 0.77,
   "event": "ordinary_request",
   "block": "hiking.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Perfect, collies have tons of energy. She'll probably outlast you. Just build up the distance gradually.",
   "est_sec": 5.06,
   "gap_before": 1.17,
   "role": "reply",
   "block": "hiking.dlg4"
  },
  {
   "speaker": "user",
   "text": "What does she need to bring?",
   "est_sec": 1.96,
   "gap_before": 0.32,
   "event": "ordinary_request",
   "block": "hiking.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Water and a collapsible bowl, some treats, and poo bags. Check her paws during breaks, rocky trails can hurt them.",
   "est_sec": 6.3,
   "gap_before": 0.72,
   "role": "reply",
   "block": "hiking.dlg4"
  },
  {
   "speaker": "user",
   "text": "Should I",
   "est_sec": 0.72,
   "gap_before": 0.48,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg4"
  },
  {
   "speaker": "user",
   "text": "keep her on the lead the whole time?",
   "est_sec": 2.58,
   "gap_before": 2.6,
   "event": "ordinary_request",
   "block": "hiking.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Check the trail rules first. Near livestock or wildlife, a lead is always the safer choice.",
   "est_sec": 5.06,
   "gap_before": 1.19,
   "role": "reply",
   "block": "hiking.dlg4"
  }
 ]
