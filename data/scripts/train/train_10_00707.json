 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.75,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.49,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "I have three days in Rome. Help me not waste them.",
   "est_sec": 3.51,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "travel_planning.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Three days is good. I'd group things by area so you're not crossing the city all the time.",
   "est_sec": 5.68,
   "gap_before": 0.99,
   "role": "reply",
   "block": "travel_planning.dlg15"
  },
  {
   "speaker": "user",
   "text": "Okay, how?",
   "est_sec": 0.72,
   "gap_before": 0.85,
   "event": "ordinary_request",
   "block": "travel_planning.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Day one, the Colosseum and the Forum. Day two, the Vatican museums and Saint Peter's. Day three, wander the center, Trevi Fountain and the Pantheon.",
   "est_sec": 7.85,
   "gap_before": 0.87,
   "role": "reply",
   "block": "travel_planning.dlg15"
  },
  {
   "speaker": "user",
   "text": "Do I need to book things?",
   "est_sec": 1.96,
   "gap_before": 1.03,
   "event": "ordinary_request",
   "block": "travel_planning.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Yes, book the Colosseum and the Vatican ahead online. The queues without tickets can be hours long.",
   "est_sec": 5.37,
   "gap_before": 0.44,
   "role": "reply",
   "block": "travel_planning.dlg15"
  },
  {
   "speaker": "user",
   "text": "Hours. Wow. And I want",
   "est_sec": 1.65,
   "gap_before": 0.33,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg15"
  },
  {
   "speaker": "user",
   "text": "one really good dinner somewhere.",
   "est_sec": 1.65,
   "gap_before": 2.71,
   "event": "ordinary_request",
   "block": "travel_planning.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Try Trastevere in the evening. Walk the side streets and pick a place where you hear more Italian than English.",
   "est_sec": 6.3,
   "gap_before": 0.65,
   "role": "reply",
   "block": "travel_planning.dlg15"
  }
 ]
