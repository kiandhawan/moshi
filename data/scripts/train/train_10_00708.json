 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.45,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.59,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "I just inherited my grandpa's record collection. Boxes and boxes of it.",
   "est_sec": 3.82,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "music.ctx7"
  },
  {
   "speaker": "moshi",
   "text": "What a treasure. Do you want to get a turntable and play them as they are, or digitise them so they're safe?",
   "est_sec": 6.92,
   "gap_before": 1.8,
   "role": "reply",
   "block": "music.ctx7"
  },
  {
   "speaker": "user",
   "text": "Wait for me, I need to talk to Sam about something. Don't say a word until I'm back.",
   "est_sec": 5.68,
   "gap_before": 1.02,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_28"
  },
  {
   "speaker": "moshi",
   "text": "Got it.",
   "est_sec": 0.72,
   "gap_before": 0.47,
   "role": "ack",
   "phrasing": "ack_07"
  },
  {
   "speaker": "user",
   "text": "Sam, did you send the invites yet?",
   "est_sec": 2.27,
   "gap_before": 1.21,
   "event": "distractor",
   "kind": "friend_question",
   "block": "birthday_party.side1"
  },
  {
   "speaker": "friend",
   "text": "Most of them. I'm still missing a few addresses.",
   "est_sec": 2.89,
   "gap_before": 0.71,
   "block": "birthday_party.side1"
  },
  {
   "speaker": "user",
   "text": "Whose?",
   "est_sec": 0.41,
   "gap_before": 1.29,
   "event": "distractor",
   "kind": "friend_question",
   "block": "birthday_party.side1"
  },
  {
   "speaker": "friend",
   "text": "The neighbors from upstairs and your cousin.",
   "est_sec": 2.27,
   "gap_before": 1.28,
   "block": "birthday_party.side1"
  },
  {
   "speaker": "user",
   "text": "I'll text you my cousin's. Just knock on the neighbors' door, they're always home.",
   "est_sec": 4.44,
   "gap_before": 0.91,
   "block": "birthday_party.side1"
  },
  {
   "speaker": "friend",
   "text": "Okay, I'll do it tonight.",
   "est_sec": 1.65,
   "gap_before": 2.33,
   "block": "birthday_party.side1"
  },
  {
   "speaker": "user",
   "text": "Sorry, I stepped on your foot.",
   "est_sec": 1.96,
   "gap_before": 1.15,
   "event": "distractor",
   "kind": "near_miss",
   "phrasing": "dn_27"
  },
  {
   "speaker": "friend",
   "text": "It's fine, I've got thick socks.",
   "est_sec": 1.96,
   "gap_before": 1.74,
   "phrasing": "dn_27"
  },
  {
   "speaker": "user",
   "text": "Okay, that's sorted. I'm back.",
   "est_sec": 1.65,
   "gap_before": 1.93,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_08"
  },
  {
   "speaker": "moshi",
   "text": "No problem. Back to that record collection. Which way are you leaning?",
   "est_sec": 3.82,
   "gap_before": 0.79,
   "role": "resume",
   "block": "music.ctx7"
  },
  {
   "speaker": "user",
   "text": "Turntable. I want to hear them how he did.",
   "est_sec": 2.89,
   "gap_before": 1.42,
   "event": "ordinary_request",
   "block": "music.ctx7"
  },
  {
   "speaker": "moshi",
   "text": "That's lovely. Get a turntable with a decent needle, cheap ones can wear the grooves down.",
