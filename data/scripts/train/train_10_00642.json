   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "cooking.ctx3"
  },
  {
   "speaker": "moshi",
   "text": "No rush, it really depends on how much variety you need.",
   "est_sec": 3.51,
   "gap_before": 0.42,
   "role": "reply",
   "block": "cooking.ctx3"
  },
  {
   "speaker": "user",
   "text": "Wait a moment, my coworker is here. Please be quiet until I tell you I'm back.",
   "est_sec": 5.06,
   "gap_before": 0.58,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_14"
  },
  {
   "speaker": "user",
   "text": "Wait, are you back for good or just visiting?",
