   "event": "distractor",
   "kind": "near_miss",
   "phrasing": "dn_08"
  },
  {
   "speaker": "friend",
   "text": "Just for the weekend.",
   "est_sec": 1.34,
   "gap_before": 0.79,
   "phrasing": "dn_08"
  },
  {
   "speaker": "user",
   "text": "Ben, which of these two pans do you think is better?",
