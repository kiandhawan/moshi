   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "I'm trying to meal prep lunches for the week. Cheap and not boring, please.",
   "est_sec": 4.44,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "cooking.ctx3"
  },
  {
   "speaker": "moshi",
   "text": "Sure. Do you want one big batch of the same thing, like a chili, or two smaller recipes you can alternate?",
   "est_sec": 6.61,
   "gap_before": 0.34,
   "role": "reply",
   "block": "cooking.ctx3"
  },
  {
   "speaker": "user",
   "text": "Hmm, good question.",
