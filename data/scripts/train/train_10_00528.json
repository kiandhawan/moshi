 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.52,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.36,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "I'm at the big choice in this story game. The traitor's on his knees begging.",
   "est_sec": 4.75,
   "gap_before": 0.3,
   "event": "ordinary_request",
   "block": "video_games.ctx11"
  },
  {
   "speaker": "moshi",
   "text": "Ooh, tense. Are you going to spare him and hope he redeems himself, or banish him from the kingdom for good?",
   "est_sec": 6.61,
   "gap_before": 0.69,
   "role": "reply",
   "block": "video_games.ctx11"
  },
  {
   "speaker": "user",
   "text": "Wait a moment, my coworker is here. Please be quiet until I tell you I'm back.",
   "est_sec": 5.06,
   "gap_before": 1.02,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_14"
  },
  {
   "speaker": "moshi",
   "text": "Sure, go ahead.",
   "est_sec": 1.03,
   "gap_before": 0.31,
   "role": "ack",
   "phrasing": "ack_08"
  },
  {
   "speaker": "user",
   "text": "Grace, can you help me lift these compost bags out of the boot?",
   "est_sec": 4.13,
   "gap_before": 1.3,
   "event": "distractor",
   "kind": "friend_question",
   "block": "gardening.side4"
  },
  {
   "speaker": "friend",
   "text": "Sure. Why are there five of them?",
   "est_sec": 2.27,
   "gap_before": 0.78,
   "block": "gardening.side4"
  },
  {
   "speaker": "user",
   "text": "They were on offer. Three for the price of two.",
   "est_sec": 3.2,
   "gap_before": 0.9,
   "block": "gardening.side4"
  },
  {
   "speaker": "friend",
   "text": "So you bought five.",
   "est_sec": 1.34,
   "gap_before": 0.84,
   "block": "gardening.side4"
  },
  {
   "speaker": "user",
   "text": "I know how maths works, thank you.",
   "est_sec": 2.27,
   "gap_before": 3.26,
   "block": "gardening.side4"
  },
  {
   "speaker": "friend",
   "text": "Wow, this one's leaking.",
   "est_sec": 1.34,
   "gap_before": 2.31,
   "block": "gardening.side4"
  },
  {
   "speaker": "user",
   "text": "Yeah, mind your shoes. Where do you reckon we stack them?",
   "est_sec": 3.51,
   "gap_before": 0.54,
   "event": "distractor",
   "kind": "friend_question",
   "block": "gardening.side4"
  },
  {
   "speaker": "friend",
   "text": "By the shed, under the tarp. And please hoover the car later.",
   "est_sec": 3.82,
   "gap_before": 0.77,
   "block": "gardening.side4"
  },
  {
   "speaker": "user",
   "text": "Okay, we can continue now.",
