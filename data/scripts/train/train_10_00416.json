   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "My study group wants to meet this weekend but I keep getting distracted when we do.",
   "est_sec": 5.06,
   "gap_before": 0.34,
   "event": "ordinary_request",
   "block": "studying.ctx2"
  },
  {
   "speaker": "moshi",
   "text": "Would it help to meet somewhere quieter, like the library, or to set a fixed agenda before you start?",
   "est_sec": 5.99,
   "gap_before": 0.92,
   "role": "reply",
   "block": "studying.ctx2"
  },
  {
   "speaker": "user",
   "text": "Give me a minute, my friend just walked in. Don't say anything until I'm back.",
   "est_sec": 4.75,
   "gap_before": 1.4,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_02"
  },
  {
   "speaker": "moshi",
   "text": "Okay, sure.",
   "est_sec": 0.72,
   "gap_before": 0.39,
   "role": "ack",
   "phrasing": "ack_16"
  },
  {
