   "gap_before": 1.83,
   "event": "distractor",
   "kind": "friend_question",
   "block": "gardening.side3"
  },
  {
   "speaker": "friend",
   "text": "Not really, anything thicker than a finger you'll need loppers for.",
   "est_sec": 3.51,
   "gap_before": 0.62,
   "block": "gardening.side3"
  },
  {
   "speaker": "user",
   "text": "Got it. I'll bring it back Sunday evening.",
   "est_sec": 2.58,
   "gap_before": 0.78,
   "block": "gardening.side3"
  },
  {
   "speaker": "friend",
   "text": "No rush. Just don't drop it in the pond like last time.",
   "est_sec": 3.82,
   "gap_before": 1.45,
   "block": "gardening.side3"
  },
  {
   "speaker": "user",
   "text": "That was one time!",
   "est_sec": 1.34,
   "gap_before": 2.31,
   "block": "gardening.side3"
  },
  {
