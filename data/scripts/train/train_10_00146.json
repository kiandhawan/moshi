 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.99,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "Give me some party game ideas for a bunch of eight year olds.",
   "est_sec": 4.13,
   "gap_before": 0.41,
   "event": "ordinary_request",
   "block": "birthday_party.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Musical chairs and freeze dance are always hits. A treasure hunt with little clues around the yard is great too.",
   "est_sec": 6.3,
   "gap_before": 1.06,
   "role": "reply",
   "block": "birthday_party.dlg1"
  },
  {
   "speaker": "user",
   "text": "Ooh, a treasure hunt. How would that work?",
   "est_sec": 2.58,
   "gap_before": 0.83,
   "event": "ordinary_request",
   "block": "birthday_party.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Hide simple rhyming clues that lead from one spot to the next, ending at a box of small prizes.",
   "est_sec": 5.99,
   "gap_before": 0.94,
   "role": "reply",
   "block": "birthday_party.dlg1"
  },
  {
   "speaker": "user",
   "text": "I'm not great at rhymes",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg1"
  },
  {
   "speaker": "user",
   "text": "could you give me one example?",
   "est_sec": 1.96,
   "gap_before": 1.83,
   "event": "ordinary_request",
   "block": "birthday_party.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Sure. Where you wash your hands each day, the next clue is hiding away. That one leads to the bathroom sink.",
   "est_sec": 6.61,
   "gap_before": 0.97,
   "role": "reply",
   "block": "birthday_party.dlg1"
  },
  {
   "speaker": "user",
   "text": "Ha, perfect. How many clues should I do?",
   "est_sec": 2.58,
   "gap_before": 0.32,
   "event": "ordinary_request",
   "block": "birthday_party.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Six to eight is about right for that age. Long enough to be exciting, short enough that nobody gets bored.",
   "est_sec": 6.3,
   "gap_before": 0.57,
   "role": "reply",
   "block": "birthday_party.dlg1"
  }
 ]
}
