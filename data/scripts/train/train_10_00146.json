 "est_total_sec": 46.86,
 "est_speech_sec": 36.96,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.66,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "I work late and take the last bus home. Sometimes it feels a bit sketchy.",
   "est_sec": 4.75,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "public_transport.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "That's understandable. Sitting near the driver is one of the simplest things you can do, there's always someone watching that area.",
   "est_sec": 6.61,
   "gap_before": 0.68,
   "role": "reply",
   "block": "public_transport.dlg9"
  },
  {
   "speaker": "user",
   "text": "What if someone",
   "est_sec": 1.03,
   "gap_before": 0.52,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg9"
  },
  {
   "speaker": "user",
   "text": "starts bothering me?",
   "est_sec": 1.03,
   "gap_before": 2.82,
   "event": "ordinary_request",
   "block": "public_transport.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Move seats, tell the driver, or get off at a busy stop. Most buses have a way to alert the driver quickly.",
   "est_sec": 6.92,
   "gap_before": 0.51,
   "role": "reply",
   "block": "public_transport.dlg9"
  },
  {
   "speaker": "user",
   "text": "I also have a long walk from the stop.",
   "est_sec": 2.89,
   "gap_before": 1.49,
   "event": "ordinary_request",
   "block": "public_transport.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Share your location with a friend or housemate, and keep your keys ready before you get off. Some services also let you request a stop closer to your home at night.",
   "est_sec": 9.71,
   "gap_before": 0.41,
   "role": "reply",
   "block": "public_transport.dlg9"
  },
  {
   "speaker": "user",
   "text": "Really? I'll ask about that.",
   "est_sec": 1.65,
   "gap_before": 0.39,
   "block": "public_transport.dlg9"
  }
 ]
}
