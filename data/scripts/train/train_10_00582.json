 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.96,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "How many push-ups should a beginner aim for?",
   "est_sec": 2.58,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "fitness.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Start with however many you can do with good form, even if it's five. Do three sets and try to add one rep each week.",
   "est_sec": 7.85,
   "gap_before": 1.06,
   "role": "reply",
   "block": "fitness.dlg1"
  },
  {
   "speaker": "user",
   "text": "What if I can't do a single one?",
   "est_sec": 2.58,
   "gap_before": 0.89,
   "event": "ordinary_request",
   "block": "fitness.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Then start with push-ups against a wall or a kitchen counter. As those get easy, move lower, to a chair and then the floor.",
   "est_sec": 7.54,
   "gap_before": 1.09,
   "role": "reply",
   "block": "fitness.dlg1"
  },
  {
   "speaker": "user",
   "text": "Knee push-ups count too, right?",
   "est_sec": 1.65,
   "gap_before": 2.93,
   "event": "ordinary_request",
   "block": "fitness.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Absolutely. They build the same muscles and they're a great step towards full push-ups.",
   "est_sec": 4.44,
   "gap_before": 1.02,
   "role": "reply",
   "block": "fitness.dlg1"
  },
  {
   "speaker": "user",
   "text": "Cool. And how often should I",
   "est_sec": 1.96,
   "gap_before": 0.96,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg1"
  },
  {
   "speaker": "user",
   "text": "do them, every day?",
   "est_sec": 1.34,
   "gap_before": 3.0,
   "event": "ordinary_request",
   "block": "fitness.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Every other day is better at first. Your muscles grow during the rest days.",
   "est_sec": 4.44,
   "gap_before": 1.01,
   "role": "reply",
   "block": "fitness.dlg1"
  }
 ]
}
