 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.98,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "My daughter wants a hamster for her birthday. Are they good first pets?",
   "est_sec": 4.13,
   "gap_before": 0.4,
   "event": "ordinary_request",
   "block": "pets.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "They can be, but they're awake mostly at night and can nip if handled roughly. How old is she?",
   "est_sec": 5.99,
   "gap_before": 0.52,
   "role": "reply",
   "block": "pets.dlg2"
  },
  {
   "speaker": "user",
   "text": "She's turning eight.",
   "est_sec": 1.03,
   "gap_before": 3.25,
   "event": "ordinary_request",
   "block": "pets.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "That's a fine age with some supervision. A big cage, a wheel and a deep layer of bedding are the essentials.",
   "est_sec": 6.61,
   "gap_before": 1.01,
   "role": "reply",
   "block": "pets.dlg2"
  },
  {
   "speaker": "user",
   "text": "Would a guinea pig be better? I've heard",
   "est_sec": 2.58,
   "gap_before": 1.89,
   "event": "distractor",
   "kind": "pause",
   "block": "pets.dlg2"
  },
  {
   "speaker": "user",
   "text": "they're friendlier.",
   "est_sec": 0.72,
   "gap_before": 2.02,
   "event": "ordinary_request",
   "block": "pets.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Guinea pigs are usually calmer and awake during the day, so they're great with kids. But they're happier in pairs.",
   "est_sec": 6.3,
   "gap_before": 0.8,
   "role": "reply",
   "block": "pets.dlg2"
  },
  {
   "speaker": "user",
   "text": "Two of them? That's double the cleaning.",
   "est_sec": 2.27,
   "gap_before": 1.35,
   "event": "ordinary_request",
   "block": "pets.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "True, but one cage and they keep each other company. It's honestly not much more work.",
   "est_sec": 5.06,
   "gap_before": 0.82,
   "role": "reply",
   "block": "pets.dlg2"
  }
 ]
}
