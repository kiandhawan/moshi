 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.91,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "We've bought a house, but my son is halfway through the school year.",
   "est_sec": 4.13,
   "gap_before": 0.25,
   "event": "ordinary_request",
   "block": "moving_house.ctx12"
  },
  {
   "speaker": "moshi",
   "text": "Tricky timing. Is the new house in a different school area?",
   "est_sec": 3.51,
   "gap_before": 0.41,
   "role": "reply",
   "block": "moving_house.ctx12"
  },
  {
   "speaker": "user",
   "text": "Yes, twenty minutes away.",
   "est_sec": 1.34,
   "gap_before": 1.5,
   "event": "ordinary_request",
   "block": "moving_house.ctx12"
  },
  {
   "speaker": "moshi",
   "text": "Then you could move now and switch schools mid year, or move now and drive him to his old school until summer. Which would he prefer?",
   "est_sec": 8.16,
   "gap_before": 0.7,
   "role": "reply",
   "block": "moving_house.ctx12"
  },
  {
   "speaker": "user",
   "text": "Hold that thought, I need to talk to Ryan real quick. Stay quiet until I return.",
   "est_sec": 5.06,
   "gap_before": 1.42,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_07"
  },
  {
   "speaker": "user",
   "text": "Are you hungry?",
   "est_sec": 1.03,
   "gap_before": 1.08,
   "event": "distractor",
   "kind": "friend_question",
   "phrasing": "dq_19"
  },
  {
   "speaker": "friend",
   "text": "A little, yeah.",
   "est_sec": 1.03,
   "gap_before": 1.29,
   "phrasing": "dq_19"
  },
  {
   "speaker": "user",
   "text": "Ryan, are you sure the sofa will fit through the door?",
   "est_sec": 3.51,
   "gap_before": 0.47,
   "event": "distractor",
   "kind": "friend_question",
   "block": "moving_house.side3"
  },
  {
   "speaker": "friend",
   "text": "I measured it twice. It's tight, but it should go.",
   "est_sec": 3.2,
   "gap_before": 0.76,
   "block": "moving_house.side3"
  },
  {
   "speaker": "user",
   "text": "What if we have to take the legs off?",
   "est_sec": 2.89,
   "gap_before": 0.5,
   "event": "distractor",
   "kind": "friend_question",
   "block": "moving_house.side3"
  },
  {
   "speaker": "friend",
   "text": "Then we take the legs off. I've got a screwdriver in my bag.",
   "est_sec": 4.13,
   "gap_before": 0.43,
   "block": "moving_house.side3"
  },
  {
   "speaker": "user",
   "text": "Okay. And the stairs?",
   "est_sec": 1.34,
   "gap_before": 0.63,
   "event": "distractor",
   "kind": "friend_question",
   "block": "moving_house.side3"
  },
  {
   "speaker": "friend",
   "text": "Let's not think about the stairs yet.",
   "est_sec": 2.27,
   "gap_before": 0.35,
   "block": "moving_house.side3"
  },
  {
   "speaker": "user",
   "text": "Okay, finished. I'm back now.",
   "est_sec": 1.65,
   "gap_before": 1.14,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_14"
  },
  {
   "speaker": "moshi",
   "text": "Okay. So, your son. New school mid year, or the school run until summer?",
   "est_sec": 4.44,
   "gap_before": 1.02,
   "role": "resume",
   "block": "moving_house.ctx12"
  },
  {
   "speaker": "user",
   "text": "We'll drive him. He's got exams and his friends are there.",
   "est_sec": 3.51,
   "gap_before": 0.99,
   "event": "ordinary_request",
   "block": "moving_house.ctx12"
  },
  {
   "speaker": "moshi",
   "text": "Sensible. It's only a few months, and he can visit the new school before September.",
   "est_sec": 4.75,
   "gap_before": 0.63,
   "role": "followup",
   "block": "moving_house.ctx12"
  }
 ]
