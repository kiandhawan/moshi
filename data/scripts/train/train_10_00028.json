 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.42,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "Is it actually dangerous to leave cooked rice out overnight? My flatmate does it all the time.",
   "est_sec": 5.37,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "cooking.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "It can be. Rice can carry bacteria spores that survive cooking and multiply at room temperature.",
   "est_sec": 5.06,
   "gap_before": 0.49,
   "role": "reply",
   "block": "cooking.dlg13"
  },
  {
   "speaker": "user",
   "text": "But he's never been sick.",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "cooking.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Lots of people get lucky. It's still better to cool rice within an hour and put it in the fridge.",
   "est_sec": 6.3,
   "gap_before": 0.81,
   "role": "reply",
   "block": "cooking.dlg13"
  },
  {
   "speaker": "user",
   "text": "How do you cool it that fast?",
   "est_sec": 2.27,
   "gap_before": 1.19,
   "event": "ordinary_request",
   "block": "cooking.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Spread it out on a plate or tray. It cools much quicker than in a deep pot.",
   "est_sec": 5.37,
   "gap_before": 0.44,
   "role": "reply",
   "block": "cooking.dlg13"
  },
  {
   "speaker": "user",
   "text": "And reheating, is once enough",
   "est_sec": 1.65,
   "gap_before": 1.12,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg13"
  },
  {
   "speaker": "user",
   "text": "or can you do it again?",
   "est_sec": 1.96,
   "gap_before": 2.91,
   "event": "ordinary_request",
   "block": "cooking.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Just once, and make sure it's steaming hot all the way through.",
   "est_sec": 3.82,
   "gap_before": 0.3,
   "role": "reply",
   "block": "cooking.dlg13"
  }
 ]
}
