 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.75,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.52,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "I tried running today and I was gasping after one minute. Is something wrong with me?",
   "est_sec": 5.06,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "fitness.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Not at all, that's really normal when you're starting out. Most beginners go too fast.",
   "est_sec": 4.75,
   "gap_before": 0.97,
   "role": "reply",
   "block": "fitness.dlg5"
  },
  {
   "speaker": "user",
   "text": "I wasn't even going fast. I don't think.",
   "est_sec": 2.58,
   "gap_before": 1.27,
   "event": "ordinary_request",
   "block": "fitness.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Try slowing down until you could hold a conversation. It'll feel almost silly slow.",
   "est_sec": 4.44,
   "gap_before": 0.87,
   "role": "reply",
   "block": "fitness.dlg5"
  },
  {
   "speaker": "user",
   "text": "And if I still can't last?",
   "est_sec": 1.96,
   "gap_before": 1.29,
   "event": "ordinary_request",
   "block": "fitness.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Mix running and walking. Run one minute, walk two, and repeat that six or seven times.",
   "est_sec": 5.06,
   "gap_before": 0.7,
   "role": "reply",
   "block": "fitness.dlg5"
  },
  {
   "speaker": "user",
   "text": "That sounds doable. How often",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg5"
  },
  {
   "speaker": "user",
   "text": "should I go out?",
   "est_sec": 1.34,
   "gap_before": 2.2,
   "event": "ordinary_request",
   "block": "fitness.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Three times a week, with a rest day in between. Each week, run a little longer and walk a little less.",
   "est_sec": 6.61,
   "gap_before": 0.36,
   "role": "reply",
   "block": "fitness.dlg5"
  }
 ]
