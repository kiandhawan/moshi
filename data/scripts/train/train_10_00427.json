 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.67,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.94,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "I get really motion sick on buses. Is there anything that helps?",
   "est_sec": 3.82,
   "gap_before": 0.27,
   "event": "ordinary_request",
   "block": "public_transport.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Sit near the front, facing forward, and look out the window at the horizon. Reading or scrolling usually makes it worse.",
   "est_sec": 6.61,
   "gap_before": 0.45,
   "role": "reply",
   "block": "public_transport.dlg2"
  },
  {
   "speaker": "user",
   "text": "I always read",
   "est_sec": 1.03,
   "gap_before": 0.77,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg2"
  },
  {
   "speaker": "user",
   "text": "on my commute, though.",
   "est_sec": 1.34,
   "gap_before": 2.14,
   "event": "ordinary_request",
   "block": "public_transport.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Audiobooks or podcasts are a great swap. You keep the story without staring at a page.",
   "est_sec": 5.06,
   "gap_before": 0.97,
   "role": "reply",
   "block": "public_transport.dlg2"
  },
  {
   "speaker": "user",
   "text": "Hmm, I never thought of that. Anything else?",
   "est_sec": 2.58,
   "gap_before": 1.07,
   "event": "ordinary_request",
   "block": "public_transport.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Fresh air helps, so open a window if you can. Some people also find ginger candies settle their stomach.",
   "est_sec": 5.99,
   "gap_before": 0.75,
   "role": "reply",
   "block": "public_transport.dlg2"
  },
  {
