 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.73,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "Can I bring my dog to a cafe? I've never tried it.",
   "est_sec": 3.82,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "pets.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Lots of cafes welcome dogs, just check first. Go at a quieter time for your first visit so it's not overwhelming.",
   "est_sec": 6.61,
   "gap_before": 0.96,
   "role": "reply",
   "block": "pets.dlg21"
  },
  {
   "speaker": "user",
   "text": "He's quite excitable around food.",
   "est_sec": 1.65,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "pets.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Then walk him well beforehand, so he's tired. Bring a mat and a long lasting chew so he has a job to do under the table.",
   "est_sec": 8.16,
   "gap_before": 0.9,
   "role": "reply",
   "block": "pets.dlg21"
  },
  {
   "speaker": "user",
   "text": "What if he barks?",
   "est_sec": 1.34,
   "gap_before": 0.89,
   "event": "ordinary_request",
   "block": "pets.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Calmly take him outside for a minute, then try again. If he can't settle, keep the visit short and try again another day.",
   "est_sec": 7.23,
   "gap_before": 0.33,
   "role": "reply",
   "block": "pets.dlg21"
  },
  {
   "speaker": "user",
   "text": "And a water bowl?",
   "est_sec": 1.34,
   "gap_before": 1.16,
   "event": "ordinary_request",
   "block": "pets.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Many places put one out, but a collapsible bowl in your bag is handy. Short positive visits will teach him cafes are boring, which is the goal.",
   "est_sec": 8.47,
   "gap_before": 1.73,
   "role": "reply",
   "block": "pets.dlg21"
  }
 ]
}
