 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.44,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.72,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "We're moving out at the end of the month and I really want my deposit back.",
   "est_sec": 5.06,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "cleaning.ctx5"
  },
  {
   "speaker": "moshi",
   "text": "Landlords look hard at kitchens and bathrooms. Do you want to book a professional end of tenancy clean, or do it yourselves?",
   "est_sec": 6.92,
   "gap_before": 0.88,
   "role": "reply",
   "block": "cleaning.ctx5"
  },
  {
   "speaker": "user",
   "text": "Hold that thought, I need to talk to Nina real quick. Stay quiet until I return.",
   "est_sec": 5.06,
   "gap_before": 0.55,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_07"
  },
  {
   "speaker": "user",
   "text": "Nina, did you pay the electric bill this month or was it my turn?",
   "est_sec": 4.44,
   "gap_before": 1.48,
   "event": "distractor",
   "kind": "friend_question",
   "block": "personal_finance.side1"
  },
  {
   "speaker": "friend",
   "text": "I paid it last month, so it's yours.",
   "est_sec": 2.58,
   "gap_before": 0.76,
   "block": "personal_finance.side1"
  },
  {
   "speaker": "user",
   "text": "Right. How much was it again?",
   "est_sec": 1.96,
   "gap_before": 1.45,
   "event": "distractor",
   "kind": "friend_question",
   "block": "personal_finance.side1"
  },
  {
   "speaker": "friend",
   "text": "Around ninety, I think. It went up because of the heater.",
   "est_sec": 3.51,
   "gap_before": 0.65,
   "block": "personal_finance.side1"
  },
  {
   "speaker": "user",
   "text": "Okay, I'll send you half of the internet too while I'm at it.",
   "est_sec": 4.13,
   "gap_before": 1.34,
   "block": "personal_finance.side1"
  },
  {
   "speaker": "friend",
   "text": "Thanks, no rush.",
   "est_sec": 1.03,
   "gap_before": 0.81,
   "block": "personal_finance.side1"
  },
  {
   "speaker": "user",
   "text": "Nina, have you got any cash on you?",
   "est_sec": 2.58,
   "gap_before": 1.17,
   "event": "distractor",
   "kind": "friend_question",
   "phrasing": "dq_43"
  },
  {
   "speaker": "friend",
   "text": "Maybe a few coins.",
   "est_sec": 1.34,
   "gap_before": 0.39,
   "phrasing": "dq_43"
  },
  {
   "speaker": "user",
   "text": "Okay, finished. I'm back now.",
   "est_sec": 1.65,
   "gap_before": 1.85,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_14"
  },
  {
   "speaker": "moshi",
   "text": "Sure thing. So, the end of tenancy clean. Who's doing it?",
   "est_sec": 3.51,
   "gap_before": 0.39,
   "role": "resume",
   "block": "cleaning.ctx5"
  },
  {
   "speaker": "user",
   "text": "We'll do it ourselves. Four of us, one long Saturday.",
   "est_sec": 3.2,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "cleaning.ctx5"
  },
  {
   "speaker": "moshi",
   "text": "Very doable with four. Split it by room and save the oven for whoever loses rock paper scissors.",
   "est_sec": 5.68,
   "gap_before": 1.36,
