 "est_total_sec": 44.51,
 "est_speech_sec": 33.55,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.69,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.76,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "Our front path is a sheet of ice. Salt or grit?",
   "est_sec": 3.51,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "weather_plans.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Grit is just salt mixed with sand or small stones. Salt melts the ice, grit also adds some grip.",
   "est_sec": 5.99,
   "gap_before": 0.36,
   "role": "reply",
   "block": "weather_plans.dlg20"
  },
  {
   "speaker": "user",
   "text": "I have table salt. Does that work?",
   "est_sec": 2.27,
   "gap_before": 0.85,
   "event": "ordinary_request",
   "block": "weather_plans.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "It does, for a small area. Sprinkle it thinly before the ice forms, it works best that way.",
   "est_sec": 5.68,
   "gap_before": 0.32,
   "role": "reply",
   "block": "weather_plans.dlg20"
  },
  {
   "speaker": "user",
   "text": "What about hot water?",
   "est_sec": 1.34,
   "gap_before": 0.97,
   "event": "ordinary_request",
   "block": "weather_plans.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Avoid it. It melts the ice for a bit, then refreezes, often even slipperier.",
   "est_sec": 4.44,
   "gap_before": 1.06,
   "role": "reply",
   "block": "weather_plans.dlg20"
  },
  {
   "speaker": "user",
   "text": "Oh no, I did that this morning.",
   "est_sec": 2.27,
   "gap_before": 3.26,
   "event": "ordinary_request",
   "block": "weather_plans.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Easy mistake. Scatter some salt on it now and wear shoes with good soles until it's gone.",
   "est_sec": 5.37,
   "gap_before": 0.65,
   "role": "reply",
   "block": "weather_plans.dlg20"
  }
 ]
}
