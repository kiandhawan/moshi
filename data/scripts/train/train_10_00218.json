 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.94,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "I'm sixty three and applying for a part time job at a garden centre. I'm worried they'll think I'm overqualified.",
   "est_sec": 6.3,
   "gap_before": 0.21,
   "event": "ordinary_request",
   "block": "job_interview.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "What did you do before?",
   "est_sec": 1.65,
   "gap_before": 1.08,
   "role": "reply",
   "block": "job_interview.dlg9"
  },
  {
   "speaker": "user",
   "text": "Thirty years as a bank branch manager.",
   "est_sec": 2.27,
   "gap_before": 2.0,
   "event": "ordinary_request",
   "block": "job_interview.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "That's a lot of experience with customers and teams. The key is showing why you genuinely want this particular job now.",
   "est_sec": 6.61,
   "gap_before": 0.79,
   "role": "reply",
   "block": "job_interview.dlg9"
  },
  {
   "speaker": "user",
   "text": "Honestly, I just love plants and I want less stress.",
   "est_sec": 3.2,
   "gap_before": 1.07,
   "event": "ordinary_request",
   "block": "job_interview.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Say exactly that. It's honest and it reassures them you won't leave for something bigger in a month.",
   "est_sec": 5.68,
   "gap_before": 0.56,
   "role": "reply",
   "block": "job_interview.dlg9"
  },
  {
   "speaker": "user",
   "text": "Should I play down the manager thing",
   "est_sec": 2.27,
   "gap_before": 1.49,
   "event": "distractor",
   "kind": "pause",
   "block": "job_interview.dlg9"
  },
  {
   "speaker": "user",
   "text": "or is that silly?",
   "est_sec": 1.34,
   "gap_before": 3.0,
   "event": "ordinary_request",
   "block": "job_interview.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Don't hide it. Just frame it as, I've done the big job, now I want to work with my hands and help people.",
   "est_sec": 7.23,
   "gap_before": 0.95,
   "role": "reply",
   "block": "job_interview.dlg9"
  }
 ]
}
