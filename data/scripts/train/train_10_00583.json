 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.79,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.61,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "The puppy peed on the rug again. It's the third time this week.",
   "est_sec": 4.13,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "cleaning.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Puppies, eh. Blot up as much as you can with kitchen paper, pressing hard. Don't rub.",
   "est_sec": 5.06,
   "gap_before": 0.94,
   "role": "reply",
   "block": "cleaning.dlg27"
  },
  {
   "speaker": "user",
   "text": "Done. Now?",
   "est_sec": 0.72,
   "gap_before": 3.25,
   "event": "ordinary_request",
   "block": "cleaning.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Use an enzyme cleaner if you have one. It breaks down the smell completely, otherwise the puppy smells it and goes there again.",
   "est_sec": 7.23,
   "gap_before": 1.91,
   "role": "reply",
   "block": "cleaning.dlg27"
  },
  {
   "speaker": "user",
   "text": "I don't have one. I could",
   "est_sec": 1.96,
   "gap_before": 0.49,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg27"
  },
  {
   "speaker": "user",
   "text": "get one tomorrow?",
   "est_sec": 1.03,
   "gap_before": 1.71,
   "event": "ordinary_request",
   "block": "cleaning.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "For tonight, a mix of white vinegar and water helps, then baking soda once it's dry. Get the enzyme cleaner tomorrow for a proper fix.",
   "est_sec": 7.85,
   "gap_before": 0.67,
   "role": "reply",
   "block": "cleaning.dlg27"
  },
  {
   "speaker": "user",
   "text": "And the training part?",
   "est_sec": 1.34,
   "gap_before": 1.46,
   "event": "ordinary_request",
   "block": "cleaning.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Take her out right after meals and naps, and praise her like crazy when she goes outside.",
   "est_sec": 5.37,
   "gap_before": 1.2,
   "role": "reply",
   "block": "cleaning.dlg27"
  }
 ]
