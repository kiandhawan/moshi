 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.62,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.58,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "My sister and I are going to the Christmas markets in Germany. What do I wear? I'm from Florida.",
   "est_sec": 5.99,
   "gap_before": 0.23,
   "event": "ordinary_request",
   "block": "travel_planning.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Layers, lots of them. It can be around freezing, and you'll be standing outside for hours.",
   "est_sec": 5.06,
   "gap_before": 0.81,
   "role": "reply",
   "block": "travel_planning.dlg22"
  },
  {
   "speaker": "user",
   "text": "Freezing. Okay. I own exactly one coat.",
   "est_sec": 2.27,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "travel_planning.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Make sure it's warm and ideally waterproof. Add thermal underwear, a thick jumper, a hat, a scarf and gloves.",
   "est_sec": 5.99,
   "gap_before": 1.19,
   "role": "reply",
   "block": "travel_planning.dlg22"
  },
  {
   "speaker": "user",
   "text": "Thermal underwear. Very glamorous.",
   "est_sec": 1.34,
   "gap_before": 0.93,
   "event": "ordinary_request",
   "block": "travel_planning.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "It's the secret of every happy market visitor. Good boots with thick socks matter too, cold feet ruin everything.",
   "est_sec": 5.99,
   "gap_before": 0.73,
   "role": "reply",
   "block": "travel_planning.dlg22"
  },
  {
   "speaker": "user",
   "text": "And the mulled wine",
   "est_sec": 1.34,
   "gap_before": 3.46,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg22"
  },
  {
   "speaker": "user",
   "text": "keeps you warm, right?",
   "est_sec": 1.34,
   "gap_before": 2.53,
   "event": "ordinary_request",
   "block": "travel_planning.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "It helps your hands at least. You often pay a deposit for the mug, and you can keep it as a souvenir.",
   "est_sec": 6.92,
   "gap_before": 1.99,
   "role": "reply",
   "block": "travel_planning.dlg22"
  }
 ]
}
