 "est_total_sec": 59.89,
 "est_speech_sec": 44.39,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.65,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.84,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "First winter with a car. What should I keep in it for snow?",
   "est_sec": 4.13,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "weather_plans.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "A scraper, de icer, a small shovel and a blanket are the basics. A phone charger and a torch too.",
   "est_sec": 6.3,
   "gap_before": 0.41,
   "role": "reply",
   "block": "weather_plans.dlg14"
  },
  {
   "speaker": "user",
   "text": "A shovel? In my tiny car?",
   "est_sec": 1.96,
   "gap_before": 2.53,
   "event": "ordinary_request",
   "block": "weather_plans.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "A folding one fits in the boot. If you get stuck, it's a lifesaver.",
   "est_sec": 4.44,
   "gap_before": 0.85,
   "role": "reply",
   "block": "weather_plans.dlg14"
  },
  {
   "speaker": "user",
   "text": "What about food?",
   "est_sec": 1.03,
   "gap_before": 1.39,
   "event": "ordinary_request",
   "block": "weather_plans.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "A few cereal bars and some water. If you're stuck in traffic for hours, you'll be glad.",
   "est_sec": 5.37,
   "gap_before": 0.86,
   "role": "reply",
   "block": "weather_plans.dlg14"
  },
  {
   "speaker": "user",
   "text": "And tyres?",
   "est_sec": 0.72,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "weather_plans.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Check the tread and the pressure. If you live somewhere hilly or snowy, winter tyres are really worth it.",
   "est_sec": 5.99,
   "gap_before": 1.42,
   "role": "reply",
   "block": "weather_plans.dlg14"
  },
  {
   "speaker": "user",
   "text": "My dad says I need a bag of cat litter.",
   "est_sec": 3.2,
   "gap_before": 0.73,
   "event": "distractor",
   "kind": "pause",
   "block": "weather_plans.dlg14"
  },
  {
   "speaker": "user",
   "text": "He was very serious about it.",
   "est_sec": 1.96,
   "gap_before": 2.37,
   "event": "ordinary_request",
   "block": "weather_plans.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "He's right. Sprinkle it under the wheels if you're spinning on ice, it gives the tyres grip.",
   "est_sec": 5.37,
   "gap_before": 1.16,
   "role": "reply",
   "block": "weather_plans.dlg14"
  }
 ]
}
