 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "I'm well, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.56,
   "event": "greeting_answer",
   "phrasing": "greet_ans_25"
  },
  {
   "speaker": "user",
   "text": "Can I swap regular flour for whole wheat in my muffin recipe?",
   "est_sec": 3.82,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "baking.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "You can, but start by swapping only half. Whole wheat makes muffins denser and a little drier.",
   "est_sec": 5.37,
   "gap_before": 1.12,
   "role": "reply",
   "block": "baking.dlg2"
  },
  {
   "speaker": "user",
   "text": "Should I add more liquid then?",
   "est_sec": 1.96,
   "gap_before": 1.42,
   "event": "ordinary_request",
   "block": "baking.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Yes, a couple of extra spoonfuls of milk helps. Letting the batter rest ten minutes also softens the bran.",
   "est_sec": 5.99,
   "gap_before": 0.93,
   "role": "reply",
   "block": "baking.dlg2"
  },
  {
   "speaker": "user",
   "text": "And if I want to cut",
   "est_sec": 1.96,
   "gap_before": 1.2,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg2"
  },
  {
   "speaker": "user",
   "text": "some of the sugar too?",
   "est_sec": 1.65,
   "gap_before": 2.3,
   "event": "ordinary_request",
   "block": "baking.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "You can cut about a quarter without problems. Mashed banana or a bit of applesauce adds sweetness back.",
   "est_sec": 5.68,
   "gap_before": 0.85,
   "role": "reply",
   "block": "baking.dlg2"
  },
  {
   "speaker": "user",
   "text": "Banana sounds good. I have some brown ones.",
   "est_sec": 2.58,
   "gap_before": 0.7,
   "event": "ordinary_request",
   "block": "baking.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Perfect, the browner the better for baking.",
   "est_sec": 2.27,
   "gap_before": 1.47,
   "role": "reply",
   "block": "baking.dlg2"
  }
 ]
}
