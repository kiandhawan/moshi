 "est_speech_sec": 42.33,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.6,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.88,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "My trumpet smells weird. How often am I meant to clean it?",
   "est_sec": 3.82,
   "gap_before": 0.25,
   "event": "ordinary_request",
   "block": "music.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Ideally a quick rinse every couple of weeks and a proper bath once a month or so. A smell usually means it's overdue.",
   "est_sec": 7.23,
   "gap_before": 1.1,
   "role": "reply",
   "block": "music.dlg23"
  },
  {
   "speaker": "user",
   "text": "Overdue is putting it mildly.",
   "est_sec": 1.65,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "music.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Then give it a full bath. Lukewarm water with a bit of washing up liquid, and take the valves and slides out first.",
   "est_sec": 7.23,
   "gap_before": 0.75,
   "role": "reply",
   "block": "music.dlg23"
  },
  {
   "speaker": "user",
   "text": "Won't hot water",
   "est_sec": 1.03,
   "gap_before": 0.55,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg23"
  },
  {
   "speaker": "user",
   "text": "ruin the finish?",
   "est_sec": 1.03,
   "gap_before": 2.01,
   "event": "ordinary_request",
   "block": "music.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Hot water can damage the lacquer, so stick with lukewarm. Use a snake brush through the tubes and a soft cloth on the outside.",
   "est_sec": 7.54,
   "gap_before": 1.06,
   "role": "reply",
   "block": "music.dlg23"
  },
  {
   "speaker": "user",
   "text": "And the valves?",
   "est_sec": 1.03,
   "gap_before": 1.09,
   "event": "ordinary_request",
   "block": "music.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Rinse them, dry them, add a few drops of valve oil, and put each one back in its own slot. They're numbered for a reason.",
   "est_sec": 7.85,
   "gap_before": 0.45,
   "role": "reply",
   "block": "music.dlg23"
  }
 ]
}
