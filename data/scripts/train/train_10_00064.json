 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.62,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.86,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "Is it better to stretch before or after a run?",
   "est_sec": 3.2,
   "gap_before": 0.34,
   "event": "ordinary_request",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Before a run, do a dynamic warm-up like leg swings and easy jogging. Save the longer, held stretches for after.",
   "est_sec": 6.3,
   "gap_before": 0.58,
   "role": "reply",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "user",
   "text": "Why not hold stretches before?",
   "est_sec": 1.65,
   "gap_before": 2.68,
   "event": "ordinary_request",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Long static stretches can make your muscles feel a bit weaker right away. Moving warm-ups get them ready instead.",
   "est_sec": 5.99,
   "gap_before": 0.54,
   "role": "reply",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "user",
   "text": "Makes sense. I usually just",
   "est_sec": 1.65,
   "gap_before": 1.38,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "user",
   "text": "start running and hope for the best.",
   "est_sec": 2.27,
   "gap_before": 2.42,
   "event": "ordinary_request",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Lots of people do. Even five minutes of brisk walking first makes a real difference.",
   "est_sec": 4.75,
   "gap_before": 1.03,
   "role": "reply",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "user",
   "text": "Okay. And after, how long should I hold each stretch?",
   "est_sec": 3.2,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "About thirty seconds each. Focus on calves, hamstrings and hips, those get tight from running.",
   "est_sec": 4.75,
   "gap_before": 0.4,
   "role": "reply",
   "block": "fitness.dlg3"
  }
 ]
}
