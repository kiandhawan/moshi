   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "My flatmates are all away so I've got the whole weekend to myself, and I want to use it well.",
   "est_sec": 6.3,
   "gap_before": 0.25,
   "block": "weekend_plans.opt5"
  },
  {
   "speaker": "user",
   "text": "Wait until I've listed everything before you jump in.",
   "est_sec": 2.89,
