   "event": "instruction",
   "kind": "describe_options",
   "phrasing": "describe_instr_13"
  },
  {
   "speaker": "user",
   "text": "I could take the train to the coast and stay one night in a little guesthouse on my own.",
   "est_sec": 5.99,
   "gap_before": 0.82,
   "block": "weekend_plans.opt5",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "Or stay home and do a proper reset, deep clean, cook something big, and read all day Sunday.",
   "est_sec": 5.68,
   "gap_before": 1.7,
   "block": "weekend_plans.opt5",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "Or treat myself at the spa day place across town, pricey but I've wanted to go for ages.",
   "est_sec": 5.68,
   "gap_before": 2.54,
   "block": "weekend_plans.opt5"
  },
  {
