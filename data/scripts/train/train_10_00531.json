 "est_total_sec": 57.02,
 "est_speech_sec": 44.7,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.35,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.31,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "I'm hosting brunch and my hollandaise always splits. What am I doing wrong?",
   "est_sec": 4.13,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "cooking.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Usually the butter goes in too fast or the bowl gets too hot.",
   "est_sec": 4.13,
   "gap_before": 1.19,
   "role": "reply",
   "block": "cooking.dlg30"
  },
  {
   "speaker": "user",
   "text": "I'm doing it over a pan of simmering water.",
   "est_sec": 2.89,
   "gap_before": 0.79,
   "event": "ordinary_request",
   "block": "cooking.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Make sure the bowl isn't touching the water, and keep it at a gentle simmer. Add the melted butter in a very thin stream while whisking.",
   "est_sec": 8.16,
   "gap_before": 0.71,
   "role": "reply",
   "block": "cooking.dlg30"
  },
  {
   "speaker": "user",
   "text": "And if it splits anyway, is it ruined?",
   "est_sec": 2.58,
   "gap_before": 1.22,
   "event": "ordinary_request",
   "block": "cooking.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "No. Put a fresh egg yolk in a clean bowl and slowly whisk the split sauce into it. It usually comes back.",
   "est_sec": 6.92,
   "gap_before": 0.97,
   "role": "reply",
   "block": "cooking.dlg30"
  },
  {
   "speaker": "user",
   "text": "Oh, that's a relief. Can I make it",
   "est_sec": 2.58,
   "gap_before": 0.85,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg30"
  },
  {
   "speaker": "user",
   "text": "an hour before people arrive?",
   "est_sec": 1.65,
   "gap_before": 2.23,
   "event": "ordinary_request",
   "block": "cooking.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "It's best fresh, but you can keep it warm in a thermos for about an hour.",
   "est_sec": 5.06,
   "gap_before": 0.49,
   "role": "reply",
   "block": "cooking.dlg30"
  },
  {
   "speaker": "user",
   "text": "A thermos. That's genius.",
   "est_sec": 1.34,
   "gap_before": 0.64,
   "event": "ordinary_request",
   "block": "cooking.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "It's an old cafe trick. Enjoy the brunch.",
   "est_sec": 2.58,
   "gap_before": 0.49,
   "role": "reply",
   "block": "cooking.dlg30"
  }
 ]
}
