 "est_total_sec": 59.22,
 "est_speech_sec": 43.46,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.35,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.74,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I'm a woman traveling alone for the first time, to Portugal. My mum is very worried.",
   "est_sec": 5.06,
   "gap_before": 0.25,
   "event": "ordinary_request",
   "block": "travel_planning.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "That's natural for her. Portugal is generally considered quite safe, and lots of women travel there solo.",
   "est_sec": 5.37,
   "gap_before": 0.89,
   "role": "reply",
   "block": "travel_planning.dlg18"
  },
  {
   "speaker": "user",
   "text": "Any actual tips, though? Beyond be careful.",
   "est_sec": 2.27,
   "gap_before": 2.76,
   "event": "ordinary_request",
   "block": "travel_planning.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Share your plans with someone at home, and arrive in a new city during daylight if you can.",
   "est_sec": 5.68,
   "gap_before": 1.37,
   "role": "reply",
   "block": "travel_planning.dlg18"
  },
  {
   "speaker": "user",
   "text": "That's useful.",
   "est_sec": 0.72,
   "gap_before": 0.86,
   "event": "ordinary_request",
   "block": "travel_planning.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Stay somewhere with good reviews from other solo women. And keep a little cash and a copy of your passport separate from your wallet.",
   "est_sec": 7.54,
   "gap_before": 0.72,
   "role": "reply",
   "block": "travel_planning.dlg18"
  },
  {
   "speaker": "user",
   "text": "I was thinking of hostels",
   "est_sec": 1.65,
   "gap_before": 1.01,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg18"
  },
  {
   "speaker": "user",
   "text": "to meet people.",
   "est_sec": 1.03,
   "gap_before": 1.98,
   "event": "ordinary_request",
   "block": "travel_planning.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Good idea. Many have female only dorms, and the common rooms are great for finding company for day trips.",
   "est_sec": 5.99,
   "gap_before": 0.97,
   "role": "reply",
   "block": "travel_planning.dlg18"
  },
  {
   "speaker": "user",
   "text": "Okay, I'll show this to my mum.",
   "est_sec": 2.27,
   "gap_before": 1.32,
   "event": "ordinary_request",
   "block": "travel_planning.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "I hope it reassures her. Have a wonderful trip.",
   "est_sec": 2.89,
   "gap_before": 1.04,
   "role": "reply",
   "block": "travel_planning.dlg18"
  }
 ]
}
