 "est_speech_sec": 37.89,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.36,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.52,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "Every month my bank account dips below zero right before payday.",
   "est_sec": 3.51,
   "gap_before": 0.39,
   "event": "ordinary_request",
   "block": "personal_finance.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "That sounds stressful. Do you know which bills come out at the end of the month?",
   "est_sec": 5.06,
   "gap_before": 0.79,
   "role": "reply",
   "block": "personal_finance.dlg30"
  },
  {
   "speaker": "user",
   "text": "Phone, internet and a car payment.",
   "est_sec": 1.96,
   "gap_before": 0.85,
   "event": "ordinary_request",
   "block": "personal_finance.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "You could ask those companies to move the due dates to just after payday. Many will do it if you ask.",
   "est_sec": 6.61,
   "gap_before": 1.16,
   "role": "reply",
   "block": "personal_finance.dlg30"
  },
  {
   "speaker": "user",
   "text": "I didn't know you could do that.",
   "est_sec": 2.27,
   "gap_before": 1.93,
   "event": "ordinary_request",
   "block": "personal_finance.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Most people don't. It's often a quick call or a setting in your account.",
   "est_sec": 4.44,
   "gap_before": 0.57,
   "role": "reply",
   "block": "personal_finance.dlg30"
  },
  {
   "speaker": "user",
   "text": "And to stop overdraft fees?",
   "est_sec": 1.65,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "personal_finance.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Set up a low balance alert in your bank app, so you get a warning before it dips. Some banks also offer a small buffer for free.",
   "est_sec": 8.47,
   "gap_before": 1.62,
   "role": "reply",
   "block": "personal_finance.dlg30"
  }
 ]
}
