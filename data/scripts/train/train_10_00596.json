 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.38,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.38,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "I've got ADHD and studying normal ways just doesn't work for me.",
   "est_sec": 3.82,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "studying.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "That makes sense. Lots of standard advice isn't built for how your brain works. What helps you focus, even a little?",
   "est_sec": 6.61,
   "gap_before": 0.42,
   "role": "reply",
   "block": "studying.dlg9"
  },
  {
   "speaker": "user",
   "text": "Weirdly, noise. And moving around.",
   "est_sec": 1.65,
   "gap_before": 1.93,
   "event": "ordinary_request",
   "block": "studying.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Then lean into that. Try studying in a cafe, or with background sound, and take short walking breaks every twenty minutes.",
   "est_sec": 6.61,
   "gap_before": 1.19,
   "role": "reply",
   "block": "studying.dlg9"
  },
  {
   "speaker": "user",
   "text": "Twenty minutes feels short.",
   "est_sec": 1.34,
   "gap_before": 1.23,
   "event": "ordinary_request",
   "block": "studying.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Short is good. Lots of quick wins keep your motivation going. You could also stand up while you read or use a whiteboard.",
   "est_sec": 7.23,
   "gap_before": 0.91,
   "role": "reply",
   "block": "studying.dlg9"
  },
  {
   "speaker": "user",
   "text": "My teachers always told me",
   "est_sec": 1.65,
   "gap_before": 1.12,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg9"
  },
  {
   "speaker": "user",
   "text": "to sit still and concentrate.",
   "est_sec": 1.65,
   "gap_before": 2.2,
   "event": "ordinary_request",
   "block": "studying.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Some people do learn best that way. You might not, and that's fine. What matters is finding what works for you.",
   "est_sec": 6.61,
   "gap_before": 0.53,
   "role": "reply",
   "block": "studying.dlg9"
  }
 ]
