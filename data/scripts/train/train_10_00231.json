 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.48,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.59,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "I just found out I'm pregnant. Do I have to give up coffee completely?",
   "est_sec": 4.44,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "coffee.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Congratulations! Many health guidelines say a moderate amount is okay, often up to about two hundred milligrams of caffeine a day. Your doctor or midwife can tell you what's right for you.",
   "est_sec": 10.02,
   "gap_before": 0.32,
   "role": "reply",
   "block": "coffee.dlg6"
  },
  {
   "speaker": "user",
   "text": "How much coffee is that?",
   "est_sec": 1.65,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "coffee.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Roughly one or two regular cups, depending on how strong they are. A big cafe coffee can have quite a lot more than one made at home.",
   "est_sec": 8.47,
   "gap_before": 0.96,
   "role": "reply",
   "block": "coffee.dlg6"
  },
  {
   "speaker": "user",
   "text": "What about",
   "est_sec": 0.72,
   "gap_before": 1.28,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg6"
  },
  {
   "speaker": "user",
   "text": "tea and chocolate?",
   "est_sec": 1.03,
   "gap_before": 2.29,
   "event": "ordinary_request",
   "block": "coffee.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Those count too, though they usually have less. It's the total across the day that matters.",
   "est_sec": 5.06,
   "gap_before": 0.98,
   "role": "reply",
   "block": "coffee.dlg6"
  },
  {
   "speaker": "user",
   "text": "Decaf is fine, then?",
   "est_sec": 1.34,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "coffee.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Decaf has very little caffeine, so it's a nice way to keep the ritual. Just check with your midwife if you have any doubts.",
   "est_sec": 7.54,
   "gap_before": 1.05,
   "role": "reply",
   "block": "coffee.dlg6"
  }
 ]
}
