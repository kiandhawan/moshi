 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.65,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "Help, I'm hosting book club tonight and I didn't finish the book.",
   "est_sec": 3.82,
   "gap_before": 0.24,
   "event": "ordinary_request",
   "block": "books.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Don't panic. How far did you get?",
   "est_sec": 2.27,
   "gap_before": 0.94,
   "role": "reply",
   "block": "books.dlg17"
  },
  {
   "speaker": "user",
   "text": "About halfway. Everyone is going to know.",
   "est_sec": 2.27,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "books.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Honestly, half the club probably didn't finish either. You could ask open questions and let others lead.",
   "est_sec": 5.37,
   "gap_before": 1.03,
   "role": "reply",
   "block": "books.dlg17"
  },
  {
   "speaker": "user",
   "text": "Like what?",
   "est_sec": 0.72,
   "gap_before": 0.68,
   "event": "ordinary_request",
   "block": "books.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Things like which character people related to most, or whether the title makes sense now. Those work no matter where you stopped.",
   "est_sec": 6.92,
   "gap_before": 1.05,
   "role": "reply",
   "block": "books.dlg17"
  },
  {
   "speaker": "user",
   "text": "Should I just confess?",
   "est_sec": 1.34,
   "gap_before": 1.21,
   "event": "ordinary_request",
   "block": "books.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "A cheerful confession at the start often goes down well. Then ask them not to spoil the ending, and you're the one with the most to look forward to.",
   "est_sec": 9.09,
   "gap_before": 1.05,
   "role": "reply",
   "block": "books.dlg17"
  }
 ]
}
