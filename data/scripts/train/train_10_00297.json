 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.64,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.86,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "I want to start budgeting with my husband but we can't agree on how.",
   "est_sec": 4.44,
   "gap_before": 0.46,
   "block": "personal_finance.opt4"
  },
  {
   "speaker": "user",
   "text": "Please wait until I've gone through all the options.",
   "est_sec": 2.89,
   "gap_before": 0.82,
   "event": "instruction",
   "kind": "describe_options",
   "phrasing": "describe_instr_08"
  },
  {
   "speaker": "moshi",
   "text": "Sure.",
   "est_sec": 0.41,
   "gap_before": 0.26,
   "role": "ack",
   "phrasing": "ack_01"
  },
  {
   "speaker": "user",
   "text": "We could put both salaries into one joint account and pay everything from there.",
   "est_sec": 4.44,
   "gap_before": 1.06,
   "block": "personal_finance.opt4"
  },
  {
   "speaker": "user",
   "text": "Or keep our own accounts and each pay half of the shared bills.",
   "est_sec": 4.13,
   "gap_before": 1.37,
   "block": "personal_finance.opt4",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "Another idea is to pay bills in proportion to what we earn, since he earns quite a bit more.",
   "est_sec": 5.99,
   "gap_before": 1.55,
   "block": "personal_finance.opt4",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "Or a joint account just for bills, and the rest stays separate as our own fun money.",
   "est_sec": 5.37,
   "gap_before": 1.61,
   "block": "personal_finance.opt4"
  },
  {
   "speaker": "user",
   "text": "Alright, I'm finished. What's your opinion?",
   "est_sec": 1.96,
   "gap_before": 1.13,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "describe_cue_14"
  },
  {
   "speaker": "moshi",
   "text": "Half and half can feel unfair if one of you earns much more. The joint bills account combined with paying in proportion to income is a nice middle ground.",
   "est_sec": 9.09,
   "gap_before": 0.99,
   "role": "resume",
   "block": "personal_finance.opt4"
  }
 ]
}
