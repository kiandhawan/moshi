 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.35,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.3,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "Every time I clean my windows they end up streaky. What am I doing wrong?",
   "est_sec": 4.75,
   "gap_before": 0.29,
   "event": "ordinary_request",
   "block": "cleaning.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Probably cleaning in the sun. The liquid dries too fast and leaves streaks. Pick a cloudy day or do them in the shade.",
   "est_sec": 7.23,
   "gap_before": 0.62,
   "role": "reply",
   "block": "cleaning.dlg18"
  },
  {
   "speaker": "user",
   "text": "Huh. I always wait for a sunny day.",
   "est_sec": 2.58,
   "gap_before": 2.3,
   "event": "ordinary_request",
   "block": "cleaning.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Common mistake. Use a spray of water with a splash of vinegar, then wipe with a microfibre cloth, and buff with a second dry one.",
   "est_sec": 7.85,
   "gap_before": 1.06,
   "role": "reply",
   "block": "cleaning.dlg18"
  },
  {
   "speaker": "user",
   "text": "Two cloths?",
   "est_sec": 0.72,
   "gap_before": 3.49,
   "event": "ordinary_request",
   "block": "cleaning.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "One to clean, one to polish. Wipe horizontally on the outside and vertically on the inside, so you know which side a streak is on.",
   "est_sec": 7.85,
   "gap_before": 0.34,
   "role": "reply",
   "block": "cleaning.dlg18"
  },
  {
   "speaker": "user",
   "text": "That's very clever. I'm doing it",
   "est_sec": 1.96,
   "gap_before": 2.27,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg18"
  },
  {
   "speaker": "user",
   "text": "this afternoon.",
   "est_sec": 0.72,
   "gap_before": 2.27,
   "event": "ordinary_request",
   "block": "cleaning.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Check the forecast first.",
   "est_sec": 1.34,
