 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.56,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.97,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "My work trip to Chicago ends on a Friday. My company says I can stay the weekend if I pay for the hotel.",
   "est_sec": 7.23,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "travel_planning.ctx6"
  },
  {
   "speaker": "moshi",
   "text": "That's a good deal, the flight's already covered. Do you want to explore the city, or would you rather get home to your family?",
   "est_sec": 7.54,
   "gap_before": 0.74,
   "role": "reply",
   "block": "travel_planning.ctx6"
  },
  {
   "speaker": "user",
   "text": "Let me talk to Nina for a bit, so please stay quiet until I say I'm back.",
   "est_sec": 5.37,
   "gap_before": 2.17,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_20"
  },
  {
   "speaker": "moshi",
   "text": "Take your time.",
   "est_sec": 1.03,
   "gap_before": 0.42,
   "role": "ack",
   "phrasing": "ack_09"
  },
  {
   "speaker": "user",
   "text": "Do you know if the bins go out tonight or tomorrow?",
   "est_sec": 3.51,
   "gap_before": 1.18,
   "event": "distractor",
   "kind": "friend_question",
   "phrasing": "dq_33"
  },
  {
   "speaker": "friend",
   "text": "Tomorrow, it's recycling week.",
   "est_sec": 1.34,
   "gap_before": 3.24,
   "phrasing": "dq_33"
  },
  {
   "speaker": "user",
   "text": "Nina, are you bringing the map or should I?",
   "est_sec": 2.89,
   "gap_before": 1.02,
   "event": "distractor",
   "kind": "friend_question",
   "block": "hiking.side3"
  },
  {
   "speaker": "friend",
   "text": "I've got it on my phone.",
   "est_sec": 1.96,
   "gap_before": 0.4,
   "block": "hiking.side3"
  },
  {
   "speaker": "user",
   "text": "There's no signal up there though.",
   "est_sec": 1.96,
   "gap_before": 0.32,
   "block": "hiking.side3"
  },
  {
   "speaker": "friend",
   "text": "I downloaded it, it works offline.",
   "est_sec": 1.96,
   "gap_before": 1.38,
   "block": "hiking.side3"
  },
  {
   "speaker": "user",
   "text": "Okay, but I'm bringing the paper one too. Just in case your battery dies.",
   "est_sec": 4.44,
   "gap_before": 0.45,
   "block": "hiking.side3"
  },
  {
   "speaker": "friend",
   "text": "You're such a scout. Fine, bring it.",
   "est_sec": 2.27,
   "gap_before": 1.14,
   "block": "hiking.side3"
  },
