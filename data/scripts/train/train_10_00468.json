 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.52,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.65,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "I got a bonus at work and I'm trying to decide what to do with it.",
   "est_sec": 5.06,
   "gap_before": 0.4,
   "block": "personal_finance.opt1"
  },
  {
   "speaker": "user",
   "text": "Let me finish describing every option before you respond.",
   "est_sec": 2.89,
   "gap_before": 0.84,
   "event": "instruction",
   "kind": "describe_options",
   "phrasing": "describe_instr_17"
  },
  {
   "speaker": "moshi",
   "text": "Sure thing.",
   "est_sec": 0.72,
   "gap_before": 0.55,
   "role": "ack",
   "phrasing": "ack_12"
  },
  {
   "speaker": "user",
   "text": "The first idea is paying off my credit card, which has a pretty high interest rate.",
   "est_sec": 5.06,
   "gap_before": 0.72,
   "block": "personal_finance.opt1"
  },
  {
   "speaker": "user",
   "text": "Then there's putting it in a savings account as an emergency fund, since I don't really have one.",
   "est_sec": 5.68,
   "gap_before": 1.14,
   "block": "personal_finance.opt1",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "Option three is investing it in an index fund for the long term.",
   "est_sec": 4.13,
   "gap_before": 1.76,
   "block": "personal_finance.opt1",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "And the last one is taking a trip I've wanted to do for years.",
   "est_sec": 4.44,
   "gap_before": 2.84,
   "block": "personal_finance.opt1"
  },
  {
   "speaker": "user",
   "text": "Done. What would you recommend?",
   "est_sec": 1.65,
   "gap_before": 1.23,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "describe_cue_10"
  },
  {
   "speaker": "moshi",
   "text": "How big is the credit card balance compared to the bonus? If you can wipe it out, I'd do that and put the rest in savings. The trip could come from a small slice, as a reward, without derailing the rest.",
   "est_sec": 12.81,
   "gap_before": 0.48,
   "role": "resume",
   "block": "personal_finance.opt1"
  }
 ]
}
