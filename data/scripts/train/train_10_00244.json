   "text": "Okay, no rush.",
   "est_sec": 1.03,
   "gap_before": 0.33,
   "role": "ack",
   "phrasing": "ack_10"
  },
  {
   "speaker": "user",
   "text": "Back already? That was a short walk.",
   "est_sec": 2.27,
   "gap_before": 0.8,
   "event": "distractor",
   "kind": "near_miss",
   "phrasing": "dn_67"
  },
  {
   "speaker": "friend",
   "text": "It started hailing.",
   "est_sec": 1.03,
   "gap_before": 1.26,
   "phrasing": "dn_67"
  },
  {
   "speaker": "user",
   "text": "Ethan, are you free on Sunday?",
