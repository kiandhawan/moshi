   "est_sec": 1.65,
   "gap_before": 0.49,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "Our hallway rug is disgusting. Muddy boots, the dog, my kids, all of it.",
   "est_sec": 4.44,
   "gap_before": 0.4,
   "event": "ordinary_request",
   "block": "shopping.ctx10"
  },
  {
   "speaker": "moshi",
   "text": "Hallways take a beating. Would you go for a flat woven one you can throw in the washing machine, or something thicker that's nicer underfoot?",
   "est_sec": 7.85,
   "gap_before": 1.2,
   "role": "reply",
   "block": "shopping.ctx10"
  },
  {
   "speaker": "user",
   "text": "Hold that thought, I need to talk to Ethan real quick. Stay quiet until I return.",
