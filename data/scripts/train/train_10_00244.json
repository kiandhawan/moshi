   "gap_before": 1.31,
   "event": "distractor",
   "kind": "friend_question",
   "block": "weekend_plans.side1"
  },
  {
   "speaker": "friend",
   "text": "In the afternoon, yeah. Morning I've got football.",
   "est_sec": 2.58,
   "gap_before": 0.6,
   "block": "weekend_plans.side1"
  },
  {
   "speaker": "user",
   "text": "There's a food festival in the park. Want to go?",
   "est_sec": 3.2,
   "gap_before": 2.19,
   "event": "distractor",
   "kind": "friend_question",
   "block": "weekend_plans.side1"
  },
  {
   "speaker": "friend",
   "text": "Oh, the one with the dumplings? I went last year, it was amazing.",
   "est_sec": 4.13,
   "gap_before": 0.61,
   "block": "weekend_plans.side1"
  },
  {
