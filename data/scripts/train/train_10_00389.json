   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "I keep picking up my phone without even thinking. It's eating my whole evening.",
   "est_sec": 4.44,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "smartphones.ctx2"
  },
  {
   "speaker": "moshi",
   "text": "Lots of people feel that way. Would you rather set a daily time limit on certain apps, or delete the worst ones entirely?",
   "est_sec": 7.23,
   "gap_before": 0.55,
   "role": "reply",
   "block": "smartphones.ctx2"
  },
  {
   "speaker": "user",
