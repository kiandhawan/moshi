 "est_total_sec": 54.43,
 "est_speech_sec": 41.29,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.4,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.45,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "I got fined on the tram because my ticket app crashed. I had actually paid! It's infuriating.",
   "est_sec": 5.37,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "public_transport.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "That's maddening. You can usually appeal. Did the app show the purchase anywhere, like in your email or bank statement?",
   "est_sec": 6.3,
   "gap_before": 1.89,
   "role": "reply",
   "block": "public_transport.dlg24"
  },
  {
   "speaker": "user",
   "text": "Hold on, that's not right.",
   "est_sec": 1.65,
   "gap_before": 1.32,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_07",
   "block": "public_transport.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "Let me double-check. I'd still stand by it, but tell me what you heard.",
   "est_sec": 4.44,
   "gap_before": 0.96,
   "role": "reply",
   "block": "public_transport.dlg24"
  },
  {
   "speaker": "user",
   "text": "My bank shows the payment.",
   "est_sec": 1.65,
   "gap_before": 0.87,
   "event": "ordinary_request",
   "block": "public_transport.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "Good, that's your evidence. Screenshot the payment with the date and time and send it along with your appeal.",
   "est_sec": 5.99,
   "gap_before": 1.1,
   "role": "reply",
   "block": "public_transport.dlg24"
  },
  {
   "speaker": "user",
   "text": "Where do I",
   "est_sec": 1.03,
   "gap_before": 0.37,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg24"
  },
  {
   "speaker": "user",
   "text": "even send it?",
   "est_sec": 1.03,
   "gap_before": 2.81,
   "event": "ordinary_request",
   "block": "public_transport.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "The fine notice should list an address or website for appeals. Do it soon, there's often a short deadline.",
   "est_sec": 5.99,
   "gap_before": 0.33,
   "role": "reply",
   "block": "public_transport.dlg24"
  },
  {
   "speaker": "user",
   "text": "They'll probably ignore me.",
   "est_sec": 1.34,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "public_transport.dlg24"
  },
  {
   "speaker": "moshi",
   "text": "Proof of payment usually wins these cases. Keep it calm and factual.",
   "est_sec": 3.82,
   "gap_before": 0.41,
   "role": "reply",
   "block": "public_transport.dlg24"
  }
 ]
}
