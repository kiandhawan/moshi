 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.38,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.46,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "My phone gets really hot when I'm using maps in the car. Is that bad for it?",
   "est_sec": 5.37,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "smartphones.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "A little warmth is normal, but sitting in direct sun on the dashboard can really heat it up. Heat is hard on the battery over time.",
   "est_sec": 8.16,
   "gap_before": 1.19,
   "role": "reply",
   "block": "smartphones.dlg1"
  },
  {
   "speaker": "user",
   "text": "It's in one of those holders on the windshield.",
   "est_sec": 2.89,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "smartphones.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Try moving it to a vent mount with the air conditioning on. That keeps it much cooler.",
   "est_sec": 5.37,
   "gap_before": 0.82,
   "role": "reply",
   "block": "smartphones.dlg1"
  },
  {
   "speaker": "user",
   "text": "And should I",
   "est_sec": 1.03,
   "gap_before": 1.13,
   "event": "distractor",
   "kind": "pause",
   "block": "smartphones.dlg1"
  },
  {
   "speaker": "user",
   "text": "take it off the charger while I drive?",
   "est_sec": 2.58,
   "gap_before": 2.12,
   "event": "ordinary_request",
   "block": "smartphones.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Charging and navigating at the same time makes the most heat. If the battery is above half, you can skip charging on short trips.",
   "est_sec": 7.54,
   "gap_before": 0.44,
   "role": "reply",
   "block": "smartphones.dlg1"
  },
  {
   "speaker": "user",
   "text": "Okay, that's easy enough. Thanks.",
   "est_sec": 1.65,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "smartphones.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "You're welcome. Your battery will thank you too.",
   "est_sec": 2.58,
   "gap_before": 0.78,
   "role": "reply",
   "block": "smartphones.dlg1"
  }
 ]
