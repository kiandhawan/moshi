 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.58,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.94,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "We just started homeschooling our ten year old and I have no idea how to plan a week.",
   "est_sec": 5.68,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "studying.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Big change. Start simple. What subjects do you want to cover?",
   "est_sec": 3.51,
   "gap_before": 0.78,
   "role": "reply",
   "block": "studying.dlg26"
  },
  {
   "speaker": "user",
   "text": "Maths, English, science, and some history. And she loves art.",
   "est_sec": 3.2,
   "gap_before": 1.45,
   "event": "ordinary_request",
   "block": "studying.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "Try core subjects like maths and English in the mornings when she's freshest, and lighter things like art and history in the afternoons.",
   "est_sec": 7.23,
   "gap_before": 1.04,
   "role": "reply",
   "block": "studying.dlg26"
  },
  {
   "speaker": "user",
   "text": "How long should each lesson be?",
   "est_sec": 1.96,
   "gap_before": 0.96,
   "event": "ordinary_request",
   "block": "studying.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "For ten, about forty five minutes with breaks is plenty. Homeschool days are often shorter than school days, and that's fine.",
   "est_sec": 6.61,
   "gap_before": 0.81,
   "role": "reply",
   "block": "studying.dlg26"
  },
  {
   "speaker": "user",
   "text": "I keep worrying",
   "est_sec": 1.03,
   "gap_before": 2.21,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg26"
  },
  {
   "speaker": "user",
   "text": "she's falling behind her friends.",
   "est_sec": 1.65,
   "gap_before": 2.62,
   "event": "ordinary_request",
   "block": "studying.dlg26"
  },
  {
   "speaker": "moshi",
   "text": "One to one time is really efficient. Check in with a simple test now and then, and you'll see how she's doing.",
   "est_sec": 6.92,
