 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.56,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 1.0,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "I just started a new job across town. I could take the bus or the train.",
   "est_sec": 5.06,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "public_transport.ctx1"
  },
  {
   "speaker": "moshi",
   "text": "The bus stops closer to your place but takes about fifty minutes. The train is thirty, but it's a ten minute walk. Which matters more to you?",
   "est_sec": 8.47,
   "gap_before": 0.62,
   "role": "reply",
   "block": "public_transport.ctx1"
  },
  {
   "speaker": "user",
   "text": "Can you give me ten seconds? Then ask me again.",
   "est_sec": 3.2,
   "gap_before": 0.62,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 10,
   "phrasing": "think_instr_05"
  },
  {
   "speaker": "user",
   "text": "Hmm, decisions, decisions.",
   "est_sec": 1.03,
   "anchor": {
    "turn": 4,
    "offset": 5.89
   },
   "event": "distractor",
   "kind": "self_talk",
   "phrasing": "self_26"
  },
  {
   "speaker": "moshi",
   "text": "So, which commute sounds better? The closer bus, or the faster train?",
   "est_sec": 3.82,
   "role": "resume",
   "block": "public_transport.ctx1",
   "anchor": {
    "turn": 4,
    "offset": 10.09
   }
  },
  {
   "speaker": "user",
   "text": "The bus. I can read the whole way without changing.",
   "est_sec": 3.2,
   "gap_before": 0.98,
   "event": "ordinary_request",
   "block": "public_transport.ctx1"
  },
  {
   "speaker": "moshi",
   "text": "That's a great reason. Fifty minutes of reading adds up to a lot of books.",
