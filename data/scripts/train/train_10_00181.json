 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.41,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "I work every Saturday. Sundays are all I get and they fly by.",
   "est_sec": 4.13,
   "gap_before": 0.23,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "That's tough. Planning a little helps the day feel longer. Maybe a lie in, then one thing you really enjoy.",
   "est_sec": 6.3,
   "gap_before": 0.74,
   "role": "reply",
   "block": "weekend_plans.dlg17"
  },
  {
   "speaker": "user",
   "text": "I always waste the morning doing laundry.",
   "est_sec": 2.27,
   "gap_before": 0.74,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Could you do laundry on a weekday evening instead? Then Sunday is truly free.",
   "est_sec": 4.44,
   "gap_before": 0.88,
   "role": "reply",
   "block": "weekend_plans.dlg17"
  },
  {
   "speaker": "user",
   "text": "Hm. I could do",
   "est_sec": 1.34,
   "gap_before": 0.66,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg17"
  },
  {
   "speaker": "user",
   "text": "one load on Thursdays.",
   "est_sec": 1.34,
   "gap_before": 2.73,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "That's a great start. And try to get out of the house before noon, it makes the day feel much fuller.",
   "est_sec": 6.61,
   "gap_before": 0.74,
   "role": "reply",
   "block": "weekend_plans.dlg17"
  },
  {
   "speaker": "user",
   "text": "Okay. Lie in, then out by noon.",
   "est_sec": 2.27,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. And keep the evening quiet, so you start Monday rested.",
   "est_sec": 3.51,
   "gap_before": 0.43,
   "role": "reply",
   "block": "weekend_plans.dlg17"
  }
 ]
}
