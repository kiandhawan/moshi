 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.71,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.99,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "Those escape room games in a box, can you play them more than once?",
   "est_sec": 4.44,
   "gap_before": 0.59,
   "event": "ordinary_request",
   "block": "board_games.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Most of them only once, sadly. You often cut, fold or write on the components, and once you know the puzzles, the surprise is gone.",
   "est_sec": 7.85,
   "gap_before": 0.52,
   "role": "reply",
   "block": "board_games.dlg25"
  },
  {
   "speaker": "user",
   "text": "That seems wasteful.",
   "est_sec": 1.03,
   "gap_before": 1.25,
   "event": "ordinary_request",
   "block": "board_games.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Some are designed so you don't destroy anything, so you can pass them on to friends afterward. The box usually says so.",
   "est_sec": 6.92,
   "gap_before": 0.41,
   "role": "reply",
   "block": "board_games.dlg25"
  },
  {
   "speaker": "user",
   "text": "Oh, swapping with friends is a good idea.",
   "est_sec": 2.58,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "board_games.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "A lot of groups do that. You play one, they play another, then you swap.",
   "est_sec": 4.75,
   "gap_before": 1.05,
   "role": "reply",
   "block": "board_games.dlg25"
  },
  {
   "speaker": "user",
   "text": "How hard are they? I'm",
   "est_sec": 1.65,
   "gap_before": 1.41,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg25"
  },
  {
   "speaker": "user",
   "text": "not great with puzzles.",
   "est_sec": 1.34,
   "gap_before": 2.6,
   "event": "ordinary_request",
   "block": "board_games.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "They have difficulty ratings on the box, and a hint system if you get stuck. Start with an easy one, it's more fun when you finish.",
   "est_sec": 8.16,
   "gap_before": 0.85,
   "role": "reply",
   "block": "board_games.dlg25"
  }
 ]
}
