 "est_speech_sec": 39.23,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.48,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.65,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "My watch keeps talking about zone two training. What even is that?",
   "est_sec": 3.82,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "fitness.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "It's easy, steady exercise at a low heart rate, where you can still talk in full sentences.",
   "est_sec": 5.37,
   "gap_before": 1.72,
   "role": "reply",
   "block": "fitness.dlg19"
  },
  {
   "speaker": "user",
   "text": "That sounds too easy to do anything.",
   "est_sec": 2.27,
   "gap_before": 1.01,
   "event": "ordinary_request",
   "block": "fitness.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "It builds your aerobic base, so your heart and muscles get better at using oxygen. Lots of endurance athletes spend most of their time there.",
   "est_sec": 7.85,
   "gap_before": 0.4,
   "role": "reply",
   "block": "fitness.dlg19"
  },
  {
   "speaker": "user",
   "text": "How long do I have to do it?",
   "est_sec": 2.58,
   "gap_before": 0.81,
   "event": "ordinary_request",
   "block": "fitness.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Sessions of thirty to sixty minutes, a few times a week, tend to work well.",
   "est_sec": 4.75,
   "gap_before": 0.8,
   "role": "reply",
   "block": "fitness.dlg19"
  },
  {
   "speaker": "user",
   "text": "So I should slow down my runs?",
   "est_sec": 2.27,
   "gap_before": 1.94,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg19"
  },
  {
   "speaker": "user",
   "text": "My ego hates that.",
   "est_sec": 1.34,
   "gap_before": 1.8,
   "event": "ordinary_request",
   "block": "fitness.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Most of them, yes. Keep one harder session a week for speed. Your ego will recover when you get faster.",
   "est_sec": 6.3,
   "gap_before": 0.38,
   "role": "reply",
   "block": "fitness.dlg19"
  }
 ]
}
