 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.52,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "Can I take a cello on the train? It's in a hard case.",
   "est_sec": 4.13,
   "gap_before": 0.39,
   "event": "ordinary_request",
   "block": "public_transport.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Usually yes. Most trains allow musical instruments as long as they fit in the luggage space or you can hold them without blocking the aisle.",
   "est_sec": 7.85,
   "gap_before": 0.37,
   "role": "reply",
   "block": "public_transport.dlg8"
  },
  {
   "speaker": "user",
   "text": "A cello is quite big.",
   "est_sec": 1.65,
   "gap_before": 0.81,
   "event": "ordinary_request",
   "block": "public_transport.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "True. On a busy commuter train it could be tough. On long distance trains, some people book a seat for the instrument.",
   "est_sec": 6.92,
   "gap_before": 0.81,
   "role": "reply",
   "block": "public_transport.dlg8"
  },
  {
   "speaker": "user",
   "text": "A seat? For the cello?",
   "est_sec": 1.65,
   "gap_before": 1.07,
   "event": "ordinary_request",
   "block": "public_transport.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "It sounds funny, but it's common for musicians. The cello rides safely next to you instead of getting bumped in the rack.",
   "est_sec": 6.92,
   "gap_before": 1.19,
   "role": "reply",
   "block": "public_transport.dlg8"
  },
  {
   "speaker": "user",
   "text": "That's actually adorable.",
   "est_sec": 1.03,
   "gap_before": 1.02,
   "event": "ordinary_request",
   "block": "public_transport.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Just travel outside rush hour if you can.",
   "est_sec": 2.58,
   "gap_before": 1.15,
   "role": "reply",
   "block": "public_transport.dlg8"
  }
 ]
}
