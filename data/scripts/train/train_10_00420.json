 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.38,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.52,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "How long should I rest between sets? I usually scroll my phone until I feel like it.",
   "est_sec": 5.37,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "fitness.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "That's a very common approach. It depends on your goal, though.",
   "est_sec": 3.51,
   "gap_before": 0.96,
   "role": "reply",
   "block": "fitness.dlg28"
  },
  {
   "speaker": "user",
   "text": "Strength, mostly. Getting stronger.",
   "est_sec": 1.34,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "fitness.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "For heavy strength work, two to three minutes is good. That lets your muscles recover enough to lift heavy again.",
   "est_sec": 6.3,
   "gap_before": 0.92,
   "role": "reply",
   "block": "fitness.dlg28"
  },
  {
   "speaker": "user",
   "text": "And for, like, arm stuff?",
   "est_sec": 1.65,
   "gap_before": 0.79,
   "event": "ordinary_request",
   "block": "fitness.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "For smaller muscles or lighter weights, sixty to ninety seconds is usually enough.",
   "est_sec": 4.13,
   "gap_before": 0.7,
   "role": "reply",
   "block": "fitness.dlg28"
  },
  {
   "speaker": "user",
   "text": "So the scrolling",
   "est_sec": 1.03,
   "gap_before": 1.85,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg28"
  },
  {
   "speaker": "user",
   "text": "is fine as long as I time it?",
   "est_sec": 2.58,
   "gap_before": 1.78,
   "event": "ordinary_request",
   "block": "fitness.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Set a timer on your phone so ten minutes of videos don't sneak in.",
   "est_sec": 4.75,
   "gap_before": 1.0,
   "role": "reply",
   "block": "fitness.dlg28"
  }
 ]
}
