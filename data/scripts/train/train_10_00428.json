 "est_total_sec": 56.57,
 "est_speech_sec": 45.12,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.39,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "My grandson says I should use the bus instead of driving into town. I'm seventy-two and I haven't taken a bus in years.",
   "est_sec": 7.23,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "public_transport.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Lots of people rediscover the bus later in life. Many cities offer a free or discounted senior pass, too.",
   "est_sec": 5.99,
   "gap_before": 0.69,
   "role": "reply",
   "block": "public_transport.dlg4"
  },
  {
   "speaker": "user",
   "text": "How would I",
   "est_sec": 1.03,
   "gap_before": 0.46,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg4"
  },
  {
   "speaker": "user",
   "text": "find out about that?",
   "est_sec": 1.34,
   "gap_before": 2.21,
   "event": "ordinary_request",
   "block": "public_transport.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Your local transit office or the town hall can tell you. You usually just need a photo ID showing your age.",
   "est_sec": 6.61,
   "gap_before": 1.17,
   "role": "reply",
   "block": "public_transport.dlg4"
  },
  {
   "speaker": "user",
   "text": "And where do I get on? I don't want to look silly.",
   "est_sec": 3.82,
   "gap_before": 1.61,
   "event": "ordinary_request",
   "block": "public_transport.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Wave to the driver as the bus comes, then get on at the front and show your pass. Drivers are used to questions, so feel free to ask which stop is yours.",
   "est_sec": 10.02,
   "gap_before": 0.56,
   "role": "reply",
   "block": "public_transport.dlg4"
  },
  {
   "speaker": "user",
   "text": "That doesn't sound so bad.",
   "est_sec": 1.65,
   "gap_before": 1.47,
   "event": "ordinary_request",
   "block": "public_transport.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "It really isn't. And no parking to worry about in town.",
   "est_sec": 3.51,
   "gap_before": 0.37,
   "role": "reply",
   "block": "public_transport.dlg4"
  }
 ]
}
