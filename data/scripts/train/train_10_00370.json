   "gap_before": 2.05,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_07",
   "block": "weekend_plans.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Hmm, I believe it is. Which part doesn't sound right?",
   "est_sec": 3.2,
   "gap_before": 0.3,
   "role": "reply",
   "block": "weekend_plans.dlg18"
  },
  {
   "speaker": "user",
   "text": "Should my son",
