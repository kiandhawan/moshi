   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "This Saturday, my son has a birthday party at two, and I promised my mum I'd visit her for lunch.",
   "est_sec": 6.3,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Busy. How far is your mum from the party?",
   "est_sec": 2.89,
   "gap_before": 1.17,
   "role": "reply",
   "block": "weekend_plans.dlg18"
  },
  {
   "speaker": "user",
   "text": "About half an hour.",
   "est_sec": 1.34,
   "gap_before": 0.91,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Then you could have an early lunch with her at twelve, leave at half one, and get to the party just in time.",
   "est_sec": 7.23,
   "gap_before": 0.77,
   "role": "reply",
   "block": "weekend_plans.dlg18"
  },
  {
   "speaker": "user",
   "text": "My son needs to bring a present.",
