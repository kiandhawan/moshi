   "gap_before": 2.84,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Wrap it on Friday night so you're not doing it in the car.",
   "est_sec": 4.13,
   "gap_before": 0.45,
   "role": "reply",
   "block": "weekend_plans.dlg18"
  },
  {
   "speaker": "user",
   "text": "Hold on, that's not right.",
