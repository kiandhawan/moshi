 "est_total_sec": 49.84,
 "est_speech_sec": 37.68,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.32,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.75,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "I work in a hospital, so my weekend is Tuesday and Wednesday. Nobody's free.",
   "est_sec": 4.44,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "That can feel lonely, but weekdays have perks. Everything's quieter, from museums to cinemas.",
   "est_sec": 4.44,
   "gap_before": 0.31,
   "role": "reply",
   "block": "weekend_plans.dlg31"
  },
  {
   "speaker": "user",
   "text": "True. The cinema's empty on a Tuesday.",
   "est_sec": 2.27,
   "gap_before": 1.36,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "And many places have cheaper midweek prices. You could treat yourself to things you'd skip on a crowded weekend.",
   "est_sec": 5.99,
   "gap_before": 1.18,
   "role": "reply",
   "block": "weekend_plans.dlg31"
  },
  {
   "speaker": "user",
   "text": "I'd still like",
   "est_sec": 1.03,
   "gap_before": 1.42,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg31"
  },
  {
   "speaker": "user",
   "text": "to see people though.",
   "est_sec": 1.34,
   "gap_before": 2.49,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Look for others with odd schedules, like coworkers or groups for shift workers. Or meet a friend for an early dinner after their work.",
   "est_sec": 7.54,
   "gap_before": 0.96,
   "role": "reply",
   "block": "weekend_plans.dlg31"
  },
  {
   "speaker": "user",
   "text": "Good idea. A colleague has the same days off.",
   "est_sec": 2.89,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Perfect. Make it a regular Tuesday thing, it'll give your week a shape.",
   "est_sec": 4.13,
   "gap_before": 0.83,
   "role": "reply",
   "block": "weekend_plans.dlg31"
  }
 ]
}
