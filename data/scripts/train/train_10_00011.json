 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.44,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "My son broke the handle off his bedroom door. Classic.",
   "est_sec": 3.2,
   "gap_before": 0.29,
   "event": "ordinary_request",
   "block": "home_repair.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Kids and door handles. Does the handle just need screwing back on, or is the part inside broken?",
   "est_sec": 5.68,
   "gap_before": 0.74,
   "role": "reply",
   "block": "home_repair.dlg11"
  },
  {
   "speaker": "user",
   "text": "The bit inside is snapped. The square metal bit.",
   "est_sec": 2.89,
   "gap_before": 0.7,
   "event": "ordinary_request",
   "block": "home_repair.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "That's the spindle. You can buy a new one cheaply, just measure the door thickness so you get the right length.",
   "est_sec": 6.61,
   "gap_before": 1.41,
   "role": "reply",
   "block": "home_repair.dlg11"
  },
  {
   "speaker": "user",
   "text": "And the handle itself is fine?",
   "est_sec": 1.96,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "home_repair.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "If it's not cracked, reuse it. Slide the new spindle through, fit both handles, and screw them back on.",
   "est_sec": 5.99,
   "gap_before": 0.62,
   "role": "reply",
   "block": "home_repair.dlg11"
  },
  {
   "speaker": "user",
   "text": "Should I make him",
   "est_sec": 1.34,
   "gap_before": 0.71,
   "event": "distractor",
   "kind": "pause",
   "block": "home_repair.dlg11"
  },
  {
   "speaker": "user",
   "text": "help me fix it?",
   "est_sec": 1.34,
   "gap_before": 2.05,
   "event": "ordinary_request",
   "block": "home_repair.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Absolutely. It's a nice little lesson, and he might be gentler with it next time.",
   "est_sec": 4.75,
   "gap_before": 0.68,
   "role": "reply",
   "block": "home_repair.dlg11"
  }
 ]
}
