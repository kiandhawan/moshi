   "gap_before": 0.4,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "I've got about forty houseplants and I'm moving across the country.",
   "est_sec": 3.51,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "block": "moving_house.ctx11"
  },
  {
   "speaker": "moshi",
   "text": "That's a jungle. You could give most of them to friends and take just your favourites, or pack them all in the car and risk a few casualties. How attached are you?",
   "est_sec": 10.02,
   "gap_before": 0.47,
   "role": "reply",
   "block": "moving_house.ctx11"
  },
  {
   "speaker": "user",
   "text": "I'll need twenty seconds to think. Ask me again after that.",
   "est_sec": 3.51,
   "gap_before": 0.8,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 20,
   "phrasing": "think_instr_28"
  },
  {
   "speaker": "moshi",
   "text": "No problem.",
   "est_sec": 0.72,
   "gap_before": 0.43,
   "role": "ack",
   "phrasing": "ack_04"
  },
  {
   "speaker": "moshi",
   "text": "So, is the whole jungle coming, or just the stars of the collection?",
