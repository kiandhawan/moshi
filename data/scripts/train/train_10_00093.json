 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, nice to hear from you. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.56,
   "role": "greeting",
   "phrasing": "greet_13"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
