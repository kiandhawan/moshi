 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.49,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "My grandson keeps talking about some building game with blocks. What is it?",
   "est_sec": 4.13,
   "gap_before": 0.25,
   "event": "ordinary_request",
   "block": "video_games.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "He probably means a sandbox game where you build anything you like out of blocks, a bit like digital Lego. It's hugely popular with kids.",
   "est_sec": 7.85,
   "gap_before": 0.51,
   "role": "reply",
   "block": "video_games.dlg4"
  },
  {
   "speaker": "user",
   "text": "Is it violent at all?",
   "est_sec": 1.65,
   "gap_before": 1.17,
   "event": "ordinary_request",
   "block": "video_games.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Very mildly. There are a few cartoon monsters at night, but there's also a mode with no monsters, just building.",
   "est_sec": 6.3,
   "gap_before": 0.5,
   "role": "reply",
   "block": "video_games.dlg4"
  },
  {
   "speaker": "user",
   "text": "Could I play it with him? I'm seventy-three and",
   "est_sec": 2.89,
   "gap_before": 0.45,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg4"
  },
  {
   "speaker": "user",
   "text": "hopeless with computers.",
   "est_sec": 1.03,
   "gap_before": 2.54,
   "event": "ordinary_request",
   "block": "video_games.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "You definitely could. Ask him to teach you, kids love being the expert and the basics are simple.",
   "est_sec": 5.68,
   "gap_before": 0.53,
   "role": "reply",
   "block": "video_games.dlg4"
  },
  {
   "speaker": "user",
   "text": "That's a lovely idea. He'd think it was hilarious.",
   "est_sec": 2.89,
   "gap_before": 0.68,
   "event": "ordinary_request",
   "block": "video_games.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "He'd probably build you a house on the first day.",
   "est_sec": 3.2,
   "gap_before": 1.76,
   "role": "reply",
   "block": "video_games.dlg4"
  }
 ]
}
