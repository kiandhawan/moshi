 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.43,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.86,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "My uncle's funeral is next week and the family asked me to choose a song.",
   "est_sec": 4.75,
   "gap_before": 0.25,
   "event": "ordinary_request",
   "block": "music.ctx12"
  },
  {
   "speaker": "moshi",
   "text": "I'm sorry about your uncle. Would you pick something he loved that might be upbeat, or something more traditional and calm?",
   "est_sec": 6.61,
   "gap_before": 1.91,
   "role": "reply",
   "block": "music.ctx12"
  },
  {
   "speaker": "user",
   "text": "Wait a moment, my coworker is here. Please be quiet until I tell you I'm back.",
   "est_sec": 5.06,
   "gap_before": 1.06,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_14"
  },
  {
   "speaker": "moshi",
   "text": "Take your time.",
   "est_sec": 1.03,
   "gap_before": 0.48,
   "role": "ack",
   "phrasing": "ack_09"
  },
  {
   "speaker": "user",
   "text": "Chloe, where's the tape gun?",
   "est_sec": 1.65,
   "gap_before": 1.28,
   "event": "distractor",
   "kind": "friend_question",
   "block": "moving_house.side4"
  },
  {
   "speaker": "friend",
   "text": "You had it. Two minutes ago.",
   "est_sec": 1.96,
   "gap_before": 0.72,
   "block": "moving_house.side4"
  },
  {
   "speaker": "user",
   "text": "I put it down on a box.",
   "est_sec": 2.27,
   "gap_before": 0.45,
   "block": "moving_house.side4"
  },
  {
   "speaker": "friend",
   "text": "Which box? There are eighty boxes.",
   "est_sec": 1.96,
   "gap_before": 1.01,
   "block": "moving_house.side4"
  },
  {
   "speaker": "user",
   "text": "Can you just check the ones in the hall?",
   "est_sec": 2.89,
   "gap_before": 1.32,
   "event": "distractor",
   "kind": "friend_question",
   "block": "moving_house.side4"
  },
  {
   "speaker": "friend",
   "text": "Found it. You taped it into the box with the towels.",
   "est_sec": 3.51,
   "gap_before": 0.35,
   "block": "moving_house.side4"
  },
  {
   "speaker": "user",
   "text": "Of course I did.",
   "est_sec": 1.34,
   "gap_before": 2.96,
   "block": "moving_house.side4"
  },
  {
   "speaker": "user",
   "text": "Okay, that's sorted. I'm back.",
   "est_sec": 1.65,
   "gap_before": 0.8,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_08"
  },
  {
   "speaker": "moshi",
   "text": "Alright. The song for your uncle. One he loved, or something traditional?",
   "est_sec": 3.82,
   "gap_before": 0.77,
   "role": "resume",
   "block": "music.ctx12"
  },
  {
   "speaker": "user",
   "text": "One he loved. He sang it at every family party.",
   "est_sec": 3.2,
   "gap_before": 3.25,
   "event": "ordinary_request",
   "block": "music.ctx12"
  },
  {
   "speaker": "moshi",
   "text": "That sounds perfect. People will smile and remember him singing it, that's a lovely tribute.",
   "est_sec": 4.75,
   "gap_before": 1.13,
