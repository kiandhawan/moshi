 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.31,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.89,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "It's damp and grey for weeks. How do I dry washing indoors without the flat smelling musty?",
   "est_sec": 5.37,
   "gap_before": 0.59,
   "event": "ordinary_request",
   "block": "weather_plans.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Space the clothes out on the rack so air can move between them. Don't cram everything together.",
   "est_sec": 5.37,
   "gap_before": 0.43,
   "role": "reply",
   "block": "weather_plans.dlg17"
  },
  {
   "speaker": "user",
   "text": "I've got a small flat and one rack.",
   "est_sec": 2.58,
   "gap_before": 1.04,
   "event": "ordinary_request",
   "block": "weather_plans.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Then do smaller loads more often. Use the highest spin on your washing machine to get more water out.",
   "est_sec": 5.99,
   "gap_before": 0.31,
   "role": "reply",
   "block": "weather_plans.dlg17"
  },
  {
   "speaker": "user",
   "text": "Windows open or closed?",
   "est_sec": 1.34,
   "gap_before": 0.75,
   "event": "ordinary_request",
   "block": "weather_plans.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Open a little if you can, or put the rack near an extractor fan. A dehumidifier is even better and dries things fast.",
   "est_sec": 7.23,
   "gap_before": 1.4,
   "role": "reply",
   "block": "weather_plans.dlg17"
  },
  {
   "speaker": "user",
   "text": "Are those expensive to run?",
   "est_sec": 1.65,
   "gap_before": 1.17,
   "event": "ordinary_request",
   "block": "weather_plans.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Less than a tumble dryer usually. And it'll help stop mould on the walls, which is often the real musty smell.",
   "est_sec": 6.61,
   "gap_before": 1.46,
   "role": "reply",
   "block": "weather_plans.dlg17"
  }
 ]
}
