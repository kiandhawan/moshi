 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.39,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.62,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "I hate malls. I need one plain white dress shirt for tomorrow and I want to be in and out.",
   "est_sec": 6.3,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "shopping.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Totally doable. Do you know your collar and sleeve size?",
   "est_sec": 3.2,
   "gap_before": 0.37,
   "role": "reply",
   "block": "shopping.dlg16"
  },
  {
   "speaker": "user",
   "text": "No idea.",
   "est_sec": 0.72,
   "gap_before": 0.8,
   "event": "ordinary_request",
   "block": "shopping.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Then go straight to a menswear department and ask them to measure you, it takes about a minute.",
   "est_sec": 5.68,
   "gap_before": 1.1,
   "role": "reply",
   "block": "shopping.dlg16"
  },
  {
   "speaker": "user",
   "text": "Ugh, talking to people.",
   "est_sec": 1.34,
   "gap_before": 0.82,
   "event": "ordinary_request",
   "block": "shopping.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "One short conversation saves you buying the wrong size twice. Ask for a non iron cotton shirt, so you don't need to press it tonight.",
   "est_sec": 7.85,
   "gap_before": 0.51,
   "role": "reply",
   "block": "shopping.dlg16"
  },
  {
   "speaker": "user",
   "text": "Slim fit or regular?",
   "est_sec": 1.34,
   "gap_before": 1.26,
   "event": "ordinary_request",
   "block": "shopping.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Try both on. If the buttons pull across your chest when you sit, go regular.",
   "est_sec": 4.75,
   "gap_before": 0.33,
   "role": "reply",
   "block": "shopping.dlg16"
  },
  {
   "speaker": "user",
   "text": "Fine. In, measured, two shirts tried, out.",
   "est_sec": 2.27,
   "gap_before": 1.18,
   "event": "ordinary_request",
   "block": "shopping.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "That's the plan. You'll be back in the car park in twenty minutes.",
   "est_sec": 4.13,
   "gap_before": 0.81,
   "role": "reply",
   "block": "shopping.dlg16"
  }
 ]
}
