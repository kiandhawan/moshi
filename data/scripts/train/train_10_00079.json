 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.33,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.31,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "My twelve year old wants to go to her first concert. I'm a bit nervous about it.",
   "est_sec": 5.37,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "music.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Understandable. A smaller venue or a seated arena show is a gentler first experience than a standing crowd.",
   "est_sec": 5.68,
   "gap_before": 0.88,
   "role": "reply",
   "block": "music.dlg22"
  },
  {
   "speaker": "user",
   "text": "She wants to be at the front, obviously.",
   "est_sec": 2.58,
   "gap_before": 1.07,
   "event": "ordinary_request",
   "block": "music.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Of course she does. If you go with her, maybe stand near the side or the back of the standing area, so you can step out if it gets crushed.",
   "est_sec": 9.4,
   "gap_before": 1.14,
   "role": "reply",
   "block": "music.dlg22"
  },
  {
   "speaker": "user",
   "text": "Should I bring",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "event": "distractor",
   "kind": "pause",
   "block": "music.dlg22"
  },
  {
   "speaker": "user",
   "text": "earplugs for her too?",
   "est_sec": 1.34,
   "gap_before": 1.98,
   "event": "ordinary_request",
   "block": "music.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Definitely. Kids' ears are more sensitive, and concerts are really loud. The small musician style ones don't spoil the music.",
   "est_sec": 6.3,
   "gap_before": 0.59,
   "role": "reply",
   "block": "music.dlg22"
  },
  {
   "speaker": "user",
   "text": "Anything else?",
   "est_sec": 0.72,
   "gap_before": 0.4,
   "event": "ordinary_request",
   "block": "music.dlg22"
  },
  {
   "speaker": "moshi",
   "text": "Agree on a meeting point in case you get separated, and write your phone number on her arm or a card in her pocket.",
   "est_sec": 7.54,
   "gap_before": 0.41,
   "role": "reply",
   "block": "music.dlg22"
  }
 ]
