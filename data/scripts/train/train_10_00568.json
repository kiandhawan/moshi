 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.45,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "What should I pack for a weekend where it might be sunny or might pour?",
   "est_sec": 4.75,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "weather_plans.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Layers are your friend. A t-shirt, a warm sweater and a light waterproof jacket cover most situations.",
   "est_sec": 5.37,
   "gap_before": 0.66,
   "role": "reply",
   "block": "weather_plans.dlg2"
  },
  {
   "speaker": "user",
   "text": "What about shoes? I only want to bring one pair.",
   "est_sec": 3.2,
   "gap_before": 2.01,
   "event": "ordinary_request",
   "block": "weather_plans.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Then pick something comfortable that can handle getting wet, like trail runners or water resistant sneakers.",
   "est_sec": 5.06,
   "gap_before": 0.85,
   "role": "reply",
   "block": "weather_plans.dlg2"
  },
  {
   "speaker": "user",
   "text": "Should I bother with an umbrella or",
   "est_sec": 2.27,
   "gap_before": 0.97,
   "event": "distractor",
   "kind": "pause",
   "block": "weather_plans.dlg2"
  },
  {
   "speaker": "user",
   "text": "is the jacket enough?",
   "est_sec": 1.34,
   "gap_before": 1.81,
   "event": "ordinary_request",
   "block": "weather_plans.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "If the jacket has a hood, it's usually enough. A small folding umbrella is nice if you'll be walking around a city.",
   "est_sec": 6.92,
   "gap_before": 1.15,
   "role": "reply",
   "block": "weather_plans.dlg2"
  },
  {
   "speaker": "user",
   "text": "We'll be in a city, mostly.",
   "est_sec": 1.96,
   "gap_before": 1.35,
   "event": "ordinary_request",
   "block": "weather_plans.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Then toss the umbrella in your bag. It barely takes up any space.",
   "est_sec": 4.13,
   "gap_before": 0.47,
   "role": "reply",
   "block": "weather_plans.dlg2"
  }
 ]
