 "est_total_sec": 51.79,
 "est_speech_sec": 34.89,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.62,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.66,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "Recipe says two tablespoons of fresh thyme. I only have dried.",
   "est_sec": 3.51,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "cooking.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Use about a third as much dried, so roughly two teaspoons.",
   "est_sec": 3.51,
   "gap_before": 1.61,
   "role": "reply",
   "block": "cooking.dlg17"
  },
  {
   "speaker": "user",
   "text": "Why less?",
   "est_sec": 0.72,
   "gap_before": 3.26,
   "event": "ordinary_request",
   "block": "cooking.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Dried herbs are more concentrated because the water's gone.",
   "est_sec": 2.89,
   "gap_before": 1.01,
   "role": "reply",
   "block": "cooking.dlg17"
  },
  {
   "speaker": "user",
   "text": "Does that work for all herbs?",
   "est_sec": 1.96,
   "gap_before": 2.47,
   "event": "ordinary_request",
   "block": "cooking.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "For woody ones like thyme, rosemary and oregano, yes. Soft herbs like basil or coriander lose a lot when dried, so they're not a great swap.",
   "est_sec": 8.16,
   "gap_before": 0.35,
   "role": "reply",
   "block": "cooking.dlg17"
  },
  {
   "speaker": "user",
   "text": "Good to know. When do I add it, at the start",
   "est_sec": 3.51,
   "gap_before": 1.22,
   "event": "distractor",
   "kind": "pause",
   "block": "cooking.dlg17"
  },
  {
   "speaker": "user",
   "text": "or the end?",
   "est_sec": 1.03,
   "gap_before": 2.77,
   "event": "ordinary_request",
   "block": "cooking.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Dried herbs go in early so they have time to soften. Fresh soft herbs go in at the very end.",
   "est_sec": 6.3,
   "gap_before": 0.94,
   "role": "reply",
   "block": "cooking.dlg17"
  }
 ]
}
