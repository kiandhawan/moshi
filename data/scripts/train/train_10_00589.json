 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.35,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.56,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "My husband and I are glued to our phones all weekend. I want to change that.",
   "est_sec": 5.06,
   "gap_before": 0.24,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "That's a lovely goal. Try a simple rule, like no phones during meals or on walks.",
   "est_sec": 5.06,
   "gap_before": 1.2,
   "role": "reply",
   "block": "weekend_plans.dlg21"
  },
  {
   "speaker": "user",
   "text": "He'll moan.",
   "est_sec": 0.72,
   "gap_before": 1.12,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Make it a game rather than a rule. Phones in a basket, and whoever checks first does the dishes.",
   "est_sec": 5.99,
   "gap_before": 0.34,
   "role": "reply",
   "block": "weekend_plans.dlg21"
  },
  {
   "speaker": "user",
   "text": "Ha, he'd lose instantly.",
   "est_sec": 1.34,
   "gap_before": 3.01,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Then you'd get clean dishes and his attention. Win win.",
   "est_sec": 3.2,
   "gap_before": 0.47,
   "role": "reply",
   "block": "weekend_plans.dlg21"
  },
  {
   "speaker": "user",
   "text": "What do we",
   "est_sec": 1.03,
   "gap_before": 1.45,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg21"
  },
  {
   "speaker": "user",
   "text": "actually do instead, though?",
   "est_sec": 1.34,
   "gap_before": 2.1,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Something with your hands, like cooking, a puzzle, or a walk with a destination. It's easier to put the phone down when you're busy.",
   "est_sec": 7.54,
   "gap_before": 1.31,
   "role": "reply",
   "block": "weekend_plans.dlg21"
  }
 ]
}
