 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.68,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.31,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "I have to recite a poem in English class on Monday. Forty lines. I'm going to die.",
   "est_sec": 5.37,
   "gap_before": 0.31,
   "event": "ordinary_request",
   "block": "studying.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "You'll survive, I promise. Have you got a favourite way of learning things by heart?",
   "est_sec": 4.75,
   "gap_before": 0.31,
   "role": "reply",
   "block": "studying.dlg7"
  },
  {
   "speaker": "user",
   "text": "Not really. I just read it again and again.",
   "est_sec": 2.89,
   "gap_before": 3.5,
   "event": "ordinary_request",
   "block": "studying.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Try learning it in chunks of four lines. Say the first chunk out loud until you can do it without looking, then add the next.",
   "est_sec": 7.85,
   "gap_before": 0.54,
   "role": "reply",
   "block": "studying.dlg7"
  },
  {
   "speaker": "user",
   "text": "That takes forever.",
   "est_sec": 1.03,
   "gap_before": 2.71,
   "event": "ordinary_request",
   "block": "studying.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "It's faster than rereading. Walk around while you practise, moving actually helps memory.",
   "est_sec": 4.13,
   "gap_before": 0.43,
   "role": "reply",
   "block": "studying.dlg7"
  },
  {
   "speaker": "user",
   "text": "And if I forget a line",
   "est_sec": 1.96,
   "gap_before": 0.49,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg7"
  },
  {
   "speaker": "user",
   "text": "in front of everyone?",
   "est_sec": 1.34,
   "gap_before": 2.7,
   "event": "ordinary_request",
   "block": "studying.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Pause, breathe, and carry on from where you remember. Most people won't even notice.",
   "est_sec": 4.44,
   "gap_before": 1.1,
   "role": "reply",
   "block": "studying.dlg7"
  }
 ]
