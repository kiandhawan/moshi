   "text": "Another is a cheaper place in a quiet neighborhood, but it's a forty minute bus ride to work.",
   "est_sec": 5.68,
   "gap_before": 2.31,
   "block": "moving_house.opt2",
   "event": "distractor",
   "kind": "pause"
  },
  {
