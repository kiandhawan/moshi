   "gap_before": 0.38,
   "role": "ack",
   "phrasing": "ack_16"
  },
  {
   "speaker": "user",
   "text": "One is a bright two bedroom near the train station, but the rent is at the top of my budget.",
   "est_sec": 6.3,
   "gap_before": 1.44,
   "block": "moving_house.opt2",
   "event": "distractor",
   "kind": "pause"
  },
