   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "I've seen a few apartments and I need to choose one before Friday.",
   "est_sec": 4.13,
   "gap_before": 0.22,
   "block": "moving_house.opt2"
  },
  {
   "speaker": "user",
   "text": "Hear me out on all the options before you comment.",
