   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "My daughter wants to bake with me on Sunday. She's seven.",
   "est_sec": 3.51,
   "gap_before": 0.39,
   "event": "ordinary_request",
   "block": "baking.ctx3"
  },
  {
