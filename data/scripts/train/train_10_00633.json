 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.98,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "Can I use oil instead of butter in a cake? I've run out.",
   "est_sec": 4.13,
   "gap_before": 0.41,
   "event": "ordinary_request",
   "block": "baking.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "In most cakes, yes. Use a bit less oil than the butter amount, roughly three quarters.",
   "est_sec": 5.06,
   "gap_before": 0.82,
   "role": "reply",
   "block": "baking.dlg30"
  },
  {
   "speaker": "user",
   "text": "Will it taste different?",
   "est_sec": 1.34,
   "gap_before": 1.24,
   "event": "ordinary_request",
   "block": "baking.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "You lose the buttery flavour, but oil cakes are often moister and stay soft for longer.",
   "est_sec": 5.06,
   "gap_before": 0.59,
   "role": "reply",
   "block": "baking.dlg30"
  },
  {
   "speaker": "user",
   "text": "It's a",
   "est_sec": 0.72,
   "gap_before": 1.35,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg30"
  },
  {
   "speaker": "user",
   "text": "chocolate cake, if that matters.",
   "est_sec": 1.65,
   "gap_before": 2.91,
   "event": "ordinary_request",
   "block": "baking.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "That's ideal, actually. Chocolate hides the missing butter flavour completely, and lots of chocolate cake recipes use oil anyway.",
   "est_sec": 5.99,
   "gap_before": 0.47,
   "role": "reply",
   "block": "baking.dlg30"
  },
  {
   "speaker": "user",
   "text": "Any kind of oil?",
   "est_sec": 1.34,
   "gap_before": 0.63,
   "event": "ordinary_request",
   "block": "baking.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Something neutral like sunflower or vegetable. Avoid strong olive oil unless you like the flavour.",
   "est_sec": 4.75,
   "gap_before": 0.66,
   "role": "reply",
   "block": "baking.dlg30"
  }
 ]
}
