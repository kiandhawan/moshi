 "est_total_sec": 52.28,
 "est_speech_sec": 39.23,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.46,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.79,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "Midges. Last summer they ate me alive by the loch. What actually works?",
   "est_sec": 4.13,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "hiking.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Repellents with picaridin or a high strength of DEET work best. Some people swear by a head net too, it looks silly but it's bliss.",
   "est_sec": 7.85,
   "gap_before": 0.45,
   "role": "reply",
   "block": "hiking.dlg18"
  },
  {
   "speaker": "user",
   "text": "I'll look silly, I don't care.",
   "est_sec": 1.96,
   "gap_before": 1.12,
   "event": "ordinary_request",
   "block": "hiking.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "That's the spirit. Midges are worst at dawn and dusk and on still days, so a breezy ridge is much better than a sheltered glen.",
   "est_sec": 7.85,
   "gap_before": 0.54,
   "role": "reply",
   "block": "hiking.dlg18"
  },
  {
   "speaker": "user",
   "text": "And when I stop for lunch?",
   "est_sec": 1.96,
   "gap_before": 2.97,
   "event": "ordinary_request",
   "block": "hiking.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "Find a spot in the wind or the sun. They hate both.",
   "est_sec": 3.82,
   "gap_before": 0.9,
   "role": "reply",
   "block": "hiking.dlg18"
  },
  {
   "speaker": "user",
   "text": "Anything for the bites themselves? I scratched",
   "est_sec": 2.27,
   "gap_before": 0.47,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg18"
  },
  {
   "speaker": "user",
   "text": "until they bled.",
   "est_sec": 1.03,
   "gap_before": 2.84,
   "event": "ordinary_request",
   "block": "hiking.dlg18"
  },
  {
   "speaker": "moshi",
   "text": "An antihistamine and a cold compress help. Try hard not to scratch, it only makes them itch longer.",
   "est_sec": 5.68,
   "gap_before": 0.68,
   "role": "reply",
   "block": "hiking.dlg18"
  }
 ]
}
