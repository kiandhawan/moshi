 "est_total_sec": 50.17,
 "est_speech_sec": 39.85,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.41,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.65,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "I'm retired now and finally have time to fix up the deck. Where do I even begin?",
   "est_sec": 5.37,
   "gap_before": 0.46,
   "event": "ordinary_request",
   "block": "home_repair.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Start with a good look for loose boards, popped nails and soft spots. Soft wood means rot and should be replaced first.",
   "est_sec": 6.92,
   "gap_before": 0.37,
   "role": "reply",
   "block": "home_repair.dlg2"
  },
  {
   "speaker": "user",
   "text": "There are a few soft boards near the steps, yes.",
   "est_sec": 3.2,
   "gap_before": 1.09,
   "event": "ordinary_request",
   "block": "home_repair.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Replace those, then give the whole deck a scrub with a deck cleaner and let it dry for a couple of days.",
   "est_sec": 6.92,
   "gap_before": 0.92,
   "role": "reply",
   "block": "home_repair.dlg2"
  },
  {
   "speaker": "user",
   "text": "Then stain it?",
   "est_sec": 1.03,
   "gap_before": 0.74,
   "event": "ordinary_request",
   "block": "home_repair.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. Pick a dry stretch of weather and apply a thin, even coat. Two thin coats beat one thick one.",
   "est_sec": 6.3,
   "gap_before": 0.69,
   "role": "reply",
   "block": "home_repair.dlg2"
  },
  {
   "speaker": "user",
   "text": "I was going to do it all",
   "est_sec": 2.27,
   "gap_before": 0.41,
   "event": "distractor",
   "kind": "pause",
   "block": "home_repair.dlg2"
  },
  {
   "speaker": "user",
   "text": "well, maybe over two weekends instead.",
   "est_sec": 1.96,
   "gap_before": 2.7,
   "event": "ordinary_request",
   "block": "home_repair.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "That's a sensible pace. Repairs and cleaning one weekend, staining the next.",
   "est_sec": 3.82,
   "gap_before": 0.38,
   "role": "reply",
   "block": "home_repair.dlg2"
  }
 ]
}
