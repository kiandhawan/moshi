 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi there, how are you feeling today?",
   "est_sec": 2.27,
   "gap_before": 0.36,
   "role": "greeting",
   "phrasing": "greet_08"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.6,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "Someone in the row in front keeps checking their phone in the cinema. It's so bright.",
   "est_sec": 5.06,
   "gap_before": 0.36,
   "event": "ordinary_request",
   "block": "movies.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "That is annoying. A quiet, polite word usually works, like asking if they could turn the brightness down.",
   "est_sec": 5.68,
   "gap_before": 0.57,
   "role": "reply",
   "block": "movies.dlg32"
  },
  {
   "speaker": "user",
   "text": "I hate confrontation.",
   "est_sec": 1.03,
   "gap_before": 1.17,
   "event": "ordinary_request",
   "block": "movies.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Then tell a staff member at the next chance. They deal with it all the time and won't mention you.",
   "est_sec": 6.3,
   "gap_before": 1.29,
   "role": "reply",
   "block": "movies.dlg32"
  },
  {
   "speaker": "user",
   "text": "But I'd miss",
   "est_sec": 1.03,
   "gap_before": 1.62,
   "event": "distractor",
   "kind": "pause",
   "block": "movies.dlg32"
  },
  {
   "speaker": "user",
   "text": "part of the film walking out.",
   "est_sec": 1.96,
   "gap_before": 2.74,
   "event": "ordinary_request",
   "block": "movies.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "True. You could also quietly move seats, if there's space further away.",
   "est_sec": 3.82,
   "gap_before": 0.46,
   "role": "reply",
   "block": "movies.dlg32"
  },
  {
   "speaker": "user",
   "text": "Wait, are you sure about that?",
   "est_sec": 1.96,
   "gap_before": 0.76,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_08",
   "block": "movies.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Let me double-check. I'd still stand by it, but tell me what you heard.",
   "est_sec": 4.44,
   "gap_before": 1.54,
   "role": "reply",
   "block": "movies.dlg32"
  },
  {
   "speaker": "user",
   "text": "There's a free seat two rows back.",
   "est_sec": 2.27,
   "gap_before": 1.3,
   "event": "ordinary_request",
   "block": "movies.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Then grab it. Sometimes the easiest fix is just getting out of the glow.",
   "est_sec": 4.44,
   "gap_before": 1.14,
   "role": "reply",
   "block": "movies.dlg32"
  }
 ]
