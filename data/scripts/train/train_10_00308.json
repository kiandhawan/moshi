   "gap_before": 0.74,
   "event": "ordinary_request",
   "block": "coffee.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "A cappuccino has a thick layer of foam on top, and it's usually smaller than a latte.",
   "est_sec": 5.37,
   "gap_before": 0.92,
   "role": "reply",
   "block": "coffee.dlg1"
  },
