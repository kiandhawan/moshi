 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.8,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.46,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "The neighbours in our new street seem really friendly. We're thinking of a housewarming.",
   "est_sec": 4.44,
   "gap_before": 0.29,
   "event": "ordinary_request",
   "block": "moving_house.ctx9"
  },
  {
   "speaker": "moshi",
   "text": "Lovely. Would you invite them now, while the boxes are still everywhere, or wait a few weeks until the house looks like a home?",
   "est_sec": 7.54,
   "gap_before": 0.76,
   "role": "reply",
   "block": "moving_house.ctx9"
  },
  {
   "speaker": "user",
   "text": "Pause for a bit, my kid needs me. I'll come back to you when I'm done.",
   "est_sec": 5.06,
   "gap_before": 1.27,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_29"
  },
  {
   "speaker": "user",
   "text": "Did you move my basil off the windowsill?",
   "est_sec": 2.58,
   "gap_before": 0.72,
   "event": "distractor",
   "kind": "friend_question",
   "block": "gardening.side5"
  },
  {
   "speaker": "friend",
   "text": "Yeah, it was blocking the blind.",
   "est_sec": 1.96,
   "gap_before": 1.43,
   "block": "gardening.side5"
  },
  {
   "speaker": "user",
   "text": "It's gone completely floppy now. It was fine yesterday.",
   "est_sec": 2.89,
   "gap_before": 1.07,
   "block": "gardening.side5"
  },
  {
   "speaker": "friend",
   "text": "It's a plant, it'll survive.",
   "est_sec": 1.65,
   "gap_before": 1.16,
   "block": "gardening.side5"
  },
  {
   "speaker": "user",
   "text": "It's on the radiator shelf. It's literally cooking.",
   "est_sec": 2.58,
   "gap_before": 0.75,
   "block": "gardening.side5"
  },
  {
   "speaker": "friend",
   "text": "Oh. I didn't think about the radiator.",
   "est_sec": 2.27,
   "gap_before": 1.02,
   "block": "gardening.side5"
  },
  {
   "speaker": "user",
   "text": "Can you just put it back where it was next time?",
   "est_sec": 3.51,
   "gap_before": 1.45,
   "event": "distractor",
   "kind": "friend_question",
   "block": "gardening.side5"
  },
  {
   "speaker": "friend",
   "text": "Fine, fine. Sorry, little basil.",
   "est_sec": 1.65,
   "gap_before": 0.54,
   "block": "gardening.side5"
  },
  {
   "speaker": "user",
   "text": "Are you back on the night shift this week?",
   "est_sec": 2.89,
   "gap_before": 1.27,
   "event": "distractor",
   "kind": "near_miss",
   "phrasing": "dn_56"
  },
  {
