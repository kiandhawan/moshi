 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How's life treating you?",
   "est_sec": 1.65,
   "gap_before": 0.31,
   "role": "greeting",
   "phrasing": "greet_14"
  },
  {
   "speaker": "user",
   "text": "Hanging in there.",
   "est_sec": 1.03,
   "gap_before": 0.87,
   "event": "greeting_answer",
   "phrasing": "greet_ans_14"
  },
  {
   "speaker": "user",
   "text": "I'm at the rental desk at the airport and they're pushing the extra insurance on me.",
   "est_sec": 5.06,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "cars.ctx10"
  },
  {
   "speaker": "moshi",
   "text": "They always do. Does your credit card already cover rental cars, or would you rather pay for the peace of mind?",
   "est_sec": 6.61,
   "gap_before": 1.27,
   "role": "reply",
   "block": "cars.ctx10"
  },
  {
   "speaker": "user",
   "text": "Pause for a bit, my kid needs me. I'll come back to you when I'm done.",
   "est_sec": 5.06,
   "gap_before": 0.98,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_29"
  },
  {
   "speaker": "moshi",
   "text": "Alright, go ahead.",
   "est_sec": 1.03,
   "gap_before": 0.53,
   "role": "ack",
   "phrasing": "ack_15"
  },
  {
   "speaker": "user",
   "text": "Okay, all done here, back to the game.",
   "est_sec": 2.58,
   "gap_before": 1.4,
   "event": "distractor",
   "kind": "near_miss",
   "phrasing": "dn_22"
  },
  {
   "speaker": "friend",
   "text": "Finally!",
   "est_sec": 0.41,
   "gap_before": 0.78,
   "phrasing": "dn_22"
  },
  {
   "speaker": "user",
   "text": "Sam, you worked there for two years. What's the manager actually like?",
   "est_sec": 3.82,
   "gap_before": 1.42,
   "event": "distractor",
   "kind": "friend_question",
   "block": "job_interview.side6"
  },
  {
   "speaker": "friend",
   "text": "Diane? Sharp, a bit intimidating at first, but fair.",
   "est_sec": 2.89,
   "gap_before": 0.45,
   "block": "job_interview.side6"
  },
  {
   "speaker": "user",
   "text": "Intimidating how?",
   "est_sec": 0.72,
   "gap_before": 2.82,
   "event": "distractor",
   "kind": "friend_question",
   "block": "job_interview.side6"
  },
  {
   "speaker": "friend",
   "text": "She asks follow up questions until she gets to the real answer. Don't give her vague stuff.",
   "est_sec": 5.37,
   "gap_before": 0.68,
   "block": "job_interview.side6"
  },
  {
   "speaker": "user",
   "text": "Good to know. Does she care about the degree thing? I never finished mine.",
   "est_sec": 4.44,
   "gap_before": 0.9,
   "block": "job_interview.side6"
  },
  {
   "speaker": "friend",
   "text": "Not really. She cares whether you can show her actual work. Bring examples.",
   "est_sec": 4.13,
   "gap_before": 2.81,
   "block": "job_interview.side6"
  },
  {
   "speaker": "user",
   "text": "Okay, I'll print a couple of the reports I did last year.",
   "est_sec": 3.82,
   "gap_before": 0.34,
   "block": "job_interview.side6"
  },
  {
   "speaker": "user",
   "text": "Alright, back to you.",
   "est_sec": 1.34,
   "gap_before": 0.87,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_13"
  },
  {
   "speaker": "moshi",
   "text": "No problem. That rental desk. Did you decide on the extra cover?",
   "est_sec": 3.82,
   "gap_before": 0.71,
   "role": "resume",
   "block": "cars.ctx10"
  },
  {
   "speaker": "user",
   "text": "I checked, my card covers it, so I'm saying no.",
   "est_sec": 3.2,
   "gap_before": 0.75,
   "event": "ordinary_request",
   "block": "cars.ctx10"
  },
  {
   "speaker": "moshi",
   "text": "Great. Take photos of every scratch before you drive off, just in case.",
   "est_sec": 4.13,
   "gap_before": 0.49,
   "role": "followup",
   "block": "cars.ctx10"
  }
 ]
