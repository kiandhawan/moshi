 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.47,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.86,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "There's a brown ring in my toilet that won't come off no matter how much I scrub.",
   "est_sec": 5.37,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "cleaning.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "That's usually mineral buildup, not dirt. Pour in a cup of white vinegar and leave it overnight.",
   "est_sec": 5.37,
   "gap_before": 1.0,
   "role": "reply",
   "block": "cleaning.dlg17"
  },
  {
   "speaker": "user",
   "text": "Overnight? Can I use the toilet?",
   "est_sec": 1.96,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "cleaning.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Put a note on the lid if you live with others. In the morning, sprinkle baking soda and scrub with the brush.",
   "est_sec": 6.92,
   "gap_before": 0.47,
   "role": "reply",
   "block": "cleaning.dlg17"
  },
  {
   "speaker": "user",
   "text": "And if it's",
   "est_sec": 1.03,
   "gap_before": 0.74,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg17"
  },
  {
   "speaker": "user",
   "text": "still there?",
   "est_sec": 0.72,
   "gap_before": 2.27,
   "event": "ordinary_request",
   "block": "cleaning.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "A pumice stone, wet, gently on the ring. It takes it off without scratching the porcelain.",
   "est_sec": 5.06,
   "gap_before": 0.83,
   "role": "reply",
   "block": "cleaning.dlg17"
  },
  {
   "speaker": "user",
   "text": "A pumice stone. I have one in the bathroom already.",
   "est_sec": 3.2,
   "gap_before": 0.98,
   "event": "ordinary_request",
   "block": "cleaning.dlg17"
  },
  {
   "speaker": "moshi",
   "text": "Maybe just buy a separate one for the toilet.",
   "est_sec": 2.89,
   "gap_before": 0.35,
   "role": "reply",
   "block": "cleaning.dlg17"
  }
 ]
