 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.77,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.86,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "I want a nice Sunday morning ritual. Right now I just scroll my phone in bed until noon.",
   "est_sec": 5.68,
   "gap_before": 0.51,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Start with something small you'd look forward to. Like proper coffee made slowly, or pancakes.",
   "est_sec": 4.75,
   "gap_before": 0.95,
   "role": "reply",
   "block": "weekend_plans.dlg10"
  },
  {
   "speaker": "user",
   "text": "Pancakes, yes.",
   "est_sec": 0.72,
   "gap_before": 1.21,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Then add one thing that gets you outside, even briefly. A short walk to get a newspaper or flowers works.",
   "est_sec": 6.3,
   "gap_before": 0.57,
   "role": "reply",
   "block": "weekend_plans.dlg10"
  },
  {
   "speaker": "user",
   "text": "I don't really",
   "est_sec": 1.03,
   "gap_before": 0.51,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg10"
  },
  {
   "speaker": "user",
   "text": "read newspapers anymore.",
   "est_sec": 1.03,
   "gap_before": 1.91,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Then a pastry from a bakery. The point is the little walk and the treat.",
   "est_sec": 4.75,
   "gap_before": 0.78,
   "role": "reply",
   "block": "weekend_plans.dlg10"
  },
  {
   "speaker": "user",
   "text": "And the phone?",
   "est_sec": 1.03,
   "gap_before": 1.47,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg10"
  },
  {
   "speaker": "moshi",
   "text": "Leave it in another room until after breakfast. You'll be surprised how different the morning feels.",
   "est_sec": 5.06,
   "gap_before": 1.06,
   "role": "reply",
   "block": "weekend_plans.dlg10"
  }
 ]
}
