 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.73,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.96,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "I'm flying to Sydney from London next month. How do I not die of jet lag?",
   "est_sec": 5.06,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "travel_planning.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Start shifting your sleep a little in the few days before you leave, going to bed an hour earlier each night.",
   "est_sec": 6.61,
   "gap_before": 1.14,
   "role": "reply",
   "block": "travel_planning.dlg5"
  },
  {
   "speaker": "user",
   "text": "Earlier? I'm a total night owl.",
   "est_sec": 1.96,
   "gap_before": 1.05,
   "event": "ordinary_request",
   "block": "travel_planning.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "I know, but Sydney is way ahead of London, so even small shifts help. On the plane, set your watch to Sydney time and sleep when it's night there.",
   "est_sec": 9.09,
   "gap_before": 0.91,
   "role": "reply",
   "block": "travel_planning.dlg5"
  },
  {
   "speaker": "user",
   "text": "Hold on, really?",
   "est_sec": 1.03,
   "gap_before": 1.68,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_11",
   "block": "travel_planning.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Let me double-check. I'd still stand by it, but tell me what you heard.",
   "est_sec": 4.44,
   "gap_before": 0.88,
   "role": "reply",
   "block": "travel_planning.dlg5"
  },
  {
   "speaker": "user",
   "text": "And when I land?",
   "est_sec": 1.34,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "travel_planning.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Get outside in daylight and stay awake until a normal bedtime. A short nap is okay, but keep it under half an hour.",
   "est_sec": 7.23,
   "gap_before": 0.76,
   "role": "reply",
   "block": "travel_planning.dlg5"
  },
  {
   "speaker": "user",
   "text": "Coffee? Because I'm going to",
   "est_sec": 1.65,
   "gap_before": 0.62,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg5"
  },
  {
   "speaker": "user",
   "text": "need a lot of it.",
   "est_sec": 1.65,
   "gap_before": 1.68,
   "event": "ordinary_request",
   "block": "travel_planning.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Coffee in the morning is fine. Skip it after lunch or you'll be wide awake at two in the morning.",
   "est_sec": 6.3,
   "gap_before": 0.86,
   "role": "reply",
   "block": "travel_planning.dlg5"
  }
 ]
}
