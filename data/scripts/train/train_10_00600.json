 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.3,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.65,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I want to decorate for my girlfriend's birthday but I have no budget and no taste.",
   "est_sec": 5.06,
   "gap_before": 0.44,
   "event": "ordinary_request",
   "block": "birthday_party.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Two problems, both fixable. Does she have a favourite colour?",
   "est_sec": 3.2,
   "gap_before": 0.98,
   "role": "reply",
   "block": "birthday_party.dlg20"
  },
  {
   "speaker": "user",
   "text": "Green. Like, forest green.",
   "est_sec": 1.34,
   "gap_before": 0.97,
   "event": "ordinary_request",
   "block": "birthday_party.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Then collect some branches and leaves from a walk, put them in jars with candles, and add a string of fairy lights if you have one.",
   "est_sec": 8.16,
   "gap_before": 0.54,
   "role": "reply",
   "block": "birthday_party.dlg20"
  },
  {
   "speaker": "user",
   "text": "That actually sounds nice. What else?",
   "est_sec": 1.96,
   "gap_before": 1.26,
   "event": "ordinary_request",
   "block": "birthday_party.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Print a few photos of the two of you and peg them along a piece of string. Costs almost nothing, looks personal.",
   "est_sec": 6.92,
   "gap_before": 0.44,
   "role": "reply",
   "block": "birthday_party.dlg20"
  },
  {
   "speaker": "user",
   "text": "And she won't think I just picked up rubbish from the park?",
   "est_sec": 3.82,
   "gap_before": 1.24,
   "event": "ordinary_request",
   "block": "birthday_party.dlg20"
  },
  {
   "speaker": "moshi",
   "text": "Not if the photos are there. It'll look intentional, almost like a little woodland theme.",
   "est_sec": 4.75,
   "gap_before": 0.8,
   "role": "reply",
   "block": "birthday_party.dlg20"
  }
 ]
}
