 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.75,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.43,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "We're flying with our eighteen month old. Do we need to bring the car seat?",
   "est_sec": 4.75,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "travel_planning.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "You don't have to, but it's often worth it, both for the flight if she has her own seat, and for taxis or rental cars at the other end.",
   "est_sec": 9.09,
   "gap_before": 0.71,
   "role": "reply",
   "block": "travel_planning.dlg14"
  },
  {
   "speaker": "user",
   "text": "She'll be on my lap, we didn't buy her a seat.",
   "est_sec": 3.51,
   "gap_before": 0.42,
   "event": "ordinary_request",
   "block": "travel_planning.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Then you can usually check the car seat for free at the gate. Put it in a padded bag to protect it.",
   "est_sec": 6.92,
   "gap_before": 0.32,
   "role": "reply",
   "block": "travel_planning.dlg14"
  },
  {
   "speaker": "user",
   "text": "Free? That's a relief.",
   "est_sec": 1.34,
   "gap_before": 1.21,
   "event": "ordinary_request",
   "block": "travel_planning.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Most airlines don't charge for car seats or strollers. Check yours to be sure.",
   "est_sec": 4.44,
   "gap_before": 1.83,
   "role": "reply",
   "block": "travel_planning.dlg14"
  },
  {
   "speaker": "user",
   "text": "Any tips for keeping her",
   "est_sec": 1.65,
   "gap_before": 0.32,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg14"
  },
  {
   "speaker": "user",
   "text": "you know, not screaming the whole time?",
   "est_sec": 2.27,
   "gap_before": 2.58,
   "event": "ordinary_request",
   "block": "travel_planning.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "Feed her or give her a dummy during takeoff and landing to help her ears. Pack new little toys she hasn't seen yet.",
   "est_sec": 7.23,
   "gap_before": 0.99,
   "role": "reply",
   "block": "travel_planning.dlg14"
  },
  {
   "speaker": "user",
   "text": "New toys. Smart.",
   "est_sec": 1.03,
   "gap_before": 0.89,
   "event": "ordinary_request",
   "block": "travel_planning.dlg14"
  },
  {
   "speaker": "moshi",
   "text": "And snacks, lots of snacks.",
   "est_sec": 1.65,
   "gap_before": 0.99,
   "role": "reply",
   "block": "travel_planning.dlg14"
  }
 ]
}
