 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.54,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.93,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "I want to learn to sew. Which sewing machine should a total beginner buy?",
   "est_sec": 4.44,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "shopping.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "A simple mechanical machine is perfect to start. You want a straight stitch, a zigzag, and an easy buttonhole, not two hundred fancy stitches.",
   "est_sec": 7.54,
   "gap_before": 0.33,
   "role": "reply",
   "block": "shopping.dlg30"
  },
  {
   "speaker": "user",
   "text": "The computerised ones look so cool though.",
   "est_sec": 2.27,
   "gap_before": 2.53,
   "event": "ordinary_request",
   "block": "shopping.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "They are, but they cost more and can be fiddly to repair. Many people sew for years on a basic one.",
   "est_sec": 6.61,
   "gap_before": 1.49,
   "role": "reply",
   "block": "shopping.dlg30"
  },
  {
   "speaker": "user",
   "text": "What about secondhand?",
   "est_sec": 1.03,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "shopping.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Great option. Older metal machines are often tanks. Just make sure it comes with the foot pedal and it sews smoothly when you test it.",
   "est_sec": 7.85,
   "gap_before": 1.75,
   "role": "reply",
   "block": "shopping.dlg30"
  },
  {
   "speaker": "user",
   "text": "I have no idea",
   "est_sec": 1.34,
   "gap_before": 1.18,
   "event": "distractor",
   "kind": "pause",
   "block": "shopping.dlg30"
  },
  {
   "speaker": "user",
   "text": "how to test it, though.",
   "est_sec": 1.65,
   "gap_before": 2.66,
   "event": "ordinary_request",
   "block": "shopping.dlg30"
  },
  {
   "speaker": "moshi",
   "text": "Bring a scrap of cotton and sew a few lines. It should run quietly, the stitches should look even on both sides, and the thread shouldn't keep snapping.",
   "est_sec": 8.78,
   "gap_before": 0.54,
   "role": "reply",
   "block": "shopping.dlg30"
  }
 ]
}
