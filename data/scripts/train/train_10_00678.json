 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.37,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "I'm a student and I have like forty dollars until the end of the month. Help.",
   "est_sec": 5.06,
   "gap_before": 0.3,
   "event": "ordinary_request",
   "block": "personal_finance.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Okay, we can work with that. How many days until you get money again?",
   "est_sec": 4.44,
   "gap_before": 0.65,
   "role": "reply",
   "block": "personal_finance.dlg4"
  },
  {
   "speaker": "user",
   "text": "Twelve days.",
   "est_sec": 0.72,
   "gap_before": 1.15,
   "event": "ordinary_request",
   "block": "personal_finance.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "That's a bit over three dollars a day. Focus on cheap staples like rice, beans, eggs, oats and bananas.",
   "est_sec": 5.99,
   "gap_before": 0.34,
   "role": "reply",
   "block": "personal_finance.dlg4"
  },
  {
   "speaker": "user",
   "text": "I was going to go out with friends on Friday",
   "est_sec": 3.2,
   "gap_before": 1.21,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg4"
  },
  {
   "speaker": "user",
   "text": "but maybe I shouldn't.",
   "est_sec": 1.34,
   "gap_before": 2.6,
   "event": "ordinary_request",
   "block": "personal_finance.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "You could suggest something free instead, like a movie night at someone's place where everyone brings a snack.",
   "est_sec": 5.68,
   "gap_before": 0.92,
   "role": "reply",
   "block": "personal_finance.dlg4"
  },
  {
   "speaker": "user",
   "text": "That could work. Does my campus have anything that helps?",
   "est_sec": 3.2,
   "gap_before": 1.22,
   "event": "ordinary_request",
   "block": "personal_finance.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Many campuses have a food pantry for students, no questions asked. It's worth checking your student services page.",
   "est_sec": 5.68,
   "gap_before": 1.48,
   "role": "reply",
   "block": "personal_finance.dlg4"
  }
 ]
}
