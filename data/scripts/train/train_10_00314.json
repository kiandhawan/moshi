 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.7,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.87,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "I'm hosting thirty adults on Saturday evening. How much drink do I need?",
   "est_sec": 4.13,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "birthday_party.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "A rough guide is two drinks per person in the first hour and one per hour after that. How long is the party?",
   "est_sec": 7.23,
   "gap_before": 1.07,
   "role": "reply",
   "block": "birthday_party.dlg16"
  },
  {
   "speaker": "user",
   "text": "Seven till midnight. Ish.",
   "est_sec": 1.34,
   "gap_before": 0.51,
   "event": "ordinary_request",
   "block": "birthday_party.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "So about six to seven drinks each, call it two hundred in total. Split it between wine, beer, and soft drinks based on your crowd.",
   "est_sec": 7.85,
   "gap_before": 1.1,
   "role": "reply",
   "block": "birthday_party.dlg16"
  },
  {
   "speaker": "user",
   "text": "That sounds like a lot. Most of my friends",
   "est_sec": 2.89,
   "gap_before": 0.58,
   "event": "distractor",
   "kind": "pause",
   "block": "birthday_party.dlg16"
  },
  {
   "speaker": "user",
   "text": "don't drink that much anymore.",
   "est_sec": 1.65,
   "gap_before": 2.95,
   "event": "ordinary_request",
   "block": "birthday_party.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Then scale down and lean on soft drinks and sparkling water. Plenty of ice is the thing people always forget.",
   "est_sec": 6.3,
   "gap_before": 1.82,
   "role": "reply",
   "block": "birthday_party.dlg16"
  },
  {
   "speaker": "user",
   "text": "Oh, ice. Good shout.",
   "est_sec": 1.34,
   "gap_before": 1.16,
   "event": "ordinary_request",
   "block": "birthday_party.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Get more than you think, at least a big bag per ten people. It disappears fast.",
   "est_sec": 5.06,
   "gap_before": 1.19,
   "role": "reply",
   "block": "birthday_party.dlg16"
  }
 ]
}
