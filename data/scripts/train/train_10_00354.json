 "est_speech_sec": 37.58,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.31,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.35,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "I sell jam at an outdoor market on Saturdays. Rain's forecast. Should I still go?",
   "est_sec": 4.75,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "weather_plans.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "If it's light showers, people still come, especially regulars. Heavy rain all day is another story.",
   "est_sec": 5.06,
   "gap_before": 0.8,
   "role": "reply",
   "block": "weather_plans.dlg21"
  },
  {
   "speaker": "user",
   "text": "My gazebo leaks at the corners.",
   "est_sec": 1.96,
   "gap_before": 1.31,
   "event": "ordinary_request",
   "block": "weather_plans.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "A cheap tarp over the top or a bit of seam sealer could save you. Keep your stock in plastic boxes under the table.",
   "est_sec": 7.54,
   "gap_before": 0.58,
   "role": "reply",
   "block": "weather_plans.dlg21"
  },
  {
   "speaker": "user",
   "text": "Do people buy jam in the rain?",
   "est_sec": 2.27,
   "gap_before": 0.75,
   "event": "ordinary_request",
   "block": "weather_plans.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Comfort food sells well on grim days. A little sign saying something like rainy day treats can help.",
   "est_sec": 5.68,
   "gap_before": 0.61,
   "role": "reply",
   "block": "weather_plans.dlg21"
  },
  {
   "speaker": "user",
   "text": "Ha, I like that.",
   "est_sec": 1.34,
   "gap_before": 1.0,
   "event": "ordinary_request",
   "block": "weather_plans.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "And bring a towel for your jars and a warm hat for you. Standing still in the rain gets cold fast.",
   "est_sec": 6.61,
   "gap_before": 1.08,
   "role": "reply",
   "block": "weather_plans.dlg21"
  }
 ]
}
