 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.67,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.33,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "I've been studying ten hours a day for a month and I'm starting to feel numb.",
   "est_sec": 5.06,
   "gap_before": 0.27,
   "event": "ordinary_request",
   "block": "studying.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "That sounds like burnout creeping in. Ten hours every day is a lot for anyone.",
   "est_sec": 4.75,
   "gap_before": 0.59,
   "role": "reply",
   "block": "studying.dlg19"
  },
  {
   "speaker": "user",
   "text": "But my exams are so close. I can't stop now.",
   "est_sec": 3.2,
   "gap_before": 1.03,
   "event": "ordinary_request",
   "block": "studying.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "You don't have to stop. But cutting back to six focused hours with real breaks will probably get you more than ten tired ones.",
   "est_sec": 7.54,
   "gap_before": 1.06,
   "role": "reply",
   "block": "studying.dlg19"
  },
  {
   "speaker": "user",
   "text": "What counts as a real break?",
   "est_sec": 1.96,
   "gap_before": 0.75,
   "event": "ordinary_request",
   "block": "studying.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Away from the desk and away from screens. A walk, a meal with someone, a shower. Anything that lets your brain switch off.",
   "est_sec": 7.23,
   "gap_before": 1.09,
   "role": "reply",
   "block": "studying.dlg19"
  },
  {
   "speaker": "user",
   "text": "And a day off?",
   "est_sec": 1.34,
   "gap_before": 1.48,
   "event": "distractor",
   "kind": "pause",
   "block": "studying.dlg19"
  },
  {
   "speaker": "user",
   "text": "That feels impossible.",
   "est_sec": 1.03,
   "gap_before": 1.97,
   "event": "ordinary_request",
   "block": "studying.dlg19"
  },
  {
   "speaker": "moshi",
   "text": "Even half a day a week helps. Rest is part of the plan, not a break from it.",
   "est_sec": 5.68,
   "gap_before": 1.49,
   "role": "reply",
   "block": "studying.dlg19"
  }
 ]
}
