 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.73,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.74,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "Do I really need eight hours of sleep? I feel fine on six.",
   "est_sec": 4.13,
   "gap_before": 0.21,
   "event": "ordinary_request",
   "block": "sleep.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Most adults need about seven to nine, but there's some variation. A few people genuinely do well on less.",
   "est_sec": 5.99,
   "gap_before": 0.44,
   "role": "reply",
   "block": "sleep.dlg31"
  },
  {
   "speaker": "user",
   "text": "How would I know?",
   "est_sec": 1.34,
   "gap_before": 0.85,
   "event": "ordinary_request",
   "block": "sleep.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Do you need an alarm to wake up? Do you crash in the afternoon, or doze off in meetings?",
   "est_sec": 5.99,
   "gap_before": 0.65,
   "role": "reply",
   "block": "sleep.dlg31"
  },
  {
   "speaker": "user",
   "text": "Okay, all three.",
   "est_sec": 1.03,
   "gap_before": 1.45,
   "event": "distractor",
   "kind": "pause",
   "block": "sleep.dlg31"
  },
  {
   "speaker": "user",
   "text": "Yes.",
   "est_sec": 0.41,
   "gap_before": 1.9,
   "event": "ordinary_request",
   "block": "sleep.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Then you might be running on a sleep debt you've got used to. Try seven hours for two weeks and see how you feel.",
   "est_sec": 7.54,
   "gap_before": 0.47,
   "role": "reply",
   "block": "sleep.dlg31"
  },
  {
   "speaker": "user",
   "text": "Seven. That's a whole extra hour of my evening gone.",
   "est_sec": 3.2,
   "gap_before": 2.21,
   "event": "ordinary_request",
   "block": "sleep.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Maybe, but you might get more done in the hours you're awake.",
   "est_sec": 3.82,
   "gap_before": 0.43,
   "role": "reply",
   "block": "sleep.dlg31"
  }
 ]
}
