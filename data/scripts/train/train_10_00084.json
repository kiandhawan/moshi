 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.76,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Pretty good, thanks for asking.",
   "est_sec": 1.65,
   "gap_before": 0.64,
   "event": "greeting_answer",
   "phrasing": "greet_ans_02"
  },
  {
   "speaker": "user",
   "text": "I'm doing a ten hour overnight coach next week. I need survival tips.",
   "est_sec": 4.13,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "public_transport.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Respect. A neck pillow, an eye mask and earplugs are the holy trinity.",
   "est_sec": 4.13,
   "gap_before": 0.67,
   "role": "reply",
   "block": "public_transport.dlg31"
  },
  {
   "speaker": "user",
   "text": "Where should I sit?",
   "est_sec": 1.34,
   "gap_before": 0.96,
   "event": "ordinary_request",
   "block": "public_transport.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Somewhere in the middle, away from the toilet and not right over the wheels. A window seat lets you lean and control the curtain.",
   "est_sec": 7.54,
   "gap_before": 1.04,
   "role": "reply",
   "block": "public_transport.dlg31"
  },
  {
   "speaker": "user",
   "text": "What about",
   "est_sec": 0.72,
   "gap_before": 0.44,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg31"
  },
  {
   "speaker": "user",
   "text": "food and stuff?",
   "est_sec": 1.03,
   "gap_before": 2.35,
   "event": "ordinary_request",
   "block": "public_transport.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Bring snacks and water, but nothing too salty. And wear layers, coaches swing from boiling to freezing.",
   "est_sec": 5.37,
   "gap_before": 0.92,
   "role": "reply",
   "block": "public_transport.dlg31"
  },
  {
   "speaker": "user",
   "text": "Anything to help actually sleep?",
   "est_sec": 1.65,
   "gap_before": 1.76,
   "event": "ordinary_request",
   "block": "public_transport.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Download a long, boring podcast. And put your shoes somewhere you'll find them in the dark.",
   "est_sec": 5.06,
   "gap_before": 0.74,
   "role": "reply",
   "block": "public_transport.dlg31"
  },
  {
   "speaker": "user",
   "text": "Very specific advice.",
   "est_sec": 1.03,
   "gap_before": 1.87,
   "event": "ordinary_request",
   "block": "public_transport.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Learned the hard way, I imagine, by many people.",
   "est_sec": 2.89,
   "gap_before": 0.73,
   "role": "reply",
   "block": "public_transport.dlg31"
  }
 ]
}
