 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.82,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "Summer holidays are ending and my kids have been going to bed at eleven. School starts in a week.",
   "est_sec": 5.99,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "sleep.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "A week is enough if you start now. Bring bedtime earlier by about twenty minutes every night or two.",
   "est_sec": 5.99,
   "gap_before": 1.16,
   "role": "reply",
   "block": "sleep.dlg28"
  },
  {
   "speaker": "user",
   "text": "And mornings? They've been sleeping till ten.",
   "est_sec": 2.27,
   "gap_before": 0.6,
   "event": "ordinary_request",
   "block": "sleep.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Same idea, wake them a bit earlier each day too. Mornings actually matter even more for shifting their body clocks.",
   "est_sec": 6.3,
   "gap_before": 1.85,
   "role": "reply",
   "block": "sleep.dlg28"
  },
  {
   "speaker": "user",
   "text": "They'll",
   "est_sec": 0.41,
   "gap_before": 2.52,
   "event": "distractor",
   "kind": "pause",
   "block": "sleep.dlg28"
  },
  {
   "speaker": "user",
   "text": "grumble, no doubt about it.",
   "est_sec": 1.65,
   "gap_before": 2.41,
   "event": "ordinary_request",
   "block": "sleep.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Probably. Make mornings more appealing, breakfast in the garden or something fun planned, and keep evenings calm with dimmer lights.",
   "est_sec": 6.3,
   "gap_before": 0.35,
   "role": "reply",
   "block": "sleep.dlg28"
  },
  {
   "speaker": "user",
   "text": "Pancakes might work. They'd get up at dawn for pancakes.",
   "est_sec": 3.2,
   "gap_before": 1.05,
   "event": "ordinary_request",
   "block": "sleep.dlg28"
  },
  {
   "speaker": "moshi",
   "text": "Pancakes are a powerful motivator. Use them wisely.",
   "est_sec": 2.58,
   "gap_before": 0.67,
   "role": "reply",
   "block": "sleep.dlg28"
  }
 ]
