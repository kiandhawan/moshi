 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.58,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.92,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "It's dark at five, it's raining, and I haven't worked out in three weeks. I just can't be bothered.",
   "est_sec": 5.99,
   "gap_before": 0.4,
   "event": "ordinary_request",
   "block": "fitness.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Winter slumps hit almost everyone. Be kind to yourself, three weeks is not a disaster.",
   "est_sec": 4.75,
   "gap_before": 0.65,
   "role": "reply",
   "block": "fitness.dlg23"
  },
  {
   "speaker": "user",
   "text": "Feels like one.",
   "est_sec": 1.03,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "fitness.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "I get that. The trick is to make the next workout tiny, like ten minutes, so it's easy to start.",
   "est_sec": 6.3,
   "gap_before": 0.33,
   "role": "reply",
   "block": "fitness.dlg23"
  },
  {
   "speaker": "user",
   "text": "Ten minutes won't do anything.",
   "est_sec": 1.65,
   "gap_before": 0.71,
   "event": "ordinary_request",
   "block": "fitness.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "It does more than zero, and starting is the hard part. Often you'll keep going once you're moving.",
   "est_sec": 5.68,
   "gap_before": 0.55,
   "role": "reply",
   "block": "fitness.dlg23"
  },
  {
   "speaker": "user",
   "text": "Maybe. I could",
   "est_sec": 1.03,
   "gap_before": 0.76,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg23"
  },
  {
   "speaker": "user",
   "text": "do something at home I guess.",
   "est_sec": 1.96,
   "gap_before": 2.85,
   "event": "ordinary_request",
   "block": "fitness.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Good idea. A short video workout in your living room, no rain involved. Put your trainers by the sofa now.",
   "est_sec": 6.3,
   "gap_before": 0.83,
   "role": "reply",
   "block": "fitness.dlg23"
  }
 ]
}
