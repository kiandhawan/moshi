 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.68,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.72,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "When I play online, everything lags. My character teleports around. Is it my internet?",
   "est_sec": 4.44,
   "gap_before": 0.42,
   "event": "ordinary_request",
   "block": "video_games.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Possibly. Are you on wifi or plugged into the router with a cable?",
   "est_sec": 4.13,
   "gap_before": 1.23,
   "role": "reply",
   "block": "video_games.dlg32"
  },
  {
   "speaker": "user",
   "text": "Wifi. The router is in another room.",
   "est_sec": 2.27,
   "gap_before": 0.45,
   "event": "ordinary_request",
   "block": "video_games.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "That's often the culprit. Walls and distance hurt wifi a lot. A cable straight to the console, even a long one, usually fixes most lag.",
   "est_sec": 7.85,
   "gap_before": 0.62,
   "role": "reply",
   "block": "video_games.dlg32"
  },
  {
   "speaker": "user",
   "text": "A long cable across",
   "est_sec": 1.34,
   "gap_before": 0.43,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg32"
  },
  {
   "speaker": "user",
   "text": "the hallway though? My flatmate will hate it.",
   "est_sec": 2.58,
   "gap_before": 2.87,
   "event": "ordinary_request",
   "block": "video_games.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Fair. Powerline adapters send internet through your home's electrical wiring, so you just plug one near the router and one near the console.",
   "est_sec": 7.23,
   "gap_before": 1.63,
   "role": "reply",
   "block": "video_games.dlg32"
  },
  {
   "speaker": "user",
   "text": "Is that reliable?",
   "est_sec": 1.03,
   "gap_before": 2.19,
   "event": "ordinary_request",
   "block": "video_games.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "In most homes it works well, and it's usually more stable than wifi. Also check nobody else is streaming or downloading huge files while you play.",
   "est_sec": 8.16,
   "gap_before": 1.43,
   "role": "reply",
   "block": "video_games.dlg32"
  }
 ]
}
