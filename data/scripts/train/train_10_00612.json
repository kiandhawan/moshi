 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.73,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.96,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "Should I bring cash to Japan or just use my card?",
   "est_sec": 3.51,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "travel_planning.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Bring some cash. Cards are widely accepted in cities now, but smaller restaurants, temples and rural places often still want cash.",
   "est_sec": 6.61,
   "gap_before": 1.0,
   "role": "reply",
   "block": "travel_planning.dlg9"
  },
  {
   "speaker": "user",
   "text": "How much?",
   "est_sec": 0.72,
   "gap_before": 1.25,
   "event": "ordinary_request",
   "block": "travel_planning.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Enough for a couple of days is a good start. Convenience store cash machines usually accept foreign cards, so you can top up.",
   "est_sec": 7.23,
   "gap_before": 0.34,
   "role": "reply",
   "block": "travel_planning.dlg9"
  },
  {
   "speaker": "user",
   "text": "Do I get yen before I go?",
   "est_sec": 2.27,
   "gap_before": 1.5,
   "event": "ordinary_request",
   "block": "travel_planning.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "You can, but rates at home are often worse. Taking some out at the airport when you land is usually fine.",
   "est_sec": 6.61,
   "gap_before": 0.67,
   "role": "reply",
   "block": "travel_planning.dlg9"
  },
  {
   "speaker": "user",
   "text": "Hold on, really?",
   "est_sec": 1.03,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_11",
   "block": "travel_planning.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Hmm, I believe it is. Which part doesn't sound right?",
   "est_sec": 3.2,
   "gap_before": 1.69,
   "role": "reply",
   "block": "travel_planning.dlg9"
  },
  {
   "speaker": "user",
   "text": "And do I tell my bank",
   "est_sec": 1.96,
   "gap_before": 2.67,
   "event": "distractor",
   "kind": "pause",
   "block": "travel_planning.dlg9"
  },
  {
   "speaker": "user",
   "text": "that I'm traveling? People keep saying that.",
   "est_sec": 2.27,
   "gap_before": 1.69,
   "event": "ordinary_request",
   "block": "travel_planning.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "It doesn't hurt. Many banks don't need it anymore, but a quick message in their app can stop your card being blocked.",
   "est_sec": 6.92,
   "gap_before": 1.79,
   "role": "reply",
   "block": "travel_planning.dlg9"
  }
 ]
}
