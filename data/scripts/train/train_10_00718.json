 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.64,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "Is it just me or are films getting longer? Everything's nearly three hours.",
   "est_sec": 4.13,
   "gap_before": 0.42,
   "event": "ordinary_request",
   "block": "movies.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "It's not just you. Big blockbusters especially have been creeping longer over the last couple of decades.",
   "est_sec": 5.37,
   "gap_before": 0.67,
   "role": "reply",
   "block": "movies.dlg21"
  },
  {
   "speaker": "user",
   "text": "Why though?",
   "est_sec": 0.72,
   "gap_before": 0.91,
   "event": "ordinary_request",
   "block": "movies.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Partly streaming, since people are used to long series. And bigger films have so many characters and set pieces to fit in.",
   "est_sec": 6.92,
   "gap_before": 0.3,
   "role": "reply",
   "block": "movies.dlg21"
  },
  {
   "speaker": "user",
   "text": "I just get restless after two hours.",
   "est_sec": 2.27,
   "gap_before": 1.08,
   "event": "ordinary_request",
   "block": "movies.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Lots of people do. Some cinemas abroad still do an intermission for really long ones, which helps.",
   "est_sec": 5.37,
   "gap_before": 0.76,
   "role": "reply",
   "block": "movies.dlg21"
  },
  {
   "speaker": "user",
   "text": "I wish ours did. My",
   "est_sec": 1.65,
   "gap_before": 0.83,
   "event": "distractor",
   "kind": "pause",
   "block": "movies.dlg21"
  },
  {
   "speaker": "user",
   "text": "knees can't take three hours.",
   "est_sec": 1.65,
   "gap_before": 1.57,
   "event": "ordinary_request",
   "block": "movies.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Pick an aisle seat so you can stretch, or wait for streaming so you can pause. Your knees will thank you.",
   "est_sec": 6.61,
   "gap_before": 1.16,
   "role": "reply",
   "block": "movies.dlg21"
  }
 ]
}
