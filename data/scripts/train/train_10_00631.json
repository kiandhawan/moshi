 "est_speech_sec": 39.85,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how's everything with you?",
   "est_sec": 1.65,
   "gap_before": 0.52,
   "role": "greeting",
   "phrasing": "greet_19"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.43,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "How do I hang a heavy mirror without it falling on my head?",
   "est_sec": 4.13,
   "gap_before": 0.58,
   "event": "ordinary_request",
   "block": "home_repair.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "First find out what the wall is made of. Knock on it. Does it sound hollow or solid?",
   "est_sec": 5.68,
   "gap_before": 0.85,
   "role": "reply",
   "block": "home_repair.dlg5"
  },
  {
   "speaker": "user",
   "text": "Hollow, kind of like a drum.",
   "est_sec": 1.96,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "block": "home_repair.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Then it's probably plasterboard. Either screw into a wooden stud behind it, or use heavy duty hollow wall anchors.",
   "est_sec": 5.99,
   "gap_before": 0.89,
   "role": "reply",
   "block": "home_repair.dlg5"
  },
  {
   "speaker": "user",
   "text": "How do I find a stud without a fancy gadget?",
   "est_sec": 3.2,
   "gap_before": 2.97,
   "event": "ordinary_request",
   "block": "home_repair.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Knock along the wall. Where the hollow sound turns dull, there's often a stud. A strong magnet can also find the screws in them.",
   "est_sec": 7.54,
   "gap_before": 0.31,
   "role": "reply",
   "block": "home_repair.dlg5"
  },
  {
   "speaker": "user",
   "text": "The mirror is about",
   "est_sec": 1.34,
   "gap_before": 1.23,
   "event": "distractor",
   "kind": "pause",
   "block": "home_repair.dlg5"
  },
  {
   "speaker": "user",
   "text": "twenty kilos, I think.",
   "est_sec": 1.34,
   "gap_before": 2.47,
   "event": "ordinary_request",
   "block": "home_repair.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "That's heavy. Use two fixings, ideally both in studs, and check the anchors are rated for more than that.",
   "est_sec": 5.99,
   "gap_before": 1.79,
   "role": "reply",
   "block": "home_repair.dlg5"
  }
 ]
}
