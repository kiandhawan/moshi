 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.76,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "Is it better to stretch before or after a run?",
   "est_sec": 3.2,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Before a run, do a dynamic warm-up like leg swings and easy jogging. Save the longer, held stretches for after.",
   "est_sec": 6.3,
   "gap_before": 1.74,
   "role": "reply",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "user",
   "text": "Why not hold stretches before?",
   "est_sec": 1.65,
   "gap_before": 0.5,
   "event": "ordinary_request",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Long static stretches can make your muscles feel a bit weaker right away. Moving warm-ups get them ready instead.",
   "est_sec": 5.99,
   "gap_before": 0.97,
   "role": "reply",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "user",
   "text": "Makes sense. I usually just",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "user",
   "text": "start running and hope for the best.",
   "est_sec": 2.27,
   "gap_before": 2.47,
   "event": "ordinary_request",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "Lots of people do. Even five minutes of brisk walking first makes a real difference.",
   "est_sec": 4.75,
   "gap_before": 0.79,
   "role": "reply",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "user",
   "text": "Okay. And after, how long should I hold each stretch?",
   "est_sec": 3.2,
   "gap_before": 1.15,
   "event": "ordinary_request",
   "block": "fitness.dlg3"
  },
  {
   "speaker": "moshi",
   "text": "About thirty seconds each. Focus on calves, hamstrings and hips, those get tight from running.",
   "est_sec": 4.75,
   "gap_before": 1.67,
   "role": "reply",
   "block": "fitness.dlg3"
  }
 ]
}
