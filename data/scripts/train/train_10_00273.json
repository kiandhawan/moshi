 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.45,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "Weird question, but my hands get really sweaty and I hate shaking hands at interviews.",
   "est_sec": 4.75,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "job_interview.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Not weird at all, it's really common. A few small things help a lot.",
   "est_sec": 4.44,
   "gap_before": 0.79,
   "role": "reply",
   "block": "job_interview.dlg7"
  },
  {
   "speaker": "user",
   "text": "Like what?",
   "est_sec": 0.72,
   "gap_before": 1.77,
   "event": "ordinary_request",
   "block": "job_interview.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "Run your hands under cold water just before you go in, and keep a tissue in your pocket to dab them in reception.",
   "est_sec": 7.23,
   "gap_before": 0.75,
   "role": "reply",
   "block": "job_interview.dlg7"
  },
  {
   "speaker": "user",
   "text": "Hold on, and if they're still damp?",
   "est_sec": 2.27,
   "gap_before": 1.25,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_14",
   "block": "job_interview.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "A firm, quick handshake and a smile. Most people won't notice, and nobody will remember it after the first minute.",
   "est_sec": 6.3,
   "gap_before": 0.46,
   "role": "reply",
   "block": "job_interview.dlg7"
  },
  {
   "speaker": "user",
   "text": "Right. I always think",
   "est_sec": 1.34,
   "gap_before": 1.2,
   "event": "distractor",
   "kind": "pause",
   "block": "job_interview.dlg7"
  },
  {
   "speaker": "user",
   "text": "it's the only thing they'll remember about me.",
   "est_sec": 2.58,
   "gap_before": 2.17,
   "event": "ordinary_request",
   "block": "job_interview.dlg7"
  },
  {
   "speaker": "moshi",
   "text": "They'll remember your answers. The handshake is two seconds of a forty five minute conversation.",
   "est_sec": 4.75,
   "gap_before": 0.66,
   "role": "reply",
   "block": "job_interview.dlg7"
  }
 ]
