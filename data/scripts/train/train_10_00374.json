 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.94,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "When should I plant tulip bulbs?",
   "est_sec": 1.96,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "In autumn, once the soil has cooled down. Late October to November is usually ideal.",
   "est_sec": 4.75,
   "gap_before": 0.7,
   "role": "reply",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "user",
   "text": "Hang on, I missed that.",
   "est_sec": 1.65,
   "gap_before": 1.1,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_04",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "No problem. In autumn, once the soil has cooled down. Late October to November is usually ideal.",
   "est_sec": 5.37,
   "gap_before": 0.65,
   "role": "reply",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "user",
   "text": "How deep do they go?",
   "est_sec": 1.65,
   "gap_before": 1.33,
   "event": "ordinary_request",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "About three times the height of the bulb, so roughly fifteen to twenty centimeters, pointy end up.",
   "est_sec": 5.37,
   "gap_before": 0.47,
   "role": "reply",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "user",
   "text": "And can I put them in pots? I was hoping to",
   "est_sec": 3.51,
   "gap_before": 1.26,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "user",
   "text": "put a few by the front door.",
   "est_sec": 2.27,
   "gap_before": 2.24,
   "event": "ordinary_request",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Yes, tulips look great in pots. Pack them closely together and make sure the pot drains well.",
   "est_sec": 5.37,
   "gap_before": 1.56,
   "role": "reply",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "user",
   "text": "Do they come back every year?",
   "est_sec": 1.96,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "gardening.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Some do, but many fade after the first year. Lots of people just plant fresh ones each autumn.",
   "est_sec": 5.68,
   "gap_before": 0.86,
   "role": "reply",
   "block": "gardening.dlg2"
  }
 ]
}
