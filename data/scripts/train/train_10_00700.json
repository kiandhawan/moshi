 "est_total_sec": 62.05,
 "est_speech_sec": 46.56,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.47,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.62,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "I'm starting a job on an island and I'll commute by ferry. I get seasick in a bathtub.",
   "est_sec": 5.68,
   "gap_before": 0.27,
   "event": "ordinary_request",
   "block": "public_transport.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Ferries can be gentler than you'd think, especially bigger ones. Where you sit makes a huge difference.",
   "est_sec": 5.37,
   "gap_before": 0.34,
   "role": "reply",
   "block": "public_transport.dlg27"
  },
  {
   "speaker": "user",
   "text": "Where's best?",
   "est_sec": 0.72,
   "gap_before": 1.09,
   "event": "ordinary_request",
   "block": "public_transport.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Low down and in the middle of the boat, where it moves least. Looking out at the horizon helps your brain make sense of the motion.",
   "est_sec": 8.16,
   "gap_before": 1.58,
   "role": "reply",
   "block": "public_transport.dlg27"
  },
  {
   "speaker": "user",
   "text": "What about",
   "est_sec": 0.72,
   "gap_before": 2.69,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg27"
  },
  {
   "speaker": "user",
   "text": "pills or something?",
   "est_sec": 1.03,
   "gap_before": 2.58,
   "event": "ordinary_request",
   "block": "public_transport.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Travel sickness tablets help many people, but some make you drowsy. A pharmacist can suggest one that's fine for work.",
   "est_sec": 6.3,
   "gap_before": 0.38,
   "role": "reply",
   "block": "public_transport.dlg27"
  },
  {
   "speaker": "user",
   "text": "And on rough days?",
   "est_sec": 1.34,
   "gap_before": 0.73,
   "event": "ordinary_request",
   "block": "public_transport.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Fresh air on deck can be better than sitting inside. And eat something light before, an empty stomach often makes it worse.",
   "est_sec": 6.92,
   "gap_before": 1.75,
   "role": "reply",
   "block": "public_transport.dlg27"
  },
  {
   "speaker": "user",
   "text": "This is either going to be lovely or a disaster.",
   "est_sec": 3.2,
   "gap_before": 0.7,
   "event": "ordinary_request",
   "block": "public_transport.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Most regular passengers get used to it after a few weeks.",
   "est_sec": 3.51,
   "gap_before": 0.79,
   "role": "reply",
   "block": "public_transport.dlg27"
  }
 ]
}
