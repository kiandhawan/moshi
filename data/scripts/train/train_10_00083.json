 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.33,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.93,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "I want to do something nice for my wife this weekend but I'm on a tight budget.",
   "est_sec": 5.37,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Lots of options. A picnic in a nice spot, cooking her favourite meal, or a sunset walk somewhere scenic are all lovely and cheap.",
   "est_sec": 7.54,
   "gap_before": 0.65,
   "role": "reply",
   "block": "weekend_plans.dlg2"
  },
  {
   "speaker": "user",
   "text": "She loves Italian food. Maybe I could",
   "est_sec": 2.27,
   "gap_before": 0.51,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg2"
  },
  {
   "speaker": "user",
   "text": "make her lasagna.",
   "est_sec": 1.03,
   "gap_before": 2.5,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "That's a great idea. Make it in the afternoon, then it's ready when she gets home.",
   "est_sec": 5.06,
   "gap_before": 0.79,
   "role": "reply",
   "block": "weekend_plans.dlg2"
  },
  {
   "speaker": "user",
   "text": "I've never made lasagna before though.",
   "est_sec": 1.96,
   "gap_before": 1.0,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "It's more forgiving than it looks. Use a simple meat sauce, layer it with pasta sheets and a white sauce, and bake for about forty minutes.",
   "est_sec": 8.16,
   "gap_before": 1.94,
   "role": "reply",
   "block": "weekend_plans.dlg2"
  },
  {
   "speaker": "user",
   "text": "Okay. And maybe some candles.",
   "est_sec": 1.65,
   "gap_before": 1.11,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Candles and a nice playlist, and you've got a proper date night at home.",
   "est_sec": 4.44,
   "gap_before": 0.83,
   "role": "reply",
   "block": "weekend_plans.dlg2"
  }
 ]
