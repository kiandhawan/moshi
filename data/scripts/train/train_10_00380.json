  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.36,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.83,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "My grandmother turns ninety in May and the whole family wants to do something.",
   "est_sec": 4.44,
   "gap_before": 0.36,
   "event": "ordinary_request",
   "block": "birthday_party.ctx4"
  },
  {
   "speaker": "moshi",
   "text": "Ninety is huge. Would she enjoy a big lunch with everyone, or a smaller afternoon tea with just her closest people?",
   "est_sec": 6.61,
   "gap_before": 0.54,
   "role": "reply",
   "block": "birthday_party.ctx4"
  },
  {
   "speaker": "user",
   "text": "Let me think about it for twenty seconds and then ask me again.",
   "est_sec": 4.13,
   "gap_before": 1.1,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 20,
   "phrasing": "think_instr_02"
  },
  {
   "speaker": "user",
   "text": "Okay, so, the thing is",
   "est_sec": 1.65,
   "anchor": {
    "turn": 4,
    "offset": 4.78
   },
   "event": "distractor",
   "kind": "self_talk",
   "phrasing": "self_25"
  },
  {
   "speaker": "user",
   "text": "No, hang on, that's silly.",
   "est_sec": 1.65,
   "anchor": {
    "turn": 4,
    "offset": 14.28
   },
   "event": "distractor",
   "kind": "self_talk",
   "phrasing": "self_14"
  },
  {
   "speaker": "moshi",
   "text": "Any clearer now? A full family lunch, or something smaller with tea and cake?",
   "est_sec": 4.44,
   "role": "resume",
   "block": "birthday_party.ctx4",
   "anchor": {
    "turn": 4,
    "offset": 20.44
   }
  },
  {
   "speaker": "user",
   "text": "Afternoon tea. Crowds wear her out these days.",
