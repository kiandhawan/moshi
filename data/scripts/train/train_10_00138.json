 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.41,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.46,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "So the council finally gave me an allotment plot. It's waist high in brambles.",
   "est_sec": 4.44,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "gardening.ctx4"
  },
  {
   "speaker": "moshi",
   "text": "Congratulations, that's the hard part done. Do you want to clear the whole thing in one go, or cover half with sheeting and grow on the other half this year?",
   "est_sec": 9.4,
   "gap_before": 0.72,
   "role": "reply",
   "block": "gardening.ctx4"
  },
  {
   "speaker": "user",
   "text": "I'm not sure. Wait forty-five seconds and ask me again.",
   "est_sec": 3.2,
   "gap_before": 0.34,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 45,
   "phrasing": "think_instr_08"
  },
  {
   "speaker": "moshi",
   "text": "No worries.",
   "est_sec": 0.72,
   "gap_before": 0.29,
   "role": "ack",
   "phrasing": "ack_14"
  },
  {
   "speaker": "moshi",
   "text": "Right, the brambles. All at once, or half under sheeting for now?",
   "est_sec": 3.82,
   "role": "resume",
   "block": "gardening.ctx4",
   "anchor": {
    "turn": 4,
    "offset": 45.58
   }
  },
  {
   "speaker": "user",
   "text": "Half and half. I'd like at least some potatoes this summer.",
   "est_sec": 3.51,
   "gap_before": 0.42,
   "event": "ordinary_request",
   "block": "gardening.ctx4"
  },
  {
   "speaker": "moshi",
   "text": "Sensible. Black sheeting over the far half will weaken the roots while you get growing on the cleared side.",
   "est_sec": 5.99,
   "gap_before": 0.57,
   "role": "followup",
   "block": "gardening.ctx4"
  }
