  },
  {
   "speaker": "user",
   "text": "I need a new vacuum and I'm comparing a few kinds.",
   "est_sec": 3.51,
   "gap_before": 0.32,
   "block": "cleaning.opt2"
  },
  {
   "speaker": "user",
   "text": "Let me walk you through all the options, then you can tell me what you think.",
