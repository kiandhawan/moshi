  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.44,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Good, thanks. Just got home.",
   "est_sec": 1.65,
   "gap_before": 0.87,
   "event": "greeting_answer",
   "phrasing": "greet_ans_19"
  },
  {
   "speaker": "user",
   "text": "I want to teach my grandson chess. He's seven and very wriggly.",
   "est_sec": 3.82,
   "gap_before": 0.55,
   "event": "ordinary_request",
   "block": "board_games.ctx9"
  },
  {
   "speaker": "moshi",
   "text": "Lovely. Would you start with the full game straight away, or begin with just the pawns and add one piece at a time?",
   "est_sec": 7.23,
   "gap_before": 0.3,
   "role": "reply",
   "block": "board_games.ctx9"
  },
  {
   "speaker": "user",
   "text": "Sorry, can you wait? My friend is talking to me. Keep quiet until I come back.",
   "est_sec": 5.06,
   "gap_before": 0.48,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_17"
  },
  {
   "speaker": "moshi",
   "text": "Okay.",
   "est_sec": 0.41,
   "gap_before": 0.38,
   "role": "ack",
   "phrasing": "ack_02"
  },
  {
   "speaker": "user",
   "text": "Daniel, did you get the bill from the restaurant on Saturday?",
   "est_sec": 3.51,
   "gap_before": 1.08,
   "event": "distractor",
   "kind": "friend_question",
   "block": "personal_finance.side4"
  },
  {
   "speaker": "friend",
   "text": "Yeah, I paid it all on my card. You owe me for yours.",
   "est_sec": 4.13,
   "gap_before": 1.43,
   "block": "personal_finance.side4"
  },
  {
   "speaker": "user",
   "text": "How much was mine?",
   "est_sec": 1.34,
   "gap_before": 1.05,
   "event": "distractor",
   "kind": "friend_question",
   "block": "personal_finance.side4"
  },
  {
   "speaker": "friend",
   "text": "You had the steak and two glasses of wine, so a bit more than half.",
   "est_sec": 4.75,
   "gap_before": 0.6,
   "block": "personal_finance.side4"
  },
  {
   "speaker": "user",
   "text": "Ouch. Can I send it on Friday? Payday.",
   "est_sec": 2.58,
   "gap_before": 0.4,
   "block": "personal_finance.side4"
  },
  {
   "speaker": "friend",
   "text": "Friday's fine. Just don't forget like last time.",
   "est_sec": 2.58,
   "gap_before": 2.99,
   "block": "personal_finance.side4"
  },
  {
   "speaker": "user",
   "text": "Okay, I'm free again.",
   "est_sec": 1.34,
   "gap_before": 1.9,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_20"
  },
  {
