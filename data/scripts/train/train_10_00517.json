 "est_total_sec": 50.3,
 "est_speech_sec": 40.06,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.76,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.7,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "A stone hit my windscreen on the motorway. There's a tiny chip, like a little star.",
   "est_sec": 5.06,
   "gap_before": 0.39,
   "event": "ordinary_request",
   "block": "cars.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Ah, annoying. Is it in the driver's line of sight, and is it smaller than a coin?",
   "est_sec": 5.37,
   "gap_before": 0.79,
   "role": "reply",
   "block": "cars.dlg11"
  },
  {
   "speaker": "user",
   "text": "It's on the passenger side, and it's really small.",
   "est_sec": 2.89,
   "gap_before": 1.21,
   "event": "ordinary_request",
   "block": "cars.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Good news, then. Small chips like that can usually be repaired with resin instead of replacing the whole screen.",
   "est_sec": 5.99,
   "gap_before": 1.13,
   "role": "reply",
   "block": "cars.dlg11"
  },
  {
   "speaker": "user",
   "text": "Can I just ignore it?",
   "est_sec": 1.65,
   "gap_before": 1.21,
   "event": "ordinary_request",
   "block": "cars.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "I wouldn't. Temperature changes and bumps can make a chip crack across the glass, and then you'd need a new windscreen.",
   "est_sec": 6.61,
   "gap_before": 1.19,
   "role": "reply",
   "block": "cars.dlg11"
  },
  {
   "speaker": "user",
   "text": "Is the repair expensive?",
   "est_sec": 1.34,
   "gap_before": 1.01,
   "event": "ordinary_request",
   "block": "cars.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Often it's covered by your insurance without affecting your no claims. Worth a quick call. In the meantime, a bit of clear tape keeps dirt out of it.",
   "est_sec": 8.78,
   "gap_before": 0.35,
   "role": "reply",
   "block": "cars.dlg11"
  }
 ]
}
