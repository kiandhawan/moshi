 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello! How's everything today?",
   "est_sec": 1.34,
   "gap_before": 0.65,
   "role": "greeting",
   "phrasing": "greet_28"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.67,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "How do I pack plates so they don't break?",
   "est_sec": 2.89,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "moving_house.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Wrap each one in paper and stand them on their edge in the box, like records. They're much stronger that way than stacked flat.",
   "est_sec": 7.54,
   "gap_before": 1.03,
   "role": "reply",
   "block": "moving_house.dlg2"
  },
  {
   "speaker": "user",
   "text": "On their edge? Really?",
   "est_sec": 1.34,
   "gap_before": 1.81,
   "event": "ordinary_request",
   "block": "moving_house.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Really. Put some crumpled paper at the bottom of the box too, and fill any gaps so nothing moves.",
   "est_sec": 5.99,
   "gap_before": 0.65,
   "role": "reply",
   "block": "moving_house.dlg2"
  },
  {
   "speaker": "user",
   "text": "Wait, are you sure about that?",
   "est_sec": 1.96,
   "gap_before": 1.26,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_08",
   "block": "moving_house.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Good to question it. I still think it's right, though you know your situation best.",
   "est_sec": 4.75,
   "gap_before": 0.96,
   "role": "reply",
   "block": "moving_house.dlg2"
  },
  {
   "speaker": "user",
   "text": "What about glasses? We have",
   "est_sec": 1.65,
   "gap_before": 0.65,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg2"
  },
  {
   "speaker": "user",
   "text": "a lot of wine glasses.",
   "est_sec": 1.65,
   "gap_before": 2.78,
   "event": "ordinary_request",
   "block": "moving_house.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Stuff a bit of paper inside each glass, then wrap the outside. Liquor stores often give away boxes with dividers, which are perfect.",
   "est_sec": 7.23,
   "gap_before": 0.43,
   "role": "reply",
   "block": "moving_house.dlg2"
  },
  {
   "speaker": "user",
   "text": "Oh nice, I'll ask at the shop down the road.",
   "est_sec": 3.2,
   "gap_before": 1.41,
   "event": "ordinary_request",
   "block": "moving_house.dlg2"
  },
  {
   "speaker": "moshi",
   "text": "Good idea. And mark those boxes fragile on every side, not just the top.",
   "est_sec": 4.44,
   "gap_before": 1.73,
   "role": "reply",
   "block": "moving_house.dlg2"
  }
 ]
}
