 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.31,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "We've lost the rulebook for a game we got second hand. Are we stuck?",
   "est_sec": 4.44,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "board_games.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Probably not. Most publishers put the rules as free downloads on their website. What's the game called?",
   "est_sec": 5.37,
   "gap_before": 0.78,
   "role": "reply",
   "block": "board_games.dlg8"
  },
  {
   "speaker": "user",
   "text": "It's about building castles, it's in German on the box.",
   "est_sec": 3.2,
   "gap_before": 2.81,
   "event": "ordinary_request",
   "block": "board_games.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "If the title is on the box, try searching it with the words rules in English. Fan sites often have translations too.",
   "est_sec": 6.92,
   "gap_before": 0.63,
   "role": "reply",
   "block": "board_games.dlg8"
  },
  {
   "speaker": "user",
   "text": "Hold on, oh nice. And if it's",
   "est_sec": 2.27,
   "gap_before": 3.23,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg8"
  },
  {
   "speaker": "user",
   "text": "some really obscure one?",
   "est_sec": 1.34,
   "gap_before": 1.77,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_14",
   "block": "board_games.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Then board game forums are great. Post a photo of the box and the pieces, someone usually knows it.",
   "est_sec": 5.99,
   "gap_before": 1.06,
   "role": "reply",
   "block": "board_games.dlg8"
  },
  {
   "speaker": "user",
   "text": "People are that helpful?",
   "est_sec": 1.34,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "board_games.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "In this hobby, very. Board gamers love explaining rules, almost more than playing.",
   "est_sec": 4.13,
   "gap_before": 0.58,
   "role": "reply",
   "block": "board_games.dlg8"
  }
 ]
}
