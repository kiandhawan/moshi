 "est_total_sec": 52.03,
 "est_speech_sec": 40.47,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.42,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Really good, actually.",
   "est_sec": 1.03,
   "gap_before": 0.31,
   "event": "greeting_answer",
   "phrasing": "greet_ans_13"
  },
  {
   "speaker": "user",
   "text": "Our new house has a steep sloping garden. Mowing it is honestly dangerous.",
   "est_sec": 4.13,
   "gap_before": 0.23,
   "event": "ordinary_request",
   "block": "gardening.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Slopes are tough. Many people terrace them, or swap the grass for plants that hold the soil and never need mowing.",
   "est_sec": 6.61,
   "gap_before": 0.52,
   "role": "reply",
   "block": "gardening.dlg27"
  },
  {
   "speaker": "user",
   "text": "Terracing sounds expensive.",
   "est_sec": 1.03,
   "gap_before": 0.65,
   "event": "ordinary_request",
   "block": "gardening.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "It can be if you hire a team. A cheaper route is ground cover plants and shrubs, with a simple path of steps across it.",
   "est_sec": 7.85,
   "gap_before": 1.15,
   "role": "reply",
   "block": "gardening.dlg27"
  },
  {
   "speaker": "user",
   "text": "What kind of ground cover?",
   "est_sec": 1.65,
   "gap_before": 1.05,
   "event": "ordinary_request",
   "block": "gardening.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "For sun, creeping thyme, rock roses and low junipers. For shade, periwinkle and some hardy geraniums.",
   "est_sec": 5.06,
   "gap_before": 0.53,
   "role": "reply",
   "block": "gardening.dlg27"
  },
  {
   "speaker": "user",
   "text": "And to stop the soil",
   "est_sec": 1.65,
   "gap_before": 1.43,
   "event": "distractor",
   "kind": "pause",
   "block": "gardening.dlg27"
  },
  {
   "speaker": "user",
   "text": "sliding down when it rains?",
   "est_sec": 1.65,
   "gap_before": 2.58,
   "event": "ordinary_request",
   "block": "gardening.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Mulch with bark chips and use a biodegradable jute matting while the plants get going. The roots will hold it after a year or two.",
   "est_sec": 7.85,
   "gap_before": 1.19,
   "role": "reply",
   "block": "gardening.dlg27"
  }
 ]
}
