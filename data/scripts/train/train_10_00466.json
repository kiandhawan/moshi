 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How's everything going?",
   "est_sec": 1.34,
   "gap_before": 0.65,
   "role": "greeting",
   "phrasing": "greet_07"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.93,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "My friends invited me on a hike but the forecast says rain in the afternoon.",
   "est_sec": 4.75,
   "gap_before": 0.22,
   "event": "ordinary_request",
   "block": "hiking.ctx3"
  },
  {
   "speaker": "moshi",
   "text": "Tricky. You could start very early and be down before the rain, or move the hike to another day. What do you think?",
   "est_sec": 7.23,
   "gap_before": 0.33,
   "role": "reply",
   "block": "hiking.ctx3"
  },
  {
   "speaker": "user",
   "text": "Hold on, my friend and I need to figure something out. Wait until I'm back, okay?",
   "est_sec": 5.06,
   "gap_before": 1.03,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_26"
  },
  {
   "speaker": "moshi",
   "text": "Of course.",
   "est_sec": 0.72,
   "gap_before": 0.21,
   "role": "ack",
   "phrasing": "ack_06"
  },
  {
   "speaker": "user",
   "text": "Did you top up your travel card? Mine's almost empty.",
   "est_sec": 3.2,
   "gap_before": 1.32,
   "block": "public_transport.side2"
  },
  {
   "speaker": "friend",
   "text": "I did it yesterday at the machine by the entrance.",
   "est_sec": 3.2,
   "gap_before": 0.94,
   "block": "public_transport.side2"
  },
  {
   "speaker": "user",
   "text": "Does it take cards or only cash?",
   "est_sec": 2.27,
   "gap_before": 2.45,
   "event": "distractor",
   "kind": "friend_question",
   "block": "public_transport.side2"
  },
  {
   "speaker": "friend",
   "text": "Both. But the one on the left is always broken.",
   "est_sec": 3.2,
   "gap_before": 0.92,
   "block": "public_transport.side2"
  },
  {
   "speaker": "user",
   "text": "Good to know. Wait for me here, I'll be quick.",
   "est_sec": 3.2,
   "gap_before": 1.04,
   "block": "public_transport.side2"
  },
  {
   "speaker": "friend",
   "text": "Hurry, the train is in four minutes.",
   "est_sec": 2.27,
   "gap_before": 0.71,
   "block": "public_transport.side2"
  },
  {
   "speaker": "user",
   "text": "Omar, when does your train leave?",
   "est_sec": 1.96,
   "gap_before": 0.32,
   "event": "distractor",
   "kind": "friend_question",
   "phrasing": "dq_20"
  },
  {
   "speaker": "friend",
   "text": "At a quarter past nine.",
   "est_sec": 1.65,
   "gap_before": 1.08,
   "phrasing": "dq_20"
  },
  {
   "speaker": "user",
   "text": "Okay, that's sorted. I'm back.",
   "est_sec": 1.65,
   "gap_before": 1.55,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_08"
  },
  {
   "speaker": "moshi",
   "text": "Sure thing. Any decision on the rainy hike?",
   "est_sec": 2.58,
   "gap_before": 0.81,
   "role": "resume",
   "block": "hiking.ctx3"
  },
  {
   "speaker": "user",
   "text": "Let's go early. Everyone's already free that day.",
   "est_sec": 2.58,
   "gap_before": 1.47,
   "event": "ordinary_request",
   "block": "hiking.ctx3"
  },
  {
   "speaker": "moshi",
   "text": "Then aim to be on the trail by seven, and still pack a rain jacket just in case.",
   "est_sec": 5.68,
   "gap_before": 0.88,
   "role": "followup",
   "block": "hiking.ctx3"
  }
 ]
