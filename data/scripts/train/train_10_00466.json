   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "My wife's just had knee surgery and she's itching to get back on the trails.",
   "est_sec": 4.75,
   "gap_before": 0.38,
   "event": "ordinary_request",
   "block": "hiking.ctx4"
  },
  {
   "speaker": "moshi",
   "text": "Good for her. The old railway path is completely flat but a bit dull, while the marsh boardwalk is prettier with a few steps. Which would she rather start with?",
   "est_sec": 9.4,
   "gap_before": 0.68,
   "role": "reply",
   "block": "hiking.ctx4"
  },
  {
   "speaker": "user",
   "text": "Wait ten seconds, then ask me that again.",
   "est_sec": 2.58,
   "gap_before": 1.4,
   "event": "instruction",
   "kind": "think_time",
   "wait_sec": 10,
   "phrasing": "think_instr_14"
  },
  {
   "speaker": "moshi",
   "text": "Okay, sure.",
   "est_sec": 0.72,
   "gap_before": 0.25,
   "role": "ack",
   "phrasing": "ack_16"
  },
  {
   "speaker": "user",
   "text": "Mm, I don't know.",
   "est_sec": 1.34,
   "anchor": {
    "turn": 4,
    "offset": 5.77
   },
   "event": "distractor",
   "kind": "self_talk",
   "phrasing": "self_10"
  },
  {
   "speaker": "moshi",
   "text": "Which one feels right for her knee, the railway path or the marsh?",
   "est_sec": 4.13,
   "role": "resume",
   "block": "hiking.ctx4",
   "anchor": {
    "turn": 4,
    "offset": 10.18
   }
  },
  {
   "speaker": "user",
   "text": "The railway path. Boring is fine for now, she'll just be happy to be out.",
