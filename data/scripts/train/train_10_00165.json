 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how's your day been so far?",
   "est_sec": 2.27,
   "gap_before": 0.6,
   "role": "greeting",
   "phrasing": "greet_10"
  },
  {
   "speaker": "user",
   "text": "I'm good, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.4,
   "event": "greeting_answer",
   "phrasing": "greet_ans_01"
  },
  {
   "speaker": "user",
   "text": "Can you recommend a good board game for just two players?",
   "est_sec": 3.51,
   "gap_before": 0.36,
   "event": "ordinary_request",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Jaipur is a great one. It's a quick trading game, about twenty minutes, and easy to learn.",
   "est_sec": 5.37,
   "gap_before": 1.18,
   "role": "reply",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "user",
   "text": "We like something",
   "est_sec": 1.03,
   "gap_before": 1.13,
   "event": "distractor",
   "kind": "pause",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "user",
   "text": "a bit more strategic, actually.",
   "est_sec": 1.65,
   "gap_before": 2.67,
   "event": "ordinary_request",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Then try Seven Wonders Duel. It's still under an hour, but there's lots to plan.",
   "est_sec": 4.75,
   "gap_before": 0.53,
   "role": "reply",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "user",
   "text": "Is that one hard to learn?",
   "est_sec": 1.96,
   "gap_before": 0.35,
   "event": "ordinary_request",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "The first game takes a bit of rule checking, but after that it flows nicely. Most couples play it again right away.",
   "est_sec": 6.92,
   "gap_before": 1.07,
   "role": "reply",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "user",
   "text": "Sounds perfect. We'll get that one.",
   "est_sec": 1.96,
   "gap_before": 0.32,
   "event": "ordinary_request",
   "block": "board_games.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Enjoy! Fair warning, it gets pretty competitive.",
   "est_sec": 2.27,
   "gap_before": 1.09,
   "role": "reply",
   "block": "board_games.dlg1"
  }
 ]
