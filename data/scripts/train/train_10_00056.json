 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.65,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.71,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "I have about forty games I've bought and never played. How do I even choose?",
   "est_sec": 4.75,
   "gap_before": 0.39,
   "event": "ordinary_request",
   "block": "video_games.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "A classic backlog. One way is to pick by how long they take. Do you want a short win or a long project right now?",
   "est_sec": 7.85,
   "gap_before": 1.06,
   "role": "reply",
   "block": "video_games.dlg25"
  },
  {
   "speaker": "user",
   "text": "Short. I need to feel like I finish something.",
   "est_sec": 2.89,
   "gap_before": 0.65,
   "event": "ordinary_request",
   "block": "video_games.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Then look up how long each one takes to beat and sort by that. Pick the shortest one you're still curious about.",
   "est_sec": 6.92,
   "gap_before": 1.14,
   "role": "reply",
   "block": "video_games.dlg25"
  },
  {
   "speaker": "user",
   "text": "What if I don't",
   "est_sec": 1.34,
   "gap_before": 0.64,
   "event": "distractor",
   "kind": "pause",
   "block": "video_games.dlg25"
  },
  {
   "speaker": "user",
   "text": "like it after an hour?",
   "est_sec": 1.65,
   "gap_before": 2.16,
   "event": "ordinary_request",
   "block": "video_games.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Drop it, guilt free. A backlog isn't homework. Uninstalling things you won't play makes the list feel lighter too.",
   "est_sec": 5.99,
   "gap_before": 0.82,
   "role": "reply",
   "block": "video_games.dlg25"
  },
  {
   "speaker": "user",
   "text": "Wait, what did you say?",
   "est_sec": 1.65,
   "gap_before": 1.22,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_01",
   "block": "video_games.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Of course. Drop it, guilt free. A backlog isn't homework. Uninstalling things you won't play makes the list feel lighter too.",
   "est_sec": 6.61,
   "gap_before": 0.59,
   "role": "reply",
   "block": "video_games.dlg25"
  },
  {
   "speaker": "user",
   "text": "And stop buying new ones?",
   "est_sec": 1.65,
