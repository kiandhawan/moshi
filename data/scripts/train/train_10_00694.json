 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.74,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.84,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "Is it okay to take melatonin every night? My coworker swears by it.",
   "est_sec": 4.13,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "sleep.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "It's best to check with a doctor or pharmacist, especially for nightly use. It can help for things like jet lag, but it's not a fix for every sleep problem.",
   "est_sec": 9.4,
   "gap_before": 0.35,
   "role": "reply",
   "block": "sleep.dlg5"
  },
  {
   "speaker": "user",
   "text": "I just thought it was",
   "est_sec": 1.65,
   "gap_before": 1.45,
   "event": "distractor",
   "kind": "pause",
   "block": "sleep.dlg5"
  },
  {
   "speaker": "user",
   "text": "like a vitamin.",
   "est_sec": 1.03,
   "gap_before": 2.69,
   "event": "ordinary_request",
   "block": "sleep.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Lots of people think that. It's a hormone, and the doses in some products are much higher than your body makes.",
   "est_sec": 6.61,
   "gap_before": 0.83,
   "role": "reply",
   "block": "sleep.dlg5"
  },
  {
   "speaker": "user",
   "text": "So what should I try instead?",
   "est_sec": 1.96,
   "gap_before": 0.34,
   "event": "ordinary_request",
   "block": "sleep.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Start with the basics. Same wake time every day, dim lights an hour before bed, and no caffeine after lunch. If that doesn't help in a few weeks, then talk to your doctor.",
   "est_sec": 10.33,
   "gap_before": 0.52,
   "role": "reply",
   "block": "sleep.dlg5"
  },
  {
   "speaker": "user",
   "text": "Okay. The no caffeine part is going to hurt.",
   "est_sec": 2.89,
   "gap_before": 1.65,
   "event": "ordinary_request",
   "block": "sleep.dlg5"
  },
  {
   "speaker": "moshi",
   "text": "Decaf in the afternoon is a decent halfway point.",
   "est_sec": 2.89,
   "gap_before": 0.42,
   "role": "reply",
   "block": "sleep.dlg5"
  }
 ]
