 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.67,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.31,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "How much of my paycheck should I be saving?",
   "est_sec": 2.89,
   "gap_before": 0.23,
   "event": "ordinary_request",
   "block": "personal_finance.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "A common rule of thumb is about a fifth of your take home pay. If that's too much right now, start smaller and build up.",
   "est_sec": 7.85,
   "gap_before": 0.55,
   "role": "reply",
   "block": "personal_finance.dlg1"
  },
  {
   "speaker": "user",
   "text": "A fifth sounds like a lot when rent is already half.",
   "est_sec": 3.51,
   "gap_before": 0.92,
   "event": "ordinary_request",
   "block": "personal_finance.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "That's tight, I get it. Even five percent saved automatically is a great habit to start with.",
   "est_sec": 5.37,
   "gap_before": 1.44,
   "role": "reply",
   "block": "personal_finance.dlg1"
  },
  {
   "speaker": "user",
   "text": "Should that go into",
   "est_sec": 1.34,
   "gap_before": 1.22,
   "event": "distractor",
   "kind": "pause",
   "block": "personal_finance.dlg1"
  },
  {
   "speaker": "user",
   "text": "like a normal savings account, or something else?",
   "est_sec": 2.58,
   "gap_before": 2.61,
   "event": "ordinary_request",
   "block": "personal_finance.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "For an emergency fund, a high yield savings account is ideal. It's easy to reach and still earns some interest.",
   "est_sec": 6.3,
   "gap_before": 0.9,
   "role": "reply",
   "block": "personal_finance.dlg1"
  },
  {
   "speaker": "user",
   "text": "And once that's built up?",
   "est_sec": 1.65,
   "gap_before": 2.84,
   "event": "ordinary_request",
   "block": "personal_finance.dlg1"
  },
  {
   "speaker": "moshi",
   "text": "Then look at retirement accounts, especially if your employer matches contributions. That match is basically free money.",
   "est_sec": 5.37,
   "gap_before": 1.29,
   "role": "reply",
   "block": "personal_finance.dlg1"
  }
 ]
}
