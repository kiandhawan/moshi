 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.61,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "My friend is visiting this weekend and she doesn't drink. Most of my plans involve pubs. Oops.",
   "est_sec": 5.37,
   "gap_before": 0.47,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Easy fix. There's lots to do without alcohol, like a bowling alley, a food market or a comedy show.",
   "est_sec": 5.99,
   "gap_before": 0.78,
   "role": "reply",
   "block": "weekend_plans.dlg9"
  },
  {
   "speaker": "user",
   "text": "Comedy could be good. She loves to laugh.",
   "est_sec": 2.58,
   "gap_before": 1.21,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Book a small club night, they're cheap and often really fun. You could grab dinner first.",
   "est_sec": 5.06,
   "gap_before": 0.56,
   "role": "reply",
   "block": "weekend_plans.dlg9"
  },
  {
   "speaker": "user",
   "text": "And Sunday?",
   "est_sec": 0.72,
   "gap_before": 1.22,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Maybe a long walk and brunch, or a cooking class together if there's one nearby.",
   "est_sec": 4.75,
   "gap_before": 0.96,
   "role": "reply",
   "block": "weekend_plans.dlg9"
  },
  {
   "speaker": "user",
   "text": "Okay, that's",
   "est_sec": 0.72,
   "gap_before": 0.49,
   "event": "distractor",
   "kind": "pause",
   "block": "weekend_plans.dlg9"
  },
  {
   "speaker": "user",
   "text": "way better than my pub crawl idea.",
   "est_sec": 2.27,
   "gap_before": 1.85,
   "event": "ordinary_request",
   "block": "weekend_plans.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Ha, and you'll probably remember more of the weekend too.",
   "est_sec": 3.2,
   "gap_before": 0.56,
   "role": "reply",
   "block": "weekend_plans.dlg9"
  }
