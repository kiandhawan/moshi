 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.66,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.91,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "My kids moan the whole way on every walk. Seven and nine.",
   "est_sec": 3.82,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "hiking.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Classic. Give them a job. One can be the navigator with the map, the other can be in charge of the snacks.",
   "est_sec": 6.92,
   "gap_before": 0.36,
   "role": "reply",
   "block": "hiking.dlg23"
  },
  {
   "speaker": "user",
   "text": "The snack job will start a war.",
   "est_sec": 2.27,
   "gap_before": 1.16,
   "event": "ordinary_request",
   "block": "hiking.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Then they swap halfway. Treasure hunts work too, like spotting a feather, a red leaf or a bird nest.",
   "est_sec": 5.99,
   "gap_before": 0.6,
   "role": "reply",
   "block": "hiking.dlg23"
  },
  {
   "speaker": "user",
   "text": "They do like collecting things.",
   "est_sec": 1.65,
   "gap_before": 1.96,
   "event": "ordinary_request",
   "block": "hiking.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Perfect. A small bag each for treasures, and a hot chocolate at the end gives them something to aim for.",
   "est_sec": 6.3,
   "gap_before": 1.19,
   "role": "reply",
   "block": "hiking.dlg23"
  },
  {
   "speaker": "user",
   "text": "Should I",
   "est_sec": 0.72,
   "gap_before": 0.6,
   "event": "distractor",
   "kind": "pause",
   "block": "hiking.dlg23"
  },
  {
   "speaker": "user",
   "text": "tell them how far it is?",
   "est_sec": 1.96,
   "gap_before": 2.97,
   "event": "ordinary_request",
   "block": "hiking.dlg23"
  },
  {
   "speaker": "moshi",
   "text": "Talk in landmarks instead of miles. To the bridge, then the big rock, then the cafe. It feels much shorter.",
   "est_sec": 6.3,
   "gap_before": 0.44,
   "role": "reply",
   "block": "hiking.dlg23"
  }
 ]
}
