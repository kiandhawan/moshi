 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.47,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "Pretty busy, but good.",
   "est_sec": 1.34,
   "gap_before": 0.33,
   "event": "greeting_answer",
   "phrasing": "greet_ans_16"
  },
  {
   "speaker": "user",
   "text": "I'm a student with a tiny oven. Can I still bake cookies?",
   "est_sec": 3.82,
   "gap_before": 0.37,
   "event": "ordinary_request",
   "block": "baking.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Definitely. Bake them in smaller batches on one tray in the middle of the oven, so they cook evenly.",
   "est_sec": 5.99,
   "gap_before": 1.0,
   "role": "reply",
   "block": "baking.dlg4"
  },
  {
   "speaker": "user",
   "text": "I don't have",
   "est_sec": 1.03,
   "gap_before": 1.39,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg4"
  },
  {
   "speaker": "user",
   "text": "a mixer or anything fancy.",
   "est_sec": 1.65,
   "gap_before": 2.63,
   "event": "ordinary_request",
   "block": "baking.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "You don't need one. Melted butter cookies can be mixed with just a spoon and a bowl.",
   "est_sec": 5.37,
   "gap_before": 1.14,
   "role": "reply",
   "block": "baking.dlg4"
  },
  {
   "speaker": "user",
   "text": "Oh nice. How long do they take?",
   "est_sec": 2.27,
   "gap_before": 1.19,
   "event": "ordinary_request",
   "block": "baking.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Usually ten to twelve minutes. Take them out when the edges are golden and the middle still looks soft.",
   "est_sec": 5.99,
   "gap_before": 0.94,
   "role": "reply",
   "block": "baking.dlg4"
  },
  {
   "speaker": "user",
   "text": "They won't be raw?",
   "est_sec": 1.34,
   "gap_before": 3.42,
   "event": "ordinary_request",
   "block": "baking.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "They keep cooking on the hot tray for a few minutes. That's the secret to chewy cookies.",
   "est_sec": 5.37,
   "gap_before": 0.54,
   "role": "reply",
   "block": "baking.dlg4"
  }
 ]
}
