 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.56,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "Honestly, a little stressed, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.98,
   "event": "greeting_answer",
   "phrasing": "greet_ans_07"
  },
  {
   "speaker": "user",
   "text": "We moved into an old house last week and I can't sleep. Every creak sounds like someone on the stairs.",
   "est_sec": 6.3,
   "gap_before": 0.27,
   "event": "ordinary_request",
   "block": "sleep.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "That's really normal in a new place. Your brain stays a little on guard until the noises become familiar.",
   "est_sec": 5.99,
   "gap_before": 1.6,
   "role": "reply",
   "block": "sleep.dlg32"
  },
  {
   "speaker": "user",
   "text": "How long does that last?",
   "est_sec": 1.65,
   "gap_before": 0.6,
   "event": "ordinary_request",
   "block": "sleep.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Usually a week or two. It helps to learn the sounds, the pipes cooling, the floorboards settling, the boiler clicking on.",
   "est_sec": 6.61,
   "gap_before": 0.34,
   "role": "reply",
   "block": "sleep.dlg32"
  },
  {
   "speaker": "user",
   "text": "The boiler. That's probably",
   "est_sec": 1.34,
   "gap_before": 3.19,
   "event": "distractor",
   "kind": "pause",
   "block": "sleep.dlg32"
  },
  {
   "speaker": "user",
   "text": "the thumping at midnight.",
   "est_sec": 1.34,
   "gap_before": 2.75,
   "event": "ordinary_request",
   "block": "sleep.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Very likely. A quiet fan or white noise can cover the random sounds while you adjust.",
   "est_sec": 5.06,
   "gap_before": 1.08,
   "role": "reply",
   "block": "sleep.dlg32"
  },
  {
   "speaker": "user",
   "text": "And maybe I'll check the locks before bed so I stop wondering.",
   "est_sec": 3.82,
   "gap_before": 0.77,
   "event": "ordinary_request",
   "block": "sleep.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Good idea. A little routine like that tells your mind the house is safe.",
   "est_sec": 4.44,
   "gap_before": 1.08,
   "role": "reply",
   "block": "sleep.dlg32"
  }
 ]
}
