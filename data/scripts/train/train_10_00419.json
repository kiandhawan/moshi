 "est_total_sec": 62.39,
 "est_speech_sec": 47.49,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello, how are things going?",
   "est_sec": 1.65,
   "gap_before": 0.76,
   "role": "greeting",
   "phrasing": "greet_22"
  },
  {
   "speaker": "user",
   "text": "Good, good. Thanks.",
   "est_sec": 1.03,
   "gap_before": 0.44,
   "event": "greeting_answer",
   "phrasing": "greet_ans_23"
  },
  {
   "speaker": "user",
   "text": "I've been gluten free for a year and I really miss proper bread.",
   "est_sec": 4.13,
   "gap_before": 0.25,
   "event": "ordinary_request",
   "block": "baking.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Gluten free bread is a different beast, but you can get something good. Start with a flour blend that already contains xanthan gum or psyllium.",
   "est_sec": 7.85,
   "gap_before": 1.04,
   "role": "reply",
   "block": "baking.dlg27"
  },
  {
   "speaker": "user",
   "text": "What does psyllium do?",
   "est_sec": 1.34,
   "gap_before": 0.87,
   "event": "ordinary_request",
   "block": "baking.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "It acts a bit like gluten, holding the dough together and trapping air. Bread made with it is far less crumbly.",
   "est_sec": 6.61,
   "gap_before": 0.5,
   "role": "reply",
   "block": "baking.dlg27"
  },
  {
   "speaker": "user",
   "text": "The dough I made last time",
   "est_sec": 1.96,
   "gap_before": 0.99,
   "event": "distractor",
   "kind": "pause",
   "block": "baking.dlg27"
  },
  {
   "speaker": "user",
   "text": "was like cake batter. Is that normal?",
   "est_sec": 2.27,
   "gap_before": 2.61,
   "event": "ordinary_request",
   "block": "baking.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Yes, gluten free dough is usually much wetter. Don't add more flour to make it feel like normal dough, it'll come out dry.",
   "est_sec": 7.23,
   "gap_before": 0.53,
   "role": "reply",
   "block": "baking.dlg27"
  },
  {
   "speaker": "user",
   "text": "Any tip for the crust?",
   "est_sec": 1.65,
   "gap_before": 1.28,
   "event": "ordinary_request",
   "block": "baking.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Bake it in a covered pot for the first part, then uncover it. And let it cool fully before slicing, it finishes setting as it cools.",
   "est_sec": 8.16,
   "gap_before": 0.73,
   "role": "reply",
   "block": "baking.dlg27"
  },
  {
   "speaker": "user",
   "text": "That's the hardest part.",
   "est_sec": 1.34,
   "gap_before": 2.24,
   "event": "ordinary_request",
   "block": "baking.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "It really is. Warm bread smells unfair.",
   "est_sec": 2.27,
   "gap_before": 1.16,
   "role": "reply",
   "block": "baking.dlg27"
  }
 ]
}
