 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are things with you?",
   "est_sec": 1.96,
   "gap_before": 0.53,
   "role": "greeting",
   "phrasing": "greet_11"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.32,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "There's a fancy new cafe near me, and the menu is so complicated I just ordered a tea last time.",
   "est_sec": 6.3,
   "gap_before": 0.41,
   "event": "ordinary_request",
   "block": "coffee.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Totally understandable, those menus can be a lot. What kind of coffee do you usually like at home?",
   "est_sec": 5.68,
   "gap_before": 0.89,
   "role": "reply",
   "block": "coffee.dlg8"
  },
  {
   "speaker": "user",
   "text": "Milky, not too strong.",
   "est_sec": 1.34,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "coffee.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Then a latte or a cortado in a bigger size would be safe. Or just tell the barista exactly that, milky and not too strong.",
   "est_sec": 7.85,
   "gap_before": 0.56,
   "role": "reply",
   "block": "coffee.dlg8"
  },
  {
   "speaker": "user",
   "text": "Won't they",
   "est_sec": 0.72,
   "gap_before": 1.15,
   "event": "distractor",
   "kind": "pause",
   "block": "coffee.dlg8"
  },
  {
   "speaker": "user",
   "text": "judge me for not knowing?",
   "est_sec": 1.65,
   "gap_before": 2.44,
   "event": "ordinary_request",
   "block": "coffee.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "Most baristas love helping people find something they like. Asking for a recommendation is the best thing you can do.",
   "est_sec": 6.3,
   "gap_before": 0.63,
   "role": "reply",
   "block": "coffee.dlg8"
  },
  {
   "speaker": "user",
   "text": "What's a cortado anyway?",
   "est_sec": 1.34,
   "gap_before": 2.58,
   "event": "ordinary_request",
   "block": "coffee.dlg8"
  },
  {
   "speaker": "moshi",
   "text": "It's espresso with a roughly equal amount of warm milk. Smaller and stronger than a latte, so maybe start with the latte.",
   "est_sec": 6.92,
   "gap_before": 0.87,
   "role": "reply",
   "block": "coffee.dlg8"
  }
 ]
