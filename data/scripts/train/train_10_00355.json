 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.42,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.94,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "My laptop keyboard has crumbs under every key. I eat lunch at my desk.",
   "est_sec": 4.44,
   "gap_before": 0.27,
   "event": "ordinary_request",
   "block": "cleaning.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "We all do. Turn the laptop off, tip it upside down and gently tap the back, a lot will fall out.",
   "est_sec": 6.61,
   "gap_before": 0.76,
   "role": "reply",
   "block": "cleaning.dlg16"
  },
  {
   "speaker": "user",
   "text": "Gross. A whole cracker came out.",
   "est_sec": 1.96,
   "gap_before": 2.61,
   "event": "ordinary_request",
   "block": "cleaning.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Then use a soft brush or a can of compressed air between the keys, short bursts at an angle.",
   "est_sec": 5.99,
   "gap_before": 0.45,
   "role": "reply",
   "block": "cleaning.dlg16"
  },
  {
   "speaker": "user",
   "text": "And the keys are shiny",
   "est_sec": 1.65,
   "gap_before": 1.26,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg16"
  },
  {
   "speaker": "user",
   "text": "and grubby too.",
   "est_sec": 1.03,
   "gap_before": 1.71,
   "event": "ordinary_request",
   "block": "cleaning.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Wipe them with a cloth barely dampened with rubbing alcohol. Never spray anything straight onto the keyboard.",
   "est_sec": 5.37,
   "gap_before": 0.86,
   "role": "reply",
   "block": "cleaning.dlg16"
  },
  {
   "speaker": "user",
   "text": "Wait, looks brand new. Kind of.",
   "est_sec": 1.96,
   "gap_before": 0.87,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_13",
   "block": "cleaning.dlg16"
  },
  {
   "speaker": "moshi",
   "text": "Kind of is great for a keyboard.",
   "est_sec": 2.27,
   "gap_before": 0.73,
   "role": "reply",
   "block": "cleaning.dlg16"
  }
 ]
