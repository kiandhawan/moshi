 "est_total_sec": 47.66,
 "est_speech_sec": 37.89,
 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey! How are you feeling?",
   "est_sec": 1.65,
   "gap_before": 0.34,
   "role": "greeting",
   "phrasing": "greet_23"
  },
  {
   "speaker": "user",
   "text": "Can't complain.",
   "est_sec": 0.72,
   "gap_before": 0.72,
   "event": "greeting_answer",
   "phrasing": "greet_ans_20"
  },
  {
   "speaker": "user",
   "text": "The walk I'm planning ends at a lake. I'd love to swim at the end.",
   "est_sec": 4.75,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "hiking.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Sounds lovely. Just be careful, mountain lakes are often much colder than they look, even in summer.",
   "est_sec": 5.37,
   "gap_before": 1.62,
   "role": "reply",
   "block": "hiking.dlg25"
  },
  {
   "speaker": "user",
   "text": "How cold are we talking?",
   "est_sec": 1.65,
   "gap_before": 1.21,
   "event": "ordinary_request",
   "block": "hiking.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "It can be cold enough to make you gasp involuntarily, which is dangerous if your head goes under. Walk in slowly rather than jumping.",
   "est_sec": 7.54,
   "gap_before": 0.74,
   "role": "reply",
   "block": "hiking.dlg25"
  },
  {
   "speaker": "user",
   "text": "I was totally going to jump.",
   "est_sec": 1.96,
   "gap_before": 1.05,
   "event": "ordinary_request",
   "block": "hiking.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Lots of people do. Let your body adjust for a minute or two first, and stay close to the shore.",
   "est_sec": 6.3,
   "gap_before": 0.41,
   "role": "reply",
   "block": "hiking.dlg25"
  },
  {
   "speaker": "user",
   "text": "Anything else?",
   "est_sec": 0.72,
   "gap_before": 1.34,
   "event": "ordinary_request",
   "block": "hiking.dlg25"
  },
  {
   "speaker": "moshi",
   "text": "Swim with someone, keep it short, and have warm clothes and a hot drink ready. You'll cool down more after you get out.",
   "est_sec": 7.23,
   "gap_before": 0.3,
   "role": "reply",
   "block": "hiking.dlg25"
  }
 ]
}
