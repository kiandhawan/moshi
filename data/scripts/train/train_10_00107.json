 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you holding up?",
   "est_sec": 1.96,
   "gap_before": 0.42,
   "role": "greeting",
   "phrasing": "greet_16"
  },
  {
   "speaker": "user",
   "text": "Pretty good so far.",
   "est_sec": 1.34,
   "gap_before": 0.75,
   "event": "greeting_answer",
   "phrasing": "greet_ans_29"
  },
  {
   "speaker": "user",
   "text": "What actually is a director's cut? Is it always better?",
   "est_sec": 3.2,
   "gap_before": 0.26,
   "event": "ordinary_request",
   "block": "movies.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "It's a version of the film closer to what the director wanted, often before the studio asked for changes, like trimming it shorter.",
   "est_sec": 7.23,
   "gap_before": 0.4,
   "role": "reply",
   "block": "movies.dlg6"
  },
  {
   "speaker": "user",
   "text": "So it's longer.",
   "est_sec": 1.03,
   "gap_before": 0.6,
   "event": "ordinary_request",
   "block": "movies.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Usually longer, sometimes with a different ending or extra scenes that explain things.",
   "est_sec": 4.13,
   "gap_before": 0.6,
   "role": "reply",
   "block": "movies.dlg6"
  },
  {
   "speaker": "user",
   "text": "Always better though?",
   "est_sec": 1.03,
   "gap_before": 0.9,
   "event": "ordinary_request",
   "block": "movies.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Not always. Sometimes the studio was right and the shorter version is tighter. Other times the director's cut fixes a film that felt rushed.",
   "est_sec": 7.54,
   "gap_before": 1.49,
   "role": "reply",
   "block": "movies.dlg6"
  },
  {
   "speaker": "user",
   "text": "There's one I like that",
   "est_sec": 1.65,
   "gap_before": 0.6,
   "event": "distractor",
   "kind": "pause",
   "block": "movies.dlg6"
  },
  {
   "speaker": "user",
   "text": "apparently has a forty minute longer version.",
   "est_sec": 2.27,
   "gap_before": 1.93,
   "event": "ordinary_request",
   "block": "movies.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Then watch it on a lazy weekend with no expectations. You might love the extra time with the characters, or miss the pace of the original.",
