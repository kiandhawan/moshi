  },
  {
   "speaker": "user",
   "text": "My cousin's flying in from Brazil tonight, she'll be jetlagged. What film should we put on?",
   "est_sec": 5.06,
   "gap_before": 0.59,
   "event": "ordinary_request",
   "block": "movies.dlg9"
  },
  {
   "speaker": "moshi",
   "text": "Something easy to follow that you can talk over. A light comedy or a heartwarming film is ideal, nothing with a complicated plot.",
