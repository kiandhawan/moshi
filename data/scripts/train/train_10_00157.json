 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there, how are you?",
   "est_sec": 1.65,
   "gap_before": 0.52,
   "role": "greeting",
   "phrasing": "greet_04"
  },
  {
   "speaker": "user",
   "text": "I'm alright, a bit tired.",
   "est_sec": 1.65,
   "gap_before": 0.53,
   "event": "greeting_answer",
   "phrasing": "greet_ans_05"
  },
  {
   "speaker": "user",
   "text": "I'm sixty-eight and my doctor said I should do more exercise. I'm not really a gym person.",
   "est_sec": 5.37,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "fitness.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "You don't need a gym. Brisk walking, swimming or a gentle yoga class are all excellent choices.",
   "est_sec": 5.37,
   "gap_before": 0.77,
   "role": "reply",
   "block": "fitness.dlg4"
  },
  {
   "speaker": "user",
   "text": "I do like swimming. How often should I go?",
   "est_sec": 2.89,
   "gap_before": 1.09,
   "event": "ordinary_request",
   "block": "fitness.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Two or three times a week is a great target. Start with twenty minutes and build up as you feel comfortable.",
   "est_sec": 6.61,
   "gap_before": 1.14,
   "role": "reply",
   "block": "fitness.dlg4"
  },
  {
   "speaker": "user",
   "text": "Wait a second, what about strength? My doctor mentioned that too.",
   "est_sec": 3.51,
   "gap_before": 1.19,
   "event": "ordinary_request",
   "kind": "wait_like",
   "phrasing": "waitlike_16",
   "block": "fitness.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Simple things help a lot, like standing up from a chair without using your hands, or light weights at home.",
   "est_sec": 6.3,
   "gap_before": 0.55,
   "role": "reply",
   "block": "fitness.dlg4"
  },
  {
   "speaker": "user",
   "text": "I have some old dumbbells",
   "est_sec": 1.65,
   "gap_before": 0.37,
   "event": "distractor",
   "kind": "pause",
   "block": "fitness.dlg4"
  },
  {
   "speaker": "user",
   "text": "somewhere in the garage, I think.",
   "est_sec": 1.96,
   "gap_before": 2.6,
   "event": "ordinary_request",
   "block": "fitness.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Perfect. Try a few slow bicep curls and shoulder raises while watching television.",
