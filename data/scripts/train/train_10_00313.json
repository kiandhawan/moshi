 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.67,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.71,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "How do I ask about working from home without looking like I don't want to work?",
   "est_sec": 5.06,
   "gap_before": 0.21,
   "event": "ordinary_request",
   "block": "job_interview.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Ask it as a question about how the team works, not about what you want.",
   "est_sec": 4.75,
   "gap_before": 1.78,
   "role": "reply",
   "block": "job_interview.dlg11"
  },
  {
   "speaker": "user",
   "text": "Like what exactly?",
   "est_sec": 1.03,
   "gap_before": 1.64,
   "event": "ordinary_request",
   "block": "job_interview.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Something like, how does the team usually split time between the office and home? It's neutral and practical.",
   "est_sec": 5.68,
   "gap_before": 1.02,
   "role": "reply",
   "block": "job_interview.dlg11"
  },
  {
   "speaker": "user",
   "text": "And if they say everyone's in five days?",
   "est_sec": 2.58,
   "gap_before": 0.65,
   "event": "ordinary_request",
   "block": "job_interview.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Then you've learned something important before accepting. You don't have to argue in the interview itself.",
   "est_sec": 5.06,
   "gap_before": 0.64,
   "role": "reply",
   "block": "job_interview.dlg11"
  },
  {
   "speaker": "user",
   "text": "Should I bring it up",
   "est_sec": 1.65,
   "gap_before": 1.41,
   "event": "distractor",
   "kind": "pause",
   "block": "job_interview.dlg11"
  },
  {
   "speaker": "user",
   "text": "in the first round already?",
   "est_sec": 1.65,
   "gap_before": 2.69,
   "event": "ordinary_request",
   "block": "job_interview.dlg11"
  },
  {
   "speaker": "moshi",
   "text": "Usually the second round or when an offer is near is better. In the first round, focus on showing you're right for the job.",
   "est_sec": 7.54,
   "gap_before": 0.68,
   "role": "reply",
   "block": "job_interview.dlg11"
  }
 ]
