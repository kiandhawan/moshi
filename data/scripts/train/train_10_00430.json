 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, good to have you here. How are you?",
   "est_sec": 2.89,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_20"
  },
  {
   "speaker": "user",
   "text": "Pretty relaxed today.",
   "est_sec": 1.03,
   "gap_before": 0.89,
   "event": "greeting_answer",
   "phrasing": "greet_ans_22"
  },
  {
   "speaker": "user",
   "text": "It's pouring rain on our moving day tomorrow. Ugh.",
   "est_sec": 2.89,
   "gap_before": 0.48,
   "event": "ordinary_request",
   "block": "moving_house.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Annoying, but manageable. Lay old towels or cardboard on the floors at both places to stop mud getting everywhere.",
   "est_sec": 5.99,
   "gap_before": 0.45,
   "role": "reply",
   "block": "moving_house.dlg31"
  },
  {
   "speaker": "user",
   "text": "What about the boxes?",
   "est_sec": 1.34,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "moving_house.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Cover the ones with paper or books in bin bags. Keep a pile of plastic sheeting near the van for the sofa and mattress.",
   "est_sec": 7.54,
   "gap_before": 0.38,
   "role": "reply",
   "block": "moving_house.dlg31"
  },
  {
   "speaker": "user",
   "text": "The van is going to",
   "est_sec": 1.65,
   "gap_before": 2.01,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg31"
  },
  {
   "speaker": "user",
   "text": "get soaked inside too.",
   "est_sec": 1.34,
   "gap_before": 1.92,
   "event": "ordinary_request",
   "block": "moving_house.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "Park as close to the door as you can, and set up a quick handover point so things spend as little time in the rain as possible.",
   "est_sec": 8.47,
   "gap_before": 1.08,
   "role": "reply",
   "block": "moving_house.dlg31"
  },
  {
   "speaker": "user",
   "text": "Makes sense.",
   "est_sec": 0.72,
   "gap_before": 0.49,
   "event": "ordinary_request",
   "block": "moving_house.dlg31"
  },
  {
   "speaker": "moshi",
   "text": "And keep a dry change of clothes for everyone. You'll want it by the end.",
   "est_sec": 4.75,
   "gap_before": 0.37,
   "role": "reply",
   "block": "moving_house.dlg31"
  }
 ]
}
