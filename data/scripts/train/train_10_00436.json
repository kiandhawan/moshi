 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you today?",
   "est_sec": 1.65,
   "gap_before": 0.79,
   "role": "greeting",
   "phrasing": "greet_02"
  },
  {
   "speaker": "user",
   "text": "A bit tired today, but okay.",
   "est_sec": 1.96,
   "gap_before": 0.61,
   "event": "greeting_answer",
   "phrasing": "greet_ans_17"
  },
  {
   "speaker": "user",
   "text": "First year at uni, my birthday's next week, and I don't really know anyone yet.",
   "est_sec": 4.75,
   "gap_before": 0.54,
   "event": "ordinary_request",
   "block": "birthday_party.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "That can feel lonely, but birthdays are actually a great excuse to get to know people. Who do you chat to most?",
   "est_sec": 6.92,
   "gap_before": 0.6,
   "role": "reply",
   "block": "birthday_party.dlg27"
  },
  {
   "speaker": "user",
   "text": "A couple of people from my flat, and one girl from my seminar.",
   "est_sec": 4.13,
   "gap_before": 0.76,
   "event": "ordinary_request",
   "block": "birthday_party.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Invite them for something casual, like pizza in the flat kitchen. Low pressure, and people love a free slice.",
   "est_sec": 5.99,
   "gap_before": 0.67,
   "role": "reply",
   "block": "birthday_party.dlg27"
  },
  {
   "speaker": "user",
   "text": "What if nobody comes?",
   "est_sec": 1.34,
   "gap_before": 0.41,
   "event": "ordinary_request",
   "block": "birthday_party.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Ask in person rather than in a group chat. People rarely say no to a face to face invite.",
   "est_sec": 5.99,
   "gap_before": 1.15,
   "role": "reply",
   "block": "birthday_party.dlg27"
  },
  {
   "speaker": "user",
   "text": "Okay. I'll ask tomorrow. Maybe.",
   "est_sec": 1.65,
   "gap_before": 0.99,
   "event": "ordinary_request",
   "block": "birthday_party.dlg27"
  },
  {
   "speaker": "moshi",
   "text": "Do it. Worst case you get pizza and a quiet evening. Best case, those three become your people.",
   "est_sec": 5.68,
   "gap_before": 1.11,
   "role": "reply",
   "block": "birthday_party.dlg27"
  }
 ]
}
