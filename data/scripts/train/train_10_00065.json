 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.44,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Doing well, thank you.",
   "est_sec": 1.34,
   "gap_before": 0.81,
   "event": "greeting_answer",
   "phrasing": "greet_ans_10"
  },
  {
   "speaker": "user",
   "text": "Is taking the bus actually better for the environment than driving? Be honest.",
   "est_sec": 4.13,
   "gap_before": 0.56,
   "event": "ordinary_request",
   "block": "public_transport.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "Generally yes, especially when the bus is reasonably full. Per passenger, a busy bus produces far less pollution than everyone driving.",
   "est_sec": 6.61,
   "gap_before": 1.18,
   "role": "reply",
   "block": "public_transport.dlg21"
  },
  {
   "speaker": "user",
   "text": "And an empty bus at midnight?",
   "est_sec": 1.96,
   "gap_before": 1.35,
   "event": "ordinary_request",
   "block": "public_transport.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "That's less impressive, fair. But the bus runs anyway, so you riding it adds almost nothing extra.",
   "est_sec": 5.37,
   "gap_before": 1.55,
   "role": "reply",
   "block": "public_transport.dlg21"
  },
  {
   "speaker": "user",
   "text": "Huh. I never looked",
   "est_sec": 1.34,
   "gap_before": 2.98,
   "event": "distractor",
   "kind": "pause",
   "block": "public_transport.dlg21"
  },
  {
   "speaker": "user",
   "text": "at it that way.",
   "est_sec": 1.34,
   "gap_before": 1.8,
   "event": "ordinary_request",
   "block": "public_transport.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "It's a nice way to think about it. And trains, especially electric ones, are usually even better.",
   "est_sec": 5.37,
   "gap_before": 0.83,
   "role": "reply",
   "block": "public_transport.dlg21"
  },
  {
   "speaker": "user",
   "text": "So I can feel smug on the train.",
   "est_sec": 2.58,
   "gap_before": 0.33,
   "event": "ordinary_request",
   "block": "public_transport.dlg21"
  },
  {
   "speaker": "moshi",
   "text": "A little smugness is allowed.",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "role": "reply",
   "block": "public_transport.dlg21"
  }
 ]
}
