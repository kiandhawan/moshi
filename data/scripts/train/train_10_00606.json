 "turns": [
  {
   "speaker": "moshi",
   "text": "Hello there! How's your day treating you?",
   "est_sec": 2.27,
   "gap_before": 0.63,
   "role": "greeting",
   "phrasing": "greet_25"
  },
  {
   "speaker": "user",
   "text": "Not too bad.",
   "est_sec": 1.03,
   "gap_before": 0.49,
   "event": "greeting_answer",
   "phrasing": "greet_ans_11"
  },
  {
   "speaker": "user",
   "text": "I want to make a monthly budget but every app I try feels complicated.",
   "est_sec": 4.44,
   "gap_before": 0.28,
   "event": "ordinary_request",
   "block": "personal_finance.ctx2"
  },
  {
   "speaker": "moshi",
   "text": "You could keep it simple with a spreadsheet, or try the envelope method with cash. Which feels more doable for you?",
   "est_sec": 6.61,
   "gap_before": 0.58,
   "role": "reply",
   "block": "personal_finance.ctx2"
  },
  {
   "speaker": "user",
   "text": "Excuse me for a moment, my friend has a question. Don't talk until I'm back.",
   "est_sec": 4.75,
   "gap_before": 0.69,
   "event": "instruction",
   "kind": "side_conversation",
   "phrasing": "side_instr_11"
  },
  {
   "speaker": "user",
   "text": "Rosa, have you seen my ticket? I swear I had it at the barrier.",
   "est_sec": 4.44,
   "gap_before": 1.37,
   "block": "public_transport.side5"
  },
  {
   "speaker": "friend",
   "text": "Check your coat pocket.",
   "est_sec": 1.34,
   "gap_before": 1.25,
   "block": "public_transport.side5"
  },
  {
   "speaker": "user",
   "text": "Not there. Oh no, there's an inspector getting on.",
   "est_sec": 2.89,
   "gap_before": 0.67,
   "block": "public_transport.side5"
  },
  {
   "speaker": "friend",
   "text": "Calm down. Did you buy it on the app?",
   "est_sec": 2.89,
   "gap_before": 1.25,
   "block": "public_transport.side5"
  },
  {
   "speaker": "user",
   "text": "No, paper. From the machine.",
   "est_sec": 1.65,
   "gap_before": 0.56,
   "block": "public_transport.side5"
  },
  {
   "speaker": "friend",
   "text": "Back pocket of your jeans? You always shove things there.",
   "est_sec": 3.2,
   "gap_before": 1.11,
   "block": "public_transport.side5"
  },
  {
   "speaker": "user",
   "text": "Oh. Found it. How do you know that about me?",
   "est_sec": 3.2,
   "gap_before": 0.43,
   "event": "distractor",
   "kind": "friend_question",
   "block": "public_transport.side5"
  },
  {
   "speaker": "friend",
   "text": "Years of experience.",
   "est_sec": 1.03,
   "gap_before": 0.88,
   "block": "public_transport.side5"
  },
  {
   "speaker": "user",
   "text": "Alright, I'm back now.",
   "est_sec": 1.34,
   "gap_before": 1.09,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "side_cue_02"
  },
  {
   "speaker": "moshi",
   "text": "Sure thing. Still weighing the spreadsheet against the envelope method?",
   "est_sec": 3.2,
   "gap_before": 0.47,
   "role": "resume",
   "block": "personal_finance.ctx2"
  },
  {
   "speaker": "user",
   "text": "Let's try envelopes. I need to actually see the money go.",
   "est_sec": 3.51,
   "gap_before": 0.57,
   "event": "ordinary_request",
   "block": "personal_finance.ctx2"
  },
  {
   "speaker": "moshi",
   "text": "Good choice for that. Label envelopes for groceries, fun and gas, and when one's empty, that's it for the month.",
   "est_sec": 6.3,
   "gap_before": 0.35,
   "role": "followup",
   "block": "personal_finance.ctx2"
  }
 ]
