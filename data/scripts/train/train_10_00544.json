   "text": "Sure, but the battery doesn't last long. Charge it the night before.",
   "est_sec": 3.82,
   "gap_before": 0.36,
   "block": "gardening.side3"
  },
  {
   "speaker": "user",
   "text": "Will do. Is it okay on thick branches?",
