 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey there! How's your day?",
   "est_sec": 1.65,
   "gap_before": 0.59,
   "role": "greeting",
   "phrasing": "greet_17"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.98,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "I just moved into an apartment and the oven is disgusting. Where do I even start?",
   "est_sec": 5.06,
   "gap_before": 0.43,
   "event": "ordinary_request",
   "block": "cleaning.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Take the racks out and soak them in the bathtub with hot water and dish soap. Then coat the inside with a baking soda paste and leave it overnight.",
   "est_sec": 9.09,
   "gap_before": 1.13,
   "role": "reply",
   "block": "cleaning.dlg4"
  },
  {
   "speaker": "user",
   "text": "Overnight? I was hoping",
   "est_sec": 1.34,
   "gap_before": 0.53,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg4"
  },
  {
   "speaker": "user",
   "text": "to cook something tonight.",
   "est_sec": 1.34,
   "gap_before": 2.09,
   "event": "ordinary_request",
   "block": "cleaning.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "You can cook tonight and start the paste after. Cleaning a slightly warm oven is actually a bit easier.",
   "est_sec": 5.99,
   "gap_before": 0.74,
   "role": "reply",
   "block": "cleaning.dlg4"
  },
  {
   "speaker": "user",
   "text": "What do I do in the morning?",
   "est_sec": 2.27,
   "gap_before": 0.8,
   "event": "ordinary_request",
   "block": "cleaning.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Wipe off the paste with a damp cloth, then spray a little vinegar on the leftover bits. It fizzes and loosens them.",
   "est_sec": 6.92,
   "gap_before": 0.86,
   "role": "reply",
   "block": "cleaning.dlg4"
  },
  {
   "speaker": "user",
   "text": "And the glass on the door?",
   "est_sec": 1.96,
   "gap_before": 0.86,
   "event": "ordinary_request",
   "block": "cleaning.dlg4"
  },
  {
   "speaker": "moshi",
   "text": "Same paste, then a razor scraper held flat for the tough spots. Go gently so you don't scratch it.",
   "est_sec": 5.99,
   "gap_before": 1.11,
   "role": "reply",
   "block": "cleaning.dlg4"
  }
 ]
}
