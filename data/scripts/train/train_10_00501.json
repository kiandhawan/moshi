 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi! How are you doing these days?",
   "est_sec": 2.27,
   "gap_before": 0.5,
   "role": "greeting",
   "phrasing": "greet_26"
  },
  {
   "speaker": "user",
   "text": "Pretty well, actually.",
   "est_sec": 1.03,
   "gap_before": 0.42,
   "event": "greeting_answer",
   "phrasing": "greet_ans_04"
  },
  {
   "speaker": "user",
   "text": "My cat keeps leaving dead mice on the doormat. Is she trying to tell me something?",
   "est_sec": 5.06,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "block": "pets.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "In a way. It's natural hunting behaviour, and some think cats bring prey home to the place they feel safe, or to share with their family.",
   "est_sec": 8.16,
   "gap_before": 0.78,
   "role": "reply",
   "block": "pets.dlg32"
  },
  {
   "speaker": "user",
   "text": "It's very disgusting sharing.",
   "est_sec": 1.34,
   "gap_before": 1.56,
   "event": "ordinary_request",
   "block": "pets.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Ha, I understand. Don't tell her off, she won't connect it with the mouse.",
   "est_sec": 4.44,
   "gap_before": 0.56,
   "role": "reply",
   "block": "pets.dlg32"
  },
  {
   "speaker": "user",
   "text": "Can I stop her hunting?",
   "est_sec": 1.65,
   "gap_before": 0.42,
   "event": "ordinary_request",
   "block": "pets.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "A bright collar with a quick release clasp can warn birds and mice. Keeping her in at dawn and dusk also cuts down on hunting.",
   "est_sec": 7.85,
   "gap_before": 0.33,
   "role": "reply",
   "block": "pets.dlg32"
  },
  {
   "speaker": "user",
   "text": "And playing with her more?",
   "est_sec": 1.65,
   "gap_before": 1.02,
   "event": "ordinary_request",
   "block": "pets.dlg32"
  },
  {
   "speaker": "moshi",
   "text": "Yes, that helps a lot. Hunting style play with a wand toy, ending with a treat, can satisfy that instinct before she goes out.",
   "est_sec": 7.54,
   "gap_before": 0.99,
   "role": "reply",
   "block": "pets.dlg32"
  }
 ]
}
