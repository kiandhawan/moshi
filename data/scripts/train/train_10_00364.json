 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how have you been?",
   "est_sec": 1.65,
   "gap_before": 0.57,
   "role": "greeting",
   "phrasing": "greet_05"
  },
  {
   "speaker": "user",
   "text": "Kind of tired, honestly.",
   "est_sec": 1.34,
   "gap_before": 0.45,
   "event": "greeting_answer",
   "phrasing": "greet_ans_26"
  },
  {
   "speaker": "user",
   "text": "My four-year-old drew on our cream leather sofa. With a biro.",
   "est_sec": 3.51,
   "gap_before": 0.52,
   "event": "ordinary_request",
   "block": "cleaning.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Oh dear. Act fast, ink sets over time. Dab a cotton bud with a little rubbing alcohol and touch only the ink lines.",
   "est_sec": 7.23,
   "gap_before": 1.16,
   "role": "reply",
   "block": "cleaning.dlg13"
  },
  {
   "speaker": "user",
   "text": "Won't that hurt the leather?",
   "est_sec": 1.65,
   "gap_before": 1.23,
   "event": "ordinary_request",
   "block": "cleaning.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Test it on a hidden spot first, like the back. And dab, don't rub, or you'll spread it.",
   "est_sec": 5.68,
   "gap_before": 1.11,
   "role": "reply",
   "block": "cleaning.dlg13"
  },
  {
   "speaker": "user",
   "text": "Okay. It's lifting on",
   "est_sec": 1.34,
   "gap_before": 2.47,
   "event": "distractor",
   "kind": "pause",
   "block": "cleaning.dlg13"
  },
  {
   "speaker": "user",
   "text": "the test bit.",
   "est_sec": 1.03,
   "gap_before": 2.92,
   "event": "ordinary_request",
   "block": "cleaning.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Good. Work slowly along the lines, then wipe with a damp cloth and use leather conditioner afterwards.",
   "est_sec": 5.37,
   "gap_before": 0.75,
   "role": "reply",
   "block": "cleaning.dlg13"
  },
  {
   "speaker": "user",
   "text": "And hide every pen in the house.",
   "est_sec": 2.27,
   "gap_before": 1.39,
   "event": "ordinary_request",
   "block": "cleaning.dlg13"
  },
  {
   "speaker": "moshi",
   "text": "Probably wise for a while.",
   "est_sec": 1.65,
   "gap_before": 0.33,
   "role": "reply",
   "block": "cleaning.dlg13"
  }
 ]
}
