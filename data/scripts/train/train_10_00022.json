  {
   "speaker": "user",
   "text": "What's a mind map and do they actually help?",
   "est_sec": 2.89,
   "gap_before": 0.3,
   "event": "ordinary_request",
   "block": "studying.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "It's a diagram with the main topic in the middle, and branches going out for ideas and details. Lots of people find them great for seeing connections.",
   "est_sec": 8.47,
   "gap_before": 0.83,
   "role": "reply",
   "block": "studying.dlg15"
  },
  {
   "speaker": "user",
   "text": "Like a spider web.",
   "est_sec": 1.34,
   "gap_before": 0.53,
   "event": "ordinary_request",
   "block": "studying.dlg15"
  },
  {
   "speaker": "moshi",
   "text": "Exactly. You can use colours, little drawings, and short words instead of full sentences.",
   "est_sec": 4.44,
   "gap_before": 0.33,
   "role": "reply",
   "block": "studying.dlg15"
  },
