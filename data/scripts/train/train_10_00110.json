 "turns": [
  {
   "speaker": "moshi",
   "text": "Hi, how are you doing right now?",
   "est_sec": 2.27,
   "gap_before": 0.4,
   "role": "greeting",
   "phrasing": "greet_29"
  },
  {
   "speaker": "user",
   "text": "Doing alright, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.33,
   "event": "greeting_answer",
   "phrasing": "greet_ans_28"
  },
  {
   "speaker": "user",
   "text": "Laundry is taking over my bedroom and I need a better plan.",
   "est_sec": 3.82,
   "gap_before": 0.56,
   "block": "cleaning.opt3"
  },
  {
   "speaker": "user",
   "text": "Hold your thoughts until I've described all the options.",
   "est_sec": 2.89,
   "gap_before": 0.81,
   "event": "instruction",
   "kind": "describe_options",
   "phrasing": "describe_instr_04"
  },
  {
   "speaker": "moshi",
   "text": "Take your time.",
   "est_sec": 1.03,
   "gap_before": 0.63,
   "role": "ack",
   "phrasing": "ack_09"
  },
  {
   "speaker": "user",
   "text": "I could do one small load every evening, so it never piles up.",
   "est_sec": 4.13,
   "gap_before": 0.64,
   "block": "cleaning.opt3"
  },
  {
   "speaker": "user",
   "text": "Or have a laundry day on Sunday and do everything at once, folding included, with a film on.",
   "est_sec": 5.68,
   "gap_before": 1.39,
   "block": "cleaning.opt3",
   "event": "distractor",
   "kind": "pause"
  },
  {
   "speaker": "user",
   "text": "There's a service near me that collects it and brings it back folded, but it isn't cheap.",
   "est_sec": 5.37,
   "gap_before": 2.77,
   "block": "cleaning.opt3"
  },
  {
   "speaker": "user",
   "text": "Done. What would you recommend?",
   "est_sec": 1.65,
   "gap_before": 1.24,
   "event": "return_cue",
   "kind": "explicit",
   "phrasing": "describe_cue_10"
  },
  {
   "speaker": "moshi",
   "text": "If the folding is what you hate, the pickup service solves that completely. Otherwise the Sunday session with a film is the cheapest, and the nightly load is the gentlest on your weekends.",
   "est_sec": 10.33,
   "gap_before": 0.62,
