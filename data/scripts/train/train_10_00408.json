 "turns": [
  {
   "speaker": "moshi",
   "text": "Hey, how are you doing?",
   "est_sec": 1.65,
   "gap_before": 0.56,
   "role": "greeting",
   "phrasing": "greet_01"
  },
  {
   "speaker": "user",
   "text": "I'm great, thanks.",
   "est_sec": 1.03,
   "gap_before": 0.93,
   "event": "greeting_answer",
   "phrasing": "greet_ans_08"
  },
  {
   "speaker": "user",
   "text": "How do I make sure I get my whole deposit back?",
   "est_sec": 3.51,
   "gap_before": 0.2,
   "event": "ordinary_request",
   "block": "moving_house.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Start with your check in inventory, if you have one. You want to leave the place as it was then, apart from normal wear and tear.",
   "est_sec": 8.16,
   "gap_before": 0.91,
   "role": "reply",
   "block": "moving_house.dlg6"
  },
  {
   "speaker": "user",
   "text": "I think I've got it somewhere in my email.",
   "est_sec": 2.89,
   "gap_before": 2.79,
   "event": "ordinary_request",
   "block": "moving_house.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Find it. Then clean properly, especially the oven, fridge and bathroom. Those are where most deductions come from.",
   "est_sec": 5.68,
   "gap_before": 0.49,
   "role": "reply",
   "block": "moving_house.dlg6"
  },
  {
   "speaker": "user",
   "text": "Should I pay for professional cleaning?",
   "est_sec": 1.96,
   "gap_before": 0.71,
   "event": "ordinary_request",
   "block": "moving_house.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Only if your contract requires it. Otherwise a thorough clean yourself is usually fine.",
   "est_sec": 4.44,
   "gap_before": 0.83,
   "role": "reply",
   "block": "moving_house.dlg6"
  },
  {
   "speaker": "user",
   "text": "Okay. Anything",
   "est_sec": 0.72,
   "gap_before": 3.47,
   "event": "distractor",
   "kind": "pause",
   "block": "moving_house.dlg6"
  },
  {
   "speaker": "user",
   "text": "on the last day?",
   "est_sec": 1.34,
   "gap_before": 2.22,
   "event": "ordinary_request",
   "block": "moving_house.dlg6"
  },
  {
   "speaker": "moshi",
   "text": "Take dated photos and a video of every room after you clean. It's your best evidence if there's a disagreement.",
   "est_sec": 6.3,
